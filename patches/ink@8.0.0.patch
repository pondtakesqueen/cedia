new file mode 100644
index 0000000000000000000000000000000000000000..ec8ef390bde5b2d95780561aafe5ef011d769603
--- /dev/null
+++ b/build/transform-cache.js
@@ -0,0 +1,21 @@
+// cedia: a transform is a pure function of its line and index, so its result is kept per function. Text memoizes
+// its transform on its styles, so a Text drawn again with the same styles and text costs a lookup.
+const LIMIT = 2_000;
+const results = new WeakMap();
+export default function cachedTransform(transform, line, index) {
+    let byLine = results.get(transform);
+    if (byLine === undefined) {
+        byLine = new Map();
+        results.set(transform, byLine);
+    }
+    const key = `${index}\u{0}${line}`;
+    let result = byLine.get(key);
+    if (result === undefined) {
+        result = transform(line, index);
+        if (byLine.size > LIMIT) {
+            byLine.clear();
+        }
+        byLine.set(key, result);
+    }
+    return result;
+}
