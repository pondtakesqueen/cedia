diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.fixes.test.ts b/memo.fixes.test.ts
--- a/memo.fixes.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.fixes.test.ts	2026-10-28 19:49:07.227767545 +0000
@@ -0,0 +1,115 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+// fn's calls, each settled by the test.
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("size stays at max when a key is added past it", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a call evicted for max is not put back when it settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  const a = m("a");
+  const b = m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await Promise.all([a, b]);
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a result in flight during clear is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale rejection does not drop the newer entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const p = expect(m("k")).rejects.toThrow("x");
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("x"));
+  await p;
+  await tick();
+  m("k");
+  expect(calls).toHaveLength(2);
+  expect(m.size).toBe(1);
+});
+
+test("a rejection is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const p = expect(m("k")).rejects.toThrow("x");
+  calls[0]!.d.reject(new Error("x"));
+  await p;
+  await tick();
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a cache hit counts as a use for eviction", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("a");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("joining an in-flight call counts as a use for eviction", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("a");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
