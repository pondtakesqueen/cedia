diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.cases.test.ts b/edit.cases.test.ts
--- a/edit.cases.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.cases.test.ts	2026-10-28 19:47:57.979763429 +0000
@@ -0,0 +1,42 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+
+describe('indentation', () => {
+  test('a line less indented than old_text keeps its place relative to the window', () => {
+    const r = ok(applyEdit('function f() {\n        return 1;\n    }\n}\n', { old_text: '    return 1;\n}', new_text: '    return 2;\n}' }));
+    expect(r.content).toBe('function f() {\n        return 2;\n    }\n}\n');
+  });
+  test('several windows match: error names them', () => {
+    const r = applyEdit('  a\n  b\n    a\n    b\n', { old_text: 'a\nb', new_text: 'c' });
+    expect('error' in r && r.error).toContain('matches 2 places');
+    expect('error' in r && r.error).toContain('1, 3');
+  });
+});
+
+describe('line tiers', () => {
+  test('CRLF line endings are kept', () => {
+    const r = ok(applyEdit('x\r\ny  \r\nz\r\n', { old_text: 'y\nz', new_text: 'Y\nZ' }));
+    expect(r.content).toBe('x\r\nY\r\nZ\r\n');
+  });
+  test('replace_all is ignored by the line tiers', () => {
+    const r = applyEdit('  a\n  b\n    a\n    b\n', { old_text: 'a\nb', new_text: 'c', replace_all: true });
+    expect('error' in r && r.error).toContain('matches 2 places');
+  });
+  test('content without a trailing newline stays without one', () => {
+    const r = ok(applyEdit('a  \nb', { old_text: 'a \nb', new_text: 'A\nb' }));
+    expect(r.content).toBe('A\nb');
+  });
+});
+
+describe('not found hints', () => {
+  test('at most 5 line numbers are listed', () => {
+    const r = applyEdit('a1\na1\na1\na1\na1\na1\n', { old_text: 'a1\nzz', new_text: 'x' });
+    expect('error' in r && r.error).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect('error' in r && r.error).not.toContain('6');
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-28 19:45:18.408956499 +0000
+++ b/edit.ts	2026-10-28 19:47:57.968235236 +0000
@@ -23,5 +23,72 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text, replace_all } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  // exact
+  const lineOf = (idx: number) => 1 + content.slice(0, idx).split('\n').length - 1;
+  const matches: number[] = [];
+  for (let i = content.indexOf(old_text); i !== -1; i = content.indexOf(old_text, i + old_text.length)) matches.push(i);
+  if (matches.length > 1 && !replace_all) {
+    return { error: `old_text matches ${matches.length} places; first at line ${lineOf(matches[0])}. Add context or set replace_all.` };
+  }
+  if (matches.length > 0) {
+    const from = lineOf(matches[0]);
+    const to = from + old_text.replace(/\n$/, '').split('\n').length - 1;
+    return {
+      content: content.split(old_text).join(new_text),
+      applied: { from, to, tier: 'exact', count: matches.length },
+    };
+  }
+
+  // line tiers
+  const trailing = content.endsWith('\n');
+  const lines = content.split('\n');
+  if (trailing) lines.pop();
+  const stripNl = (s: string) => s.replace(/\n$/, '');
+  const oldLines = stripNl(old_text).split('\n');
+  const newLines = stripNl(new_text) === '' ? [] : stripNl(new_text).split('\n');
+
+  const lineTier = (tier: Tier, norm: (s: string) => string, repl: (win: string[]) => string[]) => {
+    const starts: number[] = [];
+    for (let s = 0; s + oldLines.length <= lines.length; s++) {
+      if (oldLines.every((l, k) => norm(lines[s + k]) === norm(l))) starts.push(s);
+    }
+    if (starts.length === 0) return null;
+    if (starts.length > 1) {
+      return { error: `old_text matches ${starts.length} places (lines ${starts.map(s => s + 1).join(', ')}); add more context` };
+    }
+    const s = starts[0];
+    const cr = lines[s].endsWith('\r') ? '\r' : '';
+    const out = [...lines.slice(0, s), ...repl(lines.slice(s, s + oldLines.length)).map(l => l + cr), ...lines.slice(s + oldLines.length)];
+    return {
+      content: out.join('\n') + (trailing && out.length > 0 ? '\n' : ''),
+      applied: { from: s + 1, to: s + oldLines.length, tier, count: 1 },
+    };
+  };
+
+  const trailingTier = lineTier('trailing-space', s => s.trimEnd(), () => newLines);
+  if (trailingTier) return trailingTier;
+
+  const indentOf = (l: string) => l.match(/^\s*/)![0];
+  const fromIndent = indentOf(oldLines.find(l => l.trim() !== '') ?? '');
+  const indentTier = lineTier('indentation', s => s.trim(), win => {
+    const toIndent = indentOf(win.find(l => l.trim() !== '') ?? '');
+    return newLines.map(l => {
+      if (l.trim() === '') return '';
+      if (l.startsWith(fromIndent)) return toIndent + l.slice(fromIndent.length);
+      // less indented than old_text's first line: keep the same distance left of it
+      const cut = fromIndent.length - indentOf(l).length;
+      return toIndent.slice(0, Math.max(0, toIndent.length - cut)) + l.trimStart();
+    });
+  });
+  if (indentTier) return indentTier;
+
+  // nothing matched
+  const first = (oldLines.find(l => l.trim() !== '') ?? '').trim();
+  const hits = first === '' ? [] : lines.flatMap((l, i) => (l.includes(first) ? [i + 1] : [])).slice(0, 5);
+  if (hits.length > 0) return { error: `old_text not found; first line appears at line ${hits.join(', ')}` };
+  return { error: 'old_text not found; re-read the file and copy the text exactly' };
 }
