+import { describe, expect, test } from 'bun:test';
+import { ledgerEntries, matchCheck } from './ledger.ts';
+
+describe('review findings', () => {
+  test('unbalanced quote in leading cd is not a match', () => {
+    expect(matchCheck('cd "/work/repo && bun test', ['bun test'], '/work/repo')).toBeUndefined();
+    expect(matchCheck("cd /work/repo' && bun test", ['bun test'], '/work/repo')).toBeUndefined();
+  });
+
+  test('matched quotes in leading cd still match', () => {
+    expect(matchCheck('cd "/work/repo" && bun test', ['bun test'], '/work/repo')).toBe('bun test');
+    expect(matchCheck("cd '/work/repo' && bun test", ['bun test'], '/work/repo')).toBe('bun test');
+  });
+
+  test('edit without a string path records no write', () => {
+    const events = [
+      { kind: 'tool_intent', callId: 'a', tool: 'edit', input: {} },
+      { kind: 'tool_result', callId: 'a', status: 'completed', output: { isError: false } },
+    ] as const;
+    expect(ledgerEntries([...events], [])).toEqual([]);
+  });
+});
