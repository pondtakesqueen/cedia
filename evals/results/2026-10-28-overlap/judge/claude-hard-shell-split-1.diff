@@ -0,0 +1,43 @@
+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+test('a substitution inside a word keeps the word whole', () => {
+  expect(simpleCommands('r$(true)m -rf /')).toContainEqual(['rm', '-rf', '/']);
+  expect(simpleCommands('r`true`m -rf /')).toContainEqual(['rm', '-rf', '/']);
+  expect(simpleCommands('"r$(true)m" -rf /')).toContainEqual(['rm', '-rf', '/']);
+});
+
+test('a substitution as a redirect target does not drop the next word', () => {
+  expect(simpleCommands('> $(echo f) rm -rf /')).toContainEqual(['rm', '-rf', '/']);
+  expect(simpleCommands('>"$(echo f)" rm -rf /')).toContainEqual(['rm', '-rf', '/']);
+});
+
+test('escaped backticks nest inside backticks', () => {
+  expect(simpleCommands('echo `echo \\`rm -rf x\\` `')).toContainEqual(['rm', '-rf', 'x']);
+});
+
+test('bash flags with values and -- before the script', () => {
+  expect(simpleCommands("bash -c -- 'rm x'")).toEqual([['rm', 'x']]);
+  expect(simpleCommands("bash --rcfile f -c 'rm x'")).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash -lc "ls; id"')).toEqual([['ls'], ['id']]);
+  expect(simpleCommands('bash -o pipefail -c "ls"')).toEqual([['ls']]);
+});
+
+test('env -S and xargs -i take no value word', () => {
+  expect(simpleCommands("env -S 'rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('xargs -i rm -rf {}')).toEqual([['rm', '-rf', '{}']]);
+});
+
+test('process substitution, pipes, redirect forms and quoted keywords', () => {
+  expect(simpleCommands('diff <(rm x) y')).toEqual([['diff', 'y'], ['rm', 'x']]);
+  expect(simpleCommands('echo a >| out')).toEqual([['echo', 'a']]);
+  expect(simpleCommands('make |& tee log')).toEqual([['make'], ['tee', 'log']]);
+  expect(simpleCommands('"if" rm -rf /')).toEqual([['if', 'rm', '-rf', '/']]);
+  expect(simpleCommands('"A=1" rm -rf /')).toEqual([['A=1', 'rm', '-rf', '/']]);
+});
+
+test('substitutions in double quotes and unclosed substitutions', () => {
+  expect(simpleCommands('echo "$(rm -rf /)"')).toEqual([['echo'], ['rm', '-rf', '/']]);
+  expect(simpleCommands('echo $(ls')).toEqual([['echo'], ['ls']]);
+  expect(simpleCommands('echo "$(ls')).toBeNull();
+});
