+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, verified, type SessionEvent } from './ledger.ts';
+
+describe('review findings', () => {
+  test('a non-bash tool with a command field is not a check', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'a', tool: 'task', input: { command: 'bun test' } },
+      { kind: 'tool_result', callId: 'a', status: 'completed', output: { isError: false } },
+    ];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([]);
+  });
+
+  test('an edit without a string path is not a write with a bogus label', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'a', tool: 'edit', input: { file_path: 'a.ts' } },
+      { kind: 'tool_result', callId: 'a', status: 'completed', output: { isError: false } },
+    ];
+    expect(evidence(ledgerEntries(events, [])).changed).toEqual([]);
+  });
+});
