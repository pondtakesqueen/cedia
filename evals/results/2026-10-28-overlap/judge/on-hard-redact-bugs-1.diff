diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact-names.test.ts b/redact-names.test.ts
--- a/redact-names.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact-names.test.ts	2026-10-28 19:52:55.616047096 +0000
@@ -0,0 +1,15 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+test('secret names in camelCase, plural or suffixed forms are still redacted', () => {
+  expect(redactSecrets('"secretKey": "abcd1234efgh5678"')).toEqual({ text: `"secretKey": "${REDACTED}"`, count: 1 });
+  expect(redactSecrets('apiKeyProd: "abcd1234efgh5678"')).toEqual({ text: `apiKeyProd: "${REDACTED}"`, count: 1 });
+  expect(redactSecrets('tokenValue: "abcd1234efgh5678"')).toEqual({ text: `tokenValue: "${REDACTED}"`, count: 1 });
+  expect(redactSecrets('GITHUB_TOKENS=ghx1234abcd')).toEqual({ text: `GITHUB_TOKENS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('DB_PASSWORDS=changeme')).toEqual({ text: `DB_PASSWORDS=${REDACTED}`, count: 1 });
+});
+
+test('count-style names that merely contain a secret word are not redacted', () => {
+  for (const line of ['MAX_TOKENS=4096', 'max_tokens: 1000', 'NUM_TOKENS=512'])
+    expect([line, redactSecrets(line).count]).toEqual([line, 0]);
+});
