 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-28 20:01:56.490849470 +0000
+++ b/src/slug.ts	2026-10-28 20:03:19.510536565 +0000
@@ -11,10 +11,25 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const special: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => special[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  const head = s.slice(0, max + 1);
+  const i = head.lastIndexOf('-');
+  return i > 0 ? s.slice(0, i) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-28 20:03:19.515818208 +0000
@@ -0,0 +1,23 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('duration parse rules', () => {
+  expect(parseDuration(' 90s ')).toBe(90_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1m5s')).toBe(65_000);
+  expect(parseDuration('0.0005s')).toBe(1);
+  for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '5 s', '1.h', '.5h']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
+
+test('duration format rules', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(formatDuration(1)).toBe('1ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(() => formatDuration(-1)).toThrow('-1');
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-28 20:04:30.322496546 +0000
@@ -0,0 +1,103 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+test('lru capacity and recency', () => {
+  const events: unknown[] = [];
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = (k, v, r) => events.push([k, v, r]);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(events).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('lru ttl boundary', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 999;
+  expect(cache.get('a')).toBe(1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('lru expired entry goes first when over capacity', () => {
+  const events: unknown[] = [];
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = (k, v, r) => events.push([k, v, r]);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1200;
+  cache.set('c', 3);
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('lru expired entries count toward capacity until exceeded', () => {
+  const events: unknown[] = [];
+  let t = 0;
+  const cache = new LRU<string, number>(2, 100, () => t);
+  cache.onEvict = (k, v, r) => events.push([k, v, r]);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  t = 500;
+  expect(events).toEqual([]);
+  expect(cache.size).toBe(0);
+  cache.set('c', 3);
+  expect(events).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('lru delete reasons', () => {
+  const events: unknown[] = [];
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.onEvict = (k, v, r) => events.push([k, v, r]);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(cache.delete('missing')).toBe(false);
+  t = 1000;
+  expect(cache.delete('b')).toBe(false);
+  expect(events).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('lru get expired fires event; overwrite moves to front silently', () => {
+  const events: unknown[] = [];
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.onEvict = (k, v, r) => events.push([k, v, r]);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('a', 3);
+  expect(events).toEqual([]);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+  expect(events).toEqual([['a', 3, 'expired']]);
+  expect(cache.size).toBe(0);
+  expect(cache.keys()).toEqual([]);
+});
+
+test('lru overwrite gets a fresh ttl', () => {
+  const events: unknown[] = [];
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.onEvict = (k, v, r) => events.push([k, v, r]);
+  cache.set('a', 1);
+  t = 900;
+  cache.set('a', 2);
+  t = 1500;
+  expect(cache.get('a')).toBe(2);
+  expect(events).toEqual([]);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-28 20:03:19.518158114 +0000
@@ -0,0 +1,19 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify rules', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab-cd', 5)).toBe('ab-cd');
+  expect(slugify('Straße')).toBe('strasse');
+  expect(slugify('Æsir Œuvre Øl Łódź Đak')).toBe('aesir-oeuvre-ol-lodz-dak');
+  expect(slugify('façade ñ à ź')).toBe('facade-n-a-z');
+  expect(slugify('--Hi!!  there--')).toBe('hi-there');
+  expect(slugify('!!!')).toBe('');
+});
+
+test('uniqueSlug rules', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+});
