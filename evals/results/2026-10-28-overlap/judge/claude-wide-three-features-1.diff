 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const units: Record<string, number> = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1_000, ms: 1 };
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const fail = (): never => {
+    throw new Error(`invalid duration: "${text}"`);
+  };
+  const s = text.trim();
+  if (s === '') fail();
+  const part = /(\d+(?:\.\d+)?)(ms|d|h|m|s)/y;
+  const space = /\s*/y;
+  let total = 0;
+  let pos = 0;
+  while (pos < s.length) {
+    part.lastIndex = pos;
+    const m = part.exec(s);
+    if (!m) fail();
+    total += Number(m[1]) * units[m[2]];
+    space.lastIndex = part.lastIndex;
+    space.exec(s);
+    pos = space.lastIndex;
+  }
+  if (!Number.isFinite(total)) fail();
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (ms < 0 || !Number.isFinite(ms)) throw new Error(`invalid duration: ${ms}`);
+  ms = Math.round(ms);
+  if (ms === 0) return '0s';
+  let out = '';
+  for (const [unit, size] of Object.entries(units)) {
+    const n = Math.floor(ms / size);
+    if (n > 0) {
+      out += `${n}${unit}`;
+      ms -= n * size;
+    }
+  }
+  return out;
 }
