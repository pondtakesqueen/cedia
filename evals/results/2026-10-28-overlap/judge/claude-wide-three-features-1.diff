 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  private map = new Map<K, { value: V; expires: number }>();
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+  constructor(
+    private capacity: number,
+    private ttlMs: number,
+    private now: () => number = Date.now,
+  ) {}
+
+  private evict(key: K, entry: { value: V }, reason: EvictReason): void {
+    this.map.delete(key);
+    this.onEvict?.(key, entry.value, reason);
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const t = this.now();
+    const entry = this.map.get(key);
+    if (!entry) return undefined;
+    if (t >= entry.expires) {
+      this.evict(key, entry, 'expired');
+      return undefined;
+    }
+    this.map.delete(key);
+    this.map.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const t = this.now();
+    this.map.delete(key);
+    this.map.set(key, { value, expires: t + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    const expired = [...this.map]
+      .filter(([, entry]) => t >= entry.expires)
+      .map(([k]) => k);
+    for (const k of expired) this.evict(k, this.map.get(k)!, 'expired');
+    for (const k of [...this.map.keys()]) {
+      if (this.map.size <= this.capacity) break;
+      this.evict(k, this.map.get(k)!, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const t = this.now();
+    const entry = this.map.get(key);
+    if (!entry) return false;
+    if (t >= entry.expires) {
+      this.evict(key, entry, 'expired');
+      return false;
+    }
+    this.evict(key, entry, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    const t = this.now();
+    let n = 0;
+    for (const entry of this.map.values()) if (t < entry.expires) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
+    const out: K[] = [];
