diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse-edge.test.ts b/sse-edge.test.ts
--- a/sse-edge.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse-edge.test.ts	2026-10-28 19:56:36.207794234 +0000
@@ -0,0 +1,37 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+test('a lone \\r at the end of the body does not drop pending data', async () => {
+  expect(await all('data: a\r\n\r', 100)).toEqual([{ data: 'a' }]);
+  expect(await all('data: a\r\n\r', 1)).toEqual([{ data: 'a' }]);
+});
+
+test('breaking out early cancels the upstream body', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'x' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
+
+test('many lines and one long line are split in linear time', async () => {
+  expect((await all('data: a\n\n'.repeat(100000), 1 << 20)).length).toBe(100000);
+  const long = 'data: ' + 'x'.repeat(200000) + '\n\n';
+  expect(await all(long, 64)).toEqual([{ data: 'x'.repeat(200000) }]);
+});
