diff -ruN '--exclude=node_modules' '--exclude=.git' a/shell.review.test.ts b/shell.review.test.ts
--- a/shell.review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/shell.review.test.ts	2026-10-28 19:55:42.151791021 +0000
@@ -0,0 +1,39 @@
+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+test('substitutions inside double quotes are commands', () => {
+  expect(simpleCommands('echo "$(rm -rf /)"')).toEqual([['echo'], ['rm', '-rf', '/']]);
+  expect(simpleCommands('echo "`id`"')).toEqual([['echo'], ['id']]);
+  expect(simpleCommands('echo "$(id)"')).toEqual([['echo'], ['id']]);
+});
+
+test('an escaped > is not a redirection', () => {
+  expect(simpleCommands('echo x\\>& rm -rf /')).toEqual([['echo', 'x>'], ['rm', '-rf', '/']]);
+});
+
+test('env -S and --split-string run their script', () => {
+  expect(simpleCommands("env -S 'rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands("env --split-string='rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+});
+
+test('bundled short flags that take a value', () => {
+  expect(simpleCommands('sudo -iu root rm -rf /')).toEqual([['rm', '-rf', '/']]);
+});
+
+test('full paths of wrappers and shells', () => {
+  expect(simpleCommands('/usr/bin/sudo rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands("/bin/bash -c 'rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+});
+
+test('shell options with a value before -c', () => {
+  expect(simpleCommands("bash -o pipefail -c 'rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+});
+
+test('redirections glued after a word', () => {
+  expect(simpleCommands('rm>/dev/null -rf /')).toEqual([['rm', '-rf', '/']]);
+});
+
+test('nested scripts that fail to parse return null', () => {
+  expect(simpleCommands(`bash -c "'"`)).toBeNull();
+  expect(simpleCommands(`eval "'"`)).toBeNull();
+});
