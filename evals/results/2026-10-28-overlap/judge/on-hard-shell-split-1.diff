+
+// Whether `flag` takes its value from the next word: a listed flag, or the last letter of a bundle (`-iu root`).
+function takesValue(flag: string, list: string[] = []): boolean {
+  if (list.includes(flag)) return true;
+  if (!/^-[a-zA-Z]{2,}$/.test(flag)) return false;
+  const i = [...flag.slice(1)].findIndex((letter) => list.includes('-' + letter));
+  return i >= 0 && i === flag.length - 2;
+}
