+      }
+    } else if (c === '>' || c === '<') {
+      // A redirection starts its own word, so `rm>/dev/null` is `rm` and `>/dev/null`. `2>` and `&>` keep their prefix.
+      if (started && !/^\d*$/.test(raw) && !/[>&]$/.test(raw)) endWord();
+      value += c;
+      raw += c;
+      started = true;
+    } else {
+      value += c;
+      raw += c;
+      started = true;
+    }
+  }
+  endSegment();
+  return segments;
+}
 
