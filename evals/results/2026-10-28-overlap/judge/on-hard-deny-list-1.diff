diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.bypass.test.ts b/deny.bypass.test.ts
--- a/deny.bypass.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.bypass.test.ts	2026-10-28 19:46:39.607758770 +0000
@@ -0,0 +1,29 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('shortened long options are still caught', () => {
+  expect(hit('rm --recur /etc')).toBe('rm-outside');
+  expect(hit('rm --r /')).toBe('rm-outside');
+  expect(hit('git reset --har')).toBe('reset-hard');
+  expect(hit('git push --forc')).toBe('force-push');
+  expect(hit('git clean --forc')).toBe('clean-force');
+});
+
+test('find global options before the start paths', () => {
+  for (const line of ['find -L / -delete', 'find -H / -delete', 'find -P / -exec rm {} ;', 'find -D search / -delete', 'find -O3 / -delete'])
+    expect([line, hit(line)]).toEqual([line, 'rm-outside']);
+  for (const line of ['find -L src -delete', 'find -P -delete'])
+    expect([line, hit(line)]).toEqual([line, undefined]);
+});
+
+test('-n as the value of -e is not a dry run', () => {
+  expect(hit('git clean -fdx -e -n')).toBe('clean-force');
+  expect(hit('git clean -f --exclude -n')).toBe('clean-force');
+});
+
+test('git --config-env takes a value', () => {
+  expect(hit('git --config-env x=Y push -f')).toBe('force-push');
+});
