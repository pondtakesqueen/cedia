diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.review.test.ts b/sse.review.test.ts
--- a/sse.review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.review.test.ts	2026-10-28 19:54:33.071786914 +0000
@@ -0,0 +1,31 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+test('breaking out early cancels the body and unlocks it', async () => {
+  const enc = new TextEncoder();
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'x' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+  expect(body.locked).toBe(false);
+});
+
+test('a long data line in one-byte chunks is parsed in about linear time', async () => {
+  const text = 'data: ' + 'a'.repeat(200_000) + '\n\n';
+  const out: SseMessage[] = [];
+  const start = performance.now();
+  for await (const m of readSse(streamFromString(text, 1))) out.push(m);
+  const ms = performance.now() - start;
+  expect(out).toEqual([{ data: 'a'.repeat(200_000) }]);
+  expect(ms).toBeLessThan(5000);
+});
