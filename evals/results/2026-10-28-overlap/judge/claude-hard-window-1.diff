diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.cases.test.ts b/window.cases.test.ts
--- a/window.cases.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/window.cases.test.ts	2026-10-28 19:59:09.999803376 +0000
@@ -0,0 +1,126 @@
+import { expect, test } from "bun:test";
+import { distinctInWindow, type Event } from "./window";
+
+// The original O(n²) definition, kept as the reference for the tests below.
+function bruteForce(events: Event[], windowMs: number): number[] {
+  return events.map((e) => {
+    const keys = new Set<string>();
+    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
+    return keys.size;
+  });
+}
+
+test("a later entry with an earlier or equal time is in the window", () => {
+  const events = [
+    { t: 10, key: "a" },
+    { t: 5, key: "b" },
+    { t: 10, key: "c" },
+    { t: 0, key: "a" },
+  ];
+  expect(distinctInWindow(events, 10)).toEqual([3, 2, 3, 1]);
+  expect(distinctInWindow(events, 10)).toEqual(bruteForce(events, 10));
+});
+
+test("the window excludes t - windowMs and includes t - 9.5", () => {
+  const events = [
+    { t: 0, key: "a" },
+    { t: 10, key: "b" },
+  ];
+  expect(distinctInWindow(events, 10)).toEqual([1, 1]);
+  const later = [
+    { t: 0.5, key: "a" },
+    { t: 10, key: "b" },
+  ];
+  expect(distinctInWindow(later, 10)).toEqual([1, 2]);
+});
+
+test("keys are compared exactly", () => {
+  const events = [
+    { t: 1, key: "a" },
+    { t: 1, key: "A" },
+    { t: 1, key: "a " },
+  ];
+  expect(distinctInWindow(events, 10)).toEqual([3, 3, 3]);
+});
+
+test("a window too small to change a large t is empty", () => {
+  expect(distinctInWindow([{ t: 1e17, key: "a" }], 1)).toEqual([0]);
+});
+
+test("a bad windowMs is a RangeError, even when a t is bad too", () => {
+  const bad = [{ t: NaN, key: "a" }];
+  expect(() => distinctInWindow(bad, NaN)).toThrow(RangeError);
+  expect(() => distinctInWindow([{ t: 1, key: "a" }], Infinity)).toThrow(RangeError);
+  expect(() => distinctInWindow([{ t: 1, key: "a" }], -1)).toThrow(RangeError);
+});
+
+test("a bad t is a TypeError naming the first bad index", () => {
+  const events = [
+    { t: 1, key: "a" },
+    { t: NaN, key: "b" },
+    { t: "5" as any, key: "c" },
+  ];
+  expect(() => distinctInWindow(events, 10)).toThrow(TypeError);
+  expect(() => distinctInWindow(events, 10)).toThrow("event 1");
+});
+
+// Seeded generator (mulberry32), so a failing random case can be reproduced.
+function seededRandom(seed: number): () => number {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let x = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
+    return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test("matches the brute-force definition on random lists", () => {
+  const random = seededRandom(12345);
+  const keys = ["a", "b", "c", "d", "e"];
+  for (let run = 0; run < 200; run++) {
+    const n = Math.floor(random() * 61);
+    const events = Array.from({ length: n }, () => ({
+      t: random() < 0.5 ? Math.floor(random() * 41) - 20 : Math.round((random() * 40 - 20) * 4) / 4,
+      key: keys[Math.floor(random() * keys.length)],
+    }));
+    for (const windowMs of [0.5, 1, 3, 10, 25]) {
+      expect({ events, windowMs, result: distinctInWindow(events, windowMs) }).toEqual({
+        events,
+        windowMs,
+        result: bruteForce(events, windowMs),
+      });
+    }
+  }
+});
+
+test("sparse input keeps its holes, as before", () => {
+  for (const n of [1, 3]) {
+    const sparse: Event[] = new Array(n);
+    const result = distinctInWindow(sparse, 10);
+    expect(result.length).toBe(n);
+    expect(Object.keys(result)).toEqual([]);
+  }
+});
+
+test("200,000 events in a sparse window finish well under a second", () => {
+  const random = seededRandom(99);
+  const events = Array.from({ length: 200_000 }, () => ({
+    t: random() * 1e7,
+    key: `k${Math.floor(random() * 50_000)}`,
+  }));
+  const start = performance.now();
+  const result = distinctInWindow(events, 1000);
+  const elapsed = performance.now() - start;
+  expect(result.length).toBe(200_000);
+  expect(elapsed).toBeLessThan(1000);
+});
+
+test("200,000 events at one time with distinct keys finish well under a second", () => {
+  const events = Array.from({ length: 200_000 }, (_, i) => ({ t: 5, key: `k${i}` }));
+  const start = performance.now();
+  const result = distinctInWindow(events, 1e9);
+  const elapsed = performance.now() - start;
+  expect(result.length).toBe(200_000);
+  expect(result[0]).toBe(200_000);
+  expect(elapsed).toBeLessThan(1000);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.ts b/window.ts
--- a/window.ts	2026-10-28 19:56:50.471881682 +0000
+++ b/window.ts	2026-10-28 19:59:02.919802955 +0000
@@ -16,9 +16,37 @@
   events.forEach((e, i) => {
     if (typeof e.t !== "number" || !Number.isFinite(e.t)) throw new TypeError(`event ${i} has no finite time: ${e.t}`);
   });
-  return events.map((e) => {
-    const keys = new Set<string>();
-    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
-    return keys.size;
-  });
+  const n = events.length;
+  // Sweep the events in time order. The window of an event is (t - windowMs, t], and both ends only move forward.
+  // forEach skips holes, as the original map did, so a sparse input keeps its holes in the result.
+  const indices: number[] = [];
+  events.forEach((_, i) => indices.push(i));
+  const order = indices.sort((a, b) => events[a].t - events[b].t);
+  const counts = new Map<string, number>();
+  const result = new Array<number>(n);
+  let distinct = 0;
+  let lo = 0;
+  let hi = 0;
+  for (const i of order) {
+    const cur = events[i].t;
+    while (hi < n && events[order[hi]].t <= cur) {
+      const key = events[order[hi]].key;
+      const count = counts.get(key) ?? 0;
+      if (count === 0) distinct++;
+      counts.set(key, count + 1);
+      hi++;
+    }
+    const lowBound = cur - windowMs;
+    while (lo < hi && events[order[lo]].t <= lowBound) {
+      const key = events[order[lo]].key;
+      const count = counts.get(key)! - 1;
+      if (count === 0) {
+        distinct--;
+        counts.delete(key);
+      } else counts.set(key, count);
+      lo++;
+    }
+    result[i] = distinct;
+  }
+  return result;
 }
