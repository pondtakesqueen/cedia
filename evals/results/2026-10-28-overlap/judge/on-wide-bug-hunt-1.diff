diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-28 19:59:46.459805543 +0000
@@ -0,0 +1,43 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+describe('pricing rules from README', () => {
+  test('UK free shipping from 4000: 2 BAG = 4400, no shipping, tax 880, total 5280', () => {
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+
+  test('UK at exactly 4000 gets free shipping: 2200 + 1200 + 5 * 120 = 4000, tax 800, total 4800', () => {
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+
+  test('9 units gets no bulk discount: 9 PEN = 1080, shipping 800, tax 132, total 2012', () => {
+    expect(totals(cart('US', [['PEN', 9]]))).toMatchObject({ subtotal: 1080, shipping: 800, tax: 132, total: 2012 });
+  });
+
+  test('49 units gets 5%, not 10%: 49 PEN = 5880 - 294 = 5586, free shipping, tax 391, total 5977', () => {
+    expect(totals(cart('US', [['PEN', 49]]))).toMatchObject({ subtotal: 5586, shipping: 0, tax: 391, total: 5977 });
+  });
+
+  test('exactly 10 units gets 5%: 10 PEN = 1200 - 60 = 1140, shipping 800, tax 136, total 2076', () => {
+    const t = totals(cart('US', [['PEN', 10]]));
+    expect(t.lines[0].discount).toBe(60);
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('exactly 50 units gets 10%: 50 PEN = 6000 - 600 = 5400, free shipping, tax 378, total 5778', () => {
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same SKU merge before the bulk tier is chosen: 6 + 4 PEN behaves like 10 PEN', () => {
+    const t = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+    expect(t.lines.length).toBe(1);
+    expect(t.lines[0].quantity).toBe(10);
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('shipping uses the post-coupon amount: 5200 - 520 = 4680 < 5000, so shipping 800, tax 384, total 5864', () => {
+    const t = totals(cart('US', [['BAG', 1], ['TEE', 2]], 'SAVE10'));
+    expect(t).toMatchObject({ subtotal: 5200, coupon: 520, shipping: 800, tax: 384, total: 5864 });
+  });
+});
