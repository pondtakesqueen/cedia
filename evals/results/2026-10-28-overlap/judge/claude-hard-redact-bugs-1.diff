diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact-plural.test.ts b/redact-plural.test.ts
--- a/redact-plural.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact-plural.test.ts	2026-10-28 19:52:49.686026676 +0000
@@ -0,0 +1,9 @@
+import { expect, test } from 'bun:test';
+import { redactSecrets, REDACTED } from './redact';
+
+test('plural secret names are still redacted', () => {
+  expect(redactSecrets('API_KEYS=abc123def456')).toEqual({ text: `API_KEYS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('SECRETS=hunter2xyz')).toEqual({ text: `SECRETS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('DB_PASSWORDS=changeme')).toEqual({ text: `DB_PASSWORDS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('GITHUB_TOKENS=abcd1234efgh')).toEqual({ text: `GITHUB_TOKENS=${REDACTED}`, count: 1 });
+});
