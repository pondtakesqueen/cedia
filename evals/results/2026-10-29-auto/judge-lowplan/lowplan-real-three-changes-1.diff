@@ -0,0 +1,58 @@
+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { runPrompt, type RunOptions } from '../src/core/loop/run.ts';
+import { FAUX_MODEL } from '../src/core/providers/catalog.ts';
+import { fauxProvider, text, type FauxStep } from '../src/core/providers/faux.ts';
+import { SessionLog } from '../src/core/session/log.ts';
+import { bashTool } from '../src/core/tools/bash.ts';
+import { readTool } from '../src/core/tools/read.ts';
+
+const cwd = mkdtempSync(join(tmpdir(), 'cedia-quota-'));
+writeFileSync(join(cwd, 'a.txt'), 'alpha\n');
+
+function setup(steps: FauxStep[], extra: Partial<RunOptions> = {}) {
+  const log = SessionLog.create();
+  const provider = fauxProvider(steps);
+  const sleeps: number[] = [];
+  const opts: RunOptions = {
+    log,
+    provider,
+    model: FAUX_MODEL,
+    tools: [readTool, bashTool],
+    system: 'sys',
+    cwd,
+    retry: { sleep: async (ms) => void sleeps.push(ms) },
+    ...extra,
+  };
+  return { log, provider, opts, sleeps };
+}
+
+describe('loop quota wait', () => {
+  test('a quota with retryAfterMs 0 is not waited out: no sleep, one attempt, the run ends', async () => {
+    const spent: FauxStep = { error: { code: 'quota', status: 429, retryAfterMs: 0, message: 'usage limit reached' } };
+    const waits: number[] = [];
+    const { log, opts, sleeps } = setup([...Array.from({ length: 50 }, () => spent), { blocks: [text('ok')] }], {
+      quotaWaitMs: 60_000,
+      onQuotaWait: (ms) => void waits.push(ms),
+    });
+    const res = await runPrompt(opts, 'hi');
+    expect(res.subtype).toBe('error_during_execution');
+    expect(sleeps).toEqual([]);
+    expect(waits).toEqual([]);
+    expect(log.events.filter((e) => e.kind === 'attempt')).toHaveLength(1);
+  });
+
+  test('a quota with retryAfterMs 1000 is waited out once, then the run succeeds', async () => {
+    const spent: FauxStep = { error: { code: 'quota', status: 429, retryAfterMs: 1000, message: 'usage limit reached' } };
+    const waits: number[] = [];
+    const { opts, sleeps } = setup([spent, { blocks: [text('ok')] }], {
+      quotaWaitMs: 60_000,
+      onQuotaWait: (ms) => void waits.push(ms),
+    });
+    expect((await runPrompt(opts, 'hi')).subtype).toBe('success');
+    expect(waits).toEqual([1000]);
+    expect(sleeps).toEqual([1000]);
+  });
+});
