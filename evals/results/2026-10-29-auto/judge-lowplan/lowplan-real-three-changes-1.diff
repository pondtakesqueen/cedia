@@ -0,0 +1,48 @@
+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, readdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { SessionLog } from '../src/core/session/log.ts';
+import type { SessionEvent } from '../src/core/types.ts';
+
+const BIN = join(import.meta.dir, '..', 'bin', 'cedia');
+
+function cedia(script: unknown[], args: string[]) {
+  const dir = mkdtempSync(join(tmpdir(), 'cedia-e2e-'));
+  const scriptPath = join(dir, 'script.json');
+  writeFileSync(scriptPath, JSON.stringify(script));
+  const home = join(dir, 'home');
+  const proc = Bun.spawnSync([BIN, '-m', 'faux', '--cwd', dir, ...args], {
+    env: { ...process.env, CEDIA_FAUX_SCRIPT: scriptPath, CEDIA_HOME: home },
+  });
+  return { code: proc.exitCode, out: proc.stdout.toString(), err: proc.stderr.toString(), home, dir };
+}
+
+const reply = (text: string) => ({ blocks: [{ type: 'text', text }] });
+const call = (id: string, command: string) => ({ blocks: [{ type: 'tool_use', id, name: 'bash', input: { command } }] });
+const rejected = { error: { code: 'bad_request', status: 400, message: 'messages.3.content.0: Invalid `signature` in `thinking` block' } };
+
+describe('a resumed thread whose last session was refused', () => {
+  const args = ['-p', 'make f.txt say good', '--output-format', 'json', '--permission', 'workspace', '--sandbox', 'off', '--check', 'grep -q good f.txt'];
+  const sessions = (home: string) => {
+    const root = join(home, 'sessions');
+    const [project] = readdirSync(root);
+    return readdirSync(join(root, project!)).map((f) => ({ id: f.replace(/\.jsonl$/, ''), events: SessionLog.load(join(root, project!, f)).events }));
+  };
+  const head = (events: SessionEvent[]) => events[0] as Extract<SessionEvent, { kind: 'session' }>;
+
+  test('starts a new session recorded as rejected, which is told the earlier session stopped', () => {
+    // Both sessions are refused, so the thread's last session is a refused one.
+    const first = cedia([call('c1', 'echo good > f.txt'), rejected, call('c2', 'echo good >> f.txt'), rejected], args);
+    const thread = JSON.parse(first.out).thread as string;
+    const before = new Set(sessions(first.home).map((s) => s.id));
+    const scriptPath = join(first.dir, 'script.json');
+    writeFileSync(scriptPath, JSON.stringify([reply('done')]));
+    const proc = Bun.spawnSync([BIN, '-m', 'faux', '--cwd', first.dir, ...args, '--thread', thread], { env: { ...process.env, CEDIA_FAUX_SCRIPT: scriptPath, CEDIA_HOME: first.home } });
+    expect(proc.exitCode).toBe(0);
+    const added = sessions(first.home).filter((s) => !before.has(s.id));
+    expect(added).toHaveLength(1);
+    const [next] = added;
+    expect(next!.events.some((e) => e.kind === 'reminder' && e.text.includes('stopped partway through this task when the provider refused its history'))).toBe(true);
+  });
+});
