+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { runPrompt, type RunOptions } from '../src/core/loop/run.ts';
+import { FAUX_MODEL } from '../src/core/providers/catalog.ts';
+import { fauxProvider, text, toolUse, type FauxStep } from '../src/core/providers/faux.ts';
+import { lintSession } from '../src/core/session/lint.ts';
+import { SessionLog } from '../src/core/session/log.ts';
+import { readTool } from '../src/core/tools/read.ts';
+import type { EventOf, SessionEvent } from '../src/core/types.ts';
+
+const cwd = mkdtempSync(join(tmpdir(), 'cedia-loop-shared-'));
+writeFileSync(join(cwd, 'a.txt'), 'alpha\n');
+
+function setup(steps: FauxStep[], extra: Partial<RunOptions> = {}) {
+  const log = SessionLog.create();
+  const opts: RunOptions = {
+    log,
+    provider: fauxProvider(steps),
+    model: FAUX_MODEL,
+    tools: [readTool],
+    system: 'sys',
+    cwd,
+    retry: { sleep: async () => {} },
+    ...extra,
+  };
+  return { log, opts };
+}
+
+const of = <K extends SessionEvent['kind']>(events: SessionEvent[], k: K) => events.filter((e): e is EventOf<K> => e.kind === k);
+
+describe('calls that share an id, on the paths that do not run them', () => {
+  test('a stopped session writes one tool_result per shared id', async () => {
+    const { log, opts } = setup(
+      [{ blocks: [toolUse('d', 'read', { path: 'a.txt' }), toolUse('d', 'read', { path: 'a.txt' })] }, { blocks: [text('ok')] }],
+      { maxBudgetUsd: 1e-9 },
+    );
+    const res = await runPrompt(opts, 'spend');
+    expect(res.subtype).toBe('error_max_budget_usd');
+    expect(of(log.events, 'tool_result').map((r) => r.callId)).toEqual(['d']);
+    expect(lintSession(log.events)).toEqual([]);
+  });
+});
