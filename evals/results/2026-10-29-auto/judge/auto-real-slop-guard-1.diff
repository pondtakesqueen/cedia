--- a/src/core/trust/slop.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/core/trust/slop.ts	2026-10-29 03:00:21.350363670 +0000
@@ -0,0 +1,79 @@
+// The slop guard finds shortcuts in a run's changes that make work look done.
+export type FileChange = { path: string; added: string[]; removed: string[]; deleted: boolean };
+export type SlopRule = 'test-deleted' | 'test-weakened' | 'test-skipped' | 'suppression' | 'swallowed-error' | 'type-escape' | 'stub';
+export type SlopFinding = { rule: SlopRule; path: string; text?: string };
+
+const CODE = /\.(ts|tsx|js|jsx|mjs|cjs|mts|cts|py|go|rs|rb|java|kt|swift|c|cc|cpp|h|hpp|cs|php|scala)$/;
+const TS = /\.(ts|tsx|js|jsx|mjs|cjs|mts|cts)$/;
+const TEST_DIR = /(^|\/)(tests?|__tests__|spec)\//;
+const TEST_NAME = /[._](test|spec)\.[a-z]+$/;
+const TEST_PY = /^test_.*\.py$/;
+const ASSERT = /\b(assert\w*|expect|should)\b|\bt\.(Error|Fatal|Fail)/;
+const SKIPPED = /\b(it|test|describe)\.(skip|todo)\s*\(|\b(xit|xdescribe|xtest)\s*\(|\bt\.Skip(Now|f)?\s*\(|@pytest\.mark\.skip|@unittest\.skip|\bpytest\.skip\s*\(|#\[ignore\]/;
+const SUPPRESSION = /@ts-(ignore|nocheck|expect-error)|eslint-disable|biome-ignore|#\s*type:\s*ignore|#\s*noqa|pylint:\s*disable|\/\/\s*nolint|@SuppressWarnings/;
+const SWALLOWED = [/\bcatch\s*(\([^)]*\))?\s*\{\s*\}/, /\bexcept\b[^:]*:\s*pass\b/, /\.catch\(\s*\(\s*\w*\s*\)\s*=>\s*\{\s*\}\s*\)/];
+const TYPE_ESCAPE = /\bas\s+any\b|<any>|:\s*any\b(?!\s*\()/;
+const STUB = [/\b(throw|raise|panic)\b.*\b(not implemented|unimplemented)\b/i, /NotImplementedError/, /\b(todo|unimplemented)!\(/];
+
+const isTest = (path: string) => TEST_DIR.test(path) || TEST_NAME.test(path) || TEST_PY.test(path.split('/').pop()!);
+const count = (lines: string[]) => lines.filter((l) => ASSERT.test(l)).length;
+
+// Type escapes are looked for in code only: strings and comments may say `any`.
+const code = (line: string) => line.replace(/\/\/.*$/, '').replace(/(['"`]).*?\1/g, "''");
+
+// `next` is the following added line, so a catch or except whose body is on the next line still counts.
+function lineRule(path: string, line: string, next = ''): SlopRule | undefined {
+  if (isTest(path) && SKIPPED.test(line)) return 'test-skipped';
+  if (SUPPRESSION.test(line)) return 'suppression';
+  if (SWALLOWED.some((r) => r.test(`${line} ${next}`))) return 'swallowed-error';
+  if (TS.test(path) && TYPE_ESCAPE.test(code(line))) return 'type-escape';
+  if (STUB.some((r) => r.test(line))) return 'stub';
+}
+
+export function findSlop(changes: FileChange[]): SlopFinding[] {
+  const out: SlopFinding[] = [];
+  for (const c of changes) {
+    if (isTest(c.path)) {
+      if (c.deleted) {
+        out.push({ rule: 'test-deleted', path: c.path });
+        continue;
+      }
+      const fewer = count(c.removed) - count(c.added);
+      if (fewer > 0) out.push({ rule: 'test-weakened', path: c.path, text: `${fewer} fewer assertions` });
+    }
+    if (!CODE.test(c.path)) continue;
+    for (const [i, line] of c.added.entries()) {
+      const rule = lineRule(c.path, line, c.added[i + 1]);
+      if (rule) out.push({ rule, path: c.path, text: line.trim().slice(0, 120) });
+    }
+  }
+  return out;
+}
+
+export function changesFromPatch(patch: string): FileChange[] {
+  const out: FileChange[] = [];
+  let cur: FileChange | undefined;
+  let inHunk = false;
+  for (const line of patch.split('\n')) {
+    const head = /^diff --git a\/.* b\/(.*)$/.exec(line);
+    if (head) {
+      cur = { path: head[1]!, added: [], removed: [], deleted: false };
+      out.push(cur);
+      inHunk = false;
+    } else if (!cur) {
+      continue;
+    } else if (line.startsWith('@@')) {
+      inHunk = true;
+    } else if (inHunk) {
+      if (line.startsWith('+')) cur.added.push(line.slice(1));
+      else if (line.startsWith('-')) cur.removed.push(line.slice(1));
+    } else if (line.startsWith('--- a/')) {
+      cur.path = line.slice(6);
+    } else if (line.startsWith('+++ b/')) {
+      cur.path = line.slice(6);
+    } else if (line.startsWith('deleted file mode')) {
+      cur.deleted = true;
+    }
+  }
+  return out;
+}
