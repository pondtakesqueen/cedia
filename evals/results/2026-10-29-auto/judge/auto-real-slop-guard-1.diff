diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slop-review.test.ts b/test/slop-review.test.ts
--- a/test/slop-review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slop-review.test.ts	2026-10-29 03:00:13.215734247 +0000
@@ -0,0 +1,60 @@
+import { describe, expect, test } from 'bun:test';
+import { receipt } from '../src/clients/headless/main.ts';
+import { runChanges } from '../src/core/loop/run.ts';
+import type { SessionEvent } from '../src/core/types.ts';
+import { changesFromPatch, findSlop, type FileChange } from '../src/core/trust/slop.ts';
+
+const change = (path: string, added: string[], removed: string[] = [], deleted = false): FileChange => ({ path, added, removed, deleted });
+const rules = (c: FileChange[]) => findSlop(c).map((f) => `${f.rule} ${f.path}`);
+
+describe('review findings', () => {
+  test('a path with spaces is read from the header, not the previous file', () => {
+    const patch = [
+      'diff --git a/src/a.ts b/src/a.ts',
+      '--- a/src/a.ts',
+      '+++ b/src/a.ts',
+      '@@ -1 +1 @@',
+      '-old',
+      '+new',
+      'diff --git a/my tests/a b.test.ts b/my tests/a b.test.ts',
+      'deleted file mode 100644',
+      '--- a/my tests/a b.test.ts',
+      '+++ /dev/null',
+      '@@ -1 +0,0 @@',
+      '-expect(1)',
+    ].join('\n');
+    expect(changesFromPatch(patch)).toEqual([
+      { path: 'src/a.ts', added: ['new'], removed: ['old'], deleted: false },
+      { path: 'my tests/a b.test.ts', added: [], removed: ['expect(1)'], deleted: true },
+    ]);
+    expect(rules(changesFromPatch(patch))).toEqual(['test-deleted my tests/a b.test.ts']);
+  });
+
+  test('a swallowed error split over two added lines is caught', () => {
+    expect(rules([change('app.py', ['try:', '    f()', 'except Exception:', '    pass'])])).toEqual(['swallowed-error app.py']);
+    expect(rules([change('src/a.ts', ['try {', '  f()', '} catch (e) {', '}'])])).toEqual(['swallowed-error src/a.ts']);
+  });
+
+  test('an `any` inside a string or comment is not a type escape', () => {
+    expect(rules([change('src/a.ts', ["throw new Error('invalid input: any value is rejected')", '// note: any caller may pass this'])])).toEqual([]);
+  });
+});
+
+describe('runChanges without snapshots', () => {
+  const edit = (path: string, edits: { old_text: string; new_text: string }[]): SessionEvent[] => [
+    { kind: 'tool_intent', callId: 'c1', tool: 'edit', input: { path, edits } },
+    { kind: 'tool_result', callId: 'c1', status: 'completed', output: { text: 'ok' } },
+  ] as unknown as SessionEvent[];
+
+  test('context lines copied from old_text are not counted as added', () => {
+    const changes = runChanges(edit('a.ts', [{ old_text: '// @ts-ignore\nx()', new_text: '// @ts-ignore\ny()' }]), '/tmp', undefined);
+    expect(changes).toEqual([{ path: 'a.ts', added: ['y()'], removed: ['x()'], deleted: false }]);
+    expect(findSlop(changes)).toEqual([]);
+  });
+});
+
+test('the receipt names the flags only when there are some', () => {
+  const base = { changed: ['a.ts'], checks: [], unverified: ['bun test'] };
+  expect(receipt(base)).toBe('cedia receipt: changed a.ts; checks none; unverified bun test');
+  expect(receipt({ ...base, flags: ['stub a.ts: throw'] })).toBe('cedia receipt: changed a.ts; checks none; unverified bun test; flags stub a.ts: throw');
+});
