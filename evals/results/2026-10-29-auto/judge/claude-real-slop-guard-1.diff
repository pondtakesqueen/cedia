+      const cut = line.slice(0, 120);
+      const hit = (rule: SlopRule) => out.push({ rule, path: c.path, line: cut });
+      if (test && SKIPPED.some((re) => re.test(line))) hit('test-skipped');
+      if (SUPPRESSION.some((re) => re.test(line))) hit('suppression');
+      const next = c.added[i + 1]?.trim();
+      if (SWALLOWED.some((re) => re.test(line)) || (/^except\b.*:$/.test(line) && next === 'pass') || (ts && emptyCatchAt(c.added, i))) hit('swallowed-error');
+      if (ts && TYPE_ESCAPE.some((re) => re.test(line))) hit('type-escape');
+      if (STUB.some((re) => re.test(line))) hit('stub');
+    });
+  }
+  return out;
+}
+
+// git quotes a path with non-ASCII, quotes or backslashes: "t\303\251.ts" holds UTF-8 octal bytes and C escapes.
+function unquote(quoted: string): string {
+  const raw = quoted.replace(/^"|"$/g, '').replace(/\\([0-7]{3}|.)/g, (_, e: string) => {
+    if (/^[0-7]{3}$/.test(e)) return String.fromCharCode(parseInt(e, 8));
+    return ({ n: '\n', t: '\t' } as Record<string, string>)[e] ?? e;
+  });
+  return Buffer.from(raw, 'latin1').toString('utf8');
+}
+
+// Splits one diff-tree -p -U0 patch into per-file changes. Lines before a file's first hunk are headers.
+export function changesFromPatch(patch: string): FileChange[] {
+  const out: FileChange[] = [];
+  let cur: FileChange | undefined;
+  let inHunk = false;
+  for (const line of patch.split('\n')) {
+    if (line.startsWith('diff --git ')) {
+      const q = line.indexOf(' "b/');
+      const i = line.lastIndexOf(' b/');
+      const path = q >= 0 ? unquote(line.slice(q + 1)).slice(2) : i >= 0 ? line.slice(i + 3) : line.slice('diff --git '.length);
+      cur = { path, added: [], removed: [], deleted: false };
+      out.push(cur);
+      inHunk = false;
+    } else if (!cur) {
+      continue;
+    } else if (line.startsWith('@@')) {
+      inHunk = true;
+    } else if (!inHunk) {
+      if (line.startsWith('deleted file mode')) cur.deleted = true;
+    } else if (line.startsWith('+')) {
+      cur.added.push(line.slice(1));
+    } else if (line.startsWith('-')) {
+      cur.removed.push(line.slice(1));
+    }
+  }
+  return out;
+}
+
+// Lines of a text, without the empty piece after a trailing newline.
+const lines = (s: string) => {
+  const xs = s.split('\n');
+  if (xs[xs.length - 1] === '') xs.pop();
+  return xs;
+};
+
+// Multiset difference: items of `a` not matched by an item of `b`, in order.
+function minus(a: string[], b: string[]): string[] {
+  const count = new Map<string, number>();
+  for (const x of b) count.set(x, (count.get(x) ?? 0) + 1);
+  return a.filter((x) => {
+    const n = count.get(x) ?? 0;
+    if (n === 0) return true;
+    count.set(x, n - 1);
+    return false;
+  });
+}
+
+// Fallback when there are no snapshots: derive changes from completed write and edit calls.
+export function changesFromCalls(events: SessionEvent[], cwd: string): FileChange[] {
+  const out: FileChange[] = [];
+  const intents = new Map<string, EventOf<'tool_intent'>>();
+  for (const e of events) {
+    if (e.kind === 'request') intents.clear();
+    if (e.kind === 'tool_intent' && (e.tool === 'write' || e.tool === 'edit')) intents.set(e.callId, e);
+    if (e.kind !== 'tool_result' || e.status !== 'completed') continue;
+    const intent = intents.get(e.callId);
+    if (!intent) continue;
+    const raw = String(intent.input.path);
+    const path = isAbsolute(raw) ? relative(cwd, raw) : raw;
+    if (intent.tool === 'write') {
+      out.push({ path, added: lines(String(intent.input.content ?? '')), removed: [], deleted: false });
+    } else {
+      const edits = (intent.input.edits ?? []) as { old_text: string; new_text: string }[];
+      const oldLines = edits.flatMap((x) => lines(x.old_text));
+      const newLines = edits.flatMap((x) => lines(x.new_text));
+      out.push({ path, added: minus(newLines, oldLines), removed: minus(oldLines, newLines), deleted: false });
+    }
+  }
+  return out;
+}
