+import { isAbsolute, relative } from 'node:path';
+import type { EventOf, SessionEvent } from '../types.ts';
+
+// Shortcuts in a run's own file changes that can make work look done. Patterns are heuristics over added lines.
+export type FileChange = { path: string; added: string[]; removed: string[]; deleted: boolean };
+export type SlopRule = 'test-deleted' | 'test-weakened' | 'test-skipped' | 'suppression' | 'swallowed-error' | 'type-escape' | 'stub';
+export type SlopFinding = { rule: SlopRule; path: string; line?: string };
+
+export const slopLabel = (f: SlopFinding) => `${f.rule} ${f.path}${f.line ? `: ${f.line}` : ''}`;
+
+const MAX_REMINDED = 20;
+
+export function slopReminder(fs: SlopFinding[]): string {
+  const shown = fs.slice(0, MAX_REMINDED).map((f) => `- ${slopLabel(f)}`);
+  const more = fs.length > MAX_REMINDED ? [`and ${fs.length - MAX_REMINDED} more`] : [];
+  return [
+    'cedia found shortcuts in your changes that can make work look done:',
+    ...shown,
+    ...more,
+    'Fix each one properly. If one is really needed, keep it and say why in your report; what is left is flagged in the receipt.',
+  ].join('\n');
+}
+
+const TEST_DIRS = new Set(['test', 'tests', '__tests__', 'spec']);
+const JS_TS = /\.(js|jsx|mjs|cjs|ts|tsx|mts|cts)$/;
+const TS = /\.(ts|tsx|mts|cts)$/;
+const CODE = /\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|py|go|rs|rb|java|kt|swift|c|h|cc|cpp|hpp|cs|php|scala|sh)$/;
+
+function isTestFile(path: string): boolean {
+  const parts = path.split('/');
+  const base = parts.pop()!;
+  if (parts.some((d) => TEST_DIRS.has(d))) return true;
+  return (
+    ((/\.(test|spec)\./.test(base)) && JS_TS.test(base)) ||
+    /^test_.*\.py$/.test(base) ||
+    /_test\.py$/.test(base) ||
+    /_test\.go$/.test(base) ||
+    /_spec\.rb$/.test(base) ||
+    /(Test\.java|Test\.kt)$/.test(base)
+  );
+}
+
+const ASSERT = /expect\(|\bassert[A-Za-z_]*\(|\bassert |\bshould\.|\bt\.(Error|Fatal|Fail)|\b(require|assert)\.|\bassert_eq!/;
+
+const SKIPPED = [
+  /(it|test|describe|context)\.(skip|todo|only)\b/,
+  /\bx(it|test|describe)\s*\(/,
+  /t\.Skip(Now|f)?\(/,
+  /@pytest\.mark\.skip/,
+  /pytest\.skip\(/,
+  /@unittest\.skip/,
+  /@Disabled\b/,
+  /@Ignore\b/,
+  /#\[ignore\]/,
+];
+
+const SUPPRESSION = [
+  /@ts-ignore/,
+  /@ts-nocheck/,
+  /@ts-expect-error/,
+  /eslint-disable/,
+  /biome-ignore/,
+  /#\s*type:\s*ignore/,
+  /#\s*noqa/,
+  /pylint:\s*disable/,
+  /#\[allow\(/,
+  /\/\/\s*nolint/,
+  /@SuppressWarnings/,
+  /istanbul ignore/,
+  /c8 ignore/,
+];
+
+const SWALLOWED = [
+  /catch\s*(\([^)]*\))?\s*\{\s*\}/,
+  /\.catch\(\s*\(\s*\)\s*=>\s*(\{\s*\}|undefined|null)\s*\)/,
+  /\bexcept\b[^:]*:\s*(pass|\.\.\.)\s*$/,
+];
+
+const TYPE_ESCAPE = [/\bas\s+any\b/, /\bas\s+unknown\s+as\b/, /<any>/, /:\s*any\s*([;,)=\]]|$)/];
+
+const STUB = [
+  /throw new \w*Error\(\s*["'`](todo|not implemented|not yet implemented)/i,
+  /raise NotImplementedError/,
+  /NotImplementedException/,
+  /unimplemented!/,
+  /todo!\(/,
+  /panic\("(todo|not implemented)/i,
+];
+
+const isAssertion = (line: string) => ASSERT.test(line);
+
+// A catch that opens on added line i and closes after only comment lines: the error is swallowed.
+const emptyCatchAt = (added: string[], i: number) => {
+  if (!/\bcatch\b[^{]*\{\s*$/.test(added[i]!.trim())) return false;
+  let j = i + 1;
+  while (j < added.length && /^(\/\/|\/\*|\*)/.test(added[j]!.trim())) j++;
+  return /^\}[;\s]*$/.test(added[j]?.trim() ?? '');
+};
+
+export function findSlop(changes: FileChange[]): SlopFinding[] {
+  const out: SlopFinding[] = [];
+  for (const c of changes) {
+    const test = isTestFile(c.path);
+    if (test && c.deleted) {
+      out.push({ rule: 'test-deleted', path: c.path });
+      continue;
+    }
+    if (c.deleted || !CODE.test(c.path)) continue;
