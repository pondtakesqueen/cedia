diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.edge.test.ts b/window.edge.test.ts
--- a/window.edge.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/window.edge.test.ts	2026-10-29 03:52:09.281304452 +0000
@@ -0,0 +1,96 @@
+import { expect, test } from "bun:test";
+import { distinctInWindow, type Event } from "./window";
+
+function naive(events: Event[], windowMs: number): number[] {
+  return events.map((e) => {
+    const keys = new Set<string>();
+    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
+    return keys.size;
+  });
+}
+
+test("unsorted input, and later entries with earlier times, count as in the window", () => {
+  const events = [
+    { t: 8, key: "a" },
+    { t: 0, key: "b" },
+    { t: 5, key: "a" },
+  ];
+  expect(distinctInWindow(events, 10)).toEqual([2, 1, 2]);
+});
+
+test("events with equal times are all in each other's window", () => {
+  const events = [
+    { t: 5, key: "a" },
+    { t: 5, key: "b" },
+    { t: 5, key: "a" },
+  ];
+  expect(distinctInWindow(events, 1)).toEqual([2, 2, 2]);
+});
+
+test("the lower window edge is excluded and the upper edge included", () => {
+  expect(
+    distinctInWindow(
+      [
+        { t: 0, key: "a" },
+        { t: 10, key: "b" },
+      ],
+      10,
+    ),
+  ).toEqual([1, 1]);
+});
+
+test("a window too small for the time's precision can hold no events", () => {
+  expect(distinctInWindow([{ t: 1e20, key: "a" }], 1)).toEqual([0]);
+});
+
+test("bad window and bad times are refused, in the same order as before", () => {
+  expect(() => distinctInWindow([], NaN)).toThrow(RangeError);
+  expect(() => distinctInWindow([], Infinity)).toThrow(RangeError);
+  expect(() => distinctInWindow([], -1)).toThrow(RangeError);
+  expect(() =>
+    distinctInWindow(
+      [
+        { t: 0, key: "a" },
+        { t: NaN, key: "b" },
+        { t: Infinity, key: "c" },
+      ],
+      10,
+    ),
+  ).toThrow(/event 1/);
+  expect(() => distinctInWindow([{ t: NaN, key: "a" }], 0)).toThrow(RangeError);
+});
+
+test("matches the straightforward version on random inputs", () => {
+  let seed = 42;
+  const rand = () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed / 2147483648;
+  };
+  const windows = [0.5, 1, 3, 10, 100];
+  for (let round = 0; round < 200; round++) {
+    const n = Math.floor(rand() * 60);
+    const events = Array.from({ length: n }, () => ({
+      t: rand() < 0.2 ? Math.floor(rand() * 30) + rand() : Math.floor(rand() * 30),
+      key: ["a", "b", "c", "d"][Math.floor(rand() * 4)],
+    }));
+    const w = windows[Math.floor(rand() * windows.length)];
+    expect(distinctInWindow(events, w)).toEqual(naive(events, w));
+  }
+});
+
+test("200,000 events finish in under a second", () => {
+  let seed = 7;
+  const rand = () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed / 2147483648;
+  };
+  const events = Array.from({ length: 200_000 }, () => ({
+    t: Math.floor(rand() * 1_000_000),
+    key: "k" + Math.floor(rand() * 1000),
+  }));
+  const start = performance.now();
+  const result = distinctInWindow(events, 5000);
+  const elapsed = performance.now() - start;
+  expect(result.length).toBe(200_000);
+  expect(elapsed).toBeLessThan(1000);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.ts b/window.ts
--- a/window.ts	2026-10-29 03:51:13.469556946 +0000
+++ b/window.ts	2026-10-29 03:52:09.277167035 +0000
@@ -16,9 +16,26 @@
   events.forEach((e, i) => {
     if (typeof e.t !== "number" || !Number.isFinite(e.t)) throw new TypeError(`event ${i} has no finite time: ${e.t}`);
   });
-  return events.map((e) => {
-    const keys = new Set<string>();
-    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
-    return keys.size;
-  });
+  const order = events.map((_, i) => i).sort((a, b) => events[a].t - events[b].t);
+  const counts = new Map<string, number>();
+  const result = new Array<number>(events.length);
+  let lo = 0;
+  let hi = 0;
+  while (hi < order.length) {
+    const t = events[order[hi]].t;
+    const start = hi;
+    for (; hi < order.length && events[order[hi]].t === t; hi++) {
+      const key = events[order[hi]].key;
+      counts.set(key, (counts.get(key) ?? 0) + 1);
+    }
+    const after = t - windowMs;
+    for (; lo < hi && events[order[lo]].t <= after; lo++) {
+      const key = events[order[lo]].key;
+      const n = counts.get(key)! - 1;
+      if (n === 0) counts.delete(key);
+      else counts.set(key, n);
+    }
+    for (let i = start; i < hi; i++) result[order[i]] = counts.size;
+  }
+  return result;
 }
