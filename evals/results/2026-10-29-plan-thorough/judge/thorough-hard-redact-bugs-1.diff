diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact-plural.test.ts b/redact-plural.test.ts
--- a/redact-plural.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact-plural.test.ts	2026-10-29 03:51:10.444829430 +0000
@@ -0,0 +1,15 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+const r = (s: string) => redactSecrets(s).text;
+
+test('plural secret names still redact their values', () => {
+  expect(r('AUTH_TOKENS=abc123def456')).toBe(`AUTH_TOKENS=${REDACTED}`);
+  expect(r('refresh_tokens: "abcd1234efgh5678"')).toBe(`refresh_tokens: "${REDACTED}"`);
+  expect(r('{"tokens": "abcd1234efgh5678"}')).toBe(`{"tokens": "${REDACTED}"}`);
+});
+
+test('count and limit names with tokens stay as written', () => {
+  expect(r('MAX_TOKENS=4096')).toBe('MAX_TOKENS=4096');
+  expect(r('max_tokens: 4096')).toBe('max_tokens: 4096');
+});
