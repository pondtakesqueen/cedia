 // - Empty commands are left out.
 // - Unbalanced quotes: return null.
 export function simpleCommands(command: string): string[][] | null {
-  throw new Error('not implemented');
+  return parse(command, 0, null)?.cmds ?? null;
+}
+
+// `value` is the word with quotes removed; `plain` has each quoted character replaced by 'x', so syntax checks
+// (assignments, keywords, redirections) see only unquoted text.
+type Word = { value: string; plain: string };
+
+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const SHELLS = new Set(['bash', 'sh', 'zsh', 'dash', 'ksh']);
+const SHELL_C_FLAG = /^-[A-Za-z]*c[A-Za-z]*$/;
+const REDIRECT_ONLY = /^(\d*(>>|>|<|>&)|&>)$/;
+const REDIRECT_START = /^(\d*[<>]|&>)/;
+const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;
+
+// Scans from `start` until the end of input, or until the `)` or backtick that closes a substitution (`end`).
+// Returns the commands found and the index after the scanned text, or null if quotes or substitutions are unbalanced.
+function parse(s: string, start: number, end: ')' | '`' | null): { cmds: string[][]; i: number } | null {
+  const out: string[][] = [];
+  let words: Word[] = [];
+  let nested: string[][] = [];
+  let cur: Word | null = null;
+  let depth = 0;
+  let i = start;
+
+  const append = (text: string, isQuoted = false) => {
+    cur ??= { value: '', plain: '' };
+    cur.value += text;
+    cur.plain += isQuoted ? 'x'.repeat(text.length) : text;
+  };
+  const endWord = () => {
+    if (cur) words.push(cur);
+    cur = null;
+  };
+  const endCommand = (): boolean => {
+    endWord();
+    const cmds = finish(words);
+    if (!cmds) return false;
+    out.push(...cmds, ...nested);
+    words = [];
+    nested = [];
+    return true;
+  };
+  // Parses the substitution whose text starts at `at`; returns the index after it, or null.
+  const substitution = (at: number, close: ')' | '`'): number | null => {
+    const sub = parse(s, at, close);
+    if (!sub) return null;
+    nested.push(...sub.cmds);
+    return sub.i;
+  };
+
+  while (i < s.length) {
+    const c = s[i];
+    if (c === ' ' || c === '\t') {
+      endWord();
+      i++;
+    } else if (c === '\n' || c === ';' || c === '|') {
+      if (!endCommand()) return null;
+      i++;
+    } else if (c === '&') {
+      if (cur?.plain.endsWith('>')) append(c);
+      else if (s[i + 1] === '>') {
+        endWord();
+        append(c);
+      } else if (!endCommand()) return null;
+      i++;
+    } else if (c === '<' || c === '>') {
+      if (cur && !/^(\d*|&)$/.test(cur.plain) && !/[<>]$/.test(cur.plain)) endWord();
+      append(c);
+      i++;
+    } else if (c === '(') {
+      if (!endCommand()) return null;
+      if (end === ')') depth++;
+      i++;
+    } else if (c === ')') {
+      if (!endCommand()) return null;
+      i++;
+      if (end === ')' && depth === 0) return { cmds: out, i };
+      if (depth > 0) depth--;
+    } else if (c === '`') {
+      if (end === '`') {
+        if (!endCommand()) return null;
+        return { cmds: out, i: i + 1 };
+      }
+      const next = substitution(i + 1, '`');
+      if (next === null) return null;
+      i = next;
+    } else if (c === '$' && s[i + 1] === '(') {
+      const next = substitution(i + 2, ')');
+      if (next === null) return null;
+      i = next;
+    } else if (c === "'") {
+      const close = s.indexOf("'", i + 1);
+      if (close < 0) return null;
+      append(s.slice(i + 1, close), true);
+      i = close + 1;
+    } else if (c === '"') {
+      i++;
+      while (s[i] !== '"') {
+        if (i >= s.length) return null;
+        if (s[i] === '\\' && i + 1 < s.length) {
+          append(s[i + 1], true);
+          i += 2;
+        } else if (s[i] === '$' && s[i + 1] === '(') {
+          const next = substitution(i + 2, ')');
+          if (next === null) return null;
+          i = next;
+        } else if (s[i] === '`') {
+          const next = substitution(i + 1, '`');
+          if (next === null) return null;
+          i = next;
+        } else {
+          append(s[i], true);
+          i++;
+        }
+      }
+      append('', true);
+      i++;
+    } else if (c === '\\') {
+      if (s[i + 1] !== '\n') append(s[i + 1] ?? '\\', true);
+      i += 2;
+    } else {
+      append(c);
+      i++;
+    }
+  }
+  if (end !== null) return null;
+  return endCommand() ? { cmds: out, i } : null;
+}
+
+// Turns the words of one simple command into argv, or into the commands it runs (wrappers, shells, eval).
+function finish(words: Word[]): string[][] | null {
+  let argv: Word[] = [];
+  for (let k = 0; k < words.length; k++) {
+    const w = words[k];
+    if (REDIRECT_ONLY.test(w.plain)) k++;
+    else if (REDIRECT_START.test(w.plain)) continue;
+    else argv.push(w);
+  }
+
+  for (;;) {
+    const w = argv[0];
+    if (w && (ASSIGNMENT.test(w.plain) || KEYWORDS.has(w.plain))) {
+      argv = argv.slice(1);
+      continue;
+    }
+    const wrapper = w && WRAPPERS.get(w.value.slice(w.value.lastIndexOf('/') + 1));
+    if (!wrapper) break;
+    let i = 1;
+    while (argv[i]?.value.startsWith('-')) {
+      const flag = argv[i++].value;
+      if (flag === '--') break;
+      if (wrapper.value?.includes(flag)) i++;
+    }
+    argv = argv.slice(i + (wrapper.positional ?? 0));
+  }
+  if (argv.length === 0) return [];
+
+  const values = argv.map((w) => w.value);
+  if (SHELLS.has(values[0].slice(values[0].lastIndexOf('/') + 1))) {
+    let k = 1;
+    while (k < values.length && values[k].startsWith('-') && values[k] !== '--' && !SHELL_C_FLAG.test(values[k])) k++;
+    if (k < values.length && SHELL_C_FLAG.test(values[k])) {
+      const script = values[k + 1] === '--' ? k + 2 : k + 1;
+      if (script < values.length) return simpleCommands(values[script]);
+    }
+  }
+  if (values[0] === 'eval') return simpleCommands(values.slice(1).join(' '));
+  return [values];
 }
