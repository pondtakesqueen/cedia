diff -ruN '--exclude=node_modules' '--exclude=.git' a/shell.edge.test.ts b/shell.edge.test.ts
--- a/shell.edge.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/shell.edge.test.ts	2026-10-29 01:42:52.584002991 +0000
@@ -0,0 +1,32 @@
+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+test('quoted assignments are still assignments', () => {
+  expect(simpleCommands('FOO="a b" rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands("FOO='' rm x")).toEqual([['rm', 'x']]);
+  expect(simpleCommands('FOO=a\\ b rm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('"FOO=1" rm x')).toEqual([['FOO=1', 'rm', 'x']]);
+});
+
+test('quoted redirect targets are dropped with their operator', () => {
+  expect(simpleCommands('>"out" rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('cmd 2>"/dev/null" arg')).toEqual([['cmd', 'arg']]);
+});
+
+test('a quoted operator character does not glue a following &', () => {
+  expect(simpleCommands('echo "x>"&rm -rf /')).toEqual([['echo', 'x>'], ['rm', '-rf', '/']]);
+  expect(simpleCommands('echo x\\>&rm -rf /')).toEqual([['echo', 'x>'], ['rm', '-rf', '/']]);
+  expect(simpleCommands("echo '>'&rm -rf /")).toEqual([['echo', '>'], ['rm', '-rf', '/']]);
+});
+
+test('a quoted word ends before an unquoted redirect', () => {
+  expect(simpleCommands('"a">out rm x')).toEqual([['a', 'rm', 'x']]);
+});
+
+test('shells called by path are unpacked', () => {
+  expect(simpleCommands("/bin/sh -c 'rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+});
+
+test('bash -c takes the script after an optional --', () => {
+  expect(simpleCommands("bash -c -- 'rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+});
