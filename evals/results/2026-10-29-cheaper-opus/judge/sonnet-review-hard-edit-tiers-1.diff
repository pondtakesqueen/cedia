     expect('error' in r && r.error).not.toContain('appears');
   });
 });
+
+describe('review cases', () => {
+  test('tier 3 ambiguity names both windows', () => {
+    const r = applyEdit('  x\n  y\n\tx\n\ty\n', { old_text: 'x\ny', new_text: 'z' });
+    expect('error' in r && r.error).toContain('matches 2 places (lines 1, 3)');
+  });
+  test('not-found lists at most 5 lines', () => {
+    const r = applyEdit('a\nxq\nxq\nxq\nxq\nxq\nxq\n', { old_text: 'xq\nzz', new_text: 'x' });
+    expect('error' in r && r.error).toContain('first line appears at line 2, 3, 4, 5, 6');
+    expect('error' in r && r.error).not.toContain('7');
+  });
+  test('replace_all reports first and last lines', () => {
+    const r = ok(applyEdit('a\nb\na\nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }));
+    expect(r.applied).toEqual({ from: 1, to: 4, tier: 'exact', count: 2 });
+    expect(r.content).toBe('c\nc\n');
+  });
+  test('old_text ending in newline reports one line', () => {
+    const r = ok(applyEdit('a\nb\nc\n', { old_text: 'b\n', new_text: 'B\n' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+    expect(r.content).toBe('a\nB\nc\n');
+  });
+  test('content without trailing newline', () => {
+    const r = ok(applyEdit('a \nb', { old_text: 'b\n', new_text: 'B' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'trailing-space', count: 1 });
+    expect(r.content).toBe('a \nB');
+  });
+  test('dedented new_text line is an error, not left unchanged', () => {
+    const r = applyEdit('a\n        b\n        c\n', { old_text: '    b\n    c', new_text: '  d\n    e' });
+    expect('error' in r && r.error).toContain('cannot re-indent');
+  });
+  test('CRLF content keeps CRLF in replaced lines', () => {
+    const r = ok(applyEdit('a  \r\nb\r\n', { old_text: 'a\nb', new_text: 'c\nd' }));
+    expect(r.content).toBe('c\r\nd\r\n');
+  });
+});
