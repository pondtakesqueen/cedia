 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text, replace_all } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create content' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same' };
+
+  // 1-based line of a character index
+  const lineAt = (idx: number) => content.slice(0, idx).split('\n').length;
+
+  const starts: number[] = [];
+  for (let i = content.indexOf(old_text); i !== -1; i = content.indexOf(old_text, i + old_text.length)) starts.push(i);
+  if (starts.length > 1 && !replace_all)
+    return { error: `old_text matches ${starts.length} places (first at line ${lineAt(starts[0])}); add context or set replace_all` };
+  if (starts.length > 0) {
+    const nl = old_text.split('\n').length - 1;
+    const trailing = old_text.endsWith('\n') ? 1 : 0;
+    return {
+      content: content.split(old_text).join(new_text),
+      applied: { from: lineAt(starts[0]), to: lineAt(starts[starts.length - 1]) + nl - trailing, tier: 'exact', count: starts.length },
+    };
+  }
+
+  const stripNl = (s: string) => (s.endsWith('\n') ? s.slice(0, -1) : s);
+  const oldLines = stripNl(old_text).split('\n');
+  const stripped = stripNl(new_text);
+  // a CRLF file gets CRLF on the inserted lines too
+  const eol = content.includes('\r\n') ? '\r' : '';
+  const newLines = stripped === '' ? [] : stripped.split('\n').map(l => l.replace(/\r$/, '') + eol);
+  const lines = content.split('\n');
+  const realCount = lines.length - (content.endsWith('\n') ? 1 : 0);
+  const firstNonBlank = (ls: string[]) => ls.find(l => l.trim() !== '') ?? '';
+
+  // start indexes of every window of lines equal to old_text under norm
+  const find = (norm: (s: string) => string) => {
+    const hits: number[] = [];
+    for (let i = 0; i + oldLines.length <= realCount; i++)
+      if (oldLines.every((o, k) => norm(lines[i + k]) === norm(o))) hits.push(i);
+    return hits;
+  };
+  const apply = (tier: Tier, hits: number[], replacement: (i: number) => string[]) => {
+    if (hits.length > 1) return { error: `old_text matches ${hits.length} places (lines ${hits.map(i => i + 1).join(', ')})` };
+    const i = hits[0];
+    lines.splice(i, oldLines.length, ...replacement(i));
+    return { content: lines.join('\n'), applied: { from: i + 1, to: i + oldLines.length, tier, count: 1 } };
+  };
+
+  const rtrimHits = find(s => s.trimEnd());
+  if (rtrimHits.length > 0) return apply('trailing-space', rtrimHits, () => newLines);
+
+  const trimHits = find(s => s.trim());
+  if (trimHits.length > 0) {
+    const indentOf = (s: string) => /^\s*/.exec(s)![0];
+    const oldIndent = indentOf(firstNonBlank(oldLines));
+    if (newLines.some(l => l.trim() !== '' && !l.startsWith(oldIndent)))
+      return { error: `new_text has a line indented less than old_text's first line (${oldIndent.length} columns); cannot re-indent` };
+    return apply('indentation', trimHits, i => {
+      const fileIndent = indentOf(firstNonBlank(lines.slice(i, i + oldLines.length)));
+      return newLines.map(l => (l.trim() !== '' && l.startsWith(oldIndent) ? fileIndent + l.slice(oldIndent.length) : l));
+    });
+  }
+
+  const first = firstNonBlank(oldLines).trim();
+  const hits = first === '' ? [] : lines.slice(0, realCount).flatMap((l, i) => (l.includes(first) ? [i + 1] : [])).slice(0, 5);
+  return { error: 'old_text not found' + (hits.length > 0 ? `; first line appears at line ${hits.join(', ')}` : '') };
 }
