diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact-tokens.test.ts b/redact-tokens.test.ts
--- a/redact-tokens.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact-tokens.test.ts	2026-10-29 01:38:09.275986150 +0000
@@ -0,0 +1,15 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+const r = (s: string) => redactSecrets(s).text;
+
+test('secrets whose names end in tokens are redacted', () => {
+  expect(r('AUTH_TOKENS=abcDEF123456789')).toBe(`AUTH_TOKENS=${REDACTED}`);
+  expect(r('GITHUB_TOKENS=ghs_realvalue1')).toBe(`GITHUB_TOKENS=${REDACTED}`);
+  expect(r('{"tokens": "abcd1234efgh5678"}')).toBe(`{"tokens": "${REDACTED}"}`);
+});
+
+test('token limits named with tokens are not redacted', () => {
+  expect(r('MAX_TOKENS=4096')).toBe('MAX_TOKENS=4096');
+  expect(r('LLM_MAX_TOKENS=4096')).toBe('LLM_MAX_TOKENS=4096');
+});
