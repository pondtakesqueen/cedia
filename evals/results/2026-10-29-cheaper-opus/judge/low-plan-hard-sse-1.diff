--- a/sse.review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.review.test.ts	2026-10-29 01:39:55.766159855 +0000
@@ -0,0 +1,34 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+test('breaking out early cancels the body', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: a\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const _m of readSse(body)) break;
+  expect(cancelled).toBe(true);
+});
+
+test('a body ending in a lone CR still yields the pending message', async () => {
+  expect(await all('data: x\n\r', 100)).toEqual([{ data: 'x' }]);
+});
+
+test('long lines in small chunks stay correct and fast', async () => {
+  const big = 'x'.repeat(80000);
+  const t = performance.now();
+  expect(await all('data: ' + big + '\n\n', 1)).toEqual([{ data: big }]);
+  expect(performance.now() - t).toBeLessThan(5000);
+});
