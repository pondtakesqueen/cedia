diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact.plural.test.ts b/redact.plural.test.ts
--- a/redact.plural.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact.plural.test.ts	2026-10-29 01:39:37.209208586 +0000
@@ -0,0 +1,15 @@
+import { expect, test } from 'bun:test';
+import { redactSecrets } from './redact.ts';
+
+test('plural secret names are still redacted', () => {
+  expect(redactSecrets('AWS_SECRETS=abc123xyz').count).toBe(1);
+  expect(redactSecrets('DB_PASSWORDS=hunter2').count).toBe(1);
+  expect(redactSecrets('{"api_keys": "abcd1234efgh"}').count).toBe(1);
+  expect(redactSecrets('GITHUB_TOKENS=abcd1234efgh').count).toBe(1);
+  expect(redactSecrets('TOKENS_FILE=abcd1234efgh').count).toBe(1);
+  expect(redactSecrets('"secrets": "hunter22"').count).toBe(1);
+});
+
+test('a numeric token count is not a secret', () => {
+  expect(redactSecrets('MAX_TOKENS=4096').count).toBe(0);
+});
