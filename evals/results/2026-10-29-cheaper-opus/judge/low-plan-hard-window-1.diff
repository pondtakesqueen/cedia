diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.cases.test.ts b/window.cases.test.ts
--- a/window.cases.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/window.cases.test.ts	2026-10-29 01:42:13.008000638 +0000
@@ -0,0 +1,154 @@
+import { expect, test } from "bun:test";
+import { distinctInWindow, type Event } from "./window";
+
+// The original quadratic implementation, kept here as the reference the fast one must match.
+function naive(events: Event[], windowMs: number): number[] {
+  return events.map((e) => {
+    const keys = new Set<string>();
+    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
+    return keys.size;
+  });
+}
+
+test("unsorted input keeps the order of events", () => {
+  expect(
+    distinctInWindow(
+      [
+        { t: 8, key: "a" },
+        { t: 0, key: "b" },
+        { t: 5, key: "a" },
+      ],
+      10,
+    ),
+  ).toEqual([2, 1, 2]);
+});
+
+test("events with the same time see each other", () => {
+  expect(
+    distinctInWindow(
+      [
+        { t: 5, key: "a" },
+        { t: 5, key: "b" },
+      ],
+      10,
+    ),
+  ).toEqual([2, 2]);
+});
+
+test("the window excludes t - windowMs and includes t", () => {
+  expect(
+    distinctInWindow(
+      [
+        { t: 0, key: "a" },
+        { t: 10, key: "b" },
+      ],
+      10,
+    ),
+  ).toEqual([1, 1]);
+});
+
+test("large times keep the exact window arithmetic", () => {
+  expect(distinctInWindow([{ t: 1e17, key: "a" }], 1)).toEqual([0]);
+});
+
+test("keys are compared as exact strings", () => {
+  expect(
+    distinctInWindow(
+      [
+        { t: 1, key: "1" },
+        { t: 2, key: "01" },
+      ],
+      10,
+    ),
+  ).toEqual([1, 2]);
+});
+
+test("a non-finite or negative window is refused", () => {
+  const events = [{ t: 1, key: "a" }];
+  expect(() => distinctInWindow(events, NaN)).toThrow(RangeError);
+  expect(() => distinctInWindow(events, Infinity)).toThrow(RangeError);
+  expect(() => distinctInWindow(events, -1)).toThrow(RangeError);
+});
+
+test("a bad window is reported before a bad time", () => {
+  expect(() => distinctInWindow([{ t: NaN, key: "a" }], 0)).toThrow(RangeError);
+});
+
+test("a hole next to a real event is refused, as before", () => {
+  const sparse: Event[] = [{ t: 0, key: "a" }, , { t: 1, key: "b" }];
+  expect(() => distinctInWindow(sparse, 10)).toThrow(/event 1/);
+});
+
+test("an array of only holes keeps its holes", () => {
+  expect(distinctInWindow(new Array<Event>(2), 10).length).toBe(2);
+});
+
+test("large times and tiny windows match the reference", () => {
+  const events: Event[] = [
+    { t: 2 ** 53, key: "a" },
+    { t: 2 ** 53 + 2, key: "b" },
+    { t: 2 ** 53 + 4, key: "c" },
+    { t: 1e300, key: "d" },
+    { t: -1e300, key: "e" },
+  ];
+  for (const windowMs of [1, 2, 3, 4, 5]) {
+    expect(distinctInWindow(events, windowMs)).toEqual(naive(events, windowMs));
+  }
+});
+
+test("a bad time names the first bad event", () => {
+  expect(() =>
+    distinctInWindow(
+      [
+        { t: 0, key: "a" },
+        { t: NaN, key: "b" },
+      ],
+      10,
+    ),
+  ).toThrow(/event 1/);
+});
+
+test("matches the quadratic reference on random inputs", () => {
+  let seed = 12345;
+  const rand = () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed / 2147483648;
+  };
+  for (let run = 0; run < 200; run++) {
+    const n = Math.floor(rand() * 51);
+    const events: Event[] = [];
+    for (let i = 0; i < n; i++) {
+      const t = rand() < 0.2 ? Math.round(rand() * 40) / 4 : Math.floor(rand() * 20);
+      events.push({ t, key: `k${Math.floor(rand() * 5)}` });
+    }
+    for (const windowMs of [1, 3, 2.5, 100]) {
+      expect(distinctInWindow(events, windowMs)).toEqual(naive(events, windowMs));
+    }
+  }
+});
+
+// The reference count for one event, so large inputs can be spot-checked without the quadratic pass.
+function naiveAt(events: Event[], index: number, windowMs: number): number {
+  const e = events[index];
+  const keys = new Set<string>();
+  for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
+  return keys.size;
+}
+
+test("200,000 events finish in under a second and match the reference", () => {
+  let seed = 987654;
+  const rand = () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed / 2147483648;
+  };
+  const events: Event[] = [];
+  for (let i = 0; i < 200_000; i++) events.push({ t: Math.floor(rand() * 1e6), key: `k${Math.floor(rand() * 1000)}` });
+  const start = performance.now();
+  const counts = distinctInWindow(events, 1000);
+  expect(performance.now() - start).toBeLessThan(1000);
+  expect(counts.length).toBe(200_000);
+  for (let k = 0; k < 10; k++) {
+    const i = Math.floor(rand() * events.length);
+    expect(counts[i]).toBe(naiveAt(events, i, 1000));
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.ts b/window.ts
--- a/window.ts	2026-10-29 01:40:17.290458082 +0000
+++ b/window.ts	2026-10-29 01:42:09.909854247 +0000
@@ -16,9 +16,35 @@
   events.forEach((e, i) => {
     if (typeof e.t !== "number" || !Number.isFinite(e.t)) throw new TypeError(`event ${i} has no finite time: ${e.t}`);
   });
-  return events.map((e) => {
-    const keys = new Set<string>();
-    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
-    return keys.size;
-  });
+  // Sweep the events in time order. Each group of equal times is added whole, then events at or before
+  // `t - windowMs` are dropped, so the map holds exactly the keys of the window.
+  const present = events.flatMap((_, i) => [i]);
+  if (present.length > 0 && present.length < events.length) {
+    const hole = events.findIndex((_, i) => !(i in events));
+    throw new TypeError(`event ${hole} has no finite time: undefined`);
+  }
+  const order = present.sort((a, b) => events[a].t - events[b].t);
+  const counts = new Map<string, number>();
+  const out = new Array<number>(events.length);
+  let lo = 0;
+  let hi = 0;
+  while (hi < order.length) {
+    const t = events[order[hi]].t;
+    const start = hi;
+    while (hi < order.length && events[order[hi]].t === t) {
+      const key = events[order[hi]].key;
+      counts.set(key, (counts.get(key) ?? 0) + 1);
+      hi++;
+    }
+    const bound = t - windowMs;
+    while (lo < hi && events[order[lo]].t <= bound) {
+      const key = events[order[lo]].key;
+      const left = counts.get(key)! - 1;
+      if (left === 0) counts.delete(key);
+      else counts.set(key, left);
+      lo++;
+    }
+    for (let k = start; k < hi; k++) out[order[k]] = counts.size;
+  }
+  return out;
 }
