diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 01:45:26.016012111 +0000
@@ -0,0 +1,49 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('exactly 10 units of one SKU get the 5% tier', () => {
+    // 10 pens = 1200; 5% off = 60 -> 1140; shipping 800 (under 5000); tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('9 units of one SKU get no bulk discount', () => {
+    // 9 pens = 1080; no discount; shipping 800; tax 7% of 1880 = 131.6 -> 132
+    expect(totals(cart('US', [['PEN', 9]]))).toMatchObject({ subtotal: 1080, shipping: 800, tax: 132, total: 2012 });
+  });
+
+  test('49 units of one SKU get the 5% tier, not the 10% tier', () => {
+    // 49 pens = 5880; 5% off = 294 -> 5586 (10% would give 5292); shipping free; tax 7% of 5586 = 391.02 -> 391
+    expect(totals(cart('US', [['PEN', 49]]))).toMatchObject({ subtotal: 5586, shipping: 0, tax: 391, total: 5977 });
+  });
+
+  test('exactly 50 units of one SKU get the 10% tier', () => {
+    // 50 pens = 6000; 10% off = 600 -> 5400; shipping free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same SKU are merged before the bulk tier is picked', () => {
+    // 6 + 4 mugs = 10 mugs = 4500; 5% off = 225 -> 4275; shipping 800; tax 7% of 5075 = 355.25 -> 355
+    const t = totals(cart('US', [['MUG', 6], ['MUG', 4]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ quantity: 10 });
+    expect(t).toMatchObject({ subtotal: 4275, shipping: 800, tax: 355, total: 5430 });
+  });
+
+  test('shipping threshold uses the amount after the coupon', () => {
+    // 4 tees = 6000; FLAT5 -> 5500, under 6000 so shipping 900; tax 20% of 6400 = 1280
+    expect(totals(cart('EU', [['TEE', 4]], 'FLAT5'))).toMatchObject({ subtotal: 6000, coupon: 500, shipping: 900, tax: 1280, total: 7680 });
+  });
+
+  test('UK under 4000 still pays shipping', () => {
+    // 2200 + 1200 + 4 * 120 = 3880 < 4000; shipping 700; tax 20% of 4580 = 916
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 4]]))).toMatchObject({ subtotal: 3880, shipping: 700, tax: 916, total: 5496 });
+  });
+
+  test('UK ships free from exactly 4000', () => {
+    // 2200 + 1200 + 5 * 120 = 4000 >= 4000; shipping 0; tax 20% of 4000 = 800
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+});
