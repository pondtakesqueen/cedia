--- a/ledger.review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.review.test.ts	2026-10-29 01:36:03.407362796 +0000
@@ -0,0 +1,29 @@
+import { describe, expect, test } from 'bun:test';
+import { ledgerEntries, matchCheck, verified, type LedgerEntry } from './ledger.ts';
+
+describe('review findings', () => {
+  test('F1: a declared check that starts with the cd prefix matches itself', () => {
+    expect(matchCheck('cd /work/repo && bun test', ['cd /work/repo && bun test'], '/work/repo')).toBe('cd /work/repo && bun test');
+  });
+
+  test('F2: quoted cd directory keeps its inner spaces', () => {
+    expect(matchCheck('cd "/work/my  repo" && bun test', ['bun test'], '/work/my  repo')).toBe('bun test');
+  });
+
+  test('F3: a doubled trailing 2>&1 matches the same as without the cd', () => {
+    expect(matchCheck('cd . && bun test 2>&1 2>&1', ['bun test'], '/work/repo')).toBe(matchCheck('bun test 2>&1 2>&1', ['bun test'], '/work/repo'));
+  });
+
+  test('F4: an edit without a string path is not a write with path undefined', () => {
+    const events = [
+      { kind: 'tool_intent' as const, callId: 'a', tool: 'edit', input: { file_path: 'x.ts' } },
+      { kind: 'tool_result' as const, callId: 'a', status: 'completed' as const, output: { isError: false } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([]);
+  });
+
+  test('F5: verified does not overflow the stack on a long log', () => {
+    const entries: LedgerEntry[] = Array.from({ length: 300000 }, (_, i) => ({ kind: 'write' as const, at: i, tool: 'edit', path: 'a' }));
+    expect(verified(entries, ['bun test'])).toBe(false);
+  });
+});
