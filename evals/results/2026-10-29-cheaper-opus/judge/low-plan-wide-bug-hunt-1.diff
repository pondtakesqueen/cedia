diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 01:43:57.668006859 +0000
@@ -0,0 +1,46 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('UK free shipping starts at 4000', () => {
+    // 2 caps + 1 tee = 3900 < 4000; shipping 700
+    expect(totals(cart('UK', [['CAP', 2], ['TEE', 1]]))).toMatchObject({ subtotal: 3900, shipping: 700 });
+    // 2 bags = 4400 >= 4000; shipping 0; tax 20% of 4400 = 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+
+  test('bulk discount applies at exactly 10 units', () => {
+    // 10 pens = 1200; 5% off = 60; 1140 discounted; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('bulk discount applies at exactly 50 units', () => {
+    // 50 pens = 6000; 10% off = 600; 5400 discounted; free shipping; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same sku count together for bulk discounts', () => {
+    // 5 + 5 pens = 10 pens, so the same 5% tier as above
+    const t = totals(cart('US', [['PEN', 5], ['PEN', 5]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('shipping threshold uses the discounted subtotal', () => {
+    // 2 bags + 5 pens = 5000; SAVE10 takes 500 -> 4500 < 5000; shipping 800; tax 7% of 5300 = 371
+    expect(totals(cart('US', [['BAG', 2], ['PEN', 5]], 'SAVE10'))).toMatchObject({
+      subtotal: 5000,
+      coupon: 500,
+      shipping: 800,
+      tax: 371,
+      total: 5671,
+    });
+  });
+
+  test('FLAT5 never takes an amount below zero', () => {
+    // 1 pen = 120; FLAT5 takes only 120, leaving 0; shipping 800; tax 7% of 800 = 56
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ subtotal: 120, coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+});
