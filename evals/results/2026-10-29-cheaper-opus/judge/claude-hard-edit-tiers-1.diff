diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.review.test.ts b/edit.review.test.ts
--- a/edit.review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.review.test.ts	2026-10-29 01:35:19.007976029 +0000
@@ -0,0 +1,39 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+
+describe('CRLF files', () => {
+  test('trailing-space tier keeps CRLF endings', () => {
+    const r = ok(applyEdit('a\r\nb  \r\nc\r\n', { old_text: 'a\nb', new_text: 'A\nB' }));
+    expect(r.content).toBe('A\r\nB\r\nc\r\n');
+  });
+  test('indentation tier keeps CRLF endings', () => {
+    const r = ok(applyEdit('x\r\n  a\r\n  b\r\ny\r\n', { old_text: 'a\nb', new_text: 'a\nc' }));
+    expect(r.content).toBe('x\r\n  a\r\n  c\r\ny\r\n');
+  });
+});
+
+describe('untested branches', () => {
+  test('not-found pointer lists at most 5 lines', () => {
+    const r = applyEdit('x\n'.repeat(7), { old_text: 'x\nq', new_text: 'z' });
+    expect('error' in r && r.error).toContain('line 1, 2, 3, 4, 5');
+    expect('error' in r && r.error).not.toContain('6');
+  });
+  test('indentation tier ambiguity names the lines', () => {
+    const r = applyEdit('\ta\nq\n\ta\nq\n', { old_text: '  a\nq', new_text: 'b' });
+    expect('error' in r && r.error).toContain('matches 2 places');
+    expect('error' in r && r.error).toContain('lines 1, 3');
+  });
+  test('replace_all reports from/to of first and last match', () => {
+    const r = ok(applyEdit('x\ny\nx\n', { old_text: 'x', new_text: 'z', replace_all: true }));
+    expect(r.applied).toEqual({ from: 1, to: 3, tier: 'exact', count: 2 });
+  });
+  test('new_text line indented less than old_text is left unchanged', () => {
+    const r = ok(applyEdit('    if (a) {\n        x();\n    }\n', { old_text: '    if (a) {\n        x();', new_text: '  if (b) {\n        y();' }));
+    expect(r.content).toBe('  if (b) {\n        y();\n    }\n');
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-29 01:32:50.446886906 +0000
