@@ -1,4 +1,4 @@
-// Lines written through oldLog before 1.4 had no level prefix; the parser below accepts both.
+// Lines written by the deprecated logger before 1.4 had no level prefix; the parser below accepts both.
 export function parseLine(line: string): { level: string; msg: string } {
   const m = /^(DEBUG|INFO|WARN|ERROR) (.*)$/.exec(line);
   return m ? { level: m[1]!.toLowerCase(), msg: m[2]! } : { level: 'info', msg: line };
