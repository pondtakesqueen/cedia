diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 01:45:32.268824820 +0000
+++ b/src/slug.ts	2026-10-29 01:46:44.612711994 +0000
@@ -11,10 +11,26 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  if (slug[max] === '-') return slug.slice(0, max);
+  const cut = slug.slice(0, max);
+  const i = cut.lastIndexOf('-');
+  return i > 0 ? cut.slice(0, i) : cut;
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/rules.test.ts b/test/rules.test.ts
--- a/test/rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/rules.test.ts	2026-10-29 01:47:37.220019910 +0000
@@ -0,0 +1,132 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+import { LRU } from '../src/lru.ts';
+
+test('parseDuration accepts', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1m30s')).toBe(90_000);
+  expect(parseDuration('0.0005s')).toBe(1);
+});
+
+test('parseDuration rejects', () => {
+  for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '1.h', '1H', '5\\x', '1h\t30m x', '1h"']) {
+    expect(() => parseDuration(bad)).toThrow(bad);
+  }
+});
+
+test('formatDuration', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(250)).toBe('250ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(() => formatDuration(-1)).toThrow();
+});
+
+test('slugify rules', () => {
+  expect(slugify('  --Hello__World--  ')).toBe('hello-world');
+  expect(slugify('Stra\u00dfe')).toBe('strasse');
+  expect(slugify('\u00c6r\u00f8 \u0141\u00f3d\u017a')).toBe('aero-lodz');
+  expect(slugify('\u0152uvre')).toBe('oeuvre');
+  expect(slugify('\u0110ak')).toBe('dak');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cdef', 5)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab-cd', 3)).toBe('ab');
+  expect(slugify('abc', 5)).toBe('abc');
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set(['other']))).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+});
+
+test('lru get refreshes recency', () => {
+  let t = 0;
+  const reasons: string[] = [];
+  const cache = new LRU<string, number>(2, 10_000, () => t);
+  cache.onEvict = (k, _v, r) => reasons.push(`${k}:${r}`);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(reasons).toEqual(['b:capacity']);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('lru ttl boundary', () => {
+  let t = 0;
+  const reasons: string[] = [];
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = (k, _v, r) => reasons.push(`${k}:${r}`);
+  cache.set('a', 1);
+  t = 999;
+  expect(cache.get('a')).toBe(1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+  expect(reasons).toEqual(['a:expired']);
+});
+
+test('lru purges expired before live on capacity', () => {
+  let t = 0;
+  const reasons: string[] = [];
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = (k, _v, r) => reasons.push(`${k}:${r}`);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1200;
+  cache.set('c', 3);
+  expect(reasons).toEqual(['a:expired']);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('lru delete', () => {
+  let t = 0;
+  const reasons: string[] = [];
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.onEvict = (k, _v, r) => reasons.push(`${k}:${r}`);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  t = 1000;
+  expect(cache.delete('b')).toBe(false);
+  expect(cache.delete('zzz')).toBe(false);
+  expect(reasons).toEqual(['a:delete', 'b:expired']);
+});
+
+test('lru size and keys skip expired but count toward capacity', () => {
+  let t = 0;
+  const reasons: string[] = [];
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = (k, _v, r) => reasons.push(`${k}:${r}`);
+  cache.set('a', 1);
+  t = 600;
+  cache.set('b', 2);
+  t = 1100;
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(reasons).toEqual([]);
+  cache.set('c', 3);
+  expect(reasons).toEqual(['a:expired']);
+});
+
+test('lru overwrite fires nothing and refreshes ttl', () => {
+  let t = 0;
+  const reasons: string[] = [];
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = (k, _v, r) => reasons.push(`${k}:${r}`);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  t = 900;
+  cache.set('a', 9);
+  expect(reasons).toEqual([]);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  t = 1500;
+  expect(cache.get('a')).toBe(9);
+});
