diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.review.test.ts b/deny.review.test.ts
--- a/deny.review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.review.test.ts	2026-10-29 01:33:06.370275446 +0000
@@ -0,0 +1,24 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const name = (argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('find with options before the start path', () => {
+  expect(name(['find', '-L', '/', '-delete'])).toBe('rm-outside');
+  expect(name(['find', '-H', '/', '-delete'])).toBe('rm-outside');
+  expect(name(['find', '-O3', '/', '-delete'])).toBe('rm-outside');
+  expect(name(['find', '-L', 'src', '-delete'])).toBeUndefined();
+});
+
+test('abbreviated long options', () => {
+  expect(name(['rm', '--recur', '-f', '/etc'])).toBe('rm-outside');
+  expect(name(['git', 'reset', '--har'])).toBe('reset-hard');
+  expect(name(['git', 'push', '--mirr'])).toBe('force-push');
+  expect(name(['git', 'clean', '--forc'])).toBe('clean-force');
+  expect(name(['git', 'clean', '--force', '-n'])).toBeUndefined();
+});
+
+test('command substitution in targets', () => {
+  expect(name(['rm', '-rf', '`echo /`'])).toBe('rm-outside');
+});
