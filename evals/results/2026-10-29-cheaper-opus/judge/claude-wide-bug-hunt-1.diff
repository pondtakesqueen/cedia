diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing.test.ts b/test/pricing.test.ts
--- a/test/pricing.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing.test.ts	2026-10-29 01:45:10.632011197 +0000
@@ -0,0 +1,33 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('bulk discount applies at exactly 10 units', () => {
+    // 10 pens = 1200; 5% off = 60 -> 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('bulk discount applies at exactly 50 units', () => {
+    // 50 pens = 6000; 10% off = 600 -> 5400, free shipping; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same sku count together for bulk', () => {
+    // 6 + 4 pens merge to 10 units, so the same totals as 10 pens
+    const t = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('shipping threshold uses the amount after the coupon', () => {
+    // 1 bag + 2 tees = 5200; SAVE10 takes 520 -> 4680 < 5000, so shipping 800; tax 7% of 5480 = 383.6 -> 384
+    expect(totals(cart('US', [['BAG', 1], ['TEE', 2]], 'SAVE10'))).toMatchObject({ subtotal: 5200, coupon: 520, shipping: 800, tax: 384, total: 5864 });
+  });
+
+  test('UK ships free from exactly 4000', () => {
+    // 1 bag + 1 cap + 5 pens = 4000 -> free shipping; tax 20% = 800
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+});
