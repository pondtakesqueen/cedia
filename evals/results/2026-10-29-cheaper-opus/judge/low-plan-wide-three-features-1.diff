diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 01:44:20.176707316 +0000
+++ b/src/slug.ts	2026-10-29 01:45:05.652013965 +0000
@@ -11,10 +11,26 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const LETTERS: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => LETTERS[c])
+    .normalize('NFKD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  if (slug[max] === '-') return slug.slice(0, max);
+  const cut = slug.slice(0, max);
+  const i = cut.lastIndexOf('-');
+  return i > 0 ? cut.slice(0, i) : cut;
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 01:46:33.133944640 +0000
@@ -0,0 +1,24 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parses fractions, compound and spaced parts', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration(' 1m ')).toBe(60_000);
+  expect(parseDuration('1m30s')).toBe(90_000);
+  expect(parseDuration('1.0004s')).toBe(1000);
+});
+
+test('rejects invalid input', () => {
+  for (const bad of ['', '10', 'h', '-1s', '9'.repeat(400) + 'd']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
+
+test('formats shortest text', () => {
+  expect(formatDuration(1500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(86_400_000 + 1)).toBe('1d1ms');
+  expect(() => formatDuration(-1)).toThrow();
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 01:46:33.148016102 +0000
@@ -0,0 +1,83 @@
+import { expect, test } from 'bun:test';
+import { LRU, type EvictReason } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const evicted: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => evicted.push([k, v, r]);
+  return { cache, evicted, setTime: (x: number) => (t = x) };
+}
+
+test('get promotes the entry', () => {
+  const { cache, evicted } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(evicted).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('expired entries are evicted before live ones', () => {
+  const { cache, evicted, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(500);
+  cache.set('b', 2);
+  setTime(1200);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+});
+
+test('capacity counts expired entries', () => {
+  const { cache, evicted, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(1000);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+});
+
+test('delete reports live and expired entries', () => {
+  const { cache, evicted, setTime } = setup(5, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  setTime(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(cache.delete('zzz')).toBe(false);
+  expect(evicted).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('size and keys skip expired entries', () => {
+  const { cache, setTime } = setup(5, 1000);
+  cache.set('a', 1);
+  setTime(600);
+  cache.set('b', 2);
+  setTime(1000);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+});
+
+test('re-setting a key does not evict and refreshes ttl', () => {
+  const { cache, evicted, setTime } = setup(5, 1000);
+  cache.set('a', 1);
+  setTime(900);
+  cache.set('a', 2);
+  setTime(1500);
+  expect(cache.get('a')).toBe(2);
+  expect(evicted).toEqual([]);
+});
+
+test('ttl boundary: expires at set time plus ttl', () => {
+  const { cache, evicted, setTime } = setup(5, 1000);
+  cache.set('a', 1);
+  setTime(999);
+  expect(cache.get('a')).toBe(1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 01:46:33.140982770 +0000
@@ -0,0 +1,24 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('special letters and diacritics', () => {
+  expect(slugify('Straße Æon Œuvre Øl Łódź Đak')).toBe('strasse-aeon-oeuvre-ol-lodz-dak');
+  expect(slugify('ñ ç ź')).toBe('n-c-z');
+});
+
+test('separator runs collapse and edges are trimmed', () => {
+  expect(slugify('--a  b--')).toBe('a-b');
+});
+
+test('max cuts at a dash or at max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cdef', 5)).toBe('ab');
+  expect(slugify('abcdefg', 5)).toBe('abcde');
+  expect(slugify('abc', 5)).toBe('abc');
+  expect(slugify('abcd-ef', 5)).toBe('abcd');
+});
+
+test('uniqueSlug finds the first free suffix', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['other']))).toBe('post');
+});
