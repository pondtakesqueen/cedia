diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.regress.test.ts b/sse.regress.test.ts
--- a/sse.regress.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.regress.test.ts	2026-10-29 01:40:57.959996177 +0000
@@ -0,0 +1,34 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString } from './sse.ts';
+
+test('breaking out early cancels the body', async () => {
+  const enc = new TextEncoder();
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'x' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
+
+test('a long line in small chunks is parsed in linear time', async () => {
+  const time = async (n: number) => {
+    const start = performance.now();
+    const out = [];
+    for await (const m of readSse(streamFromString('data: ' + 'a'.repeat(n) + '\n\n', 1))) out.push(m);
+    expect(out).toEqual([{ data: 'a'.repeat(n) }]);
+    return performance.now() - start;
+  };
+  await time(1000);
+  const small = await time(100_000);
+  const large = await time(200_000);
+  expect(large / small).toBeLessThan(3);
+});
