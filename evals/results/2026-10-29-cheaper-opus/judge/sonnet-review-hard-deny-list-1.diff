+++ b/deny.dotnames.test.ts	2026-10-29 01:32:10.585087034 +0000
@@ -0,0 +1,14 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+
+test('names starting with two dots inside cwd are not outside', () => {
+  expect(denyListed(['rm', '-r', '..cache'], cwd)).toBeUndefined();
+  expect(denyListed(['find', '..cache', '-delete'], cwd)).toBeUndefined();
+});
+
+test('real parent paths are still outside', () => {
+  expect(denyListed(['rm', '-r', '..'], cwd)?.name).toBe('rm-outside');
+  expect(denyListed(['rm', '-r', '../x'], cwd)?.name).toBe('rm-outside');
+});
