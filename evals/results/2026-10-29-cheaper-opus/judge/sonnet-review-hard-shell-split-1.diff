--- a/shell.review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/shell.review.test.ts	2026-10-29 01:44:23.428008391 +0000
@@ -0,0 +1,52 @@
+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+test('substitutions are words: they do not shift redirect targets or wrapper values', () => {
+  expect(simpleCommands('> $(echo f) rm -rf /')).toEqual([['rm', '-rf', '/'], ['echo', 'f']]);
+  expect(simpleCommands('sudo -u $(whoami) rm -rf /')).toEqual([['rm', '-rf', '/'], ['whoami']]);
+  expect(simpleCommands('nice -n $(x) make')).toEqual([['make'], ['x']]);
+  expect(simpleCommands('cmd >$(echo f) arg')).toEqual([['cmd', 'arg'], ['echo', 'f']]);
+});
+
+test('a substitution in command position keeps an empty command name', () => {
+  expect(simpleCommands('$(echo rm) -rf /')).toEqual([['', '-rf', '/'], ['echo', 'rm']]);
+});
+
+test('escaped nested backticks are unpacked', () => {
+  expect(simpleCommands('echo `echo \\`rm -rf /\\``')).toEqual([['echo'], ['echo'], ['rm', '-rf', '/']]);
+});
+
+test('arithmetic expansion is not a command, but substitutions inside it are', () => {
+  expect(simpleCommands('echo $((i+1))')).toEqual([['echo']]);
+  expect(simpleCommands('echo $((1 + $(rm x)))')).toEqual([['echo'], ['rm', 'x']]);
+});
+
+test('>| is a redirection, not a pipe', () => {
+  expect(simpleCommands('echo x >| out')).toEqual([['echo', 'x']]);
+});
+
+test('substitutions inside double quotes are commands', () => {
+  expect(simpleCommands('echo "$(rm x)"')).toEqual([['echo', ''], ['rm', 'x']]);
+  expect(simpleCommands('echo "`rm x`"')).toEqual([['echo', ''], ['rm', 'x']]);
+});
+
+test('unclosed substitutions and eval return null', () => {
+  expect(simpleCommands('echo $(rm x')).toBeNull();
+  expect(simpleCommands('eval "rm x')).toBeNull();
+  expect(simpleCommands('bash -c "rm x')).toBeNull();
+});
+
+test('redirections glued to words and fd duplications', () => {
+  expect(simpleCommands('cmd &>log arg')).toEqual([['cmd', 'arg']]);
+  expect(simpleCommands('cmd x>&2 arg')).toEqual([['cmd', 'x', 'arg']]);
+});
+
+test('-- and positional operands in wrappers', () => {
+  expect(simpleCommands('sudo -- rm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('timeout 5 make')).toEqual([['make']]);
+});
+
+test('bash -c after other shell options, and bash -c with no script', () => {
+  expect(simpleCommands('bash -O extglob -c "rm -rf /"')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('bash -c')).toEqual([['bash', '-c']]);
+});
