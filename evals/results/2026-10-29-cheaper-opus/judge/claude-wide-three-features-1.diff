@@ -11,10 +11,25 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  if (slug[max] === '-') return slug.slice(0, max);
+  const cut = slug.lastIndexOf('-', max - 1);
+  return cut > 0 ? slug.slice(0, cut) : slug.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 01:47:57.169194771 +0000
@@ -0,0 +1,34 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parseDuration accepts the documented forms', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(2 * 86_400_000 + 4 * 3_600_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+  expect(parseDuration('1m30s500ms')).toBe(90_500);
+});
+
+test('parseDuration rejects bad input and names it in the error', () => {
+  for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '1 h', '.5h', '1.h']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
+
+test('parseDuration rounds to whole milliseconds', () => {
+  expect(parseDuration('0.5ms')).toBe(1);
+  expect(parseDuration('1.0004s')).toBe(1000);
+  expect(parseDuration('1.0006s')).toBe(1001);
+});
+
+test('formatDuration', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(500)).toBe('500ms');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(formatDuration(0)).toBe('0s');
+  expect(() => formatDuration(-1)).toThrow();
+  for (const x of [5_400_000, 1_500, 90_061_001]) {
+    expect(parseDuration(formatDuration(x))).toBe(x);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 01:47:57.162022273 +0000
@@ -0,0 +1,100 @@
+import { expect, test } from 'bun:test';
+import { LRU, type EvictReason } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const log: [string, number, EvictReason][] = [];
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return { cache, log, advance: (ms: number) => (t += ms) };
+}
+
+test('get refreshes recency; capacity evicts the least recent', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('expired entries are removed before a live one is evicted', () => {
+  const { cache, log, advance } = setup(2, 100);
+  cache.set('a', 1);
+  advance(60);
+  cache.set('b', 2);
+  advance(50); // a expired (t=110 >= 100), b live
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('expired entries count toward capacity', () => {
+  const { cache, log, advance } = setup(1, 100);
+  cache.set('a', 1);
+  advance(100);
+  expect(cache.size).toBe(0);
+  cache.set('b', 2);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.size).toBe(1);
+});
+
+test('live until t+ttl-1, expired at t+ttl', () => {
+  const { cache, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  advance(999);
+  expect(cache.get('a')).toBe(1);
+  advance(1);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('get on expired reports expired; delete reports delete or expired', () => {
+  const { cache, log, advance } = setup(5, 100);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  expect(cache.delete('a')).toBe(true);
+  expect(log).toEqual([['a', 1, 'delete']]);
+  expect(cache.delete('missing')).toBe(false);
+  advance(100);
+  expect(cache.get('b')).toBeUndefined();
+  expect(cache.delete('c')).toBe(false);
+  expect(log).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+    ['c', 3, 'expired'],
+  ]);
+});
+
+test('size and keys ignore expired entries without evicting', () => {
+  const { cache, log, advance } = setup(5, 100);
+  cache.set('a', 1);
+  advance(50);
+  cache.set('b', 2);
+  advance(60);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+});
+
+test('re-setting an expired key reports the old value as expired', () => {
+  const { cache, log, advance } = setup(5, 100);
+  cache.set('a', 1);
+  advance(100);
+  cache.set('a', 2);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('re-setting refreshes ttl and recency without onEvict', () => {
+  const { cache, log, advance } = setup(2, 100);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  advance(90);
+  cache.set('a', 10);
+  expect(log).toEqual([]);
+  advance(50); // b expired, a live with fresh ttl
+  expect(cache.get('a')).toBe(10);
+  expect(cache.keys()).toEqual(['a']);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 01:47:57.175773452 +0000
@@ -0,0 +1,27 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify letters and separators', () => {
+  expect(slugify('Straße')).toBe('strasse');
+  expect(slugify('Æon Œuvre')).toBe('aeon-oeuvre');
+  expect(slugify('Øl Łódź Đak')).toBe('ol-lodz-dak');
+  expect(slugify('ñ ç ź à')).toBe('n-c-z-a');
+  expect(slugify('--Hi!!  there--')).toBe('hi-there');
+  expect(slugify('')).toBe('');
+});
+
+test('slugify keeps digits', () => {
+  expect(slugify('Top 10 Tips 2024')).toBe('top-10-tips-2024');
+});
+
+test('slugify with max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+  expect(slugify('ab-cd', 10)).toBe('ab-cd');
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('free', new Set(['post']))).toBe('free');
+});
