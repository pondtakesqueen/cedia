+
+test('quoted assignments, redirection targets and operators glued to words', () => {
+  expect(simpleCommands('FOO="a b" rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands("A='' rm -rf /")).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('env X="1" rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('cmd 2>"/dev/null" arg')).toEqual([['cmd', 'arg']]);
+  expect(simpleCommands('cmd >"out.txt"')).toEqual([['cmd']]);
+  expect(simpleCommands('rm>/dev/null -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('sort<in.txt')).toEqual([['sort']]);
+  expect(simpleCommands('echo \\>&rm -rf /')).toEqual([['echo', '>'], ['rm', '-rf', '/']]);
+});
+
+test('bash -c after flags that take a value, and wrappers given as paths', () => {
+  expect(simpleCommands('bash -o pipefail -c "rm -rf /"')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands("bash -O extglob -c 'rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands("bash --rcfile x -c 'rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('/usr/bin/env rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('/usr/bin/sudo rm -rf /')).toEqual([['rm', '-rf', '/']]);
+});
