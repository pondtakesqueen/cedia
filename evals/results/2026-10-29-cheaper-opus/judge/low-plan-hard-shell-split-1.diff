+// `text` is the word with quotes and escapes removed; `raw` is its source text.
+type Word = { text: string; raw: string };
+
+const ASSIGN = /^[A-Za-z_][A-Za-z0-9_]*=/;
+const OPERATOR = /^(\d*>>?|\d*<|&>>?|\d*>&)$/;
+const REDIR = /^(\d*>>?|\d*<|&>>?|\d*>&)/;
+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const SHELLS = new Set(['bash', 'sh', 'zsh', 'dash', 'ksh']);
+// Shell flags whose next word is a value, so a `-c` after them is still found.
+const SHELL_VALUE = ['-o', '-O', '+o', '+O', '--rcfile', '--init-file'];
+
+// Index of the ')' that closes a $( whose contents start at `start`, or -1.
+function closeParen(src: string, start: number): number {
+  let depth = 1;
+  for (let j = start; j < src.length; j++) {
+    const c = src[j];
+    if (c === '\\') j++;
+    else if (c === "'" || c === '"') {
+      j = src.indexOf(c, j + 1);
+      if (j < 0) return -1;
+    } else if (c === '(') depth++;
+    else if (c === ')' && --depth === 0) return j;
+  }
+  return -1;
+}
+
+// Drops redirections, assignments, keywords and wrappers from one command, then unpacks bash -c and eval.
+function normalize(words: Word[]): string[][] | null {
+  const argv: Word[] = [];
+  for (let i = 0; i < words.length; i++) {
+    const w = words[i];
+    if (OPERATOR.test(w.raw)) i++;
+    else if (REDIR.test(w.raw)) continue;
+    else argv.push(w);
+  }
+
+  let i = 0;
+  while (i < argv.length) {
+    const w = argv[i];
+    if (ASSIGN.test(w.raw) || KEYWORDS.has(w.raw)) {
+      i++;
+      continue;
+    }
+    const wrapper = WRAPPERS.get(w.text.split('/').pop()!);
+    if (!wrapper) break;
+    i++;
+    while (i < argv.length && argv[i].text.startsWith('-')) {
+      const flag = argv[i++].text;
+      if (flag === '--') break;
+      if (wrapper.value?.includes(flag)) i++;
+    }
+    i += wrapper.positional ?? 0;
+  }
+
+  const rest = argv.slice(i).map((w) => w.text);
+  if (rest.length === 0) return [];
+  const [head, ...args] = rest;
+  if (head === 'eval') return simpleCommands(args.join(' '));
+  if (SHELLS.has(head.split('/').pop()!)) {
+    for (let j = 0; j < args.length && /^[-+]/.test(args[j]); j++) {
+      if (/^-[a-zA-Z]*c/.test(args[j])) return args[j + 1] === undefined ? [rest] : simpleCommands(args[j + 1]);
+      if (SHELL_VALUE.includes(args[j])) j++;
+    }
+  }
+  return [rest];
+}
 
