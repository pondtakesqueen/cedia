+++ b/csv.ts	2026-10-29 01:33:08.611968278 +0000
@@ -50,3 +50,109 @@
   rows.push(row);
   return rows;
 }
+
+type State = "fieldStart" | "unquoted" | "quoted" | "quoteInQuoted" | "afterClose" | "crUnquoted" | "crAfterClose";
+
+/** Parses the same CSV as `parseCsv`, fed in chunks of any size: each push returns the rows that are complete. */
+export class CsvStream {
+  private field = "";
+  private row: string[] = [];
+  private state: State = "fieldStart";
+  private rowStart = true;
+  private seenAny = false;
+
+  push(chunk: string): string[][] {
+    const out: string[][] = [];
+    for (const c of chunk) {
+      if (!this.seenAny) {
+        this.seenAny = true;
+        if (c === "﻿") continue;
+      }
+      this.rowStart = false;
+      this.feed(c, out);
+    }
+    return out;
+  }
+
+  end(): string[][] {
+    const out: string[][] = [];
+    if (!this.seenAny) return out;
+    if (this.state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+    if (this.state === "crAfterClose") throw new SyntaxError("a \\r after a closing quote must be followed by \\n");
+    if (this.state === "crUnquoted") this.field += "\r";
+    if (this.state === "fieldStart" && this.rowStart) return out;
+    this.endRow(out);
+    return out;
+  }
+
+  private feed(c: string, out: string[][]): void {
+    switch (this.state) {
+      case "fieldStart":
+        if (c === '"') this.state = "quoted";
+        else if (c === ",") this.finishField();
+        else if (c === "\n") this.endRow(out);
+        else if (c === "\r") this.state = "crUnquoted";
+        else {
+          this.field += c;
+          this.state = "unquoted";
+        }
+        return;
+      case "unquoted":
+        if (c === '"') throw new SyntaxError("a quote in a field that is not quoted");
+        if (c === ",") {
+          this.finishField();
+          this.state = "fieldStart";
+        } else if (c === "\n") this.endRow(out);
+        else if (c === "\r") this.state = "crUnquoted";
+        else this.field += c;
+        return;
+      case "crUnquoted":
+        if (c === "\n") {
+          this.endRow(out);
+          return;
+        }
+        this.field += "\r";
+        this.state = "unquoted";
+        this.feed(c, out);
+        return;
+      case "quoted":
+        if (c === '"') this.state = "quoteInQuoted";
+        else this.field += c;
+        return;
+      case "quoteInQuoted":
+        if (c === '"') {
+          this.field += '"';
+          this.state = "quoted";
+        } else {
+          this.state = "afterClose";
+          this.feed(c, out);
+        }
+        return;
+      case "afterClose":
+        if (c === ",") {
+          this.finishField();
+          this.state = "fieldStart";
+        } else if (c === "\n") this.endRow(out);
+        else if (c === "\r") this.state = "crAfterClose";
+        else throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote`);
+        return;
+      case "crAfterClose":
+        if (c !== "\n") throw new SyntaxError("a \\r after a closing quote must be followed by \\n");
+        this.endRow(out);
+        return;
+    }
+  }
+
+  private finishField(): void {
+    this.row.push(this.field);
+    this.field = "";
+  }
+
+  private endRow(out: string[][]): void {
+    this.finishField();
+    out.push(this.row);
+    this.row = [];
+    this.state = "fieldStart";
+    this.rowStart = true;
+  }
+}
