--- a/sse.edge.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.edge.test.ts	2026-10-30 17:20:51.281754439 +0000
@@ -0,0 +1,52 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+test('a last line ending in CR without LF, and pending data after a comment', async () => {
+  expect(await all('data: a\r')).toEqual([{ data: 'a' }]);
+  expect(await all('event: e\ndata: a\n: tail')).toEqual([{ event: 'e', data: 'a' }]);
+  expect(await all('event: e')).toEqual([]);
+});
+
+test('many lines in one large chunk', async () => {
+  const text = 'data: x\n\n'.repeat(20000);
+  const out = await all(text, text.length);
+  expect(out.length).toBe(20000);
+});
+
+test('stopping early cancels the body', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'x' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
+
+test('a stream error propagates', async () => {
+  const body = new ReadableStream<Uint8Array>({
+    start(c) {
+      c.enqueue(new TextEncoder().encode('data: x\n\n'));
+      c.error(new Error('boom'));
+    },
+  });
+  const out: SseMessage[] = [];
+  await expect(
+    (async () => {
+      for await (const m of readSse(body)) out.push(m);
+    })(),
+  ).rejects.toThrow('boom');
+});
