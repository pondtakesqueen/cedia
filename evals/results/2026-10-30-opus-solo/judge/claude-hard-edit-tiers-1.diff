--- a/edit.ts	2026-10-30 03:50:41.584584958 +0000
+++ b/edit.ts	2026-10-30 03:52:36.782124941 +0000
@@ -23,5 +23,100 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create or overwrite a whole file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  const exact = findAll(content, old_text);
+  if (exact.length > 1 && !edit.replace_all) {
+    return {
+      error: `old_text matches ${exact.length} places (first at line ${lineAt(content, exact[0])}); ` +
+        'include more surrounding lines to make it unique, or set replace_all',
+    };
+  }
+  if (exact.length > 0) {
+    let out = '';
+    let prev = 0;
+    for (const i of exact) {
+      out += content.slice(prev, i) + new_text;
+      prev = i + old_text.length;
+    }
+    const last = exact[exact.length - 1];
+    return {
+      content: out + content.slice(prev),
+      applied: { from: lineAt(content, exact[0]), to: lineAt(content, last + old_text.length - 1), tier: 'exact', count: exact.length },
+    };
+  }
+
+  const lines = splitLines(content);
+  const oldLines = splitLines(old_text);
+  const newLines = new_text === '' ? [] : splitLines(new_text);
+  for (const { tier, ignoring, norm } of FUZZY) {
+    const have = lines.map(norm);
+    const want = oldLines.map(norm);
+    const starts: number[] = [];
+    for (let i = 0; i + want.length <= have.length; i++) {
+      if (want.every((w, j) => have[i + j] === w)) starts.push(i);
+    }
+    if (starts.length > 1) {
+      return {
+        error: `old_text matches ${starts.length} places ignoring ${ignoring} (lines ${starts.map((i) => i + 1).join(', ')}); ` +
+          `include more surrounding lines to make it unique${edit.replace_all ? ' (replace_all applies to exact matches only)' : ''}`,
+      };
+    }
+    if (starts.length === 0) continue;
+
+    const at = starts[0];
+    const end = at + oldLines.length;
+    let replacement = newLines;
+    if (tier === 'indentation') {
+      const from = indentOf(oldLines);
+      const to = indentOf(lines.slice(at, end));
+      replacement = newLines.map((l) => (l.trim() !== '' && l.startsWith(from) ? to + l.slice(from.length) : l));
+    }
+    const out = [...lines.slice(0, at), ...replacement, ...lines.slice(end)];
+    return {
+      content: out.length === 0 ? '' : out.join('\n') + (content.endsWith('\n') ? '\n' : ''),
+      applied: { from: at + 1, to: end, tier, count: 1 },
+    };
+  }
+
+  let error = 'old_text not found';
+  const first = oldLines.find((l) => l.trim() !== '')?.trim();
+  const seen = first ? lines.flatMap((l, i) => (l.includes(first) ? [i + 1] : [])) : [];
+  if (seen.length > 0) {
+    const more = seen.length > 5 ? ` (and ${seen.length - 5} more)` : '';
+    error += `; its first line appears at line ${seen.slice(0, 5).join(', ')}${more}. Re-read the file there and copy old_text exactly`;
+  } else {
+    error += '. Re-read the file and copy old_text exactly';
+  }
+  return { error };
+}
+
+const FUZZY: { tier: Tier; ignoring: string; norm: (line: string) => string }[] = [
+  { tier: 'trailing-space', ignoring: 'trailing whitespace', norm: (l) => l.trimEnd() },
+  { tier: 'indentation', ignoring: 'indentation and trailing whitespace', norm: (l) => l.trim() },
+];
+
+// Start offsets of non-overlapping occurrences of `needle`, left to right.
+function findAll(haystack: string, needle: string): number[] {
+  const found: number[] = [];
+  for (let i = haystack.indexOf(needle); i !== -1; i = haystack.indexOf(needle, i + needle.length)) found.push(i);
+  return found;
+}
+
+// 1-based line number of the character at `offset`.
+function lineAt(s: string, offset: number): number {
+  return s.slice(0, offset).split('\n').length;
+}
+
+// Lines of `s`, ignoring a single trailing newline.
+function splitLines(s: string): string[] {
+  return (s.endsWith('\n') ? s.slice(0, -1) : s).split('\n');
+}
+
+// Leading whitespace of the first non-blank line.
+function indentOf(lines: string[]): string {
+  const line = lines.find((l) => l.trim() !== '');
+  return line ? line.match(/^\s*/)![0] : '';
 }
