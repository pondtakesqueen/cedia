--- a/ledger.edge.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.edge.test.ts	2026-10-30 17:24:58.617501577 +0000
@@ -0,0 +1,32 @@
+import { expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type SessionEvent } from './ledger.ts';
+
+test('matchCheck edge cases', () => {
+  expect(matchCheck("cd '/work/my repo' && bun test", ['bun test'], '/work/my repo')).toBe('bun test');
+  expect(matchCheck('cd /work/repo&&bun test', ['bun test'], '/work/repo')).toBe('bun test');
+  expect(matchCheck('cd /work/repo && bun test | tail', ['bun test'], '/work/repo')).toBeUndefined();
+  expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], '/work/repo')).toBeUndefined();
+  expect(matchCheck('cd /tmp && bun test', ['bun test'], '/work/repo')).toBeUndefined();
+  expect(matchCheck('bun test 2>&1 | tail', ['bun test'])).toBeUndefined();
+  expect(matchCheck('bun test', [])).toBeUndefined();
+});
+
+test('failed bash writes count, snapshots win over edit paths, unverified after a later pass is empty', () => {
+  const events: SessionEvent[] = [
+    { kind: 'tool_intent', callId: 'a', tool: 'bash', input: { command: 'npm i' } },
+    { kind: 'tool_result', callId: 'a', status: 'failed', output: { isError: true, exitCode: 2 } },
+    { kind: 'tool_intent', callId: 'b', tool: 'edit', input: { path: 'x.ts' } },
+    { kind: 'tool_result', callId: 'b', status: 'completed', output: { isError: false } },
+    { kind: 'snapshot', callId: 'b', changed: ['y.ts'] },
+    { kind: 'tool_intent', callId: 'c', tool: 'bash', input: { command: 'bun test' } },
+    { kind: 'tool_result', callId: 'c', status: 'completed', output: { isError: false, exitCode: 0 } },
+  ];
+  const entries = ledgerEntries(events, ['bun test']);
+  expect(entries).toEqual([
+    { kind: 'write', at: 1, tool: 'bash', command: 'npm i' },
+    { kind: 'write', at: 3, tool: 'edit', path: 'y.ts' },
+    { kind: 'check', at: 6, command: 'bun test', exitCode: 0 },
+  ]);
+  expect(evidence(entries).unverified).toEqual([]);
+  expect(verified(entries, ['bun test'])).toBe(true);
+});
