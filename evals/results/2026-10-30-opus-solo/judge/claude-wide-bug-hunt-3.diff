diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/rules.test.ts b/test/rules.test.ts
--- a/test/rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/rules.test.ts	2026-10-30 05:31:28.331544586 +0000
@@ -0,0 +1,94 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('the region table matches README.md', () => {
+    expect(REGIONS).toEqual({
+      US: { code: 'US', taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 },
+      EU: { code: 'EU', taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 },
+      UK: { code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 },
+    });
+  });
+
+  test('9 units get no bulk discount', () => {
+    // 9 pens = 1080; shipping 800; tax 7% of 1880 = 131.6 -> 132
+    expect(totals(cart('US', [['PEN', 9]]))).toMatchObject({ subtotal: 1080, shipping: 800, tax: 132, total: 2012 });
+  });
+
+  test('exactly 10 units get 5% off', () => {
+    // 10 pens = 1200, -60 = 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    const t = totals(cart('US', [['PEN', 10]]));
+    expect(t.lines[0]).toMatchObject({ subtotal: 1200, discount: 60, total: 1140 });
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('exactly 50 units get 10% off, not 5%', () => {
+    // 50 pens = 6000, -600 = 5400 >= 5000 ships free; tax 7% of 5400 = 378
+    const t = totals(cart('US', [['PEN', 50]]));
+    expect(t.lines[0]).toMatchObject({ subtotal: 6000, discount: 600, total: 5400 });
+    expect(t).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same sku are merged before the bulk discount', () => {
+    // 6 + 4 pens = one line of 10 pens, priced as in the 10-unit case
+    const t = totals(cart('US', [['PEN', 6], ['MUG', 1], ['PEN', 4]]));
+    expect(t.lines).toHaveLength(2);
+    expect(t.lines[0]).toMatchObject({ sku: 'PEN', quantity: 10, discount: 60, total: 1140 });
+    // 1140 + 450 = 1590; shipping 800; tax 7% of 2390 = 167.3 -> 167
+    expect(t).toMatchObject({ subtotal: 1590, shipping: 800, tax: 167, total: 2557 });
+  });
+
+  test('merging does not change the cart passed in', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    totals(c);
+    expect(c.lines).toEqual([
+      { sku: 'PEN', quantity: 6, unitPrice: 120 },
+      { sku: 'PEN', quantity: 4, unitPrice: 120 },
+    ]);
+  });
+
+  test('free shipping looks at the subtotal after a percentage coupon', () => {
+    // 2 bags + 2 mugs = 5300; SAVE10 -530 = 4770 < 5000 pays shipping; tax 7% of 5570 = 389.9 -> 390
+    expect(totals(cart('US', [['BAG', 2], ['MUG', 2]], 'SAVE10'))).toMatchObject({
+      subtotal: 5300,
+      coupon: 530,
+      shipping: 800,
+      tax: 390,
+      total: 5960,
+    });
+  });
+
+  test('free shipping looks at the subtotal after a flat coupon', () => {
+    // 2 bags + 2 mugs = 5300; FLAT5 -500 = 4800 < 5000 pays shipping; tax 7% of 5600 = 392
+    expect(totals(cart('US', [['BAG', 2], ['MUG', 2]], 'FLAT5'))).toMatchObject({
+      subtotal: 5300,
+      coupon: 500,
+      shipping: 800,
+      tax: 392,
+      total: 5992,
+    });
+  });
+
+  test('a UK order between 4000 and 4500 ships free', () => {
+    // bag + tee + mug = 4150 >= 4000; tax 20% of 4150 = 830
+    expect(totals(cart('UK', [['BAG', 1], ['TEE', 1], ['MUG', 1]]))).toMatchObject({ subtotal: 4150, shipping: 0, tax: 830, total: 4980 });
+  });
+
+  test('a UK order of exactly 4000 ships free', () => {
+    // bag + cap + 5 pens = 4000; tax 20% of 4000 = 800
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+
+  test('a UK order just under 4000 pays shipping', () => {
+    // bag + cap + 4 pens = 3880; shipping 700; tax 20% of 4580 = 916
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 4]]))).toMatchObject({ subtotal: 3880, shipping: 700, tax: 916, total: 5496 });
+  });
+
+  test('FLAT5 never takes the order below zero', () => {
+    // 3 pens = 360; FLAT5 takes all 360; shipping 800; tax 7% of 800 = 56
+    expect(totals(cart('US', [['PEN', 3]], 'FLAT5'))).toMatchObject({ subtotal: 360, coupon: 360, shipping: 800, tax: 56, total: 856 });
+  });
+});
