diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.test.ts b/memo.test.ts
--- a/memo.test.ts	2026-10-30 05:21:52.961046459 +0000
+++ b/memo.test.ts	2026-10-30 05:24:35.959554018 +0000
@@ -66,3 +66,138 @@
   m("k");
   expect(calls).toHaveLength(2);
 });
+
+test("keeping one more key than max drops only the least recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  for (const k of ["a", "b", "c"]) m(k);
+  expect(m.size).toBe(2);
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  m("b");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(4);
+});
+
+test("a result settling after its key was dropped for max is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  const a = m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  expect(await a).toBe("a");
+  expect(m.size).toBe(1);
+  m("b");
+  expect(calls).toHaveLength(2);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a call answered from the cache makes its key the most recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  expect(await m("a")).toBe("a");
+  m("c");
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("a call sharing an in-flight lookup makes its key the most recently used", () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("a");
+  m("c");
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("an earlier call settling after invalidate does not replace the newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  await tick();
+  expect(m("k")).toBe(second);
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("an earlier call rejecting after invalidate does not drop the newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.reject(new Error("old"));
+  await expect(first).rejects.toThrow("old");
+  expect(m("k")).toBe(second);
+  expect(calls).toHaveLength(2);
+});
+
+test("a result in flight during clear is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("an expired result is not counted and is dropped before a live key", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("x");
+  calls[0]!.d.resolve("x");
+  await tick();
+  t = 50;
+  m("y");
+  calls[1]!.d.resolve("y");
+  await tick();
+  t = 60;
+  m("x");
+  t = 120;
+  expect(m.size).toBe(1);
+  m("z");
+  expect(m.size).toBe(2);
+  expect(await m("y")).toBe("y");
+  expect(calls).toHaveLength(3);
+});
+
+test("fn throwing synchronously rejects the call and is not kept", async () => {
+  let n = 0;
+  const m = memo(
+    (key: string): Promise<string> => {
+      if (n++ === 0) throw new Error("boom");
+      return Promise.resolve(key);
+    },
+    { ttlMs: 1000, max: 10 },
+  );
+  const first = m("k");
+  expect(first).toBeInstanceOf(Promise);
+  await expect(first).rejects.toThrow("boom");
+  expect(await m("k")).toBe("k");
+  expect(n).toBe(2);
+});
