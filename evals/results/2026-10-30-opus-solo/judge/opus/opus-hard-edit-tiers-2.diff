diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.edge.test.ts b/edit.edge.test.ts
--- a/edit.edge.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.edge.test.ts	2026-10-30 17:25:07.313769658 +0000
@@ -0,0 +1,36 @@
+import { expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+test('exact replacement does not expand $ patterns', () => {
+  expect(applyEdit('a\nb\n', { old_text: 'a', new_text: "$&$'" })).toEqual({
+    content: "$&$'\nb\n",
+    applied: { from: 1, to: 1, tier: 'exact', count: 1 },
+  });
+});
+
+test('replace_all reports first to last replaced line', () => {
+  const r = applyEdit('x\ny\nx\n', { old_text: 'x\n', new_text: 'z\n', replace_all: true });
+  expect(r).toEqual({ content: 'z\ny\nz\n', applied: { from: 1, to: 3, tier: 'exact', count: 2 } });
+});
+
+test('replace_all with no exact match falls through to a unique line match', () => {
+  const r = applyEdit('a  \nb\n', { old_text: 'a\nb', new_text: 'A', replace_all: true });
+  expect(r).toEqual({ content: 'A\n', applied: { from: 1, to: 2, tier: 'trailing-space', count: 1 } });
+});
+
+test('ambiguous indentation match names count and lines', () => {
+  const r = applyEdit('  a\nb\n    a\n', { old_text: 'a ', new_text: 'c' });
+  expect('error' in r && r.error).toContain('matches 2 places');
+  expect('error' in r && r.error).toContain('1, 3');
+});
+
+test('a match at the end of a file without trailing newline', () => {
+  const r = applyEdit('a\n  b  ', { old_text: 'b\n', new_text: 'c\n' });
+  expect(r).toEqual({ content: 'a\n  c', applied: { from: 2, to: 2, tier: 'indentation', count: 1 } });
+});
+
+test('not-found pointer lists at most 5 lines and uses the first non-blank line', () => {
+  const r = applyEdit('k\nk\nk\nk\nk\nk\nk\n', { old_text: '\n  k\nzzz', new_text: '' });
+  expect('error' in r && r.error).toContain('first line appears at line 1, 2, 3, 4, 5');
+  expect('error' in r && r.error).not.toContain('5, 6');
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-30 17:24:10.628627109 +0000
+++ b/edit.ts	2026-10-30 17:24:51.353768709 +0000
@@ -23,5 +23,66 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text } = edit;
+  if (old_text === '') return { error: 'old_text is empty; to create or overwrite a file, use write' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  // 1. exact
+  const lineAt = (index: number) => content.slice(0, index).split('\n').length;
+  const starts: number[] = [];
+  for (let i = content.indexOf(old_text); i !== -1; i = content.indexOf(old_text, i + old_text.length)) starts.push(i);
+  if (starts.length > 1 && !edit.replace_all) {
+    return { error: `old_text matches ${starts.length} places (first at line ${lineAt(starts[0])}); add surrounding lines to make it unique or set replace_all` };
+  }
+  if (starts.length > 0) {
+    const last = starts[starts.length - 1];
+    const applied: Applied = { from: lineAt(starts[0]), to: lineAt(last + old_text.length - 1), tier: 'exact', count: starts.length };
+    const replaced = starts.length === 1
+      ? content.slice(0, starts[0]) + new_text + content.slice(starts[0] + old_text.length)
+      : content.split(old_text).join(new_text);
+    return { content: replaced, applied };
+  }
+
+  // 2 and 3: whole lines
+  const toLines = (text: string) => {
+    const lines = text.split('\n');
+    if (lines[lines.length - 1] === '') lines.pop();
+    return lines;
+  };
+  const lines = content.split('\n');
+  const candidates = content.endsWith('\n') ? lines.length - 1 : lines.length;
+  const oldLines = toLines(old_text);
+  const newLines = toLines(new_text);
+  const indentOf = (ls: string[]) => ls.find(l => l.trim() !== '')?.match(/^\s*/)![0] ?? '';
+
+  const tiers: [Tier, (l: string) => string][] = [['trailing-space', l => l.trimEnd()], ['indentation', l => l.trim()]];
+  for (const [tier, norm] of tiers) {
+    const want = oldLines.map(norm);
+    const found: number[] = [];
+    for (let i = 0; i + want.length <= candidates; i++) {
+      if (want.every((w, j) => norm(lines[i + j]) === w)) found.push(i);
+    }
+    if (found.length > 1) {
+      return { error: `old_text matches ${found.length} places (lines ${found.map(i => i + 1).join(', ')}); add surrounding lines to make it unique` };
+    }
+    if (found.length === 1) {
+      const at = found[0];
+      let replacement = newLines;
+      if (tier === 'indentation') {
+        const from = indentOf(oldLines);
+        const to = indentOf(lines.slice(at, at + oldLines.length));
+        replacement = newLines.map(l => (l.trim() !== '' && l.startsWith(from) ? to + l.slice(from.length) : l));
+      }
+      const result = [...lines.slice(0, at), ...replacement, ...lines.slice(at + oldLines.length)];
+      return { content: result.join('\n'), applied: { from: at + 1, to: at + oldLines.length, tier, count: 1 } };
+    }
+  }
+
+  let error = 'old_text not found in the file';
+  const first = oldLines.find(l => l.trim() !== '')?.trim();
+  if (first) {
+    const at = lines.flatMap((l, i) => (l.includes(first) ? [i + 1] : [])).slice(0, 5);
+    if (at.length > 0) error += `; its first line appears at line ${at.join(', ')}, check the lines around it`;
+  }
+  return { error };
 }
