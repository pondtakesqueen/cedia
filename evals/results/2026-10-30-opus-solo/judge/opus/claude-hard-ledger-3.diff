+
+// A leading `cd <dir> && `, where <dir> may be quoted (and contain spaces inside the quotes).
+const LEADING_CD = /^cd\s+((?:"[^"]*"|'[^']*'|[^\s"'&|;])+)\s*&&\s*/;
+
+function canonical(command: string, cwd?: string): string {
+  let s = command.trim();
+  const cd = cwd === undefined ? null : LEADING_CD.exec(s);
+  if (cd && resolve(cwd!, cd[1]!.replace(/["']/g, '')) === resolve(cwd!)) s = s.slice(cd[0].length);
+  return s.trim().replace(/\s+/g, ' ').replace(/ 2>&1$/, '');
