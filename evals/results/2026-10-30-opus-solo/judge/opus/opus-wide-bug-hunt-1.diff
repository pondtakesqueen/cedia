diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-30 17:21:20.837756196 +0000
@@ -0,0 +1,41 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { bulkDiscount } from '../src/pricing/discounts/bulk.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('bulk tiers start at exactly 10 and 50 units', () => {
+    expect(bulkDiscount(9, 1000)).toBe(0);
+    expect(bulkDiscount(10, 1000)).toBe(50);
+    expect(bulkDiscount(49, 1000)).toBe(50);
+    expect(bulkDiscount(50, 1000)).toBe(100);
+  });
+
+  test('lines of the same sku are merged before the bulk discount', () => {
+    // 6 + 4 pens = 10 units = 1200, 5% off = 60 -> 1140; + mug 450 = 1590; shipping 800; tax 7% of 2390 = 167.3 -> 167
+    const t = totals(cart('US', [['PEN', 6], ['MUG', 1], ['PEN', 4]]));
+    expect(t.lines.map((l) => [l.sku, l.quantity, l.discount])).toEqual([['PEN', 10, 60], ['MUG', 1, 0]]);
+    expect(t).toMatchObject({ subtotal: 1590, shipping: 800, tax: 167, total: 2557 });
+  });
+
+  test('merging does not change the cart passed in', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    totals(c);
+    expect(c.lines.map((l) => l.quantity)).toEqual([6, 4]);
+  });
+
+  test('free shipping is decided on the subtotal after the coupon', () => {
+    // 4 tees = 6000 in EU: at the threshold, ships free; SAVE10 -> 5400, below it, pays 900
+    expect(totals(cart('EU', [['TEE', 4]]))).toMatchObject({ subtotal: 6000, shipping: 0, tax: 1200, total: 7200 });
+    // 5400 + 900 = 6300; tax 1260
+    expect(totals(cart('EU', [['TEE', 4]], 'SAVE10'))).toMatchObject({ coupon: 600, shipping: 900, tax: 1260, total: 7560 });
+  });
+
+  test('UK ships free from 4000', () => {
+    // 2 bags = 4400 >= 4000; tax 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+    // 3 caps = 3600 < 4000; 3600 + 700 = 4300; tax 860
+    expect(totals(cart('UK', [['CAP', 3]]))).toMatchObject({ shipping: 700, tax: 860, total: 5160 });
+  });
+});
