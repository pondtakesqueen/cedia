--- a/deny.edge.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.edge.test.ts	2026-10-30 17:18:26.157745812 +0000
@@ -0,0 +1,42 @@
+import { expect, test } from 'bun:test';
+import { homedir } from 'node:os';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('git long options with =value and abbreviations', () => {
+  expect(hit(['git', 'push', '--force=yes'])).toBe('force-push');
+  expect(hit(['git', 'push', '--mir'])).toBe('force-push');
+  expect(hit(['git', 'reset', '--ha'])).toBe('reset-hard');
+  expect(hit(['git', 'clean', '--for'])).toBe('clean-force');
+  expect(hit(['git', '--git-dir=.git', 'push', '-f'])).toBe('force-push');
+  expect(hit(['git', '--work-tree', 'w', '--namespace', 'n', 'reset', '--hard'])).toBe('reset-hard');
+  expect(hit(['git', 'push', '--'])).toBeUndefined();
+  expect(hit(['git', 'push', 'origin', '--', '+main'])).toBe('force-push');
+  expect(hit(['git', 'push', 'origin', '--', '-f'])).toBeUndefined();
+  expect(hit(['git', 'reset', '--', '--hard'])).toBeUndefined();
+  expect(hit(['git'])).toBeUndefined();
+  expect(hit(['git', '-C'])).toBeUndefined();
+});
+
+test('rm targets that resolve to cwd, home or nothing', () => {
+  expect(hit(['rm', '-rf', ''])).toBe('rm-outside');
+  expect(hit(['rm', '-rf', './'])).toBe('rm-outside');
+  expect(hit(['rm', '-rf', 'src/..'])).toBe('rm-outside');
+  expect(hit(['rm', '-rf', '*/../..'])).toBe('rm-outside');
+  expect(hit(['rm', '-rf', '../*'])).toBe('rm-outside');
+  expect(hit(['rm', '-rf', '~/x'])).toBe(`${homedir()}/x`.startsWith(cwd + '/') ? undefined : 'rm-outside');
+  expect(hit(['rm', '-rf', '`pwd`'])).toBe('rm-outside');
+  expect(hit(['rm', '-rf', '--'])).toBe('rm-outside');
+  expect(hit(['rm', '--rec', '/etc'])).toBe('rm-outside');
+  expect(hit(['rm', '-r', 'a', '-v', '/etc'])).toBe('rm-outside');
+});
+
+test('find start paths after leading options', () => {
+  expect(hit(['find', '-L', '/', '-delete'])).toBe('rm-outside');
+  expect(hit(['find', '-D', 'tree', '/', '-delete'])).toBe('rm-outside');
+  expect(hit(['find', '-L', '-delete'])).toBeUndefined();
+  expect(hit(['find', '~bob', '-exec', 'rm', '{}', ';'])).toBe('rm-outside');
+  expect(hit(['find', '/work/repo', '-delete'])).toBeUndefined();
+});
