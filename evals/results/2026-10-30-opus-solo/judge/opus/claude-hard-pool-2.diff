diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.contract.test.ts b/pool.contract.test.ts
--- a/pool.contract.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.contract.test.ts	2026-10-30 05:27:36.543141316 +0000
@@ -0,0 +1,229 @@
+import { expect, test } from "bun:test";
+import { runPool } from "./pool";
+
+const later = <T>(ms: number, v: T) => () => new Promise<T>((r) => setTimeout(() => r(v), ms));
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+// Wraps tasks so the test can see how many are in flight at once and in what order they were called.
+function tracked<T>(tasks: Array<() => Promise<T> | T>) {
+  const stats = { active: 0, max: 0, calls: [] as number[] };
+  const wrapped = tasks.map((task, i) => () => {
+    stats.calls.push(i);
+    stats.active++;
+    stats.max = Math.max(stats.max, stats.active);
+    return new Promise<T>((r) => r(task())).finally(() => stats.active--);
+  });
+  return { stats, wrapped };
+}
+
+test("never has more than limit in flight, and keeps limit in flight while tasks are left", async () => {
+  const gates = Array.from({ length: 6 }, () => deferred<number>());
+  const { stats, wrapped } = tracked(gates.map((g) => () => g.promise));
+  const run = runPool(wrapped, 2);
+
+  await tick();
+  expect(stats.calls).toEqual([0, 1]);
+  gates[1].resolve(1);
+  await tick();
+  expect(stats.calls).toEqual([0, 1, 2]);
+  expect(stats.active).toBe(2);
+  gates[0].resolve(0);
+  gates[2].resolve(2);
+  await tick();
+  expect(stats.calls).toEqual([0, 1, 2, 3, 4]);
+  expect(stats.active).toBe(2);
+  for (const [i, g] of gates.entries()) g.resolve(i);
+
+  await run;
+  expect(stats.max).toBe(2);
+  expect(stats.calls).toEqual([0, 1, 2, 3, 4, 5]);
+});
+
+test("a limit of 1 runs one task at a time", async () => {
+  const { stats, wrapped } = tracked([later(3, "a"), later(1, "b"), later(2, "c")]);
+  await runPool(wrapped, 1);
+  expect(stats.max).toBe(1);
+});
+
+test("a limit of Infinity starts every task at once", async () => {
+  const { stats, wrapped } = tracked(Array.from({ length: 20 }, (_, i) => later(2, i)));
+  await runPool(wrapped, Infinity);
+  expect(stats.max).toBe(20);
+});
+
+test("results are in input order, not finishing order", async () => {
+  const out = await runPool([later(15, "a"), later(1, "b"), later(8, "c"), () => "d"], 4);
+  expect(out).toEqual([
+    { status: "fulfilled", value: "a", attempts: 1 },
+    { status: "fulfilled", value: "b", attempts: 1 },
+    { status: "fulfilled", value: "c", attempts: 1 },
+    { status: "fulfilled", value: "d", attempts: 1 },
+  ]);
+});
+
+test("a rejected task is tried up to retries more times", async () => {
+  let calls = 0;
+  const out = await runPool(
+    [
+      () => {
+        calls++;
+        return Promise.reject(new Error("no"));
+      },
+    ],
+    1,
+    { retries: 2 },
+  );
+  expect(calls).toBe(3);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 3 });
+  expect((out[0] as { reason: Error }).reason.message).toBe("no");
+});
+
+test("a task that works on a retry is fulfilled with the attempts it took", async () => {
+  let calls = 0;
+  const flaky = () => (++calls < 2 ? Promise.reject(new Error("once")) : Promise.resolve("ok"));
+  const out = await runPool([flaky], 1, { retries: 1 });
+  expect(out).toEqual([{ status: "fulfilled", value: "ok", attempts: 2 }]);
+});
+
+test("with no retries a rejected task is called once", async () => {
+  let calls = 0;
+  const out = await runPool([() => (calls++, Promise.reject("x"))], 1);
+  expect(calls).toBe(1);
+  expect(out).toEqual([{ status: "rejected", reason: "x", attempts: 1 }]);
+});
+
+test("a retry keeps its slot, so the next task waits for it", async () => {
+  let calls = 0;
+  const flaky = () => (++calls < 3 ? Promise.reject("no") : Promise.resolve("ok"));
+  const { stats, wrapped } = tracked([flaky, later(1, "next")]);
+  const out = await runPool(wrapped, 1, { retries: 5 });
+  expect(stats.calls).toEqual([0, 0, 0, 1]);
+  expect(stats.max).toBe(1);
+  expect(out.map((r) => r.attempts)).toEqual([3, 1]);
+});
+
+test("a synchronous throw is a rejection and a plain value is a fulfilment", async () => {
+  let calls = 0;
+  const out = await runPool<unknown>(
+    [
+      () => {
+        calls++;
+        throw new Error("sync");
+      },
+      () => 42,
+      () => undefined,
+    ],
+    2,
+    { retries: 1 },
+  );
+  expect(calls).toBe(2);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 2 });
+  expect(out[1]).toEqual({ status: "fulfilled", value: 42, attempts: 1 });
+  expect(out[2]).toEqual({ status: "fulfilled", value: undefined, attempts: 1 });
+});
+
+test("a thenable that calls back more than once settles its task once", async () => {
+  const noisy = () =>
+    ({
+      then(onFulfilled: (v: string) => void, onRejected: (e: unknown) => void) {
+        onFulfilled("first");
+        onFulfilled("second");
+        onRejected("third");
+      },
+    }) as unknown as Promise<string>;
+  // The thenable goes to the pool as is; wrapping it in a promise would hide the extra calls.
+  const { stats, wrapped } = tracked([later(5, "b"), later(5, "c"), later(5, "d")]);
+  const out = await runPool([noisy, ...wrapped], 1);
+  expect(stats.max).toBe(1);
+  expect(out.map((r) => r.status === "fulfilled" && r.value)).toEqual(["first", "b", "c", "d"]);
+});
+
+test("after an abort no task starts; in-flight tasks keep their result and the rest reject with the reason", async () => {
+  const controller = new AbortController();
+  const gates = Array.from({ length: 2 }, () => deferred<string>());
+  const { stats, wrapped } = tracked<string>([() => gates[0].promise, () => gates[1].promise, () => "c", () => "d"]);
+  const run = runPool(wrapped, 2, { signal: controller.signal });
+
+  await tick();
+  controller.abort("stop");
+  gates[0].resolve("a");
+  gates[1].reject("b failed");
+  const out = await run;
+
+  expect(stats.calls).toEqual([0, 1]);
+  expect(out).toEqual([
+    { status: "fulfilled", value: "a", attempts: 1 },
+    { status: "rejected", reason: "b failed", attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("after an abort a pending retry is cancelled and rejects with the reason and the attempts made", async () => {
+  const controller = new AbortController();
+  const gate = deferred<string>();
+  let calls = 0;
+  const run = runPool([() => (calls++, gate.promise)], 1, { retries: 3, signal: controller.signal });
+
+  await tick();
+  controller.abort("stop");
+  gate.reject("first failed");
+  expect(await run).toEqual([{ status: "rejected", reason: "stop", attempts: 1 }]);
+  expect(calls).toBe(1);
+});
+
+test("a task that aborts the signal while being called stops the rest from starting", async () => {
+  const controller = new AbortController();
+  let calls = 0;
+  const tasks = Array.from({ length: 4 }, (_, i) => () => {
+    calls++;
+    if (i === 0) controller.abort("from task");
+    return i;
+  });
+  const out = await runPool(tasks, 4, { signal: controller.signal });
+  expect(calls).toBe(1);
+  expect(out).toEqual([
+    { status: "fulfilled", value: 0, attempts: 1 },
+    { status: "rejected", reason: "from task", attempts: 0 },
+    { status: "rejected", reason: "from task", attempts: 0 },
+    { status: "rejected", reason: "from task", attempts: 0 },
+  ]);
+});
+
+test("an already aborted signal starts no task and resolves with every task rejected", async () => {
+  const controller = new AbortController();
+  const reason = new Error("gone");
+  controller.abort(reason);
+  let calls = 0;
+  const out = await runPool([() => calls++, () => calls++], 1, { signal: controller.signal });
+  expect(calls).toBe(0);
+  expect(out).toEqual([
+    { status: "rejected", reason, attempts: 0 },
+    { status: "rejected", reason, attempts: 0 },
+  ]);
+});
+
+test("a bad limit or retries rejects with a RangeError and starts nothing", async () => {
+  let calls = 0;
+  const tasks = [() => calls++];
+  for (const limit of [1.5, -1, NaN, -Infinity, "2", null, undefined, Symbol("x"), Object.create(null)]) {
+    await expect(runPool(tasks, limit as number)).rejects.toBeInstanceOf(RangeError);
+  }
+  for (const retries of [-1, 0.5, NaN, Infinity, "1"]) {
+    await expect(runPool(tasks, 1, { retries: retries as number })).rejects.toBeInstanceOf(RangeError);
+  }
+  expect(calls).toBe(0);
+});
+
+test("whole-number limits and retries are accepted", async () => {
+  expect(await runPool([() => 1], 1, { retries: 0 })).toHaveLength(1);
+  expect(await runPool([() => 1], 3, { retries: 2 })).toHaveLength(1);
+  expect(await runPool([() => 1], Infinity)).toHaveLength(1);
+});
