+
+/** Where a `CsvStream` is in the input, as of the end of the last chunk. */
+type StreamState =
+  | "bom" // nothing has arrived yet, so a `﻿` would still be dropped
+  | "rowStart" // no row has begun, so the end of the input here adds none
+  | "fieldStart" // after a `,`
+  | "unquoted"
+  | "unquotedCr" // in a field that is not quoted, after a `\r` that a `\n` would make a row end
+  | "quoted"
+  | "quote" // in a quoted field, after a `"` that closes it unless another `"` follows
+  | "quoteCr"; // after a closing quote and a `\r`, which only a `\n` may follow
+
+/**
+ * Reads CSV, as `parseCsv` describes it, from input that arrives in chunks of any size: `push` each chunk as it
+ * arrives and call `end` once the input is over. `push` returns each row whose row end it has seen and `end`
+ * returns the rest, so together they return `parseCsv` of the whole input. An input `parseCsv` rejects makes one
+ * of them throw a SyntaxError, as early as the chunks allow. The work for a chunk does not grow with the input
+ * before it. After `end` or a SyntaxError, the stream takes no more calls.
+ */
+export class CsvStream {
+  private state: StreamState = "bom";
+  private row: string[] = [];
+  private field = "";
+  private offset = 0; // of the current chunk in the whole input
+  private crOffset = 0; // of the `\r` in state "quoteCr"
+  private done = false;
+
+  push(chunk: string): string[][] {
+    this.checkOpen();
+    const rows: string[][] = [];
+    const n = chunk.length;
+    let i = 0;
+    while (i < n) {
+      switch (this.state) {
+        case "bom":
+          if (chunk[i] === "﻿") i++;
+          this.state = "rowStart";
+          break;
+        case "rowStart":
+        case "fieldStart":
+          if (chunk[i] === '"') {
+            i++;
+            this.state = "quoted";
+          } else this.state = "unquoted";
+          break;
+        case "unquoted": {
+          let j = i;
+          let c: string | undefined;
+          while (j < n && (c = chunk[j]) !== "," && c !== "\n" && c !== "\r" && c !== '"') j++;
+          this.field += chunk.slice(i, j);
+          i = j + 1;
+          if (j === n) break;
+          if (c === '"') throw this.reject(`a quote in a field that is not quoted, at offset ${this.offset + j}`);
+          if (c === ",") this.endField();
+          else if (c === "\n") this.endRow(rows);
+          else this.state = "unquotedCr";
+          break;
+        }
+        case "unquotedCr":
+          if (chunk[i] === "\n") {
+            i++;
+            this.endRow(rows);
+          } else {
+            this.field += "\r";
+            this.state = "unquoted";
+          }
+          break;
+        case "quoted": {
+          const j = chunk.indexOf('"', i);
+          this.field += j < 0 ? chunk.slice(i) : chunk.slice(i, j);
+          i = j < 0 ? n : j + 1;
+          if (j >= 0) this.state = "quote";
+          break;
+        }
+        case "quote": {
+          const c = chunk[i]!;
+          if (c === '"') {
+            this.field += '"';
+            this.state = "quoted";
+          } else if (c === ",") this.endField();
+          else if (c === "\n") this.endRow(rows);
+          else if (c === "\r") {
+            this.crOffset = this.offset + i;
+            this.state = "quoteCr";
+          } else throw this.reject(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${this.offset + i}`);
+          i++;
+          break;
+        }
+        case "quoteCr":
+          if (chunk[i] !== "\n") throw this.rejectQuoteCr();
+          i++;
+          this.endRow(rows);
+          break;
+      }
+    }
+    this.offset += n;
+    return rows;
+  }
+
+  end(): string[][] {
+    this.checkOpen();
+    this.done = true;
+    switch (this.state) {
+      case "bom":
+      case "rowStart":
+        return [];
+      case "quoted":
+        throw new SyntaxError("a quoted field is still open at the end of the input");
+      case "quoteCr":
+        throw this.rejectQuoteCr();
+      case "unquotedCr":
+        this.field += "\r";
+    }
+    this.row.push(this.field);
+    return [this.row];
+  }
+
+  private endField() {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "fieldStart";
+  }
+
+  private endRow(rows: string[][]) {
+    this.row.push(this.field);
+    this.field = "";
+    rows.push(this.row);
+    this.row = [];
+    this.state = "rowStart";
+  }
+
+  private checkOpen() {
+    if (this.done) throw new Error("this CsvStream has already ended or rejected its input");
+  }
+
+  private reject(message: string): SyntaxError {
+    this.done = true;
+    return new SyntaxError(message);
+  }
+
+  private rejectQuoteCr(): SyntaxError {
+    return this.reject(`unexpected "\\r" after a closing quote at offset ${this.crOffset}`);
+  }
+}
