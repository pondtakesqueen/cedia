--- a/ledger.edge.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.edge.test.ts	2026-10-30 17:19:32.413749751 +0000
@@ -0,0 +1,29 @@
+import { expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type SessionEvent } from './ledger.ts';
+
+test('cd prefix: quotes, relative dirs, only one leading cd, still no pipes', () => {
+  expect(matchCheck("cd '/work/repo' && bun test", ['bun test'], '/work/repo')).toBe('bun test');
+  expect(matchCheck('cd sub/.. && bun test', ['bun test'], '/work/repo')).toBe('bun test');
+  expect(matchCheck('cd /work/repo && bun test | tail', ['bun test'], '/work/repo')).toBeUndefined();
+  expect(matchCheck('bun test && cd /work/repo', ['bun test'], '/work/repo')).toBeUndefined();
+  expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], '/work/repo')).toBeUndefined();
+});
+
+test('denied calls ignore snapshots; a failed writing bash is still a write', () => {
+  const events: SessionEvent[] = [
+    { kind: 'tool_intent', callId: 'a', tool: 'bash', input: { command: 'sed -i x f' } },
+    { kind: 'snapshot', callId: 'a', changed: ['f'] },
+    { kind: 'tool_result', callId: 'a', status: 'denied', output: { isError: true } },
+    { kind: 'tool_intent', callId: 'b', tool: 'bash', input: { command: 'make' } },
+    { kind: 'tool_result', callId: 'b', status: 'failed', output: { isError: true, exitCode: 2 } },
+  ];
+  expect(ledgerEntries(events, ['bun test'])).toEqual([{ kind: 'write', at: 4, tool: 'bash', command: 'make' }]);
+});
+
+test('a later passing check verifies, a failing one after it does not undo writes coverage', () => {
+  const w = { kind: 'write' as const, at: 1, tool: 'edit', path: 'a.ts' };
+  const ok = { kind: 'check' as const, at: 2, command: 'bun test', exitCode: 0 };
+  const bad = { kind: 'check' as const, at: 3, command: 'bun test', exitCode: 1 };
+  expect(verified([w, ok, bad], ['bun test'])).toBe(true);
+  expect(evidence([w, ok, bad]).unverified).toEqual([]);
+});
