+++ b/src/slug.ts	2026-10-30 05:35:07.291539578 +0000
@@ -11,10 +11,31 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+
+// Letters that Unicode does not decompose into a base letter plus combining marks.
+const LETTERS: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  if (max !== undefined && !(max >= 0)) throw new RangeError(`Invalid slug length ${max}`);
+
+  const slug = text
+    .toLowerCase()
+    .normalize('NFD') // é -> e + U+0301, and so on
+    .replace(/\p{M}/gu, '')
+    .replace(/[ßæœøłđ]/g, (letter) => LETTERS[letter])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+
+  if (max === undefined || slug.length <= max) return slug;
+  // Searching from index max, not max - 1, is what lets a "-" right after the first max characters count.
+  const cut = slug.lastIndexOf('-', max);
+  return slug.slice(0, cut > 0 ? cut : max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  for (let n = 2; ; n++) {
+    const candidate = `${slug}-${n}`;
+    if (!taken.has(candidate)) return candidate;
+  }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 05:35:32.019539012 +0000
@@ -0,0 +1,88 @@
+import { describe, expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+describe('parseDuration', () => {
+  test('every unit', () => {
+    expect(parseDuration('2d')).toBe(172_800_000);
+    expect(parseDuration('3h')).toBe(10_800_000);
+    expect(parseDuration('4m')).toBe(240_000);
+    expect(parseDuration('5s')).toBe(5_000);
+    expect(parseDuration('250ms')).toBe(250);
+  });
+
+  test('ms is milliseconds, not minutes then seconds', () => {
+    expect(parseDuration('1ms')).toBe(1);
+    expect(parseDuration('1m1s')).toBe(61_000);
+    expect(parseDuration('1m1ms')).toBe(60_001);
+  });
+
+  test('several parts, with or without spaces between them', () => {
+    expect(parseDuration('1d2h3m4s5ms')).toBe(93_784_005);
+    expect(parseDuration('2d 4h')).toBe(187_200_000);
+    expect(parseDuration('1h   30m 15s')).toBe(5_415_000);
+  });
+
+  test('spaces around the whole text are ignored', () => {
+    expect(parseDuration('  90s  ')).toBe(90_000);
+    expect(parseDuration(' 2d 4h ')).toBe(187_200_000);
+  });
+
+  test('fractions', () => {
+    expect(parseDuration('1.5h')).toBe(5_400_000);
+    expect(parseDuration('0.25s')).toBe(250);
+    expect(parseDuration('1.5h 0.5m')).toBe(5_430_000);
+  });
+
+  test('rounds to a whole number of milliseconds', () => {
+    expect(parseDuration('1.4ms')).toBe(1);
+    expect(parseDuration('1.5ms')).toBe(2);
+    expect(parseDuration('0.0004s')).toBe(0);
+    // 1.0005 * 1000 is 1000.4999999999999 in floating point; the text says 1000.5.
+    expect(parseDuration('1.0005s')).toBe(1001);
+    expect(parseDuration('0.3ms 0.2ms')).toBe(1);
+  });
+
+  test('throws with the input in the message for anything else', () => {
+    const bad = [
+      '', '   ', '10', '5x', 'h', 'ms', '-1s', '+1s', '1.s', '.5s', '1 h', '1H', '1e3s', '1h,30m', '1h-30m',
+      '1h 30', 'one second', '1s!',
+    ];
+    for (const text of bad) expect(() => parseDuration(text), text).toThrow(`"${text}"`);
+  });
+});
+
+describe('formatDuration', () => {
+  test('largest unit first, zero parts left out, no spaces', () => {
+    expect(formatDuration(5_400_000)).toBe('1h30m');
+    expect(formatDuration(1_500)).toBe('1s500ms');
+    expect(formatDuration(90_000)).toBe('1m30s');
+    expect(formatDuration(93_784_005)).toBe('1d2h3m4s5ms');
+    expect(formatDuration(3_600_001)).toBe('1h1ms');
+    expect(formatDuration(172_801_000)).toBe('2d1s');
+  });
+
+  test('single units', () => {
+    expect(formatDuration(1)).toBe('1ms');
+    expect(formatDuration(999)).toBe('999ms');
+    expect(formatDuration(1_000)).toBe('1s');
+    expect(formatDuration(60_000)).toBe('1m');
+    expect(formatDuration(3_600_000)).toBe('1h');
+    expect(formatDuration(86_400_000)).toBe('1d');
+    expect(formatDuration(30 * 86_400_000)).toBe('30d');
+  });
+
+  test('zero is 0s', () => {
+    expect(formatDuration(0)).toBe('0s');
+  });
+
+  test('throws on a negative number', () => {
+    expect(() => formatDuration(-1)).toThrow();
+    expect(() => formatDuration(-0.5)).toThrow();
+  });
+
+  test('parses back to the same number', () => {
+    for (const ms of [0, 1, 999, 1_500, 61_001, 5_400_000, 93_784_005, 1_000_000_000]) {
+      expect(parseDuration(formatDuration(ms))).toBe(ms);
+    }
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 05:36:06.923538214 +0000
@@ -0,0 +1,211 @@
+import { describe, expect, test } from 'bun:test';
+import { type EvictReason, LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttlMs = 1000) {
+  const clock = { t: 0 };
+  const cache = new LRU<string, number>(capacity, ttlMs, () => clock.t);
+  const evicted: [string, number, EvictReason][] = [];
+  cache.onEvict = (key, value, reason) => evicted.push([key, value, reason]);
+  return { clock, cache, evicted };
+}
+
+describe('get', () => {
+  test('a hit returns the value and makes the entry the most recently used', () => {
+    const { cache, evicted } = setup(2);
+    cache.set('a', 1);
+    cache.set('b', 2);
+    expect(cache.get('a')).toBe(1);
+    expect(cache.keys()).toEqual(['a', 'b']);
+    cache.set('c', 3);
+    expect(evicted).toEqual([['b', 2, 'capacity']]);
+    expect(cache.keys()).toEqual(['c', 'a']);
+  });
+
+  test('missing is undefined and evicts nothing', () => {
+    const { cache, evicted } = setup(2);
+    expect(cache.get('nope')).toBeUndefined();
+    expect(evicted).toEqual([]);
+  });
+
+  test('an expired entry is removed with reason expired', () => {
+    const { clock, cache, evicted } = setup(2);
+    cache.set('a', 1);
+    clock.t = 1000;
+    expect(cache.get('a')).toBeUndefined();
+    expect(evicted).toEqual([['a', 1, 'expired']]);
+    expect(cache.get('a')).toBeUndefined();
+    expect(evicted).toHaveLength(1);
+  });
+
+  test('a hit does not extend the ttl', () => {
+    const { clock, cache } = setup(2);
+    cache.set('a', 1);
+    clock.t = 900;
+    expect(cache.get('a')).toBe(1);
+    clock.t = 1000;
+    expect(cache.get('a')).toBeUndefined();
+  });
+});
+
+describe('expiry', () => {
+  test('live while now() < t + ttlMs', () => {
+    const { clock, cache } = setup(2);
+    clock.t = 500;
+    cache.set('a', 1);
+    clock.t = 1499;
+    expect(cache.get('a')).toBe(1);
+    clock.t = 1500;
+    expect(cache.get('a')).toBeUndefined();
+  });
+
+  test('defaults to Date.now', () => {
+    const cache = new LRU<string, number>(2, 60_000);
+    cache.set('a', 1);
+    expect(cache.get('a')).toBe(1);
+    expect(cache.size).toBe(1);
+  });
+});
+
+describe('set', () => {
+  test('replacing a key gives a fresh ttl and makes it the most recently used, without evicting', () => {
+    const { clock, cache, evicted } = setup(2);
+    cache.set('a', 1);
+    cache.set('b', 2);
+    clock.t = 600;
+    cache.set('a', 10);
+    expect(cache.keys()).toEqual(['a', 'b']);
+    expect(evicted).toEqual([]);
+    clock.t = 1200;
+    expect(cache.get('a')).toBe(10);
+    expect(cache.get('b')).toBeUndefined();
+    clock.t = 1600;
+    expect(cache.get('a')).toBeUndefined();
+  });
+
+  test('replacing an expired key removes the old value with reason expired', () => {
+    const { clock, cache, evicted } = setup(2);
+    cache.set('a', 1);
+    clock.t = 1000;
+    cache.set('a', 2);
+    expect(evicted).toEqual([['a', 1, 'expired']]);
+    expect(cache.get('a')).toBe(2);
+  });
+
+  test('going over capacity evicts the least recently used entry', () => {
+    const { cache, evicted } = setup(3);
+    cache.set('a', 1);
+    cache.set('b', 2);
+    cache.set('c', 3);
+    expect(evicted).toEqual([]);
+    cache.set('d', 4);
+    cache.set('e', 5);
+    expect(evicted).toEqual([
+      ['a', 1, 'capacity'],
+      ['b', 2, 'capacity'],
+    ]);
+    expect(cache.keys()).toEqual(['e', 'd', 'c']);
+  });
+
+  test('capacity counts expired entries, which are removed only once the cache goes over', () => {
+    const { clock, cache, evicted } = setup(2);
+    cache.set('a', 1);
+    clock.t = 1000;
+    cache.set('b', 2);
+    expect(evicted).toEqual([]);
+    expect(cache.size).toBe(1);
+    cache.set('c', 3);
+    expect(evicted).toEqual([['a', 1, 'expired']]);
+    expect(cache.keys()).toEqual(['c', 'b']);
+  });
+
+  test('expired entries go first even when a live entry is less recently used', () => {
+    const { clock, cache, evicted } = setup(2);
+    cache.set('x', 1); // expires at 1000
+    clock.t = 500;
+    cache.set('y', 2); // expires at 1500
+    clock.t = 600;
+    cache.get('x'); // x is now the most recently used, y the least
+    clock.t = 1100;
+    cache.set('z', 3);
+    expect(evicted).toEqual([['x', 1, 'expired']]);
+    expect(cache.keys()).toEqual(['z', 'y']);
+  });
+
+  test('every expired entry is removed, least recently used first', () => {
+    const { clock, cache, evicted } = setup(3);
+    cache.set('a', 1);
+    cache.set('b', 2);
+    clock.t = 500;
+    cache.set('c', 3);
+    clock.t = 1000;
+    cache.set('d', 4);
+    expect(evicted).toEqual([
+      ['a', 1, 'expired'],
+      ['b', 2, 'expired'],
+    ]);
+    expect(cache.keys()).toEqual(['d', 'c']);
+  });
+});
+
+describe('delete', () => {
+  test('a live entry: true, reason delete', () => {
+    const { cache, evicted } = setup(2);
+    cache.set('a', 1);
+    expect(cache.delete('a')).toBe(true);
+    expect(evicted).toEqual([['a', 1, 'delete']]);
+    expect(cache.get('a')).toBeUndefined();
+    expect(cache.size).toBe(0);
+  });
+
+  test('a missing entry: false, no callback', () => {
+    const { cache, evicted } = setup(2);
+    expect(cache.delete('a')).toBe(false);
+    expect(evicted).toEqual([]);
+  });
+
+  test('an expired entry: false, removed with reason expired', () => {
+    const { clock, cache, evicted } = setup(2);
+    cache.set('a', 1);
+    clock.t = 1000;
+    expect(cache.delete('a')).toBe(false);
+    expect(evicted).toEqual([['a', 1, 'expired']]);
+    expect(cache.delete('a')).toBe(false);
+    expect(evicted).toHaveLength(1);
+  });
+
+  test('the freed slot is reused without evicting', () => {
+    const { cache, evicted } = setup(2);
+    cache.set('a', 1);
+    cache.set('b', 2);
+    cache.delete('a');
+    cache.set('c', 3);
+    expect(evicted).toEqual([['a', 1, 'delete']]);
+    expect(cache.keys()).toEqual(['c', 'b']);
+  });
+});
+
+describe('size and keys', () => {
+  test('count and list only live entries, most recently used first', () => {
+    const { clock, cache, evicted } = setup(3);
+    cache.set('a', 1);
+    clock.t = 500;
+    cache.set('b', 2);
+    cache.set('c', 3);
+    cache.get('b');
+    expect(cache.size).toBe(3);
+    expect(cache.keys()).toEqual(['b', 'c', 'a']);
+    clock.t = 1000;
+    expect(cache.size).toBe(2);
+    expect(cache.keys()).toEqual(['b', 'c']);
+    clock.t = 1500;
+    expect(cache.size).toBe(0);
+    expect(cache.keys()).toEqual([]);
+    expect(evicted).toEqual([]);
+  });
+});
+
+test('rejects a negative capacity or ttl', () => {
+  expect(() => new LRU(-1, 1000)).toThrow(RangeError);
+  expect(() => new LRU(1, -1)).toThrow(RangeError);
+  expect(() => new LRU(NaN, 1000)).toThrow(RangeError);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 05:35:46.319538685 +0000
@@ -0,0 +1,101 @@
+import { describe, expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+describe('slugify', () => {
+  test('lower case', () => {
+    expect(slugify('ABC Def')).toBe('abc-def');
+  });
+
+  test('diacritics are dropped', () => {
+    expect(slugify('à ç ñ ź')).toBe('a-c-n-z');
+    expect(slugify('Ångström Øre')).toBe('angstrom-ore');
+    expect(slugify('Tiếng Việt')).toBe('tieng-viet');
+    expect(slugify('ŽŠČĆ ăîș')).toBe('zscc-ais');
+    // Already decomposed: e followed by a combining acute accent.
+    expect(slugify('café')).toBe('cafe');
+  });
+
+  test('letters that do not decompose', () => {
+    expect(slugify('Straße')).toBe('strasse');
+    expect(slugify('ẞ')).toBe('ss');
+    expect(slugify('Ærøskøbing')).toBe('aeroskobing');
+    expect(slugify('Œuvre cœur')).toBe('oeuvre-coeur');
+    expect(slugify('Łódź')).toBe('lodz');
+    expect(slugify('Đakovo đ')).toBe('dakovo-d');
+    expect(slugify('ÆŒØŁĐ')).toBe('aeoeold');
+    // With a diacritic on top: æ + macron, ø + acute.
+    expect(slugify('ǣ ǿ')).toBe('ae-o');
+  });
+
+  test('anything else not a-z or 0-9 separates', () => {
+    expect(slugify('Top 10 tips')).toBe('top-10-tips');
+    expect(slugify('a_b.c/d+e')).toBe('a-b-c-d-e');
+    expect(slugify('a🙂b')).toBe('a-b');
+    expect(slugify('日本語 title')).toBe('title');
+    expect(slugify('ðþ x')).toBe('x');
+  });
+
+  test('runs of separators become one "-", never at either end', () => {
+    expect(slugify('--a -- b--')).toBe('a-b');
+    expect(slugify('  hi  ')).toBe('hi');
+    expect(slugify('...wait...what?!')).toBe('wait-what');
+    expect(slugify('!!!')).toBe('');
+    expect(slugify('')).toBe('');
+  });
+
+  test('max cuts at the last "-" that keeps the slug within max', () => {
+    expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+    expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+    expect(slugify('ab-cd-ef', 7)).toBe('ab-cd');
+    expect(slugify('ab-cd-ef', 4)).toBe('ab');
+    expect(slugify('ab-cd-ef', 2)).toBe('ab');
+    expect(slugify('abcd-efgh', 5)).toBe('abcd');
+    expect(slugify('Hello, World!', 7)).toBe('hello');
+  });
+
+  test('max cuts at max itself when there is no "-" to cut at', () => {
+    expect(slugify('abcdefgh', 3)).toBe('abc');
+    expect(slugify('abcdef-gh', 3)).toBe('abc');
+    expect(slugify('ab-cd-ef', 1)).toBe('a');
+    expect(slugify('abc', 0)).toBe('');
+  });
+
+  test('max leaves a slug that already fits alone', () => {
+    expect(slugify('ab-cd-ef', 8)).toBe('ab-cd-ef');
+    expect(slugify('ab-cd-ef', 100)).toBe('ab-cd-ef');
+    // Length is counted after the separators are collapsed and trimmed.
+    expect(slugify('  ab -- cd  ', 5)).toBe('ab-cd');
+  });
+
+  test('a cut slug never ends with "-"', () => {
+    const text = 'the quick brown fox jumps over the lazy dog';
+    for (let max = 0; max <= 45; max++) {
+      const slug = slugify(text, max);
+      expect(slug.length).toBeLessThanOrEqual(max);
+      expect(slug.endsWith('-')).toBe(false);
+    }
+  });
+
+  test('max must not be negative', () => {
+    expect(() => slugify('abc', -1)).toThrow(RangeError);
+    expect(() => slugify('abc', NaN)).toThrow(RangeError);
+  });
+});
+
+describe('uniqueSlug', () => {
+  test('the slug itself when it is free', () => {
+    expect(uniqueSlug('post', new Set())).toBe('post');
+    expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+  });
+
+  test('the first free numbered slug', () => {
+    expect(uniqueSlug('post', new Set(['post', 'post-2', 'post-3']))).toBe('post-4');
+    expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+  });
+
+  test('does not change taken', () => {
+    const taken = new Set(['post']);
+    uniqueSlug('post', taken);
+    expect([...taken]).toEqual(['post']);
+  });
+});
