 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+interface Entry<V> {
+  value: V;
+  expiresAt: number;
+}
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
 
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
+  // Map iterates in insertion order, so re-inserting on use keeps the least recently used entry first.
+  private readonly entries = new Map<K, Entry<V>>();
+
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    if (!(capacity >= 0)) throw new RangeError(`Invalid capacity ${capacity}`);
+    if (!(ttlMs >= 0)) throw new RangeError(`Invalid ttl ${ttlMs}`);
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return undefined;
+    if (entry.expiresAt <= this.now()) {
+      this.evict(key, entry, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const t = this.now();
+    const old = this.entries.get(key);
+    if (old) {
+      // A live value is simply replaced; an expired one counts as found, and so as removed.
+      if (old.expiresAt <= t) this.evict(key, old, 'expired');
+      else this.entries.delete(key);
+    }
+    this.entries.set(key, { value, expiresAt: t + this.ttlMs });
+
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, entry] of this.entries) {
+      if (entry.expiresAt <= t) this.evict(k, entry, 'expired');
+    }
+    for (const [k, entry] of this.entries) {
+      if (this.entries.size <= this.capacity) break;
+      this.evict(k, entry, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return false;
+    const live = entry.expiresAt > this.now();
+    this.evict(key, entry, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    const t = this.now();
+    let count = 0;
+    for (const entry of this.entries.values()) if (entry.expiresAt > t) count++;
+    return count;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
+    const keys: K[] = [];
+    for (const [key, entry] of this.entries) if (entry.expiresAt > t) keys.push(key);
+    return keys.reverse();
+  }
+
+  private evict(key: K, entry: Entry<V>, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, entry.value, reason);
   }
 }
