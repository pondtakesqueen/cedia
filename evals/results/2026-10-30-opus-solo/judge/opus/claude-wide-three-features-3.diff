 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+
+// Largest first, the order formatDuration writes them in.
+const UNITS: [unit: string, ms: number][] = [
+  ['d', 86_400_000],
+  ['h', 3_600_000],
+  ['m', 60_000],
+  ['s', 1_000],
+  ['ms', 1],
+];
+const UNIT_MS = new Map(UNITS.map(([unit, ms]) => [unit, BigInt(ms)]));
+
+// "ms" comes before "m" so that "250ms" is not read as 250 minutes followed by a stray "s".
+const PART = /(\d+)(?:\.(\d+))?(ms|d|h|m|s)\s*/y;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const body = text.trim();
+  if (body === '') throw invalid(text);
+
+  // The total is kept exact, as num / 10^scale milliseconds, so that a value like "1.0005s" rounds the way it is
+  // written instead of the way its nearest float does.
+  let num = 0n;
+  let scale = 0;
+  PART.lastIndex = 0;
+  while (PART.lastIndex < body.length) {
+    const match = PART.exec(body);
+    if (!match) throw invalid(text);
+    const [, whole, fraction = '', unit] = match;
+    let part = BigInt(whole + fraction) * UNIT_MS.get(unit)!;
+    if (fraction.length > scale) {
+      num *= 10n ** BigInt(fraction.length - scale);
+      scale = fraction.length;
+    } else {
+      part *= 10n ** BigInt(scale - fraction.length);
+    }
+    num += part;
+  }
+
+  const den = 10n ** BigInt(scale);
+  const ms = Number((2n * num + den) / (2n * den)); // half up
+  if (!Number.isFinite(ms)) throw invalid(text);
+  return ms;
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new RangeError(`Cannot format duration ${ms}`);
+  let rest = Math.round(ms);
+  let text = '';
+  for (const [unit, size] of UNITS) {
+    const count = Math.floor(rest / size);
+    if (count > 0) text += `${count}${unit}`;
+    rest %= size;
+  }
+  return text || '0s';
+}
+
+function invalid(text: string): Error {
+  return new Error(`Invalid duration "${text}"`);
 }
