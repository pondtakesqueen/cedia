 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNITS: [string, number][] = [
+  ['d', 86_400_000],
+  ['h', 3_600_000],
+  ['m', 60_000],
+  ['s', 1_000],
+  ['ms', 1],
+];
+const UNIT_MS = new Map(UNITS);
+
+// "ms" comes before "m" so that "250ms" is not read as "250m" followed by a stray "s".
+const PART = /\s*(\d+)(?:\.(\d+))?(ms|d|h|m|s)/y;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const invalid = () => new Error(`Invalid duration: "${text}"`);
+  const body = text.trim();
+  if (body === '') throw invalid();
+
+  // Sum the parts exactly, as numerator / 10^scale, so "1.0005s" rounds to 1001 rather than suffering
+  // from floating-point error.
+  let numerator = 0n;
+  let scale = 0;
+  PART.lastIndex = 0;
+  while (PART.lastIndex < body.length) {
+    const match = PART.exec(body);
+    if (!match) throw invalid();
+    const [, whole, fraction = '', unit] = match;
+    if (fraction.length > scale) {
+      numerator *= 10n ** BigInt(fraction.length - scale);
+      scale = fraction.length;
+    }
+    const value = BigInt(whole + fraction) * 10n ** BigInt(scale - fraction.length);
+    numerator += value * BigInt(UNIT_MS.get(unit)!);
+  }
+
+  const denominator = 10n ** BigInt(scale);
+  const ms = Number((2n * numerator + denominator) / (2n * denominator));
+  if (!Number.isFinite(ms)) throw invalid();
+  return ms;
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (Number.isNaN(ms) || ms < 0 || ms === Infinity) {
+    throw new Error(`Cannot format duration: ${ms}`);
+  }
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+
+  let text = '';
+  for (const [unit, size] of UNITS) {
+    const count = Math.floor(rest / size);
+    if (count > 0) {
+      text += `${count}${unit}`;
+      rest -= count * size;
+    }
+  }
+  return text;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
