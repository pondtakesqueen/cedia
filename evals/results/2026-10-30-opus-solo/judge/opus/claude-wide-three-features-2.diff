--- a/src/slug.ts	2026-10-30 05:31:42.643435903 +0000
+++ b/src/slug.ts	2026-10-30 05:33:30.871541783 +0000
@@ -11,10 +11,31 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const LETTERS: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  if (max !== undefined && !(max >= 0)) throw new RangeError(`Invalid slug length: ${max}`);
+
+  // Decompose so that diacritics become separate combining marks, which are then dropped. The letters in
+  // LETTERS have no decomposition and are mapped afterwards ("ǿ" decomposes to "ø" plus an accent).
+  const slug = text
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/\p{Mn}/gu, '')
+    .replace(/[ßæœøłđ]/g, (letter) => LETTERS[letter])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+
+  if (max === undefined || slug.length <= max) return slug;
+  const limit = Math.floor(max);
+  const cut = slug.lastIndexOf('-', limit);
+  return slug.slice(0, cut > 0 ? cut : limit);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  for (let n = 2; ; n++) {
+    const candidate = `${slug}-${n}`;
+    if (!taken.has(candidate)) return candidate;
+  }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 05:33:56.091541206 +0000
@@ -0,0 +1,64 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parseDuration reads every unit', () => {
+  expect(parseDuration('2d')).toBe(172_800_000);
+  expect(parseDuration('3h')).toBe(10_800_000);
+  expect(parseDuration('4m')).toBe(240_000);
+  expect(parseDuration('5s')).toBe(5_000);
+  expect(parseDuration('250ms')).toBe(250);
+});
+
+test('parseDuration tells ms apart from m followed by s', () => {
+  expect(parseDuration('1m5s')).toBe(65_000);
+  expect(parseDuration('1m5ms')).toBe(60_005);
+  expect(parseDuration('1ms1m')).toBe(60_001);
+});
+
+test('parseDuration accepts fractions and rounds to whole milliseconds', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('0.5s')).toBe(500);
+  expect(parseDuration('1.4ms')).toBe(1);
+  expect(parseDuration('1.5ms')).toBe(2);
+  expect(parseDuration('0.0005s')).toBe(1);
+  expect(parseDuration('1.0005s')).toBe(1001);
+  expect(parseDuration('0.25ms 0.25ms')).toBe(1);
+});
+
+test('parseDuration allows spaces between parts and around the text', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('1h   30m')).toBe(5_400_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+  expect(parseDuration('\t1d 1h 1m 1s 1ms\n')).toBe(90_061_001);
+  expect(parseDuration('0s')).toBe(0);
+});
+
+test('parseDuration rejects anything else, quoting the input', () => {
+  const bad = ['', '   ', '10', '5x', 'h', '-1s', '+1s', '1 h', '1.s', '.5s', '1.5.5s', '1H', '1hm', '1h,30m', 's1', '1e3s'];
+  for (const text of bad) {
+    expect(() => parseDuration(text)).toThrow(`"${text}"`);
+  }
+});
+
+test('formatDuration uses the largest units first and leaves out zero parts', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(1)).toBe('1ms');
+  expect(formatDuration(60_000)).toBe('1m');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(formatDuration(86_400_001)).toBe('1d1ms');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(3 * 86_400_000 + 5_000)).toBe('3d5s');
+});
+
+test('formatDuration throws on a negative number', () => {
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(-0.5)).toThrow();
+  expect(() => formatDuration(Number.NaN)).toThrow();
+});
+
+test('formatDuration output parses back to the same value', () => {
+  for (const ms of [0, 1, 999, 1_000, 59_999, 3_600_000, 5_400_000, 90_061_001, 1_234_567_890]) {
+    expect(parseDuration(formatDuration(ms))).toBe(ms);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 05:34:28.591540463 +0000
@@ -0,0 +1,213 @@
+import { expect, test } from 'bun:test';
+import { type EvictReason, LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttlMs = 1000) {
+  const clock = { t: 0 };
+  const cache = new LRU<string, number>(capacity, ttlMs, () => clock.t);
+  const evicted: [string, number, EvictReason][] = [];
+  cache.onEvict = (key, value, reason) => evicted.push([key, value, reason]);
+  return { clock, cache, evicted };
+}
+
+test('get returns the value and makes the entry the most recently used', () => {
+  const { cache, evicted } = setup(2);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+  expect(cache.get('missing')).toBeUndefined();
+});
+
+test('get does not renew the ttl', () => {
+  const { clock, cache } = setup(2);
+  cache.set('a', 1);
+  clock.t = 999;
+  expect(cache.get('a')).toBe(1);
+  clock.t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('an entry is live while now() < t + ttlMs', () => {
+  const { clock, cache } = setup(2);
+  clock.t = 500;
+  cache.set('a', 1);
+  clock.t = 1499;
+  expect(cache.get('a')).toBe(1);
+  expect(cache.size).toBe(1);
+  clock.t = 1500;
+  expect(cache.size).toBe(0);
+  expect(cache.keys()).toEqual([]);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('get removes an expired entry with reason "expired"', () => {
+  const { clock, cache, evicted } = setup(2);
+  cache.set('a', 1);
+  clock.t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.get('a')).toBeUndefined();
+  expect(evicted).toHaveLength(1);
+});
+
+test('set replaces a value, making it the most recently used with a fresh ttl', () => {
+  const { clock, cache, evicted } = setup(2);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  clock.t = 600;
+  cache.set('a', 10);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  expect(cache.size).toBe(2);
+  clock.t = 1000;
+  expect(cache.get('a')).toBe(10);
+  expect(cache.get('b')).toBeUndefined();
+  clock.t = 1600;
+  expect(cache.get('a')).toBeUndefined();
+  expect(evicted).toEqual([
+    ['b', 2, 'expired'],
+    ['a', 10, 'expired'],
+  ]);
+});
+
+test('set evicts the least recently used entry when over capacity', () => {
+  const { cache, evicted } = setup(3);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  cache.get('a');
+  cache.set('d', 4);
+  cache.set('e', 5);
+  expect(evicted).toEqual([
+    ['b', 2, 'capacity'],
+    ['c', 3, 'capacity'],
+  ]);
+  expect(cache.keys()).toEqual(['e', 'd', 'a']);
+});
+
+test('capacity counts expired entries until they are removed', () => {
+  const { clock, cache, evicted } = setup(2);
+  cache.set('a', 1);
+  clock.t = 1000;
+  cache.set('b', 2);
+  // 'a' has expired but is still stored, so the cache is full and size only counts 'b'.
+  expect(cache.size).toBe(1);
+  expect(evicted).toEqual([]);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('set removes expired entries before evicting a live one', () => {
+  const { clock, cache, evicted } = setup(3);
+  cache.set('a', 1);
+  clock.t = 500;
+  cache.set('b', 2);
+  cache.set('c', 3);
+  cache.get('a');
+  clock.t = 1000;
+  // 'a' is the most recently used but has expired; 'b' is the least recently used live entry.
+  cache.set('d', 4);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['d', 'c', 'b']);
+});
+
+test('set removes all expired entries when over capacity', () => {
+  const { clock, cache, evicted } = setup(3);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  clock.t = 500;
+  cache.set('c', 3);
+  clock.t = 1000;
+  cache.set('d', 4);
+  expect(evicted).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+  ]);
+  expect(cache.keys()).toEqual(['d', 'c']);
+});
+
+test('set evicts a live entry only if still over capacity after removing expired ones', () => {
+  const { clock, cache, evicted } = setup(2);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  clock.t = 999;
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('setting an expired key reports the old value as expired', () => {
+  const { clock, cache, evicted } = setup(2);
+  cache.set('a', 1);
+  clock.t = 1000;
+  cache.set('a', 2);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('replacing a live value is not an eviction', () => {
+  const { cache, evicted } = setup(1);
+  cache.set('a', 1);
+  cache.set('a', 2);
+  expect(evicted).toEqual([]);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('delete removes a live entry with reason "delete"', () => {
+  const { cache, evicted } = setup(2);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(evicted).toEqual([['a', 1, 'delete']]);
+  expect(cache.keys()).toEqual(['b']);
+  expect(cache.delete('a')).toBe(false);
+  expect(cache.delete('missing')).toBe(false);
+  expect(evicted).toHaveLength(1);
+});
+
+test('delete removes an expired entry with reason "expired" and returns false', () => {
+  const { clock, cache, evicted } = setup(2);
+  cache.set('a', 1);
+  clock.t = 1000;
+  expect(cache.delete('a')).toBe(false);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  // It is gone: it no longer counts toward capacity.
+  cache.set('b', 2);
+  cache.set('c', 3);
+  expect(evicted).toHaveLength(1);
+});
+
+test('size and keys only count live entries', () => {
+  const { clock, cache, evicted } = setup(5);
+  cache.set('a', 1);
+  clock.t = 500;
+  cache.set('b', 2);
+  cache.set('c', 3);
+  expect(cache.size).toBe(3);
+  expect(cache.keys()).toEqual(['c', 'b', 'a']);
+  clock.t = 1000;
+  expect(cache.size).toBe(2);
+  expect(cache.keys()).toEqual(['c', 'b']);
+  expect(evicted).toEqual([]);
+});
+
+test('works without onEvict', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(1, 1000, () => t);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  t = 1000;
+  expect(cache.get('b')).toBeUndefined();
+  cache.set('c', 3);
+  expect(cache.delete('c')).toBe(true);
+  expect(cache.size).toBe(0);
+});
+
+test('defaults to Date.now', () => {
+  const cache = new LRU<string, number>(2, 60_000);
+  cache.set('a', 1);
+  expect(cache.get('a')).toBe(1);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 05:34:07.787540939 +0000
@@ -0,0 +1,72 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify lower-cases', () => {
+  expect(slugify('ABC Def')).toBe('abc-def');
+});
+
+test('slugify drops diacritics', () => {
+  expect(slugify('à ç ñ ź')).toBe('a-c-n-z');
+  expect(slugify('Ångström Über Čapek Şişli')).toBe('angstrom-uber-capek-sisli');
+  expect(slugify('ÀÇÑŹ')).toBe('acnz');
+  // Already decomposed input: "e" followed by a combining acute accent.
+  expect(slugify('café')).toBe('cafe');
+});
+
+test('slugify maps letters that have no decomposition', () => {
+  expect(slugify('ß æ œ ø ł đ')).toBe('ss-ae-oe-o-l-d');
+  expect(slugify('Straße Æsir Œuvre Øresund Łódź Đakovo')).toBe('strasse-aesir-oeuvre-oresund-lodz-dakovo');
+  expect(slugify('ẞ')).toBe('ss');
+  // "ǿ" decomposes to "ø" plus an acute accent.
+  expect(slugify('ǿ')).toBe('o');
+});
+
+test('slugify turns runs of other characters into a single "-"', () => {
+  expect(slugify('a  --  b')).toBe('a-b');
+  expect(slugify('a_b.c/d')).toBe('a-b-c-d');
+  expect(slugify('2024: a year')).toBe('2024-a-year');
+  expect(slugify('日本 and 中国')).toBe('and');
+  expect(slugify('x² + y²')).toBe('x-y');
+});
+
+test('slugify never starts or ends with "-"', () => {
+  expect(slugify('  --Hello--  ')).toBe('hello');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('')).toBe('');
+});
+
+test('slugify with max cuts at the last "-" within max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 7)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('ab-cd-ef', 2)).toBe('ab');
+  expect(slugify('Hello big world', 11)).toBe('hello-big');
+});
+
+test('slugify with max cuts at max when there is no "-" to cut at', () => {
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('abcdef-gh', 4)).toBe('abcd');
+  expect(slugify('ab-cd', 1)).toBe('a');
+  expect(slugify('abc', 0)).toBe('');
+});
+
+test('slugify with max leaves short slugs alone', () => {
+  expect(slugify('ab-cd-ef', 8)).toBe('ab-cd-ef');
+  expect(slugify('ab-cd-ef', 100)).toBe('ab-cd-ef');
+  // max applies to the slug, not to the input text.
+  expect(slugify('  Ab -- Cd  ', 5)).toBe('ab-cd');
+});
+
+test('uniqueSlug returns the slug when it is free', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['post-2', 'other']))).toBe('post');
+});
+
+test('uniqueSlug returns the first free numbered slug', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2', 'post-3']))).toBe('post-4');
+  expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+  const taken = new Set(['post', 'post-2']);
+  expect(uniqueSlug('post', taken)).toBe('post-3');
+  expect([...taken]).toEqual(['post', 'post-2']);
+});
