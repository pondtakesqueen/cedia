--- a/src/slug.ts	2026-10-30 05:31:27.935665455 +0000
+++ b/src/slug.ts	2026-10-30 05:34:42.411540147 +0000
@@ -11,10 +11,33 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+
+// Letters that Unicode does not decompose into a base letter plus combining marks, so NFD alone misses them.
+// ħ, ŧ, ŀ and ı are not in the rules above, but they are letters with a diacritic in the same way.
+const SPECIAL: Record<string, string> = {
+  ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd',
+  ħ: 'h', ŧ: 't', ŀ: 'l', ı: 'i',
+};
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[ßæœøłđħŧŀı]/g, (letter) => SPECIAL[letter])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  const limit = Math.max(0, Math.floor(max));
+  // Searching from index `limit` itself lets a "-" just past the limit count as a cut point.
+  const cut = slug.lastIndexOf('-', limit);
+  return slug.slice(0, cut > 0 ? cut : limit);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  for (let n = 2; ; n++) {
+    const candidate = `${slug}-${n}`;
+    if (!taken.has(candidate)) return candidate;
+  }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 05:35:03.719539659 +0000
@@ -0,0 +1,97 @@
+import { describe, expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+describe('parseDuration', () => {
+  test('every unit', () => {
+    expect(parseDuration('2d')).toBe(172_800_000);
+    expect(parseDuration('3h')).toBe(10_800_000);
+    expect(parseDuration('4m')).toBe(240_000);
+    expect(parseDuration('5s')).toBe(5_000);
+    expect(parseDuration('250ms')).toBe(250);
+  });
+
+  test('ms is not read as m followed by s', () => {
+    expect(parseDuration('1m1ms')).toBe(60_001);
+    expect(parseDuration('1ms1m')).toBe(60_001);
+  });
+
+  test('parts with and without spaces between them', () => {
+    expect(parseDuration('2d 4h')).toBe(187_200_000);
+    expect(parseDuration('2d4h')).toBe(187_200_000);
+    expect(parseDuration('1h  30m 15s')).toBe(5_415_000);
+  });
+
+  test('spaces around the whole text are ignored', () => {
+    expect(parseDuration('  90s  ')).toBe(90_000);
+  });
+
+  test('fractions', () => {
+    expect(parseDuration('1.5h')).toBe(5_400_000);
+    expect(parseDuration('0.25s')).toBe(250);
+  });
+
+  test('result is rounded to whole milliseconds', () => {
+    expect(parseDuration('1.4ms')).toBe(1);
+    expect(parseDuration('1.5ms')).toBe(2);
+    expect(parseDuration('0.0015s')).toBe(2);
+    // The total is rounded, not each part.
+    expect(parseDuration('0.4ms 0.4ms')).toBe(1);
+  });
+
+  test.each([
+    '',
+    '   ',
+    '10',
+    '5x',
+    'h',
+    '-1s',
+    '+1s',
+    '1 s',
+    '1.s',
+    '.5s',
+    '1,5s',
+    '1H',
+    '1h,30m',
+    '1h30',
+    '1e3s',
+    'ms',
+  ])('rejects %p with the input in the message', (text) => {
+    expect(() => parseDuration(text)).toThrow(`"${text}"`);
+  });
+});
+
+describe('formatDuration', () => {
+  test('largest unit first, zero parts left out', () => {
+    expect(formatDuration(5_400_000)).toBe('1h30m');
+    expect(formatDuration(1_500)).toBe('1s500ms');
+    expect(formatDuration(86_400_000 + 1)).toBe('1d1ms');
+    expect(formatDuration(93_784_005)).toBe('1d2h3m4s5ms');
+  });
+
+  test('single units', () => {
+    expect(formatDuration(1)).toBe('1ms');
+    expect(formatDuration(1_000)).toBe('1s');
+    expect(formatDuration(60_000)).toBe('1m');
+    expect(formatDuration(3_600_000)).toBe('1h');
+    expect(formatDuration(86_400_000)).toBe('1d');
+  });
+
+  test('days are the largest unit', () => {
+    expect(formatDuration(400 * 86_400_000)).toBe('400d');
+  });
+
+  test('zero is 0s', () => {
+    expect(formatDuration(0)).toBe('0s');
+  });
+
+  test('throws on a negative number', () => {
+    expect(() => formatDuration(-1)).toThrow();
+    expect(() => formatDuration(-0.5)).toThrow();
+  });
+
+  test('round-trips through parseDuration', () => {
+    for (const ms of [0, 1, 999, 1_000, 61_001, 5_400_000, 93_784_005]) {
+      expect(parseDuration(formatDuration(ms))).toBe(ms);
+    }
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 05:35:39.539538840 +0000
@@ -0,0 +1,199 @@
+import { beforeEach, expect, test } from 'bun:test';
+import { type EvictReason, LRU } from '../src/lru.ts';
+
+let t: number;
+let evicted: [string, number, EvictReason][];
+
+function cache(capacity: number, ttlMs = 1000): LRU<string, number> {
+  const c = new LRU<string, number>(capacity, ttlMs, () => t);
+  c.onEvict = (key, value, reason) => evicted.push([key, value, reason]);
+  return c;
+}
+
+beforeEach(() => {
+  t = 0;
+  evicted = [];
+});
+
+test('get returns the value, or undefined when missing', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  expect(c.get('a')).toBe(1);
+  expect(c.get('b')).toBeUndefined();
+  expect(evicted).toEqual([]);
+});
+
+test('a get hit makes the entry the most recently used', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  c.set('b', 2);
+  c.get('a');
+  expect(c.keys()).toEqual(['a', 'b']);
+  c.set('c', 3);
+  expect(evicted).toEqual([['b', 2, 'capacity']]);
+  expect(c.keys()).toEqual(['c', 'a']);
+});
+
+test('an entry is live while now() < t + ttlMs', () => {
+  const c = cache(2);
+  t = 100;
+  c.set('a', 1);
+  t = 1099;
+  expect(c.get('a')).toBe(1);
+  t = 1100;
+  expect(c.get('a')).toBeUndefined();
+});
+
+test('get removes an expired entry with reason expired', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  t = 1000;
+  expect(c.get('a')).toBeUndefined();
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(c.get('a')).toBeUndefined();
+  expect(evicted).toHaveLength(1);
+});
+
+test('a get hit does not refresh the ttl', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  t = 900;
+  expect(c.get('a')).toBe(1);
+  t = 1000;
+  expect(c.get('a')).toBeUndefined();
+});
+
+test('set on an existing key replaces it with a fresh ttl and no eviction', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  c.set('b', 2);
+  t = 900;
+  c.set('a', 10);
+  expect(evicted).toEqual([]);
+  expect(c.keys()).toEqual(['a', 'b']);
+  t = 1500;
+  expect(c.get('a')).toBe(10);
+  expect(c.keys()).toEqual(['a']);
+});
+
+test('set over an expired entry reports the old value as expired', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  t = 1000;
+  c.set('a', 10);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(c.get('a')).toBe(10);
+});
+
+test('set evicts the least recently used entry over capacity', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  c.set('b', 2);
+  c.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'capacity']]);
+  expect(c.keys()).toEqual(['c', 'b']);
+});
+
+test('capacity counts expired entries that are still stored', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  t = 1000;
+  c.set('b', 2);
+  // 'a' has expired but still takes a slot, so this goes over capacity.
+  expect(evicted).toEqual([]);
+  c.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(c.keys()).toEqual(['c', 'b']);
+});
+
+test('over capacity, all expired entries go before any live one', () => {
+  const c = cache(3);
+  c.set('a', 1);
+  t = 500;
+  c.set('b', 2);
+  c.get('a');
+  t = 600;
+  c.set('c', 3);
+  t = 1000; // 'a' expired, though it was used after 'b'; 'b' and 'c' are live.
+  c.set('d', 4);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(c.keys()).toEqual(['d', 'c', 'b']);
+
+  t = 1600; // 'b' and 'c' expired.
+  c.set('e', 5);
+  expect(evicted.slice(1)).toEqual([
+    ['b', 2, 'expired'],
+    ['c', 3, 'expired'],
+  ]);
+  expect(c.keys()).toEqual(['e', 'd']);
+});
+
+test('a live entry is evicted only when expired ones do not free enough room', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  c.set('b', 2);
+  t = 500;
+  c.set('c', 3); // no expired entries yet: 'a' goes for capacity
+  expect(evicted).toEqual([['a', 1, 'capacity']]);
+});
+
+test('delete of a live entry returns true with reason delete', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  expect(c.delete('a')).toBe(true);
+  expect(evicted).toEqual([['a', 1, 'delete']]);
+  expect(c.get('a')).toBeUndefined();
+  expect(c.delete('a')).toBe(false);
+  expect(evicted).toHaveLength(1);
+});
+
+test('delete of an expired entry returns false with reason expired', () => {
+  const c = cache(2);
+  c.set('a', 1);
+  t = 1000;
+  expect(c.delete('a')).toBe(false);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(c.delete('a')).toBe(false);
+  expect(evicted).toHaveLength(1);
+});
+
+test('delete of a missing key returns false without onEvict', () => {
+  const c = cache(2);
+  expect(c.delete('nope')).toBe(false);
+  expect(evicted).toEqual([]);
+});
+
+test('size counts only live entries', () => {
+  const c = cache(3);
+  expect(c.size).toBe(0);
+  c.set('a', 1);
+  t = 500;
+  c.set('b', 2);
+  expect(c.size).toBe(2);
+  t = 1000;
+  expect(c.size).toBe(1);
+  t = 1500;
+  expect(c.size).toBe(0);
+});
+
+test('keys lists live keys, most recently used first', () => {
+  const c = cache(3);
+  c.set('a', 1);
+  t = 500;
+  c.set('b', 2);
+  c.set('c', 3);
+  c.get('b');
+  expect(c.keys()).toEqual(['b', 'c', 'a']);
+  t = 1000;
+  expect(c.keys()).toEqual(['b', 'c']);
+});
+
+test('works without onEvict and with the default clock', () => {
+  const c = new LRU<string, number>(1, 60_000);
+  c.set('a', 1);
+  c.set('b', 2);
+  expect(c.get('a')).toBeUndefined();
+  expect(c.get('b')).toBe(2);
+  expect(c.delete('b')).toBe(true);
+  expect(c.size).toBe(0);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 05:35:14.115539422 +0000
@@ -0,0 +1,76 @@
+import { describe, expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+describe('slugify', () => {
+  test('lower case', () => {
+    expect(slugify('ABC Def')).toBe('abc-def');
+  });
+
+  test('diacritics are removed', () => {
+    expect(slugify('à ç ñ ź')).toBe('a-c-n-z');
+    expect(slugify('ÀÉÎÕÜ')).toBe('aeiou');
+    expect(slugify('Ångström')).toBe('angstrom');
+    expect(slugify('Dvořák')).toBe('dvorak');
+    // A base letter followed by a separate combining mark.
+    expect(slugify('été')).toBe('ete');
+  });
+
+  test('letters that are not decomposed', () => {
+    expect(slugify('ß æ œ ø ł đ')).toBe('ss-ae-oe-o-l-d');
+    expect(slugify('Straße')).toBe('strasse');
+    expect(slugify('ÆŒØŁĐ')).toBe('aeoeold');
+    expect(slugify('Łódź')).toBe('lodz');
+    expect(slugify('ǿ')).toBe('o');
+  });
+
+  test('other characters are separators, collapsed and trimmed', () => {
+    expect(slugify('  --Hello,   World!--  ')).toBe('hello-world');
+    expect(slugify('a_b.c/d')).toBe('a-b-c-d');
+    expect(slugify('日本 2024 語')).toBe('2024');
+    expect(slugify('x²')).toBe('x');
+    expect(slugify('!!!')).toBe('');
+    expect(slugify('')).toBe('');
+  });
+
+  test('digits are kept', () => {
+    expect(slugify('Top 10 of 2024')).toBe('top-10-of-2024');
+  });
+
+  test('max cuts at the last "-" within max', () => {
+    expect(slugify('ab-cd-ef', 7)).toBe('ab-cd');
+    expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+    expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  });
+
+  test('a "-" right after the first max characters counts', () => {
+    expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+    expect(slugify('ab-cd-ef', 2)).toBe('ab');
+  });
+
+  test('max cuts at max itself when there is no "-" to cut at', () => {
+    expect(slugify('abcdef', 3)).toBe('abc');
+    expect(slugify('abcdef-gh', 4)).toBe('abcd');
+    expect(slugify('ab-cd', 1)).toBe('a');
+  });
+
+  test('max leaves short slugs alone', () => {
+    expect(slugify('ab-cd', 5)).toBe('ab-cd');
+    expect(slugify('ab-cd', 50)).toBe('ab-cd');
+  });
+
+  test('max applies to the slug, not the input', () => {
+    expect(slugify('  Ab,  Cd!  ', 5)).toBe('ab-cd');
+  });
+});
+
+describe('uniqueSlug', () => {
+  test('free slug is returned as is', () => {
+    expect(uniqueSlug('post', new Set())).toBe('post');
+    expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+  });
+
+  test('first free numbered slug', () => {
+    expect(uniqueSlug('post', new Set(['post', 'post-2', 'post-3']))).toBe('post-4');
+    expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+  });
+});
