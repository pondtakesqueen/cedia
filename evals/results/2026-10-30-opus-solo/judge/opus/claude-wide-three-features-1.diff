@@ -14,30 +14,78 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+interface Entry<V> {
+  value: V;
+  expiresAt: number;
+}
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
 
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
+  // Least recently used first: a Map iterates in insertion order, and a hit re-inserts its key at the end.
+  private readonly entries = new Map<K, Entry<V>>();
+
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (entry === undefined) return undefined;
+    if (this.now() >= entry.expiresAt) {
+      this.evict(key, entry, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const now = this.now();
+    const old = this.entries.get(key);
+    if (old !== undefined) {
+      this.entries.delete(key);
+      // Overwriting a live value is not an eviction, but an expired one has left the cache.
+      if (now >= old.expiresAt) this.onEvict?.(key, old.value, 'expired');
+    }
+    this.entries.set(key, { value, expiresAt: now + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+
+    const expired = [...this.entries].filter(([, entry]) => now >= entry.expiresAt);
+    for (const [k, entry] of expired) this.evict(k, entry, 'expired');
+    if (this.entries.size <= this.capacity) return;
+
+    const [lruKey, lruEntry] = this.entries.entries().next().value!;
+    this.evict(lruKey, lruEntry, 'capacity');
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (entry === undefined) return false;
+    const live = this.now() < entry.expiresAt;
+    this.evict(key, entry, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    return this.keys().length;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const now = this.now();
+    const live: K[] = [];
+    for (const [key, entry] of this.entries) if (now < entry.expiresAt) live.push(key);
+    return live.reverse();
+  }
+
+  private evict(key: K, entry: Entry<V>, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, entry.value, reason);
   }
 }
