 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNIT_MS = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1_000, ms: 1 } as const;
+type Unit = keyof typeof UNIT_MS;
+
+// "ms" comes before "m" so that "250ms" is not read as "250m" followed by a stray "s".
+const WHOLE = /^(?:\d+(?:\.\d+)?(?:ms|d|h|m|s) *)+$/;
+const PART = /(\d+(?:\.\d+)?)(ms|d|h|m|s)/g;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const trimmed = text.replace(/^ +| +$/g, '');
+  if (!WHOLE.test(trimmed)) throw new Error(`Invalid duration: "${text}"`);
+  let total = 0;
+  for (const [, amount, unit] of trimmed.matchAll(PART)) total += Number(amount) * UNIT_MS[unit as Unit];
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new RangeError(`Invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  let text = '';
+  for (const [unit, size] of Object.entries(UNIT_MS)) {
+    const count = Math.floor(rest / size);
+    if (count > 0) text += count + unit;
+    rest -= count * size;
+  }
+  return text || '0s';
 }
