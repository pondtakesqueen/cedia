diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.test.ts b/memo.test.ts
--- a/memo.test.ts	2026-10-30 05:21:46.582561484 +0000
+++ b/memo.test.ts	2026-10-30 05:24:47.267553759 +0000
@@ -66,3 +66,152 @@
   m("k");
   expect(calls).toHaveLength(2);
 });
+
+test("keeping one more than max drops the least recently used key first", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("c");
+  expect(m.size).toBe(2);
+  m("b");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(4);
+});
+
+test("a key dropped to stay under max is not kept when its call settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  const a = m("a");
+  m("b");
+  calls[0]!.d.resolve("a1");
+  expect(await a).toBe("a1");
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a call answered from the cache makes its key the most recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  expect(await m("a")).toBe("a");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("joining a call in flight makes its key the most recently used", () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("a");
+  m("c");
+  m("a");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+  m("b");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c", "b"]);
+});
+
+test("after invalidate, the earlier call's result does not replace the newer call", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(m("k")).toBe(second);
+  // The earlier result's ttl running out must not forget the newer call in flight either.
+  t = 100;
+  expect(m("k")).toBe(second);
+  calls[1]!.d.resolve("new");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("after invalidate, the earlier call's rejection does not forget the newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("old"));
+  await expect(first).rejects.toThrow("old");
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a result in flight during clear is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("an expired result does not count toward size", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  calls[0]!.d.resolve("v");
+  await tick();
+  expect(m.size).toBe(1);
+  t = 100;
+  expect(m.size).toBe(0);
+});
+
+test("an expired result does not take a live key's place under max", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 50;
+  m("b");
+  calls[1]!.d.resolve("b");
+  await tick();
+  t = 60;
+  await m("a");
+  // "a" expires at 100 and "b" at 150; "b" is the least recently used.
+  t = 120;
+  m("c");
+  expect(m.size).toBe(2);
+  expect(await m("b")).toBe("b");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+});
+
+test("fn throwing synchronously gives a rejected promise and drops no other key", async () => {
+  let fail = true;
+  const { fn, calls } = lookups();
+  const m = memo((key: string) => {
+    if (key === "bad" && fail) throw new Error("sync");
+    return fn(key);
+  }, { ttlMs: 1000, max: 1 });
+  m("a");
+  const bad = m("bad");
+  expect(bad).toBeInstanceOf(Promise);
+  await expect(bad).rejects.toThrow("sync");
+  m("a");
+  expect(calls).toHaveLength(1);
+  fail = false;
+  m("bad");
+  expect(calls).toHaveLength(2);
+});
