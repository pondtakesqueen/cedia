diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-30 05:31:06.563545084 +0000
@@ -0,0 +1,92 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { bulkDiscount } from '../src/pricing/discounts/bulk.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('bulk discount tiers', () => {
+  test('10 and 50 units are inside their tiers', () => {
+    expect(bulkDiscount(9, 1080)).toBe(0);
+    expect(bulkDiscount(10, 1200)).toBe(60);
+    expect(bulkDiscount(49, 5880)).toBe(294);
+    expect(bulkDiscount(50, 6000)).toBe(600);
+  });
+
+  test('a line of exactly 10 units gets 5% off', () => {
+    // 10 pens = 1200, -60 = 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('a line of exactly 50 units gets 10% off', () => {
+    // 50 pens = 6000, -600 = 5400 >= 5000 ships free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+});
+
+describe('lines of the same sku are merged before pricing', () => {
+  test('6 + 4 pens count as 10 units', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    const t = totals(c);
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ sku: 'PEN', quantity: 10, subtotal: 1200, discount: 60, total: 1140 });
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+    // The cart itself is left alone.
+    expect(c.lines.map((l) => l.quantity)).toEqual([6, 4]);
+  });
+
+  test('30 + 20 mugs reach the 50-unit tier, even with another line between them', () => {
+    // 50 mugs = 22500, -2250 = 20250; plus 1 pen = 20370 ships free; tax 7% of 20370 = 1425.9 -> 1426
+    expect(totals(cart('US', [['MUG', 30], ['PEN', 1], ['MUG', 20]]))).toMatchObject({ subtotal: 20370, shipping: 0, tax: 1426, total: 21796 });
+  });
+});
+
+describe('free shipping looks at the subtotal after the coupon', () => {
+  test('a coupon that drops the order below the threshold brings shipping back', () => {
+    // 2 bags + 2 mugs = 5300; FLAT5 -> 4800 < 5000 so shipping 800; tax 7% of 5600 = 392
+    expect(totals(cart('US', [['BAG', 2], ['MUG', 2]], 'FLAT5'))).toMatchObject({
+      subtotal: 5300,
+      coupon: 500,
+      shipping: 800,
+      tax: 392,
+      total: 5992,
+    });
+  });
+
+  test('landing exactly on the threshold after the coupon still ships free', () => {
+    // 1500 + 2200 + 1200 + 600 = 5500; FLAT5 -> 5000 >= 5000; tax 7% of 5000 = 350
+    expect(totals(cart('US', [['TEE', 1], ['BAG', 1], ['CAP', 1], ['PEN', 5]], 'FLAT5'))).toMatchObject({
+      subtotal: 5500,
+      coupon: 500,
+      shipping: 0,
+      tax: 350,
+      total: 5350,
+    });
+  });
+
+  test('SAVE10 below the threshold', () => {
+    // 4 tees = 6000 in the EU; SAVE10 -> 5400 < 6000 so shipping 900; tax 20% of 6300 = 1260
+    expect(totals(cart('EU', [['TEE', 4]], 'SAVE10'))).toMatchObject({
+      subtotal: 6000,
+      coupon: 600,
+      shipping: 900,
+      tax: 1260,
+      total: 7560,
+    });
+  });
+});
+
+describe('regions', () => {
+  test('match the table in README.md', () => {
+    expect(REGIONS).toEqual({
+      US: { code: 'US', taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 },
+      EU: { code: 'EU', taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 },
+      UK: { code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 },
+    });
+  });
+
+  test('a UK order of exactly 4000 ships free', () => {
+    // 2200 + 1200 + 600 = 4000; tax 20% of 4000 = 800
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+});
