--- a/csv.ts	2026-10-30 03:48:50.831226715 +0000
+++ b/csv.ts	2026-10-30 03:51:44.666126133 +0000
@@ -50,3 +50,154 @@
   rows.push(row);
   return rows;
 }
+
+const COMMA = 0x2c;
+const QUOTE = 0x22;
+const CR = 0x0d;
+const LF = 0x0a;
+
+// Where a stream is between chunks. A `\r` is held back until the next character says whether it ends the row.
+const FIELD_START = 0;
+const UNQUOTED = 1;
+const UNQUOTED_CR = 2; // an unquoted field followed by a `\r` that is not in `field` yet
+const QUOTED = 3;
+const QUOTED_QUOTE = 4; // a quoted field followed by a `"` that closes it unless another `"` comes next
+const CLOSED_CR = 5; // a closed quoted field followed by a `\r`, which must be followed by `\n`
+
+/**
+ * `parseCsv` for input that arrives in chunks: `push` returns each row once its row end has arrived and `end` returns
+ * the rest, so for any way of splitting an input the rows from all the calls are `parseCsv` of the whole of it. An
+ * input `parseCsv` rejects makes `push` (as soon as the error is in sight) or `end` throw the same SyntaxError, and
+ * every call after that throws it again. A chunk is never scanned again, so the work for it does not grow with what
+ * came before it.
+ */
+export class CsvStream {
+  #state = FIELD_START;
+  #field = "";
+  #row: string[] = [];
+  #offset = 0; // of the current chunk in the whole input
+  #started = false;
+  #ended = false;
+  #error: unknown;
+
+  push(chunk: string): string[][] {
+    this.#check();
+    const rows: string[][] = [];
+    let i = 0;
+    if (!this.#started && chunk.length > 0) {
+      this.#started = true;
+      if (chunk.charCodeAt(0) === 0xfeff) i = 1;
+    }
+    try {
+      this.#scan(chunk, i, rows);
+    } catch (error) {
+      this.#error = error;
+      throw error;
+    }
+    this.#offset += chunk.length;
+    return rows;
+  }
+
+  end(): string[][] {
+    this.#check();
+    this.#ended = true;
+    switch (this.#state) {
+      case FIELD_START:
+        if (this.#row.length === 0) return [];
+        break;
+      case UNQUOTED_CR:
+        this.#field += "\r";
+        break;
+      case QUOTED:
+        throw (this.#error = new SyntaxError("a quoted field is still open at the end of the input"));
+      case CLOSED_CR:
+        throw (this.#error = this.#afterClosingQuote("\r", this.#offset - 1));
+    }
+    this.#endField();
+    return [this.#row];
+  }
+
+  #check() {
+    if (this.#error !== undefined) throw this.#error;
+    if (this.#ended) throw new Error("the stream has already ended");
+  }
+
+  #scan(s: string, i: number, rows: string[][]) {
+    while (i < s.length) {
+      switch (this.#state) {
+        case FIELD_START:
+          if (s.charCodeAt(i) === QUOTE) {
+            this.#state = QUOTED;
+            i++;
+          } else this.#state = UNQUOTED;
+          break;
+        case UNQUOTED: {
+          let j = i;
+          let c = 0;
+          while (j < s.length && (c = s.charCodeAt(j)) !== COMMA && c !== LF && c !== CR && c !== QUOTE) j++;
+          this.#field += s.slice(i, j);
+          if (j === s.length) return;
+          if (c === QUOTE) throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.#offset + j}`);
+          i = j + 1;
+          if (c === COMMA) this.#endField();
+          else if (c === LF) rows.push(this.#endRow());
+          else this.#state = UNQUOTED_CR;
+          break;
+        }
+        case UNQUOTED_CR:
+          if (s.charCodeAt(i) === LF) {
+            i++;
+            rows.push(this.#endRow());
+          } else {
+            this.#field += "\r";
+            this.#state = UNQUOTED;
+          }
+          break;
+        case QUOTED: {
+          const j = s.indexOf('"', i);
+          if (j < 0) {
+            this.#field += s.slice(i);
+            return;
+          }
+          this.#field += s.slice(i, j);
+          i = j + 1;
+          this.#state = QUOTED_QUOTE;
+          break;
+        }
+        case QUOTED_QUOTE: {
+          const c = s.charCodeAt(i++);
+          if (c === QUOTE) {
+            this.#field += '"';
+            this.#state = QUOTED;
+          } else if (c === COMMA) this.#endField();
+          else if (c === LF) rows.push(this.#endRow());
+          else if (c === CR) this.#state = CLOSED_CR;
+          else throw this.#afterClosingQuote(s[i - 1]!, this.#offset + i - 1);
+          break;
+        }
+        case CLOSED_CR:
+          if (s.charCodeAt(i) !== LF) throw this.#afterClosingQuote("\r", this.#offset + i - 1);
+          i++;
+          rows.push(this.#endRow());
+          break;
+      }
+    }
+  }
+
+  #afterClosingQuote(c: string, offset: number) {
+    return new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${offset}`);
+  }
+
+  #endField() {
+    this.#row.push(this.#field);
+    this.#field = "";
+    this.#state = FIELD_START;
+  }
+
+  #endRow(): string[] {
+    this.#endField();
+    const row = this.#row;
+    this.#row = [];
+    return row;
+  }
+}
