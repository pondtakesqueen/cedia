   expect(s.push("d")).toEqual([]);
   expect(s.end()).toEqual([["c", "d"]]);
 });
+
+/** Each element is what one call returned: one per chunk, then the one from `end`. */
+function stream(...chunks: string[]): string[][][] {
+  const s = new CsvStream();
+  return [...chunks.map(chunk => s.push(chunk)), s.end()];
+}
+
+test("a stream holds back a \\r at the end of a chunk until it knows whether a \\n follows", () => {
+  expect(stream("a\r", "\nb")).toEqual([[], [["a"]], [["b"]]]);
+  expect(stream("a\r", "b\n")).toEqual([[], [["a\rb"]], []]);
+  expect(stream("a\r")).toEqual([[], [["a\r"]]]);
+  expect(stream("a,\r", ",")).toEqual([[], [], [["a", "\r", ""]]]);
+  expect(stream("\r", "\r", "\n")).toEqual([[], [], [["\r"]], []]);
+  expect(stream('"a"\r', "\n")).toEqual([[], [["a"]], []]);
+  expect(() => stream('"a"\r')).toThrow(new SyntaxError('unexpected "\\r" after a closing quote at offset 3'));
+  expect(() => stream('"a"\r', "x")).toThrow(new SyntaxError('unexpected "\\r" after a closing quote at offset 3'));
+});
+
+test("a stream holds back a quote at the end of a chunk until it knows whether it is doubled", () => {
+  expect(stream('"x"', '"y"')).toEqual([[], [], [['x"y']]]);
+  expect(stream('"x"', ",y\n")).toEqual([[], [["x", "y"]], []]);
+  expect(stream('"x"', "\n")).toEqual([[], [["x"]], []]);
+  expect(stream('"x"')).toEqual([[], [["x"]]]);
+  expect(stream('"', '"', '"', '"')).toEqual([[], [], [], [], [['"']]]);
+  expect(() => stream('"x"', "y")).toThrow(new SyntaxError('unexpected "y" after a closing quote at offset 3'));
+});
+
+test("a stream keeps a quoted field open across chunks, with any row ends in it", () => {
+  expect(stream('a,"b\n', "c\r\n", 'd",e\n')).toEqual([[], [], [["a", "b\nc\r\nd", "e"]], []]);
+  expect(() => stream('"abc', "def")).toThrow(new SyntaxError("a quoted field is still open at the end of the input"));
+});
+
+test("a stream drops a BOM only at the very start of the input", () => {
+  expect(stream("", "﻿a")).toEqual([[], [], [["a"]]]);
+  expect(stream("﻿", "﻿b")).toEqual([[], [], [["﻿b"]]]);
+  expect(stream("a", "﻿b")).toEqual([[], [], [["a﻿b"]]]);
+  expect(stream("﻿", '"a"')).toEqual([[], [], [["a"]]]);
+  expect(stream("﻿")).toEqual([[], []]);
+});
+
+test("a stream starts no row for a row end just before the end, but one for an empty line or a trailing comma", () => {
+  expect(stream()).toEqual([[]]);
+  expect(stream("", "")).toEqual([[], [], []]);
+  expect(stream("a\n")).toEqual([[["a"]], []]);
+  expect(stream("a\n", "\n")).toEqual([[["a"]], [[""]], []]);
+  expect(stream("a", ",")).toEqual([[], [], [["a", ""]]]);
+  expect(stream("\r\n")).toEqual([[[""]], []]);
+});
+
+test("a stream throws as soon as an error is in sight, and again on every call after", () => {
+  const s = new CsvStream();
+  expect(s.push("a,b\nc")).toEqual([["a", "b"]]);
+  const error = new SyntaxError("a quote in a field that is not quoted, at offset 6");
+  expect(() => s.push('d"')).toThrow(error);
+  expect(() => s.push("\n")).toThrow(error);
+  expect(() => s.end()).toThrow(error);
+});
+
+test("a stream cannot be used after its end", () => {
+  const s = new CsvStream();
+  s.end();
+  expect(() => s.push("a")).toThrow("the stream has already ended");
+  expect(() => s.end()).toThrow("the stream has already ended");
+});
+
+/**
+ * Streams `chunks` and compares with `parseCsv` of all of them: the same rows or the same SyntaxError, and after each
+ * chunk exactly the rows whose row end has arrived. Returns what went wrong, if anything.
+ */
+function mismatch(chunks: string[]): string | undefined {
+  const text = chunks.join("");
+  let expected: string[][] | undefined;
+  let error: unknown;
+  try {
+    expected = parseCsv(text);
+  } catch (e) {
+    error = e;
+  }
+  // In an input parseCsv accepts, a `"` is only ever in a quoted field, so a `\n` ends a row after an even number of them.
+  const rowEnds: number[] = [];
+  let quotes = 0;
+  for (let i = 0; i < text.length; i++) {
+    if (text[i] === '"') quotes++;
+    else if (text[i] === "\n" && quotes % 2 === 0) rowEnds.push(i + 1);
+  }
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  let length = 0;
+  try {
+    for (const chunk of chunks) {
+      rows.push(...s.push(chunk));
+      length += chunk.length;
+      if (expected && rows.length !== rowEnds.filter(end => end <= length).length) return `${rows.length} rows after ${length} characters`;
+    }
+    rows.push(...s.end());
+  } catch (e) {
+    if (!(error instanceof SyntaxError)) return `threw ${e}, parseCsv did not`;
+    if (!(e instanceof SyntaxError) || e.message !== error.message) return `threw ${e}, parseCsv threw ${error}`;
+    return;
+  }
+  if (error) return `did not throw, parseCsv threw ${error}`;
+  if (!Bun.deepEquals(rows, expected)) return `returned ${JSON.stringify(rows)}, parseCsv ${JSON.stringify(expected)}`;
+}
+
+function check(inputs: Iterable<string[]>) {
+  const failures: string[] = [];
+  for (const chunks of inputs) {
+    const failure = mismatch(chunks);
+    if (failure !== undefined && failures.push(`${JSON.stringify(chunks)}: ${failure}`) >= 10) break;
+  }
+  expect(failures).toEqual([]);
+}
+
+const alphabet = ["a", ",", '"', "\r", "\n", "﻿"];
+
+/** Every string of `alphabet` up to `length` long, split into chunks in every way, with and without empty chunks. */
+function* everySplit(length: number): Generator<string[]> {
+  for (let n = 0; n <= length; n++) {
+    for (let k = 0; k < alphabet.length ** n; k++) {
+      const chars: string[] = [];
+      for (let m = k, i = 0; i < n; i++, m = Math.floor(m / alphabet.length)) chars.push(alphabet[m % alphabet.length]!);
+      for (let cuts = 0; cuts < 2 ** Math.max(n - 1, 0); cuts++) {
+        const chunks = [""];
+        chars.forEach((c, i) => {
+          if (i > 0 && cuts & (1 << (i - 1))) chunks.push("");
+          chunks[chunks.length - 1] += c;
+        });
+        yield chunks;
+        yield ["", ...chunks.flatMap(chunk => [chunk, ""])];
+      }
+    }
+  }
+}
+
+test("a stream agrees with parseCsv on every short input split in every way", () => {
+  check(everySplit(5));
+});
+
+function random(seed: number) {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t ^= t + Math.imul(t ^ (t >>> 7), 61 | t);
+    return ((t ^ (t >>> 14)) >>> 0) / 2 ** 32;
+  };
+}
+
+/** Mostly well-formed CSV, so that most inputs get as far as their end, with the odd stray character. */
+function* randomSplits(count: number): Generator<string[]> {
+  const next = random(1);
+  const pick = (from: string[]) => from[Math.floor(next() * from.length)]!;
+  for (let k = 0; k < count; k++) {
+    let text = next() < 0.2 ? "﻿" : "";
+    for (let rows = Math.floor(next() * 5), r = 0; r < rows; r++) {
+      for (let fields = 1 + Math.floor(next() * 4), f = 0; f < fields; f++) {
+        if (f > 0) text += ",";
+        let field = "";
+        for (let n = Math.floor(next() * 6), i = 0; i < n; i++) field += pick(next() < 0.5 ? ["a", "\r", "﻿"] : alphabet);
+        text += next() < 0.5 ? `"${field.replaceAll('"', '""')}"` : field.replace(/["\n,]/g, "b");
+        if (next() < 0.03) text += pick(alphabet);
+      }
+      if (r < rows - 1 || next() < 0.5) text += pick(["\n", "\r\n"]);
+    }
+    const chunks: string[] = [];
+    for (let i = 0; i <= text.length; ) {
+      const size = next() < 0.2 ? 0 : 1 + Math.floor(next() * 8);
+      chunks.push(text.slice(i, i + size));
+      i += Math.max(size, 1);
+    }
+    yield chunks;
+  }
+}
+
+test("a stream agrees with parseCsv on random inputs split at random", () => {
+  check(randomSplits(20_000));
+});
+
+test("the work for a chunk does not grow with what came before it", () => {
+  // A million one-character chunks take well under a second; rescanning what is held back would take hours.
+  const field = "x".repeat(2 ** 20);
+  for (const text of [`${field},"${field}"\n${field}`, `"${'""'.repeat(2 ** 19)}"`, "a,\r\n".repeat(2 ** 18)]) {
+    const s = new CsvStream();
+    const rows: string[][] = [];
+    for (let i = 0; i < text.length; i++) rows.push(...s.push(text[i]!));
+    rows.push(...s.end());
+    expect(rows).toEqual(parseCsv(text));
+  }
+});
