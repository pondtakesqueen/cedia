diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.test.ts b/memo.test.ts
--- a/memo.test.ts	2026-10-30 05:22:04.539184867 +0000
+++ b/memo.test.ts	2026-10-30 05:25:20.123553008 +0000
@@ -66,3 +66,172 @@
   m("k");
   expect(calls).toHaveLength(2);
 });
+
+test("adding a key while max are kept drops one, leaving max", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  expect(m.size).toBe(1);
+  m("b");
+  expect(calls).toHaveLength(2);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a result in flight when its key is dropped for max is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a result in flight during clear is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("an invalidated call settling does not replace the call made after invalidate", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  // The earlier call settles while the later one is in flight.
+  m("x");
+  m.invalidate("x");
+  const x = m("x");
+  calls[0]!.d.resolve("old");
+  await tick();
+  const xAgain = m("x");
+  expect(calls).toHaveLength(2);
+  calls[1]!.d.resolve("new");
+  expect(await x).toBe("new");
+  expect(await xAgain).toBe("new");
+  // The earlier call settles after the later one has.
+  m("y");
+  m.invalidate("y");
+  m("y");
+  calls[3]!.d.resolve("new");
+  await tick();
+  calls[2]!.d.resolve("old");
+  await tick();
+  expect(await m("y")).toBe("new");
+  expect(calls).toHaveLength(4);
+});
+
+test("a rejection is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(new Error("down"));
+  await expect(a).rejects.toThrow("down");
+  await expect(b).rejects.toThrow("down");
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("an invalidated call rejecting does not drop the call made after invalidate", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  // The earlier call rejects while the later one is in flight.
+  const x = m("x");
+  m.invalidate("x");
+  m("x");
+  calls[0]!.d.reject(new Error("old"));
+  await expect(x).rejects.toThrow("old");
+  await tick();
+  m("x");
+  expect(calls).toHaveLength(2);
+  // The earlier call rejects after the later one has settled.
+  const y = m("y");
+  m.invalidate("y");
+  m("y");
+  calls[3]!.d.resolve("new");
+  await tick();
+  calls[2]!.d.reject(new Error("old"));
+  await expect(y).rejects.toThrow("old");
+  await tick();
+  expect(await m("y")).toBe("new");
+  expect(calls).toHaveLength(4);
+});
+
+test("a call answered from the cache makes its key the most recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  expect(await m("a")).toBe("a");
+  m("c");
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("a call sharing one in flight makes its key the most recently used", () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("a");
+  m("c");
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("an expired result neither counts toward max nor pushes out a key still kept", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 50;
+  m("b");
+  calls[1]!.d.resolve("b");
+  await tick();
+  t = 60;
+  expect(await m("a")).toBe("a");
+  // a, the most recently used, has expired; b, the least, has not.
+  t = 120;
+  expect(m.size).toBe(1);
+  m("c");
+  expect(m.size).toBe(2);
+  expect(await m("b")).toBe("b");
+  expect(calls).toHaveLength(3);
+});
+
+test("a lookup that throws synchronously drops no key", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(
+    (key: string) => {
+      if (key === "bad") throw new Error("bad");
+      return fn(key);
+    },
+    { ttlMs: 1000, max: 1 },
+  );
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  expect(() => m("bad")).toThrow("bad");
+  expect(m.size).toBe(1);
+  expect(await m("a")).toBe("a");
+  expect(calls).toHaveLength(1);
+});
