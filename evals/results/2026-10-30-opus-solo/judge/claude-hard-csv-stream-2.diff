--- a/csv.ts	2026-10-30 03:48:50.830358487 +0000
+++ b/csv.ts	2026-10-30 03:51:37.554126296 +0000
@@ -50,3 +50,159 @@
   rows.push(row);
   return rows;
 }
+
+/**
+ * Where a `CsvStream` is between two chunks:
+ * - `fieldStart`: a field has not begun; with no fields in the row yet, the end of the input there adds no row.
+ * - `unquoted`: in a field that is not quoted.
+ * - `unquotedCr`: just after a `\r` in a field that is not quoted, which is a row end if `\n` comes next.
+ * - `quoted`: in a quoted field.
+ * - `quote`: just after a `"` in a quoted field, which is a doubled `"` if `"` comes next and a closing quote if not.
+ * - `closedCr`: just after a `\r` after a closing quote, which must be followed by `\n`.
+ */
+type CsvStreamState = "fieldStart" | "unquoted" | "unquotedCr" | "quoted" | "quote" | "closedCr";
+
+/**
+ * Reads CSV, as `parseCsv` does, from chunks that may be split anywhere. `push` returns the rows whose row end has
+ * arrived and `end` the rest, so the rows from all the calls together are `parseCsv` of the whole input, and an
+ * input `parseCsv` rejects makes a `push` or `end` throw the SyntaxError `parseCsv` would. Each chunk is read once,
+ * without going back over earlier ones. After `end`, or once a call has thrown, the stream takes no more calls.
+ */
+export class CsvStream {
+  #state: CsvStreamState = "fieldStart";
+  #field = "";
+  #row: string[] = [];
+  /** How much of the input came before the next chunk, for the `﻿` and for offsets in errors. */
+  #offset = 0;
+  #over = false;
+
+  push(chunk: string): string[][] {
+    this.#begin();
+    const rows: string[][] = [];
+    let state = this.#state;
+    let field = this.#field;
+    let row = this.#row;
+    let i = this.#offset === 0 && chunk.startsWith("﻿") ? 1 : 0;
+    while (i < chunk.length) {
+      switch (state) {
+        case "fieldStart":
+          if (chunk[i] === '"') {
+            state = "quoted";
+            i++;
+          } else state = "unquoted";
+          break;
+        case "unquoted": {
+          const from = i;
+          let c = chunk.charCodeAt(i);
+          while (c !== 44 && c !== 10 && c !== 13 && c !== 34 && ++i < chunk.length) c = chunk.charCodeAt(i);
+          field += chunk.slice(from, i);
+          if (i === chunk.length) break;
+          if (c === 34) throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.#offset + i}`);
+          i++;
+          if (c === 13) state = "unquotedCr";
+          else {
+            row.push(field);
+            field = "";
+            state = "fieldStart";
+            if (c === 10) {
+              rows.push(row);
+              row = [];
+            }
+          }
+          break;
+        }
+        case "unquotedCr":
+          if (chunk[i] === "\n") {
+            i++;
+            row.push(field);
+            rows.push(row);
+            field = "";
+            row = [];
+            state = "fieldStart";
+          } else {
+            field += "\r";
+            state = "unquoted";
+          }
+          break;
+        case "quoted": {
+          const close = chunk.indexOf('"', i);
+          if (close < 0) {
+            field += chunk.slice(i);
+            i = chunk.length;
+          } else {
+            field += chunk.slice(i, close);
+            i = close + 1;
+            state = "quote";
+          }
+          break;
+        }
+        case "quote": {
+          const c = chunk[i]!;
+          if (c === '"') {
+            field += '"';
+            state = "quoted";
+          } else if (c === "\r") state = "closedCr";
+          else if (c === "," || c === "\n") {
+            row.push(field);
+            field = "";
+            state = "fieldStart";
+            if (c === "\n") {
+              rows.push(row);
+              row = [];
+            }
+          } else throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${this.#offset + i}`);
+          i++;
+          break;
+        }
+        case "closedCr":
+          if (chunk[i] !== "\n") throw this.#strayCr(this.#offset + i - 1);
+          i++;
+          row.push(field);
+          rows.push(row);
+          field = "";
+          row = [];
+          state = "fieldStart";
+          break;
+      }
+    }
+    this.#state = state;
+    this.#field = field;
+    this.#row = row;
+    this.#offset += chunk.length;
+    this.#over = false;
+    return rows;
+  }
+
+  end(): string[][] {
+    this.#begin();
+    const row = this.#row;
+    switch (this.#state) {
+      case "fieldStart":
+        if (row.length === 0) return [];
+        row.push("");
+        break;
+      case "unquotedCr":
+        row.push(this.#field + "\r");
+        break;
+      case "unquoted":
+      case "quote":
+        row.push(this.#field);
+        break;
+      case "quoted":
+        throw new SyntaxError("a quoted field is still open at the end of the input");
+      case "closedCr":
+        throw this.#strayCr(this.#offset - 1);
+    }
+    return [row];
+  }
+
+  /** Refuses a call after `end` or after a call that threw, and otherwise marks the stream over until the call returns. */
+  #begin() {
+    if (this.#over) throw new Error("the CSV stream is over: end() was called, or a call threw");
+    this.#over = true;
+  }
+
+  #strayCr(at: number) {
+    return new SyntaxError(`unexpected ${JSON.stringify("\r")} after a closing quote at offset ${at}`);
+  }
+}
