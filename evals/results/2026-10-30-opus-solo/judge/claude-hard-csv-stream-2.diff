+/** The rows whose row end is in `prefix`: `parseCsv` of the longest prefix of it that ends at a row end. */
+function rowsEndedBy(prefix: string): string[][] {
+  for (let at = prefix.length; at > 0; at--) {
+    if (prefix[at - 1] !== "\n") continue;
+    try {
+      return parseCsv(prefix.slice(0, at));
+    } catch {
+      // that \n is in a quoted field (or after an error), so it is not a row end
+    }
+  }
+  return [];
+}
+
+/**
+ * Checks a stream of `chunks` against `parseCsv` of their whole: each push returns just the rows whose row end it
+ * brought, `end` the rest, and an input `parseCsv` rejects throws its error.
+ */
+function checkAgainstParseCsv(chunks: string[]) {
+  const text = chunks.join("");
+  const error = thrown(() => parseCsv(text));
+  if (error) {
+    expect(error).toBeInstanceOf(SyntaxError);
+    expect(thrown(() => stream(chunks))).toEqual(error);
+    return;
+  }
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  const pushed: string[][][] = [];
+  const ended: string[][][] = [];
+  let prefix = "";
+  for (const chunk of chunks) {
+    rows.push(...s.push(chunk));
+    pushed.push([...rows]);
+    prefix += chunk;
+    ended.push(rowsEndedBy(prefix));
+  }
+  expect(pushed).toEqual(ended);
+  rows.push(...s.end());
+  expect(rows).toEqual(parseCsv(text));
+}
+
+/** Every way of splitting `text` into chunks, with no empty chunks. */
+function* splits(text: string): Generator<string[]> {
+  if (text === "") yield [];
+  for (let at = 1; at <= text.length; at++) for (const rest of splits(text.slice(at))) yield [text.slice(0, at), ...rest];
+}
+
+const alphabet = ["a", ",", '"', "\r", "\n", "\uFEFF"];
+
+test("a stream matches parseCsv on every input of up to 5 characters, split every way", () => {
+  let inputs = [""];
+  for (let length = 0; length <= 5; length++) {
+    for (const text of inputs) for (const chunks of splits(text)) checkAgainstParseCsv(chunks);
+    inputs = inputs.flatMap((text) => alphabet.map((c) => text + c));
+  }
+}, 30_000);
+
+test("a stream matches parseCsv on longer random inputs, split at random with empty chunks", () => {
+  let seed = 1;
+  const random = (n: number) => {
+    seed ^= seed << 13;
+    seed ^= seed >>> 17;
+    seed ^= seed << 5;
+    return (seed >>> 0) % n;
+  };
+  const pick = (xs: string[]) => xs[random(xs.length)]!;
+  const some = (xs: string[]) => Array.from({ length: random(5) }, () => pick(xs)).join("");
+  const field = () => (random(2) ? some(["a", "\r", "\uFEFF"]) : `"${some(["a", ",", "\r", "\n", '""'])}"`);
+  for (let run = 0; run < 3000; run++) {
+    let text = some(["\uFEFF", ""]);
+    for (let rows = random(6); rows > 0; rows--) {
+      text += field();
+      for (let fields = random(4); fields > 0; fields--) text += "," + field();
+      if (rows > 1 || random(2)) text += pick(["\n", "\r\n"]);
+    }
+    // A stray character makes most inputs it lands in invalid, and somewhere other than the start.
+    if (random(3) === 0) {
+      const at = random(text.length + 1);
+      text = text.slice(0, at) + pick(alphabet) + text.slice(at);
+    }
+    const chunks: string[] = [];
+    for (let at = 0; at < text.length; ) {
+      const size = random(5);
+      chunks.push(text.slice(at, at + size));
+      at += size;
+    }
+    checkAgainstParseCsv(chunks);
+  }
+});
+
+test("a stream reads a long input in tiny chunks without going back over earlier ones", () => {
+  // Going back over earlier chunks for each new one would take some 10^12 steps here, not a few million.
+  const s = new CsvStream();
+  let rows = s.push('"').length;
+  for (let i = 0; i < 1_000_000; i++) rows += s.push(i % 2 ? '""' : "a\r\n,").length;
+  expect(rows).toBe(0);
+  expect(s.push('"\n')).toEqual([['a\r\n,"'.repeat(500_000)]]);
+  for (let i = 0; i < 1_000_000; i++) rows += s.push(["b,", "b\r", "\n"][i % 3]!).length;
+  expect(rows).toBe(333_333);
+  expect(s.end()).toEqual([["b", ""]]);
+});
