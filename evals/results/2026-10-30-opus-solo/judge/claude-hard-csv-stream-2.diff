+describe("a stream rejects what parseCsv rejects, with the same error", () => {
+  const rejects = (chunks: string[]) => {
+    const expected = thrown(() => parseCsv(chunks.join("")));
+    expect(expected).toBeInstanceOf(SyntaxError);
+    expect(thrown(() => stream(chunks))).toEqual(expected);
+  };
+
+  test("a quoted field still open at the end", () => {
+    rejects(['"a', "b"]);
+    rejects(['"a""']);
+    rejects(['"']);
+  });
+
+  test('a " in a field that is not quoted', () => {
+    rejects(["a", '"']);
+    rejects(["a\r", '"']);
+    rejects(['a,b"']);
