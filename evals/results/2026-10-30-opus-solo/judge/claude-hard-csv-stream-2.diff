+/** What `run` throws, if anything. */
+function thrown(run: () => unknown): unknown {
+  try {
+    run();
+  } catch (e) {
+    return e;
+  }
+}
+
+/** Pushes each chunk and ends the stream, returning what each call returned. */
+function stream(chunks: string[]): string[][][] {
+  const s = new CsvStream();
+  return [...chunks.map((chunk) => s.push(chunk)), s.end()];
+}
+
+describe("a stream split where a decision waits for the next chunk", () => {
+  test("a \\r in a field that is not quoted is a row end only if \\n follows", () => {
+    expect(stream(["a\r", "\nb"])).toEqual([[], [["a"]], [["b"]]]);
+    expect(stream(["a\r", "b\n"])).toEqual([[], [["a\rb"]], []]);
+    expect(stream(["a\r", "\r", "\n"])).toEqual([[], [], [["a\r"]], []]);
+    expect(stream(["a\r", ",b"])).toEqual([[], [], [["a\r", "b"]]]);
+    expect(stream(["\r", "\n\r", "\n"])).toEqual([[], [[""]], [[""]], []]);
+    expect(stream(["a\r"])).toEqual([[], [["a\r"]]]);
+  });
+
+  test('a " in a quoted field is doubled if " follows, and closes the field if not', () => {
+    expect(stream(['"a"', '"b"'])).toEqual([[], [], [['a"b']]]);
+    expect(stream(['"a"', ",b"])).toEqual([[], [], [["a", "b"]]]);
+    expect(stream(['"a"', "\n"])).toEqual([[], [["a"]], []]);
+    expect(stream(['"', '"', '"', '"', '"', '"'])).toEqual([[], [], [], [], [], [], [['""']]]);
+    expect(stream(['"a"'])).toEqual([[], [["a"]]]);
+  });
+
+  test("a \\r after a closing quote must be followed by \\n", () => {
+    expect(stream(['"a"\r', "\nb"])).toEqual([[], [["a"]], [["b"]]]);
+    const s = new CsvStream();
+    s.push('"a"\r');
+    expect(() => s.push("b")).toThrow(SyntaxError);
+    expect(() => stream(['"a"\r'])).toThrow(SyntaxError);
+    expect(() => stream(['"a"\r', "\r\n"])).toThrow(SyntaxError);
+  });
+
+  test("a quoted field may hold , \\r and \\n across chunks", () => {
+    expect(stream(['"a,', "b\r", "\nc\r", '"\n'])).toEqual([[], [], [], [["a,b\r\nc\r"]], []]);
+  });
+
+  test("a field may start in one chunk and go on in many", () => {
+    expect(stream(["ab", "cd", "", "ef,g", "h\n"])).toEqual([[], [], [], [], [["abcdef", "gh"]], []]);
+  });
+});
+
