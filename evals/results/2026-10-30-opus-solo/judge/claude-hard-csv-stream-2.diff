+  test("drops a byte order mark only at the very start of the input, even after empty chunks", () => {
+    expect(stream(["\uFEFFa"])).toEqual([[], [["a"]]]);
+    expect(stream(["", "", "\uFEFFa"])).toEqual([[], [], [], [["a"]]]);
+    expect(stream(["\uFEFF", "\uFEFFa"])).toEqual([[], [], [["\uFEFFa"]]]);
+    expect(stream(["a", "\uFEFFb"])).toEqual([[], [], [["a\uFEFFb"]]]);
+    expect(stream(["\uFEFF", '"a"'])).toEqual([[], [], [["a"]]]);
+  });
+
+  test("has no rows for an empty input, and no extra row after a final row end", () => {
+    expect(stream([])).toEqual([[]]);
+    expect(stream(["", ""])).toEqual([[], [], []]);
+    expect(stream(["\uFEFF"])).toEqual([[], []]);
+    expect(stream(["a\n"])).toEqual([[["a"]], []]);
+    expect(stream(["a\r", "\n"])).toEqual([[], [["a"]], []]);
+  });
+
+  test("ends a last row that ends in , with an empty field", () => {
+    expect(stream(["a,"])).toEqual([[], [["a", ""]]]);
+    expect(stream(["a\n,"])).toEqual([[["a"]], [["", ""]]]);
+  });
