@@ -14,30 +14,74 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expiresAt: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Map keeps insertion order: the first entry is the least recently used, the last the most recently used.
+  private entries = new Map<K, Entry<V>>();
+  private capacity: number;
+  private ttlMs: number;
+  private now: () => number;
 
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return undefined;
+    if (this.isExpired(entry)) {
+      this.drop(key, entry, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.entries.delete(key);
+    this.entries.set(key, { value, expiresAt: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, entry] of [...this.entries]) {
+      if (this.isExpired(entry)) this.drop(k, entry, 'expired');
+    }
+    for (const [k, entry] of this.entries) {
+      if (this.entries.size <= this.capacity) break;
+      this.drop(k, entry, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return false;
+    const live = !this.isExpired(entry);
+    this.drop(key, entry, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const entry of this.entries.values()) if (!this.isExpired(entry)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.entries]
+      .filter(([, entry]) => !this.isExpired(entry))
+      .map(([key]) => key)
+      .reverse();
+  }
+
+  private isExpired(entry: Entry<V>): boolean {
+    return this.now() >= entry.expiresAt;
+  }
+
+  private drop(key: K, entry: Entry<V>, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, entry.value, reason);
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 07:20:29.542297973 +0000
+++ b/src/slug.ts	2026-10-29 07:21:21.392999964 +0000
@@ -11,10 +11,24 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  if (max !== undefined && (!Number.isInteger(max) || max < 0)) throw new RangeError(`Invalid max: ${max}`);
+  const slug = text
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  const dash = slug.lastIndexOf('-', max);
+  return dash > 0 ? slug.slice(0, dash) : slug.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  let candidate = slug;
+  for (let n = 2; taken.has(candidate); n++) candidate = `${slug}-${n}`;
+  return candidate;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration-rules.test.ts b/test/duration-rules.test.ts
--- a/test/duration-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration-rules.test.ts	2026-10-29 07:21:33.580608030 +0000
@@ -0,0 +1,37 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parseDuration accepts parts with or without spaces, fractions and ms', () => {
+  expect(parseDuration('2d 4h')).toBe(2 * 86_400_000 + 4 * 3_600_000);
+  expect(parseDuration('1h 30m')).toBe(5_400_000);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1m30s')).toBe(90_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+  expect(parseDuration('0.4ms')).toBe(0);
+  expect(parseDuration('1.5ms')).toBe(2);
+});
+
+test('parseDuration rejects anything else and names the input', () => {
+  for (const bad of ['', '  ', '10', '5x', 'h', '-1s', '.5s', '5.s', '1e3s', '1 h', '1H', '1s-1s']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
+
+test('formatDuration uses the largest units first and leaves out zero parts', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_000_000)).toBe('1d1h');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(formatDuration(250)).toBe('250ms');
+});
+
+test('formatDuration throws on a negative number', () => {
+  expect(() => formatDuration(-1)).toThrow();
+});
+
+test('parseDuration(formatDuration(x)) gives x back', () => {
+  for (const ms of [0, 1, 999, 61_001, 5_400_000, 123_456_789]) {
+    expect(parseDuration(formatDuration(ms))).toBe(ms);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru-rules.test.ts b/test/lru-rules.test.ts
--- a/test/lru-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru-rules.test.ts	2026-10-29 07:21:44.868608701 +0000
@@ -0,0 +1,122 @@
+import { expect, test } from 'bun:test';
+import { LRU, type EvictReason } from '../src/lru.ts';
+
+function recorder() {
+  const events: [string, string, EvictReason][] = [];
+  return { events, onEvict: (k: string, v: number, r: EvictReason) => events.push([k, String(v), r]) };
+}
+
+test('get makes an entry the most recently used', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('capacity eviction reports reason capacity', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(1, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(rec.events).toEqual([['a', '1', 'capacity']]);
+});
+
+test('an entry expires at t + ttl and is live before that', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  t = 999;
+  expect(cache.get('a')).toBe(1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+  expect(rec.events).toEqual([['a', '1', 'expired']]);
+});
+
+test('set gives a fresh ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 900;
+  cache.set('a', 2);
+  t = 1500;
+  expect(cache.get('a')).toBe(2);
+});
+
+test('expired entries are removed before a live one is evicted', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1000;
+  cache.set('c', 3);
+  expect(rec.events).toEqual([['a', '1', 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('all expired entries go when the cache is over capacity', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  t = 1000;
+  cache.set('c', 3);
+  expect(rec.events).toEqual([
+    ['a', '1', 'expired'],
+    ['b', '2', 'expired'],
+  ]);
+  expect(cache.size).toBe(1);
+});
+
+test('a live entry is evicted when the cache is over capacity with live entries', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 600;
+  cache.set('c', 3);
+  expect(rec.events).toEqual([['a', '1', 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('size and keys count only live entries', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1200;
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+});
+
+test('delete reports reason delete for a live entry and false for an expired one', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(cache.delete('a')).toBe(false);
+  t = 1000;
+  expect(cache.delete('b')).toBe(false);
+  expect(rec.events).toEqual([
+    ['a', '1', 'delete'],
+    ['b', '2', 'expired'],
+  ]);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug-rules.test.ts b/test/slug-rules.test.ts
--- a/test/slug-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug-rules.test.ts	2026-10-29 07:21:33.584629458 +0000
@@ -0,0 +1,36 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify removes diacritics and maps the special letters', () => {
+  expect(slugify('ñandú ź')).toBe('nandu-z');
+  expect(slugify('Straße')).toBe('strasse');
+  expect(slugify('Æble Œuvre Østerbro Łódź Đorđe')).toBe('aeble-oeuvre-osterbro-lodz-dorde');
+});
+
+test('slugify turns runs of other characters into one dash and trims the ends', () => {
+  expect(slugify('  --Hello,   world!!  ')).toBe('hello-world');
+  expect(slugify('a_b.c/d')).toBe('a-b-c-d');
+  expect(slugify('!!!')).toBe('');
+});
+
+test('slugify cuts at the last dash within max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('ab-cd-ef', 8)).toBe('ab-cd-ef');
+});
+
+test('slugify cuts at max when there is no dash to cut at', () => {
+  expect(slugify('abcdefgh', 5)).toBe('abcde');
+  expect(slugify('ab-cdefghi', 5)).toBe('ab');
+});
+
+test('slugify does not leave a trailing dash after a cut', () => {
+  expect(slugify('abcd-efgh', 5)).toBe('abcd');
+  expect(slugify('abcd-efgh', 4)).toBe('abcd');
+});
+
+test('uniqueSlug finds the first free suffix', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+});
