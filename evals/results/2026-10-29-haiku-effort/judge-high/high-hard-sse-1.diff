+// Splits the decoded body into lines. A line is complete only when its \n arrives, so a \r at the end of a
+// chunk cannot be mistaken for a line end before the \n that follows it.
+async function* sseLines(body: ReadableStream<Uint8Array>): AsyncGenerator<string> {
+  const reader = body.getReader();
+  const decoder = new TextDecoder();
+  let buf = '';
+  // Set once the body has ended or failed; only then is there nothing left for cancel() to do.
+  let ended = false;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read().catch((err) => {
+        ended = true;
+        throw err;
+      });
+      if (done) {
+        ended = true;
+        break;
+      }
+      buf += decoder.decode(value, { stream: true });
+      for (let nl = buf.indexOf('\n'); nl !== -1; nl = buf.indexOf('\n')) {
+        yield buf.slice(0, nl).replace(/\r$/, '');
+        buf = buf.slice(nl + 1);
+      }
+    }
+    buf += decoder.decode();
+    if (buf) yield buf.replace(/\r$/, '');
+  } finally {
+    // The consumer stopped early: release the connection.
+    if (!ended) await reader.cancel();
+  }
+}
