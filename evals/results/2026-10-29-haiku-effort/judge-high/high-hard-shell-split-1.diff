+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const SHELLS = new Set(['sh', 'bash', 'zsh', 'dash', 'ksh']);
+const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;
+const SHELL_C = /^-[a-zA-Z]*c[a-zA-Z]*$/;
+
+// A word, a command separator, or a redirection operator.
+type Item = { text: string } | 'sep' | 'redir';
+
+// Splits a line into words and separators. Substitutions, subshells and backticks are separators, so their
+// contents become commands of their own. `open` holds the constructs still waiting for their closing character.
+function lex(src: string): Item[] | null {
+  const items: Item[] = [];
+  const open: string[] = [];
+  let text = '';
+  let quoted = false;
+  let started = false;
+  const add = (s: string, q: boolean): void => {
+    text += s;
+    quoted ||= q;
+    started = true;
+  };
+  const endWord = (): void => {
+    if (started) items.push({ text });
+    text = '';
+    quoted = false;
+    started = false;
+  };
+  const sep = (): void => {
+    endWord();
+    items.push('sep');
+  };
+  const redir = (): void => {
+    if (!quoted && /^\d+$/.test(text)) {
+      text = '';
+      started = false;
+    }
+    endWord();
+    items.push('redir');
+  };
+
+  let i = 0;
+  while (i < src.length) {
+    const c = src[i];
+    const top = open.at(-1);
+    if (top === 'dq') {
+      if (c === '"') {
+        open.pop();
+        i++;
+      } else if (c === '\\' && i + 1 < src.length) {
+        add(src[i + 1], true);
+        i += 2;
+      } else if (src.startsWith('$(', i)) {
+        sep();
+        open.push('subst');
+        i += 2;
+      } else if (c === '`') {
+        sep();
+        open.push('bt');
+        i++;
+      } else {
+        add(c, true);
+        i++;
+      }
+    } else if (c === "'") {
+      const close = src.indexOf("'", i + 1);
+      if (close === -1) return null;
+      add(src.slice(i + 1, close), true);
+      i = close + 1;
+    } else if (c === '"') {
+      add('', true);
+      open.push('dq');
+      i++;
+    } else if (c === '\\' && i + 1 < src.length) {
+      add(src[i + 1], true);
+      i += 2;
+    } else if (src.startsWith('$(', i) || ((c === '<' || c === '>') && src[i + 1] === '(')) {
+      sep();
+      open.push('subst');
+      i += 2;
+    } else if (c === '`') {
+      sep();
+      if (top === 'bt') open.pop();
+      else open.push('bt');
+      i++;
+    } else if (c === '(') {
+      sep();
+      open.push('paren');
+      i++;
+    } else if (c === ')') {
+      sep();
+      if (top === 'paren' || top === 'subst') open.pop();
+      i++;
+    } else if (c === '<' || c === '>' || (c === '&' && src[i + 1] === '>')) {
+      let j = i;
+      while (j < src.length && '<>&|'.includes(src[j])) j++;
+      redir();
+      i = j;
+    } else if (c === '\n' || c === ';' || c === '|' || c === '&') {
+      sep();
+      i++;
+    } else if (/\s/.test(c)) {
+      endWord();
+      i++;
+    } else {
+      add(c, false);
+      i++;
+    }
+  }
+  if (open.length > 0) return null;
+  endWord();
+  return items;
+}
