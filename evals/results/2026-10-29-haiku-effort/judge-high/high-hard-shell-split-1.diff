+// Drops leading assignments and keywords, and wrappers with their flags, and returns the command they run.
+function unwrap(argv: string[]): string[] {
+  let i = 0;
+  while (i < argv.length) {
+    const word = argv[i];
+    const wrapper = WRAPPERS.get(word);
+    if (ASSIGNMENT.test(word) || KEYWORDS.has(word)) {
+      i++;
+    } else if (wrapper) {
+      i++;
+      while (i < argv.length && argv[i].startsWith('-')) {
+        const flag = argv[i++];
+        if (flag === '--') break;
+        if (wrapper.value?.includes(flag)) i++;
+      }
+      i += wrapper.positional ?? 0;
+    } else {
+      break;
+    }
+  }
+  return argv.slice(i);
+}
+
+// Returns the commands one argv runs: `eval` and `sh -c` scripts are parsed in turn.
+function commandsOf(argv: string[]): string[][] | null {
+  const cmd = unwrap(argv);
+  if (cmd[0] === 'eval') return simpleCommands(cmd.slice(1).join(' '));
+  if (SHELLS.has(cmd[0])) {
+    for (let j = 1; j + 1 < cmd.length && cmd[j].startsWith('-'); j++) {
+      if (SHELL_C.test(cmd[j])) return simpleCommands(cmd[j + 1]);
+    }
+  }
+  return cmd.length > 0 ? [cmd] : [];
+}
