+  let cmd = norm(command);
+  const cd = /^cd\s+("[^"]*"|'[^']*'|\S+)\s*&&\s*/.exec(cmd);
+  if (cd) {
+    if (cwd === undefined || resolve(cwd, cd[1]!.replace(/^["']|["']$/g, '')) !== resolve(cwd)) return undefined;
