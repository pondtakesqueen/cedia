--- a/edit.ts	2026-10-29 08:06:21.852769774 +0000
+++ b/edit.ts	2026-10-29 08:08:07.144116556 +0000
@@ -23,5 +23,69 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text, replace_all } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create or replace a whole file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same' };
+
+  const strip1 = (s: string) => (s.endsWith('\n') ? s.slice(0, -1) : s);
+  const lineOf = (idx: number) => content.slice(0, idx).split('\n').length;
+  const starts: number[] = [];
+  for (let idx = content.indexOf(old_text); idx !== -1; idx = content.indexOf(old_text, idx + old_text.length)) starts.push(idx);
+  if (starts.length > 1 && !replace_all) {
+    return { error: `old_text matches ${starts.length} places (first at line ${lineOf(starts[0])}); add context or set replace_all` };
+  }
+  if (starts.length > 0) {
+    const from = lineOf(starts[0]);
+    return {
+      content: content.split(old_text).join(new_text),
+      applied: { from, to: from + strip1(old_text).split('\n').length - 1, tier: 'exact', count: starts.length },
+    };
+  }
+
+  const oldLines = strip1(old_text).split('\n');
+  const newText = strip1(new_text);
+  const newLines = newText === '' ? [] : newText.split('\n');
+  const lines = content.split('\n');
+  const indentOf = (s: string) => s.match(/^\s*/)![0];
+  const firstNonBlank = (ls: string[]) => ls.find(l => l.trim() !== '') ?? '';
+  const windows = (norm: (s: string) => string) => {
+    const hits: number[] = [];
+    for (let i = 0; i + oldLines.length <= lines.length; i++) {
+      if (oldLines.every((o, k) => norm(lines[i + k]) === norm(o))) hits.push(i);
+    }
+    return hits;
+  };
+
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', s => s.trimEnd()],
+    ['indentation', s => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const hits = windows(norm);
+    if (hits.length > 1) {
+      return { error: `old_text matches ${hits.length} places (lines ${hits.map(i => i + 1).join(', ')})` };
+    }
+    if (hits.length === 1) {
+      const i = hits[0];
+      let out = newLines;
+      if (tier === 'indentation') {
+        const oldIndent = indentOf(firstNonBlank(oldLines));
+        const fileIndent = indentOf(firstNonBlank(lines.slice(i, i + oldLines.length)));
+        out = newLines.map(l => {
+          if (l.trim() === '') return '';
+          if (l.startsWith(oldIndent)) return fileIndent + l.slice(oldIndent.length);
+          return fileIndent + l.trimStart();
+        });
+      }
+      return {
+        content: [...lines.slice(0, i), ...out, ...lines.slice(i + oldLines.length)].join('\n'),
+        applied: { from: i + 1, to: i + oldLines.length, tier, count: 1 },
+      };
+    }
+  }
+
+  const first = firstNonBlank(oldLines).trim();
+  const nums = first === '' ? [] : lines.flatMap((l, j) => (l.includes(first) ? [j + 1] : [])).slice(0, 5);
+  const hint = nums.length > 0 ? `; first line appears at line ${nums.join(', ')}` : '';
+  return { error: `old_text not found${hint}` };
 }
