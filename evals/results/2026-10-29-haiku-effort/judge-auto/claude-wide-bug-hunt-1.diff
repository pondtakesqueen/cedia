diff -ruN --exclude=node_modules --exclude=.git a/test/rules.test.ts b/test/rules.test.ts
--- a/test/rules.test.ts	1970-01-01 07:00:00
+++ b/test/rules.test.ts	2026-10-23 14:59:16
@@ -0,0 +1,39 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('exactly 10 units get the 5% bulk discount', () => {
+    // 10 pens = 1200; -5% = 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('exactly 50 units get the 10% bulk discount', () => {
+    // 50 pens = 6000; -10% = 5400; ships free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same SKU are merged before the bulk discount', () => {
+    // 6 + 4 pens = 10 units, so the same as 10 pens on one line
+    const t = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('free shipping is judged on the subtotal after the coupon', () => {
+    // 2 tees + 1 bag = 5200; FLAT5 -> 4700 < 5000 so shipping 800; tax 7% of 5500 = 385
+    expect(totals(cart('US', [['TEE', 2], ['BAG', 1]], 'FLAT5'))).toMatchObject({
+      subtotal: 5200,
+      coupon: 500,
+      shipping: 800,
+      tax: 385,
+      total: 5885,
+    });
+  });
+
+  test('UK ships free from 4000', () => {
+    // 2 bags = 4400 >= 4000; tax 20% of 4400 = 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+});
