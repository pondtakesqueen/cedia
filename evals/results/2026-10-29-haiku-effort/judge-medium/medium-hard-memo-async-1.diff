diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.regression.test.ts b/memo.regression.test.ts
--- a/memo.regression.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.regression.test.ts	2026-10-29 07:17:42.116594271 +0000
@@ -0,0 +1,74 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("a settled result is not kept when its key was invalidated while in flight", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(m("k")).toBe(second);
+  expect(calls).toHaveLength(2);
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+});
+
+test("a failed call does not drop a newer call for the same key", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await tick();
+  expect(m("k")).toBe(second);
+  expect(calls).toHaveLength(2);
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+});
+
+test("a hit counts as use: the least recently used key is dropped", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  m("a");
+  m("c");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+  m("a");
+  m("b");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c", "b"]);
+});
+
+test("a key dropped while in flight is not kept when its lookup settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  await tick();
+  expect(m.size).toBe(1);
+});
