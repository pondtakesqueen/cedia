@@ -37,5 +37,148 @@
 // - Empty commands are left out.
 // - Unbalanced quotes: return null.
 export function simpleCommands(command: string): string[][] | null {
-  throw new Error('not implemented');
+  const lexed = lex(command, 0, '');
+  return lexed === null ? null : toCommands(lexed.tokens);
+}
+
+const SHELLS = new Set(['sh', 'bash', 'zsh', 'dash', 'ksh']);
+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+
+type Token = { t: 'word'; v: string } | { t: 'sep' } | { t: 'redir' } | { t: 'sub'; cmds: string[][] };
+
+// Splits s from start into tokens. closer is ')' for $( ) and '`' for backticks, '' at top level.
+// Returns null for unbalanced quotes or substitutions.
+function lex(s: string, start: number, closer: '' | ')' | '`'): { tokens: Token[]; end: number } | null {
+  const tokens: Token[] = [];
+  let word = null as string | null;
+  let parens = 0;
+  const endWord = () => {
+    if (word !== null) tokens.push({ t: 'word', v: word });
+    word = null;
+  };
+  let i = start;
+  while (i < s.length) {
+    const c = s[i];
+    if (closer === '`' ? c === '`' : closer === ')' && c === ')' && parens === 0) {
+      endWord();
+      return { tokens, end: i + 1 };
+    }
+    if (c === ' ' || c === '\t') {
+      endWord();
+      i++;
+    } else if (c === '\n' || c === ';' || c === '|' || (c === '&' && s[i + 1] !== '>')) {
+      endWord();
+      tokens.push({ t: 'sep' });
+      i += (c === '&' || c === '|') && s[i + 1] === c ? 2 : 1;
+    } else if (c === '&') {
+      endWord();
+      i++;
+    } else if (c === '<' || c === '>') {
+      if (word !== null && /^\d+$/.test(word)) word = null;
+      else endWord();
+      let j = i + 1;
+      if (s[j] === c || s[j] === '&' || s[j] === '|') j++;
+      tokens.push({ t: 'redir' });
+      i = j;
+    } else if (c === '(' || c === ')') {
+      endWord();
+      parens += c === '(' ? 1 : -1;
+      tokens.push({ t: 'sep' });
+      i++;
+    } else if (c === '`' || (c === '$' && s[i + 1] === '(')) {
+      const r = substitution(s, i);
+      if (r === null) return null;
+      tokens.push(r.token);
+      i = r.end;
+    } else if (c === '\\') {
+      word = (word ?? '') + (s[i + 1] ?? '');
+      i += 2;
+    } else if (c === "'") {
+      const close = s.indexOf("'", i + 1);
+      if (close < 0) return null;
+      word = (word ?? '') + s.slice(i + 1, close);
+      i = close + 1;
+    } else if (c === '"') {
+      word = word ?? '';
+      let j = i + 1;
+      while (s[j] !== '"') {
+        if (j >= s.length) return null;
+        if (s[j] === '\\') {
+          word += s[j + 1] ?? '';
+          j += 2;
+        } else if (s[j] === '`' || (s[j] === '$' && s[j + 1] === '(')) {
+          const r = substitution(s, j);
+          if (r === null) return null;
+          tokens.push(r.token);
+          j = r.end;
+        } else {
+          word += s[j];
+          j++;
+        }
+      }
+      i = j + 1;
+    } else {
+      word = (word ?? '') + c;
+      i++;
+    }
+  }
+  if (closer !== '') return null;
+  endWord();
+  return { tokens, end: i };
+}
+
+// Parses the $( ) or backtick substitution starting at s[i] into a token holding its commands.
+function substitution(s: string, i: number): { token: Token; end: number } | null {
+  const inner = s[i] === '$' ? lex(s, i + 2, ')') : lex(s, i + 1, '`');
+  if (inner === null) return null;
+  const cmds = toCommands(inner.tokens);
+  return cmds === null ? null : { token: { t: 'sub', cmds }, end: inner.end };
+}
+
+// Turns tokens into commands: each simple command's argv, then the commands of its substitutions.
+function toCommands(tokens: Token[]): string[][] | null {
+  const out: string[][] = [];
+  let argv: string[] = [];
+  let subs: string[][] = [];
+  let target = false;
+  for (const t of [...tokens, { t: 'sep' } as const]) {
+    if (t.t === 'word' && target) target = false;
+    else if (t.t === 'word') argv.push(t.v);
+    else if (t.t === 'redir') target = true;
+    else if (t.t === 'sub') {
+      subs.push(...t.cmds);
+      target = false;
+    } else {
+      const cmds = expand(argv);
+      if (cmds === null) return null;
+      out.push(...cmds, ...subs);
+      argv = [];
+      subs = [];
+      target = false;
+    }
+  }
+  return out;
+}
+
+// Skips keywords and assignments, unwraps wrappers and unpacks bash -c and eval.
+function expand(argv: string[]): string[][] | null {
+  let i = 0;
+  while (i < argv.length && (KEYWORDS.has(argv[i]) || /^[A-Za-z_]\w*=/.test(argv[i]))) i++;
+  argv = argv.slice(i);
+  if (argv.length === 0) return [];
+  const wrapper = WRAPPERS.get(argv[0]);
+  if (wrapper) {
+    let j = 1;
+    while (j < argv.length && argv[j].startsWith('-')) {
+      if (argv[j] === '--') {
+        j++;
+        break;
+      }
+      j += wrapper.value?.includes(argv[j]) ? 2 : 1;
+    }
+    return expand(argv.slice(j + (wrapper.positional ?? 0)));
+  }
+  if (SHELLS.has(argv[0]) && argv[1] === '-c' && argv.length > 2) return simpleCommands(argv[2]);
+  if (argv[0] === 'eval') return simpleCommands(argv.slice(1).join(' '));
+  return [argv];
 }
