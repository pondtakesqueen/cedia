+++ b/shell.ts	2026-10-29 07:20:16.828603468 +0000
@@ -37,5 +37,202 @@
 // - Empty commands are left out.
 // - Unbalanced quotes: return null.
 export function simpleCommands(command: string): string[][] | null {
-  throw new Error('not implemented');
+  const lexed = lex(command, 0, false);
+  return lexed && parse(lexed.tokens);
+}
+
+type Word = { text: string; assign: boolean };
+type Token = { kind: 'word'; word: Word } | { kind: 'sep' } | { kind: 'redir'; target: boolean } | { kind: 'sub'; tokens: Token[] };
+
+const SEP: Token = { kind: 'sep' };
+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const SHELLS = new Set(['bash', 'sh', 'zsh', 'dash', 'ksh']);
+const REDIRECT = /&>>?|>>|<<|<>|>\||[<>]&?/y;
+const FD = /\d+|-/y;
+
+// Splits s from start into tokens. Inside $( ) (inSub) it stops at the unmatched ')' and returns where it stopped.
+function lex(s: string, start: number, inSub: boolean): { tokens: Token[]; end: number } | null {
+  const tokens: Token[] = [];
+  let text = '';
+  let started = false;
+  let nameQuoted = false;
+  let depth = 0;
+  const flush = () => {
+    if (started) tokens.push({ kind: 'word', word: { text, assign: !nameQuoted && /^[A-Za-z_]\w*=/.test(text) } });
+    text = '';
+    started = false;
+    nameQuoted = false;
+  };
+  const quoted = () => {
+    started = true;
+    if (!text.includes('=')) nameQuoted = true;
+  };
+  // Returns the index after the substitution starting at i, or null if it is not closed.
+  const substitution = (i: number): number | null => {
+    if (s[i] === '`') {
+      let j = i + 1;
+      while (j < s.length && s[j] !== '`') j += s[j] === '\\' ? 2 : 1;
+      const inner = j < s.length ? lex(s.slice(i + 1, j).replace(/\\([`\\$])/g, '$1'), 0, false) : null;
+      if (!inner) return null;
+      tokens.push({ kind: 'sub', tokens: inner.tokens });
+      return j + 1;
+    }
+    const inner = lex(s, i + 2, true);
+    if (!inner) return null;
+    tokens.push({ kind: 'sub', tokens: inner.tokens });
+    return inner.end;
+  };
+  // Returns the index after the redirection operator at i; a redirection to a file descriptor (2>&1) has no target.
+  const redirect = (i: number): number => {
+    REDIRECT.lastIndex = i;
+    const op = REDIRECT.exec(s)![0];
+    let next = i + op.length;
+    let target = true;
+    if (op.endsWith('&')) {
+      FD.lastIndex = next;
+      const fd = FD.exec(s);
+      if (fd) {
+        next += fd[0].length;
+        target = false;
+      }
+    }
+    tokens.push({ kind: 'redir', target });
+    return next;
+  };
+
+  let i = start;
+  while (i < s.length) {
+    const c = s[i];
+    if (c === '\n' || c === ';') {
+      flush();
+      tokens.push(SEP);
+      i++;
+    } else if (c === '<' || c === '>' || (c === '&' && s[i + 1] === '>')) {
+      if (/^\d+$/.test(text)) {
+        text = '';
+        started = false;
+      }
+      flush();
+      i = redirect(i);
+    } else if (c === '&' || c === '|') {
+      flush();
+      tokens.push(SEP);
+      i += s[i + 1] === c ? 2 : 1;
+    } else if (c === '(') {
+      flush();
+      depth++;
+      tokens.push(SEP);
+      i++;
+    } else if (c === ')') {
+      flush();
+      if (depth > 0) depth--;
+      else if (inSub) return { tokens, end: i + 1 };
+      tokens.push(SEP);
+      i++;
+    } else if (c === "'") {
+      const j = s.indexOf("'", i + 1);
+      if (j < 0) return null;
+      text += s.slice(i + 1, j);
+      quoted();
+      i = j + 1;
+    } else if (c === '"') {
+      quoted();
+      let j = i + 1;
+      while (s[j] !== '"') {
+        if (j >= s.length) return null;
+        if (s[j] === '\\') {
+          text += s.slice(j + 1, j + 2);
+          j += 2;
+        } else if (s[j] === '`' || (s[j] === '$' && s[j + 1] === '(')) {
+          const n = substitution(j);
+          if (n === null) return null;
+          j = n;
+        } else {
+          text += s[j];
+          j++;
+        }
+      }
+      i = j + 1;
+    } else if (c === '`' || (c === '$' && s[i + 1] === '(')) {
+      const n = substitution(i);
+      if (n === null) return null;
+      i = n;
+    } else if (c === '\\') {
+      quoted();
+      text += s.slice(i + 1, i + 2);
+      i += 2;
+    } else if (c === ' ' || c === '\t' || c === '\r') {
+      flush();
+      i++;
+    } else {
+      text += c;
+      started = true;
+      i++;
+    }
+  }
+  if (inSub) return null;
+  flush();
+  return { tokens, end: s.length };
+}
+
+// Groups tokens into simple commands. A command's slot in `out` is reserved when it starts, so commands from
+// substitutions inside it come after it.
+function parse(tokens: Token[]): string[][] | null {
+  const out: string[][] = [];
+  let argv: Word[] | null = null;
+  let slot = 0;
+  let skipNext = false;
+  for (const t of [...tokens, SEP]) {
+    if (t.kind === 'sub') {
+      const inner = parse(t.tokens);
+      if (!inner) return null;
+      out.push(...inner);
+    } else if (t.kind === 'redir') {
+      skipNext = t.target;
+    } else if (t.kind === 'sep') {
+      skipNext = false;
+      if (argv) {
+        const cmds = unwrap(argv);
+        if (!cmds) return null;
+        out.splice(slot, 1, ...cmds);
+        argv = null;
+      }
+    } else if (skipNext) {
+      skipNext = false;
+    } else {
+      if (!argv) {
+        argv = [];
+        slot = out.length;
+        out.push([]);
+      }
+      argv.push(t.word);
+    }
+  }
+  return out;
+}
+
+// Drops leading assignments, keywords and wrappers, then unpacks `bash -c` and `eval`.
+function unwrap(words: Word[]): string[][] | null {
+  let i = 0;
+  while (i < words.length) {
+    const { text, assign } = words[i];
+    if (assign || KEYWORDS.has(text)) {
+      i++;
+      continue;
+    }
+    const wrapper = WRAPPERS.get(text);
+    if (!wrapper) break;
+    i++;
+    while (i < words.length && words[i].text.startsWith('-')) {
+      const flag = words[i++].text;
+      if (flag === '--') break;
+      if (wrapper.value?.includes(flag)) i++;
+    }
+    i += wrapper.positional ?? 0;
+  }
+  const argv = words.slice(i).map((w) => w.text);
+  if (argv.length === 0) return [];
+  if (SHELLS.has(argv[0]) && argv[1] === '-c' && argv.length > 2) return simpleCommands(argv[2]);
+  if (argv[0] === 'eval') return simpleCommands(argv.slice(1).join(' '));
+  return [argv];
 }
