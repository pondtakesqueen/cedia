diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 07:18:59.180598852 +0000
@@ -0,0 +1,31 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('10 units of one SKU get the 5% bulk discount', () => {
+    // 10 mugs = 4500; 5% = 225; discounted 4275 < 5000 so shipping 800; tax 7% of 5075 = 355.25 -> 355
+    expect(totals(cart('US', [['MUG', 10]]))).toMatchObject({ subtotal: 4275, shipping: 800, tax: 355, total: 5430 });
+  });
+
+  test('50 units get the 10% bulk discount', () => {
+    // 50 pens = 6000; 10% = 600; discounted 5400 >= 5000 so free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same SKU are merged before bulk pricing', () => {
+    // 6 + 5 mugs = 11 units: 4950; 5% = 247.5 -> 248; discounted 4702; shipping 800; tax 7% of 5502 = 385.14 -> 385
+    expect(totals(cart('US', [['MUG', 6], ['MUG', 5]]))).toMatchObject({ subtotal: 4702, shipping: 800, tax: 385, total: 5887 });
+  });
+
+  test('UK free shipping starts at 4000', () => {
+    // 9 mugs = 4050 >= 4000 so free; tax 20% of 4050 = 810
+    expect(totals(cart('UK', [['MUG', 9]]))).toMatchObject({ subtotal: 4050, shipping: 0, tax: 810, total: 4860 });
+  });
+
+  test('free shipping is judged on the discounted subtotal after the coupon', () => {
+    // 3 tees + 2 mugs = 5400; SAVE10 takes 540 -> 4860 < 5000 so shipping 800; tax 7% of 5660 = 396.2 -> 396
+    expect(totals(cart('US', [['TEE', 3], ['MUG', 2]], 'SAVE10'))).toMatchObject({ coupon: 540, shipping: 800, tax: 396, total: 6056 });
+  });
+});
