diff -ruN --exclude=node_modules --exclude=.git a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-23 15:00:01
+++ b/src/slug.ts	2026-10-23 15:00:30
@@ -11,10 +11,25 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  const cut = slug.lastIndexOf('-', max);
+  return cut > 0 ? slug.slice(0, cut) : slug.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  for (let n = 2; ; n++) {
+    const candidate = `${slug}-${n}`;
+    if (!taken.has(candidate)) return candidate;
+  }
 }
diff -ruN --exclude=node_modules --exclude=.git a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 07:00:00
+++ b/test/duration.rules.test.ts	2026-10-23 15:00:52
@@ -0,0 +1,29 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parses every unit, fractions, spaces and rounding', () => {
+  expect(parseDuration('2d')).toBe(172_800_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('  1m 1s  ')).toBe(61_000);
+  expect(parseDuration('1m1ms')).toBe(60_001);
+  expect(parseDuration('1.4ms')).toBe(1);
+  expect(parseDuration('0.0005s')).toBe(1);
+});
+
+test('rejects invalid input with the input in the message', () => {
+  for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '1 h', '1.h', '1h-', 'h1']) {
+    expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+  }
+});
+
+test('formats largest unit first, skipping zero parts', () => {
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(5)).toBe('5ms');
+  expect(formatDuration(86_400_000 + 1)).toBe('1d1ms');
+  expect(formatDuration(187_200_000)).toBe('2d4h');
+  expect(formatDuration(parseDuration('3d 2h 1m 5s 7ms'))).toBe('3d2h1m5s7ms');
+  expect(() => formatDuration(-1)).toThrow();
+});
diff -ruN --exclude=node_modules --exclude=.git a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 07:00:00
+++ b/test/lru.rules.test.ts	2026-10-23 15:00:52
@@ -0,0 +1,83 @@
+import { expect, test } from 'bun:test';
+import { EvictReason, LRU } from '../src/lru.ts';
+
+function make(capacity: number, ttl = 1000) {
+  const clock = { t: 0 };
+  const cache = new LRU<string, number>(capacity, ttl, () => clock.t);
+  const events: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => events.push([k, v, r]);
+  return { clock, cache, events };
+}
+
+test('get refreshes recency; capacity evicts the least recently used', () => {
+  const { cache, events } = make(2);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(events).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('set on an existing key refreshes value, recency and ttl', () => {
+  const { clock, cache, events } = make(2);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  clock.t = 900;
+  cache.set('a', 10);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  clock.t = 1500;
+  expect(cache.get('a')).toBe(10);
+  expect(cache.size).toBe(1);
+  expect(events).toEqual([]);
+});
+
+test('expiry boundary and removal on get', () => {
+  const { clock, cache, events } = make(2);
+  cache.set('a', 1);
+  clock.t = 999;
+  expect(cache.get('a')).toBe(1);
+  clock.t = 1000;
+  expect(cache.size).toBe(0);
+  expect(cache.keys()).toEqual([]);
+  expect(cache.get('a')).toBeUndefined();
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.get('a')).toBeUndefined();
+  expect(events.length).toBe(1);
+});
+
+test('expired entries count toward capacity and are evicted before live ones', () => {
+  const { clock, cache, events } = make(3);
+  cache.set('a', 1);
+  clock.t = 500;
+  cache.set('b', 2);
+  cache.set('c', 3);
+  clock.t = 1200; // a expired, b and c live
+  expect(cache.size).toBe(2);
+  cache.set('d', 4);
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['d', 'c', 'b']);
+  cache.set('e', 5);
+  expect(events).toEqual([['a', 1, 'expired'], ['b', 2, 'capacity']]);
+});
+
+test('no eviction while within capacity, even with expired entries', () => {
+  const { clock, cache, events } = make(2);
+  cache.set('a', 1);
+  clock.t = 2000;
+  cache.set('b', 2);
+  expect(events).toEqual([]);
+  expect(cache.size).toBe(1);
+});
+
+test('delete', () => {
+  const { clock, cache, events } = make(2);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(cache.delete('a')).toBe(false);
+  expect(cache.delete('zzz')).toBe(false);
+  clock.t = 1000;
+  expect(cache.delete('b')).toBe(false);
+  expect(events).toEqual([['a', 1, 'delete'], ['b', 2, 'expired']]);
+});
diff -ruN --exclude=node_modules --exclude=.git a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 07:00:00
+++ b/test/slug.rules.test.ts	2026-10-23 15:00:52
@@ -0,0 +1,30 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('strips diacritics and maps special letters', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('Straße Æon Œuvre Øl Łódź Đak')).toBe('strasse-aeon-oeuvre-ol-lodz-dak');
+});
+
+test('separators collapse and never lead or trail', () => {
+  expect(slugify('  --Hello__World!!  ')).toBe('hello-world');
+  expect(slugify('a/b.c')).toBe('a-b-c');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('日本 abc 123')).toBe('abc-123');
+});
+
+test('max cuts at the last dash within max, or at max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('ab-cd-ef', 8)).toBe('ab-cd-ef');
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+  expect(slugify('abcdef-gh', 3)).toBe('abc');
+  expect(slugify('ab-cd', 2)).toBe('ab');
+  expect(slugify('ab-cd', 3)).toBe('ab');
+});
+
+test('uniqueSlug picks the first free suffix', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-2', 'post-3']))).toBe('post-4');
+  expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+});
