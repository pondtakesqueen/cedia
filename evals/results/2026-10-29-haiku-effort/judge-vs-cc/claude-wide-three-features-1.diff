   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.entries.delete(key);
+    this.entries.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    const t = this.now();
+    for (const [k, e] of this.entries) {
+      if (t >= e.expires) this.remove(k, e.value, 'expired');
+    }
+    for (const [k, e] of this.entries) {
+      if (this.entries.size <= this.capacity) break;
+      this.remove(k, e.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return false;
+    const live = this.now() < entry.expires;
+    this.remove(key, entry.value, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    return this.keys().length;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
+    const live: K[] = [];
+    for (const [k, e] of this.entries) if (t < e.expires) live.push(k);
+    return live.reverse();
+  }
+
+  private remove(key: K, value: V, reason: EvictReason): void {
+    this.entries.delete(key);
