 // One exception: a leading `cd <dir> && ` is removed when <dir> (quotes stripped) resolves to `cwd`.
 export function matchCheck(command: string, checks: string[], cwd?: string): string | undefined {
-  throw new Error('not implemented');
+  const norm = (s: string) => s.trim().replace(/\s+/g, ' ').replace(/ 2>&1$/, '');
+  let cmd = norm(command);
+  const cd = /^cd ("[^"]*"|'[^']*'|\S+) && (.*)$/.exec(cmd);
+  if (cd) {
+    if (cwd === undefined) return undefined;
+    const dir = cd[1]!.replace(/^(["'])(.*)\1$/, '$2');
+    if (resolve(cwd, dir) !== resolve(cwd)) return undefined;
+    cmd = norm(cd[2]!);
+  }
+  return checks.find((check) => norm(check) === cmd);
