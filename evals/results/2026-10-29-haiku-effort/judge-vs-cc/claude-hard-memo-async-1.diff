diff -ruN --exclude=node_modules --exclude=.git a/memo.test.ts b/memo.test.ts
--- a/memo.test.ts	2026-10-23 13:08:34
+++ b/memo.test.ts	2026-10-23 13:09:05
@@ -66,3 +66,128 @@
   m("k");
   expect(calls).toHaveLength(2);
 });
+
+test("a call after invalidate runs fn again while the earlier call is in flight", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  expect(calls).toHaveLength(2);
+  calls[0]!.d.resolve("old");
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("an invalidated call settling late does not overwrite the newer result", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  m("k");
+  calls[1]!.d.resolve("new");
+  await tick();
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("an invalidated call rejecting late does not drop the newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k").catch(() => {});
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("old"));
+  await tick();
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a key dropped for max is not re-added when its call settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  expect(m.size).toBe(1);
+  m("b");
+  expect(calls).toHaveLength(2);
+});
+
+test("a cache hit makes the key most recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("a");
+  m("c"); // drops b, not a
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("a rejection reaches every waiting caller and is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(a).rejects.toThrow("boom");
+  await expect(b).rejects.toThrow("boom");
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("fn throwing synchronously rejects and is not kept", async () => {
+  let n = 0;
+  const m = memo<string, string>(
+    () => {
+      n++;
+      throw new Error("sync");
+    },
+    { ttlMs: 1000, max: 10 },
+  );
+  await expect(m("k")).rejects.toThrow("sync");
+  await expect(m("k")).rejects.toThrow("sync");
+  expect(n).toBe(2);
+  expect(m.size).toBe(0);
+});
+
+test("expired keys are not counted or kept over live ones", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 50;
+  m("b");
+  calls[1]!.d.resolve("b");
+  await tick();
+  t = 100; // a expired, b still live
+  expect(m.size).toBe(1);
+  m("c"); // must not drop b
+  m("b");
+  expect(calls).toHaveLength(3);
+});
+
+test("clear forgets in-flight calls too", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
