 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: oldText, new_text: newText, replace_all: replaceAll } = edit;
+  if (oldText === '') return { error: 'old_text is empty; use write to replace the whole file' };
+  if (oldText === newText) return { error: 'old_text and new_text are the same' };
+
+  const exactAt: number[] = [];
+  for (let pos = content.indexOf(oldText); pos >= 0; pos = content.indexOf(oldText, pos + oldText.length)) exactAt.push(pos);
+  if (exactAt.length > 1 && !replaceAll) {
+    const first = lineOf(content, exactAt[0]);
+    return { error: `old_text matches ${exactAt.length} places (first at line ${first}); add context to make it unique or set replace_all` };
+  }
+  if (exactAt.length > 0) {
+    const last = exactAt[exactAt.length - 1] + oldText.length - 1;
+    const applied = { from: lineOf(content, exactAt[0]), to: lineOf(content, last), tier: 'exact' as const, count: exactAt.length };
