+  }
+
+  const { lines, eol } = splitLines(content);
+  const oldLines = stripEol(oldText).split('\n');
+  const newLines = stripEol(newText) === '' ? [] : stripEol(newText).split('\n');
+
+  const trailing = windowHits(lines, oldLines, (a, b) => a.trimEnd() === b.trimEnd());
+  if (trailing.length > 1) return { error: matchError(trailing.map((i) => i + 1)) };
+  if (trailing.length === 1) {
+    const start = trailing[0];
+    return joinLines(lines, eol, start, oldLines.length, newLines, 'trailing-space');
+  }
+
+  const indented = windowHits(lines, oldLines, (a, b) => a.trim() === b.trim());
+  if (indented.length > 1) return { error: matchError(indented.map((i) => i + 1)) };
+  if (indented.length === 1) {
+    const start = indented[0];
+    const k = oldLines.findIndex((l) => l.trim() !== '');
+    const oldIndent = k < 0 ? '' : indentOf(oldLines[k]);
+    const newIndent = k < 0 ? '' : indentOf(lines[start + k]);
+    const reindented = newLines.map((l) => {
+      if (l.trim() === '' || !l.startsWith(oldIndent)) return l;
+      return newIndent + l.slice(oldIndent.length);
+    });
+    return joinLines(lines, eol, start, oldLines.length, reindented, 'indentation');
+  }
+
+  const first = oldLines.find((l) => l.trim() !== '')?.trim() ?? '';
+  const appears = lines.flatMap((l, i) => (first !== '' && l.includes(first) ? [i + 1] : []));
+  const hint = appears.length > 0 ? `; first line appears at line ${appears.slice(0, 5).join(', ')}` : '';
+  return { error: `old_text not found${hint}` };
+}
+
+function matchError(linesOf: number[]): string {
+  return `old_text matches ${linesOf.length} places (lines ${linesOf.join(', ')}); add context to make it unique or set replace_all`;
+}
+
+function lineOf(content: string, pos: number): number {
+  return content.slice(0, pos).split('\n').length;
+}
+
+function stripEol(s: string): string {
+  return s.endsWith('\n') ? s.slice(0, -1) : s;
+}
+
+function indentOf(s: string): string {
+  return /^\s*/.exec(s)![0];
+}
+
+function splitLines(content: string): { lines: string[]; eol: boolean } {
+  if (content === '') return { lines: [], eol: false };
+  const eol = content.endsWith('\n');
+  return { lines: (eol ? content.slice(0, -1) : content).split('\n'), eol };
+}
+
+function windowHits(lines: string[], oldLines: string[], same: (a: string, b: string) => boolean): number[] {
+  const hits: number[] = [];
+  for (let i = 0; i + oldLines.length <= lines.length; i++) {
+    if (oldLines.every((l, j) => same(lines[i + j], l))) hits.push(i);
+  }
+  return hits;
+}
+
+function joinLines(lines: string[], eol: boolean, start: number, count: number, replacement: string[], tier: Tier): { content: string; applied: Applied } {
+  const out = [...lines.slice(0, start), ...replacement, ...lines.slice(start + count)];
+  return {
+    content: out.join('\n') + (eol && out.length > 0 ? '\n' : ''),
+    applied: { from: start + 1, to: start + count, tier, count: 1 },
+  };
 }
