 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  if (edit.old_text === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (edit.old_text === edit.new_text) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  const result =
+    applyExact(content, edit) ?? applyLines(content, edit, 'trailing-space') ?? applyLines(content, edit, 'indentation');
+  if (result) return result;
+
+  const first = edit.old_text
+    .split('\n')
+    .map((l) => l.trim())
+    .find((l) => l !== '');
+  const hits = first === undefined ? [] : content.split('\n').flatMap((l, i) => (l.includes(first) ? [i + 1] : []));
+  if (hits.length === 0) return { error: 'old_text not found' };
+  return { error: `old_text not found; first line appears at line ${hits.slice(0, 5).join(', ')}` };
 }
