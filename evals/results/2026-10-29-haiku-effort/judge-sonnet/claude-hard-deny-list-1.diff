+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const opts = dd < 0 ? args : args.slice(0, dd);
+  if (!opts.some((w) => w === '--recursive' || hasShortFlag(w, 'rR'))) return undefined;
+  const targets = [...opts.filter((w) => !w.startsWith('-')), ...(dd < 0 ? [] : args.slice(dd + 1))];
+  const bad = targets.length === 0 || targets.some((p) => unresolvable(p) || !insideWorkspace(p, cwd) || sameDir(p, cwd));
