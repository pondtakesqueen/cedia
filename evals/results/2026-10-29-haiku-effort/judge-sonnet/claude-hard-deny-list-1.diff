 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+// A short flag group such as -f or -fu: one dash, letters only, containing one of `letters`.
+const hasShortFlag = (word: string, letters: string) => /^-[a-zA-Z]+$/.test(word) && [...letters].some((c) => word.includes(c));
+
+// Paths that cannot be resolved before the command runs: shell variables and ~user.
+const unresolvable = (path: string) => /\$|^~[^/]/.test(path);
+
+const gitValueOptions = ['-C', '-c', '--git-dir', '--work-tree', '--namespace'];
+const pushForceFlags = ['--force', '--force-with-lease', '--mirror', '--delete', '--prune'];
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += gitValueOptions.includes(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const forced = rest.some((w) => pushForceFlags.includes(w.split('=')[0]) || hasShortFlag(w, 'fd') || /^[+:]/.test(w));
+    return forced ? { name: 'force-push', reason: 'git push that rewrites or deletes remote refs' } : undefined;
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean' && rest.some((w) => w === '--force' || hasShortFlag(w, 'f')) && !rest.some((w) => w === '-n' || w === '--dry-run'))
+    return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  return undefined;
