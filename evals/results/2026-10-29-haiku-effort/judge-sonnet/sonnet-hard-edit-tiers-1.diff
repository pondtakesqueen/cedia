+  }
+
+  const firstLine = oldLines.find((l) => l.trim() !== '')?.trim();
+  const appears: number[] = [];
+  if (firstLine !== undefined) {
+    for (let i = 0; i < searchable && appears.length < 5; i++) if (lines[i].includes(firstLine)) appears.push(i + 1);
+  }
