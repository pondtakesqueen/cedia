diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.fix.test.ts b/pool.fix.test.ts
--- a/pool.fix.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.fix.test.ts	2026-10-29 07:35:04.572670150 +0000
@@ -0,0 +1,66 @@
+import { expect, test } from "bun:test";
+import { runPool } from "./pool";
+
+const later = <T>(ms: number, v: T) => () => new Promise<T>((r) => setTimeout(() => r(v), ms));
+
+test("never exceeds the limit and keeps input order", async () => {
+  let running = 0;
+  let peak = 0;
+  const task = (ms: number, v: number) => async () => {
+    peak = Math.max(peak, ++running);
+    await new Promise((r) => setTimeout(r, ms));
+    running--;
+    return v;
+  };
+  const out = await runPool([task(20, 0), task(1, 1), task(5, 2), task(1, 3), task(1, 4)], 2);
+  expect(peak).toBe(2);
+  expect(out.map((r) => (r.status === "fulfilled" ? r.value : -1))).toEqual([0, 1, 2, 3, 4]);
+});
+
+test("refuses fractional, NaN and negative options", async () => {
+  await expect(runPool([later(1, 1)], 1.5)).rejects.toBeInstanceOf(RangeError);
+  await expect(runPool([later(1, 1)], NaN)).rejects.toBeInstanceOf(RangeError);
+  await expect(runPool([later(1, 1)], 1, { retries: 1.5 })).rejects.toBeInstanceOf(RangeError);
+  await expect(runPool([later(1, 1)], 1, { retries: -1 })).rejects.toBeInstanceOf(RangeError);
+  expect((await runPool([() => 1], Infinity))[0].status).toBe("fulfilled");
+});
+
+test("sync throws and plain values are handled", async () => {
+  const out = await runPool([() => { throw new Error("x"); }, () => 7], 1);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 1 });
+  expect(out[1]).toEqual({ status: "fulfilled", value: 7, attempts: 1 });
+});
+
+test("retries the right number of times", async () => {
+  let n = 0;
+  const out = await runPool([async () => { n++; throw new Error("no"); }], 1, { retries: 2 });
+  expect(n).toBe(3);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 3 });
+  let m = 0;
+  const ok = await runPool([async () => { if (++m < 2) throw new Error("no"); return "ok"; }], 1, { retries: 5 });
+  expect(ok[0]).toEqual({ status: "fulfilled", value: "ok", attempts: 2 });
+});
+
+test("abort stops new tasks and retries", async () => {
+  const ac = new AbortController();
+  let calls = 0;
+  const tasks = [
+    async () => { calls++; await new Promise((r) => setTimeout(r, 5)); ac.abort("stop"); throw new Error("fail"); },
+    later(20, "kept"),
+    async () => { calls++; return 3; },
+  ];
+  const out = await runPool(tasks, 2, { retries: 3, signal: ac.signal });
+  expect(out[0]).toMatchObject({ status: "rejected", reason: "stop", attempts: 1 });
+  expect(out[1]).toEqual({ status: "fulfilled", value: "kept", attempts: 1 });
+  expect(out[2]).toEqual({ status: "rejected", reason: "stop", attempts: 0 });
+  expect(calls).toBe(1);
+});
+
+test("an already aborted signal starts nothing", async () => {
+  const ac = new AbortController();
+  ac.abort("early");
+  let calls = 0;
+  const out = await runPool([() => { calls++; return 1; }], 1, { signal: ac.signal });
+  expect(calls).toBe(0);
+  expect(out).toEqual([{ status: "rejected", reason: "early", attempts: 0 }]);
+});
