diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 07:36:15.396660448 +0000
@@ -0,0 +1,34 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+describe('pricing rules from README.md', () => {
+  test('10 units get 5% off', () => {
+    // 10 pens = 1200 - 60 = 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('50 units get 10% off, not 5%', () => {
+    // 50 pens = 6000 - 600 = 5400 >= 5000 ships free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same sku are merged before the bulk tier', () => {
+    expect(totals(cart('US', [['PEN', 5], ['PEN', 5]]))).toMatchObject({ subtotal: 1140, total: 2076 });
+  });
+
+  test('UK ships free from 4000', () => {
+    // 3 caps + 1 mug = 4050; tax 20% of 4050 = 810
+    expect(totals(cart('UK', [['CAP', 3], ['MUG', 1]]))).toMatchObject({ shipping: 0, tax: 810, total: 4860 });
+  });
+
+  test('free shipping looks at the subtotal after the coupon', () => {
+    // 5070 - 500 = 4570 < 5000; shipping 800; tax 7% of 5370 = 375.9 -> 376
+    expect(totals(cart('US', [['TEE', 3], ['MUG', 1], ['PEN', 1]], 'FLAT5'))).toMatchObject({
+      coupon: 500,
+      shipping: 800,
+      tax: 376,
+      total: 5746,
+    });
+  });
+});
