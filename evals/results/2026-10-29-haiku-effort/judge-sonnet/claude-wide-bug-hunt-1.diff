diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 07:21:00.528606065 +0000
@@ -0,0 +1,31 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('10 units of one sku get the 5% tier', () => {
+    // 10 mugs = 4500; 5% = 225 off; 4275 < 5000 so shipping 800; tax 7% of 5075 = 355.25 -> 355
+    expect(totals(cart('US', [['MUG', 10]]))).toMatchObject({ subtotal: 4275, shipping: 800, tax: 355, total: 5430 });
+  });
+
+  test('50 units of one sku get the 10% tier', () => {
+    // 50 pens = 6000; 10% = 600 off; 5400 >= 5000 so shipping free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same sku are merged before bulk pricing', () => {
+    // 6 + 5 mugs = 11 units, 5% of 4950 = 247.5 -> 248 off; 4702 + 800 shipping; tax 7% of 5502 = 385.14 -> 385
+    expect(totals(cart('US', [['MUG', 6], ['MUG', 5]]))).toMatchObject({ subtotal: 4702, shipping: 800, tax: 385, total: 5887 });
+  });
+
+  test('free shipping is judged on the subtotal after the coupon', () => {
+    // 3 tees + 5 pens = 5100; FLAT5 -> 4600 < 5000 so shipping 800; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['TEE', 3], ['PEN', 5]], 'FLAT5'))).toMatchObject({ subtotal: 5100, coupon: 500, shipping: 800, tax: 378, total: 5778 });
+  });
+
+  test('UK free shipping starts at exactly 4000', () => {
+    // 1 bag + 4 mugs = 4000 >= 4000 so shipping free; tax 20% of 4000 = 800
+    expect(totals(cart('UK', [['BAG', 1], ['MUG', 4]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+});
