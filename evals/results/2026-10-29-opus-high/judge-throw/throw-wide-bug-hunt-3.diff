diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 18:30:02.847488268 +0000
@@ -0,0 +1,91 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { bulkDiscount } from '../src/pricing/discounts/bulk.ts';
+import { couponDiscount } from '../src/pricing/discounts/coupons.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+import { totals } from '../src/order/total.ts';
+import { percentOf } from '../src/money/round.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('rule 1: a line subtotal is unit price times quantity', () => {
+    // 9 pens = 9 * 120 = 1080; below the bulk threshold, so no discount
+    expect(totals(cart('US', [['PEN', 9]]))).toMatchObject({ subtotal: 1080, shipping: 800, tax: 132, total: 2012 });
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]).toMatchObject({ subtotal: 1080, discount: 0, total: 1080 });
+  });
+
+  test('rule 2: 10 units get 5% off the line', () => {
+    // 10 pens = 1200; 5% off = 60; discounted 1140; shipping 800 (below 5000); tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('rule 2: 9 units get no bulk discount, 10 units do', () => {
+    expect(bulkDiscount(9, 1080)).toBe(0);
+    expect(bulkDiscount(10, 1200)).toBe(60);
+  });
+
+  test('rule 2: 50 units get 10% off the line, and only the top tier applies', () => {
+    // 50 pens = 6000; 10% off = 600; discounted 5400 >= 5000 so shipping 0; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+    expect(bulkDiscount(49, 1000)).toBe(50);
+    expect(bulkDiscount(50, 1000)).toBe(100);
+  });
+
+  test('rule 2: units count per SKU across the cart, so lines of one SKU are merged first', () => {
+    const c = cart('US', [['PEN', 5], ['PEN', 5]]);
+    expect(totals(c)).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+    expect(totals(c).lines).toHaveLength(1);
+    // the caller's cart is not changed by pricing
+    expect(c.lines).toEqual([
+      { sku: 'PEN', quantity: 5, unitPrice: 120 },
+      { sku: 'PEN', quantity: 5, unitPrice: 120 },
+    ]);
+  });
+
+  test('rule 3: SAVE10 takes 10% off after bulk discounts', () => {
+    // 5 caps = 6000; SAVE10 = 600; discounted 5400 >= 5000 so no shipping; tax 378
+    expect(totals(cart('US', [['CAP', 5]], 'SAVE10'))).toMatchObject({ subtotal: 6000, coupon: 600, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('rule 3: FLAT5 takes 500 off and never goes below zero', () => {
+    expect(couponDiscount('FLAT5', 300)).toBe(300);
+    expect(couponDiscount('FLAT5', 800)).toBe(500);
+    // 1 pen = 120; coupon capped at 120; discounted 0; shipping 800; tax 7% of 800 = 56
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('rule 4: free shipping is judged on the discounted subtotal', () => {
+    // 2 bags + 6 pens = 4400 + 720 = 5120; FLAT5 -> 4620 discounted < 5000, so shipping is charged
+    // tax 7% of (4620 + 800) = 379.4 -> 379; total 4620 + 800 + 379 = 5799
+    expect(totals(cart('US', [['BAG', 2], ['PEN', 6]], 'FLAT5'))).toMatchObject({ subtotal: 5120, coupon: 500, shipping: 800, tax: 379, total: 5799 });
+  });
+
+  test('rule 4: a discounted subtotal exactly at the threshold ships free', () => {
+    // 2 bags + 5 pens = 4400 + 600 = 5000 >= 5000; tax 7% of 5000 = 350
+    expect(totals(cart('US', [['BAG', 2], ['PEN', 5]]))).toMatchObject({ subtotal: 5000, shipping: 0, tax: 350, total: 5350 });
+  });
+
+  test('region table: UK free shipping starts at 4000 and all regions match the table', () => {
+    expect(REGIONS).toEqual({
+      US: { code: 'US', taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 },
+      EU: { code: 'EU', taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 },
+      UK: { code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 },
+    });
+    // 2 bags = 4400 >= 4000; tax 20% of 4400 = 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+
+  test('rule 5: percentOf rounds half up exactly for the README rates', () => {
+    // 50 * 0.07 is 3.5 in exact arithmetic; the check is that it rounds up to 4
+    expect(percentOf(50, 0.07)).toBe(4);
+    for (const [rate, p] of [[0.05, 5], [0.07, 7], [0.1, 10], [0.2, 20]] as const) {
+      for (let amount = 0; amount <= 20000; amount++) {
+        expect(percentOf(amount, rate)).toBe(Math.floor((amount * p + 50) / 100));
+      }
+    }
+  });
+
+  test('unknown region still throws', () => {
+    expect(() => totals(cart('XX', [['PEN', 1]]))).toThrow('unknown region XX');
+  });
+});
