   return rows;
 }
+
+const PLAIN_STOP = /[,\r\n"]/g;
+
+type StreamState = "start" | "plain" | "cr" | "quoted" | "quote" | "closed" | "closedCr";
+
+/**
+ * `parseCsv` over chunks of any size: `push` returns the rows whose row end has arrived, `end` returns the rest.
+ * Only the current row and field are kept between calls. A SyntaxError, or a call after `end`, leaves the stream
+ * unusable: every further call throws.
+ */
+export class CsvStream {
+  private status: "reading" | "ended" | "failed" = "reading";
+  private state: StreamState = "start";
+  private started = false; // a non-empty chunk has been seen, so a BOM can only be dropped before it
+  private offset = 0; // absolute offset of the first character of the chunk being scanned
+  private row: string[] = [];
+  private field = "";
+  private rows: string[][] = [];
+
+  push(chunk: string): string[][] {
+    return this.run(() => this.scan(chunk));
+  }
+
+  end(): string[][] {
+    return this.run(() => this.finish());
+  }
+
+  private run(step: () => void): string[][] {
+    if (this.status === "failed") throw new Error("CsvStream: failed earlier");
+    if (this.status === "ended") throw new Error("CsvStream: already ended");
+    try {
+      step();
+    } catch (e) {
+      this.status = "failed";
+      throw e;
+    }
+    const rows = this.rows;
+    this.rows = [];
+    return rows;
+  }
+
+  private scan(chunk: string): void {
+    let text = chunk;
+    if (!this.started && text.length > 0) {
+      this.started = true;
+      if (text[0] === "\uFEFF") {
+        text = text.slice(1);
+        this.offset++;
+      }
+    }
+    let i = 0;
+    while (i < text.length) {
+      switch (this.state) {
+        case "start":
+          if (text[i] === '"') {
+            this.state = "quoted";
+            i++;
+          } else this.state = "plain";
+          break;
+        case "plain": {
+          PLAIN_STOP.lastIndex = i;
+          const m = PLAIN_STOP.exec(text);
+          const j = m ? m.index : text.length;
+          this.field += text.slice(i, j);
+          i = j;
+          if (j === text.length) break;
+          const c = text[j];
+          if (c === ",") {
+            this.endField();
+            i++;
+          } else if (c === "\n") {
+            this.endRow();
+            i++;
+          } else if (c === '"') {
+            throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.offset + j}`);
+          } else if (j + 1 === text.length) {
+            this.state = "cr";
+            i++;
+          } else if (text[j + 1] === "\n") {
+            this.endRow();
+            i = j + 2;
+          } else {
+            this.field += "\r";
+            i = j + 1;
+          }
+          break;
+        }
+        case "cr":
+          if (text[i] === "\n") {
+            this.endRow();
+            i++;
+          } else {
+            this.field += "\r";
+            this.state = "plain";
+          }
+          break;
+        case "quoted": {
+          const j = text.indexOf('"', i);
+          if (j < 0) {
+            this.field += text.slice(i);
+            i = text.length;
+          } else {
+            this.field += text.slice(i, j);
+            this.state = "quote";
+            i = j + 1;
+          }
+          break;
+        }
+        case "quote":
+          if (text[i] === '"') {
+            this.field += '"';
+            this.state = "quoted";
+            i++;
+          } else this.state = "closed";
+          break;
+        case "closed": {
+          const c = text[i]!;
+          if (c === ",") {
+            this.endField();
+            i++;
+          } else if (c === "\n") {
+            this.endRow();
+            i++;
+          } else if (c === "\r" && i + 1 === text.length) {
+            this.state = "closedCr";
+            i++;
+          } else if (c === "\r" && text[i + 1] === "\n") {
+            this.endRow();
+            i += 2;
+          } else throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${this.offset + i}`);
+          break;
+        }
+        case "closedCr":
+          if (text[i] !== "\n") throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.offset - 1}`);
+          this.endRow();
+          i++;
+          break;
+      }
+    }
+    this.offset += text.length;
+  }
+
+  private finish(): void {
+    if (this.state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+    if (this.state === "closedCr") throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.offset - 1}`);
+    if (this.state === "cr") this.field += "\r";
+    if (this.state !== "start" || this.row.length > 0) this.endRow();
+    this.status = "ended";
+  }
+
+  private endField(): void {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "start";
+  }
+
+  private endRow(): void {
+    this.endField();
+    this.rows.push(this.row);
+    this.row = [];
+  }
+}
