diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.stream.test.ts b/csv.stream.test.ts
--- a/csv.stream.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/csv.stream.test.ts	2026-10-29 18:00:37.707383342 +0000
@@ -0,0 +1,139 @@
+import { expect, test } from "bun:test";
+import { CsvStream, parseCsv } from "./csv";
+
+function streamParse(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const chunk of chunks) rows.push(...s.push(chunk));
+  rows.push(...s.end());
+  return rows;
+}
+
+function splitAt(text: string, cuts: number[]): string[] {
+  const chunks: string[] = [];
+  let prev = 0;
+  for (const cut of [...cuts].sort((a, b) => a - b)) {
+    chunks.push(text.slice(prev, cut));
+    prev = cut;
+  }
+  chunks.push(text.slice(prev));
+  return chunks;
+}
+
+function expectSameAsParseCsv(text: string, chunks: string[]): void {
+  let expected: string[][];
+  try {
+    expected = parseCsv(text);
+  } catch (e) {
+    expect(e).toBeInstanceOf(SyntaxError);
+    expect(() => streamParse(chunks)).toThrow(SyntaxError);
+    return;
+  }
+  expect(streamParse(chunks)).toEqual(expected);
+}
+
+test("a quoted field may hold a split doubled quote and a split closing quote", () => {
+  expectSameAsParseCsv('"x""y"', ['"x"', '"y"']);
+  expectSameAsParseCsv('"x",z', ['"x"', ',z']);
+  expect(streamParse(['"x"', ',z'])).toEqual([["x", "z"]]);
+  expect(streamParse(['"x"', '"y"'])).toEqual([['x"y']]);
+});
+
+test("a \\r at the end of a chunk waits for the next character", () => {
+  const s = new CsvStream();
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\nb")).toEqual([["a"]]);
+  expect(s.end()).toEqual([["b"]]);
+
+  expect(streamParse(["a\r", "b"])).toEqual([["a\rb"]]);
+  expect(streamParse(["a\r"])).toEqual([["a\r"]]);
+  expect(streamParse(["\n\r"])).toEqual([[""], ["\r"]]);
+});
+
+test("text after a closing quote is a SyntaxError, even in a later chunk", () => {
+  const s = new CsvStream();
+  s.push('"a"');
+  expect(() => s.push("b")).toThrow(SyntaxError);
+  expect(() => streamParse(['"a"', '\rb'])).toThrow(SyntaxError);
+  expect(() => streamParse(['"a"\r'])).toThrow(SyntaxError);
+});
+
+test("a quote in an unquoted field is a SyntaxError, even in a later chunk", () => {
+  expect(() => streamParse(["ab", 'c"'])).toThrow(SyntaxError);
+  expect(() => streamParse(["a\r", '"'])).toThrow(SyntaxError);
+});
+
+test("a quoted field still open at the end is a SyntaxError from end", () => {
+  const s = new CsvStream();
+  expect(s.push('"abc')).toEqual([]);
+  expect(() => s.end()).toThrow(SyntaxError);
+});
+
+test("a BOM is dropped only at the very start of the input", () => {
+  expect(streamParse(["", "\uFEFFa"])).toEqual([["a"]]);
+  expect(streamParse(["\uFEFF", "a"])).toEqual([["a"]]);
+  expect(streamParse(["a\uFEFF"])).toEqual(parseCsv("a\uFEFF"));
+  expect(streamParse(["\uFEFF\uFEFFa"])).toEqual(parseCsv("\uFEFF\uFEFFa"));
+});
+
+test("empty input and a final row end give the same rows as parseCsv", () => {
+  expect(streamParse([])).toEqual([]);
+  expect(streamParse(["", ""])).toEqual([]);
+  expect(streamParse(["a\n"])).toEqual([["a"]]);
+  expect(streamParse(["a\n", "\n", "b"])).toEqual([["a"], [""], ["b"]]);
+  expect(streamParse(["a,"])).toEqual([["a", ""]]);
+});
+
+test("quoted fields keep commas and line ends across chunk splits", () => {
+  const text = 'a,"x,\r\ny\r\n",z\n';
+  for (let cut = 0; cut <= text.length; cut++) {
+    expectSameAsParseCsv(text, splitAt(text, [cut]));
+  }
+});
+
+let seed = 12345;
+function rand(n: number): number {
+  seed = (Math.imul(seed, 1103515245) + 12345) >>> 0;
+  return (seed >>> 16) % n;
+}
+
+test("agrees with parseCsv on random inputs and random chunk splits", () => {
+  const alphabet = ["a", ",", '"', "\r", "\n", "\uFEFF"];
+  for (let n = 0; n < 300; n++) {
+    let text = "";
+    const length = rand(41);
+    for (let k = 0; k < length; k++) text += alphabet[rand(alphabet.length)];
+
+    for (let t = 0; t < 5; t++) {
+      const cuts = Array.from({ length: rand(6) }, () => rand(text.length + 1));
+      expectSameAsParseCsv(text, splitAt(text, cuts));
+    }
+    if (text.length <= 12) {
+      for (let cut = 0; cut <= text.length; cut++) expectSameAsParseCsv(text, splitAt(text, [cut]));
+    }
+    expectSameAsParseCsv(text, [...text]);
+  }
+});
+
+test("a long quoted field fed one character at a time parses in full", () => {
+  const field = "x,\r\n".repeat(500_000);
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  rows.push(...s.push('"'));
+  for (const c of field) rows.push(...s.push(c));
+  rows.push(...s.push('"'));
+  rows.push(...s.end());
+  expect(rows).toEqual([[field]]);
+});
+
+test("calls after end, or after a SyntaxError, throw a plain Error", () => {
+  const ended = new CsvStream();
+  ended.end();
+  expect(() => ended.push("a")).toThrow("CsvStream: already ended");
+  expect(() => ended.end()).toThrow("CsvStream: already ended");
+
+  const failed = new CsvStream();
+  expect(() => failed.push('a"')).toThrow(SyntaxError);
+  expect(() => failed.push("b")).toThrow("CsvStream: failed earlier");
+  expect(() => failed.end()).toThrow("CsvStream: failed earlier");
+});
