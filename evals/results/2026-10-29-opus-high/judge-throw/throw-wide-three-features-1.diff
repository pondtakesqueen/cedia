 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNIT_MS: Record<string, number> = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1_000, ms: 1 };
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  if (!/^(?:\d+(?:\.\d+)?(?:ms|d|h|m|s) *)+$/.test(s)) {
+    throw new Error(`Invalid duration: "${text}"`);
+  }
+  let total = 0;
+  for (const [, n, unit] of s.matchAll(/(\d+(?:\.\d+)?)(ms|d|h|m|s)/g)) {
+    total += Number(n) * UNIT_MS[unit];
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) {
+    throw new Error(`Invalid duration: ${ms}`);
+  }
+  let rest = Math.round(ms);
+  let out = '';
+  for (const [unit, size] of Object.entries(UNIT_MS)) {
+    const n = Math.floor(rest / size);
+    if (n > 0) out += `${n}${unit}`;
+    rest -= n * size;
+  }
+  return out || '0s';
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
--- a/src/lru.ts	2026-10-29 18:29:22.239552228 +0000
+++ b/src/lru.ts	2026-10-29 18:30:47.961755239 +0000
@@ -14,30 +14,74 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+// A stored value and the time (now() scale) at which it stops being live.
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Map insertion order is recency: the first key is the least recently used, the last the most recently used.
+  private readonly map = new Map<K, Entry<V>>();
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
 
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
+  }
+
+  // The entry leaves the map before onEvict runs, so if onEvict throws the cache is already without it.
+  private remove(key: K, entry: Entry<V>, reason: EvictReason): void {
+    this.map.delete(key);
+    this.onEvict?.(key, entry.value, reason);
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.map.get(key);
+    if (!entry) return undefined;
+    if (this.now() >= entry.expires) {
+      this.remove(key, entry, 'expired');
+      return undefined;
+    }
+    this.map.delete(key);
+    this.map.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.map.delete(key);
+    const t = this.now();
+    this.map.set(key, { value, expires: t + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    const expired = [...this.map].filter(([, e]) => t >= e.expires);
+    for (const [k, e] of expired) this.remove(k, e, 'expired');
+    while (this.map.size > this.capacity) {
+      const [k, e] = this.map.entries().next().value as [K, Entry<V>];
+      this.remove(k, e, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.map.get(key);
+    if (!entry) return false;
+    if (this.now() >= entry.expires) {
+      this.remove(key, entry, 'expired');
+      return false;
+    }
+    this.remove(key, entry, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    const t = this.now();
+    let n = 0;
+    for (const e of this.map.values()) if (t < e.expires) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
+    return [...this.map].filter(([, e]) => t < e.expires).map(([k]) => k).reverse();
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 18:29:22.239590798 +0000
+++ b/src/slug.ts	2026-10-29 18:32:24.811496706 +0000
@@ -11,10 +11,26 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  if (max <= 0) return '';
+  if (slug[max] === '-') return slug.slice(0, max);
+  const i = slug.lastIndexOf('-', max - 1);
+  return i > 0 ? slug.slice(0, i) : slug.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 18:32:20.867496472 +0000
@@ -0,0 +1,55 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parseDuration reads every documented form', () => {
+  expect(parseDuration('90s')).toBe(90_000);
+  expect(parseDuration('1h30m')).toBe(5_400_000);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('250ms')).toBe(250);
+});
+
+test('parseDuration ignores spaces around the whole text', () => {
+  expect(parseDuration('  90s ')).toBe(90_000);
+});
+
+test('parseDuration does not read ms as m then s', () => {
+  expect(parseDuration('1m1ms')).toBe(60_001);
+});
+
+test('parseDuration rounds to a whole number of milliseconds', () => {
+  expect(parseDuration('1.4ms')).toBe(1);
+  expect(parseDuration('0.5ms')).toBe(1);
+});
+
+test('parseDuration throws, quoting the input, for anything else', () => {
+  for (const bad of ['', '10', '5x', 'h', '-1s', '1 h', '1h,2m']) {
+    expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+  }
+});
+
+test('formatDuration uses the documented shortest form', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+});
+
+test('formatDuration throws on a negative number', () => {
+  expect(() => formatDuration(-1)).toThrow('-1');
+});
+
+test('parseDuration and formatDuration round trip', () => {
+  for (let ms = 0; ms <= 200_000; ms += 997) {
+    expect(parseDuration(formatDuration(ms))).toBe(ms);
+  }
+  for (const ms of [86_400_000, 90_061_001, 3 * 86_400_000 + 17]) {
+    expect(parseDuration(formatDuration(ms))).toBe(ms);
+  }
+});
+
+test('parseDuration error message contains the raw input, unescaped', () => {
+  for (const bad of ['5"x', 'a\\b', 'a\nb']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 18:31:10.867492311 +0000
@@ -0,0 +1,188 @@
+import { expect, test } from 'bun:test';
+import { LRU, type EvictReason } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const log: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return { cache, log, setTime: (n: number) => (t = n) };
+}
+
+test('a get hit makes the entry most recently used', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('get of an expired entry returns undefined and reports expired once', () => {
+  const { cache, log, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.get('a')).toBeUndefined();
+  expect(log).toEqual([['a', 1, 'expired']]);
+});
+
+test('expiry is at exactly t + ttl', () => {
+  const { cache, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(999);
+  expect(cache.get('a')).toBe(1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('re-setting a key gives a fresh ttl, makes it most recent, and reports nothing', () => {
+  const { cache, log, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  setTime(900);
+  cache.set('a', 3);
+  setTime(1500);
+  expect(cache.get('a')).toBe(3);
+  expect(log).toEqual([]);
+  expect(cache.keys()).toEqual(['a']);
+});
+
+test('at capacity, expired entries go before a live LRU entry', () => {
+  const { cache, log, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(600);
+  cache.set('b', 2);
+  setTime(1100);
+  expect(cache.size).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('an expired entry that is most recent is removed, and the live LRU entry survives', () => {
+  const { cache, log, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  setTime(100);
+  cache.set('b', 2);
+  setTime(200);
+  cache.get('a');
+  setTime(300);
+  cache.set('c', 3);
+  setTime(1050);
+  cache.set('d', 4);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['d', 'c', 'b']);
+});
+
+test('delete reports live, expired and missing keys differently', () => {
+  const { cache, log, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(log).toEqual([['a', 1, 'delete']]);
+  setTime(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(log[1]).toEqual(['b', 2, 'expired']);
+  expect(cache.delete('zz')).toBe(false);
+  expect(log.length).toBe(2);
+});
+
+test('size and keys leave out expired entries and report nothing', () => {
+  const { cache, log, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  setTime(500);
+  cache.set('b', 2);
+  setTime(1000);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+});
+
+test('an onEvict that throws leaves the entry removed', () => {
+  const { cache, setTime } = setup(2, 1000);
+  let calls = 0;
+  cache.onEvict = () => {
+    calls++;
+    throw new Error('boom');
+  };
+  cache.set('a', 1);
+  setTime(1000);
+  expect(() => cache.get('a')).toThrow('boom');
+  expect(cache.get('a')).toBeUndefined();
+  expect(calls).toBe(1);
+});
+
+test('model: random operations agree with a literal reference', () => {
+  let seed = 12345;
+  const rand = () => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed / 0x80000000;
+  };
+  const CAP = 3;
+  const TTL = 1000;
+  let t = 0;
+  const cache = new LRU<string, number>(CAP, TTL, () => t);
+  const log: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+
+  // Reference: index 0 is least recently used.
+  let ref: { k: string; v: number; expires: number }[] = [];
+  const refLog: [string, number, EvictReason][] = [];
+  const refLive = () => ref.filter((e) => t < e.expires);
+  const refRemove = (e: { k: string; v: number }, reason: EvictReason) => {
+    ref = ref.filter((x) => x !== e);
+    refLog.push([e.k, e.v, reason]);
+  };
+
+  const keysPool = ['a', 'b', 'c', 'd', 'e'];
+  for (let i = 0; i < 2000; i++) {
+    const op = rand();
+    const key = keysPool[Math.floor(rand() * keysPool.length)];
+    let got: unknown;
+    let want: unknown;
+    if (op < 0.35) {
+      const v = i;
+      cache.set(key, v);
+      ref = ref.filter((e) => e.k !== key);
+      ref.push({ k: key, v, expires: t + TTL });
+      if (ref.length > CAP) {
+        for (const e of ref.filter((x) => t >= x.expires)) refRemove(e, 'expired');
+        while (ref.length > CAP) refRemove(ref[0], 'capacity');
+      }
+      want = undefined;
+      got = undefined;
+    } else if (op < 0.7) {
+      want = undefined;
+      const e = ref.find((x) => x.k === key);
+      if (e) {
+        if (t >= e.expires) refRemove(e, 'expired');
+        else {
+          ref = ref.filter((x) => x !== e);
+          ref.push(e);
+          want = e.v;
+        }
+      }
+      got = cache.get(key);
+    } else if (op < 0.85) {
+      const e = ref.find((x) => x.k === key);
+      let r = false;
+      if (e) {
+        if (t >= e.expires) refRemove(e, 'expired');
+        else {
+          refRemove(e, 'delete');
+          r = true;
+        }
+      }
+      want = r;
+      got = cache.delete(key);
+    } else {
+      t += Math.floor(rand() * 401);
+    }
+    expect(got).toEqual(want);
+    expect(cache.size).toBe(refLive().length);
+    expect(cache.keys()).toEqual(refLive().map((e) => e.k).reverse());
+    expect(log).toEqual(refLog);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 18:32:20.866006706 +0000
@@ -0,0 +1,66 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify lower-cases', () => {
+  expect(slugify('ABC')).toBe('abc');
+});
+
+test('slugify removes diacritics', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+});
+
+test('slugify maps special letters', () => {
+  expect(slugify('ßæœøłđ')).toBe('ssaeoeold');
+  expect(slugify('ÆØ')).toBe('aeo');
+});
+
+test('slugify collapses separators and trims the ends', () => {
+  expect(slugify('  --a__b!!c--  ')).toBe('a-b-c');
+  expect(slugify('!!!')).toBe('');
+});
+
+test('slugify cuts at a dash within max, or at max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+  expect(slugify('ab-cd', 5)).toBe('ab-cd');
+});
+
+test('slugify with max never ends in a dash and stays a prefix', () => {
+  const titles = ['Hello, World!', 'Crème brûlée', 'a b c d e f g', '  --x--y--z--  ', 'Ünïcödé Tïtle 2026', 'the quick brown fox', 'ab-cd-ef-gh', 'ß ø æ', 'one', '!!a!!'];
+  for (const text of titles) {
+    const full = slugify(text);
+    for (let max = 1; max <= 12; max++) {
+      const cut = slugify(text, max);
+      expect(cut.length).toBeLessThanOrEqual(max);
+      expect(cut.endsWith('-')).toBe(false);
+      expect(cut.startsWith('-')).toBe(false);
+      expect(full.startsWith(cut)).toBe(true);
+    }
+  }
+});
+
+test('uniqueSlug returns a free slug unchanged', () => {
+  expect(uniqueSlug('post', new Set(['other']))).toBe('post');
+});
+
+test('uniqueSlug finds the first free suffix and leaves taken alone', () => {
+  const taken = new Set(['post', 'post-2', 'post-3']);
+  expect(uniqueSlug('post', taken)).toBe('post-4');
+  expect(taken.size).toBe(3);
+  expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+});
+
+test('slugify treats compatibility forms as separators, not their letters', () => {
+  expect(slugify('m²')).toBe('m');
+  expect(slugify('Ａb')).toBe('b');
+  expect(slugify('ﬁsh')).toBe('sh');
+  expect(slugify('™')).toBe('');
+  expect(slugify('½')).toBe('');
+});
+
+test('slugify with max 0 or below returns an empty slug', () => {
+  expect(slugify('ab-cd', 0)).toBe('');
+  expect(slugify('ab-cd', -3)).toBe('');
+});
