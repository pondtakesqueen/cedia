diff -ruN '--exclude=node_modules' '--exclude=.git' a/ledger.extra.test.ts b/ledger.extra.test.ts
--- a/ledger.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.extra.test.ts	2026-10-29 18:13:09.637986518 +0000
@@ -0,0 +1,56 @@
+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+
+describe('matchCheck extra', () => {
+  test('a semicolon chain does not match; a quoted cd to cwd does', () => {
+    expect(matchCheck('bun test; echo', ['bun test'])).toBeUndefined();
+    expect(matchCheck("cd '/work/repo' && bun test", ['bun test'], cwd)).toBe('bun test');
+  });
+});
+
+describe('ledgerEntries extra', () => {
+  test('a cd to cwd prefix still records the declared check', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'a', tool: 'bash', input: { command: 'cd /work/repo && bun test' } },
+      { kind: 'tool_result', callId: 'a', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    expect(ledgerEntries(events, ['bun test'], cwd)).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+  });
+
+  test('a snapshot placed before its result still applies', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'a', tool: 'bash', input: { command: 'gen' } },
+      { kind: 'snapshot', callId: 'a', changed: ['out.ts'] },
+      { kind: 'tool_result', callId: 'a', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'bash', path: 'out.ts' }]);
+  });
+
+  test('a failed non-read-only bash still counts as a write', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'a', tool: 'bash', input: { command: 'npm i' } },
+      { kind: 'tool_result', callId: 'a', status: 'failed', output: { isError: true, exitCode: 2 } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'npm i' }]);
+  });
+});
+
+describe('evidence and verified extra', () => {
+  test('verified agrees with evidence on random logs', () => {
+    let seed = 42;
+    const rand = (k: number) => {
+      seed = (seed * 1103515245 + 12345) % 2147483648;
+      return seed % k;
+    };
+    for (let round = 0; round < 200; round++) {
+      const size = rand(12) + 1;
+      const entries: LedgerEntry[] = [];
+      for (let i = 0; i < size; i++) {
+        entries.push(rand(2) === 0 ? { kind: 'write', at: i, tool: 'edit', path: `f${rand(3)}.ts` } : { kind: 'check', at: i, command: 'x', exitCode: rand(2) });
+      }
+      expect(verified(entries, ['x'])).toBe(evidence(entries).unverified.length === 0);
+    }
+  });
+});
