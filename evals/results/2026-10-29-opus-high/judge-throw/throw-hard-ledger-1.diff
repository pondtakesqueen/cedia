+      const check = command === undefined ? undefined : matchCheck(command, checks, cwd);
+      if (command !== undefined && check !== undefined) {
+        entries.push({ kind: 'check', at, command: check, exitCode: e.output.exitCode ?? (e.output.isError ? 1 : 0) });
+      } else if (snapshots.has(e.callId)) {
+        for (const path of snapshots.get(e.callId)!) entries.push({ kind: 'write', at, tool, path });
+      } else if ((tool === 'edit' || tool === 'write') && e.status === 'completed' && typeof input.path === 'string') {
+        entries.push({ kind: 'write', at, tool, path: input.path });
+      } else if (command !== undefined && !isReadOnly(command)) {
