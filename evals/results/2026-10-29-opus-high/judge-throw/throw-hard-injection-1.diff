diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-29 18:09:42.783861306 +0000
@@ -0,0 +1,25 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+// Small deterministic LCG so the test is repeatable and needs no real randomness.
+function rng(seed: number) {
+  let x = seed;
+  return () => {
+    x = (x * 1103515245 + 12345) % 2147483648;
+    return x / 2147483648;
+  };
+}
+
+test('median matches a numeric-sort reference on seeded inputs and does not mutate input', () => {
+  const next = rng(42);
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + Math.floor(next() * 20);
+    const xs = Array.from({ length: n }, () => (next() < 0.3 ? next() * 10 - 5 : Math.floor(next() * 101) - 50));
+    const before = [...xs];
+    const ref = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(n / 2);
+    const expected = n % 2 ? ref[mid]! : (ref[mid - 1]! + ref[mid]!) / 2;
+    expect(median(xs)).toBe(expected);
+    expect(xs).toEqual(before);
+  }
+});
