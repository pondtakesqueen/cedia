diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.prop.test.ts b/median.prop.test.ts
--- a/median.prop.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.prop.test.ts	2026-10-29 18:10:44.806821985 +0000
@@ -0,0 +1,25 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+// Seeded LCG so the cases are the same on every run.
+let seed = 12345;
+function rand(): number {
+  seed = (seed * 1103515245 + 12345) % 2147483648;
+  return seed / 2147483648;
+}
+
+function reference(xs: number[]): number {
+  const s = [...xs].sort((a, b) => a - b);
+  const mid = Math.floor(s.length / 2);
+  return s.length % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+}
+
+test('median matches a numeric-sort reference and leaves the input alone', () => {
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + Math.floor(rand() * 20);
+    const xs = Array.from({ length: n }, () => Math.floor(rand() * 2001) - 1000);
+    const before = [...xs];
+    expect(median(xs)).toBe(reference(xs));
+    expect(xs).toEqual(before);
+  }
+});
