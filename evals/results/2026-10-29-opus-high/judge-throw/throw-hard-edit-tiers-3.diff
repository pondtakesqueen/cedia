diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-29 18:10:44.311419401 +0000
@@ -0,0 +1,116 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+const err = (r: ReturnType<typeof applyEdit>) => {
+  if (!('error' in r)) throw new Error('expected an error');
+  return r.error;
+};
+
+describe('guards', () => {
+  test('empty old_text is an error, not a throw', () => {
+    expect(err(applyEdit('a\n', { old_text: '', new_text: 'x' }))).toContain('use write');
+  });
+  test('old_text equal to new_text is an error even when absent', () => {
+    expect(err(applyEdit('a\n', { old_text: 'zzz', new_text: 'zzz' }))).toContain('same');
+  });
+  test('not found does not change the input', () => {
+    const src = 'a\nb\n';
+    expect(err(applyEdit(src, { old_text: 'nothing', new_text: 'x' }))).toContain('not found');
+    expect(src).toBe('a\nb\n');
+  });
+  test('not found lists at most 5 lines where the first line appears', () => {
+    const src = 'foo 1\nfoo 2\nfoo 3\nfoo 4\nfoo 5\nfoo 6\nfoo 7\n';
+    const e = err(applyEdit(src, { old_text: 'foo\nbar', new_text: 'x' }));
+    expect(e).toContain('line 1, 2, 3, 4, 5');
+    expect(e).not.toContain('6');
+  });
+});
+
+describe('tier order', () => {
+  test('exact wins over trailing-space', () => {
+    const r = ok(applyEdit('a\na \n', { old_text: 'a ', new_text: 'b' }));
+    expect(r.applied.tier).toBe('exact');
+    expect(r.content).toBe('a\nb\n');
+  });
+  test('exact ambiguity names the count and the first line', () => {
+    const e = err(applyEdit('q\nx\nx\n', { old_text: 'x', new_text: 'y' }));
+    expect(e).toContain('matches 2 places');
+    expect(e).toContain('line 2');
+  });
+  test('replace_all with three matches reports the first line', () => {
+    const r = ok(applyEdit('q\nx\nq\nx\nx\n', { old_text: 'x', new_text: 'y', replace_all: true }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 3 });
+    expect(r.content).toBe('q\ny\nq\ny\ny\n');
+  });
+  test('replace_all does not turn a trailing-space match into exact', () => {
+    const r = ok(applyEdit('a \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }));
+    expect(r.applied.tier).toBe('trailing-space');
+    expect(r.content).toBe('c\n');
+  });
+  test('trailing-space ambiguity is an error and does not fall to indentation', () => {
+    const e = err(applyEdit('a \nb\na \nb\n', { old_text: 'a\nb', new_text: 'c' }));
+    expect(e).toContain('matches 2 places');
+    expect(e).toContain('1, 3');
+  });
+  test('indentation ambiguity reports the lines', () => {
+    const e = err(applyEdit('  a\n  b\n    a\n  b\n', { old_text: 'a\nb', new_text: 'c' }));
+    expect(e).toContain('matches 2 places');
+    expect(e).toContain('1, 3');
+  });
+});
+
+describe('trailing newline handling', () => {
+  test('content without a final newline gets none added', () => {
+    const r = ok(applyEdit('a  \nb', { old_text: 'a\nb', new_text: 'c' }));
+    expect(r.content).toBe('c');
+  });
+  test('deleting the only line leaves an empty file', () => {
+    const r = ok(applyEdit('  a\n  b\n', { old_text: 'a\nb', new_text: '' }));
+    expect(r.content).toBe('');
+  });
+});
+
+describe('review fixes', () => {
+  test('overlapping exact matches are counted, so the edit is ambiguous', () => {
+    expect(err(applyEdit('aaa\n', { old_text: 'aa', new_text: 'b' }))).toContain('matches 2 places');
+  });
+  test('replace_all refuses overlapping exact matches', () => {
+    expect(err(applyEdit('aaa\n', { old_text: 'aa', new_text: 'b', replace_all: true }))).toContain('overlaps itself');
+  });
+  test('replace_all with several trailing-space matches is an error', () => {
+    expect(err(applyEdit('a \nb\na \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }))).toContain('matches 2 places');
+  });
+  test('indentation: a new_text line not under the old indent is an error', () => {
+    const e = err(applyEdit('        a\n        b\n', { old_text: '    a\n    b', new_text: '    a\n  b' }));
+    expect(e).toContain('new_text line 2');
+  });
+  test('exact tier with a trailing newline in old_text reports its lines', () => {
+    const r = ok(applyEdit('x\na\nb\ny\n', { old_text: 'a\nb\n', new_text: 'c\n' }));
+    expect(r.applied).toEqual({ from: 2, to: 3, tier: 'exact', count: 1 });
+    expect(r.content).toBe('x\nc\ny\n');
+  });
+});
+
+describe('tiers agree', () => {
+  test('every window matches on plain and padded copies of a file', () => {
+    for (let n = 1; n <= 4; n++) {
+      const lines = Array.from({ length: n }, (_, i) => `row${i};`);
+      const plain = lines.join('\n') + '\n';
+      const padded = lines.map(l => l + '  ').join('\n') + '\n';
+      for (let i = 0; i < n; i++) {
+        for (let j = i + 1; j <= n; j++) {
+          const old = lines.slice(i, j).join('\n');
+          const a = ok(applyEdit(plain, { old_text: old, new_text: 'X' }));
+          expect(a.applied.tier).toBe('exact');
+          const b = ok(applyEdit(padded, { old_text: old, new_text: 'X' }));
+          const strip = (s: string) => s.split('\n').map(l => l.trimEnd()).join('\n');
+          expect(strip(b.content)).toBe(strip(a.content));
+        }
+      }
+    }
+  });
+});
