 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text, replace_all } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to replace the whole file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  // 1. exact
+  const first = content.indexOf(old_text);
+  if (first !== -1) {
+    const starts: number[] = [];
+    for (let i = first; i !== -1; i = content.indexOf(old_text, i + 1)) starts.push(i);
+    if (starts.length > 1 && !replace_all) {
+      return { error: `old_text matches ${starts.length} places (first at line ${lineOf(content, first)}); add context or set replace_all` };
+    }
+    if (replace_all && starts.some((s, k) => k > 0 && s - starts[k - 1] < old_text.length)) {
+      return { error: `old_text overlaps itself (first at line ${lineOf(content, first)}); replace_all cannot replace every occurrence` };
+    }
+    const from = lineOf(content, first);
+    const to = from + old_text.split('\n').length - 1 - (old_text.endsWith('\n') ? 1 : 0);
+    const updated = replace_all
+      ? content.split(old_text).join(new_text)
+      : content.slice(0, first) + new_text + content.slice(first + old_text.length);
+    return { content: updated, applied: { from, to, tier: 'exact', count: starts.length } };
+  }
+
+  // Line tiers work on the lines of content, without the empty piece after a final newline.
+  const trailingNewline = content.endsWith('\n');
+  const lines = trailingNewline ? content.slice(0, -1).split('\n') : content.split('\n');
