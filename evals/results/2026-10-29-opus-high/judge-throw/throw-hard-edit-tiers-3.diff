 // from/to are 1-based line numbers of the replaced text in the original content; count is how many places were replaced.
 export type Applied = { from: number; to: number; tier: Tier; count: number };
 
+// 1-based line number of the character at `index`.
+function lineOf(content: string, index: number): number {
+  return content.slice(0, index).split('\n').length;
+}
+
+// Lines of a text without one trailing newline; empty text has no lines.
+function toLines(text: string): string[] {
+  if (text === '') return [];
+  return (text.endsWith('\n') ? text.slice(0, -1) : text).split('\n');
+}
+
+// 0-based starts of the windows of `lines` equal to `oldLines` line by line under `norm`.
+function findWindows(lines: string[], oldLines: string[], norm: (s: string) => string): number[] {
+  const starts: number[] = [];
+  for (let i = 0; i + oldLines.length <= lines.length; i++) {
+    if (oldLines.every((l, k) => norm(lines[i + k]) === norm(l))) starts.push(i);
+  }
+  return starts;
+}
+
+// Leading whitespace of a line.
+function indentOf(line: string): string {
+  return line.match(/^\s*/)![0];
+}
+
 // Applies one edit to `content`.
 //
 // Tiers, tried in order; a tier applies only when it finds exactly one place (or replace_all is set, exact tier only):
