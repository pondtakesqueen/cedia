--- a/csv.ts	2026-10-29 17:55:54.287347243 +0000
+++ b/csv.ts	2026-10-29 17:57:57.571014436 +0000
@@ -50,3 +50,120 @@
   rows.push(row);
   return rows;
 }
+
+/**
+ * Parses CSV as `parseCsv` reads it, from input that arrives in chunks: `push` returns the rows whose row end has
+ * arrived, `end` returns the rest. It keeps only the row and field being read and the state of the last character,
+ * so the work for a chunk does not depend on what came before it. Once a call throws a SyntaxError, every later call
+ * throws the same one.
+ */
+export class CsvStream {
+  private row: string[] = [];
+  private field = "";
+  // start: at a field's first character. unquoted: in an unquoted field. cr: after a `\r` that may start a row end.
+  // quoted: in a quoted field. quote: after a `"` in a quoted field. closed: after a closing quote.
+  // closedCr: after a closing quote and a `\r`.
+  private state: "start" | "unquoted" | "cr" | "quoted" | "quote" | "closed" | "closedCr" = "start";
+  private crAt = 0; // offset of the `\r` in state closedCr
+  private offset = 0; // offset in the whole input of the next chunk's first character
+  private started = false; // a non-empty chunk has been pushed
+  private failure: SyntaxError | undefined;
+  private ended = false;
+
+  push(chunk: string): string[][] {
+    this.check();
+    const rows: string[][] = [];
+    let i = 0;
+    if (!this.started && chunk.length > 0) {
+      this.started = true;
+      if (chunk.startsWith("\uFEFF")) i = 1;
+    }
+    for (; i < chunk.length; i++) this.step(chunk[i]!, this.offset + i, rows);
+    this.offset += chunk.length;
+    return rows;
+  }
+
+  end(): string[][] {
+    this.check();
+    const rows: string[][] = [];
+    if (this.state === "quoted") this.fail("a quoted field is still open at the end of the input");
+    if (this.state === "closedCr") this.fail(`unexpected ${JSON.stringify("\r")} after a closing quote at offset ${this.crAt}`);
+    if (this.state === "cr") this.field += "\r";
+    this.ended = true;
+    if (this.state !== "start" || this.row.length > 0) this.endRow(rows);
+    return rows;
+  }
+
+  private check() {
+    if (this.failure) throw this.failure;
+    if (this.ended) throw new Error("CsvStream has already ended");
+  }
+
+  private fail(message: string): never {
+    this.failure = new SyntaxError(message);
+    throw this.failure;
+  }
+
+  private endField() {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "start";
+  }
+
+  private endRow(rows: string[][]) {
+    this.endField();
+    rows.push(this.row);
+    this.row = [];
+  }
+
+  private step(c: string, at: number, rows: string[][]) {
+    switch (this.state) {
+      case "start":
+      case "unquoted":
+        if (c === '"') {
+          if (this.state === "unquoted") this.fail(`a quote in a field that is not quoted, at offset ${at}`);
+          this.state = "quoted";
+        } else if (c === ",") this.endField();
+        else if (c === "\n") this.endRow(rows);
+        else if (c === "\r") this.state = "cr";
+        else {
+          this.field += c;
+          this.state = "unquoted";
+        }
+        break;
+      case "cr":
+        if (c === "\n") this.endRow(rows);
+        else {
+          this.field += "\r";
+          this.state = "unquoted";
+          this.step(c, at, rows);
+        }
+        break;
+      case "quoted":
+        if (c === '"') this.state = "quote";
+        else this.field += c;
+        break;
+      case "quote":
+        if (c === '"') {
+          this.field += '"';
+          this.state = "quoted";
+        } else {
+          this.state = "closed";
+          this.step(c, at, rows);
+        }
+        break;
+      case "closed":
+        if (c === ",") this.endField();
+        else if (c === "\n") this.endRow(rows);
+        else if (c === "\r") {
+          this.state = "closedCr";
+          this.crAt = at;
+        } else this.fail(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${at}`);
+        break;
+      case "closedCr":
+        if (c === "\n") this.endRow(rows);
+        else this.fail(`unexpected ${JSON.stringify("\r")} after a closing quote at offset ${this.crAt}`);
+        break;
+    }
+  }
+}
