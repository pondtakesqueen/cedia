diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-29 18:06:28.171404175 +0000
@@ -0,0 +1,91 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const errOf = (r: ReturnType<typeof applyEdit>) => ('error' in r ? r.error : '');
+
+describe('rules', () => {
+  test('empty old_text and same text are errors', () => {
+    expect(errOf(applyEdit('a\n', { old_text: '', new_text: 'x' }))).toContain('use write');
+    expect(errOf(applyEdit('a\n', { old_text: 'q', new_text: 'q' }))).toContain('same');
+  });
+
+  test('exact is tried before the looser tiers', () => {
+    expect(errOf(applyEdit('a \na\n', { old_text: 'a', new_text: 'b' }))).toContain('matches 2 places');
+  });
+
+  test('exact ambiguity names the first line', () => {
+    const e = errOf(applyEdit('q\nx\nx\n', { old_text: 'x', new_text: 'y' }));
+    expect(e).toContain('matches 2 places');
+    expect(e).toContain('line 2');
+  });
+
+  test('replace_all does not widen the looser tiers', () => {
+    expect(errOf(applyEdit('a \nb\na  \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }))).toContain('matches 2 places');
+  });
+
+  test('$ in new_text is literal', () => {
+    const r = applyEdit('x\n', { old_text: 'x', new_text: '$&$1' });
+    expect(r).toEqual({ content: '$&$1\n', applied: { from: 1, to: 1, tier: 'exact', count: 1 } });
+  });
+
+  test('no final newline is neither added nor lost', () => {
+    const r = applyEdit('a  \nb', { old_text: 'a\n', new_text: 'A' });
+    expect('content' in r && r.content).toBe('A\nb');
+  });
+
+  test('trailing-space tier keeps new_text lines verbatim', () => {
+    const r = applyEdit('a \nb\n', { old_text: 'a\nb', new_text: '  Z  \nb' });
+    expect('content' in r && r.content).toBe('  Z  \nb\n');
+  });
+
+  test('indentation tier misses when only leading whitespace differs in tier 2', () => {
+    const r = applyEdit(' a  x\n', { old_text: 'a  x \n', new_text: 'b' });
+    expect('content' in r && r.content).toBe(' b\n');
+    expect('applied' in r && r.applied.tier).toBe('indentation');
+  });
+
+  test('lines less indented than old_text are left as given', () => {
+    const r = applyEdit('\tb\n', { old_text: '    b', new_text: '    b\nc' });
+    expect('content' in r && r.content).toBe('\tb\nc\n');
+  });
+
+  test('indentation ambiguity lists the lines', () => {
+    const e = errOf(applyEdit('\ta\nb\n  a\n  b', { old_text: ' a\nb', new_text: 'z' }));
+    expect(e).toContain('2 places');
+    expect(e).toContain('1, 3');
+  });
+
+  test('deleted window reports its lines', () => {
+    const r = applyEdit('a\n  b\n  c\nd\n', { old_text: 'b\nc', new_text: '' });
+    expect('applied' in r && r.applied).toEqual({ from: 2, to: 3, tier: 'indentation', count: 1 });
+  });
+
+  test('not-found pointer lists at most 5 lines', () => {
+    const e = errOf(applyEdit('x1\nx1\nx1\nx1\nx1\nx1\nx1\n', { old_text: 'x1\nnope', new_text: 'z' }));
+    expect(e).toContain('line 1, 2, 3, 4, 5');
+    expect(e).not.toContain(', 6');
+  });
+
+  test('odd inputs return a result or an error and never throw', () => {
+    const texts = ['', '\n', '  ', 'a'];
+    for (const c of texts) for (const o of texts) for (const n of ['', ' ', '\n', 'a']) {
+      const r = applyEdit(c, { old_text: o, new_text: n });
+      expect('content' in r || 'error' in r).toBe(true);
+    }
+  });
+
+  test('replace_all agrees with split/join on exact matches', () => {
+    let seed = 7;
+    const rnd = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
+    const pieces = ['a', 'b', 'a ', '  a', ''];
+    for (let t = 0; t < 200; t++) {
+      const n = 1 + Math.floor(rnd() * 6);
+      const c = Array.from({ length: n }, () => pieces[Math.floor(rnd() * pieces.length)]).join('\n');
+      const old = pieces[Math.floor(rnd() * pieces.length)];
+      if (old === '' || !c.includes(old) || old === 'Z') continue;
+      const r = applyEdit(c, { old_text: old, new_text: 'Z', replace_all: true });
+      expect('content' in r && r.content).toBe(c.split(old).join('Z'));
+      expect('applied' in r && r.applied.count).toBe(c.split(old).length - 1);
+    }
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-29 18:04:41.173901943 +0000
+++ b/edit.ts	2026-10-29 18:06:11.903403208 +0000
@@ -23,5 +23,76 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: nw, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (old === nw) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  const starts: number[] = [];
+  for (let pos = content.indexOf(old); pos !== -1; pos = content.indexOf(old, pos + old.length)) starts.push(pos);
+  if (starts.length > 1 && !replace_all) {
+    return { error: `old_text matches ${starts.length} places (first at line ${lineAt(content, starts[0])}); add context or set replace_all` };
+  }
+  if (starts.length > 0) {
+    return {
+      content: content.split(old).join(nw),
+      applied: { from: lineAt(content, starts[0]), to: lineAt(content, starts[starts.length - 1] + old.length - 1), tier: 'exact', count: starts.length },
+    };
+  }
+
+  const lines = content === '' ? [] : content.replace(/\n$/, '').split('\n');
+  const endsNl = content.endsWith('\n');
+  const oldLines = splitLines(old);
+  const newLines = splitLines(nw);
+  const tiers: { tier: Tier; norm: (s: string) => string }[] = [
+    { tier: 'trailing-space', norm: (s) => s.trimEnd() },
+    { tier: 'indentation', norm: (s) => s.trim() },
+  ];
+  for (const { tier, norm } of tiers) {
+    if (oldLines.length === 0) break;
+    const hits = findWindows(lines, oldLines, norm);
+    if (hits.length === 0) continue;
+    if (hits.length > 1) return { error: `old_text matches ${hits.length} places at lines ${hits.map((i) => i + 1).join(', ')}` };
+    const i = hits[0];
+    const repl = tier === 'indentation' ? reindent(newLines, oldLines, lines.slice(i, i + oldLines.length)) : newLines;
+    const out = [...lines.slice(0, i), ...repl, ...lines.slice(i + oldLines.length)];
+    return {
+      content: out.join('\n') + (endsNl && out.length > 0 ? '\n' : ''),
+      applied: { from: i + 1, to: i + oldLines.length, tier, count: 1 },
+    };
+  }
+
+  let error = 'old_text not found';
+  const first = oldLines.find((l) => l.trim() !== '')?.trim();
+  if (first) {
+    const at = lines.flatMap((l, i) => (l.includes(first) ? [i + 1] : [])).slice(0, 5);
+    if (at.length > 0) error += `; first line appears at line ${at.join(', ')}`;
+  }
+  return { error };
+}
+
+// Splits edit text into lines, ignoring one trailing newline; empty text has no lines.
+function splitLines(s: string): string[] {
+  const t = s.endsWith('\n') ? s.slice(0, -1) : s;
+  return t === '' ? [] : t.split('\n');
+}
+
+// 1-based line number of the character at idx in content.
+function lineAt(content: string, idx: number): number {
+  return content.slice(0, idx).split('\n').length;
+}
+
+// 0-based start indices of the windows of lines that equal oldLines once both sides go through norm.
+function findWindows(lines: string[], oldLines: string[], norm: (s: string) => string): number[] {
+  const hits: number[] = [];
+  for (let i = 0; i + oldLines.length <= lines.length; i++) {
+    if (oldLines.every((o, k) => norm(lines[i + k]) === norm(o))) hits.push(i);
+  }
+  return hits;
+}
+
+// Moves newLines from old_text's indentation to the matched window's indentation; blank lines and lines not under old_text's indentation stay as they are.
+function reindent(newLines: string[], oldLines: string[], window: string[]): string[] {
+  const oi = (oldLines.find((l) => l.trim() !== '') ?? '').match(/^\s*/)![0];
+  const fi = (window.find((l) => l.trim() !== '') ?? '').match(/^\s*/)![0];
+  return newLines.map((l) => (l.trim() === '' || !l.startsWith(oi) ? l : fi + l.slice(oi.length)));
 }
