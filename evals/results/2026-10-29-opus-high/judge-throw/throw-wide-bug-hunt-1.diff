diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 18:27:36.451479565 +0000
@@ -0,0 +1,122 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { percentOf } from '../src/money/round.ts';
+import { REGIONS, region } from '../src/pricing/regions.ts';
+import { shippingFor } from '../src/pricing/shipping.ts';
+
+// Expected values worked by hand from the rules in README.md.
+// Prices: MUG 450, TEE 1500, CAP 1200, PEN 120, BAG 2200.
+describe('pricing rules', () => {
+  test('rule 1: a line subtotal is unit price times quantity', () => {
+    expect(totals(cart('US', [['TEE', 2]])).lines[0]).toMatchObject({ subtotal: 3000, discount: 0, total: 3000 });
+  });
+
+  test('rule 2: bulk discount starts at exactly 10 units and 50 units', () => {
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]).toMatchObject({ subtotal: 1080, discount: 0 });
+    expect(totals(cart('US', [['PEN', 10]])).lines[0]).toMatchObject({ subtotal: 1200, discount: 60 });
+    expect(totals(cart('US', [['PEN', 49]])).lines[0]).toMatchObject({ subtotal: 5880, discount: 294 });
+    // 50 units gets the 10% tier only, not 10% plus 5%
+    expect(totals(cart('US', [['PEN', 50]])).lines[0]).toMatchObject({ subtotal: 6000, discount: 600 });
+  });
+
+  test('rule 2: units of one SKU are merged before the tier is chosen', () => {
+    const c = cart('US', [['PEN', 5], ['PEN', 5]]);
+    const t = totals(c);
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ quantity: 10, discount: 60 });
+    // the caller's cart is not changed
+    expect(c.lines).toEqual([
+      { sku: 'PEN', quantity: 5, unitPrice: 120 },
+      { sku: 'PEN', quantity: 5, unitPrice: 120 },
+    ]);
+  });
+
+  test('rule 3: the coupon applies after bulk discounts', () => {
+    // 10 pens = 1200 - 60 = 1140; SAVE10 takes 114
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10'))).toMatchObject({ subtotal: 1140, coupon: 114 });
+  });
+
+  test('rule 3: FLAT5 takes 500 cents off but never below zero', () => {
+    // discounted is 0; shipping 800 is charged; tax 7% of 800 = 56
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ subtotal: 120, coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('rule 3: an unknown coupon code gives no discount', () => {
+    expect(totals(cart('US', [['PEN', 1]], 'NOPE'))).toMatchObject({ coupon: 0 });
+  });
+
+  test('rule 4: shipping is decided on the discounted subtotal', () => {
+    // subtotal 5000, FLAT5 leaves 4500, which is under 5000, so shipping is charged
+    // tax 7% of 5300 = 371; total 4500 + 800 + 371
+    expect(totals(cart('US', [['BAG', 2], ['PEN', 5]], 'FLAT5'))).toMatchObject({
+      subtotal: 5000,
+      coupon: 500,
+      shipping: 800,
+      tax: 371,
+      total: 5671,
+    });
+  });
+
+  test('rule 4: shipping is free at exactly the threshold', () => {
+    // 4 TEE = 6000 >= 6000 in EU
+    expect(totals(cart('EU', [['TEE', 4]]))).toMatchObject({ subtotal: 6000, shipping: 0, tax: 1200, total: 7200 });
+  });
+
+  test('region table: UK free shipping starts at 4000', () => {
+    // 3940 is under 4000: shipping 700; tax 20% of 4640 = 928; total 5568
+    expect(totals(cart('UK', [['BAG', 1], ['TEE', 1], ['PEN', 2]]))).toMatchObject({ subtotal: 3940, shipping: 700, tax: 928, total: 5568 });
+    // 4400 >= 4000: free shipping; tax 880; total 5280
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+
+  test('region table: each region has the values from the README table', () => {
+    expect(region('US')).toMatchObject({ taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+    expect(region('EU')).toMatchObject({ taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+    expect(region('UK')).toMatchObject({ taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+
+  test('region table: shipping flips exactly at each threshold', () => {
+    for (const r of Object.values(REGIONS)) {
+      expect(shippingFor(r, r.freeShippingFrom - 1)).toBe(r.shipping);
+      expect(shippingFor(r, r.freeShippingFrom)).toBe(0);
+    }
+  });
+
+  test('rule 5: tax rounds half up to the cent', () => {
+    // 150 * 7% = 10.5 -> 11
+    expect(percentOf(150, 0.07)).toBe(11);
+  });
+
+  test('rule 5: percentOf agrees with an integer reference on every amount in range', () => {
+    for (const rate of [0.05, 0.07, 0.1, 0.2]) {
+      const bp = Math.round(rate * 10000);
+      for (let a = 0; a <= 20000; a++) {
+        expect(percentOf(a, rate)).toBe(Math.floor((a * bp + 5000) / 10000));
+      }
+    }
+  });
+
+  test('rule 6: total is discounted subtotal + shipping + tax', () => {
+    const carts = [
+      cart('US', [['MUG', 2]]),
+      cart('EU', [['CAP', 7], ['PEN', 13]], 'SAVE10'),
+      cart('UK', [['BAG', 3]], 'FLAT5'),
+    ];
+    for (const c of carts) {
+      const t = totals(c);
+      expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+    }
+  });
+
+  test('merging: split lines of one SKU price the same as one line', () => {
+    const single = totals(cart('US', [['PEN', 10]]));
+    for (const split of [[10], [1, 9], [5, 5], [3, 3, 4]]) {
+      expect(totals(cart('US', split.map((q) => ['PEN', q] as [string, number])))).toEqual(single);
+    }
+    const bulk = totals(cart('US', [['PEN', 50]]));
+    for (const split of [[25, 25], [49, 1]]) {
+      expect(totals(cart('US', split.map((q) => ['PEN', q] as [string, number])))).toEqual(bulk);
+    }
+  });
+});
