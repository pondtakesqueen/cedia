 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNIT_MS = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1_000, ms: 1 } as const;
+
+// "ms" comes before "m" and "s" so that "1ms" is not read as "1m" followed by "s".
+const PART = /(\d+(?:\.\d+)?)(ms|d|h|m|s) */y;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  if (s === '') throw new Error(`invalid duration: "${text}"`);
+  let total = 0;
+  let pos = 0;
+  PART.lastIndex = 0;
+  while (pos < s.length) {
+    const match = PART.exec(s);
+    if (match === null) throw new Error(`invalid duration: "${text}"`);
+    total += parseFloat(match[1]) * UNIT_MS[match[2] as keyof typeof UNIT_MS];
+    pos = PART.lastIndex;
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const [name, unit] of Object.entries(UNIT_MS)) {
+    const q = Math.floor(rest / unit);
+    if (q > 0) out += `${q}${name}`;
+    rest %= unit;
+  }
+  return out;
 }
