 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 18:34:18.334969176 +0000
@@ -0,0 +1,69 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+function rng(seed: number): () => number {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test('parse: several parts with or without spaces', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('1h 30m')).toBe(5_400_000);
+  expect(parseDuration('1h30m')).toBe(5_400_000);
+  expect(parseDuration('  90s ')).toBe(90_000);
+});
+
+test('parse: every unit, and m / ms are not confused', () => {
+  expect(parseDuration('1d')).toBe(86_400_000);
+  expect(parseDuration('1h')).toBe(3_600_000);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('1s')).toBe(1_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1ms')).toBe(1);
+});
+
+test('parse: fractions and rounding', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('1.5ms')).toBe(2);
+  expect(parseDuration('0.4ms')).toBe(0);
+});
+
+test('parse: bad input throws with the input in the message', () => {
+  for (const bad of ['', '10', '5x', 'h', '-1s', '1h30', '1 h']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
+
+test('parse: the raw input is in the message, even with quotes, backslashes or newlines', () => {
+  for (const bad of ['5"x', 'a\\b', '1\ns']) {
+    expect(() => parseDuration(bad)).toThrow(bad);
+  }
+});
+
+test('format: examples', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(60_000)).toBe('1m');
+  expect(formatDuration(0.4)).toBe('0s');
+});
+
+test('format: rejects negative and non-finite numbers', () => {
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(Number.NaN)).toThrow();
+  expect(() => formatDuration(Number.POSITIVE_INFINITY)).toThrow();
+});
+
+test('format and parse agree on random integers', () => {
+  const next = rng(7);
+  for (let i = 0; i < 2000; i++) {
+    const n = Math.floor(next() * 1e10);
+    const text = formatDuration(n);
+    expect(text).toMatch(/^(\d+d)?(\d+h)?(\d+m)?(\d+s)?(\d+ms)?$/);
+    expect(parseDuration(text)).toBe(n);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 18:34:18.348099237 +0000
@@ -0,0 +1,253 @@
+import { expect, test } from 'bun:test';
+import { LRU, type EvictReason } from '../src/lru.ts';
+
+function rng(seed: number): () => number {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function setup(cap: number, ttl: number) {
+  let t = 0;
+  const events: [string, number, EvictReason][] = [];
+  const cache = new LRU<string, number>(cap, ttl, () => t);
+  cache.onEvict = (k, v, r) => events.push([k, v, r]);
+  return { cache, events, setNow: (n: number) => (t = n) };
+}
+
+test('a get hit makes the entry most recent', () => {
+  const { cache, events } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(events).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('expiry boundary is strict', () => {
+  const { cache, setNow } = setup(2, 1000);
+  cache.set('a', 1);
+  setNow(999);
+  expect(cache.get('a')).toBe(1);
+  setNow(1000);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('an expired get removes the entry with reason expired', () => {
+  const { cache, events, setNow } = setup(2, 1000);
+  cache.set('a', 1);
+  setNow(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual([]);
+});
+
+test('set gives a fresh ttl and overwriting fires no event', () => {
+  const { cache, events, setNow } = setup(2, 1000);
+  cache.set('a', 1);
+  setNow(900);
+  cache.set('a', 2);
+  setNow(1500);
+  expect(cache.get('a')).toBe(2);
+  expect(events).toEqual([]);
+});
+
+test('get does not refresh the ttl', () => {
+  const { cache, setNow } = setup(2, 1000);
+  cache.set('a', 1);
+  setNow(900);
+  expect(cache.get('a')).toBe(1);
+  setNow(1000);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('capacity counts expired entries; they are swept first with reason expired', () => {
+  const { cache, events, setNow } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  setNow(1000);
+  expect(cache.size).toBe(0);
+  expect(events).toEqual([]);
+  cache.set('c', 3);
+  expect(events).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+  ]);
+  expect(cache.keys()).toEqual(['c']);
+});
+
+test('expired sweep keeps live entries when that fits capacity', () => {
+  const { cache, events, setNow } = setup(2, 1000);
+  cache.set('a', 1);
+  setNow(500);
+  cache.set('b', 2);
+  setNow(1000);
+  cache.set('c', 3);
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('expired entries are removed before a live oldest entry', () => {
+  const { cache, events, setNow } = setup(2, 1000);
+  cache.set('old', 1); // expires at 1000
+  setNow(600);
+  cache.set('new', 2); // expires at 1600
+  setNow(1100);
+  cache.set('x', 3);
+  // "old" is expired and "new" is live; the cache fits after the sweep, so nothing live is evicted.
+  expect(events).toEqual([['old', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['x', 'new']);
+});
+
+test('delete: live, expired and missing keys', () => {
+  const { cache, events, setNow } = setup(3, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(events).toEqual([['a', 1, 'delete']]);
+  setNow(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(events[1]).toEqual(['b', 2, 'expired']);
+  events.length = 0;
+  expect(cache.delete('zzz')).toBe(false);
+  expect(events).toEqual([]);
+});
+
+test('size and keys count only live entries and fire no events', () => {
+  const { cache, events, setNow } = setup(3, 1000);
+  cache.set('a', 1);
+  setNow(500);
+  cache.set('b', 2);
+  setNow(1000);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(events).toEqual([]);
+});
+
+test('a throwing onEvict leaves the cache consistent', () => {
+  const { cache, setNow } = setup(1, 1000);
+  cache.onEvict = () => {
+    throw new Error('boom');
+  };
+  cache.set('a', 1);
+  expect(() => cache.set('b', 2)).toThrow('boom');
+  expect(cache.keys()).toEqual(['b']);
+
+  expect(() => cache.set('c', 3)).toThrow('boom'); // "b" is evicted and its callback throws
+  expect(cache.keys()).toEqual(['c']);
+  expect(() => cache.set('d', 4)).toThrow('boom');
+  expect(cache.keys()).toEqual(['d']);
+  expect(cache.get('c')).toBeUndefined();
+
+  expect(() => cache.delete('d')).toThrow('boom');
+  expect(cache.keys()).toEqual([]);
+
+  cache.set('e', 5);
+  setNow(1000);
+  expect(() => cache.get('e')).toThrow('boom');
+  expect(cache.get('e')).toBeUndefined();
+});
+
+test('a throwing onEvict during the expired sweep leaves the cache consistent', () => {
+  const { cache, setNow } = setup(1, 1000);
+  cache.set('a', 1);
+  setNow(1000);
+  cache.onEvict = () => {
+    throw new Error('boom');
+  };
+  expect(() => cache.set('b', 2)).toThrow('boom');
+  expect(cache.keys()).toEqual(['b']);
+});
+
+test('capacity 0 evicts each new entry at once with reason capacity', () => {
+  const { cache, events } = setup(0, 1000);
+  cache.set('a', 1);
+  expect(events).toEqual([['a', 1, 'capacity']]);
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.size).toBe(0);
+});
+
+test('an expired entry behind a live one is still swept', () => {
+  const { cache, events, setNow } = setup(2, 1000);
+  cache.set('a', 1); // expires at 1000
+  setNow(500);
+  cache.set('b', 2); // expires at 1500
+  setNow(400);
+  expect(cache.get('a')).toBe(1); // moves "a" to most recent; its expiry stays at 1000
+  setNow(1200);
+  cache.set('c', 3);
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('agrees with a naive reference model on random operations', () => {
+  const next = rng(3);
+  let t = 0;
+  const events: [string, number, EvictReason][] = [];
+  const cache = new LRU<number, number>(3, 1000, () => t);
+  cache.onEvict = (k, v, r) => events.push([String(k), v, r]);
+  // Model: array in LRU order (oldest first) with expiry times.
+  let model: { key: number; value: number; expires: number }[] = [];
+  const modelEvents: [string, number, EvictReason][] = [];
+  const isLive = (e: { expires: number }) => t < e.expires;
+
+  for (let i = 0; i < 2000; i++) {
+    const op = Math.floor(next() * 4);
+    const key = Math.floor(next() * 6);
+    const value = i;
+    if (op === 0) {
+      const idx = model.findIndex((e) => e.key === key);
+      let expected: number | undefined;
+      if (idx >= 0) {
+        const [e] = model.splice(idx, 1);
+        if (isLive(e)) {
+          expected = e.value;
+          model.push(e);
+        } else {
+          modelEvents.push([String(key), e.value, 'expired']);
+        }
+      }
+      expect(cache.get(key)).toBe(expected);
+    } else if (op === 1) {
+      model = model.filter((e) => e.key !== key);
+      model.push({ key, value, expires: t + 1000 });
+      if (model.length > 3) {
+        const expired = model.filter((e) => !isLive(e));
+        for (const e of expired) modelEvents.push([String(e.key), e.value, 'expired']);
+        model = model.filter((e) => isLive(e));
+        while (model.length > 3) {
+          const e = model.shift()!;
+          modelEvents.push([String(e.key), e.value, 'capacity']);
+        }
+      }
+      cache.set(key, value);
+    } else if (op === 2) {
+      const idx = model.findIndex((e) => e.key === key);
+      let expected = false;
+      if (idx >= 0) {
+        const [e] = model.splice(idx, 1);
+        if (isLive(e)) {
+          expected = true;
+          modelEvents.push([String(key), e.value, 'delete']);
+        } else {
+          modelEvents.push([String(key), e.value, 'expired']);
+        }
+      }
+      expect(cache.delete(key)).toBe(expected);
+    } else {
+      t += Math.floor(next() * 601);
+    }
+    expect(events).toEqual(modelEvents);
+    expect(cache.size).toBe(model.filter(isLive).length);
+    expect(cache.keys()).toEqual(
+      model
+        .filter(isLive)
+        .map((e) => e.key)
+        .reverse(),
+    );
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 18:34:18.341404420 +0000
@@ -0,0 +1,73 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+function rng(seed: number): () => number {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+// Reference for the max cut: the longest prefix within max that is the whole slug or ends before a "-".
+function refCut(s: string, max: number): string {
+  for (let len = Math.min(max, s.length); len >= 0; len--) {
+    if (len === s.length || s[len] === '-') return s.slice(0, len);
+  }
+  return s.slice(0, max);
+}
+
+test('slug: lower case, diacritics, special letters', () => {
+  expect(slugify('ABC')).toBe('abc');
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('Ångström')).toBe('angstrom');
+  expect(slugify('ßæœøłđ')).toBe('ssaeoeold');
+  expect(slugify('ÆØŁ')).toBe('aeol');
+});
+
+test('slug: accented special letters keep their mapping', () => {
+  expect(slugify('Ǿ')).toBe('o');
+  expect(slugify('ǿx')).toBe('ox');
+  expect(slugify('ǽ')).toBe('ae');
+});
+
+test('slug: separators collapse and trim, digits kept', () => {
+  expect(slugify('  --a__b!!c--  ')).toBe('a-b-c');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('日本')).toBe('');
+  expect(slugify('Top 10')).toBe('top-10');
+});
+
+test('slug: max boundaries', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('ab-cd-ef', 2)).toBe('ab');
+  expect(slugify('ab-cd-ef', 1)).toBe('a');
+  expect(slugify('ab-cd-ef', 8)).toBe('ab-cd-ef');
+  expect(slugify('ab-cd-ef', 0)).toBe('');
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+});
+
+test('slug: max cut agrees with a reference on random strings', () => {
+  const next = rng(11);
+  const alphabet = 'ab -';
+  for (let i = 0; i < 2000; i++) {
+    let text = '';
+    const len = Math.floor(next() * 21);
+    for (let j = 0; j < len; j++) text += alphabet[Math.floor(next() * alphabet.length)];
+    const base = slugify(text);
+    for (let max = 0; max <= 22; max++) {
+      const out = slugify(text, max);
+      expect(out.length).toBeLessThanOrEqual(max);
+      expect(out.endsWith('-')).toBe(false);
+      expect(out).toBe(refCut(base, max));
+    }
+  }
+});
+
+test('uniqueSlug: first free suffix', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-2', 'post-3']))).toBe('post-4');
+  expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+});
