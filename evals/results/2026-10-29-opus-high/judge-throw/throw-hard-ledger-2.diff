+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+const intent = (callId: string, tool: string, input: Record<string, unknown>): SessionEvent => ({ kind: 'tool_intent', callId, tool, input });
+const result = (callId: string, status: 'completed' | 'failed' | 'denied' | 'not_started', output: { isError: boolean; exitCode?: number }): SessionEvent => ({
+  kind: 'tool_result',
+  callId,
+  status,
+  output,
+});
+
+describe('matchCheck rules', () => {
+  test('whitespace and a trailing 2>&1 are normalized on both sides; the check is returned as written', () => {
+    expect(matchCheck('bun\ttest  2>&1', ['  bun test'])).toBe('  bun test');
+  });
+
+  test('pipes and chains do not match', () => {
+    expect(matchCheck('bun test; true', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test || x', ['bun test'])).toBeUndefined();
+  });
+
+  test('a leading cd is stripped only when it resolves to cwd, and only once', () => {
+    expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd /work && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+
+  test('a check that itself starts with a cd still matches the whole command', () => {
+    expect(matchCheck('cd sub && bun test', ['cd sub && bun test'], cwd)).toBe('cd sub && bun test');
+    expect(matchCheck('cd /work/repo && bun test', ['cd /work/repo && bun test'], cwd)).toBe('cd /work/repo && bun test');
+  });
+});
+
+describe('ledgerEntries rules', () => {
+  test('a missing exit code comes from isError; an explicit exit code is kept', () => {
+    const events: SessionEvent[] = [intent('a', 'bash', { command: 'bun test' }), result('a', 'failed', { isError: true, exitCode: 2 }), intent('b', 'bash', { command: 'bun test' }), result('b', 'failed', { isError: true })];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([
+      { kind: 'check', at: 1, command: 'bun test', exitCode: 2 },
+      { kind: 'check', at: 3, command: 'bun test', exitCode: 1 },
+    ]);
+  });
+
+  test('denied and not started checks never count', () => {
+    const events: SessionEvent[] = [intent('a', 'bash', { command: 'bun test' }), result('a', 'denied', { isError: true, exitCode: 1 })];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([]);
+  });
+
+  test('a snapshot after the result still applies and overrides the edit and bash rules', () => {
+    const events: SessionEvent[] = [intent('a', 'edit', { path: 'a.ts' }), result('a', 'completed', { isError: false }), { kind: 'snapshot', callId: 'a', changed: ['x.ts'] }];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'x.ts' }]);
+
+    const empty: SessionEvent[] = [intent('b', 'edit', { path: 'a.ts' }), result('b', 'completed', { isError: false }), { kind: 'snapshot', callId: 'b', changed: [] }];
+    expect(ledgerEntries(empty, [])).toEqual([]);
+
+    const bash: SessionEvent[] = [intent('c', 'bash', { command: 'npm i' }), result('c', 'completed', { isError: false, exitCode: 0 }), { kind: 'snapshot', callId: 'c', changed: ['y.ts'] }];
+    expect(ledgerEntries(bash, [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', path: 'y.ts' }]);
+  });
+
+  test('a failed edit gives no entry, but a failed writing bash command is a write', () => {
+    const events: SessionEvent[] = [intent('a', 'edit', { path: 'a.ts' }), result('a', 'failed', { isError: true }), intent('b', 'bash', { command: 'npm i' }), result('b', 'failed', { isError: true, exitCode: 1 })];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 3, tool: 'bash', command: 'npm i' }]);
+  });
+
+  test('read-only bash gives no entry; a redirect makes a write', () => {
+    const events: SessionEvent[] = [
+      intent('a', 'bash', { command: 'git status' }),
+      result('a', 'completed', { isError: false, exitCode: 0 }),
+      intent('b', 'bash', { command: 'cat x > y' }),
+      result('b', 'completed', { isError: false, exitCode: 0 }),
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 3, tool: 'bash', command: 'cat x > y' }]);
+  });
+});
+
+describe('evidence rules', () => {
+  const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+  const b = (at: number, command: string): LedgerEntry => ({ kind: 'write', at, tool: 'bash', command });
+  const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+  test('changed is deduplicated in first-seen order, with the bash label', () => {
+    expect(evidence([w(1, 'a.ts'), b(2, 'npm i'), w(3, 'a.ts'), b(4, 'npm i')]).changed).toEqual(['a.ts', 'bash: npm i']);
+  });
+
+  test('unverified is everything when no check passed, and empty when the last entry is a passing check', () => {
+    expect(evidence([w(1, 'a.ts'), w(2, 'a.ts'), c(3, 1)]).unverified).toEqual(['a.ts']);
+    expect(evidence([w(1, 'a.ts'), c(2, 0)]).unverified).toEqual([]);
+  });
+});
+
+describe('verified rules', () => {
+  const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+  const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+  test('a failing check after a passing one, with no write between, is still verified', () => {
+    expect(verified([w(1, 'a.ts'), c(2, 0), c(3, 1)], ['bun test'])).toBe(true);
+  });
+});
+
+describe('generated logs', () => {
+  // Small seeded generator so the cases are the same on every run.
+  const rng = (seed: number) => {
+    let s = seed >>> 0;
+    return () => {
+      s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
+      return s / 2 ** 32;
+    };
+  };
+  const pick = <T>(next: () => number, xs: readonly T[]): T => xs[Math.floor(next() * xs.length)]!;
+
+  test('evidence and verified agree on generated entry lists', () => {
+    const next = rng(7);
+    for (let k = 0; k < 500; k++) {
+      const len = Math.floor(next() * 9);
+      const entries: LedgerEntry[] = [];
+      for (let i = 0; i < len; i++) {
+        entries.push(next() < 0.5 ? { kind: 'write', at: i, tool: 'edit', path: pick(next, ['a.ts', 'b.ts']) } : { kind: 'check', at: i, command: 'x', exitCode: pick(next, [0, 1]) });
+      }
+      expect(verified(entries, ['x'])).toBe(evidence(entries).unverified.length === 0);
+    }
+  });
+
+  test('entries point at tool_result events and stay in log order', () => {
+    const next = rng(11);
+    const commands = ['bun test', 'npm i', 'ls', 'git status', 'cat a > b'];
+    for (let k = 0; k < 200; k++) {
+      const events: SessionEvent[] = [];
+      let id = 0;
+      const len = Math.floor(next() * 30);
+      for (let i = 0; i < len; i++) {
+        const r = next();
+        if (r < 0.1) events.push({ kind: 'request' });
+        else if (r < 0.2) events.push({ kind: 'snapshot', callId: `c${Math.floor(next() * (id + 1))}`, changed: ['s.ts'] });
+        else {
+          const callId = `c${id++}`;
+          const tool = pick(next, ['bash', 'edit', 'write']);
+          events.push(intent(callId, tool, tool === 'bash' ? { command: pick(next, commands) } : { path: 'a.ts' }));
+          events.push(result(callId, pick(next, ['completed', 'failed', 'denied', 'not_started'] as const), { isError: next() < 0.5, exitCode: pick(next, [0, 1]) }));
+        }
+      }
+      const entries = ledgerEntries(events, ['bun test']);
+      let last = 0;
+      for (const e of entries) {
+        expect(events[e.at]?.kind).toBe('tool_result');
+        expect(e.at).toBeGreaterThanOrEqual(last);
+        last = e.at;
+      }
+    }
+  });
+});
