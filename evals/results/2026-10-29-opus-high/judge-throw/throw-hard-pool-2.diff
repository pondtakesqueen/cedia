diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.fix.test.ts b/pool.fix.test.ts
--- a/pool.fix.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.fix.test.ts	2026-10-29 18:22:15.499460487 +0000
@@ -0,0 +1,235 @@
+import { expect, test } from "bun:test";
+import { runPool } from "./pool";
+
+const flush = () => new Promise<void>((r) => setTimeout(r, 0));
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+}
+
+test("refuses a limit or retries that is not a whole number in range, before any task starts", async () => {
+  for (const limit of [0, -1, 1.5, NaN]) {
+    let called = 0;
+    await expect(runPool([() => (called++, 1)], limit)).rejects.toBeInstanceOf(RangeError);
+    expect(called).toBe(0);
+  }
+  for (const retries of [-1, 1.5, NaN]) {
+    let called = 0;
+    await expect(runPool([() => (called++, 1)], 1, { retries })).rejects.toBeInstanceOf(RangeError);
+    expect(called).toBe(0);
+  }
+});
+
+test("an Infinity limit starts every task at once", async () => {
+  const ds = [deferred<number>(), deferred<number>(), deferred<number>()];
+  let started = 0;
+  const p = runPool(ds.map((d) => () => (started++, d.promise)), Infinity);
+  expect(started).toBe(3);
+  ds.forEach((d, i) => d.resolve(i));
+  expect((await p).map((r) => r.status)).toEqual(["fulfilled", "fulfilled", "fulfilled"]);
+});
+
+test("never runs more than limit at once, and starts the next task as soon as a slot frees", async () => {
+  const ds = Array.from({ length: 5 }, () => deferred<number>());
+  const started: number[] = [];
+  let inFlight = 0;
+  let maxInFlight = 0;
+  const p = runPool(
+    ds.map((d, i) => () => {
+      started.push(i);
+      inFlight++;
+      maxInFlight = Math.max(maxInFlight, inFlight);
+      return d.promise.finally(() => inFlight--);
+    }),
+    2,
+  );
+  expect(started).toEqual([0, 1]);
+  ds[1].resolve(1);
+  await flush();
+  expect(started).toEqual([0, 1, 2]);
+  ds[0].resolve(0);
+  ds[2].resolve(2);
+  await flush();
+  expect(started).toEqual([0, 1, 2, 3, 4]);
+  ds[3].resolve(3);
+  ds[4].resolve(4);
+  await p;
+  expect(maxInFlight).toBe(2);
+});
+
+test("a synchronous throw is a rejection and a plain value is a fulfilment, both called in the same call", async () => {
+  const boom = new Error("boom");
+  let calls = 0;
+  const p = runPool<number>([() => (calls++, 7), () => (calls++, (() => { throw boom; })())], 1);
+  const out = await p;
+  expect(calls).toBe(2);
+  expect(out[0]).toEqual({ status: "fulfilled", value: 7, attempts: 1 });
+  expect(out[1]).toEqual({ status: "rejected", reason: boom, attempts: 1 });
+});
+
+test("retries in the same slot until success, with attempts counting every call", async () => {
+  let calls = 0;
+  const flaky = () => (++calls <= 2 ? Promise.reject(new Error("x")) : Promise.resolve("ok"));
+  const [r] = await runPool([flaky], 1, { retries: 2 });
+  expect(r).toEqual({ status: "fulfilled", value: "ok", attempts: 3 });
+  expect(calls).toBe(3);
+});
+
+test("retries stop after retries more calls, and retries: 0 makes one call", async () => {
+  let calls = 0;
+  const bad = () => (calls++, Promise.reject("nope"));
+  const [r] = await runPool([bad], 1, { retries: 2 });
+  expect(r).toEqual({ status: "rejected", reason: "nope", attempts: 3 });
+  expect(calls).toBe(3);
+
+  calls = 0;
+  const [once] = await runPool([bad], 1);
+  expect(once).toEqual({ status: "rejected", reason: "nope", attempts: 1 });
+  expect(calls).toBe(1);
+});
+
+test("results come back in task order, not finish order", async () => {
+  const ds = [deferred<number>(), deferred<number>(), deferred<number>()];
+  const p = runPool(ds.map((d) => () => d.promise), 3);
+  ds[2].resolve(2);
+  ds[0].resolve(0);
+  ds[1].resolve(1);
+  const out = await p;
+  expect(out.map((r) => (r.status === "fulfilled" ? r.value : null))).toEqual([0, 1, 2]);
+});
+
+test("a signal aborted before the call starts nothing and settles every task", async () => {
+  const ac = new AbortController();
+  ac.abort("stop");
+  let calls = 0;
+  const out = await runPool([() => (calls++, 1), () => (calls++, 2)], 1, { signal: ac.signal });
+  expect(calls).toBe(0);
+  expect(out).toEqual([
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("an abort mid-run keeps the task in flight and settles the rest as never started", async () => {
+  const ac = new AbortController();
+  const d = [deferred<number>(), deferred<number>(), deferred<number>()];
+  const called: number[] = [];
+  const p = runPool(
+    d.map((x, i) => () => (called.push(i), x.promise)),
+    1,
+    { signal: ac.signal },
+  );
+  ac.abort("stop");
+  d[0].resolve(10);
+  const out = await p;
+  expect(called).toEqual([0]);
+  expect(out[0]).toEqual({ status: "fulfilled", value: 10, attempts: 1 });
+  expect(out[1]).toEqual({ status: "rejected", reason: "stop", attempts: 0 });
+  expect(out[2]).toEqual({ status: "rejected", reason: "stop", attempts: 0 });
+});
+
+test("an abort before a retry cancels the retry with the attempts made so far", async () => {
+  const ac = new AbortController();
+  const d = deferred<number>();
+  let calls = 0;
+  const p = runPool([() => (calls++, d.promise)], 1, { retries: 3, signal: ac.signal });
+  ac.abort("stop");
+  d.reject(new Error("fail"));
+  const [r] = await p;
+  expect(calls).toBe(1);
+  expect(r).toEqual({ status: "rejected", reason: "stop", attempts: 1 });
+});
+
+test("a task that aborts the signal during the launch stops later tasks from starting", async () => {
+  const ac = new AbortController();
+  const called: number[] = [];
+  const tasks = [0, 1, 2].map((i) => () => {
+    called.push(i);
+    if (i === 0) ac.abort("s");
+    return i;
+  });
+  const out = await runPool(tasks, 3, { signal: ac.signal });
+  expect(called).toEqual([0]);
+  expect(out[0]).toEqual({ status: "fulfilled", value: 0, attempts: 1 });
+  expect(out[1]).toEqual({ status: "rejected", reason: "s", attempts: 0 });
+  expect(out[2]).toEqual({ status: "rejected", reason: "s", attempts: 0 });
+});
+
+test("a task started from a settled slot that aborts the signal stops the next tasks", async () => {
+  const ac = new AbortController();
+  const called: number[] = [];
+  const tasks = [0, 1, 2].map((i) => () => {
+    called.push(i);
+    if (i === 1) ac.abort("s");
+    return i;
+  });
+  const out = await runPool(tasks, 1, { signal: ac.signal });
+  expect(called).toEqual([0, 1]);
+  expect(out[2]).toEqual({ status: "rejected", reason: "s", attempts: 0 });
+});
+
+test("resolves and never rejects when tasks throw, reject or fulfil in a mix", async () => {
+  const out = await runPool<number>(
+    [
+      () => {
+        throw new Error("sync");
+      },
+      () => Promise.reject(new Error("async")),
+      () => 3,
+    ],
+    2,
+    { retries: 1 },
+  );
+  expect(out.map((r) => r.status)).toEqual(["rejected", "rejected", "fulfilled"]);
+});
+
+test("matches the contract over many random runs", async () => {
+  let seed = 42;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  for (let iter = 0; iter < 200; iter++) {
+    const n = rand(12);
+    const limit = rand(4) === 0 ? Infinity : 1 + rand(4);
+    const retries = rand(3);
+    const fails = Array.from({ length: n }, () => rand(4));
+    // Per task: the deferred for its current attempt, or null when it is not in flight.
+    const current: Array<ReturnType<typeof deferred<number>> | null> = new Array(n).fill(null);
+    const calls = new Array<number>(n).fill(0);
+    let inFlight = 0;
+    let maxInFlight = 0;
+    const tasks = fails.map((k, i) => () => {
+      const d = deferred<number>();
+      current[i] = d;
+      calls[i]++;
+      inFlight++;
+      maxInFlight = Math.max(maxInFlight, inFlight);
+      return d.promise;
+    });
+    const p = runPool(tasks, limit, { retries });
+    for (;;) {
+      await flush();
+      const live = current.map((d, i) => i).filter((i) => current[i] !== null);
+      if (live.length === 0) break;
+      const pick = live[rand(live.length)];
+      const d = current[pick]!;
+      current[pick] = null;
+      inFlight--;
+      if (calls[pick] > fails[pick]) d.resolve(pick);
+      else d.reject(pick);
+    }
+    const out = await p;
+    expect(maxInFlight).toBeLessThanOrEqual(limit);
+    out.forEach((r, i) => {
+      if (fails[i] <= retries) expect(r).toEqual({ status: "fulfilled", value: i, attempts: fails[i] + 1 });
+      else expect(r).toEqual({ status: "rejected", reason: i, attempts: retries + 1 });
+    });
+  }
+});
