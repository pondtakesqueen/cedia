diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-29 18:17:51.767557623 +0000
@@ -0,0 +1,149 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+// fn's calls, each settled by the test.
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("a rejection is not kept: every waiter gets it and the next call runs fn again", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  const err = new Error("nope");
+  calls[0]!.d.reject(err);
+  await expect(a).rejects.toBe(err);
+  await expect(b).rejects.toBe(err);
+  const c = m("k");
+  expect(calls).toHaveLength(2);
+  calls[1]!.d.resolve("v");
+  expect(await c).toBe("v");
+});
+
+test("a cache hit counts as a use for max: the hit key outlives the one not used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  expect(await m("a")).toBe("a");
+  m("c");
+  expect(m.size).toBe(2);
+  expect(calls).toHaveLength(3);
+  expect(await m("a")).toBe("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("settling does not count as a use for max", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[1]!.d.resolve("b");
+  await tick();
+  calls[0]!.d.resolve("a");
+  await tick();
+  m("c");
+  expect(m.size).toBe(2);
+  expect(calls).toHaveLength(3);
+  expect(await m("b")).toBe("b");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(4);
+});
+
+test("a stale settle after invalidate does not overwrite the newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  await tick();
+  const third = m("k");
+  expect(calls).toHaveLength(2);
+  expect(third).toBe(second);
+  calls[1]!.d.resolve("new");
+  expect(await third).toBe("new");
+});
+
+test("a stale rejection after invalidate does not delete the newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.reject(new Error("stale"));
+  await expect(first).rejects.toThrow("stale");
+  await tick();
+  expect(m("k")).toBe(second);
+  expect(calls).toHaveLength(2);
+});
+
+test("a call dropped to stay under max is forgotten: its late settle does not replace the newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  const a1 = m("a");
+  m("b");
+  const a2 = m("a");
+  expect(calls).toHaveLength(3);
+  calls[0]!.d.resolve("old-a");
+  expect(await a1).toBe("old-a");
+  await tick();
+  expect(m.size).toBe(1);
+  expect(m("a")).toBe(a2);
+  expect(calls).toHaveLength(3);
+});
+
+test("clear forgets in-flight calls: their late settle does not keep them", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("a");
+  m("b");
+  m.clear();
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  expect(m.size).toBe(0);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a synchronous throw from fn rejects and leaves the cache as it was", async () => {
+  const { fn: inner, calls } = lookups();
+  const m = memo((key: string) => {
+    if (key === "x") throw new Error("boom");
+    return inner(key);
+  }, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  await expect(m("x")).rejects.toThrow("boom");
+  expect(m.size).toBe(2);
+  expect(await m("a")).toBe("a");
+  expect(await m("b")).toBe("b");
+  expect(calls).toHaveLength(2);
+});
