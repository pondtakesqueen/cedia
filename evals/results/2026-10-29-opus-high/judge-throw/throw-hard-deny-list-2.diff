diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 18:03:40.411394203 +0000
@@ -0,0 +1,74 @@
+import { expect, test } from 'bun:test';
+import { homedir } from 'node:os';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string, dir = cwd) => denyListed(line.split(' '), dir)?.name;
+
+test('git: argv[0] as a path, and global options with values', () => {
+  expect(hit('/usr/bin/git push -f')).toBe('force-push');
+  expect(hit('git --work-tree=w push -f')).toBe('force-push');
+  expect(hit('git -C push status')).toBeUndefined(); // `push` is the value of -C
+  expect(hit('git')).toBeUndefined();
+  expect(hit('git -C')).toBeUndefined();
+});
+
+test('git push: long flags need an exact name or =value', () => {
+  for (const line of ['git push --force', 'git push --force-with-lease=x', 'git push --delete', 'git push --mirror', 'git push --prune'])
+    expect([line, hit(line)]).toEqual([line, 'force-push']);
+  for (const line of ['git push --forceful', 'git push --tags', 'git push --force-x'])
+    expect([line, hit(line)]).toEqual([line, undefined]);
+});
+
+test('git push: refspecs and short groups', () => {
+  expect(hit('git push origin HEAD:main')).toBeUndefined();
+  expect(hit('git push origin +HEAD')).toBe('force-push');
+  expect(hit('git push -d origin old')).toBe('force-push');
+  expect(hit('git push -u origin f')).toBeUndefined();
+});
+
+test('git clean: -n and --dry-run exempt only as exact words', () => {
+  expect(hit('git clean -nf')).toBe('clean-force');
+  expect(hit('git clean -fn --dry-run')).toBeUndefined();
+  expect(hit('git clean --force -n')).toBeUndefined();
+});
+
+test('rm: targets after -- and non-recursive forms', () => {
+  expect(hit('rm -- -r /etc')).toBeUndefined();
+  expect(hit('rm -r -- /etc')).toBe('rm-outside');
+  expect(hit('rm -rf ..cache')).toBeUndefined(); // a name starting with .. is inside
+  expect(hit('rm -rf ../x')).toBe('rm-outside');
+  expect(hit('rm -r -- $HOME')).toBe('rm-outside');
+  expect(hit('rm -r ./')).toBe('rm-outside');
+});
+
+test('rm: a tilde path is resolved against home', () => {
+  const home = homedir();
+  const proj = home + '/proj';
+  expect(hit('rm -rf ~/proj/build', proj)).toBeUndefined();
+  expect(hit('rm -rf ~/other', proj)).toBe('rm-outside');
+  expect(hit('rm -rf ~/proj', proj)).toBe('rm-outside'); // cwd itself
+});
+
+test('find: start paths only, and -exec variants', () => {
+  expect(hit('find . -exec rm {} ;')).toBeUndefined();
+  expect(hit('find /work/repo -delete')).toBeUndefined();
+  expect(hit('find ~bob -delete')).toBe('rm-outside');
+  expect(hit('find src -name x -exec rm {} ;')).toBeUndefined();
+  expect(hit('find /var -name x -execdir rm {} ;')).toBe('rm-outside');
+});
+
+test('other commands whose names only look like rm or git', () => {
+  expect(hit('/bin/rmdir -r /etc')).toBeUndefined();
+  expect(hit('gitk push -f')).toBeUndefined();
+});
+
+test('rm targets agree with insideWorkspace and sameDir on generated paths', () => {
+  for (const pre of ['', './', '../', '/', '/work/repo/', '~/'])
+    for (const name of ['', 'a', 'a/b', '..', '*']) {
+      const t = pre + name;
+      const denied = !insideWorkspace(t, cwd) || sameDir(t, cwd);
+      expect([t, denyListed(['rm', '-rf', t], cwd)?.name === 'rm-outside']).toEqual([t, denied]);
+      expect([t, denyListed(['find', t, '-delete'], cwd)?.name === 'rm-outside']).toEqual([t, !insideWorkspace(t, cwd)]);
+    }
+});
