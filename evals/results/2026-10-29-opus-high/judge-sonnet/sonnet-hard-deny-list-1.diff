diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 17:18:49.341940700 +0000
@@ -0,0 +1,45 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('git option skipping and edge cases', () => {
+  expect(hit('git --namespace x push -f')).toBe('force-push');
+  expect(hit('git --bare push -f')).toBe('force-push');
+  expect(hit('git -C')).toBeUndefined();
+  expect(hit('git')).toBeUndefined();
+  expect(hit('git push --prune=x')).toBe('force-push');
+  expect(hit('git push -df')).toBe('force-push');
+  expect(hit('git push --forced')).toBeUndefined();
+  expect(hit('git push --tags')).toBeUndefined();
+});
+
+test('rm edge cases', () => {
+  expect(hit('rm -r --')).toBe('rm-outside');
+  expect(hit('rm -rf src/$X')).toBe('rm-outside');
+  expect(hit('rm -rf /work/repo/')).toBe('rm-outside');
+  expect(hit('rm -rf ./')).toBe('rm-outside');
+  expect(hit('rm -f ../a')).toBeUndefined();
+});
+
+test('find edge cases', () => {
+  expect(hit('find /work/repo -delete')).toBeUndefined();
+  expect(hit('find . -delete')).toBeUndefined();
+  expect(hit('find ~bob -delete')).toBe('rm-outside');
+  expect(hit('./find / -delete')).toBe('rm-outside');
+});
+
+test('rm and find agree with the path helpers', () => {
+  for (const p of ['.', '..', '/', '/work', '/work/repo', '/work/repo/a', 'a/../..', 'a/..', '*']) {
+    expect([p, hit(`rm -rf ${p}`) === 'rm-outside']).toEqual([p, !insideWorkspace(p, cwd) || sameDir(p, cwd)]);
+    expect([p, hit(`find ${p} -delete`) === 'rm-outside']).toEqual([p, !insideWorkspace(p, cwd)]);
+  }
+});
+
+test('names starting with .. are inside cwd', () => {
+  expect(hit('rm -rf ..cache')).toBeUndefined();
+  expect(hit('find ..cache -delete')).toBeUndefined();
+  expect(hit('rm -rf ..')).toBe('rm-outside');
+  expect(hit('rm -rf ../x')).toBe('rm-outside');
+});
