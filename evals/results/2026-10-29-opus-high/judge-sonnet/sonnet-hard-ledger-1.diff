--- a/ledger.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.rules.test.ts	2026-10-29 17:26:59.093451682 +0000
@@ -0,0 +1,46 @@
+import { expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+const call = (id: string, tool: string, input: Record<string, unknown>, status: 'completed' | 'failed' | 'denied' = 'completed', exitCode?: number, isError = false): SessionEvent[] => [
+  { kind: 'tool_intent', callId: id, tool, input },
+  { kind: 'tool_result', callId: id, status, output: { isError, exitCode } },
+];
+
+test('matchCheck edge cases', () => {
+  expect(matchCheck('bun test 2>&1', ['bun test 2>&1'])).toBe('bun test 2>&1');
+  expect(matchCheck("cd '/work/repo' && bun test", ['bun test'], cwd)).toBe('bun test');
+  expect(matchCheck('cd /work/repo/ && bun test', ['bun test'], cwd)).toBe('bun test');
+  expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+  expect(matchCheck('bun test && cd /work/repo', ['bun test'], cwd)).toBeUndefined();
+  expect(matchCheck('', ['bun test'])).toBeUndefined();
+});
+
+test('ledgerEntries rules', () => {
+  expect(ledgerEntries(call('a', 'bash', { command: 'bun test' }, 'denied'), ['bun test'])).toEqual([]);
+  expect(ledgerEntries(call('a', 'bash', { command: 'bun test' }, 'failed', 0, true), ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+  expect(ledgerEntries(call('a', 'bash', { command: 'make' }, 'failed', 2, true), [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'make' }]);
+  const snap: SessionEvent[] = [
+    { kind: 'snapshot', callId: 'a', changed: ['x'] },
+    { kind: 'snapshot', changed: ['ignored'] },
+    ...call('a', 'edit', { path: 'p' }),
+    { kind: 'snapshot', callId: 'a', changed: ['y'] },
+  ];
+  expect(ledgerEntries(snap, [])).toEqual([
+    { kind: 'write', at: 3, tool: 'edit', path: 'x' },
+    { kind: 'write', at: 3, tool: 'edit', path: 'y' },
+  ]);
+  const [i, r] = call('a', 'edit', { path: 'p' });
+  expect(ledgerEntries([i!, { kind: 'request' }, i!, r!], [])).toEqual([{ kind: 'write', at: 3, tool: 'edit', path: 'p' }]);
+});
+
+test('verified agrees with evidence.unverified', () => {
+  let seed = 7;
+  const rnd = (n: number) => ((seed = (seed * 1103515245 + 12345) % 2147483648), seed % n);
+  for (let k = 0; k < 500; k++) {
+    const entries: LedgerEntry[] = Array.from({ length: rnd(9) }, (_, at): LedgerEntry =>
+      rnd(2) ? { kind: 'write', at, tool: 'edit', path: 'ab'[rnd(2)]! } : { kind: 'check', at, command: 'bun test', exitCode: rnd(2) });
+    expect(verified(entries, ['bun test'])).toBe(evidence(entries).unverified.length === 0 || !entries.some((e) => e.kind === 'write'));
+    expect(verified(entries, [])).toBe(true);
+  }
+});
