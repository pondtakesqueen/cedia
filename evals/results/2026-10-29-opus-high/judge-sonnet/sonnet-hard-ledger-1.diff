 // - Otherwise an edit or write call that completed is a write entry with path = input.path.
 // - Otherwise a bash call whose command is not read-only is a write entry with command set (no path).
 export function ledgerEntries(events: SessionEvent[], checks: string[], cwd?: string): LedgerEntry[] {
-  throw new Error('not implemented');
+  const snapshots = new Map<string, string[]>();
+  for (const e of events) if (e.kind === 'snapshot' && e.callId !== undefined) snapshots.set(e.callId, [...(snapshots.get(e.callId) ?? []), ...e.changed]);
+  const entries: LedgerEntry[] = [];
+  let intents = new Map<string, Extract<SessionEvent, { kind: 'tool_intent' }>>();
+  events.forEach((e, at) => {
+    if (e.kind === 'request') intents = new Map();
+    else if (e.kind === 'tool_intent') intents.set(e.callId, e);
+    else if (e.kind === 'tool_result') {
+      const intent = intents.get(e.callId);
+      if (!intent || e.status === 'denied' || e.status === 'not_started') return;
+      const command = intent.tool === 'bash' && typeof intent.input.command === 'string' ? intent.input.command : undefined;
+      const check = command === undefined ? undefined : matchCheck(command, checks, cwd);
+      if (check !== undefined) {
+        entries.push({ kind: 'check', at, command: check, exitCode: e.output.exitCode ?? (e.output.isError ? 1 : 0) });
+      } else if (snapshots.has(e.callId)) {
+        for (const path of snapshots.get(e.callId)!) entries.push({ kind: 'write', at, tool: intent.tool, path });
+      } else if ((intent.tool === 'edit' || intent.tool === 'write') && e.status === 'completed') {
+        entries.push({ kind: 'write', at, tool: intent.tool, path: intent.input.path as string });
+      } else if (command !== undefined && !isReadOnly(command)) {
+        entries.push({ kind: 'write', at, tool: intent.tool, command });
+      }
+    }
+  });
