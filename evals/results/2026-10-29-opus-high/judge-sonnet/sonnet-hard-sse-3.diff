diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.rules.test.ts b/sse.rules.test.ts
--- a/sse.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.rules.test.ts	2026-10-29 17:39:23.483337044 +0000
@@ -0,0 +1,68 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString } from './sse';
+
+async function collect(text: string, size = 7) {
+  const out = [];
+  for await (const m of readSse(streamFromString(text, size))) out.push(m);
+  return out;
+}
+
+test('chunk size does not change the result', async () => {
+  const text = ':c\r\nevent: é\r\ndata: ไทย 😀\r\ndata\r\n\r\ndata: x\n\nevent: y\n\ndata: tail';
+  const whole = await collect(text, 1000);
+  for (let n = 1; n <= text.length; n++) expect(await collect(text, n)).toEqual(whole);
+  expect(whole.length).toBe(3);
+});
+
+test('rules', async () => {
+  expect(await collect(':x\ndata: a\n\n')).toEqual([{ data: 'a' }]);
+  expect(await collect('data:  \n\n')).toEqual([{ data: ' ' }]);
+  expect(await collect('data\ndata\n\n')).toEqual([{ data: '\n' }]);
+  expect(await collect('datax: 1\n\n')).toEqual([]);
+  const r = await collect('event: a\n\ndata: b\n\n');
+  expect(r).toEqual([{ data: 'b' }]);
+  expect(Object.keys(r[0]!)).toEqual(['data']);
+  expect(await collect('data: a\ndata: b')).toEqual([{ data: 'a\nb' }]);
+  expect(await collect('event: x')).toEqual([]);
+  expect(await collect('data: x\r')).toEqual([{ data: 'x' }]);
+});
+
+test('stream error propagates', async () => {
+  let i = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (i++ === 0) c.enqueue(new TextEncoder().encode('data: a\n\n'));
+      else c.error(new Error('boom'));
+    },
+  });
+  const got: unknown[] = [];
+  await expect(
+    (async () => {
+      for await (const m of readSse(body)) got.push(m);
+    })(),
+  ).rejects.toThrow('boom');
+  expect(got).toEqual([{ data: 'a' }]);
+});
+
+test('early break releases lock', async () => {
+  let cancelled = false;
+  const bytes = new TextEncoder().encode('data: a\n\ndata: b\n\n');
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(bytes);
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const _ of readSse(body)) break;
+  expect(cancelled).toBe(true);
+  expect(body.locked).toBe(false);
+});
+
+test('long line in small chunks is linear', async () => {
+  const text = 'data: ' + 'x'.repeat(2_000_000) + '\n\n';
+  const r = await collect(text, 16);
+  expect(r.length).toBe(1);
+  expect(r[0]!.data.length).toBe(2_000_000);
+});
