 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  /** Insertion order is usage order, least recently used first. */
+  private entries = new Map<K, { value: V; expiresAt: number }>();
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+  constructor(
+    private capacity: number,
+    private ttlMs: number,
+    private now: () => number = Date.now,
+  ) {}
+
+  private live(e: { expiresAt: number }): boolean {
+    return this.now() < e.expiresAt;
+  }
+
+  private remove(key: K, reason: EvictReason): void {
+    const e = this.entries.get(key)!;
+    this.entries.delete(key);
+    this.onEvict?.(key, e.value, reason);
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return undefined;
+    if (!this.live(e)) {
+      this.remove(key, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.entries.delete(key);
+    this.entries.set(key, { value, expiresAt: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, e] of [...this.entries]) {
+      if (!this.live(e)) this.remove(k, 'expired');
+    }
+    while (this.entries.size > this.capacity) {
+      this.remove(this.entries.keys().next().value as K, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return false;
+    const live = this.live(e);
+    this.remove(key, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const e of this.entries.values()) if (this.live(e)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const out: K[] = [];
+    for (const [k, e] of this.entries) if (this.live(e)) out.push(k);
+    return out.reverse();
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 17:41:31.867389884 +0000
+++ b/src/slug.ts	2026-10-29 17:43:27.331586716 +0000
@@ -11,10 +11,25 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { 'ß': 'ss', 'æ': 'ae', 'œ': 'oe', 'ø': 'o', 'ł': 'l', 'đ': 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  if (slug[max] === '-') return slug.slice(0, max);
+  const cut = slug.lastIndexOf('-', max - 1);
+  return cut > 0 ? slug.slice(0, cut) : slug.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 17:43:27.339322094 +0000
@@ -0,0 +1,25 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parse rules', () => {
+  expect(parseDuration(' 2d 4h ')).toBe(187_200_000);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('1.6ms')).toBe(2);
+  expect(parseDuration('0.4ms')).toBe(0);
+  for (const b of ['', '   ', '10', 'h', '-1s', '1h x', '1.h', '.5h', '1h 30'])
+    expect(() => parseDuration(b)).toThrow(JSON.stringify(b));
+});
+
+test('format rules', () => {
+  expect(formatDuration(1500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(86_400_001)).toBe('1d1ms');
+  expect(() => formatDuration(-1)).toThrow();
+  for (let n = 0; n < 5000; n += 7) expect(parseDuration(formatDuration(n))).toBe(n);
+});
+
+test('error message holds raw input', () => {
+  expect(() => parseDuration('5"x')).toThrow('"5"x"');
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 17:42:37.745159660 +0000
@@ -0,0 +1,59 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+function make(cap: number) {
+  const s = { t: 0 };
+  const c = new LRU<string, number>(cap, 1000, () => s.t);
+  const ev: unknown[][] = [];
+  c.onEvict = (k, v, r) => ev.push([k, v, r]);
+  return { s, c, ev };
+}
+
+test('get refreshes recency', () => {
+  const { c, ev } = make(2);
+  c.set('a', 1); c.set('b', 2); c.get('a'); c.set('c', 3);
+  expect(ev).toEqual([['b', 2, 'capacity']]);
+});
+
+test('expiry', () => {
+  const { s, c, ev } = make(2);
+  c.set('a', 1);
+  s.t = 999;
+  expect(c.get('a')).toBe(1);
+  s.t = 1000;
+  expect(c.get('a')).toBeUndefined();
+  expect(c.get('a')).toBeUndefined();
+  expect(ev).toEqual([['a', 1, 'expired']]);
+});
+
+test('set renews ttl', () => {
+  const { s, c } = make(2);
+  c.set('a', 1); s.t = 500; c.set('a', 2); s.t = 1200;
+  expect(c.get('a')).toBe(2);
+});
+
+test('expired removed before live evicted', () => {
+  const { s, c, ev } = make(2);
+  c.set('a', 1); s.t = 600; c.set('b', 2); s.t = 1000; c.set('c', 3);
+  expect(ev).toEqual([['a', 1, 'expired']]);
+  expect(c.keys()).toEqual(['c', 'b']);
+});
+
+test('delete, size, keys', () => {
+  const { s, c, ev } = make(3);
+  c.set('a', 1); c.set('b', 2); s.t = 500; c.set('c', 3);
+  s.t = 1000;
+  expect(c.size).toBe(1);
+  expect(c.keys()).toEqual(['c']);
+  expect(c.delete('c')).toBe(true);
+  expect(c.delete('a')).toBe(false);
+  expect(c.delete('zz')).toBe(false);
+  expect(ev).toEqual([['c', 3, 'delete'], ['a', 1, 'expired']]);
+});
+
+test('overwrite does not evict', () => {
+  const { c, ev } = make(1);
+  c.set('a', 1); c.set('a', 2);
+  expect(ev).toEqual([]);
+  expect(c.get('a')).toBe(2);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 17:43:27.339322094 +0000
@@ -0,0 +1,30 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify rules', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('ßæœøłđ ÆØŁ')).toBe('ssaeoeold-aeol');
+  expect(slugify('--a  _!b--')).toBe('a-b');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('Top 10')).toBe('top-10');
+});
+
+test('slugify max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cdef', 5)).toBe('ab');
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+  expect(slugify('abc', 3)).toBe('abc');
+  expect(slugify('abc', 0)).toBe('');
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('a', new Set())).toBe('a');
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+});
+
+test('compatibility characters are separators', () => {
+  expect(slugify('a²b')).toBe('a-b');
+  expect(slugify('x™')).toBe('x');
+  expect(slugify('ﬁsh')).toBe('sh');
+});
