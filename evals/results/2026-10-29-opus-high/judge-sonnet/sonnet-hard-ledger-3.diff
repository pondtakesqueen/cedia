--- a/ledger.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.rules.test.ts	2026-10-29 17:29:02.572984264 +0000
@@ -0,0 +1,34 @@
+import { expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type SessionEvent } from './ledger.ts';
+
+test('matchCheck edge cases', () => {
+  const cwd = '/work/repo';
+  expect(matchCheck("cd '/work/repo' && bun test", ['bun test'], cwd)).toBe('bun test');
+  expect(matchCheck('cd .. && bun test', ['bun test'], cwd)).toBeUndefined();
+  expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+  expect(matchCheck('bun test || true', ['bun test'])).toBeUndefined();
+});
+
+test('snapshot after a failed edit, and denied calls with snapshots', () => {
+  const events: SessionEvent[] = [
+    { kind: 'request' },
+    { kind: 'tool_intent', callId: 'a', tool: 'edit', input: { path: 'x' } },
+    { kind: 'tool_result', callId: 'a', status: 'failed', output: { isError: true } },
+    { kind: 'snapshot', callId: 'a', changed: ['x'] },
+    { kind: 'tool_intent', callId: 'b', tool: 'bash', input: { command: 'make' } },
+    { kind: 'tool_result', callId: 'b', status: 'denied', output: { isError: true } },
+    { kind: 'snapshot', callId: 'b', changed: ['y'] },
+  ];
+  expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'edit', path: 'x' }]);
+});
+
+test('evidence dedupes and verified agrees', () => {
+  const e = [
+    { kind: 'write' as const, at: 1, tool: 'edit', path: 'a' },
+    { kind: 'check' as const, at: 2, command: 'bun test', exitCode: 0 },
+    { kind: 'write' as const, at: 3, tool: 'edit', path: 'a' },
+    { kind: 'write' as const, at: 3, tool: 'edit', path: 'a' },
+  ];
+  expect(evidence(e).unverified).toEqual(['a']);
+  expect(verified(e, ['bun test'])).toBe(false);
+});
