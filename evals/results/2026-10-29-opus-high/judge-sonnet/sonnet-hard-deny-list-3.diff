diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 17:20:59.531647234 +0000
@@ -0,0 +1,31 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('git options with values and = forms', () => {
+  expect(hit(['git', '--no-pager', '-C', 'x', 'push', '--mirror=x'])).toBe('force-push');
+  expect(hit(['git', '--namespace', 'n', 'push', '-df'])).toBe('force-push');
+  expect(hit(['git', '--work-tree', 'w', 'reset', '--hard'])).toBe('reset-hard');
+  expect(hit(['git', 'clean', '--force', '--dry-run'])).toBeUndefined();
+  expect(hit(['git', 'push', 'origin', 'main'])).toBeUndefined();
+});
+
+test('rm edge cases', () => {
+  expect(hit(['rm', '-f', '--', '-r', '/'])).toBeUndefined();
+  expect(hit(['rm', '-rf', 'a$b'])).toBe('rm-outside');
+  expect(hit(['rm', '-rf', 'a', '..'])).toBe('rm-outside');
+});
+
+test('find start paths and degenerate argv', () => {
+  expect(hit(['find', 'src', '/var', '-exec', 'x'])).toBe('rm-outside');
+  expect(hit(['find', '.', '-delete'])).toBeUndefined();
+  for (const a of [['git'], ['rm'], ['find'], []]) expect(hit(a)).toBeUndefined();
+});
+
+test('names starting with two dots are inside cwd', () => {
+  expect(hit(['rm', '-rf', '..cache'])).toBeUndefined();
+  expect(hit(['find', '...', '-delete'])).toBeUndefined();
+  expect(hit(['rm', '-rf', '../x'])).toBe('rm-outside');
+});
