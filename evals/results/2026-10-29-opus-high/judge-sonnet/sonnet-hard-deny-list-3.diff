+  if (cmd === 'rm') return rmHit(args, cwd);
+  if (cmd === 'find') return findHit(args, cwd);
+  return undefined;
+}
+
+const unresolvable = (p: string) => p.includes('$') || /^~[^/]/.test(p);
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += ['-C', '-c', '--git-dir', '--work-tree', '--namespace'].includes(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  const has = (...names: string[]) => rest.some((a) => names.some((n) => a === n || a.startsWith(n + '=')));
+  const shortGroup = (re: RegExp) => rest.some((a) => /^-[^-]/.test(a) && re.test(a));
+  if (sub === 'push') {
+    if (has('--force', '--force-with-lease', '--mirror', '--delete', '--prune') || shortGroup(/[fd]/) || rest.some((a) => /^[+:]/.test(a)))
+      return { name: 'force-push', reason: 'git push would overwrite or delete remote history' };
+  } else if (sub === 'reset') {
+    if (has('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards uncommitted changes' };
+  } else if (sub === 'clean') {
+    if ((has('--force') || shortGroup(/f/)) && !rest.some((a) => a === '-n' || a === '--dry-run'))
+      return { name: 'clean-force', reason: 'git clean --force deletes untracked files' };
+  }
+  return undefined;
+}
+
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const flags = dd < 0 ? args : args.slice(0, dd);
+  const targets = [...flags.filter((a) => !a.startsWith('-')), ...(dd < 0 ? [] : args.slice(dd + 1))];
+  const recursive = flags.some((a) => a === '--recursive' || (/^-[^-]/.test(a) && /[rR]/.test(a)));
+  if (!recursive) return undefined;
+  const deny = (reason: string): Hit => ({ name: 'rm-outside', reason });
+  if (targets.length === 0) return deny('rm -r has no targets');
+  for (const t of targets) {
+    if (unresolvable(t)) return deny(`rm -r target ${t} cannot be resolved before it runs`);
+    if (sameDir(t, cwd) || !insideWorkspace(t, cwd)) return deny(`rm -r target ${t} is outside the working directory`);
+  }
+  return undefined;
+}
+
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some((a) => a === '-delete' || a === '-exec' || a === '-execdir')) return undefined;
+  const first = args.findIndex((a) => a.startsWith('-'));
+  for (const p of first < 0 ? args : args.slice(0, first)) {
+    if (unresolvable(p) || !insideWorkspace(p, cwd)) return { name: 'rm-outside', reason: `find start path ${p} is outside the working directory` };
+  }
+  return undefined;
 }
