+import { expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+const call = (id: string, tool: string, input: Record<string, unknown>, status: 'completed' | 'failed' | 'denied' | 'not_started', output: { isError: boolean; exitCode?: number }): SessionEvent[] => [
+  { kind: 'tool_intent', callId: id, tool, input },
+  { kind: 'tool_result', callId: id, status, output },
+];
+
+test('matchCheck edge cases', () => {
+  expect(matchCheck('bun test src', ['bun test'])).toBeUndefined();
+  expect(matchCheck('bun\ttest', ['bun  test'])).toBe('bun  test');
+  expect(matchCheck('bun 2>&1 test', ['bun test'])).toBeUndefined();
+  expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+  expect(matchCheck('cd ../repo && bun test', ['bun test'], cwd)).toBe('bun test');
+  expect(matchCheck('echo && cd /work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+  expect(matchCheck('cd . && cd . && bun test', ['bun test'], cwd)).toBeUndefined();
+});
+
+test('ledgerEntries rules', () => {
+  const t = ['bun test'];
+  expect(ledgerEntries([...call('a', 'bash', { command: 'bun test' }, 'denied', { isError: false }), ...call('b', 'edit', { path: 'x' }, 'not_started', { isError: false })], t)).toEqual([]);
+  expect(ledgerEntries(call('a', 'bash', { command: 'bun test' }, 'failed', { isError: true, exitCode: 2 }), t)).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 2 }]);
+  expect(ledgerEntries([{ kind: 'snapshot', callId: 'a', changed: ['p'] }, ...call('a', 'edit', { path: 'x' }, 'failed', { isError: true })], t)).toEqual([{ kind: 'write', at: 2, tool: 'edit', path: 'p' }]);
+  expect(ledgerEntries([...call('a', 'edit', { path: 'x' }, 'completed', { isError: false }), { kind: 'snapshot', callId: 'a', changed: [] }], t)).toEqual([]);
+  expect(ledgerEntries(call('a', 'edit', { path: 'x' }, 'failed', { isError: true }), t)).toEqual([]);
+  expect(ledgerEntries(call('a', 'bash', { command: 'make' }, 'failed', { isError: true, exitCode: 2 }), t)).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'make' }]);
+  expect(ledgerEntries(call('a', 'bash', { command: 'git status' }, 'completed', { isError: false }), t)).toEqual([]);
+  expect(ledgerEntries(call('a', 'bash', { command: 'cat x > y' }, 'completed', { isError: false }), t).length).toBe(1);
+});
+
+test('verified agrees with evidence', () => {
+  let s = 7;
+  const rnd = (n: number) => ((s = (s * 1103515245 + 12345) % 2147483648), s % n);
+  for (let k = 0; k < 500; k++) {
+    const es: LedgerEntry[] = Array.from({ length: rnd(9) }, (_, i) =>
+      rnd(2) ? { kind: 'write', at: i, tool: 'edit', path: `p${rnd(3)}` } : { kind: 'check', at: i, command: 'bun test', exitCode: rnd(2) });
+    const writes = es.some((e) => e.kind === 'write');
+    expect(verified(es, ['bun test'])).toBe(!writes || evidence(es).unverified.length === 0);
+  }
+});
+
+test('review cases', () => {
+  const ok = { isError: false };
+  const [i, r] = call('a', 'edit', { path: 'x' }, 'completed', ok);
+  expect(ledgerEntries([i!, r!, r!], [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'x' }, { kind: 'write', at: 2, tool: 'edit', path: 'x' }]);
+  expect(ledgerEntries([...call('a', 'bash', { command: 'make' }, 'completed', ok), { kind: 'snapshot', callId: 'a', changed: ['p'] }, { kind: 'snapshot', callId: 'a', changed: ['q'] }], [])).toEqual([
+    { kind: 'write', at: 1, tool: 'bash', path: 'p' },
+    { kind: 'write', at: 1, tool: 'bash', path: 'q' },
+  ]);
+  expect(ledgerEntries(call('a', 'edit', {}, 'completed', ok), [])).toEqual([]);
+  expect(ledgerEntries(call('a', 'bash', { command: 'bun test' }, 'completed', { isError: true, exitCode: 0 }), ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+  expect(ledgerEntries([...call('a', 'edit', { path: 'x' }, 'denied', ok), { kind: 'snapshot', callId: 'a', changed: ['p'] }], [])).toEqual([]);
+});
