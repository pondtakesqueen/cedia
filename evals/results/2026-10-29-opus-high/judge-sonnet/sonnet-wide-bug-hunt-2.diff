diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 17:40:33.651582105 +0000
@@ -0,0 +1,48 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { percentOf } from '../src/money/round.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+const t = (r: string, items: [string, number][], coupon?: string) => totals(cart(r, items, coupon));
+
+describe('pricing rules', () => {
+  test('bulk tier boundaries', () => {
+    expect(t('US', [['PEN', 9]]).subtotal).toBe(1080);
+    expect(t('US', [['PEN', 10]])).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+    expect(t('US', [['PEN', 49]]).subtotal).toBe(5586);
+    expect(t('US', [['PEN', 50]])).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+  test('same-sku lines merge without mutating input', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    const r = totals(c);
+    expect(r.lines.length).toBe(1);
+    expect(r.subtotal).toBe(1140);
+    expect(c.lines.map((l) => l.quantity)).toEqual([6, 4]);
+  });
+  test('merged and split carts agree', () => {
+    for (let q = 2; q <= 60; q++)
+      for (let k = 1; k < q; k++) {
+        const a = t('US', [['PEN', k], ['PEN', q - k]]);
+        const b = t('US', [['PEN', q]]);
+        expect([a.subtotal, a.shipping, a.tax, a.total]).toEqual([b.subtotal, b.shipping, b.tax, b.total]);
+      }
+  });
+  test('coupons', () => {
+    expect(t('US', [['PEN', 1]], 'FLAT5').coupon).toBe(120);
+    expect(t('US', [['PEN', 1]], 'save10').coupon).toBe(12);
+  });
+  test('free shipping uses the discounted subtotal', () => {
+    expect(t('EU', [['TEE', 4]], 'FLAT5')).toMatchObject({ subtotal: 6000, coupon: 500, shipping: 900, tax: 1280, total: 7680 });
+    expect(t('US', [['MUG', 12]])).toMatchObject({ subtotal: 5130, shipping: 0 });
+    expect(t('US', [['MUG', 12]], 'SAVE10')).toMatchObject({ coupon: 513, shipping: 800, tax: 379, total: 5796 });
+  });
+  test('UK threshold is 4000', () => {
+    expect(t('UK', [['MUG', 9]])).toMatchObject({ subtotal: 4050, shipping: 0, tax: 810, total: 4860 });
+    expect(REGIONS.UK).toEqual({ code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+  test('percentOf rounds half up', () => {
+    for (const p of [5, 7, 10, 20])
+      for (let a = 0; a <= 20000; a++) expect(percentOf(a, p / 100)).toBe(Math.floor((a * p + 50) / 100));
+  });
+});
