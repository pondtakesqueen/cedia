diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 17:41:37.863454016 +0000
@@ -0,0 +1,48 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { percentOf } from '../src/money/round.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+describe('pricing rules', () => {
+  test('10 units get 5% off', () => {
+    // 1200 - 60 = 1140; ship 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('9 units get none, 50 units get only 10%', () => {
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]!.discount).toBe(0);
+    expect(totals(cart('US', [['PEN', 49]])).lines[0]!.discount).toBe(294);
+    // 6000 - 600 = 5400; free shipping; tax 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same sku merge before pricing', () => {
+    const c = cart('US', [['PEN', 5], ['MUG', 1], ['PEN', 5]]);
+    const t = totals(c);
+    expect(t.lines.length).toBe(2);
+    expect(t.lines[0]).toMatchObject({ sku: 'PEN', quantity: 10, discount: 60 });
+    expect(c.lines[0]!.quantity).toBe(5);
+  });
+
+  test('free shipping uses the subtotal after the coupon', () => {
+    // 6000 - 600 = 5400 < 6000 -> shipping 900; tax 20% of 6300 = 1260
+    expect(totals(cart('EU', [['TEE', 4]], 'SAVE10'))).toMatchObject({ coupon: 600, shipping: 900, tax: 1260, total: 7560 });
+  });
+
+  test('FLAT5 never goes below zero', () => {
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('UK ships free from 4000', () => {
+    expect(REGIONS.UK!.freeShippingFrom).toBe(4000);
+    expect(totals(cart('UK', [['TEE', 2], ['CAP', 1]]))).toMatchObject({ shipping: 0, tax: 840, total: 5040 });
+  });
+
+  test('percentOf matches exact integer rounding', () => {
+    for (const rate of [0.05, 0.1, 0.07, 0.2]) {
+      const bp = Math.round(rate * 10000);
+      for (let a = 0; a <= 20000; a++) expect(percentOf(a, rate)).toBe(Math.floor((a * bp * 2 + 10000) / 20000));
+    }
+  });
+});
