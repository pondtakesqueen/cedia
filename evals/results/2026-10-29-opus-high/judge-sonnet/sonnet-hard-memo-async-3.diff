+    for (const [k, e] of cache) if (e.expires <= now()) cache.delete(k);
+  };
   const call = ((key: K) => {
     const hit = cache.get(key);
-    if (hit && hit.expires > now()) return hit.promise;
+    if (hit && hit.expires > now()) {
+      cache.delete(key);
+      cache.set(key, hit);
+      return hit.promise;
+    }
     cache.delete(key);
-    if (cache.size > opts.max) cache.delete(cache.keys().next().value as K);
-    const entry = { promise: fn(key), expires: Infinity };
+    dropExpired();
+    while (cache.size >= opts.max) cache.delete(cache.keys().next().value as K);
+    const entry = { promise: new Promise<V>((resolve) => resolve(fn(key))), expires: Infinity };
     cache.set(key, entry);
+    // Only the entry still in the cache is updated, in place so its position stays.
     entry.promise.then(
-      (value) => cache.set(key, { promise: Promise.resolve(value), expires: now() + opts.ttlMs }),
-      () => cache.delete(key),
+      () => {
+        if (cache.get(key) === entry) entry.expires = now() + opts.ttlMs;
+      },
+      () => {
+        if (cache.get(key) === entry) cache.delete(key);
+      },
     );
     return entry.promise;
   }) as Memo<K, V>;
   call.invalidate = (key) => void cache.delete(key);
   call.clear = () => cache.clear();
-  Object.defineProperty(call, "size", { get: () => cache.size });
+  Object.defineProperty(call, "size", { get: () => (dropExpired(), cache.size) });
   return call;
 }
