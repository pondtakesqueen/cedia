diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-29 17:32:57.099284631 +0000
@@ -0,0 +1,120 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+function setup(opts: { max: number; ttlMs?: number }) {
+  const t = { v: 0 };
+  const calls: { key: string; res: (v: string) => void; rej: (e: unknown) => void }[] = [];
+  const fn = (key: string) => new Promise<string>((res, rej) => calls.push({ key, res, rej }));
+  return { t, calls, m: memo(fn, { ttlMs: 100, ...opts, now: () => t.v }) };
+}
+
+test("invalidated in-flight result does not overwrite a newer call", async () => {
+  const { calls, m } = setup({ max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[1]!.res("new");
+  calls[0]!.res("old");
+  await tick();
+  expect(await second).toBe("new");
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("an invalidated call that settles is not kept", async () => {
+  const { calls, m } = setup({ max: 10 });
+  m("k");
+  m.invalidate("k");
+  calls[0]!.res("old");
+  await tick();
+  expect(m.size).toBe(0);
+});
+
+test("a rejected old call does not drop a newer entry", async () => {
+  const { calls, m } = setup({ max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  m("k");
+  calls[0]!.rej(new Error("x"));
+  await expect(first).rejects.toThrow("x");
+  await tick();
+  expect(m.size).toBe(1);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("an evicted key's settlement is not re-added", async () => {
+  const { calls, m } = setup({ max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.res("a");
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("clear forgets in-flight keys", async () => {
+  const { calls, m } = setup({ max: 5 });
+  m("a");
+  m("b");
+  m.clear();
+  calls[0]!.res("a");
+  calls[1]!.res("b");
+  await tick();
+  expect(m.size).toBe(0);
+});
+
+test("a cache hit makes the key most recently used", async () => {
+  const { calls, m } = setup({ max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.res("a");
+  calls[1]!.res("b");
+  await tick();
+  await m("a");
+  m("c");
+  await m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("settling is not a use", async () => {
+  const { calls, m } = setup({ max: 2 });
+  m("a");
+  m("b");
+  calls[1]!.res("b");
+  calls[0]!.res("a");
+  await tick();
+  m("c");
+  expect(m.size).toBe(2);
+  m("b");
+  expect(calls).toHaveLength(3);
+});
+
+test("expired keys are not counted and do not push out live keys", async () => {
+  const { t, calls, m } = setup({ max: 2 });
+  m("a");
+  calls[0]!.res("a");
+  await tick();
+  t.v = 50;
+  m("b");
+  calls[1]!.res("b");
+  await tick();
+  t.v = 100;
+  expect(m.size).toBe(1);
+  m("c");
+  m("b");
+  expect(calls).toHaveLength(3);
+});
+
+test("a synchronous throw rejects and is not kept", async () => {
+  const m = memo((k: string): Promise<string> => {
+    throw new Error("boom");
+  }, { ttlMs: 100, max: 2 });
+  await expect(m("k")).rejects.toThrow("boom");
+  expect(m.size).toBe(0);
+});
