diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.tiers.test.ts b/edit.tiers.test.ts
--- a/edit.tiers.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.tiers.test.ts	2026-10-29 17:25:33.063258236 +0000
@@ -0,0 +1,52 @@
+import { expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+test('replace_all does not relax tier 2', () => {
+  const r = applyEdit('a \nb\na  \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true });
+  expect('error' in r && r.error).toContain('matches 2 places');
+});
+test('indentation ambiguity lists lines', () => {
+  const r = applyEdit('  a\n  b\n    a\n b\n', { old_text: 'a\nb', new_text: 'c' });
+  expect('error' in r && r.error).toContain('1, 3');
+});
+test('no window includes the pseudo-line after the final newline', () => {
+  const r = applyEdit('a\n', { old_text: 'a\n\n', new_text: 'x' });
+  expect('error' in r && r.error).toContain('not found');
+});
+test('pointer lists at most 5 lines', () => {
+  const r = applyEdit('x\n'.repeat(7), { old_text: 'x\ny', new_text: 'z' });
+  expect('error' in r && r.error).toContain('line 1, 2, 3, 4, 5');
+  expect('error' in r && r.error).not.toContain('6');
+});
+test('deleting everything leaves empty content', () => {
+  const r = applyEdit('  a\n', { old_text: 'a ', new_text: '' });
+  expect('error' in r).toBe(false);
+  expect('content' in r && r.content).toBe('');
+});
+
+test('exact to covers a trailing blank line', () => {
+  const r = applyEdit('x\n\ny\n', { old_text: 'x\n\n', new_text: 'q\n' });
+  expect('applied' in r && r.applied).toEqual({ from: 1, to: 2, tier: 'exact', count: 1 });
+});
+test('exact replace_all to is the last match end', () => {
+  const r = applyEdit('a\nb\nx\na\nb\n', { old_text: 'a\nb', new_text: 'z', replace_all: true });
+  expect('applied' in r && r.applied).toEqual({ from: 1, to: 5, tier: 'exact', count: 2 });
+});
+test('newline-only old_text is not found', () => {
+  for (const c of ['abc', '']) {
+    const r = applyEdit(c, { old_text: '\n', new_text: 'x' });
+    expect('error' in r && r.error).toContain('not found');
+  }
+});
+test('dedented new_text line is left as given', () => {
+  const r = applyEdit('\ta\n', { old_text: '    a', new_text: '    b\n  c' });
+  expect('content' in r && r.content).toBe('\tb\n  c\n');
+});
+test('no final newline stays without one; CRLF matches in tier 2', () => {
+  const r = applyEdit('a \nb', { old_text: 'a\nb', new_text: 'c' });
+  expect('content' in r && r.content).toBe('c');
+  const r2 = applyEdit('a\r\nb\r\n', { old_text: 'a\nb', new_text: 'c' });
+  expect('applied' in r2 && r2.applied.tier).toBe('trailing-space');
+  const r3 = applyEdit('  a\n  b', { old_text: 'a\nb', new_text: 'c' });
+  expect('content' in r3 && r3.content).toBe('  c');
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-29 17:23:09.943650600 +0000
+++ b/edit.ts	2026-10-29 17:25:33.062525149 +0000
@@ -23,5 +23,70 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create or replace a whole file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same' };
+
+  const lineAt = (idx: number) => content.slice(0, idx).split('\n').length;
+  const starts: number[] = [];
+  for (let i = content.indexOf(old_text); i !== -1; i = content.indexOf(old_text, i + old_text.length)) starts.push(i);
+  if (starts.length > 1 && !edit.replace_all) {
+    return { error: `old_text matches ${starts.length} places (first match at line ${lineAt(starts[0])}); add context or set replace_all` };
+  }
+  if (starts.length > 0) {
+    let out = '';
+    let pos = 0;
+    for (const i of starts) {
+      out += content.slice(pos, i) + new_text;
+      pos = i + old_text.length;
+    }
+    out += content.slice(pos);
+    const to = lineAt(starts[starts.length - 1] + old_text.length - 1);
+    return { content: out, applied: { from: lineAt(starts[0]), to, tier: 'exact', count: starts.length } };
+  }
+
+  const toLines = (t: string) => {
+    const s = t.endsWith('\n') ? t.slice(0, -1) : t;
+    return s === '' ? [] : s.split('\n');
+  };
+  const oldLines = toLines(old_text);
+  const newLines = toLines(new_text);
+  const trailingNewline = content.endsWith('\n');
+  const lines = toLines(content);
+  const indentOf = (l: string) => l.match(/^[ \t]*/)![0];
+  const firstNonBlank = (ls: string[]) => ls.find((l) => l.trim() !== '');
+
+  const tiers: [Tier, (l: string) => string][] = [
+    ['trailing-space', (l) => l.trimEnd()],
+    ['indentation', (l) => l.trim()],
+  ];
+  for (const [tier, norm] of oldLines.length ? tiers : []) {
+    const want = oldLines.map(norm);
+    const hits: number[] = [];
+    for (let i = 0; i + want.length <= lines.length; i++) {
+      if (want.every((w, k) => norm(lines[i + k]) === w)) hits.push(i);
+    }
+    if (hits.length > 1) {
+      return { error: `old_text matches ${hits.length} places (${tier}) at lines ${hits.map((h) => h + 1).join(', ')}` };
+    }
+    if (hits.length === 0) continue;
+    const at = hits[0];
+    let repl = newLines;
+    if (tier === 'indentation') {
+      const from = indentOf(firstNonBlank(oldLines) ?? '');
+      const to = indentOf(firstNonBlank(lines.slice(at, at + oldLines.length)) ?? '');
+      repl = newLines.map((l) => (l.trim() === '' || !l.startsWith(from) ? l : to + l.slice(from.length)));
+    }
+    const out = [...lines.slice(0, at), ...repl, ...lines.slice(at + oldLines.length)];
+    const text = out.join('\n') + (trailingNewline && out.length ? '\n' : '');
+    return { content: text, applied: { from: at + 1, to: at + oldLines.length, tier, count: 1 } };
+  }
+
+  let msg = 'old_text not found';
+  const first = firstNonBlank(oldLines)?.trim();
+  if (first) {
+    const found = lines.flatMap((l, i) => (l.includes(first) ? [i + 1] : [])).slice(0, 5);
+    if (found.length) msg += `; first line appears at line ${found.join(', ')}`;
+  }
+  return { error: msg };
 }
