@@ -1,5 +1,5 @@
 import { homedir } from 'node:os';
-import { isAbsolute, relative, resolve } from 'node:path';
+import { basename, isAbsolute, relative, resolve } from 'node:path';
 
 export type Hit = { name: 'force-push' | 'reset-hard' | 'clean-force' | 'rm-outside'; reason: string };
 
@@ -36,5 +36,59 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  const args = argv.slice(1);
+  switch (basename(argv[0] ?? '')) {
+    case 'git': return gitHit(args);
+    case 'rm': return rmHit(args, cwd);
+    case 'find': return findHit(args, cwd);
+    default: return undefined;
+  }
+}
+
+const shortGroup = (w: string) => /^-[^-]/.test(w);
+const longFlag = (w: string, name: string) => w === name || w.startsWith(name + '=');
+const unresolvable = (p: string) => p.includes('$') || /^~[^/]/.test(p);
+const GIT_VALUE_OPTS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += GIT_VALUE_OPTS.has(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const bad = rest.find(
+      (w) =>
+        ['--force', '--force-with-lease', '--mirror', '--delete', '--prune'].some((n) => longFlag(w, n)) ||
+        (shortGroup(w) && /[fd]/.test(w)) ||
+        (!w.startsWith('-') && /^[+:]/.test(w)),
+    );
+    if (bad !== undefined) return { name: 'force-push', reason: `\`git push ${bad}\` rewrites or deletes remote history` };
+  } else if (sub === 'reset') {
+    if (rest.includes('--hard')) return { name: 'reset-hard', reason: '`git reset --hard` discards local changes' };
+  } else if (sub === 'clean') {
+    const force = rest.find((w) => w === '--force' || (shortGroup(w) && w.includes('f')));
+    if (force !== undefined && !rest.includes('-n') && !rest.includes('--dry-run'))
+      return { name: 'clean-force', reason: `\`git clean ${force}\` deletes untracked files` };
+  }
+  return undefined;
+}
+
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const before = dd < 0 ? args : args.slice(0, dd);
+  const targets = [...before.filter((w) => !w.startsWith('-')), ...(dd < 0 ? [] : args.slice(dd + 1))];
+  if (!before.some((w) => w === '--recursive' || (shortGroup(w) && /[rR]/.test(w)))) return undefined;
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r has no targets of its own' };
+  const bad = targets.find((t) => unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd));
+  if (bad !== undefined) return { name: 'rm-outside', reason: `rm -r target "${bad}" is outside ${cwd}` };
+  return undefined;
+}
+
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const end = args.findIndex((w) => w.startsWith('-'));
+  const starts = args.slice(0, end < 0 ? args.length : end);
+  const bad = (starts.length ? starts : ['.']).find((p) => unresolvable(p) || !insideWorkspace(p, cwd));
+  if (bad !== undefined) return { name: 'rm-outside', reason: `find start path "${bad}" is outside ${cwd}` };
+  return undefined;
 }
