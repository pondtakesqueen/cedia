diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 17:19:52.677276396 +0000
@@ -0,0 +1,61 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('git global options and paths', () => {
+  expect(hit('/usr/local/bin/git reset --hard')).toBe('reset-hard');
+  expect(hit('git -C push status')).toBeUndefined();
+  expect(hit('git --work-tree w --namespace n push -f')).toBe('force-push');
+  expect(hit('git -C')).toBeUndefined();
+  expect(hit('git')).toBeUndefined();
+});
+
+test('push flags', () => {
+  for (const n of ['--force', '--force-with-lease', '--mirror', '--delete', '--prune'])
+    for (const f of [n, n + '=x']) expect(hit(`git push ${f}`)).toBe('force-push');
+  for (const f of ['-uf', '-du']) expect(hit(`git push ${f}`)).toBe('force-push');
+  for (const f of ['-u', '-v', 'origin x:+y']) expect(hit(`git push ${f}`)).toBeUndefined();
+  expect(hit('git push origin +x')).toBe('force-push');
+  expect(hit('git push origin :x')).toBe('force-push');
+});
+
+test('reset and clean', () => {
+  expect(hit('git reset HEAD')).toBeUndefined();
+  expect(hit('git clean --force')).toBe('clean-force');
+  expect(hit('git clean --force -n')).toBeUndefined();
+  expect(hit('git clean -fn')).toBe('clean-force');
+});
+
+test('rm', () => {
+  expect(hit('/bin/rm /etc/passwd')).toBeUndefined();
+  expect(hit('/bin/rm -R /etc')).toBe('rm-outside');
+  expect(hit('rm -r -- ok')).toBeUndefined();
+  expect(hit('rm -rf')).toBe('rm-outside');
+  expect(hit('rm -rf --')).toBe('rm-outside');
+  for (const t of ['a$b', '~x', '${HOME}', '.', './', '/work/repo', '/work/repo/', '..', '/']) expect([t, hit(`rm -rf ${t}`)]).toEqual([t, 'rm-outside']);
+  for (const t of ['*', './*', 'src/*.js']) expect([t, hit(`rm -rf ${t}`)]).toEqual([t, undefined]);
+});
+
+test('find', () => {
+  expect(hit('find -delete')).toBeUndefined();
+  expect(hit('find src -name / -delete')).toBeUndefined();
+  expect(hit('find /work/repo -delete')).toBeUndefined();
+  expect(hit('find ~bob -exec x ;')).toBe('rm-outside');
+});
+
+test('other commands', () => {
+  for (const l of ['ls', 'gitx push -f', 'rmdir -r /']) expect(hit(l)).toBeUndefined();
+});
+
+test('rm agrees with insideWorkspace/sameDir', () => {
+  const ts: string[] = [];
+  for (const p of ['', './', '../', '/', '/work/repo/', '/work/', '~/']) for (const n of ['', '.', '..', 'a', 'a/b', '*']) ts.push(p + n);
+  const bad = (t: string) => !insideWorkspace(t, cwd) || sameDir(t, cwd);
+  for (const t of ts) {
+    if (t === '') continue;
+    expect([t, denyListed(['rm', '-rf', t], cwd)?.name === 'rm-outside']).toEqual([t, bad(t)]);
+    for (const u of ts) if (u !== '') expect(denyListed(['rm', '-rf', t, u], cwd)?.name === 'rm-outside').toBe(bad(t) || bad(u));
+  }
+});
