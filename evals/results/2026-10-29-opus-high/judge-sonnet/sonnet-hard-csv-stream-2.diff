+
+/** Incremental `parseCsv`: feed chunks to `push`, call `end` once the input is over. */
+export class CsvStream {
+  // 0 field start, 1 unquoted, 2 quoted, 3 quote seen inside quoted, 4 after the closing quote
+  private mode = 0;
+  private cr = false; // a `\r` is waiting for the next char to say whether it ends the row
+  private first = true;
+  private rowStart = true;
+  private field = "";
+  private row: string[] = [];
+  private offset = 0;
+  private failed: SyntaxError | undefined;
+
+  push(chunk: string): string[][] {
+    return this.guard(() => this.pushChunk(chunk));
+  }
+
+  end(): string[][] {
+    return this.guard(() => this.finish());
+  }
+
+  /** After a SyntaxError every later call throws it again, so a rejected input never yields more rows. */
+  private guard(run: () => string[][]): string[][] {
+    if (this.failed) throw this.failed;
+    try {
+      return run();
+    } catch (e) {
+      if (e instanceof SyntaxError) this.failed = e;
+      throw e;
+    }
+  }
+
+  private pushChunk(chunk: string): string[][] {
+    const rows: string[][] = [];
+    for (let k = 0; k < chunk.length; k++) {
+      const c = chunk[k]!;
+      this.offset++;
+      if (this.first) {
+        this.first = false;
+        if (c === "\ufeff") continue;
+      }
+      this.rowStart = false;
+      this.step(c, rows);
+    }
+    return rows;
+  }
+
+  private finish(): string[][] {
+    const rows: string[][] = [];
+    if (this.rowStart) return rows;
+    if (this.mode === 2) throw new SyntaxError("a quoted field is still open at the end of the input");
+    if (this.cr) {
+      if (this.mode === 4) throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.offset - 1}`);
+      this.field += "\r";
+      this.cr = false;
+    }
+    this.row.push(this.field);
+    rows.push(this.row);
+    this.field = "";
+    this.row = [];
+    this.mode = 0;
+    this.rowStart = true;
+    return rows;
+  }
+
+  private endField() {
+    this.row.push(this.field);
+    this.field = "";
+    this.mode = 0;
+  }
+
+  private endRow(rows: string[][]) {
+    this.endField();
+    rows.push(this.row);
+    this.row = [];
+    this.rowStart = true;
+  }
+
+  private step(c: string, rows: string[][]) {
+    if (this.cr) {
+      this.cr = false;
+      if (c === "\n") return this.endRow(rows);
+      if (this.mode === 4) throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.offset - 2}`);
+      this.field += "\r";
+    }
+    if (this.mode === 3) {
+      if (c === '"') {
+        this.field += '"';
+        this.mode = 2;
+        return;
+      }
+      this.mode = 4;
+    } else if (this.mode === 2) {
+      if (c === '"') this.mode = 3;
+      else this.field += c;
+      return;
+    } else if (this.mode === 0) {
+      if (c === '"') {
+        this.mode = 2;
+        return;
+      }
+      this.mode = 1;
+    }
+    // mode 1 or 4
+    if (c === ",") this.endField();
+    else if (c === "\n") this.endRow(rows);
+    else if (c === "\r") this.cr = true;
+    else if (this.mode === 4) throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${this.offset - 1}`);
+    else if (c === '"') throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.offset - 1}`);
+    else this.field += c;
+  }
+}
