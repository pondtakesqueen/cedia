diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.stream.test.ts b/csv.stream.test.ts
--- a/csv.stream.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/csv.stream.test.ts	2026-10-29 17:16:47.264835062 +0000
@@ -0,0 +1,108 @@
+import { expect, test } from "bun:test";
+import { CsvStream, parseCsv } from "./csv";
+
+function run(s: string, cuts: number[]): string[][] {
+  const st = new CsvStream();
+  const out: string[][] = [];
+  let p = 0;
+  for (const c of [...cuts, s.length]) {
+    out.push(...st.push(s.slice(p, c)));
+    p = c;
+  }
+  out.push(...st.end());
+  return out;
+}
+
+function agree(s: string, cuts: number[]) {
+  let expected: string[][] | Error;
+  try {
+    expected = parseCsv(s);
+  } catch (e) {
+    expected = e as Error;
+  }
+  if (expected instanceof Error) {
+    expect(() => run(s, cuts)).toThrow(SyntaxError);
+    try {
+      run(s, cuts);
+    } catch (e) {
+      expect((e as Error).message).toBe(expected.message);
+    }
+  } else expect(run(s, cuts)).toEqual(expected);
+}
+
+test("a pending \\r, a quote at a chunk end and a quote doubled across chunks", () => {
+  const s = new CsvStream();
+  expect(s.push("a,b\r")).toEqual([]);
+  expect(s.push("\nc\r")).toEqual([["a", "b"]]);
+  expect(s.push('d,"x"')).toEqual([]);
+  expect(s.push('"y')).toEqual([]);
+  expect(s.push('"\r')).toEqual([]);
+  expect(s.push("\n")).toEqual([["c\rd", 'x"y']]);
+  expect(s.end()).toEqual([]);
+});
+
+test("errors arrive with the chunk that shows them", () => {
+  const a = new CsvStream();
+  expect(a.push('"a"')).toEqual([]);
+  expect(() => a.push("b")).toThrow(SyntaxError);
+  const b = new CsvStream();
+  b.push('"a"\r');
+  expect(() => b.push("x")).toThrow(SyntaxError);
+  const c = new CsvStream();
+  c.push('"ab');
+  expect(() => c.end()).toThrow(SyntaxError);
+  const d = new CsvStream();
+  d.push('"a"\r');
+  expect(() => d.end()).toThrow(SyntaxError);
+});
+
+test("the BOM is dropped only at the very start", () => {
+  const s = new CsvStream();
+  s.push("");
+  expect(s.push("\ufeffa\n")).toEqual([["a"]]);
+  expect(run("a\ufeff", [1])).toEqual([["a\ufeff"]]);
+  expect(run("\ufeff", [])).toEqual([]);
+});
+
+test("every split of every short input matches parseCsv", () => {
+  const alphabet = ["a", ",", '"', "\r", "\n", "\ufeff"];
+  const gen = (s: string, n: number) => {
+    if (n === 0) {
+      for (let mask = 0; mask < 1 << Math.max(0, s.length - 1); mask++) {
+        const cuts = [];
+        for (let k = 1; k < s.length; k++) if (mask & (1 << (k - 1))) cuts.push(k);
+        agree(s, cuts);
+      }
+      return;
+    }
+    for (const a of alphabet) gen(s + a, n - 1);
+  };
+  for (let n = 0; n <= 5; n++) gen("", n);
+});
+
+test("work per chunk does not grow with earlier input", () => {
+  const s = new CsvStream();
+  s.push('"');
+  for (let i = 0; i < 300000; i++) s.push("x");
+  expect(s.push('"\n')).toHaveLength(1);
+  let n = 0;
+  for (let i = 0; i < 100000; i++) n += s.push("a,b\n").length;
+  expect(n).toBe(100000);
+});
+
+test("after a SyntaxError every later call throws it again", () => {
+  const s = new CsvStream();
+  let first: unknown;
+  try {
+    s.push('"a"b');
+  } catch (e) {
+    first = e;
+  }
+  expect(first).toBeInstanceOf(SyntaxError);
+  expect(() => s.push("\nx\n")).toThrow(first as Error);
+  expect(() => s.end()).toThrow(first as Error);
+  const t = new CsvStream();
+  t.push('"ab');
+  expect(() => t.end()).toThrow(SyntaxError);
+  expect(() => t.end()).toThrow(SyntaxError);
+});
