diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.rules.test.ts b/sse.rules.test.ts
--- a/sse.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.rules.test.ts	2026-10-29 17:38:51.827305717 +0000
@@ -0,0 +1,65 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+test('chunking never changes the result', async () => {
+  const texts = ['data: a\r\ndata: b\r\n\r\nevent: e\r\ndata: สวัสดี 🙂\r\n\r\ndata: tail', ':x\ndata: a\n\n', 'event: e', 'data: a\r', 'data\ndata\n\n'];
+  for (const t of texts) {
+    const whole = await all(t, 1000);
+    for (let n = 1; n <= 12; n++) expect(await all(t, n)).toEqual(whole);
+  }
+});
+
+test('edge cases', async () => {
+  expect(await all('data\ndata\n\n')).toEqual([{ data: '\n' }]);
+  expect(await all('data: a\r')).toEqual([{ data: 'a' }]);
+  expect(await all('event: e')).toEqual([]);
+  expect(await all(':\n\n')).toEqual([]);
+  expect(Object.keys((await all('event: a\n\ndata: x\n\n'))[0]!)).toEqual(['data']);
+});
+
+test('stream error propagates', async () => {
+  let sent = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (sent) return c.error(new Error('boom'));
+      sent = true;
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+    },
+  });
+  const it = readSse(body);
+  expect((await it.next()).value).toEqual({ data: 'a' });
+  await expect(it.next()).rejects.toThrow('boom');
+});
+
+test('early exit cancels and releases', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    start(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\ndata: b\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const _ of readSse(body)) break;
+  expect(cancelled).toBe(true);
+  expect(body.locked).toBe(false);
+});
+
+test('a lone \\r tail after a data line still yields the message', async () => {
+  expect(await all('data: a\n\r')).toEqual([{ data: 'a' }]);
+  expect(await all('data: a\r\n\r')).toEqual([{ data: 'a' }]);
+});
+
+test('a very long line in tiny chunks is handled in linear time', async () => {
+  const big = 'x'.repeat(300_000);
+  const t = performance.now();
+  expect(await all(`data: ${big}\n\n`, 3)).toEqual([{ data: big }]);
+  expect(performance.now() - t).toBeLessThan(5000);
+});
