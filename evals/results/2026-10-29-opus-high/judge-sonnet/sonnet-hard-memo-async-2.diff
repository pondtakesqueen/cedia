diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-29 17:31:59.756122177 +0000
@@ -0,0 +1,130 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("expiry counts from when the promise settled", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  t = 500;
+  calls[0]!.d.resolve("v");
+  await tick();
+  t = 599;
+  await m("k");
+  expect(calls).toHaveLength(1);
+  t = 600;
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection reaches every waiter and is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(new Error("x"));
+  await expect(a).rejects.toThrow("x");
+  await expect(b).rejects.toThrow("x");
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale rejection does not delete a newer entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("x"));
+  await expect(first).rejects.toThrow("x");
+  await tick();
+  m("k");
+  expect(calls).toHaveLength(2);
+  expect(m.size).toBe(1);
+});
+
+test("max 1 keeps one key", () => {
+  const { fn } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  expect(m.size).toBe(1);
+});
+
+test("a dropped key's late result is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  expect(m.size).toBe(1);
+  m("b");
+  expect(calls).toHaveLength(2);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a cache hit makes the key most recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  m("a");
+  m("c");
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("clear forgets in-flight keys too", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("a");
+  m("b");
+  m.clear();
+  expect(m.size).toBe(0);
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  expect(m.size).toBe(0);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a stale result does not change a newer call still in flight", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  await tick();
+  t = 1000;
+  expect(m("k")).toBe(second);
+  expect(calls).toHaveLength(2);
+});
