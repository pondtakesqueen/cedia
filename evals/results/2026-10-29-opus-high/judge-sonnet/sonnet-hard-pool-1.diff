diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.fix.test.ts b/pool.fix.test.ts
--- a/pool.fix.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.fix.test.ts	2026-10-29 17:35:10.705995258 +0000
@@ -0,0 +1,119 @@
+import { test, expect } from "bun:test";
+import { runPool } from "./pool";
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+function deferred<T>() {
+  let resolve!: (v: T) => void, reject!: (e: unknown) => void;
+  const promise = new Promise<T>((a, b) => ((resolve = a), (reject = b)));
+  return { promise, resolve, reject };
+}
+
+test("invalid limit/retries reject with RangeError and start nothing", async () => {
+  let calls = 0;
+  const t = () => (calls++, 1);
+  for (const l of [0, -1, 1.5, NaN]) await expect(runPool([t], l)).rejects.toBeInstanceOf(RangeError);
+  for (const r of [-1, 1.5, NaN]) await expect(runPool([t], 1, { retries: r })).rejects.toBeInstanceOf(RangeError);
+  expect(calls).toBe(0);
+  expect((await runPool([t], Infinity))[0].status).toBe("fulfilled");
+});
+
+test("never exceeds limit, starts in order, results by index", async () => {
+  const ds = [0, 1, 2, 3, 4].map(() => deferred<number>());
+  const started: number[] = [];
+  let cur = 0, peak = 0;
+  const tasks = ds.map((d, i) => () => {
+    started.push(i);
+    peak = Math.max(peak, ++cur);
+    return d.promise.finally(() => cur--);
+  });
+  const p = runPool(tasks, 2);
+  expect(started).toEqual([0, 1]);
+  ds[1].resolve(1);
+  await tick();
+  expect(started).toEqual([0, 1, 2]);
+  for (const i of [4, 3, 2, 0]) { ds[i].resolve(i); await tick(); }
+  const r = await p;
+  expect(peak).toBe(2);
+  expect(r).toEqual([0, 1, 2, 3, 4].map((value) => ({ status: "fulfilled", value, attempts: 1 })));
+});
+
+test("sync throw and plain values", async () => {
+  const r = await runPool([() => { throw new Error("x"); }, () => 5], 1);
+  expect(r[0]).toMatchObject({ status: "rejected", attempts: 1 });
+  expect(r[1]).toEqual({ status: "fulfilled", value: 5, attempts: 1 });
+});
+
+test("retries count", async () => {
+  let n = 0;
+  const r = await runPool([() => { n++; throw new Error("x"); }], 1, { retries: 2 });
+  expect(n).toBe(3);
+  expect(r[0].attempts).toBe(3);
+  let m = 0;
+  const r2 = await runPool([() => { if (m++ === 0) throw new Error("x"); return 1; }], 1, { retries: 3 });
+  expect(r2[0]).toEqual({ status: "fulfilled", value: 1, attempts: 2 });
+});
+
+test("pre-aborted signal starts nothing", async () => {
+  const ac = new AbortController();
+  ac.abort("why");
+  let n = 0;
+  const r = await runPool([() => n++, () => n++], 1, { signal: ac.signal });
+  expect(n).toBe(0);
+  expect(r).toEqual([
+    { status: "rejected", reason: "why", attempts: 0 },
+    { status: "rejected", reason: "why", attempts: 0 },
+  ]);
+});
+
+test("abort mid-run: in flight keeps result, rest rejected, retry cancelled", async () => {
+  const ac = new AbortController();
+  const d = deferred<number>();
+  const calls: number[] = [];
+  const p = runPool([() => (calls.push(0), d.promise), () => (calls.push(1), 1), () => (calls.push(2), 2)], 1, { signal: ac.signal });
+  ac.abort("stop");
+  d.resolve(7);
+  const r = await p;
+  expect(calls).toEqual([0]);
+  expect(r[0]).toEqual({ status: "fulfilled", value: 7, attempts: 1 });
+  expect(r[2]).toEqual({ status: "rejected", reason: "stop", attempts: 0 });
+
+  const ac2 = new AbortController();
+  const d2 = deferred<number>();
+  let n = 0;
+  const p2 = runPool([() => (n++, d2.promise)], 1, { retries: 2, signal: ac2.signal });
+  ac2.abort("stop");
+  d2.reject(new Error("e"));
+  expect(await p2).toEqual([{ status: "rejected", reason: "stop", attempts: 1 }]);
+  expect(n).toBe(1);
+});
+
+test("empty tasks", async () => {
+  expect(await runPool([], 3)).toEqual([]);
+});
+
+test("abort after retries are used up keeps own reason; cancelled later retry reports its attempts", async () => {
+  const run = async (retries: number) => {
+    const ac = new AbortController();
+    const ds = [deferred<number>(), deferred<number>(), deferred<number>()];
+    let n = 0;
+    const p = runPool([() => ds[n++].promise], 1, { retries, signal: ac.signal });
+    return { ac, ds, p, calls: () => n };
+  };
+
+  const a = await run(1);
+  const err = new Error("e2");
+  a.ds[0].reject(new Error("e1"));
+  await tick();
+  expect(a.calls()).toBe(2);
+  a.ac.abort("stop");
+  a.ds[1].reject(err);
+  expect(await a.p).toEqual([{ status: "rejected", reason: err, attempts: 2 }]);
+
+  const b = await run(2);
+  b.ds[0].reject(new Error("e1"));
+  await tick();
+  b.ac.abort("stop");
+  b.ds[1].reject(new Error("e2"));
+  expect(await b.p).toEqual([{ status: "rejected", reason: "stop", attempts: 2 }]);
+  expect(b.calls()).toBe(2);
+});
