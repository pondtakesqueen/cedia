+  });
+
+  test('a callId snapshotted twice concatenates its lists; an empty list gives nothing; a snapshot without callId or intent is ignored', () => {
+    const [intent, result] = edit('a.ts');
+    const id = intent!.kind === 'tool_intent' ? intent!.callId : '';
+    expect(
+      ledgerEntries(
+        [intent!, { kind: 'snapshot', callId: id, changed: ['x'] }, result!, { kind: 'snapshot', callId: id, changed: ['y', 'z'] }],
+        [],
+      ),
+    ).toEqual([
+      { kind: 'write', at: 2, tool: 'edit', path: 'x' },
+      { kind: 'write', at: 2, tool: 'edit', path: 'y' },
+      { kind: 'write', at: 2, tool: 'edit', path: 'z' },
+    ]);
+    const [empty, emptyResult] = bash('npm install');
+    const emptyId = empty!.kind === 'tool_intent' ? empty!.callId : '';
+    expect(ledgerEntries([empty!, emptyResult!, { kind: 'snapshot', callId: emptyId, changed: [] }], [])).toEqual([]);
+    expect(ledgerEntries([...edit('b.ts'), { kind: 'snapshot', changed: ['q'] }], [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'b.ts' }]);
+    expect(ledgerEntries([{ kind: 'snapshot', callId: 'nobody', changed: ['q'] }], [])).toEqual([]);
+  });
+
+  test('failed write gives nothing; failed bash mutating command is a write; ls is not', () => {
+    expect(ledgerEntries(edit('a.ts', 'failed', 'write'), [])).toEqual([]);
+    expect(ledgerEntries(bash('npm install', 1), [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'npm install' }]);
+    expect(ledgerEntries(bash('ls -la'), [])).toEqual([]);
+  });
+
+  test('malformed inputs are skipped, not thrown on', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'm1', tool: 'bash', input: {} },
+      { kind: 'tool_result', callId: 'm1', status: 'completed', output: { isError: false } },
+      { kind: 'tool_intent', callId: 'm2', tool: 'edit', input: { path: 7 } },
+      { kind: 'tool_result', callId: 'm2', status: 'completed', output: { isError: false } },
+    ];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([]);
+  });
+});
+
+describe('evidence and verified rules', () => {
+  test('unverified is the writes after the last passing check, first seen first', () => {
+    expect(evidence([w(0, 'a.ts'), c(1, 0), w(2, 'a.ts'), w(3, undefined, 'npm i'), c(4, 1)]).unverified).toEqual(['a.ts', 'bash: npm i']);
+    expect(evidence([w(0, 'a.ts'), c(1, 1)]).unverified).toEqual(['a.ts']);
+  });
+
+  test('verified is true with no declared checks or no writes', () => {
+    expect(verified([w(0, 'a.ts'), c(1, 0)], [])).toBe(true);
+    expect(verified([c(0, 0)], ['bun test'])).toBe(true);
+  });
+
+  test('agreement between verified and evidence over seeded random logs', () => {
+    let seed = 12345;
+    const rand = () => {
+      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+      return seed / 0x80000000;
+    };
+    const pick = (i: number): LedgerEntry => {
+      const k = Math.floor(rand() * 4);
+      if (k === 0) return w(i, 'a.ts');
+      if (k === 1) return w(i, 'b.ts');
+      if (k === 2) return w(i, undefined, 'npm i');
+      return c(i, Math.floor(rand() * 2));
+    };
+    for (let iter = 0; iter < 500; iter++) {
+      const len = Math.floor(rand() * 9);
+      const entries = Array.from({ length: len }, (_, i) => pick(i));
+      const ev = evidence(entries);
+      expect(verified(entries, ['bun test'])).toBe(ev.unverified.length === 0);
+      for (const u of ev.unverified) expect(ev.changed).toContain(u);
+      for (let k = 0; k <= entries.length; k++) {
+        const rest = entries.slice(k);
+        if (rest.length > 0 && rest[0]!.kind === 'check' && rest[0]!.exitCode === 0) {
+          expect(ev.unverified).toEqual(evidence(rest).unverified);
+        }
+      }
+    }
+  });
+});
