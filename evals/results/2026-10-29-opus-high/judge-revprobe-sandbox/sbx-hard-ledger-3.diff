+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+let n = 0;
+const bash = (command: string, exitCode = 0, status: 'completed' | 'failed' | 'denied' | 'not_started' = exitCode ? 'failed' : 'completed'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool: 'bash', input: { command } },
+    { kind: 'tool_result', callId, status, output: { isError: exitCode !== 0, exitCode } },
+  ];
+};
+const edit = (path: string, status: 'completed' | 'failed' = 'completed', tool = 'edit'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool, input: { path } },
+    { kind: 'tool_result', callId, status, output: { isError: status !== 'completed' } },
+  ];
+};
+const w = (at: number, path?: string, command?: string): LedgerEntry => (path ? { kind: 'write', at, tool: 'edit', path } : { kind: 'write', at, tool: 'bash', command: command! });
+const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+describe('matchCheck rules', () => {
+  test('whitespace is collapsed and the check is returned as written', () => {
+    expect(matchCheck('  bun   test  ', ['bun test'])).toBe('bun test');
+    expect(matchCheck('bun test src', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test 2>&1', ['bun test'])).toBe('bun test');
+    expect(matchCheck('bun test', ['bun  test 2>&1'])).toBe('bun  test 2>&1');
+  });
+
+  test('pipes, chains and sequences do not count', () => {
+    expect(matchCheck('bun test | tail', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test && echo ok', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test; true', ['bun test'])).toBeUndefined();
+  });
+
+  test('one leading cd to cwd is removed, quotes and trailing slashes included', () => {
+    expect(matchCheck('cd .', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd . && bun test', ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd "/work/repo" && bun test', ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd sub/.. && bun test', ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd /work/repo/sub && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /work/repo && bun test', ['bun test'])).toBeUndefined();
+    expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+});
+
+describe('ledgerEntries rules', () => {
+  test('a result pairs only with an intent since the last request', () => {
+    const [intent, result] = edit('a.ts');
+    expect(ledgerEntries([intent!, { kind: 'request' }, result!], [])).toEqual([]);
+    expect(ledgerEntries([{ kind: 'tool_result', callId: 'x', status: 'completed', output: { isError: false } }], [])).toEqual([]);
+  });
+
+  test('denied results never count, even with a snapshot', () => {
+    const [intent, result] = bash('sed -i s/a/b/ x.ts', 0, 'denied');
+    const id = intent!.kind === 'tool_intent' ? intent!.callId : '';
+    expect(ledgerEntries([intent!, result!, { kind: 'snapshot', callId: id, changed: ['x.ts'] }], [])).toEqual([]);
+  });
+
+  test('check exit codes: explicit code, missing code with isError false or true', () => {
+    const noCode = (callId: string, isError: boolean): SessionEvent[] => [
+      { kind: 'tool_intent', callId, tool: 'bash', input: { command: 'bun test' } },
+      { kind: 'tool_result', callId, status: isError ? 'failed' : 'completed', output: { isError } },
+    ];
+    expect(ledgerEntries([...noCode('p', false), ...noCode('q', true)], ['bun test'])).toEqual([
+      { kind: 'check', at: 1, command: 'bun test', exitCode: 0 },
+      { kind: 'check', at: 3, command: 'bun test', exitCode: 1 },
+    ]);
+    expect(ledgerEntries(bash('bun test', 2), ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 2 }]);
+  });
+
+  test('a snapshot before the result still counts, and wins over the edit and bash rules', () => {
+    const callId = 'snap1';
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId, tool: 'edit', input: { path: 'ignored.ts' } },
+      { kind: 'snapshot', callId, changed: ['real.ts'] },
+      { kind: 'tool_result', callId, status: 'failed', output: { isError: true } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'edit', path: 'real.ts' }]);
+    const [ls, lsResult] = bash('ls');
