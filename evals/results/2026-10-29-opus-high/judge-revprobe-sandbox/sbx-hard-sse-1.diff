diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.rules.test.ts b/sse.rules.test.ts
--- a/sse.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.rules.test.ts	2026-10-30 03:22:59.962638990 +0000
@@ -0,0 +1,74 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+const texts = [
+  'event: a\r\ndata: สวัสดี 🙂\r\n\r\ndata: x\ndata: y\n\n',
+  ': c\ndata:  two\nid: 1\n\ndata\n\nevent: e\n\n',
+  'data: one\n\ndata: [DONE]',
+];
+
+test('every chunk size gives the same messages as one big chunk', async () => {
+  for (const text of texts) {
+    const whole = await all(text, 1000);
+    for (let chunk = 1; chunk <= 16; chunk++) expect(await all(text, chunk)).toEqual(whole);
+  }
+});
+
+test('a CRLF split exactly between two chunks', async () => {
+  for (let chunk = 1; chunk <= 12; chunk++) expect(await all('data: a\r\n\r\n', chunk)).toEqual([{ data: 'a' }]);
+  expect(await all('data: a\r', 3)).toEqual([{ data: 'a' }]);
+});
+
+test('only one space is dropped; a colon-only value keeps its colon', async () => {
+  expect(await all('data: \n\n')).toEqual([{ data: '' }]);
+  expect(await all('data::x\n\n')).toEqual([{ data: ':x' }]);
+});
+
+test('the last event line wins', async () => {
+  expect(await all('event: a\nevent: b\ndata: x\n\n')).toEqual([{ event: 'b', data: 'x' }]);
+});
+
+test('only a field named exactly data counts', async () => {
+  expect(await all('datax: 1\ndata: 2\n\n')).toEqual([{ data: '2' }]);
+});
+
+test('blank lines in a row yield nothing extra', async () => {
+  expect(await all('\n\n\ndata: a\n\n\n\n')).toEqual([{ data: 'a' }]);
+});
+
+test('pending data at the end of the body, with a trailing CR or no data', async () => {
+  expect(await all('event: e\ndata: x')).toEqual([{ event: 'e', data: 'x' }]);
+  expect(await all('event: e')).toEqual([]);
+  expect(await all('data: x\r')).toEqual([{ data: 'x' }]);
+});
+
+test('an error from the body reaches the caller unchanged', async () => {
+  const boom = new Error('boom');
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+      throw boom;
+    },
+  });
+  const seen: SseMessage[] = [];
+  let caught: unknown;
+  try {
+    for await (const m of readSse(body)) seen.push(m);
+  } catch (e) {
+    caught = e;
+  }
+  expect(seen).toEqual([{ data: 'a' }]);
+  expect(caught).toBe(boom);
+});
+
+test('a consumer that stops early releases the body', async () => {
+  const body = streamFromString('data: a\n\n'.repeat(100), 3);
+  for await (const _ of readSse(body)) break;
+  expect(body.locked).toBe(false);
+});
