 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNIT_MS: Record<string, number> = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1_000, ms: 1 };
+const PART = /(\d+(?:\.\d+)?)(ms|d|h|m|s)\s*/g;
+const WHOLE = /^(?:\d+(?:\.\d+)?(?:ms|d|h|m|s)\s*)+$/;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const trimmed = text.trim();
+  if (!WHOLE.test(trimmed)) throw new Error(`invalid duration: ${JSON.stringify(text)}`);
+  let total = 0;
+  for (const [, n, unit] of trimmed.matchAll(PART)) total += Number(n) * UNIT_MS[unit];
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  let out = '';
+  for (const [unit, size] of Object.entries(UNIT_MS)) {
+    const q = Math.floor(rest / size);
+    if (q > 0) out += `${q}${unit}`;
+    rest -= q * size;
+  }
+  return out || '0s';
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
--- a/src/lru.ts	2026-10-30 03:28:31.535518291 +0000
+++ b/src/lru.ts	2026-10-30 03:30:31.281627872 +0000
@@ -14,30 +14,78 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
 
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
+  // Map insertion order is recency order: oldest first.
+  private map = new Map<K, Entry<V>>();
+
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.map.get(key);
+    if (!entry) return undefined;
+    if (!this.live(entry)) {
+      this.remove(key, entry, 'expired');
+      return undefined;
+    }
+    this.map.delete(key);
+    this.map.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.map.delete(key);
+    this.map.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    for (const [k, e] of [...this.map]) {
+      if (!this.live(e)) this.remove(k, e, 'expired');
+    }
+    while (this.map.size > this.capacity) {
+      const [k, e] = this.map.entries().next().value as [K, Entry<V>];
+      this.remove(k, e, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.map.get(key);
+    if (!entry) return false;
+    if (!this.live(entry)) {
+      this.remove(key, entry, 'expired');
+      return false;
+    }
+    this.remove(key, entry, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const e of this.map.values()) if (this.live(e)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const out: K[] = [];
+    for (const [k, e] of this.map) if (this.live(e)) out.push(k);
+    return out.reverse();
+  }
+
+  private live(entry: Entry<V>): boolean {
+    return this.now() < entry.expires;
+  }
+
+  // Removes from the map first, so onEvict sees the cache in its final state.
+  private remove(key: K, entry: Entry<V>, reason: EvictReason): void {
+    this.map.delete(key);
+    this.onEvict?.(key, entry.value, reason);
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-30 03:28:31.535579836 +0000
+++ b/src/slug.ts	2026-10-30 03:30:31.270195483 +0000
@@ -11,10 +11,24 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { 'ß': 'ss', 'æ': 'ae', 'œ': 'oe', 'ø': 'o', 'ł': 'l', 'đ': 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  const cut = slug.lastIndexOf('-', max);
+  return cut > 0 ? slug.slice(0, cut) : slug.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 03:30:31.290957799 +0000
@@ -0,0 +1,51 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('each unit', () => {
+  expect(parseDuration('2d')).toBe(172_800_000);
+  expect(parseDuration('3h')).toBe(10_800_000);
+  expect(parseDuration('3m')).toBe(180_000);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('7s')).toBe(7_000);
+  expect(parseDuration('250ms')).toBe(250);
+});
+
+test('several parts, with or without spaces', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('1h30m')).toBe(5_400_000);
+  expect(parseDuration('1h 30m 5s')).toBe(5_405_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+});
+
+test('fractions round to whole milliseconds', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('1.5ms')).toBe(2);
+  expect(parseDuration('0.4ms')).toBe(0);
+});
+
+test('rejects anything else, naming the input', () => {
+  for (const bad of ['', '10', '5x', 'h', '-1s', '1h junk', '1 h']) {
+    expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+  }
+});
+
+test('format uses the largest units, skipping zero parts', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(86_400_000)).toBe('1d');
+});
+
+test('format rejects negative and non-finite input', () => {
+  expect(() => formatDuration(-1)).toThrow('-1');
+  expect(() => formatDuration(NaN)).toThrow();
+  expect(() => formatDuration(Infinity)).toThrow();
+});
+
+test('parse reverses format', () => {
+  for (let i = 0; i < 200; i++) {
+    const ms = (i * 7_919_993) % 10 ** 9;
+    expect(parseDuration(formatDuration(ms))).toBe(ms);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 03:30:36.286155144 +0000
@@ -0,0 +1,168 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+test('a hit makes the key most recently used', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log: string[] = [];
+  cache.onEvict = (k, v, r) => log.push(`${k}${v}:${r}`);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(log).toEqual(['b2:capacity']);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('an entry is live before t+ttl and gone at t+ttl', () => {
+  let t = 0;
+  const log: string[] = [];
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.onEvict = (k, v, r) => log.push(`${k}${v}:${r}`);
+  cache.set('a', 1);
+  t = 999;
+  expect(cache.get('a')).toBe(1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+  expect(log).toEqual(['a1:expired']);
+});
+
+test('a hit does not renew the ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 500;
+  expect(cache.get('a')).toBe(1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('set on an existing key resets the ttl and makes it most recent, with no callback', () => {
+  let t = 0;
+  const log: string[] = [];
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.onEvict = (k, v, r) => log.push(`${k}${v}:${r}`);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('a', 3);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  expect(cache.size).toBe(2);
+  t = 800;
+  cache.set('a', 4);
+  t = 1500;
+  expect(cache.get('a')).toBe(4);
+  expect(cache.keys()).toEqual(['a']);
+  expect(log).toEqual([]);
+});
+
+test('expired entries are removed before live ones on overflow', () => {
+  let t = 0;
+  const log: string[] = [];
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = (k, v, r) => log.push(`${k}${v}:${r}`);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1000;
+  cache.set('c', 3);
+  expect(log).toEqual(['a1:expired']);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('expired entries stay stored while the cache is within capacity', () => {
+  let t = 0;
+  const log: string[] = [];
+  const cache = new LRU<string, number>(3, 1000, () => t);
+  cache.onEvict = (k, v, r) => log.push(`${k}${v}:${r}`);
+  cache.set('a', 1);
+  t = 1000;
+  cache.set('b', 2);
+  expect(log).toEqual([]);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+});
+
+test('delete reports live, expired and missing keys differently', () => {
+  let t = 0;
+  const log: string[] = [];
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.onEvict = (k, v, r) => log.push(`${k}${v}:${r}`);
+  cache.set('a', 1);
+  cache.set('c', 3);
+  expect(cache.delete('a')).toBe(true);
+  t = 1000;
+  expect(cache.delete('c')).toBe(false);
+  expect(cache.delete('zz')).toBe(false);
+  expect(log).toEqual(['a1:delete', 'c3:expired']);
+});
+
+test('size and keys skip expired entries and fire no callbacks', () => {
+  let t = 0;
+  const log: string[] = [];
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.onEvict = (k, v, r) => log.push(`${k}${v}:${r}`);
+  cache.set('a', 1);
+  t = 1000;
+  expect(cache.size).toBe(0);
+  expect(cache.keys()).toEqual([]);
+  expect(log).toEqual([]);
+});
+
+test('matches a simple model under seeded random operations', () => {
+  let t = 0;
+  let seed = 7;
+  const rnd = (n: number) => {
+    seed = (Math.imul(seed, 1103515245) + 12345) >>> 0;
+    return Math.floor((seed / 2 ** 32) * n);
+  };
+  const realLog: string[] = [];
+  const modelLog: string[] = [];
+  const cache = new LRU<string, number>(3, 10, () => t);
+  cache.onEvict = (k, v, r) => realLog.push(`${k}${v}:${r}`);
+  type E = { key: string; value: number; expires: number };
+  let model: E[] = [];
+  const live = (e: E) => t < e.expires;
+  const gone = (e: E, reason: string) => modelLog.push(`${e.key}${e.value}:${reason}`);
+
+  for (let step = 0; step < 500; step++) {
+    const key = `k${rnd(5)}`;
+    const op = rnd(10);
+    if (op < 4) {
+      cache.set(key, step);
+      model = model.filter((e) => e.key !== key);
+      model.push({ key, value: step, expires: t + 10 });
+      if (model.length > 3) {
+        const expired = model.filter((e) => !live(e));
+        model = model.filter(live);
+        expired.forEach((e) => gone(e, 'expired'));
+        while (model.length > 3) gone(model.shift()!, 'capacity');
+      }
+    } else if (op < 7) {
+      const i = model.findIndex((e) => e.key === key);
+      let want: number | undefined;
+      if (i >= 0) {
+        const [e] = model.splice(i, 1);
+        if (live(e)) {
+          want = e.value;
+          model.push(e);
+        } else gone(e, 'expired');
+      }
+      expect(cache.get(key)).toBe(want);
+    } else if (op < 8) {
+      const i = model.findIndex((e) => e.key === key);
+      let want = false;
+      if (i >= 0) {
+        const [e] = model.splice(i, 1);
+        want = live(e);
+        gone(e, want ? 'delete' : 'expired');
+      }
+      expect(cache.delete(key)).toBe(want);
+    } else {
+      t += rnd(6);
+    }
+    const alive = model.filter(live);
+    expect(cache.size).toBe(alive.length);
+    expect(cache.keys()).toEqual(alive.map((e) => e.key).reverse());
+    expect(realLog).toEqual(modelLog);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 03:30:31.301839635 +0000
@@ -0,0 +1,50 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('lower case and diacritics', () => {
+  expect(slugify('ABC')).toBe('abc');
+  expect(slugify('àçñź')).toBe('acnz');
+});
+
+test('special letters', () => {
+  expect(slugify('ß æ œ ø ł đ')).toBe('ss-ae-oe-o-l-d');
+  expect(slugify('ØŁ')).toBe('ol');
+});
+
+test('separators collapse and are trimmed', () => {
+  expect(slugify('  --a__b!!c--  ')).toBe('a-b-c');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('v2 0')).toBe('v2-0');
+});
+
+test('cut at the last dash that keeps the slug within max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+});
+
+test('cut at max when there is no dash to cut at', () => {
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('abc', 3)).toBe('abc');
+  expect(slugify('abc', 10)).toBe('abc');
+});
+
+test('a cut never leaves a dangling dash and is a prefix of the full slug', () => {
+  for (const title of ['Hello, World! This is a test', 'Crème brûlée à la mode']) {
+    const full = slugify(title);
+    for (let max = 1; max <= 12; max++) {
+      const cut = slugify(title, max);
+      expect(cut.length).toBeLessThanOrEqual(max);
+      expect(cut.startsWith('-')).toBe(false);
+      expect(cut.endsWith('-')).toBe(false);
+      expect(full.startsWith(cut)).toBe(true);
+    }
+  }
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set(['x']))).toBe('post');
+  const taken = new Set(['post', 'post-2']);
+  expect(uniqueSlug('post', taken)).toBe('post-3');
+  expect(taken.size).toBe(2);
+});
