diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-30 03:04:56.318190366 +0000
@@ -0,0 +1,45 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('git global options with values are skipped', () => {
+  expect(hit('git --namespace x push -f')).toBe('force-push');
+  expect(hit('git -c a=b status')).toBeUndefined();
+  expect(hit('git --work-tree=/x push -f')).toBe('force-push');
+});
+
+test('push flags alone or with =value, and refspecs', () => {
+  expect(hit('git push --delete=x origin')).toBe('force-push');
+  expect(hit('git push origin +a:b')).toBe('force-push');
+  expect(hit('git push --mirror')).toBe('force-push');
+  expect(hit('git push -u origin x')).toBeUndefined();
+});
+
+test('clean dry-run wins over force, except inside a group', () => {
+  expect(hit('git clean --force -n')).toBeUndefined();
+  expect(hit('git clean -fn')).toBe('clean-force');
+  expect(hit('git clean -nf')).toBe('clean-force');
+});
+
+test('rm long flags do not count as short groups', () => {
+  expect(hit('rm --force /etc')).toBeUndefined();
+});
+
+test('unresolvable rm targets', () => {
+  expect(hit('rm -r ~x')).toBe('rm-outside');
+  expect(hit('rm -r ~/')).toBe('rm-outside');
+});
+
+test('find with no start path means cwd', () => {
+  expect(hit('find -exec x ;')).toBeUndefined();
+  expect(hit('find ~bob -delete')).toBe('rm-outside');
+});
+
+test('rm -r targets outside, unresolvable, or the workspace itself are denied', () => {
+  for (const p of ['/', '~', '~/', '~/x', '~bob', '$HOME', 'a$b', '.', './', '..', '../x', '/work/repo', '/work/repo/.', 'src/..', 'a/../../b', '/work/repository', '/etc/passwd'])
+    expect([p, hit(`rm -r ${p}`)]).toEqual([p, 'rm-outside']);
+  for (const p of ['src', './src/a', '/work/repo/x', '*', './*'])
+    expect([p, hit(`rm -r ${p}`)]).toEqual([p, undefined]);
+});
