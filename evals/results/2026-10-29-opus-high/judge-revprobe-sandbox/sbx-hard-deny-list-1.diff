 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+// Global git options that take the next word as their value.
+const GIT_VALUE_OPTS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+// A short flag group such as -fu or -df that contains one of `letters`; long flags never match.
+const shortGroup = (w: string, letters: string) => /^-[^-]/.test(w) && [...letters].some((c) => w.includes(c));
+// The word is `name` or `name=value`.
+const flagIs = (w: string, name: string) => w === name || w.startsWith(name + '=');
+// A path that cannot be resolved before the command runs: contains $, or is ~user.
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+
 // Looks at one simple command's argv (already split, quotes removed) and returns a Hit when it must be denied.
