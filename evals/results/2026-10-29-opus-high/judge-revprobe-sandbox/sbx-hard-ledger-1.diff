 // The whole command must be the check, after trimming and collapsing whitespace on both, and dropping a trailing
 // ` 2>&1` from both. A pipe or a chain would hide the check's exit code, so `bun test | tail` does not count.
 // One exception: a leading `cd <dir> && ` is removed when <dir> (quotes stripped) resolves to `cwd`.
+const norm = (s: string) => s.trim().replace(/\s+/g, ' ').replace(/ 2>&1$/, '');
+
 export function matchCheck(command: string, checks: string[], cwd?: string): string | undefined {
-  throw new Error('not implemented');
+  let cmd = norm(command);
+  const m = cwd === undefined ? null : /^cd ("[^"]*"|'[^']*'|\S+) && /.exec(cmd);
+  if (m && cwd !== undefined && resolve(cwd, m[1]!.replace(/["']/g, '')) === resolve(cwd)) cmd = cmd.slice(m[0].length);
+  return checks.find(c => norm(c) === cmd);
 }
 
 // Walks the log and returns one entry per thing that happened, in log order.
@@ -38,18 +43,52 @@
 // - Otherwise an edit or write call that completed is a write entry with path = input.path.
 // - Otherwise a bash call whose command is not read-only is a write entry with command set (no path).
 export function ledgerEntries(events: SessionEvent[], checks: string[], cwd?: string): LedgerEntry[] {
-  throw new Error('not implemented');
+  const snapshots = new Map<string, string[]>();
+  for (const e of events) {
+    if (e.kind === 'snapshot' && e.callId !== undefined) snapshots.set(e.callId, [...(snapshots.get(e.callId) ?? []), ...e.changed]);
+  }
+  const entries: LedgerEntry[] = [];
+  const pending = new Map<string, Extract<SessionEvent, { kind: 'tool_intent' }>>();
+  events.forEach((e, at) => {
+    if (e.kind === 'request') pending.clear();
+    else if (e.kind === 'tool_intent') pending.set(e.callId, e);
+    else if (e.kind === 'tool_result') {
+      const intent = pending.get(e.callId);
+      pending.delete(e.callId);
+      if (!intent || e.status === 'denied' || e.status === 'not_started') return;
+      const command = intent.tool === 'bash' && typeof intent.input.command === 'string' ? intent.input.command : undefined;
+      const check = command === undefined ? undefined : matchCheck(command, checks, cwd);
+      if (check !== undefined) {
+        entries.push({ kind: 'check', at, command: check, exitCode: e.output.exitCode ?? (e.output.isError ? 1 : 0) });
+      } else if (snapshots.has(e.callId)) {
+        for (const path of snapshots.get(e.callId)!) entries.push({ kind: 'write', at, tool: intent.tool, path });
+      } else if ((intent.tool === 'edit' || intent.tool === 'write') && e.status === 'completed') {
+        entries.push({ kind: 'write', at, tool: intent.tool, path: intent.input.path as string });
+      } else if (command !== undefined && !isReadOnly(command)) {
+        entries.push({ kind: 'write', at, tool: 'bash', command });
+      }
+    }
+  });
+  return entries;
 }
 
 // changed: every write's label (path, or `bash: <command>`), first seen first, no duplicates.
 // checks: every check entry, in order, as { command, exitCode }.
 // unverified: labels of writes after the last passing check (all of them when no check passed), deduped.
 export function evidence(entries: LedgerEntry[]): Evidence {
-  throw new Error('not implemented');
+  const label = (e: LedgerEntry & { kind: 'write' }) => e.path ?? `bash: ${e.command}`;
+  const labels = (es: LedgerEntry[]) => es.flatMap(e => (e.kind === 'write' ? [label(e)] : []));
+  const lastPass = entries.findLastIndex(e => e.kind === 'check' && e.exitCode === 0);
+  return {
+    changed: [...new Set(labels(entries))],
+    checks: entries.flatMap(e => (e.kind === 'check' ? [{ command: e.command, exitCode: e.exitCode }] : [])),
+    unverified: [...new Set(labels(entries.slice(lastPass + 1)))],
+  };
 }
 
 // The done gate. With no declared checks, or no writes, it is satisfied. Otherwise a check with exit code 0
 // must come after the last write.
 export function verified(entries: LedgerEntry[], checks: string[]): boolean {
-  throw new Error('not implemented');
+  const lastWrite = entries.findLastIndex(e => e.kind === 'write');
+  return checks.length === 0 || lastWrite === -1 || entries.slice(lastWrite + 1).some(e => e.kind === 'check' && e.exitCode === 0);
 }
