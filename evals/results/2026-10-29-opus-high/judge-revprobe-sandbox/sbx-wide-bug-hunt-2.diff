diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-30 03:26:31.842160735 +0000
@@ -0,0 +1,95 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { percentOf } from '../src/money/round.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+import { shippingFor } from '../src/pricing/shipping.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('R1: a line subtotal is unit price times quantity', () => {
+    expect(totals(cart('US', [['MUG', 3]])).lines[0]).toMatchObject({ subtotal: 1350, discount: 0, total: 1350 });
+  });
+
+  test('R2a: 10 or more units of a SKU get 5% off that line', () => {
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('R2a: 9 units get no bulk discount', () => {
+    expect(totals(cart('US', [['PEN', 9]]))).toMatchObject({ subtotal: 1080, shipping: 800, tax: 132, total: 2012 });
+  });
+
+  test('R2b: 50 or more units get 10% off, and only that tier', () => {
+    const t = totals(cart('US', [['PEN', 50]]));
+    expect(t.lines[0]).toMatchObject({ subtotal: 6000, discount: 600, total: 5400 });
+    expect(t).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('R2b: 49 units get the 5% tier, not 10%', () => {
+    expect(totals(cart('US', [['PEN', 49]])).lines[0]).toMatchObject({ subtotal: 5880, discount: 294, total: 5586 });
+  });
+
+  test('R2c: units of one SKU split across lines reach the 50-unit tier', () => {
+    expect(totals(cart('US', [['PEN', 25], ['PEN', 25]])).lines[0]).toMatchObject({ quantity: 50, discount: 600 });
+  });
+
+  test('R2c: lines of the same SKU are merged before pricing', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    const t = totals(c);
+    expect(t.lines.length).toBe(1);
+    expect(t.lines[0]).toMatchObject({ quantity: 10, subtotal: 1200, discount: 60, total: 1140 });
+    expect(t).toMatchObject({ subtotal: 1140, total: 2076 });
+    expect(c.lines.map((l) => l.quantity)).toEqual([6, 4]);
+  });
+
+  test('R3: FLAT5 takes 500 off but never below zero', () => {
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ subtotal: 120, coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('R4: shipping is decided on the subtotal after the coupon', () => {
+    expect(totals(cart('US', [['TEE', 2], ['CAP', 2]], 'FLAT5'))).toMatchObject({ subtotal: 5400, coupon: 500, shipping: 800, tax: 399, total: 6099 });
+  });
+
+  test('R4: shipping is free at exactly the threshold', () => {
+    expect(shippingFor(REGIONS.US, 5000)).toBe(0);
+    expect(shippingFor(REGIONS.US, 4999)).toBe(800);
+  });
+
+  test('regions match the README table', () => {
+    expect(REGIONS).toMatchObject({
+      US: { taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 },
+      EU: { taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 },
+      UK: { taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 },
+    });
+    expect(totals(cart('UK', [['TEE', 2], ['CAP', 1]]))).toMatchObject({ subtotal: 4200, shipping: 0, tax: 840, total: 5040 });
+  });
+
+  test('R5/R6: tax is on discounted subtotal plus shipping, and the total is the sum', () => {
+    const carts = [
+      cart('US', [['MUG', 2]]),
+      cart('US', [['PEN', 10]], 'SAVE10'),
+      cart('US', [['PEN', 50]]),
+      cart('US', [['TEE', 2], ['CAP', 2]], 'FLAT5'),
+      cart('EU', [['BAG', 1]]),
+      cart('EU', [['BAG', 3], ['PEN', 12]], 'SAVE10'),
+      cart('UK', [['TEE', 2], ['CAP', 1]]),
+      cart('UK', [['MUG', 1]], 'FLAT5'),
+      cart('UK', [['BAG', 1], ['MUG', 9]]),
+      cart('EU', [['PEN', 1]], 'FLAT5'),
+    ];
+    for (const c of carts) {
+      const t = totals(c);
+      const rate = REGIONS[c.region]!.taxRate;
+      expect(t.tax).toBe(percentOf(t.subtotal - t.coupon + t.shipping, rate));
+      expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+    }
+  });
+
+  test('R7: percentOf rounds half up to the cent, matching whole-number arithmetic', () => {
+    for (const p of [5, 7, 10, 20]) {
+      for (let amount = 0; amount <= 20000; amount++) {
+        expect(percentOf(amount, p / 100)).toBe(Math.floor((amount * p + 50) / 100));
+      }
+    }
+  });
+});
