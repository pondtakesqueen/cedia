diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.rules.test.ts b/sse.rules.test.ts
--- a/sse.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.rules.test.ts	2026-10-30 03:24:49.710163071 +0000
@@ -0,0 +1,101 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+test('a message is yielded before the next chunk is read', async () => {
+  let pulls = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (pulls++ === 0) c.enqueue(new TextEncoder().encode('data: a\n\n'));
+      else throw new Error('read ahead');
+    },
+  });
+  const it = readSse(body);
+  expect(await it.next()).toEqual({ value: { data: 'a' }, done: false });
+  await expect(it.next()).rejects.toThrow('read ahead');
+});
+
+test('CRLF split between chunks, and a lone CR stays in the value', async () => {
+  for (let chunk = 1; chunk <= 12; chunk++) expect(await all('data: a\r\n\r\n', chunk)).toEqual([{ data: 'a' }]);
+  expect(await all('data: a\rb\n\n')).toEqual([{ data: 'a\rb' }]);
+});
+
+test('a line starting with a colon is a comment', async () => {
+  expect(await all(':data: x\n\n')).toEqual([]);
+});
+
+test('one space after the colon is dropped; only the first colon splits', async () => {
+  expect(await all('data: \n\n')).toEqual([{ data: '' }]);
+  expect(await all('data:a:b\n\n')).toEqual([{ data: 'a:b' }]);
+});
+
+test('data lines join with newline; other fields are ignored', async () => {
+  expect(await all('data\ndata\n\n')).toEqual([{ data: '\n' }]);
+  expect(await all('id: 1\nfoo: 2\n\n')).toEqual([]);
+});
+
+test('a blank line resets event; messages without event have no event key', async () => {
+  const out = await all('event: a\n\n\n\ndata: x\n\n');
+  expect(out).toEqual([{ data: 'x' }]);
+  expect(Object.keys(out[0]!)).toEqual(['data']);
+});
+
+test('at end of body, pending data is flushed', async () => {
+  expect(await all('event: e\ndata: x')).toEqual([{ event: 'e', data: 'x' }]);
+  expect(await all('event: e')).toEqual([]);
+  expect(await all('data: x\r')).toEqual([{ data: 'x' }]);
+});
+
+test('whole-body and chunked reading agree', async () => {
+  const pieces = ['data: ', 'event: ', ':c', 'id: 1', '\n', '\r\n', '', 'é', '🙂', 'x'];
+  let seed = 12345;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  for (let t = 0; t < 200; t++) {
+    let text = '';
+    const len = 1 + rand(12);
+    for (let i = 0; i < len; i++) text += pieces[rand(pieces.length)];
+    const whole = await all(text, 1 << 20);
+    for (let n = 1; n <= 8; n++) expect(await all(text, n)).toEqual(whole);
+  }
+});
+
+test('a body error rejects next() with the same error', async () => {
+  const err = new Error('boom');
+  const body = new ReadableStream<Uint8Array>({
+    start(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n'));
+      c.error(err);
+    },
+  });
+  const it = readSse(body);
+  await expect(it.next()).rejects.toBe(err);
+});
+
+test('breaking early cancels the body and releases the lock', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const _ of readSse(body)) break;
+  expect(cancelled).toBe(true);
+  expect(body.locked).toBe(false);
+});
+
+test('a long line split into many chunks is read in linear time', async () => {
+  const out = await all(`data: ${'x'.repeat(200_000)}\n\n`, 10);
+  expect(out.length).toBe(1);
+  expect(out[0]!.data.length).toBe(200_000);
+});
