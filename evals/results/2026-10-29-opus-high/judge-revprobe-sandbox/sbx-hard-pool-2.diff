diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.rules.test.ts b/pool.rules.test.ts
--- a/pool.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.rules.test.ts	2026-10-30 03:21:58.325434493 +0000
@@ -0,0 +1,307 @@
+import { expect, test } from "bun:test";
+import { runPool } from "./pool";
+
+const flush = async () => {
+  for (let i = 0; i < 20; i++) await Promise.resolve();
+};
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((a, b) => {
+    resolve = a;
+    reject = b;
+  });
+  return { promise, resolve, reject };
+}
+
+// Counts how many tasks are in flight at once and the most that ever were.
+function meter() {
+  const m = { active: 0, max: 0 };
+  const wrap = <T>(fn: () => Promise<T> | T) => async () => {
+    m.active++;
+    m.max = Math.max(m.max, m.active);
+    try {
+      return await fn();
+    } finally {
+      m.active--;
+    }
+  };
+  return { m, wrap };
+}
+
+test("rule 1: bad limit or retries is refused before any task starts", async () => {
+  for (const limit of [0, -1, 1.5, NaN, -Infinity]) {
+    let called = 0;
+    await expect(runPool([() => ++called], limit)).rejects.toBeInstanceOf(RangeError);
+    expect(called).toBe(0);
+  }
+  for (const retries of [-1, 0.5, NaN, Infinity]) {
+    let called = 0;
+    await expect(runPool([() => ++called], 1, { retries })).rejects.toBeInstanceOf(RangeError);
+    expect(called).toBe(0);
+  }
+});
+
+test("rule 1: a limit of Infinity is accepted", async () => {
+  const out = await runPool([() => 1, () => 2], Infinity);
+  expect(out.map((r) => r.status)).toEqual(["fulfilled", "fulfilled"]);
+});
+
+test("rule 2: exactly `limit` tasks start, in input order, and a settle starts the next one", async () => {
+  const ds = Array.from({ length: 10 }, () => deferred<number>());
+  const started: number[] = [];
+  const { m, wrap } = meter();
+  const tasks = ds.map((d, i) =>
+    wrap(() => {
+      started.push(i);
+      return d.promise;
+    }),
+  );
+  const run = runPool(tasks, 3);
+  await flush();
+  expect(started).toEqual([0, 1, 2]);
+
+  ds[1].resolve(1);
+  await flush();
+  expect(started).toEqual([0, 1, 2, 3]);
+
+  for (const i of [0, 2, 3, 4, 5, 6, 7, 8, 9]) ds[i].resolve(i);
+  await flush();
+  const out = await run;
+  expect(out.length).toBe(10);
+  expect(m.max).toBe(3);
+});
+
+test("rule 2: results sit in input slots even when tasks finish in reverse", async () => {
+  const ds = Array.from({ length: 5 }, () => deferred<number>());
+  const run = runPool(
+    ds.map((d) => () => d.promise),
+    5,
+  );
+  for (let i = 4; i >= 0; i--) {
+    ds[i].resolve(i * 10);
+    await flush();
+  }
+  const out = await run;
+  expect(out.map((r) => (r.status === "fulfilled" ? r.value : null))).toEqual([0, 10, 20, 30, 40]);
+});
+
+test("rule 2: any timing gives the same values in the same slots, never over the limit", async () => {
+  let seed = 7;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  for (let n = 0; n <= 12; n++) {
+    for (const limit of [1, 2, 3, 4, 5, Infinity]) {
+      const { m, wrap } = meter();
+      const tasks = Array.from({ length: n }, (_, i) =>
+        wrap(async () => {
+          for (let k = rand(6); k > 0; k--) await null;
+          return i;
+        }),
+      );
+      const out = await runPool(tasks, limit);
+      expect(out.map((r) => (r.status === "fulfilled" ? r.value : null))).toEqual(Array.from({ length: n }, (_, i) => i));
+      expect(m.max).toBe(Math.min(limit, n));
+    }
+  }
+});
+
+test("rule 3: a synchronous throw is a rejection and a plain value is a fulfilment", async () => {
+  const boom = new Error("boom");
+  const out = await runPool(
+    [
+      () => {
+        throw boom;
+      },
+      () => 42,
+    ],
+    2,
+  );
+  expect(out).toEqual([
+    { status: "rejected", reason: boom, attempts: 1 },
+    { status: "fulfilled", value: 42, attempts: 1 },
+  ]);
+});
+
+test("rule 4: a task that fails twice then works is fulfilled after 3 attempts", async () => {
+  let calls = 0;
+  const out = await runPool(
+    [
+      async () => {
+        calls++;
+        if (calls < 3) throw new Error("again");
+        return "ok";
+      },
+    ],
+    1,
+    { retries: 2 },
+  );
+  expect(out).toEqual([{ status: "fulfilled", value: "ok", attempts: 3 }]);
+  expect(calls).toBe(3);
+});
+
+test("rule 4: retries stop at `retries` more calls and report the attempts made", async () => {
+  let calls = 0;
+  const err = new Error("always");
+  const out = await runPool(
+    [
+      async () => {
+        calls++;
+        throw err;
+      },
+    ],
+    1,
+    { retries: 2 },
+  );
+  expect(out).toEqual([{ status: "rejected", reason: err, attempts: 3 }]);
+  expect(calls).toBe(3);
+
+  const none = await runPool([async () => Promise.reject(err)], 1);
+  expect(none).toEqual([{ status: "rejected", reason: err, attempts: 1 }]);
+});
+
+test("rule 4: retries keep their slot and do not exceed the limit", async () => {
+  const { m, wrap } = meter();
+  const fails = new Map<number, number>();
+  const tasks = [0, 1, 2, 3].map((i) =>
+    wrap(async () => {
+      const n = (fails.get(i) ?? 0) + 1;
+      fails.set(i, n);
+      await null;
+      if (n <= i % 2) throw new Error("retry me");
+      return i;
+    }),
+  );
+  const out = await runPool(tasks, 2, { retries: 2 });
+  expect(out.map((r) => (r.status === "fulfilled" ? [r.value, r.attempts] : null))).toEqual([
+    [0, 1],
+    [1, 2],
+    [2, 1],
+    [3, 2],
+  ]);
+  expect(m.max).toBe(2);
+});
+
+test("rule 5: an abort starts nothing more; in-flight tasks keep their result; unstarted ones reject with the reason", async () => {
+  const ds = Array.from({ length: 5 }, () => deferred<number>());
+  const called: number[] = [];
+  const ac = new AbortController();
+  const run = runPool(
+    ds.map((d, i) => () => {
+      called.push(i);
+      return d.promise;
+    }),
+    2,
+    { signal: ac.signal },
+  );
+  await flush();
+  expect(called).toEqual([0, 1]);
+
+  ac.abort("stop");
+  ds[0].resolve(0);
+  await flush();
+  ds[1].resolve(1);
+  const out = await run;
+
+  expect(called).toEqual([0, 1]);
+  expect(out[0]).toEqual({ status: "fulfilled", value: 0, attempts: 1 });
+  expect(out[1]).toEqual({ status: "fulfilled", value: 1, attempts: 1 });
+  for (const r of out.slice(2)) expect(r).toEqual({ status: "rejected", reason: "stop", attempts: 0 });
+});
+
+test("rule 5: a failed task whose retry is cancelled rejects with the reason and its attempts so far", async () => {
+  const d = deferred<number>();
+  let calls = 0;
+  const ac = new AbortController();
+  const run = runPool(
+    [
+      () => {
+        calls++;
+        return d.promise;
+      },
+    ],
+    1,
+    { retries: 3, signal: ac.signal },
+  );
+  await flush();
+  ac.abort("stop");
+  d.reject(new Error("fail"));
+  const out = await run;
+  expect(calls).toBe(1);
+  expect(out).toEqual([{ status: "rejected", reason: "stop", attempts: 1 }]);
+});
+
+test("rule 5: an in-flight task that fails with no retries left keeps its own error", async () => {
+  const d = deferred<number>();
+  const err = new Error("own");
+  const ac = new AbortController();
+  const run = runPool([() => d.promise], 1, { signal: ac.signal });
+  await flush();
+  ac.abort("stop");
+  d.reject(err);
+  expect(await run).toEqual([{ status: "rejected", reason: err, attempts: 1 }]);
+});
+
+test("rule 5: a task that aborts while starting stops the same pass from starting more", async () => {
+  const ac = new AbortController();
+  const called: number[] = [];
+  const out = await runPool(
+    [
+      () => {
+        called.push(0);
+        ac.abort("x");
+        return 0;
+      },
+      () => {
+        called.push(1);
+        return 1;
+      },
+      () => {
+        called.push(2);
+        return 2;
+      },
+    ],
+    3,
+    { signal: ac.signal },
+  );
+  expect(called).toEqual([0]);
+  expect(out).toEqual([
+    { status: "fulfilled", value: 0, attempts: 1 },
+    { status: "rejected", reason: "x", attempts: 0 },
+    { status: "rejected", reason: "x", attempts: 0 },
+  ]);
+});
+
+test("rule 5: an already aborted signal starts no task and resolves at once", async () => {
+  let called = 0;
+  const out = await runPool(
+    [() => ++called, () => ++called],
+    2,
+    { signal: AbortSignal.abort("early") },
+  );
+  expect(called).toBe(0);
+  expect(out).toEqual([
+    { status: "rejected", reason: "early", attempts: 0 },
+    { status: "rejected", reason: "early", attempts: 0 },
+  ]);
+});
+
+test("rule 6: resolves with one settled entry per task and never rejects", async () => {
+  const out = await runPool(
+    [
+      () => {
+        throw new Error("a");
+      },
+      async () => Promise.reject(new Error("b")),
+      () => 3,
+    ],
+    1,
+    { retries: 1 },
+  );
+  expect(out.length).toBe(3);
+  expect(out.map((r) => r.status)).toEqual(["rejected", "rejected", "fulfilled"]);
+  expect(out.every((r) => r !== undefined)).toBe(true);
+});
