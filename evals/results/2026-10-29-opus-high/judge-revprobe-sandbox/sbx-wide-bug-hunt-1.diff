diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-30 03:26:03.826161376 +0000
@@ -0,0 +1,81 @@
+import { expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+import { percentOf } from '../src/money/round.ts';
+import { totals } from '../src/order/total.ts';
+
+test('rule 1: a line subtotal is unit price times quantity', () => {
+  const t = totals(cart('US', [['TEE', 3]]));
+  expect(t.lines[0].subtotal).toBe(4500);
+});
+
+test('rule 2: bulk discount starts at 10 units and is 5%', () => {
+  expect(totals(cart('US', [['PEN', 10]])).lines[0].discount).toBe(60);
+  expect(totals(cart('US', [['PEN', 9]])).lines[0].discount).toBe(0);
+});
+
+test('rule 2: bulk discount at 50 units is 10%, not 5%', () => {
+  expect(totals(cart('US', [['PEN', 50]])).lines[0].discount).toBe(600);
+  expect(totals(cart('US', [['PEN', 49]])).lines[0].discount).toBe(294);
+});
+
+test('rule 2: units count per SKU across lines, and the input cart is not changed', () => {
+  const c = cart('US', [['PEN', 5], ['PEN', 5]]);
+  const t = totals(c);
+  expect(t.lines.length).toBe(1);
+  expect(t.lines[0].quantity).toBe(10);
+  expect(t.lines[0].discount).toBe(60);
+  expect(c.lines.length).toBe(2);
+  expect(c.lines[0].quantity).toBe(5);
+});
+
+test('rule 3: coupon applies after bulk discount', () => {
+  const t = totals(cart('US', [['PEN', 10]], 'SAVE10'));
+  expect(t.coupon).toBe(114);
+  expect(t.subtotal).toBe(1140);
+});
+
+test('rule 3: FLAT5 takes 500 cents off but never below zero', () => {
+  const t = totals(cart('US', [['PEN', 1]], 'FLAT5'));
+  expect(t.coupon).toBe(120);
+  expect(t.subtotal - t.coupon).toBe(0);
+});
+
+test('rule 4: free shipping is judged on the discounted subtotal', () => {
+  // 3 bags = 6600 (no bulk tier); SAVE10 leaves 5940, which is at or above 5000
+  expect(totals(cart('US', [['BAG', 3]], 'SAVE10')).shipping).toBe(0);
+  // 4 tees = 6000, FLAT5 leaves 5500 (free)
+  expect(totals(cart('US', [['TEE', 4]], 'FLAT5')).shipping).toBe(0);
+  // 4400 + 900 - 500 = 4800 is below 5000, so shipping is charged
+  expect(totals(cart('US', [['BAG', 2], ['MUG', 2]], 'FLAT5')).shipping).toBe(800);
+});
+
+test('rule 4 and region table: UK free shipping starts at 4000', () => {
+  expect(totals(cart('UK', [['TEE', 2], ['CAP', 1]])).shipping).toBe(0);
+  expect(totals(cart('UK', [['TEE', 1], ['CAP', 1]])).shipping).toBe(700);
+});
+
+test('region table matches the README', () => {
+  expect(REGIONS.US).toEqual({ code: 'US', taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+  expect(REGIONS.EU).toEqual({ code: 'EU', taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+  expect(REGIONS.UK).toEqual({ code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+});
+
+test('rule 5: percentOf rounds half up to the cent for every amount', () => {
+  for (const [rate, pct] of [[0.07, 7], [0.2, 20], [0.1, 10], [0.05, 5]] as const) {
+    for (let a = 0; a <= 20000; a++) {
+      expect(percentOf(a, rate)).toBe(Math.floor((a * pct + 50) / 100));
+    }
+  }
+});
+
+test('rule 6: total is discounted subtotal plus shipping plus tax', () => {
+  for (const c of [
+    cart('US', [['PEN', 10]], 'SAVE10'),
+    cart('EU', [['MUG', 3], ['TEE', 1]], 'FLAT5'),
+    cart('UK', [['BAG', 1]]),
+  ]) {
+    const t = totals(c);
+    expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+  }
+});
