--- a/src/slug.ts	2026-10-30 03:29:47.646893009 +0000
+++ b/src/slug.ts	2026-10-30 03:31:10.977337997 +0000
@@ -11,10 +11,24 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (s[max] === '-') return s.slice(0, max);
+  const cut = s.lastIndexOf('-', max - 1);
+  return cut > 0 ? s.slice(0, cut) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  let out = slug;
+  for (let n = 2; taken.has(out); n++) out = `${slug}-${n}`;
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 03:31:23.580291766 +0000
@@ -0,0 +1,48 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('single units and fractions', () => {
+  expect(parseDuration('2d')).toBe(172_800_000);
+  expect(parseDuration('3h')).toBe(10_800_000);
+  expect(parseDuration('5m')).toBe(300_000);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('7s')).toBe(7_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('0.5s')).toBe(500);
+});
+
+test('rounds to whole milliseconds', () => {
+  expect(parseDuration('1.4ms')).toBe(1);
+  expect(parseDuration('1.6ms')).toBe(2);
+});
+
+test('spaces between parts and around the text', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+});
+
+test('malformed input throws with the input in the message', () => {
+  for (const input of ['', '10', '5x', 'h', '-1s', '   ', '1 h', '1.s']) {
+    expect(() => parseDuration(input)).toThrow(JSON.stringify(input));
+  }
+});
+
+test('formatDuration', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(3_600_000)).toBe('1h');
+  expect(() => formatDuration(-1)).toThrow();
+});
+
+test('round trip over pseudo-random values', () => {
+  let s = 12345;
+  const values = [0];
+  for (let i = 0; i < 200; i++) {
+    s = (s * 16807) % 2147483647;
+    values.push(s % 864_000_000);
+  }
+  for (const ms of values) expect(parseDuration(formatDuration(ms))).toBe(ms);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 03:31:26.102154004 +0000
@@ -0,0 +1,173 @@
+import { expect, test } from 'bun:test';
+import { LRU, type EvictReason } from '../src/lru.ts';
+
+function recording<K, V>(cache: LRU<K, V>) {
+  const log: [K, V, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return log;
+}
+
+test('a hit refreshes recency', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recording(cache);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('expiry boundary is t + ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recording(cache);
+  cache.set('k', 7);
+  t = 999;
+  expect(cache.get('k')).toBe(7);
+  t = 1000;
+  expect(cache.get('k')).toBeUndefined();
+  expect(log).toEqual([['k', 7, 'expired']]);
+});
+
+test('set gives a fresh ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('a', 2);
+  t = 1200;
+  expect(cache.get('a')).toBe(2);
+});
+
+test('overwriting a key does not grow the cache or evict', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recording(cache);
+  cache.set('a', 1);
+  cache.set('a', 2);
+  cache.set('a', 3);
+  expect(cache.size).toBe(1);
+  expect(cache.get('a')).toBe(3);
+  expect(log).toEqual([]);
+});
+
+test('expired entries are removed before live ones', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recording(cache);
+  cache.set('a', 1);
+  t = 600;
+  cache.set('b', 2);
+  t = 1100;
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('capacity counts expired entries that are not yet removed', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recording(cache);
+  cache.set('a', 1);
+  t = 1500;
+  cache.set('b', 2);
+  expect(log).toEqual([]);
+  expect(cache.size).toBe(1);
+});
+
+test('delete reports live, expired and missing keys', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const log = recording(cache);
+  cache.set('live', 1);
+  cache.set('old', 2);
+  expect(cache.delete('live')).toBe(true);
+  expect(log).toEqual([['live', 1, 'delete']]);
+  t = 1000;
+  expect(cache.delete('old')).toBe(false);
+  expect(log[1]).toEqual(['old', 2, 'expired']);
+  log.length = 0;
+  expect(cache.delete('missing')).toBe(false);
+  expect(log).toEqual([]);
+});
+
+test('size and keys leave out expired entries without removing them', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const log = recording(cache);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1000;
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+});
+
+test('matches a reference model over random operations', () => {
+  let seed = 4242;
+  const rand = (n: number) => {
+    seed = (seed * 16807) % 2147483647;
+    return seed % n;
+  };
+  const CAP = 3;
+  const TTL = 1000;
+  let t = 0;
+  const cache = new LRU<string, number>(CAP, TTL, () => t);
+  const log = recording(cache);
+  // Reference: oldest first, each entry with its expiry time.
+  let model: { k: string; v: number; exp: number }[] = [];
+  const mlog: [string, number, EvictReason][] = [];
+  const live = (e: { exp: number }) => t < e.exp;
+  const expire = (k: string, v: number) => mlog.push([k, v, 'expired']);
+  let counter = 0;
+  for (let i = 0; i < 500; i++) {
+    const key = `k${rand(5)}`;
+    const op = rand(4);
+    if (op === 0) {
+      const e = model.find((x) => x.k === key);
+      let want: number | undefined;
+      if (e && !live(e)) {
+        model = model.filter((x) => x !== e);
+        expire(e.k, e.v);
+      } else if (e) {
+        model = [...model.filter((x) => x !== e), e];
+        want = e.v;
+      }
+      expect(cache.get(key)).toBe(want);
+    } else if (op === 1) {
+      const v = counter++;
+      model = model.filter((x) => x.k !== key);
+      model.push({ k: key, v, exp: t + TTL });
+      if (model.length > CAP) {
+        for (const e of model.filter((x) => !live(x))) expire(e.k, e.v);
+        model = model.filter((x) => live(x));
+        while (model.length > CAP) {
+          const e = model.shift()!;
+          mlog.push([e.k, e.v, 'capacity']);
+        }
+      }
+      cache.set(key, v);
+    } else if (op === 2) {
+      const e = model.find((x) => x.k === key);
+      let want = false;
+      if (e) {
+        model = model.filter((x) => x !== e);
+        if (live(e)) {
+          mlog.push([e.k, e.v, 'delete']);
+          want = true;
+        } else {
+          expire(e.k, e.v);
+        }
+      }
+      expect(cache.delete(key)).toBe(want);
+    } else {
+      t += rand(601);
+    }
+    expect(cache.size).toBe(model.filter(live).length);
+    expect(cache.keys()).toEqual(model.filter(live).map((e) => e.k).reverse());
+    expect(log).toEqual(mlog);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 03:31:23.582747355 +0000
@@ -0,0 +1,54 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('lower case and diacritics', () => {
+  expect(slugify('ABC')).toBe('abc');
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('Ångström')).toBe('angstrom');
+});
+
+test('special letters', () => {
+  expect(slugify('Straße')).toBe('strasse');
+  expect(slugify('Æon Œuvre Øre Łódź Đak')).toBe('aeon-oeuvre-ore-lodz-dak');
+});
+
+test('separators', () => {
+  expect(slugify('a -- _ b')).toBe('a-b');
+  expect(slugify('--a!!')).toBe('a');
+  expect(slugify('日本')).toBe('');
+});
+
+test('max cuts at a dash or at max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+  expect(slugify('ab-cdefgh', 5)).toBe('ab');
+  expect(slugify('ab', 5)).toBe('ab');
+});
+
+test('max never leaves a dangling dash, and the result is a prefix of the full slug', () => {
+  let s = 99;
+  const alphabet = 'abc-';
+  for (let i = 0; i < 300; i++) {
+    let text = '';
+    const len = 1 + (s % 20);
+    for (let j = 0; j < len; j++) {
+      s = (s * 16807) % 2147483647;
+      text += alphabet[s % alphabet.length];
+    }
+    const full = slugify(text);
+    for (let max = 1; max <= 10; max++) {
+      const cut = slugify(text, max);
+      expect(cut.length).toBeLessThanOrEqual(max);
+      expect(cut.endsWith('-')).toBe(false);
+      expect(full.startsWith(cut)).toBe(true);
+    }
+    s = (s * 16807) % 2147483647;
+  }
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+});
