 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expiresAt: number };
+
+// The Map's insertion order is the recency order: the first key is the least recently used one, the last the
+// most recently used one. Every hit deletes and re-inserts its key to move it to the end.
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  private readonly entries = new Map<K, Entry<V>>();
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
 
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return undefined;
+    this.entries.delete(key);
+    if (!this.isLive(e)) {
+      this.onEvict?.(key, e.value, 'expired');
+      return undefined;
+    }
+    this.entries.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.entries.delete(key);
+    this.entries.set(key, { value, expiresAt: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, e] of [...this.entries]) {
+      if (this.isLive(e)) continue;
+      this.entries.delete(k);
+      this.onEvict?.(k, e.value, 'expired');
+    }
+    while (this.entries.size > this.capacity) {
+      const [k, e] = this.entries.entries().next().value!;
+      this.entries.delete(k);
+      this.onEvict?.(k, e.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return false;
+    this.entries.delete(key);
+    if (this.isLive(e)) {
+      this.onEvict?.(key, e.value, 'delete');
+      return true;
+    }
+    this.onEvict?.(key, e.value, 'expired');
+    return false;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const e of this.entries.values()) if (this.isLive(e)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.entries]
+      .reverse()
+      .filter(([, e]) => this.isLive(e))
+      .map(([k]) => k);
+  }
+
+  private isLive(e: Entry<V>): boolean {
+    return this.now() < e.expiresAt;
   }
 }
