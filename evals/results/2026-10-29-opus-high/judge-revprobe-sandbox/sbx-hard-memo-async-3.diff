diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-30 03:20:00.494169686 +0000
@@ -0,0 +1,262 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+// fn's calls, each settled by the test.
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("a call while a lookup is in flight returns the same promise", () => {
+  const { fn } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  expect(m("k")).toBe(m("k"));
+});
+
+test("a result is kept until ttlMs after it settled, not after it was called", async () => {
+  let t = 50;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  t = 50;
+  calls[0]!.d.resolve("v");
+  await tick();
+  t = 149;
+  expect(await m("k")).toBe("v");
+  expect(calls).toHaveLength(1);
+  t = 150;
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection reaches every waiter and is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  const err = new Error("boom");
+  calls[0]!.d.reject(err);
+  await expect(a).rejects.toBe(err);
+  await expect(b).rejects.toBe(err);
+  await tick();
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale rejection does not remove a newer entry for the key", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.reject(new Error("old"));
+  calls[1]!.d.resolve("new");
+  await expect(first).rejects.toThrow("old");
+  expect(await second).toBe("new");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale result does not overwrite a newer entry for the key", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[1]!.d.resolve("new");
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  expect(await second).toBe("new");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("a result settling after invalidate is not kept even when nothing calls the key again", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  await tick();
+  expect(m.size).toBe(0);
+});
+
+test("never holds more than max keys, including while lookups are in flight", () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  expect(m.size).toBe(2);
+  m("c");
+  expect(m.size).toBe(2);
+  expect(calls).toHaveLength(3);
+});
+
+test("a key dropped to stay under max is not kept when its lookup settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  const a = m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  expect(await a).toBe("a");
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a cache hit counts as a use for least-recently-used order", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  const a = m("a");
+  const b = m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await Promise.all([a, b]);
+  await tick();
+  m("a");
+  expect(calls).toHaveLength(2);
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("settling a lookup is not a use for least-recently-used order", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  const a = m("a");
+  const b = m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await Promise.all([a, b]);
+  await tick();
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(4);
+});
+
+test("clear forgets every key, and the waiters still get their results", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("a");
+  const b = m("b");
+  m.clear();
+  expect(m.size).toBe(0);
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  expect(await a).toBe("a");
+  expect(await b).toBe("b");
+  await tick();
+  expect(m.size).toBe(0);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("size and max count only keys that have not expired", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  const a = m("a");
+  calls[0]!.d.resolve("a");
+  await a;
+  await tick();
+  t = 100;
+  expect(m.size).toBe(0);
+  m("b");
+  m("c");
+  expect(m.size).toBe(2);
+  calls[1]!.d.resolve("b");
+  calls[2]!.d.resolve("c");
+  await tick();
+  m("b");
+  m("c");
+  expect(calls).toHaveLength(3);
+});
+
+test("matches a reference model over random operation sequences", async () => {
+  let seed = 1;
+  const rand = (n: number) => {
+    seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  const keys = ["a", "b", "c", "d", "e"];
+  for (let run = 0; run < 200; run++) {
+    let t = 0;
+    const { fn, calls } = lookups();
+    const max = 1 + rand(3);
+    const m = memo(fn, { ttlMs: 10, max, now: () => t });
+    // Least recently used first. id is the index of the fn call that made the entry.
+    let model: { key: string; id: number; expires: number }[] = [];
+    const live = (e: { expires: number }) => e.expires > t;
+    const settled = new Set<number>();
+    // Each call's outcome: the value, or the message of the rejection.
+    const outcomes: Promise<string>[] = [];
+    for (let step = 0; step < 50; step++) {
+      const op = rand(7);
+      if (op <= 1) {
+        const key = keys[rand(keys.length)]!;
+        const before = calls.length;
+        const hit = model.find((e) => e.key === key && live(e));
+        outcomes.push(m(key).then((v) => v, (e: Error) => e.message));
+        if (hit) {
+          model = [...model.filter((e) => e !== hit), hit];
+        } else {
+          model = model.filter((e) => e.key !== key && live(e));
+          while (model.length >= max) model.shift();
+          model.push({ key, id: before, expires: Infinity });
+        }
+        expect(calls.length).toBe(hit ? before : before + 1);
+      } else if (op === 2) {
+        const pending = calls.map((_, i) => i).filter((i) => !settled.has(i));
+        if (pending.length) {
+          const i = pending[rand(pending.length)]!;
+          settled.add(i);
+          if (rand(3) === 0) {
+            calls[i]!.d.reject(new Error("x"));
+            model = model.filter((e) => e.id !== i);
+          } else {
+            calls[i]!.d.resolve(calls[i]!.key);
+            const e = model.find((e) => e.id === i);
+            if (e) e.expires = t + 10;
+          }
+          for (let k = 0; k < 3; k++) await null;
+        }
+      } else if (op === 3) {
+        const key = keys[rand(keys.length)]!;
+        m.invalidate(key);
+        model = model.filter((e) => e.key !== key);
+      } else if (op === 4 && rand(4) === 0) {
+        m.clear();
+        model = [];
+      } else {
+        t += rand(7);
+      }
+      expect(m.size).toBe(model.filter(live).length);
+    }
+    calls.forEach((c, i) => settled.has(i) || c.d.resolve(c.key));
+    for (const o of await Promise.all(outcomes)) expect(["a", "b", "c", "d", "e", "x"]).toContain(o);
+  }
+});
