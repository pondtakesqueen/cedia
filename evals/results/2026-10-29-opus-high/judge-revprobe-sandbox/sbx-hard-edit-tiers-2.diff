diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-30 03:09:44.754183769 +0000
@@ -0,0 +1,85 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const SRC = 'function f() {\n    if (a) {\n        return 1;  \n    }\n}\n';
+const errOf = (r: ReturnType<typeof applyEdit>) => ('error' in r ? r.error : '');
+
+describe('exact edge cases', () => {
+  test('a match not on line 1 reports its line', () => {
+    const r = applyEdit('a\nbb\nc\n', { old_text: 'bb', new_text: 'B' });
+    expect('applied' in r && r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+  });
+  test('a match ending in a newline does not report the next line', () => {
+    const r = applyEdit('x\ny\n', { old_text: 'x\n', new_text: '' });
+    expect('applied' in r && r.applied).toEqual({ from: 1, to: 1, tier: 'exact', count: 1 });
+  });
+  test('several exact matches error before trying line tiers', () => {
+    expect(errOf(applyEdit('a\nb\na\nb\n', { old_text: 'a\nb', new_text: 'c' }))).toContain('matches 2 places');
+  });
+  test('replace_all agrees with split/join on generated inputs', () => {
+    const parts = ['x', 'y', '\n', 'xy'];
+    const cases: string[] = [];
+    for (let n = 0; n < 50; n++) {
+      let s = '';
+      for (let k = 0; k < 4 + (n % 5); k++) s += parts[(n * 7 + k * 3) % parts.length];
+      cases.push(s);
+    }
+    for (const src of cases) {
+      for (const old of ['x', 'xy', 'x\ny']) {
+        const count = src.split(old).length - 1;
+        if (count === 0) continue;
+        const r = applyEdit(src, { old_text: old, new_text: 'Z', replace_all: true });
+        expect('error' in r).toBe(false);
+        if ('applied' in r) {
+          expect(r.content).toBe(src.split(old).join('Z'));
+          expect(r.applied.count).toBe(count);
+        }
+      }
+    }
+  });
+});
+
+describe('line tiers edge cases', () => {
+  test('trailing whitespace on old and new trailing newline are ignored', () => {
+    const r = applyEdit('a\t\nb\n', { old_text: 'a\n', new_text: 'A\n' });
+    expect('content' in r && r.content).toBe('A\nb\n');
+  });
+  test('tier 2 does not re-indent new_text', () => {
+    const r = applyEdit('a  \n  b\n', { old_text: 'a\n  b', new_text: 'x\n  y' });
+    expect('content' in r && r.content).toBe('x\n  y\n');
+  });
+  test('tier 3 swaps nested indentation and blanks stay empty', () => {
+    const r = applyEdit('f\n    g\n        h\n', { old_text: '  g\n    h', new_text: '  g\n\n    k' });
+    expect('content' in r && r.content).toBe('f\n    g\n\n      k\n');
+  });
+  test('tier 3 gives a line less indented than old_text the file indentation', () => {
+    const r = applyEdit('    a\n    b\n', { old_text: '  a\nb', new_text: '  a\nc' });
+    expect('content' in r && r.content).toBe('    a\n    c\n');
+  });
+  test('two windows in tier 3 error with their lines', () => {
+    const r = applyEdit('  x\n  q\n    x\n  q\n', { old_text: 'x\nq', new_text: 'y' });
+    expect(errOf(r)).toContain('matches 2 places');
+    expect(errOf(r)).toContain('1, 3');
+  });
+  test('replace_all does not change line-tier matching', () => {
+    expect(errOf(applyEdit('a \nb\na  \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }))).toContain('matches 2 places');
+  });
+  test('old_text longer than content is not found', () => {
+    expect(errOf(applyEdit('a\n', { old_text: 'a\nb\nc', new_text: 'x' }))).toContain('not found');
+  });
+  test('blank-only old_text does not match every window', () => {
+    expect(errOf(applyEdit('a\nb\n', { old_text: '  \n', new_text: 'x' }))).toContain('not found');
+  });
+});
+
+describe('not found pointer', () => {
+  test('lists at most 5 lines', () => {
+    const src = Array.from({ length: 7 }, (_, i) => `row ${i} target`).join('\n') + '\n';
+    const e = errOf(applyEdit(src, { old_text: 'target\nnothing', new_text: 'x' }));
+    expect(e).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect(e).not.toContain('6');
+  });
+  test('whitespace-only old_text gives no pointer', () => {
+    expect(errOf(applyEdit(SRC, { old_text: '   \n', new_text: 'x' }))).not.toContain('appears');
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-30 03:08:19.815552054 +0000
+++ b/edit.ts	2026-10-30 03:09:20.882184315 +0000
@@ -23,5 +23,79 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: next, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (old === next) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  // 1. exact: non-overlapping match offsets, as split() would find them
+  const hits: number[] = [];
+  for (let i = content.indexOf(old); i !== -1; i = content.indexOf(old, i + old.length)) hits.push(i);
+  if (hits.length > 1 && !replace_all) {
+    return { error: `old_text matches ${hits.length} places (first at line ${lineAt(content, hits[0])}); add context or set replace_all` };
+  }
+  if (hits.length > 0) {
+    const from = lineAt(content, hits[0]);
+    const to = lineAt(content, hits[hits.length - 1] + old.length - 1);
+    return { content: content.split(old).join(next), applied: { from, to, tier: 'exact', count: hits.length } };
+  }
+
+  // 2 and 3: whole-line windows
+  const lines = content.split('\n');
+  const oldLines = splitLines(old);
+  const newLines = splitLines(next);
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', s => s.trimEnd()],
+    ['indentation', s => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    if (oldLines.every(s => norm(s) === '')) continue;
+    const starts = findWindows(lines, oldLines, norm);
+    if (starts.length === 0) continue;
+    if (starts.length > 1) {
+      return { error: `old_text matches ${starts.length} places (lines ${starts.map(i => i + 1).join(', ')}); add context` };
+    }
+    const i = starts[0];
+    let replacement = newLines;
+    if (tier === 'indentation') {
+      const oldIndent = indentOf(oldLines.find(s => s.trim() !== '')!);
+      const fileIndent = indentOf(lines.slice(i, i + oldLines.length).find(s => s.trim() !== '')!);
+      replacement = newLines.map(s => {
+        if (s.trim() === '') return '';
+        if (s.startsWith(oldIndent)) return fileIndent + s.slice(oldIndent.length);
+        // the line is less indented than old_text: keep its text, take the file's indentation
+        return fileIndent + s.trimStart();
+      });
+    }
+    lines.splice(i, oldLines.length, ...replacement);
+    return { content: lines.join('\n'), applied: { from: i + 1, to: i + oldLines.length, tier, count: 1 } };
+  }
+
+  const first = old.split('\n').map(s => s.trim()).find(s => s !== '');
+  const where = first === undefined ? [] : lines.flatMap((s, i) => (s.includes(first) ? [i + 1] : [])).slice(0, 5);
+  return { error: 'old_text not found' + (where.length > 0 ? `; first line appears at line ${where.join(', ')}` : '') };
+}
+
+// 1-based line number of the character at `index`.
+function lineAt(content: string, index: number): number {
+  return content.slice(0, index).split('\n').length;
+}
+
+// Lines of `text` without one trailing newline; empty text has no lines.
+function splitLines(text: string): string[] {
+  const body = text.endsWith('\n') ? text.slice(0, -1) : text;
+  return body === '' ? [] : body.split('\n');
+}
+
+// Start indexes of each window of `lines` whose lines equal `oldLines` after `norm`.
+function findWindows(lines: string[], oldLines: string[], norm: (s: string) => string): number[] {
+  const found: number[] = [];
+  for (let i = 0; i + oldLines.length <= lines.length; i++) {
+    if (oldLines.every((s, k) => norm(lines[i + k]) === norm(s))) found.push(i);
+  }
+  return found;
+}
+
+// Leading whitespace of `s`.
+function indentOf(s: string): string {
+  return s.slice(0, s.length - s.trimStart().length);
 }
