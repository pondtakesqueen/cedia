diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-30 03:10:31.235452470 +0000
@@ -0,0 +1,45 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+// Reference median: sorts a copy numerically and averages the two middle values for even lengths.
+function refMedian(xs: number[]): number {
+  const s = [...xs].sort((a, b) => a - b);
+  const m = Math.floor(s.length / 2);
+  return s.length % 2 ? s[m]! : (s[m - 1]! + s[m]!) / 2;
+}
+
+test('odd length returns the middle value', () => {
+  expect(median([5])).toBe(5);
+  expect(median([3, 1, 2])).toBe(2);
+});
+
+test('even length returns the mean of the two middle values', () => {
+  expect(median([1, 2])).toBe(1.5);
+});
+
+test('sorting is numeric, including negatives', () => {
+  expect(median([10, 9, 100, 1])).toBe(9.5);
+  expect(median([-5, -10, 3])).toBe(-5);
+});
+
+test('input array is not changed', () => {
+  const xs = [7, 2, 9, 4];
+  const before = [...xs];
+  median(xs);
+  expect(xs).toEqual(before);
+});
+
+test('empty input throws', () => expect(() => median([])).toThrow('empty'));
+
+test('matches a reference median on seeded random arrays', () => {
+  let seed = 12345;
+  const rand = () => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed / 0x7fffffff;
+  };
+  for (let t = 0; t < 200; t++) {
+    const n = 1 + Math.floor(rand() * 20);
+    const xs = Array.from({ length: n }, () => Math.floor(rand() * 101) - 50);
+    expect(median(xs)).toBe(refMedian(xs));
+  }
+});
