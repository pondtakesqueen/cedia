 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+// A single dash followed by letters, e.g. -f, -fu, -rf.
+const shortGroup = (w: string) => /^-[^-]/.test(w);
+
+// A path that cannot be resolved before the command runs: contains $, or is ~user.
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+
+const outside = (p: string, cwd: string) => unresolvable(p) || !insideWorkspace(p, cwd);
+
+// A glob whose name starts with . and can match .. (e.g. .*, ..*, .?*).
+const dotGlob = (p: string) => /(^|\/)\.(\.|[*?[])/.test(p) && /[*?[]/.test(p);
+
+// git global options that take the next word as their value.
+const GIT_VALUE_OPTS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+
+function gitHit(words: string[]): Hit | undefined {
+  let i = 0;
+  while (i < words.length && words[i].startsWith('-')) i += GIT_VALUE_OPTS.has(words[i]) ? 2 : 1;
+  const sub = words[i];
+  const rest = words.slice(i + 1);
+  if (sub === 'push') {
+    for (const w of rest) {
+      if (/^--(force|force-with-lease|mirror|delete|prune)(=|$)/.test(w) || (shortGroup(w) && /[fd]/.test(w.slice(1))) || (!w.startsWith('-') && /^[+:]/.test(w)))
+        return { name: 'force-push', reason: `git push ${w} rewrites or deletes remote refs` };
+    }
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean' && !rest.some(w => w === '-n' || w === '--dry-run')) {
+    const w = rest.find(w => w === '--force' || (shortGroup(w) && w.slice(1).includes('f')));
+    if (w) return { name: 'clean-force', reason: `git clean ${w} deletes untracked files` };
+  }
+  return undefined;
+}
+
+function rmHit(words: string[], cwd: string): Hit | undefined {
+  let recursive = false;
+  let opts = true;
+  const targets: string[] = [];
+  for (const w of words) {
+    if (opts && w === '--') opts = false;
+    else if (opts && w.startsWith('-')) recursive ||= w === '--recursive' || (shortGroup(w) && /[rR]/.test(w.slice(1)));
+    else targets.push(w);
+  }
+  if (!recursive) return undefined;
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets (from xargs?)' };
+  for (const t of targets) {
+    if (outside(t, cwd)) return { name: 'rm-outside', reason: `rm -r target \`${t}\` is outside the workspace` };
+    if (sameDir(t, cwd)) return { name: 'rm-outside', reason: `rm -r target \`${t}\` is the workspace itself` };
+    if (dotGlob(t)) return { name: 'rm-outside', reason: `rm -r target \`${t}\` can expand to ..` };
+  }
+  return undefined;
+}
+
+function findHit(words: string[], cwd: string): Hit | undefined {
+  if (!words.some(w => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  let i = 0; // find's global options come before the start paths
+  while (i < words.length && (/^-([HLP]|O\d*)$/.test(words[i]) || words[i] === '-D')) i += words[i] === '-D' ? 2 : 1;
+  const rest = words.slice(i);
+  const end = rest.findIndex(w => w.startsWith('-'));
+  const starts = end < 0 ? rest : rest.slice(0, end);
+  for (const p of starts.length ? starts : ['.']) {
+    if (outside(p, cwd)) return { name: 'rm-outside', reason: `find start path \`${p}\` is outside the workspace` };
+  }
+  return undefined;
+}
+
