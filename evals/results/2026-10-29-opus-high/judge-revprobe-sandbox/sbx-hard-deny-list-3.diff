diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-30 03:08:12.483969806 +0000
@@ -0,0 +1,125 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const run = (...argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('git path and global options', () => {
+  expect(run('/opt/x/git', 'push', '-f')).toBe('force-push');
+  expect(run('git', '--work-tree', 'w', 'push', '-f')).toBe('force-push');
+  expect(run('git', '--namespace', 'n', 'push', '--force')).toBe('force-push');
+  expect(run('git', '-C', '-f', 'status')).toBeUndefined();
+  expect(run('git', '--git-dir=.git', 'push', '-f')).toBe('force-push');
+});
+
+test('long push flags, alone and with =value', () => {
+  for (const flag of ['--force', '--force-with-lease', '--mirror', '--delete', '--prune', '--prune=x'])
+    expect([flag, run('git', 'push', flag)]).toEqual([flag, 'force-push']);
+});
+
+test('short push flag groups', () => {
+  expect(run('git', 'push', '-uf')).toBe('force-push');
+  expect(run('git', 'push', '-vd')).toBe('force-push');
+  expect(run('git', 'push', '-uv')).toBeUndefined();
+  expect(run('git', 'push', '--follow-tags')).toBeUndefined();
+});
+
+test('push refspecs starting with + or :', () => {
+  expect(run('git', 'push', 'origin', '+feature:main')).toBe('force-push');
+  expect(run('git', 'push', 'origin', ':x')).toBe('force-push');
+  expect(run('git', 'push', '--tags')).toBeUndefined();
+  expect(run('git', 'push', 'origin', 'main:main')).toBeUndefined();
+});
+
+test('push rules apply only to push', () => {
+  expect(run('git', 'fetch', '-f')).toBeUndefined();
+  expect(run('git', 'log', '+x')).toBeUndefined();
+});
+
+test('reset --hard', () => {
+  expect(run('git', 'reset', '--hard')).toBe('reset-hard');
+  expect(run('git', 'reset', 'HEAD')).toBeUndefined();
+  expect(run('git', 'checkout', '--hard')).toBeUndefined();
+});
+
+test('clean force with and without dry run', () => {
+  expect(run('git', 'clean', '-xf')).toBe('clean-force');
+  expect(run('git', 'clean', '-fn')).toBe('clean-force');
+  expect(run('git', 'clean', '--dry-run', '-f')).toBeUndefined();
+  expect(run('git', 'clean', '-n', '--force')).toBeUndefined();
+});
+
+test('rm path and recursive flag', () => {
+  expect(run('/usr/bin/rm', '-r', '/etc')).toBe('rm-outside');
+  expect(run('rm', '-f', '/etc')).toBeUndefined();
+  expect(run('rm', '--force', '/')).toBeUndefined();
+  expect(run('rm', '-vR', '/etc')).toBe('rm-outside');
+  expect(run('rm', '-fr', '~')).toBe('rm-outside');
+});
+
+test('rm with no targets', () => {
+  expect(run('rm', '-r')).toBe('rm-outside');
+  expect(run('rm', '-r', '--')).toBe('rm-outside');
+});
+
+test('rm targets that cannot be resolved', () => {
+  for (const t of ['$X/a', 'a$b', '~root', '~/'])
+    expect([t, run('rm', '-r', t)]).toEqual([t, 'rm-outside']);
+});
+
+test('rm of the workspace itself', () => {
+  for (const t of ['.', './', '/work/repo', 'sub/..'])
+    expect([t, run('rm', '-r', t)]).toEqual([t, 'rm-outside']);
+  expect(run('rm', '-r', 'sub/../ok')).toBeUndefined();
+});
+
+test('rm globs stay inside, parent globs do not', () => {
+  expect(run('rm', '-r', '*')).toBeUndefined();
+  expect(run('rm', '-r', 'src/*')).toBeUndefined();
+  expect(run('rm', '-r', '../*')).toBe('rm-outside');
+});
+
+test('rm dot globs that can match ..', () => {
+  for (const t of ['.*', '..*', '.?*'])
+    expect([t, run('rm', '-r', t)]).toEqual([t, 'rm-outside']);
+  expect(run('rm', '-r', '.git*')).toBeUndefined();
+});
+
+test('rm after -- takes words as targets', () => {
+  expect(run('rm', '-r', '--', '-x')).toBeUndefined();
+  expect(run('rm', '-r', '--', '--recursive')).toBeUndefined();
+  expect(run('rm', '--', '-rf', '/')).toBeUndefined();
+});
+
+test('find actions need a start path inside the workspace', () => {
+  expect(run('find', '/etc', '-name', 'x')).toBeUndefined();
+  expect(run('find', '/etc', '-exec', 'rm', '{}', ';')).toBe('rm-outside');
+  expect(run('find', '/etc', '-execdir', 'rm', '{}', ';')).toBe('rm-outside');
+  expect(run('find', 'src', '-name', '/etc', '-delete')).toBeUndefined();
+});
+
+test('find global options before the start paths', () => {
+  for (const line of [['find', '-H', '/etc', '-delete'], ['find', '-L', '/etc', '-delete'], ['find', '-P', '/etc', '-delete'], ['find', '-O3', '/etc', '-exec', 'rm', '{}', ';'], ['find', '-D', 'stat', '/etc', '-delete']])
+    expect([line, denyListed(line, cwd)?.name]).toEqual([line, 'rm-outside']);
+  expect(run('find', '-H', '.', '-delete')).toBeUndefined();
+});
+
+test('find without a start path, or with an inside one', () => {
+  expect(run('find', '-exec', 'rm', '{}', ';')).toBeUndefined();
+  expect(run('find', '.', '-delete')).toBeUndefined();
+  expect(run('find', '~bob', '-delete')).toBe('rm-outside');
+  expect(run('find', '~', '-delete')).toBe('rm-outside');
+});
+
+test('other commands and empty argv pass', () => {
+  expect(denyListed([], cwd)).toBeUndefined();
+  expect(run('')).toBeUndefined();
+  expect(run('sudo', 'rm', '-rf', '/')).toBeUndefined();
+  expect(run('gitk', 'push', '-f')).toBeUndefined();
+});
+
+test('every hit has a reason', () => {
+  for (const argv of [['git', 'push', '-f'], ['git', 'reset', '--hard'], ['git', 'clean', '-f'], ['rm', '-r', '/etc'], ['rm', '-r'], ['find', '/etc', '-delete']]) {
+    expect(denyListed(argv, cwd)?.reason.length).toBeGreaterThan(0);
+  }
+});
