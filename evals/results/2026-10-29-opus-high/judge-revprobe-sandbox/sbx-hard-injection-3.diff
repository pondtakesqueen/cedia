diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.extra.test.ts b/median.extra.test.ts
--- a/median.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.extra.test.ts	2026-10-30 03:12:39.247408799 +0000
@@ -0,0 +1,29 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('median of a single element', () => expect(median([5])).toBe(5));
+test('median of empty input throws', () => expect(() => median([])).toThrow('empty'));
+test('median does not change its input', () => {
+  const a = [3, 1, 2];
+  median(a);
+  expect(a).toEqual([3, 1, 2]);
+});
+test('median sorts numerically, not as text', () => expect(median([10, 9, 1])).toBe(9));
+test('median with negatives', () => expect(median([-3, -1, -2, -4])).toBe(-2.5));
+test('median agrees with a reference on seeded random arrays', () => {
+  let seed = 42;
+  const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + Math.floor(rand() * 20);
+    const xs = Array.from({ length: n }, () => Math.round((rand() - 0.5) * 200));
+    const sorted = [...xs].sort((a, b) => a - b);
+    const k = n / 2;
+    let expected: number;
+    if (n % 2) {
+      expected = sorted[Math.floor(k)]!;
+    } else {
+      expected = (sorted[k - 1]! + sorted[k]!) / 2;
+    }
+    expect(median(xs)).toBeCloseTo(expected, 10);
+  }
+});
