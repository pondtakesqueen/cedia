diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.rules.test.ts b/sse.rules.test.ts
--- a/sse.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.rules.test.ts	2026-10-30 03:24:44.594163188 +0000
@@ -0,0 +1,107 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+const corpus =
+  ': hello\r\nevent: msg\r\ndata: สวัสดี 🙂\r\ndata:  two\r\n\r\nid: 3\ndata\n\nevent: only\n\ndata: a:b\rc\n\n:\n\nevent: x\ndata: last';
+
+test('output does not depend on chunk size', async () => {
+  const want = await all(corpus, 10_000);
+  expect(want.length).toBeGreaterThan(0);
+  for (let chunk = 1; chunk <= corpus.length; chunk++) expect(await all(corpus, chunk)).toEqual(want);
+});
+
+test('\\n and \\r\\n give the same messages; a lone \\r is data', async () => {
+  expect(await all(corpus.replaceAll('\r\n', '\n'))).toEqual(await all(corpus));
+  expect(await all('data: a\rb\n\n')).toEqual([{ data: 'a\rb' }]);
+});
+
+test('a comment line is ignored; a comment-looking data value is not a comment', async () => {
+  expect(await all(':x\ndata: 1\n\n')).toEqual([{ data: '1' }]);
+  expect(await all(': data: 2\n\n')).toEqual([]);
+});
+
+test('one space after the colon is dropped, colons in the value are kept', async () => {
+  expect(await all('data:  x\n\n')).toEqual([{ data: ' x' }]);
+  expect(await all('data: a:b\n\n')).toEqual([{ data: 'a:b' }]);
+});
+
+test('a line with no colon is a field with an empty value', async () => {
+  expect(await all('data\ndata\n\n')).toEqual([{ data: '\n' }]);
+  expect(await all('event\ndata: 1\n\n')).toEqual([{ event: '', data: '1' }]);
+});
+
+test('other fields are ignored and data lines are joined with newlines', async () => {
+  expect(await all('id: 1\ndata: a\nfoo: bar\nretry: 5\ndata: b\ndata: c\n\n')).toEqual([{ data: 'a\nb\nc' }]);
+});
+
+test('an event without data is dropped, also at the end of the body', async () => {
+  expect(await all('event: a\n')).toEqual([]);
+  expect(await all('event: a\n\n')).toEqual([]);
+});
+
+test('a message is yielded when its blank line arrives, even if the newline comes in its own chunk', async () => {
+  let release!: () => void;
+  const gate = new Promise<void>((r) => (release = r));
+  const enc = new TextEncoder();
+  let step = 0;
+  const body = new ReadableStream<Uint8Array>({
+    async pull(c) {
+      if (step === 0) c.enqueue(enc.encode('data: a\n'));
+      else if (step === 1) {
+        await gate;
+        c.enqueue(enc.encode('\n'));
+      } else c.close();
+      step++;
+    },
+  });
+  const it = readSse(body);
+  const pending = it.next();
+  release();
+  expect((await pending).value).toEqual({ data: 'a' });
+  expect((await it.next()).done).toBe(true);
+});
+
+test('pending data at the end of the body is yielded as one message', async () => {
+  expect(await all('data: a\ndata: b')).toEqual([{ data: 'a\nb' }]);
+});
+
+test('a lone \\r left at the end of the body is not a blank line', async () => {
+  expect(await all('data: a\n\r')).toEqual([{ data: 'a' }]);
+  expect(await all('data: a\r\n\r')).toEqual([{ data: 'a' }]);
+});
+
+test('a stream error rejects with that error after the messages before it', async () => {
+  let step = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (step++ === 0) c.enqueue(new TextEncoder().encode('data: ok\n\n'));
+      else c.error(new Error('boom'));
+    },
+  });
+  const it = readSse(body);
+  expect((await it.next()).value).toEqual({ data: 'ok' });
+  await expect(it.next()).rejects.toThrow('boom');
+});
+
+test('breaking out early cancels the body', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    start(c) {
+      c.enqueue(new TextEncoder().encode('data: 1\n\ndata: 2\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: '1' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
