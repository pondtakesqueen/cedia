diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-30 03:13:37.258178451 +0000
@@ -0,0 +1,87 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+const err = (r: ReturnType<typeof applyEdit>) => ('error' in r ? r.error : '');
+
+describe('exact', () => {
+  test('exact match wins over trailing-space match', () => {
+    const r = ok(applyEdit('a \nb\n', { old_text: 'a ', new_text: 'c' }));
+    expect(r.applied).toEqual({ from: 1, to: 1, tier: 'exact', count: 1 });
+    expect(r.content).toBe('c\nb\n');
+  });
+  test('a trailing newline in old_text ends the range on its own line', () => {
+    const r = ok(applyEdit('a\nb\nc\n', { old_text: 'b\n', new_text: 'B\n' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+  });
+  test('three matches without replace_all report the count', () => {
+    expect(err(applyEdit('x\nx\nx\n', { old_text: 'x', new_text: 'z' }))).toContain('matches 3 places');
+  });
+  test('replace_all falls through to tier 2 when there is no exact match', () => {
+    const r = ok(applyEdit('a \nb\n', { old_text: 'a\n', new_text: 'c\n', replace_all: true }));
+    expect(r.applied).toEqual({ from: 1, to: 1, tier: 'trailing-space', count: 1 });
+    expect(r.content).toBe('c\nb\n');
+  });
+});
+
+describe('trailing-space', () => {
+  test('drops only one trailing newline', () => {
+    const r = ok(applyEdit('a \n\nb\n', { old_text: 'a\n\n', new_text: 'c\n\n' }));
+    expect(r.content).toBe('c\n\nb\n');
+  });
+  test('new_text is kept verbatim, without re-indenting', () => {
+    const r = ok(applyEdit('x \ny\n', { old_text: 'x\ny', new_text: '   odd\n  z' }));
+    expect(r.applied.tier).toBe('trailing-space');
+    expect(r.content).toBe('   odd\n  z\n');
+  });
+  test('deleting the last line keeps the file ending in a newline', () => {
+    const r = ok(applyEdit('p\nq \n', { old_text: 'q\n', new_text: '' }));
+    expect(r.content).toBe('p\n');
+  });
+});
+
+describe('indentation', () => {
+  test('three windows match: error lists their lines', () => {
+    const r = applyEdit('  a\n  q\n  a\n  q\n  a\n  q\n', { old_text: 'a\nq', new_text: 'c' });
+    expect(err(r)).toContain('matches 3 places');
+    expect(err(r)).toContain('1, 3, 5');
+  });
+  test('a match at the end of a file without final newline', () => {
+    const r = ok(applyEdit('1\n2\n3\n4\n5\nsix', { old_text: '  six', new_text: 'SIX' }));
+    expect(r.applied).toEqual({ from: 6, to: 6, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('1\n2\n3\n4\n5\nSIX');
+  });
+});
+
+describe('errors', () => {
+  test('not found lists at most five lines where the first line appears', () => {
+    const src = 'foo\nfoo\nfoo\nfoo\nfoo\nfoo\nfoo\n';
+    const e = err(applyEdit(src, { old_text: 'foo\nbar', new_text: 'x' }));
+    expect(e).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect(e).not.toContain('6');
+  });
+  test('an edit that is only a newline gives no pointer', () => {
+    expect(err(applyEdit('ab', { old_text: '\n', new_text: 'x' }))).toBe('old_text not found');
+  });
+});
+
+describe('agreement', () => {
+  test('exact tier agrees with String.replace over seeded inputs', () => {
+    const tokens = ['a', 'b', '  c', 'd '];
+    let seed = 7;
+    const next = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
+    for (let n = 0; n < 200; n++) {
+      const lines = Array.from({ length: 4 }, () => tokens[Math.floor(next() * tokens.length)]);
+      const content = lines.join('\n') + '\n';
+      const from = Math.floor(next() * 4);
+      const old = lines.slice(from, from + 1).join('\n');
+      if (content.split(old).length !== 2) continue;
+      const r = ok(applyEdit(content, { old_text: old, new_text: 'Z' }));
+      expect(r.content).toBe(content.replace(old, 'Z'));
+      expect(r.applied.tier).toBe('exact');
+    }
+  });
+});
