 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text, replace_all } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same' };
+
+  const hits: number[] = [];
+  for (let i = content.indexOf(old_text); i !== -1; i = content.indexOf(old_text, i + old_text.length)) hits.push(i);
+  if (hits.length === 1 || (hits.length > 1 && replace_all)) {
+    return {
+      content: content.split(old_text).join(new_text),
+      applied: {
+        from: lineOf(content, hits[0]),
+        to: lineOf(content, hits[0] + old_text.length - 1),
+        tier: 'exact',
+        count: hits.length,
+      },
+    };
+  }
+  if (hits.length > 1) return { error: `old_text matches ${hits.length} places (exact); first at line ${lineOf(content, hits[0])}` };
+
+  const endsNl = content.endsWith('\n');
+  const body = endsNl ? content.slice(0, -1) : content;
+  const fileLines = content === '' ? [] : body.split('\n');
+  const oldLines = toLines(old_text);
+  const newLines = toLines(new_text);
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', (s) => s.trimEnd()],
+    ['indentation', (s) => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const starts = findWindows(fileLines, oldLines, norm);
+    if (starts.length > 1) {
+      return { error: `old_text matches ${starts.length} places (${tier}) at lines ${starts.map((s) => s + 1).join(', ')}` };
+    }
+    if (starts.length === 0) continue;
+
+    const i = starts[0];
+    const end = i + oldLines.length;
+    const windowLines = fileLines.slice(i, end);
+    const replacement = tier === 'indentation' ? reindent(newLines, oldLines, windowLines) : newLines;
+    const lines = fileLines.slice(0, i).concat(replacement, fileLines.slice(end));
+    return {
+      content: lines.length === 0 ? '' : lines.join('\n') + (endsNl ? '\n' : ''),
+      applied: { from: i + 1, to: end, tier, count: 1 },
+    };
+  }
+
+  let error = 'old_text not found';
+  const probe = oldLines.find((l) => l.trim() !== '')?.trim();
+  const hitLines = probe ? fileLines.flatMap((l, i) => (l.includes(probe) ? [i + 1] : [])) : [];
+  if (hitLines.length > 0) error += `; first line appears at line ${hitLines.slice(0, 5).join(', ')}`;
+  return { error };
 }
