 // from/to are 1-based line numbers of the replaced text in the original content; count is how many places were replaced.
 export type Applied = { from: number; to: number; tier: Tier; count: number };
 
+// 1-based line of the character at `index`.
+function lineOf(content: string, index: number): number {
+  let line = 1;
+  for (let i = content.indexOf('\n'); i !== -1 && i < index; i = content.indexOf('\n', i + 1)) line++;
+  return line;
+}
+
+// Lines of a text, without one trailing newline; '' has no lines.
+function toLines(text: string): string[] {
+  const body = text.endsWith('\n') ? text.slice(0, -1) : text;
+  return body === '' ? [] : body.split('\n');
+}
+
+// 0-based starts of the windows of fileLines whose lines equal oldLines under norm.
+function findWindows(fileLines: string[], oldLines: string[], norm: (s: string) => string): number[] {
+  const starts: number[] = [];
+  if (oldLines.length === 0) return starts;
+  for (let i = 0; i + oldLines.length <= fileLines.length; i++) {
+    if (oldLines.every((line, j) => norm(fileLines[i + j]) === norm(line))) starts.push(i);
+  }
+  return starts;
+}
+
+// Leading whitespace of a line.
+function indentOf(s: string): string {
+  return s.match(/^\s*/)![0];
+}
+
+// new_text's lines with old_text's indentation swapped for the window's; blank lines stay blank.
+function reindent(newLines: string[], oldLines: string[], windowLines: string[]): string[] {
+  const oldIndent = indentOf(oldLines.find((l) => l.trim() !== '') ?? '');
+  const fileIndent = indentOf(windowLines.find((l) => l.trim() !== '') ?? '');
+  return newLines.map((line) =>
+    line.trim() === '' || !line.startsWith(oldIndent) ? line : fileIndent + line.slice(oldIndent.length),
+  );
+}
+
 // Applies one edit to `content`.
 //
 // Tiers, tried in order; a tier applies only when it finds exactly one place (or replace_all is set, exact tier only):
