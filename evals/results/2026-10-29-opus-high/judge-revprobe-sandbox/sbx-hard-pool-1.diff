diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.fix.test.ts b/pool.fix.test.ts
--- a/pool.fix.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.fix.test.ts	2026-10-30 03:19:49.606169935 +0000
@@ -0,0 +1,270 @@
+import { expect, test } from "bun:test";
+import { runPool } from "./pool";
+
+const deferred = <T>() => {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+};
+
+const flush = async () => {
+  for (let i = 0; i < 10; i++) await Promise.resolve();
+};
+
+test("a limit that is not a whole number of 1 or more, or Infinity, is refused before any task starts", async () => {
+  let calls = 0;
+  const task = () => {
+    calls++;
+    return Promise.resolve(1);
+  };
+  for (const limit of [0, -1, 1.5, NaN, "2" as any]) {
+    await expect(runPool([task], limit)).rejects.toBeInstanceOf(RangeError);
+  }
+  expect(calls).toBe(0);
+  expect((await runPool([task], Infinity)).map((r) => r.status)).toEqual(["fulfilled"]);
+});
+
+test("retries that are not a whole number of 0 or more are refused before any task starts", async () => {
+  let calls = 0;
+  const task = () => {
+    calls++;
+    return Promise.resolve(1);
+  };
+  for (const retries of [-1, 1.5, NaN]) {
+    await expect(runPool([task], 1, { retries })).rejects.toBeInstanceOf(RangeError);
+  }
+  expect(calls).toBe(0);
+});
+
+test("never runs more tasks at once than the limit, and starts the next one as soon as one settles", async () => {
+  const gates = [0, 1, 2, 3, 4].map(() => deferred<number>());
+  const started: number[] = [];
+  let inFlight = 0;
+  let maxInFlight = 0;
+  const tasks = gates.map((g, i) => () => {
+    started.push(i);
+    inFlight++;
+    maxInFlight = Math.max(maxInFlight, inFlight);
+    return g.promise.then((v) => {
+      inFlight--;
+      return v;
+    });
+  });
+
+  const done = runPool(tasks, 2);
+  await flush();
+  expect(started).toEqual([0, 1]);
+  gates[1].resolve(1);
+  await flush();
+  expect(started).toEqual([0, 1, 2]);
+  gates[0].resolve(0);
+  await flush();
+  expect(started).toEqual([0, 1, 2, 3]);
+  gates[2].resolve(2);
+  gates[3].resolve(3);
+  await flush();
+  expect(started).toEqual([0, 1, 2, 3, 4]);
+  gates[4].resolve(4);
+  const out = await done;
+  expect(maxInFlight).toBe(2);
+  expect(out.map((r) => r.status === "fulfilled" && r.value)).toEqual([0, 1, 2, 3, 4]);
+});
+
+test("results sit in the slot of their task, not the order they finish in", async () => {
+  const gates = [0, 1, 2].map(() => deferred<number>());
+  const done = runPool(
+    gates.map((g) => () => g.promise),
+    3,
+  );
+  gates[2].resolve(2);
+  gates[1].resolve(1);
+  gates[0].resolve(0);
+  const out = await done;
+  expect(out).toEqual([
+    { status: "fulfilled", value: 0, attempts: 1 },
+    { status: "fulfilled", value: 1, attempts: 1 },
+    { status: "fulfilled", value: 2, attempts: 1 },
+  ]);
+});
+
+test("a task that throws synchronously is a rejection, and a plain return value is a fulfilment", async () => {
+  const err = new Error("boom");
+  const out = await runPool(
+    [
+      () => {
+        throw err;
+      },
+      () => 42,
+    ],
+    2,
+  );
+  expect(out).toEqual([
+    { status: "rejected", reason: err, attempts: 1 },
+    { status: "fulfilled", value: 42, attempts: 1 },
+  ]);
+});
+
+test("a rejected task is retried in its slot up to retries more times, and attempts counts every call", async () => {
+  let calls = 0;
+  const alwaysFails = () => {
+    calls++;
+    return Promise.reject(new Error("no"));
+  };
+  const out = await runPool([alwaysFails], 1, { retries: 2 });
+  expect(calls).toBe(3);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 3 });
+
+  let flaky = 0;
+  const failsTwice = () => (++flaky < 3 ? Promise.reject(new Error("no")) : Promise.resolve("ok"));
+  expect(await runPool([failsTwice], 1, { retries: 2 })).toEqual([{ status: "fulfilled", value: "ok", attempts: 3 }]);
+});
+
+test("retries keep the task's slot, so the limit still holds while a task is retried", async () => {
+  let inFlight = 0;
+  let maxInFlight = 0;
+  const flaky = (failures: number) => {
+    let n = 0;
+    return () => {
+      inFlight++;
+      maxInFlight = Math.max(maxInFlight, inFlight);
+      return Promise.resolve().then(() => {
+        inFlight--;
+        if (++n <= failures) throw new Error("again");
+        return n;
+      });
+    };
+  };
+  const out = await runPool([flaky(2), flaky(0), flaky(1), flaky(0)], 2, { retries: 2 });
+  expect(maxInFlight).toBe(2);
+  expect(out.map((r) => r.attempts)).toEqual([3, 1, 2, 1]);
+});
+
+test("a signal that is already aborted at the call starts no task and settles all with its reason", async () => {
+  let calls = 0;
+  const ac = new AbortController();
+  ac.abort("x");
+  const out = await runPool(
+    [
+      () => {
+        calls++;
+        return 1;
+      },
+      () => {
+        calls++;
+        return 2;
+      },
+    ],
+    1,
+    { signal: ac.signal },
+  );
+  expect(calls).toBe(0);
+  expect(out).toEqual([
+    { status: "rejected", reason: "x", attempts: 0 },
+    { status: "rejected", reason: "x", attempts: 0 },
+  ]);
+});
+
+test("after an abort, tasks in flight keep their results and tasks not yet started settle with the reason", async () => {
+  const gates = [0, 1, 2, 3, 4].map(() => deferred<string>());
+  const started: number[] = [];
+  const ac = new AbortController();
+  const done = runPool(
+    gates.map((g, i) => () => {
+      started.push(i);
+      return g.promise;
+    }),
+    2,
+    { signal: ac.signal },
+  );
+  await flush();
+  ac.abort("stop");
+  gates[0].resolve("a");
+  gates[1].resolve("b");
+  const out = await done;
+  expect(started).toEqual([0, 1]);
+  expect(out).toEqual([
+    { status: "fulfilled", value: "a", attempts: 1 },
+    { status: "fulfilled", value: "b", attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("a retry cancelled by an abort settles as rejected with the reason and the attempts made", async () => {
+  let calls = 0;
+  const g = deferred<string>();
+  const ac = new AbortController();
+  const done = runPool(
+    [
+      () => {
+        calls++;
+        return g.promise;
+      },
+    ],
+    1,
+    { retries: 2, signal: ac.signal },
+  );
+  await flush();
+  ac.abort("stop");
+  g.reject(new Error("boom"));
+  expect(await done).toEqual([{ status: "rejected", reason: "stop", attempts: 1 }]);
+  expect(calls).toBe(1);
+});
+
+test("the promise resolves with one result per task even when tasks throw, reject and are aborted", async () => {
+  const ac = new AbortController();
+  const tasks = [
+    () => {
+      throw new Error("sync");
+    },
+    () => Promise.reject(new Error("async")),
+    () => 3,
+    () => Promise.resolve(4),
+    () => 5,
+  ];
+  const out = await runPool(tasks, 2, { retries: 1, signal: ac.signal });
+  expect(out.length).toBe(tasks.length);
+  expect(out.every((r) => r !== undefined)).toBe(true);
+  ac.abort();
+  const after = await runPool(tasks, 2, { signal: ac.signal });
+  expect(after.length).toBe(tasks.length);
+  expect(after.every((r) => r.attempts === 0)).toBe(true);
+});
+
+test("randomised agreement with a per-task script of values, throws and flaky failures", async () => {
+  let seed = 12345;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  for (let round = 0; round < 200; round++) {
+    const n = rand(12);
+    const limit = [1, 2, 3, 4, 5, Infinity][rand(6)];
+    const retries = rand(4);
+    const scripts = Array.from({ length: n }, () => ({ kind: rand(3), fails: rand(5), value: rand(100) }));
+    const tasks = scripts.map((s) => {
+      let calls = 0;
+      return () => {
+        calls++;
+        if (s.kind === 0) return s.value;
+        if (s.kind === 1) throw new Error("sync");
+        if (calls <= s.fails) return Promise.reject(new Error("flaky"));
+        return Promise.resolve(s.value);
+      };
+    });
+    const expected = scripts.map((s) => {
+      if (s.kind === 0) return { status: "fulfilled", value: s.value, attempts: 1 };
+      if (s.kind === 1) return { status: "rejected", attempts: retries + 1 };
+      if (s.fails <= retries) return { status: "fulfilled", value: s.value, attempts: s.fails + 1 };
+      return { status: "rejected", attempts: retries + 1 };
+    });
+    const out = await runPool(tasks, limit, { retries });
+    const shaped = out.map((r) => (r.status === "fulfilled" ? { status: r.status, value: r.value, attempts: r.attempts } : { status: r.status, attempts: r.attempts }));
+    expect(shaped).toEqual(expected);
+  }
+});
