diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 16:59:38.179165809 +0000
@@ -0,0 +1,75 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { bulkDiscount } from '../src/pricing/discounts/bulk.ts';
+import { couponDiscount } from '../src/pricing/discounts/coupons.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+import { percentOf } from '../src/money/round.ts';
+import { totals } from '../src/order/total.ts';
+
+describe('pricing rules', () => {
+  test('bulk discount starts at 10 units, 10% from 50 units, only the top tier applies', () => {
+    expect(bulkDiscount(9, 1000)).toBe(0);
+    expect(bulkDiscount(10, 1000)).toBe(50);
+    expect(bulkDiscount(49, 1000)).toBe(50);
+    expect(bulkDiscount(50, 1000)).toBe(100);
+  });
+
+  test('region table matches the README', () => {
+    expect(REGIONS.US).toMatchObject({ taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+    expect(REGIONS.EU).toMatchObject({ taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+    expect(REGIONS.UK).toMatchObject({ taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+
+  test('UK shipping is free from 4000 cents', () => {
+    const t = totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]));
+    expect(t.subtotal).toBe(4000);
+    expect(t.shipping).toBe(0);
+    expect(t.tax).toBe(800);
+    expect(t.total).toBe(4800);
+  });
+
+  test('lines of the same SKU are merged before bulk pricing', () => {
+    const t = totals(cart('US', [['PEN', 5], ['PEN', 5]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ quantity: 10, subtotal: 1200, discount: 60, total: 1140 });
+    expect(t.shipping).toBe(800);
+    expect(t.tax).toBe(136);
+    expect(t.total).toBe(2076);
+  });
+
+  test('coupon applies after bulk discounts', () => {
+    const t = totals(cart('US', [['PEN', 10]], 'SAVE10'));
+    expect(t.coupon).toBe(114);
+    expect(t.total).toBe(1954);
+  });
+
+  test('free shipping uses the discounted subtotal after the coupon', () => {
+    const t = totals(cart('US', [['TEE', 3], ['PEN', 5]], 'SAVE10'));
+    expect(t.subtotal).toBe(5100);
+    expect(t.coupon).toBe(510);
+    expect(t.shipping).toBe(800);
+    expect(t.tax).toBe(377);
+    expect(t.total).toBe(5767);
+  });
+
+  test('free shipping uses the subtotal after the bulk discount', () => {
+    const t = totals(cart('US', [['PEN', 42]]));
+    expect(t.subtotal).toBe(4788);
+    expect(t.shipping).toBe(800);
+    expect(t.tax).toBe(391);
+    expect(t.total).toBe(5979);
+  });
+
+  test('FLAT5 takes 500 cents off and never below zero', () => {
+    expect(couponDiscount('FLAT5', 300)).toBe(300);
+    expect(couponDiscount('FLAT5', 800)).toBe(500);
+  });
+
+  test('unknown coupon gives no discount', () => {
+    expect(couponDiscount('NOPE', 1000)).toBe(0);
+  });
+
+  test('tax rounds half up to the cent', () => {
+    expect(percentOf(150, 0.07)).toBe(11);
+  });
+});
