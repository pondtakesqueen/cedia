diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 16:59:09.400836034 +0000
@@ -0,0 +1,40 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('bulk 5% applies at exactly 10 units', () => {
+    // 10 pens = 1200, 5% off = 1140; shipping 800; tax 7% of 1940 = 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('bulk 10% applies at exactly 50 units and the order ships free', () => {
+    // 50 pens = 6000, 10% off = 5400; shipping free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same sku are merged before the bulk check', () => {
+    // 5 + 5 pens are 10 units in total, so the 5% tier applies
+    const t = totals(cart('US', [['PEN', 5], ['PEN', 5]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t).toMatchObject({ subtotal: 1140, total: 2076 });
+  });
+
+  test('shipping uses the discounted subtotal, after the coupon', () => {
+    // 2 bags + 2 mugs = 5300; SAVE10 takes 530, leaving 4770 < 5000, so shipping is charged
+    // tax 7% of 4770 + 800 = 390
+    expect(totals(cart('US', [['BAG', 2], ['MUG', 2]], 'SAVE10'))).toMatchObject({
+      subtotal: 5300,
+      coupon: 530,
+      shipping: 800,
+      tax: 390,
+      total: 5960,
+    });
+  });
+
+  test('UK free shipping starts at 4000', () => {
+    // 1 bag + 1 tee + 3 pens = 4060 >= 4000; tax 20% of 4060 = 812
+    expect(totals(cart('UK', [['BAG', 1], ['TEE', 1], ['PEN', 3]]))).toMatchObject({ subtotal: 4060, shipping: 0, tax: 812, total: 4872 });
+  });
+});
