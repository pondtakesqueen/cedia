+
+test('breaking out early cancels the body', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: a\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'a' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
+
+test('a body error reaches the caller and releases the lock', async () => {
+  const enc = new TextEncoder();
+  let pulls = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (pulls++ === 0) c.enqueue(enc.encode('data: a\n\n'));
+      else c.error(new Error('boom'));
+    },
+  });
+  const it = readSse(body);
+  expect((await it.next()).value).toEqual({ data: 'a' });
+  await expect(it.next()).rejects.toThrow('boom');
+  expect(body.locked).toBe(false);
+});
+
+test('CRLF split between \\r and \\n', async () => {
+  const enc = new TextEncoder();
+  const parts = ['data: a\r', '\n\r', '\ndata: b\r\n\r\n'];
+  const body = new ReadableStream<Uint8Array>({
+    start(c) {
+      for (const p of parts) c.enqueue(enc.encode(p));
+      c.close();
+    },
+  });
+  const out: SseMessage[] = [];
+  for await (const m of readSse(body)) out.push(m);
+  expect(out).toEqual([{ data: 'a' }, { data: 'b' }]);
+});
