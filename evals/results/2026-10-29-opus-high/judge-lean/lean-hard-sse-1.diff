+++ b/sse.extra.test.ts	2026-10-29 16:56:51.187155883 +0000
@@ -0,0 +1,28 @@
+import { expect, test } from 'bun:test';
+import { readSse } from './sse.ts';
+
+test('stopping early cancels the body stream', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const _ of readSse(body)) break;
+  expect(cancelled).toBe(true);
+});
+
+test('a failing body rejects with its own error', async () => {
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.error(new Error('boom'));
+    },
+  });
+  await expect((async () => {
+    for await (const _ of readSse(body)) void _;
+  })()).rejects.toThrow('boom');
+});
