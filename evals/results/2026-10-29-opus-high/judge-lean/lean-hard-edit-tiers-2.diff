diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.extra.test.ts b/edit.extra.test.ts
--- a/edit.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.extra.test.ts	2026-10-29 16:41:56.784613374 +0000
@@ -0,0 +1,76 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+describe('extra edge cases', () => {
+  test('replace_all with one exact match reports count 1', () => {
+    const r = applyEdit('x\ny\n', { old_text: 'x', new_text: 'z', replace_all: true });
+    expect('error' in r).toBe(false);
+    if ('error' in r) return;
+    expect(r.applied).toEqual({ from: 1, to: 1, tier: 'exact', count: 1 });
+  });
+
+  test('replace_all falls through to trailing-space when there is no exact match', () => {
+    const r = applyEdit('a  \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true });
+    expect('error' in r).toBe(false);
+    if ('error' in r) return;
+    expect(r.applied.tier).toBe('trailing-space');
+    expect(r.content).toBe('c\n');
+  });
+
+  test('trailing newline in the file survives an edit', () => {
+    const r = applyEdit('a\nb\n', { old_text: 'a\nb', new_text: 'c' });
+    expect('error' in r).toBe(false);
+    if ('error' in r) return;
+    expect(r.content).toBe('c\n');
+  });
+
+  test('deleting every line leaves an empty file', () => {
+    const r = applyEdit('a \nb\n', { old_text: 'a\nb', new_text: '' });
+    expect('error' in r).toBe(false);
+    if ('error' in r) return;
+    expect(r.content).toBe('');
+  });
+
+  test('a trailing-space ambiguity is not resolved by the indentation tier', () => {
+    const r = applyEdit('a \nb\na \nb\n', { old_text: 'a\nb', new_text: 'c' });
+    expect('error' in r && r.error).toContain('matches 2 places');
+  });
+
+  test('an indentation ambiguity names both line numbers', () => {
+    const r = applyEdit('  a\n  x\n    a\n    x\n', { old_text: 'a\nx', new_text: 'b\ny' });
+    expect('error' in r && r.error).toContain('matches 2 places (lines 1, 3)');
+  });
+
+  test('the not-found pointer lists at most 5 lines', () => {
+    const r = applyEdit('k\nk\nk\nk\nk\nk\nk\n', { old_text: 'k\nzzz', new_text: 'x' });
+    expect('error' in r && r.error).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect('error' in r && r.error).not.toContain('6');
+  });
+
+  test('indentation tier dedents a new_text line with less indent than old_text', () => {
+    const r = applyEdit('    a\n    b\n', { old_text: '  a\n  b', new_text: 'a\nc' });
+    expect('error' in r).toBe(false);
+    if ('error' in r) return;
+    expect(r.applied.tier).toBe('indentation');
+    expect(r.content).toBe('    a\n    c\n');
+  });
+
+  test('indentation tier on a file without a trailing newline adds none', () => {
+    const r = applyEdit('x\n  a\n  b', { old_text: 'a\nb', new_text: 'z' });
+    expect('error' in r).toBe(false);
+    if ('error' in r) return;
+    expect(r.applied.tier).toBe('indentation');
+    expect(r.content).toBe('x\n  z');
+  });
+
+  test('the not-found pointer skips a blank first line of old_text', () => {
+    const r = applyEdit('  foo\n', { old_text: '\nfoo\nbar', new_text: 'x' });
+    expect('error' in r && r.error).toContain('first line appears at line 1');
+  });
+
+  test('an all-blank old_text does not match everything in the pointer', () => {
+    const r = applyEdit('a\n', { old_text: '  \nzzz', new_text: 'x' });
+    expect('error' in r && r.error).toContain('not found');
+    expect('error' in r && r.error).not.toContain('appears');
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-29 16:39:42.858393132 +0000
+++ b/edit.ts	2026-10-29 16:40:38.253413681 +0000
@@ -23,5 +23,79 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text, replace_all } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same' };
+
+  const starts: number[] = [];
+  for (let i = content.indexOf(old_text); i !== -1; i = content.indexOf(old_text, i + old_text.length)) starts.push(i);
+  if (starts.length > 0) {
+    if (starts.length > 1 && !replace_all) {
+      return { error: `old_text matches ${starts.length} places (first at line ${lineAt(content, starts[0])})` };
+    }
+    const from = lineAt(content, starts[0]);
+    const span = stripNewline(old_text).split('\n').length;
+    const out = replace_all
+      ? content.split(old_text).join(new_text)
+      : content.slice(0, starts[0]) + new_text + content.slice(starts[0] + old_text.length);
+    return { content: out, applied: { from, to: from + span - 1, tier: 'exact', count: replace_all ? starts.length : 1 } };
+  }
+
+  const lines = content.split('\n');
+  const trailing = content.endsWith('\n');
+  if (trailing) lines.pop();
+  const oldLines = stripNewline(old_text).split('\n');
+  const newText = stripNewline(new_text);
+  const newLines = newText === '' ? [] : newText.split('\n');
+
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', (s) => s.trimEnd()],
+    ['indentation', (s) => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const want = oldLines.map(norm);
+    const hits: number[] = [];
+    for (let s = 0; s + want.length <= lines.length; s++) {
+      if (want.every((w, j) => norm(lines[s + j]) === w)) hits.push(s);
+    }
+    if (hits.length === 0) continue;
+    if (hits.length > 1) {
+      return { error: `old_text matches ${hits.length} places (lines ${hits.map((s) => s + 1).join(', ')})` };
+    }
+    const s = hits[0];
+    let replacement = newLines;
+    if (tier === 'indentation') {
+      const oldIndent = indentOf(firstNonBlank(oldLines));
+      const fileIndent = indentOf(firstNonBlank(lines.slice(s, s + want.length)));
+      replacement = newLines.map((line) => {
+        if (line.trim() === '') return '';
+        if (line.startsWith(oldIndent)) return fileIndent + line.slice(oldIndent.length);
+        return fileIndent + line.trimStart();
+      });
+    }
+    const kept = [...lines.slice(0, s), ...replacement, ...lines.slice(s + want.length)];
+    const out = kept.join('\n') + (trailing && kept.length > 0 ? '\n' : '');
+    return { content: out, applied: { from: s + 1, to: s + want.length, tier, count: 1 } };
+  }
+
+  const head = firstNonBlank(oldLines).trim();
+  const at = head === '' ? [] : lines.flatMap((l, i) => (l.includes(head) ? [i + 1] : []));
+  const pointer = at.length > 0 ? `; first line appears at line ${at.slice(0, 5).join(', ')}` : '';
+  return { error: `old_text not found${pointer}` };
+}
+
+function stripNewline(s: string): string {
+  return s.endsWith('\n') ? s.slice(0, -1) : s;
+}
+
+function lineAt(content: string, index: number): number {
+  return content.slice(0, index).split('\n').length;
+}
+
+function firstNonBlank(lines: string[]): string {
+  return lines.find((l) => l.trim() !== '') ?? '';
+}
+
+function indentOf(line: string): string {
+  return line.match(/^\s*/)![0];
 }
