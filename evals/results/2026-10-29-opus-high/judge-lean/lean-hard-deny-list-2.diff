 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+/** True for a short option group (-fu, -rf) that contains letter x. */
+const hasShort = (w: string, x: string) => /^-[^-]/.test(w) && w.includes(x, 1);
+
+/** True for a target that cannot be resolved before it runs: contains $ or is ~user. */
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+
+const FORCE_PUSH_LONG = ['--force', '--force-with-lease', '--mirror', '--delete', '--prune'];
