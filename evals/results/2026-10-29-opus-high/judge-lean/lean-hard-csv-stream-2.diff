diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.stream.test.ts b/csv.stream.test.ts
--- a/csv.stream.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/csv.stream.test.ts	2026-10-29 16:32:30.159069035 +0000
@@ -0,0 +1,111 @@
+import { expect, test } from "bun:test";
+import { CsvStream, parseCsv } from "./csv";
+
+function run(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const c of chunks) rows.push(...s.push(c));
+  rows.push(...s.end());
+  return rows;
+}
+
+// Runs the stream on several splits of `input` and compares it with parseCsv: same rows, or a SyntaxError on both sides.
+function check(input: string) {
+  let want: string[][] | null = null;
+  try {
+    want = parseCsv(input);
+  } catch (e) {
+    expect(e).toBeInstanceOf(SyntaxError);
+  }
+  const splits: string[][] = [[input], input.split(""), ["", ...input.split(""), ""]];
+  for (let k = 0; k <= input.length; k++) splits.push([input.slice(0, k), input.slice(k)]);
+  for (const chunks of splits) {
+    if (want === null) expect(() => run(chunks)).toThrow(SyntaxError);
+    else expect(run(chunks)).toEqual(want);
+  }
+}
+
+test("a row comes out when its \\n arrives", () => {
+  expect(new CsvStream().push("a\n")).toEqual([["a"]]);
+});
+
+test("a trailing \\r waits for the next character", () => {
+  const s = new CsvStream();
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\n")).toEqual([["a"]]);
+  expect(run(["a\r", "b\r"])).toEqual([["a\rb\r"]]);
+  check("a\rb\r");
+});
+
+test("a quote at the end of a chunk inside a quoted field waits for the next one", () => {
+  check('"a""b",c\n');
+  expect(run(['"a"', '"b",c\n'])).toEqual([['a"b', "c"]]);
+});
+
+test("a \\r after a closing quote must be followed by \\n", () => {
+  check('"a"\rx');
+  check('"a"\r');
+  check('"a"\r\n"b"');
+});
+
+test("text after a closing quote throws at the push that brings it", () => {
+  const s = new CsvStream();
+  expect(s.push('"a"')).toEqual([]);
+  expect(() => s.push("b")).toThrow(SyntaxError);
+  check('"a"b');
+});
+
+test("a quote in a field that is not quoted throws", () => {
+  check('a"b');
+  check('a,b"\n');
+});
+
+test("a quoted field still open at the end throws at end", () => {
+  const s = new CsvStream();
+  expect(s.push('"abc')).toEqual([]);
+  expect(() => s.end()).toThrow(SyntaxError);
+  check('"abc');
+});
+
+test("a BOM is dropped only at the very start of the input", () => {
+  check("\uFEFFa");
+  check("x\uFEFF");
+  expect(run(["", "\uFEFFa"])).toEqual([["a"]]);
+  expect(run(["\uFEFF"])).toEqual([]);
+});
+
+test("the end of the input ends the last row", () => {
+  check("");
+  check("a\n");
+  check("\n");
+  check("a,");
+  check('""');
+  check("a\n\nb");
+  check("a\n\n");
+});
+
+test("matches parseCsv on mixed inputs", () => {
+  for (const input of ['a,b\r\n"x,""y""",z\n', "a\r\n\r", ",,\n\"\"\"\"", '"a\nb",""\r\n', "\r", "\r\r\n", "x,\"\"y"]) {
+    check(input);
+  }
+});
+
+test("after an error every later call throws the same error", () => {
+  const s = new CsvStream();
+  expect(() => s.push('"a"b')).toThrow(SyntaxError);
+  expect(() => s.push("c")).toThrow(SyntaxError);
+  expect(() => s.end()).toThrow(SyntaxError);
+
+  const t = new CsvStream();
+  t.push('"abc');
+  expect(() => t.end()).toThrow(SyntaxError);
+  expect(() => t.push("x")).toThrow(SyntaxError);
+  expect(() => t.end()).toThrow(SyntaxError);
+});
+
+test("push or end after end() throws a plain Error", () => {
+  const s = new CsvStream();
+  expect(s.end()).toEqual([]);
+  expect(() => s.push("a")).toThrow(new Error("stream ended"));
+  expect(() => s.end()).toThrow(new Error("stream ended"));
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.ts b/csv.ts
--- a/csv.ts	2026-10-29 16:30:42.649584821 +0000
+++ b/csv.ts	2026-10-29 16:32:25.843068778 +0000
@@ -50,3 +50,157 @@
   rows.push(row);
   return rows;
 }
+
+const SPECIAL = /[,\r\n"]/g;
+
+/**
+ * Reads CSV in chunks. Over all its calls, the rows are the rows `parseCsv` gives for the concatenated input, and it
+ * throws the same SyntaxErrors. A row comes out of the call in which its row end arrives; `end` returns the rest.
+ * Only the row and the field being read are kept, so the work for a chunk does not depend on what came before it.
+ */
+export class CsvStream {
+  private row: string[] = [];
+  private field = "";
+  private state: "fieldStart" | "unquoted" | "quoted" | "quoteSeen" | "afterQuote" | "crUnquoted" | "crAfterQuote" =
+    "fieldStart";
+  private atInputStart = true;
+  private rowOpen = false;
+  private error: SyntaxError | null = null;
+  private ended = false;
+
+  push(chunk: string): string[][] {
+    this.check();
+    const rows: string[][] = [];
+    try {
+      let i = 0;
+      if (this.atInputStart && chunk.length > 0) {
+        this.atInputStart = false;
+        if (chunk[0] === "\uFEFF") i = 1;
+      }
+      while (i < chunk.length) {
+        this.rowOpen = true;
+        switch (this.state) {
+          case "fieldStart":
+            if (chunk[i] === '"') {
+              this.state = "quoted";
+              i++;
+            } else if (chunk[i] === "\r") {
+              this.state = "crUnquoted";
+              i++;
+            } else if (chunk[i] === ",") {
+              this.endField();
+              i++;
+            } else if (chunk[i] === "\n") {
+              this.endRow(rows);
+              i++;
+            } else {
+              this.state = "unquoted";
+            }
+            break;
+          case "unquoted": {
+            SPECIAL.lastIndex = i;
+            const found = SPECIAL.exec(chunk);
+            const j = found ? found.index : chunk.length;
+            this.field += chunk.slice(i, j);
+            i = j;
+            if (i < chunk.length) {
+              const c = chunk[i++];
+              if (c === '"') throw new SyntaxError("a quote in a field that is not quoted");
+              if (c === "\r") this.state = "crUnquoted";
+              else if (c === ",") this.endField();
+              else this.endRow(rows);
+            }
+            break;
+          }
+          case "quoted": {
+            const j = chunk.indexOf('"', i);
+            if (j < 0) {
+              this.field += chunk.slice(i);
+              i = chunk.length;
+            } else {
+              this.field += chunk.slice(i, j);
+              this.state = "quoteSeen";
+              i = j + 1;
+            }
+            break;
+          }
+          case "quoteSeen":
+            if (chunk[i] === '"') {
+              this.field += '"';
+              this.state = "quoted";
+              i++;
+            } else {
+              this.state = "afterQuote";
+            }
+            break;
+          case "afterQuote":
+            if (chunk[i] === ",") {
+              this.endField();
+              i++;
+            } else if (chunk[i] === "\n") {
+              this.endRow(rows);
+              i++;
+            } else if (chunk[i] === "\r") {
+              this.state = "crAfterQuote";
+              i++;
+            } else {
+              throw new SyntaxError(`unexpected ${JSON.stringify(chunk[i])} after a closing quote`);
+            }
+            break;
+          case "crUnquoted":
+            if (chunk[i] === "\n") {
+              this.endRow(rows);
+              i++;
+            } else {
+              this.field += "\r";
+              this.state = "unquoted";
+            }
+            break;
+          case "crAfterQuote":
+            if (chunk[i] !== "\n") throw new SyntaxError("a \\r after a closing quote must be followed by \\n");
+            this.endRow(rows);
+            i++;
+            break;
+        }
+      }
+    } catch (e) {
+      this.error = e as SyntaxError;
+      throw e;
+    }
+    return rows;
+  }
+
+  end(): string[][] {
+    this.check();
+    this.ended = true;
+    const rows: string[][] = [];
+    try {
+      if (this.state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+      if (this.state === "crAfterQuote") throw new SyntaxError("a \\r after a closing quote must be followed by \\n");
+      if (this.state === "crUnquoted") this.field += "\r";
+      if (this.rowOpen) this.endRow(rows);
+    } catch (e) {
+      this.error = e as SyntaxError;
+      throw e;
+    }
+    return rows;
+  }
+
+  private check() {
+    if (this.error) throw this.error;
+    if (this.ended) throw new Error("stream ended");
+  }
+
+  private endField() {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "fieldStart";
+  }
+
+  private endRow(rows: string[][]) {
+    this.endField();
+    rows.push(this.row);
+    this.row = [];
+    this.rowOpen = false;
+  }
+}
