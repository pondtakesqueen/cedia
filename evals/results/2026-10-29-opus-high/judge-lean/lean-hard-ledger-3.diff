--- a/ledger.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.extra.test.ts	2026-10-29 16:49:05.823128220 +0000
@@ -0,0 +1,56 @@
+import { describe, expect, test } from 'bun:test';
+import { ledgerEntries, matchCheck, type SessionEvent } from './ledger.ts';
+
+describe('ledgerEntries edge cases', () => {
+  test('a snapshot placed before its result still names the call', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 's', tool: 'bash', input: { command: 'sed -i s/a/b/ x.ts' } },
+      { kind: 'snapshot', callId: 's', changed: ['x.ts'] },
+      { kind: 'tool_result', callId: 's', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'bash', path: 'x.ts' }]);
+  });
+
+  test('a failed bash write that is not read-only still counts as a write', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'n', tool: 'bash', input: { command: 'npm install' } },
+      { kind: 'tool_result', callId: 'n', status: 'failed', output: { isError: true, exitCode: 1 } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'npm install' }]);
+  });
+
+  test('a snapshot without a callId is ignored', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'q', tool: 'bash', input: { command: 'touch x' } },
+      { kind: 'snapshot', changed: ['z.ts'] },
+      { kind: 'tool_result', callId: 'q', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'bash', command: 'touch x' }]);
+  });
+
+  test('two snapshots on one call are merged in log order', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'm', tool: 'bash', input: { command: 'sed -i s/a/b/ a.ts b.ts' } },
+      { kind: 'tool_result', callId: 'm', status: 'completed', output: { isError: false, exitCode: 0 } },
+      { kind: 'snapshot', callId: 'm', changed: ['a.ts'] },
+      { kind: 'snapshot', callId: 'm', changed: ['b.ts'] },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([
+      { kind: 'write', at: 1, tool: 'bash', path: 'a.ts' },
+      { kind: 'write', at: 1, tool: 'bash', path: 'b.ts' },
+    ]);
+  });
+
+  test('a quoted cd target keeps its inner spacing when matched against cwd', () => {
+    expect(matchCheck('cd "/work/my  repo" && bun test', ['bun test'], '/work/my  repo')).toBe('bun test');
+  });
+
+  test('a completed edit with an empty snapshot gives no entries', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'e', tool: 'edit', input: { path: 'a.ts' } },
+      { kind: 'tool_result', callId: 'e', status: 'completed', output: { isError: false } },
+      { kind: 'snapshot', callId: 'e', changed: [] },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([]);
+  });
+});
