--- a/csv.ts	2026-10-29 09:45:15.236002068 +0000
+++ b/csv.ts	2026-10-29 09:46:23.041087142 +0000
@@ -50,3 +50,163 @@
   rows.push(row);
   return rows;
 }
+
+/** Where a {@link CsvStream} is in the input it has seen so far. */
+type State =
+  | "fieldStart" // at the start of a field: a row's first, or one after a `,`
+  | "unquoted" // in a field that is not quoted
+  | "unquotedCr" // in a field that is not quoted, just after a `\r` that may or may not start a row end
+  | "quoted" // in a quoted field
+  | "quoteInQuoted" // just after a `"` in a quoted field, which either closes it or starts a `""`
+  | "afterClose" // just after a quoted field's closing quote
+  | "afterCloseCr"; // just after a quoted field's closing quote and a `\r`, which must start a row end
+
+/**
+ * {@link parseCsv} for input that arrives in chunks split anywhere. `push` returns the rows whose row end is in
+ * what has arrived so far, and `end` returns the rest once the input is over; together they return the rows
+ * `parseCsv` would return for the whole input, and a `push` or `end` throws a SyntaxError where `parseCsv` would
+ * throw one. Each call's work grows with its chunk and the rows it returns, not with the input before it.
+ */
+export class CsvStream {
+  #state: State = "fieldStart";
+  #field = "";
+  #row: string[] = [];
+  /** The length of the input before the current chunk, for offsets in errors. */
+  #offset = 0;
+  #started = false;
+  #ended = false;
+  #error: SyntaxError | undefined;
+
+  push(chunk: string): string[][] {
+    this.#check();
+    try {
+      return this.#feed(chunk);
+    } catch (e) {
+      if (e instanceof SyntaxError) this.#error = e;
+      throw e;
+    }
+  }
+
+  end(): string[][] {
+    this.#check();
+    this.#ended = true;
+    const rows: string[][] = [];
+    switch (this.#state) {
+      case "fieldStart":
+        // After a `,` the row has a last, empty field; at a row's start there is no row.
+        if (this.#row.length > 0) this.#endRow(rows);
+        break;
+      case "unquotedCr":
+        this.#field += "\r";
+        this.#endRow(rows);
+        break;
+      case "unquoted":
+      case "quoteInQuoted":
+      case "afterClose":
+        this.#endRow(rows);
+        break;
+      case "quoted":
+        throw (this.#error = new SyntaxError("a quoted field is still open at the end of the input"));
+      case "afterCloseCr":
+        throw (this.#error = new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.#offset - 1}`));
+    }
+    return rows;
+  }
+
+  #check() {
+    if (this.#error) throw this.#error;
+    if (this.#ended) throw new Error("the stream has already ended");
+  }
+
+  #feed(chunk: string): string[][] {
+    const rows: string[][] = [];
+    const n = chunk.length;
+    let i = 0;
+    if (!this.#started && n > 0) {
+      this.#started = true;
+      if (chunk[0] === "﻿") i = 1;
+    }
+    while (i < n) {
+      switch (this.#state) {
+        case "fieldStart":
+          if (chunk[i] === '"') {
+            i++;
+            this.#state = "quoted";
+          } else this.#state = "unquoted";
+          break;
+        case "unquoted": {
+          let j = i;
+          while (j < n) {
+            const c = chunk[j];
+            if (c === "," || c === "\n" || c === "\r" || c === '"') break;
+            j++;
+          }
+          this.#field += chunk.slice(i, j);
+          i = j;
+          if (i === n) break;
+          const c = chunk[i++];
+          if (c === ",") this.#endField();
+          else if (c === "\n") this.#endRow(rows);
+          else if (c === "\r") this.#state = "unquotedCr";
+          else throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.#offset + i - 1}`);
+          break;
+        }
+        case "unquotedCr":
+          if (chunk[i] === "\n") {
+            i++;
+            this.#endRow(rows);
+          } else {
+            this.#field += "\r";
+            this.#state = "unquoted";
+          }
+          break;
+        case "quoted": {
+          const j = chunk.indexOf('"', i);
+          if (j < 0) {
+            this.#field += chunk.slice(i);
+            i = n;
+          } else {
+            this.#field += chunk.slice(i, j);
+            i = j + 1;
+            this.#state = "quoteInQuoted";
+          }
+          break;
+        }
+        case "quoteInQuoted":
+          if (chunk[i] === '"') {
+            i++;
+            this.#field += '"';
+            this.#state = "quoted";
+          } else this.#state = "afterClose";
+          break;
+        case "afterClose": {
+          const c = chunk[i++];
+          if (c === ",") this.#endField();
+          else if (c === "\n") this.#endRow(rows);
+          else if (c === "\r") this.#state = "afterCloseCr";
+          else throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${this.#offset + i - 1}`);
+          break;
+        }
+        case "afterCloseCr":
+          if (chunk[i] !== "\n") throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.#offset + i - 1}`);
+          i++;
+          this.#endRow(rows);
+          break;
+      }
+    }
+    this.#offset += n;
+    return rows;
+  }
+
+  #endField() {
+    this.#row.push(this.#field);
+    this.#field = "";
+    this.#state = "fieldStart";
+  }
+
+  #endRow(rows: string[][]) {
+    this.#endField();
+    rows.push(this.#row);
+    this.#row = [];
+  }
+}
