--- a/csv.test.ts	2026-10-29 09:45:15.235966554 +0000
+++ b/csv.test.ts	2026-10-29 09:46:45.701088489 +0000
@@ -23,3 +23,126 @@
   expect(s.push("d")).toEqual([]);
   expect(s.end()).toEqual([["c", "d"]]);
 });
+
+/** Feeds `chunks` to a new stream and returns all its rows, or the error one of its calls threw. */
+function stream(chunks: string[]): string[][] | Error {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  try {
+    for (const chunk of chunks) rows.push(...s.push(chunk));
+    rows.push(...s.end());
+    return rows;
+  } catch (e) {
+    return e as Error;
+  }
+}
+
+function parsed(text: string): string[][] | Error {
+  try {
+    return parseCsv(text);
+  } catch (e) {
+    return e as Error;
+  }
+}
+
+function expectSame(text: string, chunks: string[]) {
+  const want = parsed(text);
+  const got = stream(chunks);
+  if (want instanceof Error) expect(got).toBeInstanceOf(SyntaxError);
+  else expect(got).toEqual(want);
+}
+
+test("a row end split between chunks", () => {
+  const s = new CsvStream();
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\nb")).toEqual([["a"]]);
+  expect(s.end()).toEqual([["b"]]);
+  expectSame("a\r", ["a", "\r"]);
+  expectSame("a\rb", ["a\r", "b"]);
+  expectSame("a\r\r\nb", ["a\r", "\r", "\nb"]);
+});
+
+test("a doubled quote and a closing quote split between chunks", () => {
+  const s = new CsvStream();
+  expect(s.push('"a"')).toEqual([]);
+  expect(s.push('"b"')).toEqual([]);
+  expect(s.push("\n")).toEqual([['a"b']]);
+  expect(s.end()).toEqual([]);
+  expectSame('"a"', ['"a', '"']);
+  expectSame('"a",b', ['"a"', ",b"]);
+  expectSame('"a"\r\n', ['"a"\r', "\n"]);
+});
+
+test("a closing quote followed by a `\\r` that does not start a row end is a SyntaxError", () => {
+  const s = new CsvStream();
+  s.push('"a"\r');
+  expect(() => s.push("b")).toThrow(SyntaxError);
+  expect(stream(['"a"\r'])).toBeInstanceOf(SyntaxError);
+  expect(stream(['"a"', "\r"])).toBeInstanceOf(SyntaxError);
+});
+
+test("the byte order mark is dropped only at the very start, even after empty chunks", () => {
+  expect(stream(["", "", "﻿a"])).toEqual([["a"]]);
+  expect(stream(["﻿", "a"])).toEqual([["a"]]);
+  expect(stream(["﻿"])).toEqual([]);
+  expect(stream(["a", "﻿b"])).toEqual([["a﻿b"]]);
+  expect(stream(["﻿", "﻿"])).toEqual([["﻿"]]);
+  expect(stream(["﻿", '"a"'])).toEqual([["a"]]);
+});
+
+test("the end of the input ends the last row, after a row end or a `,` too", () => {
+  expect(stream([])).toEqual([]);
+  expect(stream(["", ""])).toEqual([]);
+  expect(stream(["a\n"])).toEqual([["a"]]);
+  expect(stream(["a", "\n", ""])).toEqual([["a"]]);
+  expect(stream(["\n"])).toEqual([[""]]);
+  expect(stream(["a,"])).toEqual([["a", ""]]);
+  expect(stream(["a", ","])).toEqual([["a", ""]]);
+  expect(stream(['""'])).toEqual([[""]]);
+});
+
+test("inputs parseCsv rejects make push or end throw a SyntaxError", () => {
+  for (const chunks of [['"a'], ['"a', ""], ['"a""'], ["a", '"'], ['a"b'], ['"a"', "b"], ['"a"', '"', "x"]]) {
+    expect(parsed(chunks.join(""))).toBeInstanceOf(SyntaxError);
+    expect(stream(chunks)).toBeInstanceOf(SyntaxError);
+  }
+  const s = new CsvStream();
+  expect(() => s.push('"a"x')).toThrow(SyntaxError);
+  expect(() => s.push("\n")).toThrow(SyntaxError);
+  const t = new CsvStream();
+  t.push('"a');
+  expect(() => t.end()).toThrow(SyntaxError);
+});
+
+test("calls after end throw", () => {
+  const s = new CsvStream();
+  s.end();
+  expect(() => s.push("a")).toThrow();
+  expect(() => s.end()).toThrow();
+});
+
+test("any input split any way gives the rows parseCsv gives", () => {
+  let seed = 1;
+  const random = (n: number) => {
+    seed = (seed * 1103515245 + 12345) % 2 ** 31;
+    return seed % n;
+  };
+  const alphabet = ["a", "b", ",", '"', "\r", "\n", "﻿"];
+  for (let k = 0; k < 3000; k++) {
+    const text = Array.from({ length: random(12) }, () => alphabet[random(alphabet.length)]).join("");
+    // Every split into chunks of one character, as a whole, and with empty chunks among them.
+    expectSame(text, [...text]);
+    expectSame(text, [text]);
+    expectSame(text, ["", ...[...text].flatMap(c => [c, ""])]);
+    // Every split into two chunks.
+    for (let at = 0; at <= text.length; at++) expectSame(text, [text.slice(0, at), text.slice(at)]);
+    // A random split.
+    const chunks: string[] = [];
+    for (let at = 0; at < text.length; ) {
+      const len = random(4);
+      chunks.push(text.slice(at, at + len));
+      at += len;
+    }
+    expectSame(text, chunks);
+  }
+});
