diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-29 16:53:52.122465539 +0000
@@ -0,0 +1,143 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+// fn's calls, each settled by the test.
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("in flight, the cache never holds more than max keys", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("c");
+  expect(m.size).toBe(2);
+  m("a");
+  expect(calls).toHaveLength(4);
+});
+
+test("a key dropped to stay under max is not added back when its call settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  await tick();
+  expect(m.size).toBe(1);
+  m("b");
+  expect(calls).toHaveLength(2);
+});
+
+test("a result in flight during invalidate does not overwrite a newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection of an invalidated call does not delete a newer entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k").catch((e: Error) => e.message);
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  expect(await first).toBe("boom");
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection reaches every waiter and is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  const both = Promise.all([a.catch((e: Error) => e.message), b.catch((e: Error) => e.message)]);
+  calls[0]!.d.reject(new Error("boom"));
+  expect(await both).toEqual(["boom", "boom"]);
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a cache hit counts as a use, so the key is not the one dropped", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("a");
+  m("c");
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("settling a call is not a use, so the key is still the one dropped", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  await tick();
+  m("c");
+  m("b");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(4);
+});
+
+test("ttl counts from when the call settles, not when it started", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  t = 50;
+  calls[0]!.d.resolve("v");
+  await tick();
+  t = 149;
+  expect(await m("k")).toBe("v");
+  t = 150;
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("clear forgets calls still in flight", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
