 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+interface Entry<V> {
+  value: V;
+  expiresAt: number;
+}
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  private readonly entries = new Map<K, Entry<V>>();
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
-  }
+  constructor(
+    private readonly capacity: number,
+    private readonly ttlMs: number,
+    private readonly now: () => number = Date.now,
+  ) {}
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (e === undefined) return undefined;
+    if (!this.isLive(e)) {
+      this.remove(key, e, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.entries.delete(key);
+    this.entries.set(key, { value, expiresAt: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, e] of [...this.entries]) {
+      if (!this.isLive(e)) this.remove(k, e, 'expired');
+    }
+    for (const [k, e] of this.entries) {
+      if (this.entries.size <= this.capacity) break;
+      this.remove(k, e, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (e === undefined) return false;
+    if (!this.isLive(e)) {
+      this.remove(key, e, 'expired');
+      return false;
+    }
+    this.remove(key, e, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const e of this.entries.values()) if (this.isLive(e)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const live: K[] = [];
+    for (const [k, e] of this.entries) if (this.isLive(e)) live.push(k);
+    return live.reverse();
+  }
+
+  private isLive(e: Entry<V>): boolean {
+    return this.now() < e.expiresAt;
+  }
+
+  private remove(key: K, e: Entry<V>, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, e.value, reason);
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 17:01:49.925457097 +0000
+++ b/src/slug.ts	2026-10-29 17:03:58.431181279 +0000
@@ -11,10 +11,25 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  if (slug[max] === '-') return slug.slice(0, max);
+  const i = slug.lastIndexOf('-', max - 1);
+  return i > 0 ? slug.slice(0, i) : slug.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 17:02:49.564499753 +0000
@@ -0,0 +1,31 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parseDuration units, fractions and spacing', () => {
+  expect(parseDuration('90s')).toBe(90_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('  90s ')).toBe(90_000);
+  expect(parseDuration('1.5ms')).toBe(2);
+});
+
+test('parseDuration rejects malformed input and names it', () => {
+  for (const bad of ['', '10', '5x', 'h', '-1s']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
+
+test('formatDuration shortest form', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(1.4)).toBe('1ms');
+});
+
+test('formatDuration rejects negative and non-finite input', () => {
+  expect(() => formatDuration(-1)).toThrow('-1');
+  expect(() => formatDuration(Number.NaN)).toThrow();
+  expect(() => formatDuration(Number.POSITIVE_INFINITY)).toThrow();
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 17:04:13.319182164 +0000
@@ -0,0 +1,93 @@
+import { expect, test } from 'bun:test';
+import { type EvictReason, LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const evicted: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => evicted.push([k, v, r]);
+  return { cache, evicted, setTime: (x: number) => (t = x) };
+}
+
+test('capacity eviction removes the least recently used', () => {
+  const { cache, evicted } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('a hit refreshes recency', () => {
+  const { cache, evicted } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(evicted).toEqual([['b', 2, 'capacity']]);
+});
+
+test('ttl boundary', () => {
+  const { cache, evicted, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(999);
+  expect(cache.get('a')).toBe(1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+});
+
+test('expired entries go first and still count toward capacity', () => {
+  const { cache, evicted, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(500);
+  cache.set('b', 2);
+  setTime(1000);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('keys and size leave out expired entries without a callback', () => {
+  const { cache, evicted, setTime } = setup(5, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  setTime(1000);
+  expect(cache.size).toBe(0);
+  expect(cache.keys()).toEqual([]);
+  expect(evicted).toEqual([]);
+});
+
+test('expired entries are not evicted when under capacity', () => {
+  const { cache, evicted, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(1000);
+  cache.set('b', 2);
+  expect(evicted).toEqual([]);
+  expect(cache.size).toBe(1);
+});
+
+test('delete reasons', () => {
+  const { cache, evicted, setTime } = setup(5, 1000);
+  cache.set('a', 1);
+  expect(cache.delete('a')).toBe(true);
+  expect(evicted).toEqual([['a', 1, 'delete']]);
+  expect(cache.delete('missing')).toBe(false);
+  expect(evicted).toHaveLength(1);
+  cache.set('b', 2);
+  setTime(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(evicted[1]).toEqual(['b', 2, 'expired']);
+});
+
+test('re-setting a key renews ttl and recency without a callback', () => {
+  const { cache, evicted, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  setTime(900);
+  cache.set('a', 3);
+  setTime(1500);
+  expect(cache.get('b')).toBeUndefined();
+  expect(cache.get('a')).toBe(3);
+  expect(evicted).toEqual([['b', 2, 'expired']]);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 17:04:01.759181477 +0000
@@ -0,0 +1,35 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify diacritics and special letters', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('Straße Æble Œuvre Øl Łódź Đak')).toBe('strasse-aeble-oeuvre-ol-lodz-dak');
+  expect(slugify('ẞ')).toBe('ss');
+});
+
+test('slugify separators', () => {
+  expect(slugify('--a  b--')).toBe('a-b');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('x² y')).toBe('x-y');
+  expect(slugify('5℃')).toBe('5');
+  expect(slugify('ﬁsh')).toBe('sh');
+  expect(slugify('Ａbc')).toBe('bc');
+  expect(slugify('a™b')).toBe('a-b');
+});
+
+test('slugify with max 0 or empty input', () => {
+  expect(slugify('abc', 0)).toBe('');
+  expect(slugify('', 3)).toBe('');
+});
+
+test('slugify with max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cdef', 5)).toBe('ab');
+  expect(slugify('abcdefg', 3)).toBe('abc');
+  expect(slugify('abc', 5)).toBe('abc');
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('p', new Set())).toBe('p');
+  expect(uniqueSlug('p', new Set(['p', 'p-2']))).toBe('p-3');
+});
