diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.test.ts b/memo.test.ts
--- a/memo.test.ts	2026-10-29 08:59:20.858057921 +0000
+++ b/memo.test.ts	2026-10-29 09:00:06.836922116 +0000
@@ -66,3 +66,130 @@
   m("k");
   expect(calls).toHaveLength(2);
 });
+
+test("a result in flight during clear is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("an old call settling after invalidate does not replace the newer result", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[1]!.d.resolve("new");
+  await tick();
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(await second).toBe("new");
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("an old call rejecting after invalidate does not forget the newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("old"));
+  await expect(first).rejects.toThrow("old");
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a key dropped to stay under max is not kept when its call settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a call answered from the cache makes its key most recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  await m("a");
+  m("c"); // drops b, not a
+  expect(await m("a")).toBe("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("joining a call in flight makes its key most recently used", () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("a");
+  m("c"); // drops b, not a
+  m("a");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+});
+
+test("a rejection reaches every waiting caller and is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(a).rejects.toThrow("boom");
+  await expect(b).rejects.toThrow("boom");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("expired keys are not kept and do not push out live keys", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("old");
+  calls[0]!.d.resolve("old");
+  await tick();
+  t = 50;
+  m("live");
+  calls[1]!.d.resolve("live");
+  await tick();
+  t = 120; // "old" expired, "live" has not
+  expect(m.size).toBe(1);
+  m("new");
+  expect(await m("live")).toBe("live");
+  expect(calls).toHaveLength(3);
+});
+
+test("a synchronous throw from fn is a rejection that is not kept", async () => {
+  let n = 0;
+  const m = memo(async (k: string) => k, { ttlMs: 1000, max: 10 });
+  const throwing = memo(
+    (k: string) => {
+      n++;
+      if (n === 1) throw new Error("sync");
+      return m(k);
+    },
+    { ttlMs: 1000, max: 10 },
+  );
+  await expect(throwing("k")).rejects.toThrow("sync");
+  expect(throwing.size).toBe(0);
+  expect(await throwing("k")).toBe("k");
+  expect(n).toBe(2);
+});
