--- a/src/slug.ts	2026-10-29 17:03:00.192972687 +0000
+++ b/src/slug.ts	2026-10-29 17:04:04.143373462 +0000
@@ -11,10 +11,25 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (s[max] === '-') return s.slice(0, max);
+  const head = s.slice(0, max);
+  const i = head.lastIndexOf('-');
+  return i > 0 ? head.slice(0, i) : head;
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  let candidate = slug;
+  for (let n = 2; taken.has(candidate); n++) candidate = `${slug}-${n}`;
+  return candidate;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 17:05:46.571187707 +0000
@@ -0,0 +1,46 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parseDuration accepts every unit, fractions and spaces', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+  expect(parseDuration('1m 1ms')).toBe(60_001);
+});
+
+test('parseDuration rounds to whole milliseconds', () => {
+  expect(parseDuration('1.0005s')).toBe(1001);
+});
+
+test('parseDuration throws with the input in the message', () => {
+  for (const bad of ['', '10', '5x', 'h', '-1s']) {
+    expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+  }
+});
+
+test('formatDuration', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(() => formatDuration(-1)).toThrow();
+});
+
+test('parseDuration and formatDuration round trip', () => {
+  expect(formatDuration(parseDuration('2d4h'))).toBe('2d4h');
+});
+
+test('parseDuration error message holds the raw input, unescaped', () => {
+  expect(() => parseDuration('5x\n')).toThrow('5x\n');
+  expect(() => parseDuration('a"b')).toThrow('a"b');
+});
+
+test('formatDuration rejects non-finite input', () => {
+  expect(() => formatDuration(NaN)).toThrow();
+  expect(() => formatDuration(Infinity)).toThrow();
+});
+
+test('formatDuration rounds fractional milliseconds like parseDuration', () => {
+  expect(formatDuration(1.5)).toBe('2ms');
+  expect(formatDuration(0.3)).toBe('0s');
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 17:05:46.571187707 +0000
@@ -0,0 +1,119 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+function recorder() {
+  const log: [string, number, string][] = [];
+  return { log, onEvict: (k: string, v: number, r: string) => log.push([k, v, r]) };
+}
+
+test('a hit refreshes recency', () => {
+  const rec = recorder();
+  const cache = new LRU<string, number>(2, 1000, () => 0);
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(rec.log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('expiry happens exactly at t + ttl', () => {
+  let t = 0;
+  const rec = recorder();
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = rec.onEvict;
+  cache.set('k', 7);
+  t = 999;
+  expect(cache.get('k')).toBe(7);
+  t = 1000;
+  expect(cache.get('k')).toBeUndefined();
+  expect(rec.log).toEqual([['k', 7, 'expired']]);
+});
+
+test('expired entries are evicted before live ones and still count toward capacity', () => {
+  let t = 0;
+  const rec = recorder();
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1200;
+  cache.set('c', 3);
+  expect(rec.log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('when every other entry is expired, no live entry is evicted', () => {
+  let t = 0;
+  const rec = recorder();
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  t = 2000;
+  cache.set('c', 3);
+  expect(rec.log).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('delete reports live, expired and missing keys', () => {
+  let t = 0;
+  const rec = recorder();
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.onEvict = rec.onEvict;
+  cache.set('live', 1);
+  cache.set('old', 2);
+  t = 1000;
+  cache.set('new', 3);
+  expect(cache.delete('new')).toBe(true);
+  expect(cache.delete('old')).toBe(false);
+  expect(cache.delete('missing')).toBe(false);
+  expect(rec.log).toEqual([
+    ['new', 3, 'delete'],
+    ['old', 2, 'expired'],
+  ]);
+});
+
+test('size counts only live entries', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 600;
+  cache.set('b', 2);
+  t = 1000;
+  expect(cache.size).toBe(1);
+});
+
+test('set on an existing live key refreshes ttl and recency without evicting', () => {
+  let t = 0;
+  const rec = recorder();
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  t = 900;
+  cache.set('a', 10);
+  t = 1500;
+  expect(cache.get('a')).toBe(10);
+  expect(cache.keys()).toEqual(['a']);
+  expect(rec.log).toEqual([]);
+});
+
+test('an expired entry goes before a live one even when it was used more recently', () => {
+  let t = 0;
+  const rec = recorder();
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  t = 1100;
+  cache.set('c', 3);
+  expect(rec.log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 17:04:12.416599132 +0000
@@ -0,0 +1,29 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify strips diacritics', () => {
+  expect(slugify('ÀÇÑŹ')).toBe('acnz');
+});
+
+test('slugify expands special letters', () => {
+  expect(slugify('Straße Æon Œuvre Ørsted Łódź Đak')).toBe('strasse-aeon-oeuvre-orsted-lodz-dak');
+});
+
+test('slugify collapses separators and trims them from the ends', () => {
+  expect(slugify('  --Hi!!  there--  ')).toBe('hi-there');
+});
+
+test('slugify cuts at the last dash within max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('ab-cd', 10)).toBe('ab-cd');
+});
+
+test('slugify cuts at max when there is no dash to cut at', () => {
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+});
+
+test('uniqueSlug finds the first free suffix', () => {
+  expect(uniqueSlug('p', new Set(['p', 'p-2']))).toBe('p-3');
+  expect(uniqueSlug('p', new Set())).toBe('p');
+});
