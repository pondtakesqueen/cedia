 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
 
+  // Map insertion order is the recency order: the least recently used entry comes first.
+  private entries = new Map<K, { value: V; expiresAt: number }>();
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
+
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
+  }
+
+  private isLive(e: { expiresAt: number }): boolean {
+    return this.now() < e.expiresAt;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return undefined;
+    this.entries.delete(key);
+    if (!this.isLive(e)) {
+      this.onEvict?.(key, e.value, 'expired');
+      return undefined;
+    }
+    this.entries.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const old = this.entries.get(key);
+    if (old && !this.isLive(old)) this.onEvict?.(key, old.value, 'expired');
+    this.entries.delete(key);
+    this.entries.set(key, { value, expiresAt: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, e] of [...this.entries]) {
+      if (!this.isLive(e)) {
+        this.entries.delete(k);
+        this.onEvict?.(k, e.value, 'expired');
+      }
+    }
+    for (const [k, e] of [...this.entries]) {
+      if (this.entries.size <= this.capacity) break;
+      this.entries.delete(k);
+      this.onEvict?.(k, e.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return false;
+    this.entries.delete(key);
+    if (!this.isLive(e)) {
+      this.onEvict?.(key, e.value, 'expired');
+      return false;
+    }
+    this.onEvict?.(key, e.value, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    return [...this.entries.values()].filter((e) => this.isLive(e)).length;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.entries]
+      .filter(([, e]) => this.isLive(e))
+      .map(([k]) => k)
+      .reverse();
   }
 }
