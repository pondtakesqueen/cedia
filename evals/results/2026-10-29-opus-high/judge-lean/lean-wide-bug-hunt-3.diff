diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 17:01:44.557671287 +0000
@@ -0,0 +1,91 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('the region table', () => {
+    expect(REGIONS).toEqual({
+      US: { code: 'US', taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 },
+      EU: { code: 'EU', taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 },
+      UK: { code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 },
+    });
+  });
+
+  test('a bulk discount starts at 10 units', () => {
+    // 9 pens = 1080, no discount; shipping 800; tax 7% of 1880 = 131.6 -> 132
+    expect(totals(cart('US', [['PEN', 9]]))).toMatchObject({ subtotal: 1080, shipping: 800, tax: 132, total: 2012 });
+    // 10 pens = 1200; 5% off = 60; 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('a bulk discount of 50 units or more is 10%, and only the top tier applies', () => {
+    // 50 pens = 6000; 10% off = 600; 5400 >= 5000 ships free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+    // 42 pens = 5040; 5% off = 252; 4788 < 5000 so shipping 800; tax 7% of 5588 = 391.16 -> 391
+    expect(totals(cart('US', [['PEN', 42]]))).toMatchObject({ subtotal: 4788, shipping: 800, tax: 391, total: 5979 });
+  });
+
+  test('lines of the same sku are merged before the bulk tier is picked', () => {
+    // 5 + 5 pens are 10 pens in all: same totals as above
+    const c = cart('US', [['PEN', 5], ['PEN', 5]]);
+    expect(totals(c)).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+    expect(totals(c).lines).toHaveLength(1);
+    // the caller's cart is not changed
+    expect(c.lines.map((l) => l.quantity)).toEqual([5, 5]);
+  });
+
+  test('free shipping is judged on the subtotal after the coupon', () => {
+    // 2200 + 3000 = 5200; SAVE10 takes 520 -> 4680 < 5000, so shipping 800; tax 7% of 5480 = 383.6 -> 384
+    expect(totals(cart('US', [['BAG', 1], ['TEE', 2]], 'SAVE10'))).toMatchObject({
+      subtotal: 5200,
+      coupon: 520,
+      shipping: 800,
+      tax: 384,
+      total: 5864,
+    });
+  });
+
+  test('a bulk discount of 49 units is still 5%, not 10%', () => {
+    // 49 pens = 5880; 5% off = 294; 5586 >= 5000 ships free; tax 7% of 5586 = 391.02 -> 391
+    expect(totals(cart('US', [['PEN', 49]]))).toMatchObject({ subtotal: 5586, shipping: 0, tax: 391, total: 5977 });
+  });
+
+  test('free shipping applies exactly at the threshold', () => {
+    // 1 bag + 4 mugs = 2200 + 1800 = 4000 >= 4000 (UK); tax 20% of 4000 = 800
+    expect(totals(cart('UK', [['BAG', 1], ['MUG', 4]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+
+  test('FLAT5 takes 500 cents off', () => {
+    // 3 bags = 6600; FLAT5 takes 500 -> 6100 >= 5000 ships free; tax 7% of 6100 = 427
+    expect(totals(cart('US', [['BAG', 3]], 'FLAT5'))).toMatchObject({ subtotal: 6600, coupon: 500, shipping: 0, tax: 427, total: 6527 });
+  });
+
+  test('coupon codes match regardless of case', () => {
+    expect(totals(cart('US', [['BAG', 3]], 'flat5'))).toMatchObject({ coupon: 500, total: 6527 });
+  });
+
+  test('EU orders use the EU shipping and threshold', () => {
+    // 1 tee = 1500 < 6000; shipping 900; tax 20% of 2400 = 480
+    expect(totals(cart('EU', [['TEE', 1]]))).toMatchObject({ subtotal: 1500, shipping: 900, tax: 480, total: 2880 });
+    // 3 bags = 6600 >= 6000 ships free; tax 20% of 6600 = 1320
+    expect(totals(cart('EU', [['BAG', 3]]))).toMatchObject({ subtotal: 6600, shipping: 0, tax: 1320, total: 7920 });
+  });
+
+  test('UK orders ship free from 4000', () => {
+    // 2 bags = 4400 >= 4000; tax 20% of 4400 = 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+    // 2 tees = 3000 < 4000; shipping 700; tax 20% of 3700 = 740
+    expect(totals(cart('UK', [['TEE', 2]]))).toMatchObject({ subtotal: 3000, shipping: 700, tax: 740, total: 4440 });
+  });
+
+  test('FLAT5 never takes the order below zero', () => {
+    // 1 pen = 120; FLAT5 takes only 120; 0 left; shipping 800; tax 7% of 800 = 56
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ subtotal: 120, coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('an unknown coupon gives no discount', () => {
+    expect(totals(cart('US', [['MUG', 2]], 'NOPE')).coupon).toBe(0);
+  });
+});
