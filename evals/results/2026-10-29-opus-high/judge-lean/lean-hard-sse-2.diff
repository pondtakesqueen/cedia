+
+function fromChunks(parts: string[]): ReadableStream<Uint8Array> {
+  const enc = new TextEncoder();
+  return new ReadableStream({
+    start(c) {
+      for (const p of parts) c.enqueue(enc.encode(p));
+      c.close();
+    },
+  });
+}
+
+test('a pending event and data at end of body are yielded', async () => {
+  expect(await all('event: e\ndata: p')).toEqual([{ event: 'e', data: 'p' }]);
+  expect(await all('event: x')).toEqual([]);
+});
+
+test('CRLF body ending without a blank line, and CR and LF split at the end', async () => {
+  expect(await all('data: a\r\ndata: b\r\n')).toEqual([{ data: 'a\nb' }]);
+  expect(await all('data: a\r\n\r', 100)).toEqual([{ data: 'a' }]);
+  expect(await all('data: a\r', 100)).toEqual([{ data: 'a' }]);
+  expect(await fromChunksMessages(['data: a\r', '\n', '\r', '\n'])).toEqual([{ data: 'a' }]);
+});
+
+async function fromChunksMessages(parts: string[]): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(fromChunks(parts))) out.push(m);
+  return out;
+}
+
+test('breaking out of the loop cancels the body', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const _ of readSse(body)) break;
+  expect(cancelled).toBe(true);
+});
+
+test('a read error from the body reaches the caller unchanged', async () => {
+  const enc = new TextEncoder();
+  let step = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (step++ === 0) c.enqueue(enc.encode('data: ok\n\n'));
+      else c.error(new Error('boom'));
+    },
+  });
+  const out: SseMessage[] = [];
+  const failure = (async () => {
+    for await (const m of readSse(body)) out.push(m);
+  })();
+  await expect(failure).rejects.toThrow('boom');
+  expect(out).toEqual([{ data: 'ok' }]);
+});
+
+test('a long data line in small chunks is read in linear time', async () => {
+  const big = 'x'.repeat(200_000);
+  const parts: string[] = [];
+  for (let i = 0; i < big.length; i += 10) parts.push(big.slice(i, i + 10));
+  const start = performance.now();
+  const msgs = await fromChunksMessages(['data: ', ...parts, '\n\n']);
+  expect(msgs).toEqual([{ data: big }]);
+  expect(performance.now() - start).toBeLessThan(2000);
+});
