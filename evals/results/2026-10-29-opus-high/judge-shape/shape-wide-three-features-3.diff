 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNIT_MS: Record<string, number> = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1000, ms: 1 };
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  if (s === '') throw new Error(`invalid duration "${text}"`);
+  const part = /(\d+(?:\.\d+)?)(ms|d|h|m|s) */y;
+  let total = 0;
+  while (part.lastIndex < s.length) {
+    const m = part.exec(s);
+    if (!m) throw new Error(`invalid duration "${text}"`);
+    total += Number(m[1]) * UNIT_MS[m[2]];
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration ms: ${ms}`);
+  let rest = Math.round(ms);
+  let out = '';
+  for (const [unit, size] of Object.entries(UNIT_MS)) {
+    const q = Math.floor(rest / size);
+    if (q > 0) {
+      out += `${q}${unit}`;
+      rest -= q * size;
+    }
+  }
+  return out || '0s';
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
--- a/src/lru.ts	2026-10-29 16:05:26.132010291 +0000
+++ b/src/lru.ts	2026-10-29 16:07:05.383426447 +0000
@@ -14,30 +14,78 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
+// The Map keeps every stored entry, live or expired, least recently used first. An entry is removed from the
+// Map before onEvict is called, so if onEvict throws, the error propagates and the cache stays consistent.
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  private entries = new Map<K, Entry<V>>();
+  private capacity: number;
+  private ttlMs: number;
+  private now: () => number;
 
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return undefined;
+    if (!this.isLive(entry)) {
+      this.evict(key, entry, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.entries.delete(key);
+    this.entries.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, e] of [...this.entries]) {
+      if (!this.isLive(e)) this.evict(k, e, 'expired');
+    }
+    while (this.entries.size > this.capacity) {
+      const [k, e] = this.entries.entries().next().value as [K, Entry<V>];
+      this.evict(k, e, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return false;
+    if (!this.isLive(entry)) {
+      this.evict(key, entry, 'expired');
+      return false;
+    }
+    this.evict(key, entry, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const entry of this.entries.values()) if (this.isLive(entry)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.entries]
+      .filter(([, entry]) => this.isLive(entry))
+      .map(([key]) => key)
+      .reverse();
+  }
+
+  private isLive(entry: Entry<V>): boolean {
+    return this.now() < entry.expires;
+  }
+
+  private evict(key: K, entry: Entry<V>, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, entry.value, reason);
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 16:05:26.132051888 +0000
+++ b/src/slug.ts	2026-10-29 16:08:33.739085275 +0000
@@ -11,10 +11,24 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  const cut = s.lastIndexOf('-', max);
+  return cut > 0 ? s.slice(0, cut) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 16:08:30.483085082 +0000
@@ -0,0 +1,58 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('each unit parses', () => {
+  expect(parseDuration('1d')).toBe(86_400_000);
+  expect(parseDuration('1h')).toBe(3_600_000);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('1s')).toBe(1000);
+  expect(parseDuration('250ms')).toBe(250);
+});
+
+test('ms is not read as m followed by s', () => {
+  expect(parseDuration('1m1s')).toBe(61_000);
+  expect(parseDuration('1ms')).toBe(1);
+});
+
+test('fractions parse and the result is rounded', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('0.4ms')).toBe(0);
+  expect(parseDuration('1.5ms')).toBe(2);
+});
+
+test('spaces between parts and around the text', () => {
+  expect(parseDuration('2d 4h')).toBe(2 * 86_400_000 + 4 * 3_600_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+});
+
+test('invalid input throws with the input in the message', () => {
+  for (const input of ['', '10', '5x', 'h', '-1s', '  ']) {
+    expect(() => parseDuration(input)).toThrow(JSON.stringify(input));
+  }
+});
+
+test('error message holds the raw input, quotes and backslashes included', () => {
+  expect(() => parseDuration('5"x')).toThrow('5"x');
+  expect(() => parseDuration('5\\x')).toThrow('5\\x');
+});
+
+test('format examples', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+});
+
+test('format rejects negative and non-finite numbers', () => {
+  expect(() => formatDuration(-1)).toThrow('invalid duration ms: -1');
+  expect(() => formatDuration(NaN)).toThrow();
+  expect(() => formatDuration(Infinity)).toThrow();
+});
+
+test('parse(format(n)) is n', () => {
+  const values: number[] = [];
+  for (let i = 0; i < 500; i++) values.push(i * 7919 + i ** 3);
+  for (const b of [86_400_000, 3_600_000, 60_000, 1000]) values.push(b - 1, b, b + 1);
+  for (const n of values) expect(parseDuration(formatDuration(n))).toBe(n);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 16:07:19.067080837 +0000
@@ -0,0 +1,180 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const log: [string, number, string][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return { cache, log, setTime: (v: number) => (t = v) };
+}
+
+test('a get hit refreshes recency', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('an expired get logs once and returns undefined', () => {
+  const { cache, log, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.get('a')).toBeUndefined();
+  expect(log).toEqual([['a', 1, 'expired']]);
+});
+
+test('expiry boundary: live before t+ttl, expired at t+ttl', () => {
+  const { cache, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(999);
+  expect(cache.get('a')).toBe(1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('set refreshes the ttl', () => {
+  const { cache, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(500);
+  cache.set('a', 2);
+  setTime(1400);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('overwriting does not evict anything', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('a', 3);
+  expect(log).toEqual([]);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  expect(cache.get('a')).toBe(3);
+});
+
+test('capacity counts expired entries, and expired ones go first', () => {
+  const { cache, log, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(600);
+  cache.set('b', 2);
+  setTime(1000);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('with nothing expired, the least recently used entry is evicted', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'capacity']]);
+});
+
+test('delete on a live entry', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  expect(cache.delete('a')).toBe(true);
+  expect(log).toEqual([['a', 1, 'delete']]);
+});
+
+test('delete on an expired entry', () => {
+  const { cache, log, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(1000);
+  expect(cache.delete('a')).toBe(false);
+  expect(log).toEqual([['a', 1, 'expired']]);
+});
+
+test('delete on a missing key', () => {
+  const { cache, log } = setup(2, 1000);
+  expect(cache.delete('a')).toBe(false);
+  expect(log).toEqual([]);
+});
+
+test('size and keys skip expired entries and call no onEvict', () => {
+  const { cache, log, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  setTime(600);
+  cache.set('b', 2);
+  setTime(1000);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+  setTime(1600);
+  expect(cache.size).toBe(0);
+  expect(log).toEqual([]);
+});
+
+test('agrees with a naive model over random operations', () => {
+  let t = 0;
+  const cache = new LRU<number, number>(3, 1000, () => t);
+  const log: string[] = [];
+  cache.onEvict = (k, v, r) => log.push(`${k}:${v}:${r}`);
+
+  // Model: an array, least recently used first, with each entry's expiry time.
+  const model: { k: number; v: number; exp: number }[] = [];
+  const mLog: string[] = [];
+  const live = (e: { exp: number }) => t < e.exp;
+  const mRemove = (i: number, reason: string) => {
+    const [e] = model.splice(i, 1);
+    mLog.push(`${e.k}:${e.v}:${reason}`);
+  };
+
+  let seed = 42;
+  const next = (n: number) => {
+    seed = (seed * 16807) % 2147483647;
+    return seed % n;
+  };
+
+  for (let step = 0; step < 2000; step++) {
+    const op = next(10);
+    const k = next(6);
+    if (op < 4) {
+      cache.set(k, step);
+      const i = model.findIndex((e) => e.k === k);
+      if (i >= 0) model.splice(i, 1);
+      model.push({ k, v: step, exp: t + 1000 });
+      if (model.length > 3) {
+        for (let j = 0; j < model.length; ) {
+          if (live(model[j])) j++;
+          else mRemove(j, 'expired');
+        }
+        while (model.length > 3) mRemove(0, 'capacity');
+      }
+    } else if (op < 7) {
+      const i = model.findIndex((e) => e.k === k);
+      const [e] = i >= 0 ? model.splice(i, 1) : [];
+      let want: number | undefined;
+      if (e && live(e)) {
+        model.push(e);
+        want = e.v;
+      } else if (e) {
+        mLog.push(`${e.k}:${e.v}:expired`);
+      }
+      expect(cache.get(k)).toBe(want);
+    } else if (op < 9) {
+      const i = model.findIndex((e) => e.k === k);
+      let want = false;
+      if (i >= 0) {
+        if (live(model[i])) {
+          mRemove(i, 'delete');
+          want = true;
+        } else {
+          mRemove(i, 'expired');
+        }
+      }
+      expect(cache.delete(k)).toBe(want);
+    } else {
+      t += next(401);
+    }
+    const liveModel = model.filter(live);
+    expect(cache.size).toBe(liveModel.length);
+    expect(cache.keys()).toEqual(liveModel.map((e) => e.k).reverse());
+    expect(log).toEqual(mLog);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 16:08:39.331085608 +0000
@@ -0,0 +1,68 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+// Naive reference for the max cut: the last "-" at or before index max, else max itself.
+function refCut(s: string, max: number): string {
+  if (s.length <= max) return s;
+  for (let len = max; len >= 1; len--) if (s[len] === '-') return s.slice(0, len);
+  return s.slice(0, max);
+}
+
+test('lower case and diacritics', () => {
+  expect(slugify('ABC')).toBe('abc');
+  expect(slugify('àçñź')).toBe('acnz');
+});
+
+test('compatibility characters are separators, not letters', () => {
+  expect(slugify('½ cup')).toBe('cup');
+  expect(slugify('x²')).toBe('x');
+  expect(slugify('ﬁsh')).toBe('sh');
+  expect(slugify('ＦＵＬＬ')).toBe('');
+});
+
+test('special letters map', () => {
+  expect(slugify('ß æ œ ø ł đ')).toBe('ss-ae-oe-o-l-d');
+  expect(slugify('ÆØŁ')).toBe('aeol');
+});
+
+test('separators and ends', () => {
+  expect(slugify('a  --!!b')).toBe('a-b');
+  expect(slugify('--a--')).toBe('a');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('Top 10')).toBe('top-10');
+});
+
+test('cut with max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab-cdefgh', 5)).toBe('ab');
+  expect(slugify('ab-cd', 5)).toBe('ab-cd');
+});
+
+test('cut agrees with the naive reference', () => {
+  let seed = 7;
+  const next = (n: number) => {
+    seed = (seed * 16807) % 2147483647;
+    return seed % n;
+  };
+  const alphabet = 'ab cé-!';
+  for (let i = 0; i < 200; i++) {
+    let text = '';
+    const len = next(31);
+    for (let j = 0; j < len; j++) text += alphabet[next(alphabet.length)];
+    const full = slugify(text);
+    for (let max = 1; max <= 30; max++) {
+      const cut = slugify(text, max);
+      expect(cut).toBe(refCut(full, max));
+      expect(cut.length).toBeLessThanOrEqual(max);
+      expect(cut.endsWith('-')).toBe(false);
+    }
+  }
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+});
