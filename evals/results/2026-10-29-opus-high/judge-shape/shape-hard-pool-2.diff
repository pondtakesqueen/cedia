diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.contract.test.ts b/pool.contract.test.ts
--- a/pool.contract.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.contract.test.ts	2026-10-29 15:54:57.491036755 +0000
@@ -0,0 +1,209 @@
+import { expect, test } from "bun:test";
+import { runPool, type Settled } from "./pool";
+
+const deferred = <T>() => {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((a, b) => {
+    resolve = a;
+    reject = b;
+  });
+  return { promise, resolve, reject };
+};
+
+const flush = () => new Promise((r) => setImmediate(r));
+
+const mulberry32 = (seed: number) => () => {
+  seed = (seed + 0x6d2b79f5) | 0;
+  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+};
+
+const summary = (r: Settled<unknown>) =>
+  r.status === "fulfilled" ? [r.status, r.value, r.attempts] : [r.status, (r.reason as Error).message, r.attempts];
+
+test("rule 1: refuses a limit that is not a whole number of 1 or more, or Infinity", async () => {
+  // "2" is not a number at all: the type rules it out, but a plain JS caller can still pass it.
+  for (const limit of [0, -1, 1.5, NaN, "2" as unknown as number]) {
+    let calls = 0;
+    await expect(runPool([() => (calls++, 1)], limit)).rejects.toBeInstanceOf(RangeError);
+    expect(calls).toBe(0);
+  }
+});
+
+test("rule 1: refuses retries that are not a whole number of 0 or more", async () => {
+  for (const retries of [-1, 0.5, NaN, Infinity]) {
+    let calls = 0;
+    await expect(runPool([() => (calls++, 1)], 1, { retries })).rejects.toBeInstanceOf(RangeError);
+    expect(calls).toBe(0);
+  }
+});
+
+test("rule 1: a limit of Infinity runs everything", async () => {
+  const out = await runPool([() => 1, () => Promise.resolve(2), () => 3], Infinity);
+  expect(out.map((r) => r.status === "fulfilled" && r.value)).toEqual([1, 2, 3]);
+});
+
+test("rule 2: never more than limit in flight, and the next task starts as soon as one settles", async () => {
+  const ds = Array.from({ length: 6 }, () => deferred<number>());
+  const started: number[] = [];
+  const tasks = ds.map((d, i) => () => (started.push(i), d.promise));
+  const p = runPool(tasks, 2);
+  await flush();
+  expect(started).toEqual([0, 1]);
+  ds[1].resolve(1);
+  await flush();
+  expect(started).toEqual([0, 1, 2]);
+  ds.forEach((d, i) => i !== 1 && d.resolve(i));
+  await flush();
+  expect(started).toEqual([0, 1, 2, 3, 4, 5]);
+  ds[5].resolve(5);
+  await p;
+});
+
+test("rule 3: a synchronous throw is a rejection, a plain value is a fulfilment", async () => {
+  const err = new Error("boom");
+  const out = await runPool<number>([() => { throw err; }, () => 5, () => Promise.resolve(6)], 1);
+  expect(out[0]).toEqual({ status: "rejected", reason: err, attempts: 1 });
+  expect(out[1]).toEqual({ status: "fulfilled", value: 5, attempts: 1 });
+  expect(out[2]).toEqual({ status: "fulfilled", value: 6, attempts: 1 });
+});
+
+test("rule 4: retries in the same slot up to retries times, attempts counts every call", async () => {
+  let calls = 0;
+  const flaky = () => {
+    calls++;
+    return calls <= 2 ? Promise.reject(new Error(`fail ${calls}`)) : Promise.resolve("ok");
+  };
+  expect(await runPool([flaky], 1, { retries: 2 })).toEqual([{ status: "fulfilled", value: "ok", attempts: 3 }]);
+  expect(calls).toBe(3);
+
+  calls = 0;
+  const out = await runPool([flaky], 1, { retries: 1 });
+  expect(summary(out[0])).toEqual(["rejected", "fail 2", 2]);
+  expect(calls).toBe(2);
+
+  calls = 0;
+  const once = await runPool([flaky], 1);
+  expect(summary(once[0])).toEqual(["rejected", "fail 1", 1]);
+  expect(calls).toBe(1);
+});
+
+test("rule 5: an already aborted signal starts nothing", async () => {
+  const ac = new AbortController();
+  ac.abort("stop");
+  let calls = 0;
+  const out = await runPool([() => (calls++, 1), () => (calls++, 2)], 2, { signal: ac.signal });
+  expect(calls).toBe(0);
+  expect(out).toEqual([
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("rule 5: an abort leaves in-flight tasks to keep their result and stops unstarted ones", async () => {
+  const ac = new AbortController();
+  const d = deferred<string>();
+  const started: number[] = [];
+  const tasks = [() => (started.push(0), d.promise), () => (started.push(1), "b"), () => (started.push(2), "c")];
+  const p = runPool(tasks, 1, { signal: ac.signal });
+  await flush();
+  ac.abort("stop");
+  d.resolve("a");
+  const out = await p;
+  expect(out[0]).toEqual({ status: "fulfilled", value: "a", attempts: 1 });
+  expect(out[1]).toEqual({ status: "rejected", reason: "stop", attempts: 0 });
+  expect(out[2]).toEqual({ status: "rejected", reason: "stop", attempts: 0 });
+  expect(started).toEqual([0]);
+});
+
+test("rule 5: a retry cancelled by an abort settles with signal.reason and the attempts made", async () => {
+  const ac = new AbortController();
+  const d = deferred<string>();
+  let calls = 0;
+  const p = runPool([() => (calls++, d.promise)], 1, { retries: 3, signal: ac.signal });
+  await flush();
+  ac.abort("stop");
+  d.reject(new Error("nope"));
+  const out = await p;
+  expect(out).toEqual([{ status: "rejected", reason: "stop", attempts: 1 }]);
+  expect(calls).toBe(1);
+});
+
+test("rule 5: a task in flight that fails with no retries left keeps its own error after an abort", async () => {
+  const ac = new AbortController();
+  const d = deferred<string>();
+  const err = new Error("own");
+  const p = runPool([() => d.promise], 1, { retries: 0, signal: ac.signal });
+  await flush();
+  ac.abort("stop");
+  d.reject(err);
+  expect(await p).toEqual([{ status: "rejected", reason: err, attempts: 1 }]);
+});
+
+test("rule 5: an abort with nothing in flight still resolves, with the unstarted tasks rejected", async () => {
+  const ac = new AbortController();
+  let calls = 0;
+  const tasks = [
+    () => (ac.abort("stop"), 1),
+    () => (calls++, 2),
+    () => (calls++, 3),
+  ];
+  const out = await runPool(tasks, 1, { signal: ac.signal });
+  expect(out).toEqual([
+    { status: "fulfilled", value: 1, attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+  expect(calls).toBe(0);
+});
+
+test("rule 6: every task failing still resolves, with rejected entries in input order", async () => {
+  const out = await runPool([() => Promise.reject("a"), () => Promise.reject("b")], 2, { retries: 1 });
+  expect(out).toEqual([
+    { status: "rejected", reason: "a", attempts: 2 },
+    { status: "rejected", reason: "b", attempts: 2 },
+  ]);
+});
+
+test("rules 2, 3, 4, 6: random runs keep the limit, input order and the retry count under any timing", async () => {
+  const rand = mulberry32(12345);
+  for (let run = 0; run < 200; run++) {
+    const n = Math.floor(rand() * 11);
+    const limit = 1 + Math.floor(rand() * 4);
+    const retries = Math.floor(rand() * 3);
+    const specs = Array.from({ length: n }, () => ({
+      failsBefore: rand() < 0.4 ? Math.floor(rand() * 4) : 0,
+      depth: Math.floor(rand() * 4),
+    }));
+
+    let inFlight = 0;
+    let max = 0;
+    const started: number[] = [];
+    const calls = new Array(n).fill(0);
+    const tasks = specs.map((spec, i) => () => {
+      if (calls[i] === 0) started.push(i);
+      calls[i]++;
+      inFlight++;
+      max = Math.max(max, inFlight);
+      return (async () => {
+        for (let d = 0; d < spec.depth; d++) await null;
+        inFlight--;
+        if (calls[i] <= spec.failsBefore) throw new Error(`task ${i}`);
+        return i;
+      })();
+    });
+
+    const out = await runPool(tasks, limit, { retries });
+    expect(max).toBeLessThanOrEqual(limit);
+    expect(started).toEqual(Array.from({ length: n }, (_, i) => i));
+    const expected = specs.map((spec, i) =>
+      spec.failsBefore <= retries
+        ? ["fulfilled", i, spec.failsBefore + 1]
+        : ["rejected", `task ${i}`, retries + 1],
+    );
+    expect(out.map(summary)).toEqual(expected);
+    expect(calls).toEqual(out.map((r) => r.attempts));
+  }
+});
