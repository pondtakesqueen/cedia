+  });
+
+  test('agreement between verified and evidence, and ledgerEntries is unchanged by a request between call pairs', () => {
+    let s = 42;
+    const rnd = (k: number) => {
+      s = (s * 1103515245 + 12345) % 2 ** 31;
+      return s % k;
+    };
+    for (let iter = 0; iter < 500; iter++) {
+      const len = rnd(9);
+      const entries: LedgerEntry[] = [];
