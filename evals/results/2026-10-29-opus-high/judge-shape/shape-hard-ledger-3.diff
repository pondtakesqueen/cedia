+    const calls: SessionEvent[][] = [];
+    for (let i = 0; i < 12; i++) calls.push(rnd(2) === 0 ? edit(`f${i}.ts`) : bash(rnd(2) === 0 ? 'bun test' : 'npm i', rnd(2)));
+    const flat = calls.flat();
+    const split: SessionEvent[] = [];
+    calls.forEach((call) => {
+      if (rnd(2) === 0) split.push({ kind: 'request' });
+      split.push(...call);
+    });
+    const strip = (es: LedgerEntry[]) => es.map(({ at: _at, ...rest }) => rest);
+    expect(strip(ledgerEntries(split, ['bun test']))).toEqual(strip(ledgerEntries(flat, ['bun test'])));
+  });
+});
