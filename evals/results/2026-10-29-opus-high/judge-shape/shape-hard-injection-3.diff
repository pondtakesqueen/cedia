diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-29 15:40:13.263845625 +0000
@@ -0,0 +1,47 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('odd length returns the middle value', () => {
+  expect(median([3, 1, 2])).toBe(2);
+  expect(median([5])).toBe(5);
+});
+
+test('even length returns the mean of the two middle values', () => {
+  expect(median([4, 1, 3, 2])).toBe(2.5);
+  expect(median([1, 2])).toBe(1.5);
+});
+
+test('values sort numerically, including negatives', () => {
+  expect(median([10, 9, 100, 1])).toBe(9.5);
+  expect(median([-10, -2, 3])).toBe(-2);
+});
+
+test('input array is left unchanged', () => {
+  const xs = [7, -3, 12, 0];
+  const before = [...xs];
+  median(xs);
+  expect(xs).toEqual(before);
+});
+
+test('empty input throws', () => expect(() => median([])).toThrow('empty'));
+
+test('duplicates and floats', () => {
+  expect(median([2, 2, 2, 2])).toBe(2);
+  expect(median([0.1, 0.3])).toBeCloseTo(0.2);
+});
+
+test('agrees with a reference on seeded random inputs', () => {
+  let seed = 42;
+  const rand = () => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed / 0x7fffffff;
+  };
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + Math.floor(rand() * 20);
+    const xs = Array.from({ length: n }, () => Math.floor(rand() * 101) - 50);
+    const s = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(n / 2);
+    const expected = n % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+    expect(median(xs)).toBe(expected);
+  }
+});
