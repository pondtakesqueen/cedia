diff -ruN '--exclude=node_modules' '--exclude=.git' a/ledger.rules.test.ts b/ledger.rules.test.ts
--- a/ledger.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.rules.test.ts	2026-10-29 15:43:14.962518014 +0000
@@ -0,0 +1,121 @@
+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+let n = 0;
+const bash = (command: string, exitCode = 0, status: 'completed' | 'failed' | 'denied' | 'not_started' = exitCode ? 'failed' : 'completed'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool: 'bash', input: { command } },
+    { kind: 'tool_result', callId, status, output: { isError: exitCode !== 0, exitCode } },
+  ];
+};
+const edit = (path: string, status: 'completed' | 'failed' = 'completed'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool: 'edit', input: { path } },
+    { kind: 'tool_result', callId, status, output: { isError: status !== 'completed' } },
+  ];
+};
+const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+// Park-Miller generator, so the random ledgers are the same on every run.
+let seed = 1;
+const rand = (k: number) => {
+  seed = (seed * 16807) % 2147483647;
+  return seed % k;
+};
+const randomLedger = (): LedgerEntry[] => {
+  const len = rand(9);
+  return Array.from({ length: len }, (_, at) => (rand(2) === 0 ? w(at, rand(2) === 0 ? 'a.ts' : 'b.ts') : c(at, rand(2))));
+};
+
+describe('matchCheck rules', () => {
+  test('whitespace and a trailing 2>&1 are normalized on both sides', () => {
+    expect(matchCheck(' make\tlint 2>&1', ['make  lint'])).toBe('make  lint');
+  });
+
+  test('only one trailing 2>&1 is dropped, and only at the end', () => {
+    expect(matchCheck('bun test 2>&1 x', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test 2>&1 2>&1', ['bun test'])).toBeUndefined();
+  });
+
+  test('a cd prefix in single quotes, or a relative path that resolves to cwd, is accepted', () => {
+    expect(matchCheck("cd '/work/repo' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd ../repo && bun test', ['bun test'], cwd)).toBe('bun test');
+  });
+
+  test('a cd that is not followed by && does not count', () => {
+    expect(matchCheck('cd /work/repo; bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+});
+
+describe('ledgerEntries rules', () => {
+  test('a result after a request pairs with an intent after that request', () => {
+    expect(ledgerEntries([{ kind: 'request' }, ...bash('make')], [])).toEqual([{ kind: 'write', at: 2, tool: 'bash', command: 'make' }]);
+  });
+
+  test('a duplicate result counts once', () => {
+    const [intent, result] = edit('a.ts');
+    expect(ledgerEntries([intent!, result!, result!], [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'a.ts' }]);
+  });
+
+  test('a snapshot before its result still applies', () => {
+    const events: SessionEvent[] = [
+      { kind: 'snapshot', callId: 's1', changed: ['x.ts', 'y.ts'] },
+      { kind: 'tool_intent', callId: 's1', tool: 'bash', input: { command: 'gen' } },
+      { kind: 'tool_result', callId: 's1', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([
+      { kind: 'write', at: 2, tool: 'bash', path: 'x.ts' },
+      { kind: 'write', at: 2, tool: 'bash', path: 'y.ts' },
+    ]);
+  });
+
+  test('a failed bash write counts; a failed edit does not', () => {
+    expect(ledgerEntries(bash('make', 2), [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'make' }]);
+    expect(ledgerEntries(edit('a.ts', 'failed'), [])).toEqual([]);
+  });
+
+  test('a read-only bash command with no snapshot is not a write', () => {
+    expect(ledgerEntries(bash('git status'), [])).toEqual([]);
+  });
+
+  test('only a bash call counts as a command; another tool with a command input is not a write or a check', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'v', tool: 'str_replace_editor', input: { command: 'view', path: 'a.ts' } },
+      { kind: 'tool_result', callId: 'v', status: 'completed', output: { isError: false, exitCode: 0 } },
+      { kind: 'tool_intent', callId: 'r', tool: 'read', input: { command: 'bun test' } },
+      { kind: 'tool_result', callId: 'r', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([]);
+  });
+
+  test('a check exit code falls back to 0 when there is no code and isError is false', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'k', tool: 'bash', input: { command: 'bun test' } },
+      { kind: 'tool_result', callId: 'k', status: 'completed', output: { isError: false } },
+    ];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+  });
+});
+
+describe('evidence and verified rules', () => {
+  test('a passing check before a failing one still covers earlier writes', () => {
+    const entries = [w(0, 'a.ts'), c(1, 0), c(2, 1)];
+    expect(evidence(entries).unverified).toEqual([]);
+    expect(verified(entries, ['bun test'])).toBe(true);
+  });
+
+  test('unverified is empty exactly when verified holds, on random ledgers', () => {
+    for (let i = 0; i < 200; i++) {
+      const entries = randomLedger();
+      expect(verified(entries, ['bun test'])).toBe(evidence(entries).unverified.length === 0);
+    }
+  });
+
+  test('verified ignores entries when no checks are declared', () => {
+    for (let i = 0; i < 200; i++) expect(verified(randomLedger(), [])).toBe(true);
+  });
+});
