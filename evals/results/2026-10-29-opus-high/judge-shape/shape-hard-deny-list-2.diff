diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 15:34:08.086962487 +0000
@@ -0,0 +1,85 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('git global options that take a value', () => {
+  expect(hit('git --namespace x push -f')).toBe('force-push');
+  expect(hit('git -C -f status')).toBeUndefined(); // -f is the value of -C
+});
+
+test('git push flags with values and plain -u', () => {
+  expect(hit('git push --delete=x')).toBe('force-push');
+  expect(hit('git push -u')).toBeUndefined();
+});
+
+test('git clean with --dry-run and mixed flags', () => {
+  expect(hit('git clean --force --dry-run')).toBeUndefined();
+  expect(hit('git clean -xf')).toBe('clean-force');
+});
+
+test('git reset with and without a ref', () => {
+  expect(hit('git reset --hard')).toBe('reset-hard');
+  expect(hit('git reset HEAD')).toBeUndefined();
+});
+
+test('rm with -- and home or cwd targets', () => {
+  expect(hit('rm -rf --')).toBe('rm-outside');
+  expect(hit('rm -r -- .')).toBe('rm-outside');
+  expect(hit('rm -Rf ~/x')).toBe('rm-outside');
+});
+
+test('rm globs: parent or root globs are outside, inner globs are fine', () => {
+  expect(hit('rm -rf ../*')).toBe('rm-outside');
+  expect(hit('rm -rf /*')).toBe('rm-outside');
+  expect(hit('rm -rf src/*')).toBeUndefined();
+});
+
+test('unresolvable targets and find start paths', () => {
+  expect(denyListed(['rm', '-rf', 'a$b'], cwd)?.name).toBe('rm-outside');
+  expect(hit('find ~bob -delete')).toBe('rm-outside');
+  expect(hit('find /work/repo -exec x ;')).toBeUndefined();
+});
+
+test('names that start with .. are inside the workspace', () => {
+  expect(denyListed(['rm', '-rf', '..foo'], cwd)).toBeUndefined();
+  expect(denyListed(['find', '..foo', '-delete'], cwd)).toBeUndefined();
+  expect(denyListed(['rm', '-rf', '..'], cwd)?.name).toBe('rm-outside');
+});
+
+test('reasons say whether the target is cwd itself or outside it', () => {
+  expect(denyListed(['rm', '-rf', '.'], cwd)?.reason).toBe('rm -r target is the working directory itself: .');
+  expect(denyListed(['rm', '-rf', '/etc'], cwd)?.reason).toBe('rm -r target outside workspace: /etc');
+  expect(denyListed(['find', '/etc', '-delete'], cwd)?.reason).toBe('find start path outside workspace: /etc');
+});
+
+test('argv[0] given as a path works for find too', () => {
+  expect(denyListed(['/usr/bin/find', '/', '-delete'], cwd)?.name).toBe('rm-outside');
+});
+
+test('path agreement with the helpers', () => {
+  // [path, rm -rf -- path denied, find path -delete denied]
+  const cases: [string, boolean, boolean][] = [
+    ['.', true, false],
+    ['..', true, true],
+    ['/', true, true],
+    ['~', true, true],
+    ['~/x', true, true],
+    ['a', false, false],
+    ['a/../..', true, true],
+    ['/work/repo/a', false, false],
+    ['/work', true, true],
+    ['/work/repo', true, false],
+    ['*', false, false],
+    ['../*', true, true],
+    ['$X', true, true],
+    ['~u', true, true],
+    ['-x', false, false],
+    ['a b', false, false],
+  ];
+  for (const [p, rmDenied, findDenied] of cases) {
+    expect([p, denyListed(['rm', '-rf', '--', p], cwd)?.name === 'rm-outside']).toEqual([p, rmDenied]);
+    expect([p, denyListed(['find', p, '-delete'], cwd)?.name === 'rm-outside']).toEqual([p, findDenied]);
+  }
+});
