 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+const base = (w: string) => w.slice(w.lastIndexOf('/') + 1); // '/usr/bin/git' -> 'git'
+const shortGroup = (w: string, letters: RegExp) => /^-[^-]/.test(w) && letters.test(w.slice(1)); // -fu, -rf, -R
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/')); // $VAR, ~user
+const outside = (p: string, cwd: string) => unresolvable(p) || !insideWorkspace(p, cwd);
+
+// git: args are the words after `git`.
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += ['-C', '-c', '--git-dir', '--work-tree', '--namespace'].includes(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const w = rest.find((w) => /^--(force|force-with-lease|mirror|delete|prune)(=|$)/.test(w) || shortGroup(w, /[fd]/) || /^[+:]/.test(w));
+    return w === undefined ? undefined : { name: 'force-push', reason: `git push ${w} rewrites remote history` };
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean' && (rest.includes('--force') || rest.some((w) => shortGroup(w, /f/))) && !rest.includes('-n') && !rest.includes('--dry-run'))
+    return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  return undefined;
+}
+
+// rm: args are the words after `rm`.
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const before = dd < 0 ? args : args.slice(0, dd);
+  const after = dd < 0 ? [] : args.slice(dd + 1);
+  if (!before.some((w) => w === '--recursive' || shortGroup(w, /[rR]/))) return undefined;
+  const targets = [...before.filter((w) => !w.startsWith('-')), ...after];
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets (they come from xargs)' };
+  const outsideTarget = targets.find((t) => outside(t, cwd));
+  if (outsideTarget !== undefined) return { name: 'rm-outside', reason: `rm -r target outside workspace: ${outsideTarget}` };
+  const self = targets.find((t) => sameDir(t, cwd));
+  return self === undefined ? undefined : { name: 'rm-outside', reason: `rm -r target is the working directory itself: ${self}` };
+}
+
+// find: args are the words after `find`.
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const firstOpt = args.findIndex((w) => w.startsWith('-'));
+  const starts = firstOpt < 0 ? args : args.slice(0, firstOpt);
+  const bad = (starts.length ? starts : ['.']).find((p) => outside(p, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `find start path outside workspace: ${bad}` };
+}
+
