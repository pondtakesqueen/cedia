--- a/ledger.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.rules.test.ts	2026-10-29 15:43:09.106994647 +0000
@@ -0,0 +1,103 @@
+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+const intent = (callId: string, tool: string, input: Record<string, unknown>): SessionEvent => ({ kind: 'tool_intent', callId, tool, input });
+const result = (callId: string, status: 'completed' | 'failed' | 'denied' | 'not_started' = 'completed', output: { isError: boolean; exitCode?: number } = { isError: false, exitCode: 0 }): SessionEvent => ({ kind: 'tool_result', callId, status, output });
+
+describe('matchCheck edge cases', () => {
+  test('tabs and repeated whitespace collapse, and a trailing 2>&1 is dropped', () => {
+    expect(matchCheck('bun\ttest  2>&1', ['bun test'])).toBe('bun test');
+  });
+
+  test('a pipe, a semicolon or a chain does not count', () => {
+    expect(matchCheck('bun test; true', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test && x', ['bun test'])).toBeUndefined();
+  });
+
+  test('a cd is dropped only when it resolves to cwd, and only one', () => {
+    expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd .. && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd . && cd . && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+});
+
+describe('ledgerEntries edge cases', () => {
+  test('a result counts only if its intent came after the last request', () => {
+    expect(ledgerEntries([intent('x', 'edit', { path: 'a.ts' }), { kind: 'request' }, result('x')], [])).toEqual([]);
+    expect(ledgerEntries([{ kind: 'request' }, intent('x', 'edit', { path: 'a.ts' }), result('x')], [])).toEqual([
+      { kind: 'write', at: 2, tool: 'edit', path: 'a.ts' },
+    ]);
+  });
+
+  test('a denied check is not a check', () => {
+    const events = [intent('k', 'bash', { command: 'bun test' }), result('k', 'denied', { isError: true, exitCode: 1 })];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([]);
+  });
+
+  test('a failed check keeps its exit code', () => {
+    const events = [intent('k', 'bash', { command: 'bun test' }), result('k', 'failed', { isError: true, exitCode: 2 })];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 2 }]);
+  });
+
+  test('a snapshot before the intent still names the writes; an empty list writes nothing', () => {
+    const events: SessionEvent[] = [{ kind: 'snapshot', callId: 'e', changed: ['a.ts'] }, intent('e', 'edit', { path: 'a.ts' }), result('e')];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'edit', path: 'a.ts' }]);
+    expect(ledgerEntries([intent('e', 'edit', { path: 'a.ts' }), { kind: 'snapshot', callId: 'e', changed: [] }, result('e')], [])).toEqual([]);
+  });
+
+  test('a snapshot wins over the edit rule for a failed edit', () => {
+    const events: SessionEvent[] = [intent('e', 'edit', { path: 'a.ts' }), result('e', 'failed', { isError: true }), { kind: 'snapshot', callId: 'e', changed: ['b.ts'] }];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'b.ts' }]);
+  });
+
+  test('a failed write gives nothing; a failed non-read-only bash call is a write; read-only bash is not', () => {
+    expect(ledgerEntries([intent('w', 'write', { path: 'a.ts' }), result('w', 'failed', { isError: true })], [])).toEqual([]);
+    expect(ledgerEntries([intent('m', 'bash', { command: 'make' }), result('m', 'failed', { isError: true, exitCode: 2 })], [])).toEqual([
+      { kind: 'write', at: 1, tool: 'bash', command: 'make' },
+    ]);
+    expect(ledgerEntries([intent('g', 'bash', { command: 'git status' }), result('g')], [])).toEqual([]);
+  });
+});
+
+describe('evidence and verified edge cases', () => {
+  const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+  const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+  test('changed is deduplicated and first seen first; unverified follows the last passing check', () => {
+    expect(evidence([w(0, 'a'), w(1, 'b'), w(2, 'a')])).toEqual({
+      changed: ['a', 'b'],
+      checks: [],
+      unverified: ['a', 'b'],
+    });
+    expect(evidence([w(0, 'a'), c(1, 0), w(2, 'b'), c(3, 1)]).unverified).toEqual(['b']);
+  });
+
+  test('verified needs a passing check after the last write', () => {
+    expect(verified([w(0, 'a'), c(1, 0), w(2, 'a')], ['bun test'])).toBe(false);
+  });
+
+  test('the done gate agrees with an independent oracle over generated logs', () => {
+    let seed = 42;
+    const next = () => {
+      seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
+      return seed >> 8;
+    };
+    let satisfied = 0;
+    let unsatisfied = 0;
+    for (let round = 0; round < 500; round++) {
+      const len = next() % 9;
+      const entries: LedgerEntry[] = [];
+      for (let i = 0; i < len; i++) entries.push(next() % 2 ? w(i, next() % 2 ? 'a' : 'b') : c(i, next() % 2));
+      // Oracle: satisfied when no write comes after the last passing check.
+      const lastPass = entries.findLastIndex((e) => e.kind === 'check' && e.exitCode === 0);
+      const expected = !entries.some((e, i) => e.kind === 'write' && i > lastPass);
+      expect(verified(entries, ['x'])).toBe(expected);
+      expect(verified(entries, [])).toBe(true);
+      if (expected) satisfied++;
+      else unsatisfied++;
+    }
+    expect(satisfied).toBeGreaterThan(0);
+    expect(unsatisfied).toBeGreaterThan(0);
+  });
+});
