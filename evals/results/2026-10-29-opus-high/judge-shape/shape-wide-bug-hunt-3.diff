diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 16:01:29.659060067 +0000
@@ -0,0 +1,118 @@
+import { expect, test } from 'bun:test';
+import { cart, type Cart } from '../src/cart/cart.ts';
+import { PRODUCTS } from '../src/catalog/products.ts';
+import { totals } from '../src/order/total.ts';
+
+// An independent reading of README.md, used to check totals() on many carts.
+function halfUp(x: number) {
+  return Math.floor(x + 0.5);
+}
+
+function reference(c: Cart) {
+  const qty = new Map<string, number>();
+  for (const l of c.lines) qty.set(l.sku, (qty.get(l.sku) ?? 0) + l.quantity);
+  const rates = { US: [0.07, 800, 5000], EU: [0.2, 900, 6000], UK: [0.2, 700, 4000] } as const;
+  const [taxRate, shippingRate, freeFrom] = rates[c.region as keyof typeof rates];
+  let subtotal = 0;
+  for (const [sku, q] of qty) {
+    const gross = PRODUCTS[sku].price * q;
+    const rate = q >= 50 ? 0.1 : q >= 10 ? 0.05 : 0;
+    subtotal += gross - halfUp(gross * rate);
+  }
+  const code = c.coupon?.toUpperCase();
+  const coupon = code === 'SAVE10' ? halfUp(subtotal * 0.1) : code === 'FLAT5' ? Math.min(500, subtotal) : 0;
+  const discounted = subtotal - coupon;
+  const shipping = discounted >= freeFrom ? 0 : shippingRate;
+  const tax = halfUp((discounted + shipping) * taxRate);
+  return { subtotal, coupon, shipping, tax, total: discounted + shipping + tax };
+}
+
+test('rule 1: subtotal is unit price times quantity', () => {
+  expect(totals(cart('US', [['MUG', 2]]))).toMatchObject({ subtotal: 900 });
+});
+
+test('rule 2: 10 units get 5% off, 9 units get nothing', () => {
+  expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  expect(totals(cart('US', [['PEN', 9]]))).toMatchObject({ subtotal: 1080 });
+});
+
+test('rule 2: 50 units get 10% off, only the highest tier applies', () => {
+  expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+});
+
+test('rule 2: lines of the same SKU are merged before pricing', () => {
+  const merged = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+  expect(merged).toMatchObject(totals(cart('US', [['PEN', 10]])));
+  expect(merged.lines.length).toBe(1);
+  expect(merged.lines[0].quantity).toBe(10);
+});
+
+test('rule 2: totals() does not change the cart it is given', () => {
+  const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+  totals(c);
+  expect(c.lines.length).toBe(2);
+  expect(c.lines[0].quantity).toBe(6);
+});
+
+test('rule 3: SAVE10 comes off the amount after bulk discounts', () => {
+  expect(totals(cart('US', [['PEN', 10]], 'SAVE10'))).toMatchObject({ subtotal: 1140, coupon: 114 });
+});
+
+test('rule 3: FLAT5 never takes the amount below zero', () => {
+  expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ coupon: 120, shipping: 800, tax: 56, total: 856 });
+});
+
+test('rule 4: shipping is decided on the amount after the coupon', () => {
+  expect(totals(cart('US', [['BAG', 2], ['MUG', 2]], 'SAVE10'))).toMatchObject({
+    subtotal: 5300,
+    coupon: 530,
+    shipping: 800,
+    tax: 390,
+    total: 5960,
+  });
+});
+
+test('region: UK ships free from 4000, including exactly 4000', () => {
+  expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+});
+
+test('region: EU rate and shipping', () => {
+  expect(totals(cart('EU', [['MUG', 2]]))).toMatchObject({ shipping: 900, tax: 360, total: 2160 });
+});
+
+test('rule 5: tax rounds half up to the cent', () => {
+  expect(totals(cart('US', [['MUG', 1]]))).toMatchObject({ tax: 88, total: 1338 });
+});
+
+test('rule 6: total is discounted subtotal + shipping + tax', () => {
+  const t = totals(cart('US', [['PEN', 10]], 'SAVE10'));
+  expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+});
+
+test('unknown region throws', () => {
+  expect(() => totals(cart('XX', [['MUG', 1]]))).toThrow(/unknown region XX/);
+});
+
+test('totals agree with the reference reading of the README on many carts', () => {
+  const regions = ['US', 'EU', 'UK'];
+  const coupons = [undefined, 'SAVE10', 'FLAT5', 'save10'];
+  const skus = Object.keys(PRODUCTS);
+  const qtys = [1, 9, 10, 11, 49, 50];
+  const splits: [number, number][] = [[4, 6], [25, 25], [1, 49]];
+  let checked = 0;
+  for (const region of regions)
+    for (const coupon of coupons)
+      for (const sku of skus) {
+        const carts: [string, number][][] = [];
+        for (const q of qtys) carts.push([[sku, q]]);
+        for (const [a, b] of splits) carts.push([[sku, a], [sku, b]]);
+        for (const items of carts) {
+          const c = cart(region, items, coupon);
+          const got = totals(c);
+          const want = reference(c);
+          expect({ subtotal: got.subtotal, coupon: got.coupon, shipping: got.shipping, tax: got.tax, total: got.total }).toEqual(want);
+          checked++;
+        }
+      }
+  expect(checked).toBeGreaterThan(200);
+});
