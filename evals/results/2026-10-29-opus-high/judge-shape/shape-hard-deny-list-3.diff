diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 15:33:44.930961110 +0000
@@ -0,0 +1,96 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+// Every non-empty subset of `letters`, in order.
+const subsets = (letters: string) => {
+  const out: string[] = [];
+  for (let m = 1; m < 1 << letters.length; m++) out.push([...letters].filter((_, i) => m & (1 << i)).join(''));
+  return out;
+};
+
+test('git is found by its path and value options consume the next word', () => {
+  expect(hit('/x/git reset --hard')).toBe('reset-hard');
+  expect(hit('git --work-tree push status')).toBeUndefined();
+  expect(hit('git --namespace push log')).toBeUndefined();
+  expect(hit('git --git-dir=.git push -f')).toBe('force-push');
+});
+
+test('every push long flag, plain and with a value', () => {
+  for (const f of ['--force', '--force-with-lease', '--mirror', '--delete', '--prune']) {
+    for (const line of [`git push ${f}`, `git push ${f}=v`]) expect([line, hit(line)]).toEqual([line, 'force-push']);
+  }
+});
+
+test('push short flag groups', () => {
+  expect(hit('git push -uf')).toBe('force-push');
+  expect(hit('git push -d')).toBe('force-push');
+  expect(hit('git push -u')).toBeUndefined();
+  expect(hit('git push -q')).toBeUndefined();
+});
+
+test('push refspecs', () => {
+  expect(hit('git push origin +a:b')).toBe('force-push');
+  expect(hit('git push origin :x')).toBe('force-push');
+  expect(hit('git push origin main:main')).toBeUndefined();
+});
+
+test('reset is only dangerous with --hard', () => {
+  expect(hit('git reset --mixed')).toBeUndefined();
+});
+
+test('clean: -n or --dry-run as its own word turns force off', () => {
+  expect(hit('git clean --force -n')).toBeUndefined();
+  expect(hit('git clean -xf')).toBe('clean-force');
+  expect(hit('git clean --dry-run --force')).toBeUndefined();
+});
+
+test('rm without recursion passes; -- ends the flags', () => {
+  expect(hit('rm -f /etc')).toBeUndefined();
+  expect(hit('rm --recursive -- /')).toBe('rm-outside');
+});
+
+test('rm targets that cannot be resolved before running are denied', () => {
+  expect(hit('rm -r a$b')).toBe('rm-outside');
+  expect(hit('rm -r ~root')).toBe('rm-outside');
+  expect(hit('rm -r ~/')).toBe('rm-outside');
+});
+
+test('cwd itself is denied however it is spelled', () => {
+  expect(hit('rm -r ./')).toBe('rm-outside');
+  expect(hit('rm -r /work/repo/')).toBe('rm-outside');
+  expect(hit('rm -r /work/repo/x/..')).toBe('rm-outside');
+});
+
+test('a name starting with two dots inside cwd is inside', () => {
+  expect(hit('rm -r ..cache')).toBeUndefined();
+});
+
+test('find: start paths decide, and cwd itself is allowed', () => {
+  expect(hit('find / -execdir touch {} ;')).toBe('rm-outside');
+  expect(hit('find . ../x -exec ls ;')).toBe('rm-outside');
+  expect(hit('find /work/repo -delete')).toBeUndefined();
+});
+
+test('only argv[0] names the command', () => {
+  expect(hit('echo rm -rf /')).toBeUndefined();
+});
+
+test('a combined flag group means the same as the flags split into words', () => {
+  for (const s of subsets('fduqv')) {
+    const split = [...s].map(c => '-' + c).join(' ');
+    expect([s, hit('git push -' + s)]).toEqual([s, hit('git push ' + split)]);
+  }
+  for (const s of subsets('fdxn').filter(s => !s.includes('n'))) {
+    const split = [...s].map(c => '-' + c).join(' ');
+    expect([s, hit('git clean -' + s)]).toEqual([s, hit('git clean ' + split)]);
+  }
+  for (const target of ['/etc', 'build'])
+    for (const s of subsets('rRfiv')) {
+      const split = [...s].map(c => '-' + c).join(' ');
+      const line = `rm -${s} ${target}`;
+      expect([line, hit(line)]).toEqual([line, hit(`rm ${split} ${target}`)]);
+    }
+});
