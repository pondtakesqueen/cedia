 // True when `path` (relative to cwd, or absolute, or ~/...) is cwd itself or inside it.
 export function insideWorkspace(path: string, cwd: string): boolean {
   const rel = relative(resolve(cwd), resolve(cwd, expandHome(path)));
-  return rel === '' || (!rel.startsWith('..') && !isAbsolute(rel));
+  return rel === '' || (rel !== '..' && !rel.startsWith('../') && !isAbsolute(rel));
 }
 
 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+const base = (w: string) => w.slice(w.lastIndexOf('/') + 1);
+// A short flag group such as -fu: one dash, then letters. True when it contains one of `letters`.
+const shortHas = (w: string, letters: string) => /^-[^-]/.test(w) && [...w.slice(1)].some(c => letters.includes(c));
+// Cannot be resolved before the command runs: contains $, or ~user.
+const unresolvable = (w: string) => w.includes('$') || (w.startsWith('~') && w !== '~' && !w.startsWith('~/'));
+const GIT_VALUE_OPTS = ['-C', '-c', '--git-dir', '--work-tree', '--namespace'];
+const PUSH_LONG = /^--(force|force-with-lease|mirror|delete|prune)(=|$)/;
+
+// git: args are the words after the command name.
+function git(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += GIT_VALUE_OPTS.includes(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const bad = rest.find(w => PUSH_LONG.test(w) || shortHas(w, 'fd') || (!w.startsWith('-') && /^[+:]/.test(w)));
+    return bad === undefined ? undefined : { name: 'force-push', reason: `\`git push ${bad}\` rewrites remote history` };
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: '`git reset --hard` discards uncommitted work' };
+  if (sub === 'clean') {
+    const force = rest.includes('--force') || rest.some(w => shortHas(w, 'f'));
+    const dry = rest.includes('-n') || rest.includes('--dry-run');
+    if (force && !dry) return { name: 'clean-force', reason: '`git clean -f` deletes untracked files' };
+  }
+  return undefined;
+}
+
+// rm: args are the words after the command name. Only recursive removal is checked.
+function rm(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const before = dd < 0 ? args : args.slice(0, dd);
+  if (!before.some(w => w === '--recursive' || shortHas(w, 'rR'))) return undefined;
+  const targets = [...before.filter(w => !w.startsWith('-')), ...(dd < 0 ? [] : args.slice(dd + 1))];
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'recursive rm with no targets (they come from xargs?)' };
+  const bad = targets.find(t => unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `recursive rm of \`${bad}\` is outside the working directory` };
+}
+
+// find: args are the words after the command name. Only -delete, -exec and -execdir are checked.
+function find(args: string[], cwd: string): Hit | undefined {
+  if (!args.some(w => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const end = args.findIndex(w => w.startsWith('-'));
+  const roots = end > 0 ? args.slice(0, end) : ['.'];
+  const bad = roots.find(r => unresolvable(r) || !insideWorkspace(r, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `find from \`${bad}\` can delete outside the working directory` };
+}
+
 // Looks at one simple command's argv (already split, quotes removed) and returns a Hit when it must be denied.
 //
 // git (argv[0] may be a path such as /usr/bin/git). Global options before the subcommand are skipped; -C, -c,
@@ -36,5 +83,15 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  const [cmd = '', ...args] = argv;
+  switch (base(cmd)) {
+    case 'git':
+      return git(args);
+    case 'rm':
+      return rm(args, cwd);
+    case 'find':
+      return find(args, cwd);
+    default:
+      return undefined;
+  }
 }
