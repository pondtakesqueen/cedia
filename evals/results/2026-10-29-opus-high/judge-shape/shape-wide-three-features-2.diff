 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNIT_MS = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1_000, ms: 1 } as const;
+const PART = /(\d+(?:\.\d+)?)(ms|d|h|m|s) */y;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  if (s === '') throw new Error(`invalid duration: "${text}"`);
+  let total = 0;
+  let i = 0;
+  while (i < s.length) {
+    PART.lastIndex = i;
+    const m = PART.exec(s);
+    if (!m) throw new Error(`invalid duration: "${text}"`);
+    total += Number(m[1]) * UNIT_MS[m[2] as keyof typeof UNIT_MS];
+    i = PART.lastIndex;
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (ms < 0 || !Number.isFinite(ms)) throw new Error(`invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  let out = '';
+  for (const [unit, size] of Object.entries(UNIT_MS)) {
+    const n = Math.floor(rest / size);
+    if (n > 0) {
+      out += `${n}${unit}`;
+      rest -= n * size;
+    }
+  }
+  return out || '0s';
 }
