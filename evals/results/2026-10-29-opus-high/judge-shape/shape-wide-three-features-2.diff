 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+// Holds each key's value and expiry time. The Map's order runs from least to most recently used.
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  private entries = new Map<K, { value: V; expiresAt: number }>();
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+  constructor(
+    private readonly capacity: number,
+    private readonly ttlMs: number,
+    private readonly now: () => number = Date.now,
+  ) {}
+
+  private live(e: { expiresAt: number }): boolean {
+    return this.now() < e.expiresAt;
+  }
+
+  // Removes the entry first, then reports it, so the cache stays consistent if onEvict throws.
+  private remove(key: K, e: { value: V }, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, e.value, reason);
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return undefined;
+    if (!this.live(e)) {
+      this.remove(key, e, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const old = this.entries.get(key);
+    if (old) {
+      if (this.live(old)) this.entries.delete(key);
+      else this.remove(key, old, 'expired');
+    }
+    this.entries.set(key, { value, expiresAt: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, e] of [...this.entries]) {
+      if (!this.live(e)) this.remove(k, e, 'expired');
+    }
+    while (this.entries.size > this.capacity) {
+      const [k, e] = this.entries.entries().next().value!;
+      this.remove(k, e, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return false;
+    if (this.live(e)) {
+      this.remove(key, e, 'delete');
+      return true;
+    }
+    this.remove(key, e, 'expired');
+    return false;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const e of this.entries.values()) if (this.live(e)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.entries].filter(([, e]) => this.live(e)).map(([k]) => k).reverse();
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 16:02:15.818612915 +0000
+++ b/src/slug.ts	2026-10-29 16:03:32.055067342 +0000
@@ -11,10 +11,26 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (max <= 0) return '';
+  if (s[max] === '-') return s.slice(0, max);
+  const cut = s.lastIndexOf('-', max - 1);
+  return cut > 0 ? s.slice(0, cut) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 16:05:16.055073524 +0000
@@ -0,0 +1,56 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('every unit parses, ms is not m then s', () => {
+  expect(parseDuration('2d')).toBe(172_800_000);
+  expect(parseDuration('3h')).toBe(10_800_000);
+  expect(parseDuration('4m')).toBe(240_000);
+  expect(parseDuration('5s')).toBe(5_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1m1s')).toBe(61_000);
+  expect(parseDuration('1ms')).toBe(1);
+});
+
+test('several parts, spaces, fractions and rounding', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('1h  30m')).toBe(5_400_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('1.5ms')).toBe(2);
+  expect(parseDuration('0.0004s')).toBe(0);
+});
+
+test('malformed input throws with the input in the message', () => {
+  for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '1h30', '1.s', 's5']) {
+    expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+  }
+});
+
+test('formatDuration examples and negative input', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(-0.4)).toThrow();
+  expect(() => formatDuration(Number.NaN)).toThrow();
+});
+
+test('format and parse round trip', () => {
+  const values: number[] = [];
+  for (let i = 0; i <= 5000; i++) values.push(i);
+  for (let i = 0; i < 2000; i++) values.push((i * 7919 * 1013) % 1_000_000_000);
+  for (const n of values) {
+    const text = formatDuration(n);
+    expect(text).toMatch(/^(\d+(d|h|m|s|ms))+$/);
+    if (n !== 0) expect(text).not.toMatch(/(^|[a-z])0[a-z]/);
+    expect(parseDuration(text)).toBe(n);
+  }
+});
+
+test('error message holds the raw input, even with quotes or escapes', () => {
+  for (const bad of ['a"b', '5\\x', '1h\t30m']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 16:05:16.055073524 +0000
@@ -0,0 +1,203 @@
+import { expect, test } from 'bun:test';
+import { EvictReason, LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const log: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return { cache, log, tick: (to: number) => (t = to) };
+}
+
+test('a hit makes the entry most recent', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('a miss changes nothing', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  expect(cache.get('zz')).toBeUndefined();
+  expect(cache.keys()).toEqual(['a']);
+  expect(log).toEqual([]);
+});
+
+test('expiry boundary and single expired log', () => {
+  const { cache, log, tick } = setup(2, 1000);
+  cache.set('a', 1);
+  tick(999);
+  expect(cache.get('a')).toBe(1);
+  tick(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.get('a')).toBeUndefined();
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.size).toBe(0);
+});
+
+test('set gives a fresh ttl and overwrite is not an eviction', () => {
+  const { cache, log, tick } = setup(2, 1000);
+  cache.set('a', 1);
+  tick(500);
+  cache.set('a', 2);
+  tick(1400);
+  expect(cache.get('a')).toBe(2);
+  expect(cache.size).toBe(1);
+  expect(log).toEqual([]);
+});
+
+test('expired entries count toward capacity and go first', () => {
+  const { cache, log, tick } = setup(2, 100);
+  cache.set('a', 1);
+  tick(50);
+  cache.set('b', 2);
+  tick(120);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('all expired entries go before any live one is evicted', () => {
+  const { cache, log, tick } = setup(3, 100);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  tick(200);
+  cache.set('d', 4);
+  cache.set('e', 5);
+  expect(log).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+    ['c', 3, 'expired'],
+  ]);
+  expect(cache.keys()).toEqual(['e', 'd']);
+});
+
+test('over capacity with nothing expired evicts the least recent', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'capacity']]);
+});
+
+test('delete reports live, expired and missing entries', () => {
+  const { cache, log, tick } = setup(3, 100);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  tick(100);
+  expect(cache.delete('b')).toBe(false);
+  expect(cache.delete('zz')).toBe(false);
+  expect(log).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('size and keys skip expired entries without logging', () => {
+  const { cache, log, tick } = setup(3, 100);
+  cache.set('a', 1);
+  tick(60);
+  cache.set('b', 2);
+  tick(120);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+});
+
+test('keys are most recent first', () => {
+  const { cache } = setup(3, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  cache.get('a');
+  expect(cache.keys()).toEqual(['a', 'c', 'b']);
+});
+
+test('matches a simple reference model', () => {
+  for (const seed of [1, 7, 42]) {
+    let rng = seed;
+    const rand = (n: number) => {
+      rng = (rng * 1103515245 + 12345) & 0x7fffffff;
+      return rng % n;
+    };
+    const cap = 3;
+    const ttl = 10;
+    let t = 0;
+    const cache = new LRU<number, number>(cap, ttl, () => t);
+    const log: string[] = [];
+    cache.onEvict = (k, v, r) => log.push(`${k}:${v}:${r}`);
+    // model: array of {key, value, expiresAt}, least recent first
+    let model: { key: number; value: number; expiresAt: number }[] = [];
+    const modelLog: string[] = [];
+    const isLive = (e: { expiresAt: number }) => t < e.expiresAt;
+    const drop = (i: number, reason: EvictReason) => {
+      const e = model[i];
+      model.splice(i, 1);
+      modelLog.push(`${e.key}:${e.value}:${reason}`);
+    };
+    for (let op = 0; op < 300; op++) {
+      t += rand(5);
+      const kind = rand(4);
+      const key = rand(6);
+      if (kind === 0) {
+        const i = model.findIndex((e) => e.key === key);
+        let want: number | undefined;
+        if (i >= 0) {
+          if (isLive(model[i])) {
+            want = model[i].value;
+            const [e] = model.splice(i, 1);
+            model.push(e);
+          } else drop(i, 'expired');
+        }
+        expect(cache.get(key)).toBe(want);
+      } else if (kind === 1) {
+        const value = rand(100);
+        const i = model.findIndex((e) => e.key === key);
+        if (i >= 0) model.splice(i, 1);
+        model.push({ key, value, expiresAt: t + ttl });
+        if (model.length > cap) {
+          for (let j = model.length - 1; j >= 0; j--) if (!isLive(model[j])) drop(j, 'expired');
+          while (model.length > cap) drop(0, 'capacity');
+        }
+        cache.set(key, value);
+      } else if (kind === 2) {
+        const i = model.findIndex((e) => e.key === key);
+        let want = false;
+        if (i >= 0) {
+          want = isLive(model[i]);
+          drop(i, want ? 'delete' : 'expired');
+        }
+        expect(cache.delete(key)).toBe(want);
+      } else {
+        const live = model.filter(isLive);
+        expect(cache.size).toBe(live.length);
+        expect(cache.keys()).toEqual(live.map((e) => e.key).reverse());
+      }
+      expect(log).toEqual(modelLog);
+    }
+  }
+});
+
+test('set over an expired entry reports it as expired', () => {
+  const { cache, log, tick } = setup(2, 10);
+  cache.set('a', 1);
+  tick(20);
+  cache.set('a', 2);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('set over a live entry stays silent', () => {
+  const { cache, log, tick } = setup(2, 10);
+  cache.set('a', 1);
+  tick(5);
+  cache.set('a', 2);
+  expect(log).toEqual([]);
+  expect(cache.get('a')).toBe(2);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 16:03:50.958851139 +0000
@@ -0,0 +1,64 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('lower case, diacritics and special letters', () => {
+  expect(slugify('ABC Def')).toBe('abc-def');
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('ÀÇ')).toBe('ac');
+  expect(slugify('ßæœøłđ')).toBe('ssaeoeold');
+  expect(slugify('ÆŒØŁĐ')).toBe('aeoeold');
+});
+
+test('separators and trimming', () => {
+  expect(slugify('a_b.c/d')).toBe('a-b-c-d');
+  expect(slugify('日本')).toBe('');
+  expect(slugify('  --a!!  b--  ')).toBe('a-b');
+  expect(slugify('!!!')).toBe('');
+});
+
+test('cutting at max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab-cd', 10)).toBe('ab-cd');
+  expect(slugify('ab-cd', 5)).toBe('ab-cd');
+  expect(slugify('Hello, World!', 7)).toBe('hello');
+  expect(slugify('abc', 0)).toBe('');
+  expect(slugify('abc', -2)).toBe('');
+});
+
+function cutReference(s: string, max: number): string {
+  if (s.length <= max) return s;
+  for (let p = Math.min(max, s.length); p > 0; p--) {
+    const pre = s.slice(0, p);
+    if (pre.endsWith('-')) continue;
+    if (p === s.length || s[p] === '-') return pre;
+  }
+  return s.slice(0, max);
+}
+
+test('cutting matches a brute-force reference', () => {
+  let seed = 12345;
+  const parts = ['a', 'bc', '-', 'x9'];
+  for (let i = 0; i < 500; i++) {
+    let s = '';
+    const len = 1 + ((i * 7) % 9);
+    for (let j = 0; j < len; j++) {
+      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+      s += parts[seed % parts.length];
+    }
+    const full = slugify(s);
+    for (let max = 1; max <= 12; max++) {
+      expect(slugify(s, max)).toBe(cutReference(full, max));
+    }
+  }
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  const taken = new Set(['post', 'post-2', 'post-3']);
+  expect(uniqueSlug('post', taken)).toBe('post-4');
+  expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+  expect([...taken]).toEqual(['post', 'post-2', 'post-3']);
+});
