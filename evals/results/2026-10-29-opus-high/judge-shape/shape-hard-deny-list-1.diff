diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 15:31:20.190952507 +0000
@@ -0,0 +1,82 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const name = (...argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('git is found by path and global options with values are skipped', () => {
+  expect(name('/opt/x/git', 'reset', '--hard')).toBe('reset-hard');
+  expect(name('git', '--work-tree', 'w', 'push', '-f')).toBe('force-push');
+  expect(name('git', '--namespace', 'n', 'push', '-f')).toBe('force-push');
+  expect(name('git', '-c', 'push.x=1', 'status')).toBeUndefined();
+});
+
+test('push flags with values, short groups and refspecs', () => {
+  expect(name('git', 'push', '--prune=x')).toBe('force-push');
+  expect(name('git', 'push', '--delete=x')).toBe('force-push');
+  expect(name('git', 'push', '-ud', 'o', 'b')).toBe('force-push');
+  expect(name('git', 'push', 'origin', 'main:main')).toBeUndefined();
+  expect(name('git', 'push', 'origin', '+a:b')).toBe('force-push');
+});
+
+test('reset and clean edge cases', () => {
+  expect(name('git', 'reset', '--hard')).toBe('reset-hard');
+  expect(name('git', 'reset')).toBeUndefined();
+  expect(name('git', 'clean', '-xf')).toBe('clean-force');
+  expect(name('git', 'clean', '--force', '--dry-run')).toBeUndefined();
+  expect(name('git', 'clean', '-fn', '-n')).toBeUndefined();
+});
+
+test('git without a subcommand passes', () => {
+  expect(name('git')).toBeUndefined();
+  expect(name('git', '-C', 'x')).toBeUndefined();
+});
+
+test('rm -r with no target, or targeting cwd itself', () => {
+  expect(name('rm', '-r')).toBe('rm-outside');
+  expect(name('rm', '-r', '--')).toBe('rm-outside');
+  expect(name('rm', '-r', '/work/repo/')).toBe('rm-outside');
+  expect(name('rm', '-r', './')).toBe('rm-outside');
+  expect(name('rm', '-r', 'src/..')).toBe('rm-outside');
+});
+
+test('rm targets that cannot be resolved or are home paths', () => {
+  expect(name('rm', '-rf', '~/x')).toBe('rm-outside');
+  expect(name('rm', '-rf', 'a${X}')).toBe('rm-outside');
+  expect(name('rm', '-rf', '~bob/x')).toBe('rm-outside');
+  expect(name('rm', '-rf', '')).toBe('rm-outside');
+});
+
+test('rm flags after -- are not flags, flags before -- count anywhere', () => {
+  expect(name('rm', '--', '-rf', '/')).toBeUndefined();
+  expect(name('rm', 'build', '-r', '/etc')).toBe('rm-outside');
+  expect(name('rm', '-rf', 'src/*')).toBeUndefined();
+});
+
+test('find with no delete or exec action, or unresolvable start paths', () => {
+  expect(name('find', '/etc', '-print')).toBeUndefined();
+  expect(name('find', '~bob', '-exec', 'x', ';')).toBe('rm-outside');
+  expect(name('find', '/work/repo', '-delete')).toBeUndefined();
+});
+
+test('never throws on any prefix of the argv used in tests', () => {
+  const argvs = [
+    ['git', 'push', '--force', 'origin', 'main'],
+    ['git', '-C', 'sub', 'push', '-f'],
+    ['git', '-c', 'x=y'],
+    ['rm', '-rf', '--', '/etc'],
+    ['rm', '-rf', '$DIR', '~bob/x'],
+    ['find', '/', '-name', 'x', '-delete'],
+    [],
+  ];
+  for (const argv of argvs)
+    for (let k = 0; k <= argv.length; k++) expect(() => denyListed(argv.slice(0, k), cwd)).not.toThrow();
+});
+
+test('rm -r and find -delete agree with sameDir and insideWorkspace', () => {
+  const paths = ['', '.', './', '..', 'a', 'a/../..', 'src/..', '/', '/work', '/work/repo', '/work/repo/x', '/work/repo/', '/tmp/x', '~', '~/', '~/x', '*', './*'];
+  for (const p of paths) {
+    expect([p, name('rm', '-r', p) === 'rm-outside']).toEqual([p, sameDir(p, cwd) || !insideWorkspace(p, cwd)]);
+    expect([p, name('find', p, '-delete') === 'rm-outside']).toEqual([p, !insideWorkspace(p, cwd)]);
+  }
+});
