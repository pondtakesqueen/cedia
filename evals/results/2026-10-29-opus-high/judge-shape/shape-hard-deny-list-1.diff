@@ -1,5 +1,5 @@
 import { homedir } from 'node:os';
-import { isAbsolute, relative, resolve } from 'node:path';
+import { basename, isAbsolute, relative, resolve } from 'node:path';
 
 export type Hit = { name: 'force-push' | 'reset-hard' | 'clean-force' | 'rm-outside'; reason: string };
 
@@ -36,5 +36,67 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  const cmd = basename(argv[0] ?? '');
+  const args = argv.slice(1);
+  if (cmd === 'git') return gitHit(args);
+  if (cmd === 'rm') return rmHit(args, cwd);
+  if (cmd === 'find') return findHit(args, cwd);
+  return undefined;
+}
+
+// True when the word has short flags (-f, -fu, -df) and one of `letters` among them.
+const shortGroup = (w: string, letters: string) => /^-[^-]/.test(w) && [...letters].some((c) => w.includes(c));
+
+// Paths that cannot be resolved before the command runs: $ expansion, or ~user.
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+
+const GIT_VALUE_OPTS = ['-C', '-c', '--git-dir', '--work-tree', '--namespace'];
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += GIT_VALUE_OPTS.includes(args[i]) ? 2 : 1;
+  if (i >= args.length) return undefined;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const w = rest.find(
+      (w) =>
+        /^--(force|force-with-lease|mirror|delete|prune)(=|$)/.test(w) ||
+        shortGroup(w, 'fd') ||
+        (!w.startsWith('-') && /^[+:]/.test(w)),
+    );
+    if (w) return { name: 'force-push', reason: `git push ${w} rewrites or deletes remote refs` };
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean') {
+    const forced = rest.includes('--force') || rest.some((w) => shortGroup(w, 'f'));
+    const dryRun = rest.includes('-n') || rest.includes('--dry-run');
+    if (forced && !dryRun) return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  }
+  return undefined;
+}
+
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const before = dd < 0 ? args : args.slice(0, dd);
+  const after = dd < 0 ? [] : args.slice(dd + 1);
+  if (!before.some((w) => w === '--recursive' || shortGroup(w, 'rR'))) return undefined;
+  const targets = [...before.filter((w) => !w.startsWith('-')), ...after];
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no target' };
+  for (const t of targets) {
+    if (unresolvable(t) || sameDir(t, cwd) || !insideWorkspace(t, cwd))
+      return { name: 'rm-outside', reason: `rm -r target ${t} is not inside the workspace` };
+  }
+  return undefined;
+}
+
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const firstFlag = args.findIndex((w) => w.startsWith('-'));
+  const starts = firstFlag > 0 ? args.slice(0, firstFlag) : ['.'];
+  for (const p of starts) {
+    if (unresolvable(p) || !insideWorkspace(p, cwd))
+      return { name: 'rm-outside', reason: `find start path ${p} is not inside the workspace` };
+  }
+  return undefined;
 }
