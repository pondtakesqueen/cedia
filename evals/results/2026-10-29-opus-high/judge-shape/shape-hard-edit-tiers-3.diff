diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.tiers.test.ts b/edit.tiers.test.ts
--- a/edit.tiers.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.tiers.test.ts	2026-10-29 15:39:49.078982756 +0000
@@ -0,0 +1,110 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+
+describe('edge cases', () => {
+  test('empty old_text is rejected even when new_text is also empty', () => {
+    const r = applyEdit('x', { old_text: '', new_text: '' });
+    expect('error' in r && r.error).toContain('use write');
+  });
+  test('exact match inside a line and a trailing newline on old_text', () => {
+    const r = ok(applyEdit('a\nx\nb\n', { old_text: 'x\n', new_text: 'X\n' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+    expect(r.content).toBe('a\nX\nb\n');
+    const r2 = ok(applyEdit('abc\nxyz\n', { old_text: 'bc', new_text: 'Q' }));
+    expect(r2.applied).toEqual({ from: 1, to: 1, tier: 'exact', count: 1 });
+  });
+  test('replace_all counts non-overlapping occurrences only', () => {
+    const r = ok(applyEdit('aaa', { old_text: 'aa', new_text: 'b', replace_all: true }));
+    expect(r.content).toBe('ba');
+    expect(r.applied.count).toBe(1);
+  });
+  test('replace_all does not widen the line tiers', () => {
+    const r = ok(applyEdit('a  \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }));
+    expect(r.applied).toEqual({ from: 1, to: 2, tier: 'trailing-space', count: 1 });
+    expect(r.content).toBe('c\n');
+  });
+  test('indentation tier with several windows errors with their lines', () => {
+    const r = applyEdit('  x\n y\n  x\n y\n', { old_text: 'x\ny', new_text: 'z' });
+    expect('error' in r && r.error).toContain('matches 2 places');
+    expect('error' in r && r.error).toContain('1, 3');
+  });
+  test('not found lists at most five lines where the first line appears', () => {
+    const r = applyEdit('ab\n'.repeat(7), { old_text: 'b\nc', new_text: 'x' });
+    expect('error' in r && r.error).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect('error' in r && r.error).not.toContain('6');
+  });
+  test('a new_text line without old_text\'s indent is left as written', () => {
+    const r = ok(applyEdit('if x:\n\tdo()\n\tdone()\n', { old_text: '    do()\n    done()', new_text: '    do()\n  log()\n    done()' }));
+    expect(r.applied).toEqual({ from: 2, to: 3, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('if x:\n\tdo()\n  log()\n\tdone()\n');
+  });
+  test('replacement text is literal', () => {
+    const r = ok(applyEdit('a\nb\n', { old_text: 'a', new_text: '$&$1' }));
+    expect(r.content).toBe('$&$1\nb\n');
+  });
+});
+
+// Small deterministic generator so the agreement checks are repeatable.
+function lcg(seed: number) {
+  let s = seed;
+  return () => {
+    s = (Math.imul(s, 1103515245) + 12345) & 0x7fffffff;
+    return s / 0x80000000;
+  };
+}
+
+const POOL = ['a', 'b', 'c', '  d', 'x y'];
+
+function sample(rnd: () => number) {
+  const count = 3 + Math.floor(rnd() * 6);
+  const lines = Array.from({ length: count }, () => POOL[Math.floor(rnd() * POOL.length)]);
+  return lines.join('\n') + '\n';
+}
+
+describe('agreement with plain string operations', () => {
+  test('a unique substring is replaced exactly where it sits', () => {
+    const rnd = lcg(7);
+    let checked = 0;
+    for (let iter = 0; iter < 300; iter++) {
+      const content = sample(rnd);
+      const s = Math.floor(rnd() * content.length);
+      const e = s + 1 + Math.floor(rnd() * (content.length - s));
+      const old = content.slice(s, e);
+      const next = 'NEW';
+      if (content.indexOf(old) !== content.lastIndexOf(old) || old === next) continue;
+      const r = applyEdit(content, { old_text: old, new_text: next });
+      expect({ iter, content, old, result: 'error' in r ? r.error : r.content }).toEqual({
+        iter,
+        content,
+        old,
+        result: content.slice(0, s) + next + content.slice(e),
+      });
+      checked++;
+    }
+    expect(checked).toBeGreaterThan(50);
+  });
+
+  test('replace_all matches split and join', () => {
+    const rnd = lcg(11);
+    for (let iter = 0; iter < 300; iter++) {
+      const content = sample(rnd);
+      const s = Math.floor(rnd() * content.length);
+      const e = s + 1 + Math.floor(rnd() * (content.length - s));
+      const old = content.slice(s, e);
+      const next = 'Z';
+      if (old === next) continue;
+      const r = ok(applyEdit(content, { old_text: old, new_text: next, replace_all: true }));
+      expect({ iter, content, old, result: r.content }).toEqual({
+        iter,
+        content,
+        old,
+        result: content.split(old).join(next),
+      });
+    }
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-29 15:36:57.766457451 +0000
+++ b/edit.ts	2026-10-29 15:38:22.146977589 +0000
@@ -23,5 +23,95 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: next, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create content' };
+  if (old === next) return { error: 'old_text and new_text are the same' };
+
+  // exact tier: every non-overlapping occurrence
+  const hits: number[] = [];
+  for (let at = content.indexOf(old); at !== -1; at = content.indexOf(old, at + old.length)) hits.push(at);
+  if (hits.length > 1 && !replace_all) {
+    return { error: `old_text matches ${hits.length} places (first at line ${lineOf(content, hits[0])}); add context or set replace_all` };
+  }
+  if (hits.length > 0) {
+    let out = '';
+    let prev = 0;
+    for (const at of hits) {
+      out += content.slice(prev, at) + next;
+      prev = at + old.length;
+    }
+    out += content.slice(prev);
+    const last = hits[hits.length - 1] + old.length - 1;
+    return { content: out, applied: { from: lineOf(content, hits[0]), to: lineOf(content, last), tier: 'exact', count: hits.length } };
+  }
+
+  // line tiers: whole-line windows of content, compared after normalising each line
+  const lines = content.split('\n');
+  const oldLines = toLines(old);
+  const newLines = toLines(next);
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', s => s.trimEnd()],
+    ['indentation', s => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const starts = findWindows(lines, oldLines, norm);
+    if (starts.length > 1) {
+      return { error: `old_text matches ${starts.length} places at lines ${starts.map(s => s + 1).join(', ')}; add context` };
+    }
+    if (starts.length === 1) {
+      const i = starts[0];
+      const n = oldLines.length;
+      const repl = tier === 'indentation' ? reindent(newLines, oldLines, lines.slice(i, i + n)) : newLines;
+      return {
+        content: [...lines.slice(0, i), ...repl, ...lines.slice(i + n)].join('\n'),
+        applied: { from: i + 1, to: i + n, tier, count: 1 },
+      };
+    }
+  }
+
+  // nothing matched: point at the first non-blank line of old_text if it appears in content
+  const first = oldLines.find(l => l.trim() !== '')?.trim();
+  if (first) {
+    const found = lines.flatMap((l, k) => (l.includes(first) ? [k + 1] : [])).slice(0, 5);
+    if (found.length > 0) return { error: `old_text not found; first line appears at line ${found.join(', ')}` };
+  }
+  return { error: 'old_text not found' };
+}
+
+// 1-based line number of the character at idx.
+function lineOf(content: string, idx: number): number {
+  return content.slice(0, idx).split('\n').length;
+}
+
+// Lines of a text, with one trailing newline dropped; '' has no lines.
+function toLines(text: string): string[] {
+  const t = text.endsWith('\n') ? text.slice(0, -1) : text;
+  return t === '' ? [] : t.split('\n');
+}
+
+// Start indices of windows of lines whose normalised lines equal the normalised oldLines.
+function findWindows(lines: string[], oldLines: string[], norm: (s: string) => string): number[] {
+  const n = oldLines.length;
+  if (n === 0) return [];
+  const starts: number[] = [];
+  for (let i = 0; i + n <= lines.length; i++) {
+    if (oldLines.every((l, j) => norm(lines[i + j]) === norm(l))) starts.push(i);
+  }
+  return starts;
+}
+
+// Leading whitespace of the first non-blank line ('' if none).
+function indentOf(lines: string[]): string {
+  const first = lines.find(l => l.trim() !== '');
+  return first?.match(/^\s*/)?.[0] ?? '';
+}
+
+// Swaps the indent of oldLines for the indent of the matched window; blank lines become ''.
+function reindent(newLines: string[], oldLines: string[], window: string[]): string[] {
+  const from = indentOf(oldLines);
+  const to = indentOf(window);
+  return newLines.map(l => {
+    if (l.trim() === '') return '';
+    return l.startsWith(from) ? to + l.slice(from.length) : l;
+  });
 }
