--- a/csv.ts	2026-10-29 15:28:34.980191829 +0000
+++ b/csv.ts	2026-10-29 15:30:24.855436687 +0000
@@ -50,3 +50,141 @@
   rows.push(row);
   return rows;
 }
+
+const SPECIAL = /[,\r\n"]/g;
+
+/**
+ * Parses CSV as `parseCsv` does, from chunks of any size. It keeps only the row and the field being built, the scan
+ * state, and whether the last chunk ended on a `\r` whose meaning waits for the next character. After a SyntaxError
+ * every call throws that same error; after `end` every call throws.
+ */
+export class CsvStream {
+  private row: string[] = [];
+  private field = "";
+  private state: "start" | "plain" | "quoted" | "quote" | "closed" = "start";
+  private cr = false;
+  private offset = 0;
+  private begun = false;
+  private failed?: Error;
+  private ended = false;
+
+  push(chunk: string): string[][] {
+    this.check();
+    return this.run(chunk, false);
+  }
+
+  end(): string[][] {
+    this.check();
+    this.ended = true;
+    return this.run("", true);
+  }
+
+  private check(): void {
+    if (this.failed) throw this.failed;
+    if (this.ended) throw new Error("CsvStream already ended");
+  }
+
+  private run(chunk: string, last: boolean): string[][] {
+    try {
+      return this.scan(chunk, last);
+    } catch (e) {
+      this.failed = e as Error;
+      throw e;
+    }
+  }
+
+  private scan(chunk: string, last: boolean): string[][] {
+    const rows: string[][] = [];
+    const base = this.offset;
+    this.offset += chunk.length;
+    let i = 0;
+    if (!this.begun && chunk.length > 0) {
+      this.begun = true;
+      if (chunk[0] === "\uFEFF") i = 1;
+    }
+    if (this.cr && i < chunk.length) {
+      this.cr = false;
+      if (chunk[i] === "\n") {
+        i++;
+        this.endRow(rows);
+      } else this.loneCr(base - 1);
+    }
+    while (i < chunk.length) {
+      const c = chunk[i]!;
+      if (this.state === "quoted") {
+        const j = chunk.indexOf('"', i);
+        if (j < 0) {
+          this.field += chunk.slice(i);
+          break;
+        }
+        this.field += chunk.slice(i, j);
+        this.state = "quote";
+        i = j + 1;
+      } else if (this.state === "quote" && c === '"') {
+        this.field += '"';
+        this.state = "quoted";
+        i++;
+      } else if (this.state === "quote") {
+        this.state = "closed";
+      } else if (c === ",") {
+        this.endField();
+        i++;
+      } else if (c === "\n") {
+        i++;
+        this.endRow(rows);
+      } else if (c === "\r") {
+        if (i + 1 === chunk.length) {
+          this.cr = true;
+          i++;
+        } else if (chunk[i + 1] === "\n") {
+          i += 2;
+          this.endRow(rows);
+        } else {
+          this.loneCr(base + i);
+          i++;
+        }
+      } else if (this.state === "closed") {
+        throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${base + i}`);
+      } else if (c === '"') {
+        if (this.state !== "start") throw new SyntaxError(`a quote in a field that is not quoted, at offset ${base + i}`);
+        this.state = "quoted";
+        i++;
+      } else {
+        SPECIAL.lastIndex = i;
+        const m = SPECIAL.exec(chunk);
+        const j = m ? m.index : chunk.length;
+        this.field += chunk.slice(i, j);
+        this.state = "plain";
+        i = j;
+      }
+    }
+    if (!last) return rows;
+    if (this.cr) {
+      this.cr = false;
+      this.loneCr(base - 1);
+    }
+    if (this.state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+    if (this.state === "start" && this.row.length === 0) return rows;
+    this.endRow(rows);
+    return rows;
+  }
+
+  // A `\r` that is not followed by `\n` is field text, unless it closes a quoted field.
+  private loneCr(at: number): void {
+    if (this.state === "closed") throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${at}`);
+    this.field += "\r";
+    this.state = "plain";
+  }
+
+  private endField(): void {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "start";
+  }
+
+  private endRow(rows: string[][]): void {
+    this.endField();
+    rows.push(this.row);
+    this.row = [];
+  }
+}
