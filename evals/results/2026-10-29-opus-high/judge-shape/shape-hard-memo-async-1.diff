+      () => {
+        if (cache.get(key) === entry) cache.delete(key);
+      },
     );
-    return entry.promise;
+    return promise;
   }) as Memo<K, V>;
   call.invalidate = (key) => void cache.delete(key);
   call.clear = () => cache.clear();
-  Object.defineProperty(call, "size", { get: () => cache.size });
+  Object.defineProperty(call, "size", {
+    get: () => {
+      sweep();
+      return cache.size;
+    },
+  });
   return call;
 }
