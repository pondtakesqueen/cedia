     cache.delete(key);
-    if (cache.size > opts.max) cache.delete(cache.keys().next().value as K);
-    const entry = { promise: fn(key), expires: Infinity };
+    sweep();
+    while (cache.size >= opts.max) cache.delete(cache.keys().next().value as K);
+    let promise: Promise<V>;
