diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-29 15:39:21.982981146 +0000
@@ -0,0 +1,40 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('empty input throws', () => expect(() => median([])).toThrow('empty'));
+
+test('odd length returns the middle value', () => {
+  expect(median([5])).toBe(5);
+  expect(median([3, 1, 2])).toBe(2);
+});
+
+test('even length returns the mean of the two middle values', () => {
+  expect(median([4, 1, 3, 2])).toBe(2.5);
+  expect(median([1, 2])).toBe(1.5);
+});
+
+test('sorts numerically, including negatives', () => {
+  expect(median([10, 9, 100, 1])).toBe(9.5);
+  expect(median([-10, 2, -1])).toBe(-1);
+});
+
+test('does not change the input', () => {
+  const xs = [3, 1, 2, 4];
+  const before = [...xs];
+  median(xs);
+  expect(xs).toEqual(before);
+});
+
+test('agrees with a sort-and-index reference on seeded random arrays', () => {
+  let seed = 42;
+  const next = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + (i % 50);
+    const xs = Array.from({ length: n }, () => Math.floor(next() * 41) - 20);
+    const s = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(n / 2);
+    const expected = n % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+    if (n % 2) expect(median(xs)).toBe(expected);
+    else expect(median(xs)).toBeCloseTo(expected, 12);
+  }
+});
