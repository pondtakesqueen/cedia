diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 15:58:58.627051089 +0000
@@ -0,0 +1,85 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { bulkDiscount } from '../src/pricing/discounts/bulk.ts';
+import { couponDiscount } from '../src/pricing/discounts/coupons.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules and the region table in README.md.
+describe('pricing rules', () => {
+  test('the region table matches the README', () => {
+    expect(REGIONS.US).toMatchObject({ taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+    expect(REGIONS.EU).toMatchObject({ taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+    expect(REGIONS.UK).toMatchObject({ taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+
+  test('bulk 5% starts at 10 units, not 9', () => {
+    // 10 pens = 1200; 5% = 60. 9 pens = 1080; no discount.
+    expect(bulkDiscount(10, 1200)).toBe(60);
+    expect(bulkDiscount(9, 1080)).toBe(0);
+  });
+
+  test('bulk 10% starts at 50 units; only the highest tier applies', () => {
+    // 50 pens = 6000; 10% = 600. 49 pens = 5880 is in the 5% tier: 294.
+    expect(bulkDiscount(50, 6000)).toBe(600);
+    expect(bulkDiscount(49, 5880)).toBe(294);
+  });
+
+  test('a 10-pen US order gets 5% off and pays shipping and tax on the discounted amount', () => {
+    // subtotal 1200 - 60 = 1140; shipping 800 (1140 < 5000); tax 7% of 1940 = 135.8 -> 136; total 2076
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, coupon: 0, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('a 50-pen US order gets 10% off and ships free', () => {
+    // line 6000 - 600 = 5400 >= 5000, so shipping 0; tax 7% of 5400 = 378; total 5778
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('units of one SKU are counted across the whole cart', () => {
+    // 6 + 4 pens are 10 pens: the same order as 10 pens, which gets 5% off
+    const split = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+    expect(split).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+    expect(split.lines).toHaveLength(1);
+  });
+
+  test('a coupon is taken after bulk discounts, and shipping uses the discounted subtotal', () => {
+    // subtotal 3000 + 2200 = 5200; SAVE10 = 520; discounted 4680 < 5000, so shipping 800;
+    // tax 7% of 5480 = 383.6 -> 384; total 4680 + 800 + 384 = 5864
+    expect(totals(cart('US', [['TEE', 2], ['BAG', 1]], 'SAVE10'))).toMatchObject({ subtotal: 5200, coupon: 520, shipping: 800, tax: 384, total: 5864 });
+  });
+
+  test('a 10-pen order with SAVE10 takes 10% of the bulk-discounted amount', () => {
+    // bulk: 1140; SAVE10 = 114; discounted 1026
+    expect(couponDiscount('SAVE10', 1140)).toBe(114);
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10'))).toMatchObject({ coupon: 114, shipping: 800 });
+  });
+
+  test('FLAT5 takes 500 off but never below zero', () => {
+    expect(couponDiscount('FLAT5', 300)).toBe(300);
+    // one pen = 120; coupon 120; discounted 0; shipping 800; tax 7% of 800 = 56; total 856
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('a UK order at 4050 ships free at the 4000 threshold', () => {
+    // 9 mugs = 4050 >= 4000, so shipping 0; tax 20% of 4050 = 810; total 4860
+    expect(totals(cart('UK', [['MUG', 9]]))).toMatchObject({ subtotal: 4050, shipping: 0, tax: 810, total: 4860 });
+  });
+
+  test('splitting a SKU into different line counts gives the same totals', () => {
+    const splits = [[10], [1, 9], [5, 5], [3, 3, 4]];
+    const results = splits.map((qs) => {
+      const { lines, ...rest } = totals(cart('US', qs.map((q) => ['PEN', q] as [string, number])));
+      return rest;
+    });
+    for (const r of results) expect(r).toEqual(results[0]);
+  });
+
+  test('merging lines does not change the caller\'s cart', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    totals(c);
+    expect(c.lines).toEqual([
+      { sku: 'PEN', quantity: 6, unitPrice: 120 },
+      { sku: 'PEN', quantity: 4, unitPrice: 120 },
+    ]);
+  });
+});
