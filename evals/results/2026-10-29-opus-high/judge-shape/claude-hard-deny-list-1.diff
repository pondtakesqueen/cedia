+const GIT_VALUE_OPTIONS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+
+// A short flag group such as -f or -fu (not a long --flag), containing any of `letters`.
+const shortGroupHas = (word: string, letters: string) =>
+  word.length > 1 && word[0] === '-' && word[1] !== '-' && [...word.slice(1)].some((c) => letters.includes(c));
+
+// `--name` alone or as `--name=value`.
+const longIs = (word: string, name: string) => word === name || word.startsWith(name + '=');
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += GIT_VALUE_OPTIONS.has(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+
+  if (sub === 'push') {
+    let positional = false;
+    for (const word of rest) {
+      if (!positional && word === '--') positional = true;
+      else if (!positional && word.startsWith('-')) {
+        if (['--force', '--force-with-lease', '--mirror', '--delete', '--prune'].some((f) => longIs(word, f)) || shortGroupHas(word, 'fd'))
