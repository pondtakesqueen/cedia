diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-29 15:38:41.126978717 +0000
@@ -0,0 +1,27 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('median of a single element and of negative numbers', () => {
+  expect(median([5])).toBe(5);
+  expect(median([-3, -1, -2])).toBe(-2);
+});
+
+test('median matches a reference over seeded random arrays', () => {
+  let seed = 12345;
+  const next = () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed / 2147483648;
+  };
+  const reference = (xs: number[]) => {
+    const s = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(s.length / 2);
+    return s.length % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+  };
+  for (let i = 0; i < 200; i++) {
+    const len = 1 + Math.floor(next() * 20);
+    const a = Array.from({ length: len }, () => Math.floor(next() * 101) - 50);
+    const before = [...a];
+    expect(median(a)).toBe(reference(a));
+    expect(a).toEqual(before);
+  }
+});
