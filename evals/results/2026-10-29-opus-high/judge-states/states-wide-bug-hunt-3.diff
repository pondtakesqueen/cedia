diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 13:10:01.852165185 +0000
@@ -0,0 +1,94 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { percentOf } from '../src/money/round.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules in README.md. Prices: PEN 120, MUG 450, BAG 2200.
+describe('pricing rules', () => {
+  test('rule 1: a line subtotal is unit price times quantity', () => {
+    expect(totals(cart('US', [['MUG', 2]])).lines[0]!.subtotal).toBe(900);
+  });
+
+  test('rule 2: 10 units get 5% off the line', () => {
+    // 1200 - 60 = 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+    expect(totals(cart('US', [['PEN', 10]])).lines[0]!.discount).toBe(60);
+  });
+
+  test('rule 2: 9 units get no discount', () => {
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]!.discount).toBe(0);
+  });
+
+  test('rule 2: 50 units get only the 10% tier', () => {
+    // 6000 - 600 = 5400; shipping 0; tax 7% of 5400 = 378; total 5778
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+    expect(totals(cart('US', [['PEN', 50]])).lines[0]!.discount).toBe(600);
+  });
+
+  test('rule 2: units of one SKU are merged before pricing', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    const t = totals(c);
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]!.quantity).toBe(10);
+    expect(t.total).toBe(2076);
+    expect(c.lines).toHaveLength(2);
+  });
+
+  test('rule 2: splitting one SKU across lines does not change the total', () => {
+    for (let n = 1; n <= 60; n++) {
+      const whole = totals(cart('US', [['PEN', n]])).total;
+      for (let k = 1; k < n; k++) {
+        expect(totals(cart('US', [['PEN', k], ['PEN', n - k]])).total).toBe(whole);
+      }
+    }
+  });
+
+  test('rule 3: SAVE10 takes 10% off after bulk discounts', () => {
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10')).coupon).toBe(114);
+  });
+
+  test('rule 3: FLAT5 never takes the amount below zero', () => {
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('rule 4: shipping uses the discounted subtotal', () => {
+    // 6000 - 600 bulk = 5400; FLAT5 -> 4900, below 5000, so shipping is charged
+    expect(totals(cart('US', [['PEN', 50]], 'FLAT5'))).toMatchObject({ subtotal: 5400, coupon: 500, shipping: 800, tax: 399, total: 6099 });
+  });
+
+  test('region table: UK free shipping starts at 4000', () => {
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+
+  test('region table matches README', () => {
+    expect(REGIONS.US).toMatchObject({ taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+    expect(REGIONS.EU).toMatchObject({ taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+    expect(REGIONS.UK).toMatchObject({ taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+
+  test('rule 5: tax rounds half up to the cent', () => {
+    expect(percentOf(250, 0.07)).toBe(18);
+  });
+
+  test('rule 5: percentOf is exact half-up for many amounts and rates', () => {
+    for (const rate of [0.05, 0.07, 0.1, 0.2]) {
+      const bp = Math.round(rate * 10000);
+      for (let a = 0; a <= 20000; a++) {
+        expect(percentOf(a, rate)).toBe(Math.floor((a * bp + 5000) / 10000));
+      }
+    }
+  });
+
+  test('rule 6: total is discounted subtotal + shipping + tax', () => {
+    for (const [region, items, coupon] of [
+      ['US', [['PEN', 10]], undefined],
+      ['US', [['PEN', 50]], 'FLAT5'],
+      ['UK', [['BAG', 2]], 'SAVE10'],
+      ['EU', [['MUG', 1], ['TEE', 3]], undefined],
+    ] as const) {
+      const t = totals(cart(region, items as [string, number][], coupon));
+      expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+    }
+  });
+});
