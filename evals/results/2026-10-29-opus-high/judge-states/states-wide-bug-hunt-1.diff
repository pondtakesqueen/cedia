diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 13:08:02.968158118 +0000
@@ -0,0 +1,94 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { percentOf } from '../src/money/round.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('R2: bulk discount applies at exactly 10 units (5%)', () => {
+    // 10 pens = 1200; 5% = 60 -> 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('R2: 49 units still get only the 5% tier', () => {
+    // 49 pens = 5880; 5% = 294 -> 5586 (>= 5000, free shipping); tax 7% of 5586 = 391.02 -> 391
+    expect(totals(cart('US', [['PEN', 49]]))).toMatchObject({ subtotal: 5586, shipping: 0, tax: 391, total: 5977 });
+  });
+
+  test('R2: bulk discount is 10% at exactly 50 units, highest tier only', () => {
+    // 50 pens = 6000; 10% = 600 -> 5400; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('R2: lines of the same SKU are merged before the bulk tier is chosen', () => {
+    const t = totals(cart('US', [['PEN', 5], ['PEN', 5]]));
+    expect(t.lines.length).toBe(1);
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('R3 and R4: coupon comes after bulk, and shipping uses the discounted amount', () => {
+    // 12 mugs = 5400; bulk 5% -> 5130; SAVE10 -> 513 off, 4617 left (under 5000, so shipping is charged)
+    // tax 7% of 4617 + 800 = 379.19 -> 379; total 4617 + 800 + 379 = 5796
+    expect(totals(cart('US', [['MUG', 12]], 'SAVE10'))).toMatchObject({
+      subtotal: 5130,
+      coupon: 513,
+      shipping: 800,
+      tax: 379,
+      total: 5796,
+    });
+  });
+
+  test('R3: FLAT5 never takes an order below zero', () => {
+    // 1 pen = 120; FLAT5 takes only 120; 0 left; shipping 800; tax 7% of 800 = 56
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('R4: free shipping applies at exactly the threshold', () => {
+    // 4 tees = 6000 >= 6000 (EU); tax 20% = 1200
+    expect(totals(cart('EU', [['TEE', 4]]))).toMatchObject({ subtotal: 6000, shipping: 0, tax: 1200, total: 7200 });
+  });
+
+  test('region table: UK free shipping starts at 4000', () => {
+    // 2 bags = 4400 >= 4000; tax 20% = 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+
+  test('region table: each region has the rates and thresholds from the README', () => {
+    expect(Object.values(REGIONS).map((r) => [r.code, r.taxRate, r.shipping, r.freeShippingFrom])).toEqual([
+      ['US', 0.07, 800, 5000],
+      ['EU', 0.2, 900, 6000],
+      ['UK', 0.2, 700, 4000],
+    ]);
+  });
+
+  test('R5: percentOf rounds half up to the cent, matching exact integer maths', () => {
+    for (let a = 0; a <= 20000; a++) {
+      for (const bp of [500, 700, 1000, 2000]) {
+        expect(percentOf(a, bp / 10000)).toBe(Math.floor((a * bp + 5000) / 10000));
+      }
+    }
+  });
+
+  test('R2: splitting a SKU across lines does not change the totals', () => {
+    for (const r of ['US', 'EU', 'UK']) {
+      for (const sku of ['MUG', 'TEE', 'CAP', 'PEN', 'BAG']) {
+        for (let q = 1; q <= 60; q++) {
+          const { subtotal, coupon, shipping, tax, total } = totals(cart(r, [[sku, q]]));
+          for (let k = 1; k <= Math.min(4, q); k++) {
+            const items: [string, number][] = [];
+            for (let i = 0; i < k; i++) items.push([sku, Math.floor(q / k) + (i < q % k ? 1 : 0)]);
+            const input = cart(r, items);
+            const before = JSON.stringify(input.lines);
+            expect(totals(input)).toMatchObject({ subtotal, coupon, shipping, tax, total });
+            expect(JSON.stringify(input.lines)).toBe(before);
+          }
+        }
+      }
+    }
+  });
+
+  test('unknown region still throws', () => {
+    expect(() => totals({ region: 'XX', lines: [] })).toThrow(/unknown region XX/);
+  });
+});
