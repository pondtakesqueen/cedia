+// Reference: the whole text at once, with the same rules.
+function reference(text: string): SseMessage[] {
+  const out: SseMessage[] = [];
+  let event: string | undefined;
+  let data: string[] = [];
+  const flush = () => {
+    if (data.length) out.push(event === undefined ? { data: data.join('\n') } : { event, data: data.join('\n') });
+    event = undefined;
+    data = [];
+  };
+  for (const l of text.replace(/\r$/, '').split(/\r?\n/)) {
+    if (l === '') flush();
+    else if (l[0] !== ':') {
+      const i = l.indexOf(':');
+      const value = i < 0 ? '' : l.slice(i + 1).replace(/^ /, '');
+      const field = i < 0 ? l : l.slice(0, i);
+      if (field === 'event') event = value;
+      else if (field === 'data') data.push(value);
+    }
+  }
+  flush();
+  return out;
+}
+
+test('every input agrees with the whole-text reference at every chunk size', async () => {
+  const inputs = [
+    'event: message_start\ndata: {"a":1}\n\nevent: delta\ndata: {"b":2}\n\n',
+    'event: x\r\ndata: 1\r\n\r\ndata: 2\r\n\r\n',
+    ': keep-alive\ndata: a\nid: 7\ndata: b\nretry: 100\n\n:\n\n',
+    'data:no-space\n\ndata:   two spaces\n\ndata\n\n',
+    'event: ping\n\ndata: plain\n\nevent: a\ndata: x\n\ndata: y\n\n',
+    'data: สวัสดี 🙂\n\n',
+    'data: one\n\ndata: [DONE]',
+    'data: last\n',
+    'data: a\r\n\r\ndata: b',
+    'event: e\ndata:\ndata:\n\n',
+    'data: 🙂\r',
+  ];
+  for (const text of inputs)
+    for (const chunk of [1, 2, 3, 4, 5, 6, 7, 8, 1000]) expect(await all(text, chunk)).toEqual(reference(text));
+});
+
+test('a CR and LF in different chunks still end the line', async () => {
+  expect(await all('data: a\r\n\r\n', 7)).toEqual([{ data: 'a' }]);
+  expect(await all('data: a\r\n\r\n', 9)).toEqual([{ data: 'a' }]);
+});
+
+test('a stream error rejects the next read', async () => {
+  const enc = new TextEncoder();
+  let pulls = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (pulls++ === 0) c.enqueue(enc.encode('data: x\n\n'));
+      else c.error(new Error('boom'));
+    },
+  });
+  const it = readSse(body);
+  expect(await it.next()).toEqual({ value: { data: 'x' }, done: false });
+  await expect(it.next()).rejects.toThrow('boom');
+});
+
+test('breaking out early cancels the body', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: one\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'one' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+  expect(body.locked).toBe(false);
+});
+
+test('a body cut off after a CR keeps no stray carriage return', async () => {
+  expect(await all('data: x\r')).toEqual([{ data: 'x' }]);
+  expect(await all('data: x\r', 1)).toEqual([{ data: 'x' }]);
+});
