+++ b/src/slug.ts	2026-10-29 13:10:23.184166453 +0000
@@ -11,10 +11,24 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (s[max] === '-') return s.slice(0, max);
+  const i = s.lastIndexOf('-', max - 1);
+  return i > 0 ? s.slice(0, i) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  let out = slug;
+  for (let n = 2; taken.has(out); n++) out = `${slug}-${n}`;
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 13:11:23.852170059 +0000
@@ -0,0 +1,64 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('each unit parses on its own', () => {
+  expect(parseDuration('2d')).toBe(172_800_000);
+  expect(parseDuration('3h')).toBe(10_800_000);
+  expect(parseDuration('5m')).toBe(300_000);
+  expect(parseDuration('7s')).toBe(7000);
+  expect(parseDuration('250ms')).toBe(250);
+});
+
+test('parts may be separated by spaces, and outer spaces are ignored', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+});
+
+test('fractions are allowed and the result is rounded', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('1.5ms')).toBe(2);
+  expect(parseDuration('0.4ms')).toBe(0);
+});
+
+test('ms is not read as m followed by s', () => {
+  expect(parseDuration('1m5ms')).toBe(60_005);
+});
+
+test('invalid input throws with the input in the message', () => {
+  for (const bad of ['', '   ', 'h', '-1s', '+1s', '10', '5x', '1h x', '1 h']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
+
+test('the error message holds the input as typed, even with quotes or backslashes', () => {
+  expect(() => parseDuration('5"x')).toThrow('5"x');
+  expect(() => parseDuration('5\\x')).toThrow('5\\x');
+});
+
+test('zero formats as 0s and parts are largest first with zero parts left out', () => {
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(1500)).toBe('1s500ms');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(formatDuration(3_600_500)).toBe('1h500ms');
+});
+
+test('formatDuration rounds its input', () => {
+  expect(formatDuration(0.4)).toBe('0s');
+  expect(formatDuration(1.6)).toBe('2ms');
+});
+
+test('formatDuration throws on negative or non-finite input', () => {
+  expect(() => formatDuration(-1)).toThrow('invalid duration');
+  expect(() => formatDuration(Number.NaN)).toThrow('invalid duration');
+  expect(() => formatDuration(Number.POSITIVE_INFINITY)).toThrow('invalid duration');
+});
+
+test('format and parse agree on 500 seeded random values', () => {
+  let seed = 12345;
+  for (let i = 0; i < 500; i++) {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    const n = Math.floor((seed / 2147483648) * 1e10);
+    expect(parseDuration(formatDuration(n))).toBe(n);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 13:10:38.820167382 +0000
@@ -0,0 +1,213 @@
+import { expect, test } from 'bun:test';
+import { LRU, type EvictReason } from '../src/lru.ts';
+
+function recorder<K, V>(cache: LRU<K, V>) {
+  const log: [K, V, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return log;
+}
+
+test('a hit makes the entry most recent', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recorder(cache);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('an expired entry found by get is removed, and a hit does not renew the ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const log = recorder(cache);
+  cache.set('a', 1);
+  t = 999;
+  expect(cache.get('a')).toBe(1);
+  t = 1999;
+  expect(cache.get('a')).toBeUndefined();
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.get('a')).toBeUndefined();
+  expect(log).toEqual([['a', 1, 'expired']]);
+});
+
+test('expiry boundary: live before t + ttl, expired at it', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 999;
+  expect(cache.get('a')).toBe(1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('re-setting gives a fresh ttl, moves to most recent and fires no evict', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const log = recorder(cache);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('a', 2);
+  t = 1200;
+  expect(cache.get('a')).toBe(2);
+  expect(log).toEqual([]);
+});
+
+test('expired entries count toward capacity and go before live ones', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 100, () => t);
+  const log = recorder(cache);
+  cache.set('a', 1);
+  t = 50;
+  cache.set('b', 2);
+  t = 120;
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('all expired entries go before any live one is evicted', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(3, 100, () => t);
+  const log = recorder(cache);
+  cache.set('a', 1);
+  t = 10;
+  cache.set('b', 2);
+  t = 150;
+  cache.set('c', 3);
+  cache.set('d', 4);
+  expect(log).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+  ]);
+  expect(cache.keys()).toEqual(['d', 'c']);
+});
+
+test('delete on a live entry returns true with reason delete', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const log = recorder(cache);
+  cache.set('a', 1);
+  expect(cache.delete('a')).toBe(true);
+  expect(log).toEqual([['a', 1, 'delete']]);
+});
+
+test('delete on an expired entry returns false with reason expired', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 100, () => t);
+  const log = recorder(cache);
+  cache.set('a', 1);
+  t = 100;
+  expect(cache.delete('a')).toBe(false);
+  expect(log).toEqual([['a', 1, 'expired']]);
+});
+
+test('delete on a missing key returns false and fires nothing', () => {
+  const cache = new LRU<string, number>(5, 100, () => 0);
+  const log = recorder(cache);
+  expect(cache.delete('zz')).toBe(false);
+  expect(log).toEqual([]);
+});
+
+test('size counts live entries only, and reading it fires nothing', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 100, () => t);
+  const log = recorder(cache);
+  cache.set('a', 1);
+  t = 50;
+  cache.set('b', 2);
+  t = 120;
+  expect(cache.size).toBe(1);
+  expect(log).toEqual([]);
+});
+
+test('keys are live and most recent first', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 100, () => t);
+  cache.set('a', 1);
+  t = 50;
+  cache.set('b', 2);
+  cache.set('c', 3);
+  t = 120;
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('agrees with a naive reference model over 1000 seeded operations', () => {
+  type E = { k: number; v: number; expires: number };
+  let t = 0;
+  const cap = 3;
+  const ttl = 100;
+  const cache = new LRU<number, number>(cap, ttl, () => t);
+  const cacheLog = recorder(cache);
+
+  // Reference: an array in least-recent-first order.
+  const arr: E[] = [];
+  const modelLog: [number, number, EvictReason][] = [];
+  const live = (e: E) => t < e.expires;
+  const find = (k: number) => arr.findIndex((e) => e.k === k);
+  const model = {
+    get(k: number) {
+      const i = find(k);
+      if (i < 0) return undefined;
+      const [e] = arr.splice(i, 1);
+      if (!live(e)) {
+        modelLog.push([k, e.v, 'expired']);
+        return undefined;
+      }
+      arr.push(e);
+      return e.v;
+    },
+    set(k: number, v: number) {
+      const i = find(k);
+      if (i >= 0) arr.splice(i, 1);
+      arr.push({ k, v, expires: t + ttl });
+      if (arr.length <= cap) return;
+      for (const e of arr.filter((x) => !live(x))) {
+        arr.splice(arr.indexOf(e), 1);
+        modelLog.push([e.k, e.v, 'expired']);
+      }
+      while (arr.length > cap) {
+        const e = arr.shift()!;
+        modelLog.push([e.k, e.v, 'capacity']);
+      }
+    },
+    delete(k: number) {
+      const i = find(k);
+      if (i < 0) return false;
+      const [e] = arr.splice(i, 1);
+      if (live(e)) {
+        modelLog.push([k, e.v, 'delete']);
+        return true;
+      }
+      modelLog.push([k, e.v, 'expired']);
+      return false;
+    },
+    size: () => arr.filter(live).length,
+    keys: () => arr.filter(live).map((e) => e.k).reverse(),
+  };
+
+  let seed = 4242;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return Math.floor((seed / 2147483648) * n);
+  };
+  for (let step = 0; step < 1000; step++) {
+    const op = rand(4);
+    const k = rand(6);
+    if (op === 0) {
+      cache.set(k, step);
+      model.set(k, step);
+    } else if (op === 1) {
+      expect(cache.get(k)).toBe(model.get(k));
+    } else if (op === 2) {
+      expect(cache.delete(k)).toBe(model.delete(k));
+    } else {
+      t += rand(61);
+    }
+    expect(cache.size).toBe(model.size());
+    expect(cache.keys()).toEqual(model.keys());
+    expect(cacheLog).toEqual(modelLog);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 13:10:38.808167381 +0000
@@ -0,0 +1,72 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('lower case and diacritics', () => {
+  expect(slugify('ABC')).toBe('abc');
+  expect(slugify('àçñź')).toBe('acnz');
+});
+
+test('special letters', () => {
+  expect(slugify('ßæœøłđ')).toBe('ssaeoeold');
+  expect(slugify('ÆØŁ')).toBe('aeol');
+});
+
+test('separators collapse to one dash and never sit at either end', () => {
+  expect(slugify('--a__b  c!!')).toBe('a-b-c');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('a_b')).toBe('a-b');
+});
+
+test('cut at the last dash that fits', () => {
+  expect(slugify('hello-world-foo', 12)).toBe('hello-world');
+});
+
+test('a dash right after the first max characters counts', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+});
+
+test('cut at max when there is no dash to cut at', () => {
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+});
+
+test('short slugs are not cut', () => {
+  expect(slugify('abc', 3)).toBe('abc');
+  expect(slugify('abc')).toBe('abc');
+});
+
+test('truncated slugs keep the rules over 300 seeded random strings', () => {
+  const alphabet = 'aZ -_é!ß0';
+  let seed = 777;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return Math.floor((seed / 2147483648) * n);
+  };
+  for (let i = 0; i < 300; i++) {
+    let text = '';
+    const len = rand(16);
+    for (let j = 0; j < len; j++) text += alphabet[rand(alphabet.length)];
+    const max = 1 + rand(12);
+    const cut = slugify(text, max);
+    const full = slugify(text);
+    expect(cut.length).toBeLessThanOrEqual(max);
+    expect(cut.startsWith('-')).toBe(false);
+    expect(cut.endsWith('-')).toBe(false);
+    expect(full.startsWith(cut)).toBe(true);
+    expect(cut).toMatch(/^[a-z0-9-]*$/);
+  }
+});
+
+test('uniqueSlug returns a free slug as it is', () => {
+  expect(uniqueSlug('x', new Set())).toBe('x');
+});
+
+test('uniqueSlug skips taken numbers', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2', 'post-3']))).toBe('post-4');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+});
+
+test('uniqueSlug does not change the taken set', () => {
+  const taken = new Set(['post']);
+  uniqueSlug('post', taken);
+  expect(taken.size).toBe(1);
+});
