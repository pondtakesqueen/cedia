 });
+
+test('output does not depend on how the body is split into chunks', async () => {
+  const samples = [
+    ': c\r\nevent: x\r\ndata: สวัสดี 🙂\r\n\r\ndata\nid: 1\n\nevent: empty\n\ndata: tail',
+    'event: x\ndata: y',
+    'data: a\r',
+    'data: a\n\n\n\ndata: b\n\n',
+    'event: z\n\ndata:  p \n:c\n\n',
+  ];
+  for (const text of samples) {
+    const whole = await all(text, 1e6);
+    for (let c = 1; c <= 12; c++) expect(await all(text, c)).toEqual(whole);
+  }
+});
+
+test('an event with no data at the end yields nothing', async () => {
+  expect(await all('event: x')).toEqual([]);
+});
+
+test('a final line without a newline keeps its event', async () => {
+  expect(await all('event: x\ndata: y')).toEqual([{ event: 'x', data: 'y' }]);
+});
+
+test('a stray CR at the end of the body is stripped', async () => {
+  expect(await all('data: a\r')).toEqual([{ data: 'a' }]);
+});
+
+test('extra blank lines yield no empty messages', async () => {
+  expect(await all('data: a\n\n\n\ndata: b\n\n')).toEqual([{ data: 'a' }, { data: 'b' }]);
+});
+
+test('a stream error rejects after the messages already read', async () => {
+  const enc = new TextEncoder();
+  let sent = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (!sent) c.enqueue(enc.encode('data: a\n\n'));
+      else c.error(new Error('boom'));
+      sent = true;
+    },
+  });
+  const it = readSse(body);
+  expect((await it.next()).value).toEqual({ data: 'a' });
+  await expect(it.next()).rejects.toThrow('boom');
+});
+
+test('stopping early releases the stream lock', async () => {
+  const body = streamFromString('data: a\n\ndata: b\n\n');
+  for await (const _ of readSse(body)) break;
+  expect(body.locked).toBe(false);
+});
+
+test('stopping early cancels the source stream', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: a\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const _ of readSse(body)) break;
+  expect(cancelled).toBe(true);
+});
+
+test('one long line split into single bytes is read whole', async () => {
+  const long = 'x'.repeat(50000);
+  expect(await all(`data: ${long}\n\n`, 1)).toEqual([{ data: long }]);
+});
