diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 12:48:04.456086875 +0000
@@ -0,0 +1,30 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('git global options with values, and push flag forms', () => {
+  expect(hit('git --work-tree w push -f')).toBe('force-push');
+  expect(hit('git --namespace push status')).toBeUndefined();
+  expect(hit('git push --mirror=x')).toBe('force-push');
+  expect(hit('git push --prune=x')).toBe('force-push');
+  expect(hit('git push -df')).toBe('force-push');
+  expect(hit('git push -uf')).toBe('force-push');
+  expect(hit('git log --format=+x')).toBeUndefined();
+});
+
+test('rm edge targets', () => {
+  expect(hit('rm -rf /work/repo/')).toBe('rm-outside');
+  expect(hit('rm -rf ./')).toBe('rm-outside');
+  expect(hit('rm -rf ~/x')).toBe('rm-outside');
+  expect(hit('rm -rf ..')).toBe('rm-outside');
+  expect(hit('rm -rf -- -r /etc')).toBe('rm-outside');
+  expect(hit('rm -- -r /etc')).toBeUndefined();
+});
+
+test('find with a non-workspace start path or no start path', () => {
+  expect(hit('find -delete')).toBeUndefined();
+  expect(hit('find ~bob -delete')).toBe('rm-outside');
+  expect(hit('find / -exec rm {} ;')).toBe('rm-outside');
+});
