+
+test('the same messages whatever the chunk size', async () => {
+  const corpus: [string, SseMessage[]][] = [
+    ['event: a\r\ndata: สวัสดี\r\n\r\n: c\r\ndata: 🙂 x\ndata:\n\n', [{ event: 'a', data: 'สวัสดี' }, { data: '🙂 x\n' }]],
+    ['event: only\n\ndata: 1\n\r\nevent: x\r\n', [{ data: '1' }]],
+    ['data: no end', [{ data: 'no end' }]],
+    ['data: a\r\n\r\ndata: b\r', [{ data: 'a' }, { data: 'b' }]],
+    ['event: e\ndata: 1\ndata: 2\n\n:\n\ndata:  sp\nid: 3\n\n', [{ event: 'e', data: '1\n2' }, { data: ' sp' }]],
+  ];
+  for (const [s, expected] of corpus) {
+    expect(await all(s, s.length || 1)).toEqual(expected);
+    for (let k = 1; k <= 12; k++) expect(await all(s, k)).toEqual(expected);
+  }
+});
+
+test('an event with no data at the end of the body is dropped', async () => {
+  expect(await all('data: a\n\nevent: x')).toEqual([{ data: 'a' }]);
+  expect(await all('event: x\n')).toEqual([]);
+});
+
+test('a final line ending in CR without LF is yielded', async () => {
+  expect(await all('data: z\r')).toEqual([{ data: 'z' }]);
+});
+
+test('a colon inside the value is kept', async () => {
+  expect(await all('data: a: b\n\n')).toEqual([{ data: 'a: b' }]);
+});
+
+test('a read error reaches the consumer', async () => {
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+      c.error(new Error('boom'));
+    },
+  });
+  const it = readSse(body);
+  expect((await it.next()).value).toEqual({ data: 'a' });
+  await expect(it.next()).rejects.toThrow(/boom/);
+});
+
+test('breaking out early cancels the body', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'x' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
+
+test('an error from cancelling the body on early break is not swallowed', async () => {
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: x\n\n'));
+    },
+    cancel() {
+      throw new Error('cancel-failed');
+    },
+  });
+  await expect(
+    (async () => {
+      for await (const _ of readSse(body)) break;
+    })(),
+  ).rejects.toThrow(/cancel-failed/);
+});
+
+test('early break releases the body even when cancel fails', async () => {
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: x\n\n'));
+    },
+    cancel() {
+      throw new Error('cancel-failed');
+    },
+  });
+  await expect(
+    (async () => {
+      for await (const _ of readSse(body)) break;
+    })(),
+  ).rejects.toThrow(/cancel-failed/);
+  expect(body.locked).toBe(false);
+});
+
+test('an error thrown into the generator cancels the body', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  const it = readSse(body);
+  await it.next();
+  await expect(it.throw(new Error('x'))).rejects.toThrow(/x/);
+  expect(cancelled).toBe(true);
+});
+
+test('one long data line in small chunks is parsed in linear time', async () => {
+  const [m] = await all('data: ' + 'x'.repeat(200000) + '\n\n', 1);
+  expect(m.data.length).toBe(200000);
+});
