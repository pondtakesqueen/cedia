 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  const cmd = argv[0] && basename(argv[0]);
+  if (cmd === 'git') return git(argv.slice(1));
+  if (cmd === 'rm') return rm(argv.slice(1), cwd);
+  if (cmd === 'find') return find(argv.slice(1), cwd);
+  return undefined;
+}
+
+const gitValueOpts = ['-C', '-c', '--git-dir', '--work-tree', '--namespace'];
+const flagIs = (w: string, name: string) => w === name || w.startsWith(name + '=');
+// A short flag group such as -f, -fu or -df: a single dash, then letters, one of which is in `letters`.
+const shortGroup = (w: string, letters: string) => /^-[^-]/.test(w) && [...w.slice(1)].some((c) => letters.includes(c));
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+
+function git(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += gitValueOpts.includes(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const force = rest.some(
+      (w) =>
+        ['--force', '--force-with-lease', '--mirror', '--delete', '--prune'].some((name) => flagIs(w, name)) ||
+        shortGroup(w, 'fd') ||
+        (!w.startsWith('-') && (w.startsWith('+') || w.startsWith(':'))),
+    );
+    return force ? { name: 'force-push', reason: 'git push --force' } : undefined;
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard' };
+  if (sub === 'clean') {
+    const force = rest.some((w) => w === '--force' || shortGroup(w, 'f'));
+    const dryRun = rest.some((w) => w === '-n' || w === '--dry-run');
+    if (force && !dryRun) return { name: 'clean-force', reason: 'git clean -f' };
+  }
+  return undefined;
+}
+
+function rm(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const before = dd < 0 ? args : args.slice(0, dd);
+  const targets = [...before.filter((w) => !w.startsWith('-')), ...(dd < 0 ? [] : args.slice(dd + 1))];
+  if (!before.some((w) => w === '--recursive' || shortGroup(w, 'rR'))) return undefined;
+  const outside = { name: 'rm-outside' as const, reason: 'rm -r outside the working directory' };
+  if (targets.length === 0) return outside;
+  return targets.some((t) => unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd)) ? outside : undefined;
+}
+
+function find(args: string[], cwd: string): Hit | undefined {
+  if (!args.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const firstOpt = args.findIndex((w) => w.startsWith('-'));
+  const starts = firstOpt < 0 ? args : args.slice(0, firstOpt);
+  const paths = starts.length > 0 ? starts : ['.'];
+  if (paths.some((p) => unresolvable(p) || !insideWorkspace(p, cwd)))
+    return { name: 'rm-outside', reason: 'find -delete or -exec outside the working directory' };
+  return undefined;
 }
