diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 12:48:34.304088649 +0000
@@ -0,0 +1,49 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const name = (argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('git global options with values are skipped with their value', () => {
+  expect(name(['git', '--work-tree=.', 'push', '-f'])).toBe('force-push');
+  expect(name(['git', '--namespace', 'ns', 'reset', '--hard'])).toBe('reset-hard');
+  expect(name(['git', '-c', 'push.default=x', 'clean', '-f'])).toBe('clean-force');
+});
+
+test('force-push triggers stand alone and only under push', () => {
+  for (const args of [['--force'], ['--mirror'], ['--delete'], ['--prune'], ['-d'], ['+main'], [':old']])
+    expect(name(['git', 'push', ...args])).toBe('force-push');
+  expect(name(['git', 'fetch', '--prune', '+main'])).toBeUndefined();
+});
+
+test('clean force needs -f and no dry run', () => {
+  expect(name(['git', 'clean', '-f', '--dry-run'])).toBeUndefined();
+  expect(name(['git', 'clean', '--force', '-n'])).toBeUndefined();
+  expect(name(['git', 'clean', '--dry-run'])).toBeUndefined();
+});
+
+test('rm recursion and targets after --', () => {
+  expect(name(['rm', '-f', '/etc/passwd'])).toBeUndefined();
+  expect(name(['rm', '--', '-r', '/etc'])).toBeUndefined();
+  expect(name(['rm', '-rf', '--', '/etc'])).toBe('rm-outside');
+  expect(name(['rm', '-rf', 'src', '/etc'])).toBe('rm-outside');
+  expect(name(['rm', '-rf', '/work/repo/'])).toBe('rm-outside');
+});
+
+test('find with -exec outside the working directory', () => {
+  expect(name(['find', '/', '-exec', 'rm', '{}', ';'])).toBe('rm-outside');
+  expect(name(['find', '-execdir', 'rm', '{}', ';'])).toBeUndefined();
+  expect(name(['find', '/'])).toBeUndefined();
+});
+
+test('argv without a known command passes', () => {
+  expect(name(['git'])).toBeUndefined();
+  expect(name(['echo', 'rm', '-rf', '/'])).toBeUndefined();
+});
+
+test('every hit has a reason', () => {
+  for (const argv of [['git', 'push', '-f'], ['git', 'reset', '--hard'], ['git', 'clean', '-f'], ['rm', '-rf', '/'], ['find', '/', '-delete']]) {
+    const hit = denyListed(argv, cwd);
+    expect(hit?.reason.length).toBeGreaterThan(0);
+  }
+});
