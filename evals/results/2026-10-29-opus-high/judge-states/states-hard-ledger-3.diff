+  let c = norm(command);
+  const cd = /^cd ("[^"]*"|'[^']*'|\S+) && (.*)$/.exec(c);
+  if (cwd !== undefined && cd && resolve(cwd, cd[1]!.replace(/^["']|["']$/g, '')) === resolve(cwd)) c = norm(cd[2]!);
