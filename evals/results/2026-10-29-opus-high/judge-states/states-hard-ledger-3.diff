 // - Otherwise an edit or write call that completed is a write entry with path = input.path.
 // - Otherwise a bash call whose command is not read-only is a write entry with command set (no path).
 export function ledgerEntries(events: SessionEvent[], checks: string[], cwd?: string): LedgerEntry[] {
-  throw new Error('not implemented');
+  const snaps = new Map<string, string[]>();
+  for (const e of events) {
+    if (e.kind === 'snapshot' && e.callId !== undefined) snaps.set(e.callId, [...(snaps.get(e.callId) ?? []), ...e.changed]);
+  }
+  const out: LedgerEntry[] = [];
+  const intents = new Map<string, Extract<SessionEvent, { kind: 'tool_intent' }>>();
+  events.forEach((e, at) => {
+    if (e.kind === 'request') intents.clear();
+    else if (e.kind === 'tool_intent') intents.set(e.callId, e);
+    else if (e.kind === 'tool_result') {
+      const intent = intents.get(e.callId);
+      if (!intent || e.status === 'denied' || e.status === 'not_started') return;
+      const { tool, input } = intent;
+      const cmd = typeof input.command === 'string' ? input.command : undefined;
+      const check = tool === 'bash' && cmd !== undefined ? matchCheck(cmd, checks, cwd) : undefined;
+      if (check !== undefined) {
+        out.push({ kind: 'check', at, command: check, exitCode: e.output.exitCode ?? (e.output.isError ? 1 : 0) });
+        return;
+      }
+      const paths = snaps.get(e.callId);
+      if (paths !== undefined) {
+        for (const path of paths) out.push({ kind: 'write', at, tool, path });
+      } else if ((tool === 'edit' || tool === 'write') && e.status === 'completed' && typeof input.path === 'string') {
+        out.push({ kind: 'write', at, tool, path: input.path });
+      } else if (tool === 'bash' && cmd !== undefined && !isReadOnly(cmd)) {
+        out.push({ kind: 'write', at, tool, command: cmd });
+      }
