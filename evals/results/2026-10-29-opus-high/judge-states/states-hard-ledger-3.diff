-  throw new Error('not implemented');
+  const lastWrite = entries.findLastIndex((e) => e.kind === 'write');
+  if (checks.length === 0 || lastWrite < 0) return true;
+  return entries.slice(lastWrite + 1).some((e) => e.kind === 'check' && e.exitCode === 0);
