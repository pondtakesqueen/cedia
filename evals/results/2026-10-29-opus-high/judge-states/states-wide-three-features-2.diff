 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNITS: [string, number][] = [
+  ['d', 86_400_000],
+  ['h', 3_600_000],
+  ['m', 60_000],
+  ['s', 1_000],
+  ['ms', 1],
+];
+
+const PART = /(\d+(?:\.\d+)?)(ms|d|h|m|s)/g;
+const TEXT = /^\d+(?:\.\d+)?(?:ms|d|h|m|s)(?: *\d+(?:\.\d+)?(?:ms|d|h|m|s))*$/;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  if (!TEXT.test(s)) throw new Error(`invalid duration: "${text}"`);
+  let total = 0;
+  for (const [, n, unit] of s.matchAll(PART)) {
+    const size = UNITS.find(([u]) => u === unit)![1];
+    total += Number(n) * size;
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const [unit, size] of UNITS) {
+    const count = Math.floor(rest / size);
+    if (count > 0) out += `${count}${unit}`;
+    rest -= count * size;
+  }
+  return out;
 }
