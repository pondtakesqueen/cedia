--- a/src/slug.ts	2026-10-29 13:10:49.598144081 +0000
+++ b/src/slug.ts	2026-10-29 13:13:34.844177845 +0000
@@ -11,10 +11,32 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = {
+  ß: 'ss',
+  æ: 'ae',
+  ǣ: 'ae',
+  œ: 'oe',
+  ø: 'o',
+  ł: 'l',
+  đ: 'd',
+};
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const folded = text
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[ßæǣœøłđ]/g, (c) => SPECIAL[c]);
+  const s = folded.replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (s[max] === '-') return s.slice(0, max);
+  const cut = s.lastIndexOf('-', max - 1);
+  return cut > 0 ? s.slice(0, cut) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 13:13:30.576177592 +0000
@@ -0,0 +1,67 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parses single units', () => {
+  expect(parseDuration('90s')).toBe(90_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('2d')).toBe(172_800_000);
+  expect(parseDuration('3m')).toBe(180_000);
+});
+
+test('parses several parts with or without spaces', () => {
+  expect(parseDuration('1h30m')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('2d  4h')).toBe(187_200_000);
+});
+
+test('ignores spaces around the whole text', () => {
+  expect(parseDuration('  90s \t')).toBe(90_000);
+});
+
+test('accepts fractions and rounds the result', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('1.0005s')).toBe(1_001);
+  expect(parseDuration('0.4ms')).toBe(0);
+});
+
+test('ms is milliseconds, not m then s', () => {
+  expect(parseDuration('1m5ms')).toBe(60_005);
+  expect(parseDuration('5ms')).toBe(5);
+});
+
+test('the error message holds the input as written', () => {
+  expect(() => parseDuration('1h\t30m')).toThrow('1h\t30m');
+  expect(() => parseDuration('a"b')).toThrow('a"b');
+});
+
+test('rejects malformed text and names the input', () => {
+  for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '1.s', '.5s', '1h 30', '1 h', '1e3s', '1h,30m']) {
+    expect(() => parseDuration(bad)).toThrow(`invalid duration: ${JSON.stringify(bad)}`);
+  }
+});
+
+test('formats the shortest text, largest unit first', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(86_400_001)).toBe('1d1ms');
+  expect(formatDuration(250)).toBe('250ms');
+});
+
+test('formatting rounds to a whole millisecond', () => {
+  expect(formatDuration(1_500.4)).toBe('1s500ms');
+  expect(formatDuration(0.4)).toBe('0s');
+});
+
+test('formatting a negative or non-finite number throws', () => {
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(Number.NaN)).toThrow();
+  expect(() => formatDuration(Number.POSITIVE_INFINITY)).toThrow();
+});
+
+test('format then parse round-trips', () => {
+  for (let i = 0; i < 500; i++) {
+    const n = (i * 7919) % 864_000_000;
+    expect(parseDuration(formatDuration(n))).toBe(n);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 13:12:22.844173566 +0000
@@ -0,0 +1,174 @@
+import { expect, test } from 'bun:test';
+import { LRU, type EvictReason } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const log: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return { cache, log, tick: (to: number) => (t = to) };
+}
+
+test('a hit makes the entry most recently used', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('set on an existing key refreshes recency and ttl without evicting', () => {
+  const { cache, log, tick } = setup(2, 1000);
+  cache.set('a', 1);
+  tick(500);
+  cache.set('a', 5);
+  expect(log).toEqual([]);
+  tick(1499);
+  expect(cache.get('a')).toBe(5);
+  tick(1500);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('an entry is live before t + ttl and expired at t + ttl', () => {
+  const { cache, tick } = setup(2, 1000);
+  cache.set('a', 1);
+  tick(999);
+  expect(cache.get('a')).toBe(1);
+  tick(1000);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('get on an expired entry fires expired once', () => {
+  const { cache, log, tick } = setup(2, 1000);
+  cache.set('a', 1);
+  tick(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.get('a')).toBeUndefined();
+  expect(log).toEqual([['a', 1, 'expired']]);
+});
+
+test('expired entries are removed before a live one is evicted', () => {
+  const { cache, log, tick } = setup(2, 1000);
+  cache.set('a', 1);
+  tick(600);
+  cache.set('b', 2);
+  tick(1000);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('expired entries count toward capacity until removed', () => {
+  const { cache, log, tick } = setup(1, 1000);
+  cache.set('a', 1);
+  tick(1000);
+  expect(cache.size).toBe(0);
+  cache.set('b', 2);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.size).toBe(1);
+});
+
+test('with nothing expired the least recently used entry is evicted', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'capacity']]);
+});
+
+test('delete reports live, expired and missing entries', () => {
+  const { cache, log, tick } = setup(3, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(log).toEqual([['a', 1, 'delete']]);
+  tick(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(cache.delete('zz')).toBe(false);
+  expect(log).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('size and keys skip expired entries without removing them', () => {
+  const { cache, log, tick } = setup(3, 1000);
+  cache.set('a', 1);
+  tick(600);
+  cache.set('b', 2);
+  tick(1000);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+});
+
+test('matches a reference model over random operations', () => {
+  const capacity = 3;
+  const ttl = 1000;
+  let t = 0;
+  const cache = new LRU<number, number>(capacity, ttl, () => t);
+  const log: [number, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+
+  // Model: entries in recency order, oldest first.
+  let model: { k: number; v: number; exp: number }[] = [];
+  const live = () => model.filter((e) => t < e.exp);
+
+  let seed = 42;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  const expected: [number, number, EvictReason][] = [];
+
+  for (let i = 0; i < 2000; i++) {
+    const op = rand(4);
+    const k = rand(6);
+    if (op === 0) {
+      const v = i;
+      model = model.filter((e) => e.k !== k);
+      model.push({ k, v, exp: t + ttl });
+      if (model.length > capacity) {
+        for (const e of model.filter((m) => t >= m.exp)) expected.push([e.k, e.v, 'expired']);
+        model = model.filter((m) => t < m.exp);
+        while (model.length > capacity) {
+          const e = model.shift()!;
+          expected.push([e.k, e.v, 'capacity']);
+        }
+      }
+      cache.set(k, v);
+    } else if (op === 1) {
+      const e = model.find((m) => m.k === k);
+      let want: number | undefined;
+      if (e && t < e.exp) {
+        want = e.v;
+        model = model.filter((m) => m !== e);
+        model.push(e);
+      } else if (e) {
+        model = model.filter((m) => m !== e);
+        expected.push([e.k, e.v, 'expired']);
+      }
+      expect(cache.get(k)).toBe(want);
+    } else if (op === 2) {
+      const e = model.find((m) => m.k === k);
+      let want = false;
+      if (e) {
+        model = model.filter((m) => m !== e);
+        if (t < e.exp) {
+          want = true;
+          expected.push([e.k, e.v, 'delete']);
+        } else {
+          expected.push([e.k, e.v, 'expired']);
+        }
+      }
+      expect(cache.delete(k)).toBe(want);
+    } else {
+      t += rand(400);
+    }
+    expect(cache.size).toBe(live().length);
+    expect(cache.keys()).toEqual(live().map((e) => e.k).reverse());
+    expect(log).toEqual(expected);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 13:13:30.568177591 +0000
@@ -0,0 +1,74 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('lower cases', () => {
+  expect(slugify('ABC')).toBe('abc');
+});
+
+test('drops diacritics', () => {
+  expect(slugify('à ç ñ ź')).toBe('a-c-n-z');
+  expect(slugify('ÉÀ')).toBe('ea');
+});
+
+test('maps special letters in both cases', () => {
+  expect(slugify('Straße')).toBe('strasse');
+  expect(slugify('Æon')).toBe('aeon');
+  expect(slugify('cœur')).toBe('coeur');
+  expect(slugify('Øl')).toBe('ol');
+  expect(slugify('Łódź')).toBe('lodz');
+  expect(slugify('Đ')).toBe('d');
+  expect(slugify('ÆŒØŁĐ')).toBe('aeoeold');
+});
+
+test('special letters with a further diacritic lose it too', () => {
+  expect(slugify('ǿ')).toBe('o');
+  expect(slugify('ǽ')).toBe('ae');
+  expect(slugify('Ǣ')).toBe('ae');
+});
+
+test('separators collapse and the slug never starts or ends with "-"', () => {
+  expect(slugify('a  _--b')).toBe('a-b');
+  expect(slugify('--a--')).toBe('a');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('')).toBe('');
+});
+
+test('max cuts at the last "-" that fits', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 8)).toBe('ab-cd-ef');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab-cdef', 5)).toBe('ab');
+  expect(slugify('abc', 5)).toBe('abc');
+  expect(slugify('abc', 0)).toBe('');
+});
+
+test('max keeps the invariants for many inputs', () => {
+  const pieces = ['a', 'Z', '9', ' ', '-', 'é', '!', 'ß', 'x'];
+  let seed = 7;
+  for (let i = 0; i < 300; i++) {
+    let text = '';
+    const len = 1 + (i % 17);
+    for (let j = 0; j < len; j++) {
+      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+      text += pieces[seed % pieces.length];
+    }
+    const full = slugify(text);
+    for (let max = 1; max <= 12; max++) {
+      const cut = slugify(text, max);
+      expect(cut.length).toBeLessThanOrEqual(max);
+      expect(cut.startsWith('-') || cut.endsWith('-')).toBe(false);
+      expect(full.startsWith(cut)).toBe(true);
+      if (full.length <= max) expect(cut).toBe(full);
+    }
+  }
+});
+
+test('uniqueSlug returns the slug, or the first free numbered one', () => {
+  const taken = new Set(['post']);
+  expect(uniqueSlug('news', taken)).toBe('news');
+  expect(uniqueSlug('post', taken)).toBe('post-2');
+  taken.add('post-2');
+  expect(uniqueSlug('post', taken)).toBe('post-3');
+  expect([...taken]).toEqual(['post', 'post-2']);
+});
