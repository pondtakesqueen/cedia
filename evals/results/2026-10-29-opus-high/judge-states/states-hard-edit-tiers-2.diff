diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-29 12:51:57.068100702 +0000
@@ -0,0 +1,90 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+
+describe('tier order', () => {
+  test('exact wins over trailing-space when both match', () => {
+    const r = ok(applyEdit('a  \nb\n', { old_text: 'a  ', new_text: 'c' }));
+    expect(r.applied).toEqual({ from: 1, to: 1, tier: 'exact', count: 1 });
+    expect(r.content).toBe('c\nb\n');
+  });
+  test('several exact matches error at once, without falling through', () => {
+    const r = applyEdit('p\nq\nx\nx\n', { old_text: 'x', new_text: 'z' });
+    expect('error' in r && r.error).toContain('matches 2 places (first at line 3)');
+  });
+  test('replace_all does not widen the line tiers', () => {
+    const r = applyEdit('a \nb\na \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true });
+    expect('error' in r && r.error).toContain('matches 2 places');
+  });
+  test('several indentation-tier matches error with their lines', () => {
+    const r = applyEdit('  a\n  b\n    a\n    b\n', { old_text: 'a\nb', new_text: 'c' });
+    expect('error' in r && r.error).toContain('matches 2 places (lines 1, 3)');
+  });
+});
+
+describe('re-indent fallback', () => {
+  test('a new_text line indented less than old_text takes the window base indent', () => {
+    const r = ok(applyEdit('    if x:\n        a\n', { old_text: '  if x:\n      a', new_text: ' z\n  if y:\n      a' }));
+    expect(r.applied).toEqual({ from: 1, to: 2, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('    z\n    if y:\n        a\n');
+  });
+});
+
+describe('positions', () => {
+  test('a match on the last line without a final newline', () => {
+    const r = ok(applyEdit('a\n  b\n  c', { old_text: 'b\nc', new_text: 'd' }));
+    expect(r.applied).toEqual({ from: 2, to: 3, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('a\n  d');
+  });
+  test('a trailing newline on old_text does not extend the range', () => {
+    const r = ok(applyEdit('x\ny\nz\n', { old_text: 'y\n', new_text: 'Y\n' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+    expect(r.content).toBe('x\nY\nz\n');
+  });
+});
+
+describe('not found', () => {
+  test('lists at most five lines where the first line appears', () => {
+    const src = 'foo\nfoo\nfoo\nfoo\nfoo\nfoo\nfoo\n';
+    const r = applyEdit(src, { old_text: 'foo\nbar', new_text: 'x' });
+    expect('error' in r && r.error).toBe('old_text not found; first line appears at line 1, 2, 3, 4, 5');
+  });
+  test('an all-blank old_text gives no pointer', () => {
+    const r = applyEdit('a\nb\n', { old_text: '  \n', new_text: 'x' });
+    expect(r).toEqual({ error: 'old_text not found' });
+  });
+});
+
+describe('agreement with plain string replacement', () => {
+  // Deterministic LCG so the cases are the same on every run.
+  let seed = 12345;
+  const rnd = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  const alphabet = ['a', 'b', ' ', '\n'];
+  const randomString = (len: number) => Array.from({ length: len }, () => alphabet[rnd(alphabet.length)]).join('');
+
+  test('exact tier matches String.replace and split/join', () => {
+    for (let t = 0; t < 200; t++) {
+      const content = randomString(1 + rnd(20));
+      const start = rnd(content.length);
+      const old = content.slice(start, start + 1 + rnd(4));
+      if (old === 'Z') continue;
+      const pieces = content.split(old).length;
+      if (pieces === 2) {
+        const r = ok(applyEdit(content, { old_text: old, new_text: 'Z' }));
+        expect(r.content).toBe(content.replace(old, 'Z'));
+        expect(r.applied.tier).toBe('exact');
+      } else if (pieces > 2) {
+        const r = ok(applyEdit(content, { old_text: old, new_text: 'Z', replace_all: true }));
+        expect(r.content).toBe(content.split(old).join('Z'));
+        expect(r.applied.count).toBe(pieces - 1);
+      }
+    }
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-29 12:49:30.853450900 +0000
+++ b/edit.ts	2026-10-29 12:50:34.208095776 +0000
@@ -23,5 +23,69 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: neu, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create content' };
+  if (old === neu) return { error: 'old_text and new_text are the same' };
+
+  const starts: number[] = [];
+  for (let i = content.indexOf(old); i !== -1; i = content.indexOf(old, i + old.length)) starts.push(i);
+  const lineAt = (i: number) => content.slice(0, i).split('\n').length;
+  if (starts.length > 1 && !replace_all) {
+    return { error: `old_text matches ${starts.length} places (first at line ${lineAt(starts[0])}); add context or set replace_all` };
+  }
+  if (starts.length > 0) {
+    const from = lineAt(starts[0]);
+    const body = old.endsWith('\n') ? old.slice(0, -1) : old;
+    const to = from + body.split('\n').length - 1;
+    const out = replace_all
+      ? content.split(old).join(neu)
+      : content.slice(0, starts[0]) + neu + content.slice(starts[0] + old.length);
+    return { content: out, applied: { from, to, tier: 'exact', count: starts.length } };
+  }
+
+  const strip1 = (s: string) => (s.endsWith('\n') ? s.slice(0, -1) : s);
+  const oldLines = strip1(old).split('\n');
+  const newBody = strip1(neu);
+  const newLines = newBody === '' ? [] : newBody.split('\n');
+  const lines = content.split('\n');
+  const limit = lines.length - (content.endsWith('\n') ? 1 : 0);
+  const indentOf = (s: string) => s.match(/^\s*/)![0];
+  const firstNonBlank = (ls: string[]) => ls.find(l => l.trim() !== '') ?? '';
+
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', s => s.trimEnd()],
+    ['indentation', s => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const want = oldLines.map(norm);
+    const hits: number[] = [];
+    for (let i = 0; i + oldLines.length <= limit; i++) {
+      if (want.every((l, k) => norm(lines[i + k]) === l)) hits.push(i);
+    }
+    if (hits.length > 1) {
+      return { error: `old_text matches ${hits.length} places (lines ${hits.map(i => i + 1).join(', ')})` };
+    }
+    if (hits.length === 1) {
+      const i = hits[0];
+      let repl = newLines;
+      if (tier === 'indentation') {
+        const oi = indentOf(firstNonBlank(oldLines));
+        const fi = indentOf(firstNonBlank(lines.slice(i, i + oldLines.length)));
+        repl = newLines.map(l => (l.trim() === '' ? '' : l.startsWith(oi) ? fi + l.slice(oi.length) : fi + l.trimStart()));
+      }
+      const next = lines.slice(0, i).concat(repl, lines.slice(i + oldLines.length));
+      return { content: next.join('\n'), applied: { from: i + 1, to: i + oldLines.length, tier, count: 1 } };
+    }
+  }
+
+  let error = 'old_text not found';
+  const first = firstNonBlank(oldLines).trim();
+  if (first !== '') {
+    const hits: number[] = [];
+    lines.forEach((l, i) => {
+      if (hits.length < 5 && l.includes(first)) hits.push(i + 1);
+    });
+    if (hits.length > 0) error += `; first line appears at line ${hits.join(', ')}`;
+  }
+  return { error };
 }
