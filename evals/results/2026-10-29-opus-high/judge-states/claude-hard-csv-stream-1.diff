--- a/csv.ts	2026-10-29 08:57:12.310544251 +0000
+++ b/csv.ts	2026-10-29 08:58:42.600917109 +0000
@@ -50,3 +50,154 @@
   rows.push(row);
   return rows;
 }
+
+type StreamState = "fieldStart" | "unquoted" | "unquotedCr" | "quoted" | "quotedQuote" | "afterQuote" | "afterQuoteCr";
+
+/**
+ * Reads CSV as `parseCsv` does, from input that arrives in chunks split anywhere. `push` returns the rows whose row
+ * end has arrived, and `end` the rest once the input is over; together they give `parseCsv` of the whole input, and
+ * an input `parseCsv` rejects makes one of them throw a SyntaxError, after which every call throws it again. A chunk
+ * costs time in its own length, however much input came before it.
+ */
+export class CsvStream {
+  #state: StreamState = "fieldStart";
+  #row: string[] = [];
+  #field = "";
+  // Where the next chunk starts in the whole input, for error messages.
+  #offset = 0;
+  #started = false;
+  #ended = false;
+  #error: SyntaxError | undefined;
+
+  push(chunk: string): string[][] {
+    this.#check();
+    try {
+      return this.#feed(chunk);
+    } catch (e) {
+      if (e instanceof SyntaxError) this.#error = e;
+      throw e;
+    }
+  }
+
+  end(): string[][] {
+    this.#check();
+    this.#ended = true;
+    const rows: string[][] = [];
+    switch (this.#state) {
+      case "quoted":
+        throw (this.#error = new SyntaxError("a quoted field is still open at the end of the input"));
+      case "afterQuoteCr":
+        throw (this.#error = new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.#offset - 1}`));
+      case "unquotedCr":
+        this.#field += "\r";
+        break;
+      case "fieldStart":
+        // At the start of a row nothing is left; after a `,` an empty field is.
+        if (this.#row.length === 0) return rows;
+        break;
+    }
+    this.#endRow(rows);
+    return rows;
+  }
+
+  #check() {
+    if (this.#error) throw this.#error;
+    if (this.#ended) throw new Error("the stream has already ended");
+  }
+
+  #endField() {
+    this.#row.push(this.#field);
+    this.#field = "";
+    this.#state = "fieldStart";
+  }
+
+  #endRow(rows: string[][]) {
+    this.#endField();
+    rows.push(this.#row);
+    this.#row = [];
+  }
+
+  #feed(chunk: string): string[][] {
+    const rows: string[][] = [];
+    const n = chunk.length;
+    let i = 0;
+    if (!this.#started && n > 0) {
+      this.#started = true;
+      if (chunk[0] === "﻿") i = 1;
+    }
+    while (i < n) {
+      const c = chunk[i]!;
+      switch (this.#state) {
+        case "fieldStart":
+          if (c === '"') {
+            i++;
+            this.#state = "quoted";
+          } else this.#state = "unquoted";
+          break;
+        case "unquoted": {
+          let j = i;
+          for (; j < n; j++) {
+            const d = chunk[j];
+            if (d === "," || d === "\n" || d === "\r" || d === '"') break;
+          }
+          this.#field += chunk.slice(i, j);
+          if (j === n) return this.#done(rows, n);
+          const d = chunk[j];
+          i = j + 1;
+          if (d === ",") this.#endField();
+          else if (d === "\n") this.#endRow(rows);
+          else if (d === "\r") this.#state = "unquotedCr";
+          else throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.#offset + j}`);
+          break;
+        }
+        case "unquotedCr":
+          // Only now is it known whether the `\r` ended the row or belongs to the field.
+          if (c === "\n") {
+            i++;
+            this.#endRow(rows);
+          } else {
+            this.#field += "\r";
+            this.#state = "unquoted";
+          }
+          break;
+        case "quoted": {
+          const j = chunk.indexOf('"', i);
+          if (j < 0) {
+            this.#field += chunk.slice(i);
+            return this.#done(rows, n);
+          }
+          this.#field += chunk.slice(i, j);
+          i = j + 1;
+          this.#state = "quotedQuote";
+          break;
+        }
+        case "quotedQuote":
+          // Only now is it known whether the `"` was doubled or closed the field.
+          if (c === '"') {
+            i++;
+            this.#field += '"';
+            this.#state = "quoted";
+          } else this.#state = "afterQuote";
+          break;
+        case "afterQuote":
+          i++;
+          if (c === ",") this.#endField();
+          else if (c === "\n") this.#endRow(rows);
+          else if (c === "\r") this.#state = "afterQuoteCr";
+          else throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${this.#offset + i - 1}`);
+          break;
+        case "afterQuoteCr":
+          if (c !== "\n") throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.#offset + i - 1}`);
+          i++;
+          this.#endRow(rows);
+          break;
+      }
+    }
+    return this.#done(rows, n);
+  }
+
+  #done(rows: string[][], n: number): string[][] {
+    this.#offset += n;
+    return rows;
+  }
+}
