diff -ruN '--exclude=node_modules' '--exclude=.git' a/ledger.extra.test.ts b/ledger.extra.test.ts
--- a/ledger.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.extra.test.ts	2026-10-29 12:57:26.520120285 +0000
@@ -0,0 +1,122 @@
+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+const bash = (callId: string, command: string, exitCode = 0, status: 'completed' | 'failed' | 'denied' | 'not_started' = 'completed'): SessionEvent[] => [
+  { kind: 'tool_intent', callId, tool: 'bash', input: { command } },
+  { kind: 'tool_result', callId, status, output: { isError: exitCode !== 0, exitCode } },
+];
+
+describe('matchCheck edge cases', () => {
+  test('extra whitespace and trailing 2>&1 are dropped from the command', () => {
+    expect(matchCheck('bun test 2>&1 ', ['bun test'])).toBe('bun test');
+  });
+
+  test('a pipe after a leading cd is not a check', () => {
+    expect(matchCheck('cd /work/repo && bun test | tail', ['bun test'], cwd)).toBeUndefined();
+  });
+
+  test('cd is stripped only when it resolves to cwd, quotes included', () => {
+    expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd .. && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+
+  test('a double-quoted cd to cwd is stripped; without cwd it is not', () => {
+    expect(matchCheck('cd "/work/repo" && bun test', ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd "/work/repo" && bun test', ['bun test'])).toBeUndefined();
+  });
+
+  test('a quoted cd directory keeps its inner spaces', () => {
+    expect(matchCheck('cd "/work/my  repo" && bun test', ['bun test'], '/work/my  repo')).toBe('bun test');
+  });
+
+  test('2>&1 is dropped only when it is a separate word', () => {
+    expect(matchCheck('bun test2>&1', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun run test1 2>&1', ['bun run test'])).toBeUndefined();
+    expect(matchCheck('bun test2>&1', ['bun test2>&1'])).toBe('bun test2>&1');
+  });
+});
+
+describe('ledgerEntries edge cases', () => {
+  test('a denied check does not count', () => {
+    expect(ledgerEntries(bash('a', 'bun test', 0, 'denied'), ['bun test'])).toEqual([]);
+  });
+
+  test('an intent and result both after a second request are counted', () => {
+    const [intent, result] = bash('a', 'bun test');
+    expect(ledgerEntries([{ kind: 'request' }, { kind: 'request' }, intent!, result!], ['bun test'])).toEqual([
+      { kind: 'check', at: 3, command: 'bun test', exitCode: 0 },
+    ]);
+  });
+
+  test('a snapshot overrides a failed edit and applies to it', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'e', tool: 'edit', input: { path: 'a.ts' } },
+      { kind: 'tool_result', callId: 'e', status: 'failed', output: { isError: true } },
+      { kind: 'snapshot', callId: 'e', changed: ['z.ts'] },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'z.ts' }]);
+  });
+
+  test('a snapshot placed between intent and result still applies', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'b', tool: 'bash', input: { command: 'sed -i s/a/b/ q.ts' } },
+      { kind: 'snapshot', callId: 'b', changed: ['q.ts'] },
+      { kind: 'tool_result', callId: 'b', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'bash', path: 'q.ts' }]);
+  });
+
+  test('a duplicate result is counted once', () => {
+    const [intent, result] = bash('a', 'bun test');
+    expect(ledgerEntries([intent!, result!, result!], ['bun test'])).toHaveLength(1);
+  });
+
+  test('a read-only bash is not a write', () => {
+    expect(ledgerEntries(bash('a', 'ls -la'), [])).toEqual([]);
+  });
+
+  test('an edit without a string path is not a write', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'e', tool: 'edit', input: {} },
+      { kind: 'tool_result', callId: 'e', status: 'completed', output: { isError: false } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([]);
+  });
+});
+
+describe('evidence and verified edge cases', () => {
+  const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+  const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+  test('a final passing check leaves nothing unverified', () => {
+    expect(evidence([w(1, 'a'), c(2, 0)]).unverified).toEqual([]);
+  });
+
+  test('changed is deduplicated, first seen first', () => {
+    expect(evidence([w(1, 'a'), w(2, 'b'), w(3, 'a')]).changed).toEqual(['a', 'b']);
+  });
+
+  test('verified agrees with a naive dirty-flag oracle on random logs', () => {
+    let seed = 42;
+    const rand = () => {
+      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+      return seed / 0x7fffffff;
+    };
+    for (let run = 0; run < 200; run++) {
+      const len = Math.floor(rand() * 9);
+      const entries: LedgerEntry[] = [];
+      for (let i = 0; i < len; i++) {
+        entries.push(rand() < 0.5 ? w(i, rand() < 0.5 ? 'a' : 'b') : c(i, rand() < 0.5 ? 0 : 1));
+      }
+      let dirty = false;
+      for (const e of entries) {
+        if (e.kind === 'write') dirty = true;
+        else if (e.exitCode === 0) dirty = false;
+      }
+      expect(verified(entries, ['bun test'])).toBe(!dirty);
+      expect(evidence(entries).unverified.length === 0).toBe(!dirty);
+      expect(verified(entries, [])).toBe(true);
+    }
+  });
+});
