diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.fixes.test.ts b/memo.fixes.test.ts
--- a/memo.fixes.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.fixes.test.ts	2026-10-29 12:58:40.016124654 +0000
@@ -0,0 +1,139 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+// fn's calls, each settled by the test.
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("a new key keeps the cache at max, not max plus one", () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  expect(m.size).toBe(1);
+  expect(calls.map((c) => c.key)).toEqual(["a", "b"]);
+});
+
+test("a cache hit makes its key the most recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  for (const k of ["a", "b"]) m(k);
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  m("a");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("a rejection is shared by every waiter and the next call runs fn again", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const err = new Error("boom");
+  const p1 = m("k");
+  const p2 = m("k");
+  calls[0]!.d.reject(err);
+  await expect(p1).rejects.toBe(err);
+  await expect(p2).rejects.toBe(err);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection of an invalidated call does not delete the newer entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+  calls[0]!.d.reject(new Error("old"));
+  await expect(first).rejects.toThrow("old");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("an in-flight call evicted to stay under max is not written back", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  const a = m("a");
+  m("b");
+  calls[0]!.d.resolve("va");
+  expect(await a).toBe("va");
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("an invalidated in-flight result does not replace the newer result", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.resolve("old");
+  calls[1]!.d.resolve("new");
+  expect(await first).toBe("old");
+  expect(await second).toBe("new");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("clear forgets every key, including those in flight", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("a");
+  m("b");
+  m.clear();
+  calls[0]!.d.resolve("va");
+  calls[1]!.d.resolve("vb");
+  await tick();
+  expect(m.size).toBe(0);
+  m("a");
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("the ttl counts from when the result settled, not from the call", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  t = 50;
+  calls[0]!.d.resolve("v");
+  await tick();
+  t = 149;
+  expect(await m("k")).toBe("v");
+  t = 150;
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("bad options are rejected", () => {
+  const { fn } = lookups();
+  expect(() => memo(fn, { ttlMs: 0, max: 1 })).toThrow(RangeError);
+  expect(() => memo(fn, { ttlMs: 1, max: 0 })).toThrow(RangeError);
+  expect(() => memo(fn, { ttlMs: 1, max: 1.5 })).toThrow(RangeError);
+});
