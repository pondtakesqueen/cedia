 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Map order is least recently used first.
+  private readonly map = new Map<K, Entry<V>>();
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
-  }
+  constructor(
+    private readonly capacity: number,
+    private readonly ttlMs: number,
+    private readonly now: () => number = Date.now,
+  ) {}
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.map.get(key);
+    if (!entry) return undefined;
+    this.map.delete(key);
+    if (this.now() >= entry.expires) {
+      this.onEvict?.(key, entry.value, 'expired');
+      return undefined;
+    }
+    this.map.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.map.delete(key);
+    this.map.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    const t = this.now();
+    for (const [k, e] of this.map) {
+      if (t >= e.expires) {
+        this.map.delete(k);
+        this.onEvict?.(k, e.value, 'expired');
+      }
+    }
+    while (this.map.size > this.capacity) {
+      const [k, e] = this.map.entries().next().value as [K, Entry<V>];
+      this.map.delete(k);
+      this.onEvict?.(k, e.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.map.get(key);
+    if (!entry) return false;
+    this.map.delete(key);
+    if (this.now() >= entry.expires) {
+      this.onEvict?.(key, entry.value, 'expired');
+      return false;
+    }
+    this.onEvict?.(key, entry.value, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    const t = this.now();
+    let n = 0;
+    for (const e of this.map.values()) if (t < e.expires) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
