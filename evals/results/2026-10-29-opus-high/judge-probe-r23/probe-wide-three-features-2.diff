 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const FOLD: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const folded = text.toLowerCase().replace(/[ßæœøłđ]/g, (c) => FOLD[c]);
+  const s = folded
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (s[max] === '-') return s.slice(0, max);
+  const head = s.slice(0, max);
+  const i = head.lastIndexOf('-');
+  return i > 0 ? head.slice(0, i) : head;
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 10:04:18.705151082 +0000
@@ -0,0 +1,31 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parseDuration accepts fractions, spaces and ms', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+  expect(parseDuration('1.0005s')).toBe(1001);
+});
+
+test('parseDuration rejects malformed input and names it', () => {
+  for (const bad of ['', '10', 'h', '-1s', '1 h', '1h x']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
+
+test('parseDuration error message holds the raw input, escapes included', () => {
+  expect(() => parseDuration('a"b')).toThrow('a"b');
+  expect(() => parseDuration('1h\nx')).toThrow('1h\nx');
+  expect(() => parseDuration('a\\b')).toThrow('a\\b');
+});
+
+test('formatDuration rules', () => {
+  expect(formatDuration(1500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(500)).toBe('500ms');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(Number.NaN)).toThrow();
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 10:04:18.713151083 +0000
@@ -0,0 +1,107 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const evicted: [string, number, string][] = [];
+  cache.onEvict = (k, v, reason) => evicted.push([k, v, reason]);
+  return { cache, evicted, advance: (to: number) => (t = to) };
+}
+
+test('a hit makes the entry most recent', () => {
+  const { cache, evicted } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(evicted).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('entry is live before ttl and expired at ttl', () => {
+  const { cache, evicted, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  advance(999);
+  expect(cache.get('a')).toBe(1);
+  advance(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+});
+
+test('expired entries are removed before a live one is evicted', () => {
+  const { cache, evicted, advance } = setup(2, 1000);
+  cache.set('a', 1);
+  advance(500);
+  cache.set('b', 2);
+  advance(1200);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('a live entry is evicted for capacity when nothing has expired', () => {
+  const { cache, evicted, advance } = setup(2, 1000);
+  cache.set('a', 1);
+  advance(900);
+  cache.set('b', 2);
+  advance(950);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('overwriting a key moves it to most recent', () => {
+  const { cache, evicted, advance } = setup(2, 1000);
+  cache.set('a', 1);
+  advance(100);
+  cache.set('b', 2);
+  advance(200);
+  cache.set('a', 3);
+  advance(300);
+  cache.set('c', 4);
+  expect(evicted).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('overwriting a key gives it a fresh ttl', () => {
+  const { cache, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  advance(800);
+  cache.set('a', 2);
+  advance(1200);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('a get hit does not extend the expiry', () => {
+  const { cache, evicted, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  advance(900);
+  expect(cache.get('a')).toBe(1);
+  advance(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+});
+
+test('delete reports live, expired and missing keys', () => {
+  const { cache, evicted, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(evicted).toEqual([['a', 1, 'delete']]);
+  advance(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(evicted[1]).toEqual(['b', 2, 'expired']);
+  expect(cache.delete('zz')).toBe(false);
+});
+
+test('size and keys leave out expired entries', () => {
+  const { cache, evicted, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  advance(600);
+  cache.set('b', 2);
+  advance(1000);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(evicted).toEqual([]);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 10:03:14.289147253 +0000
@@ -0,0 +1,23 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify strips diacritics and folds letters', () => {
+  expect(slugify('à ç ñ ź')).toBe('a-c-n-z');
+  expect(slugify('Straße Æon Œuvre Øl Łódź Đak')).toBe('strasse-aeon-oeuvre-ol-lodz-dak');
+});
+
+test('slugify collapses separators at the ends', () => {
+  expect(slugify('--a__b--')).toBe('a-b');
+});
+
+test('slugify with max cuts at a dash within max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab', 5)).toBe('ab');
+});
+
+test('uniqueSlug finds the first free suffix', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('x', new Set())).toBe('x');
+});
