diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.rules.test.ts b/pool.rules.test.ts
--- a/pool.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.rules.test.ts	2026-10-29 09:53:09.589111308 +0000
@@ -0,0 +1,238 @@
+import { expect, test } from "bun:test";
+import { runPool } from "./pool";
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+// A task the test settles by hand, recording how many calls are in flight.
+function gate() {
+  const state = { inFlight: 0, maxInFlight: 0, started: [] as number[] };
+  const pending = new Map<number, { resolve: (v: number) => void; reject: (e: unknown) => void }>();
+  const task = (i: number) => () => {
+    state.started.push(i);
+    state.inFlight++;
+    state.maxInFlight = Math.max(state.maxInFlight, state.inFlight);
+    return new Promise<number>((resolve, reject) => {
+      pending.set(i, {
+        resolve: (v) => (state.inFlight--, resolve(v)),
+        reject: (e) => (state.inFlight--, reject(e)),
+      });
+    });
+  };
+  return { state, pending, task };
+}
+
+test("never runs more than limit at once, and keeps limit in flight while tasks remain", async () => {
+  const { state, pending, task } = gate();
+  const run = runPool([0, 1, 2, 3, 4].map(task), 2);
+  await tick();
+  expect(state.started).toEqual([0, 1]);
+  pending.get(1)!.resolve(1);
+  await tick();
+  expect(state.started).toEqual([0, 1, 2]);
+  expect(state.inFlight).toBe(2);
+  pending.get(0)!.resolve(0);
+  pending.get(2)!.resolve(2);
+  await tick();
+  expect(state.started).toEqual([0, 1, 2, 3, 4]);
+  pending.get(3)!.resolve(3);
+  pending.get(4)!.resolve(4);
+  await run;
+  expect(state.maxInFlight).toBe(2);
+});
+
+test("limit 1 runs tasks strictly one after another", async () => {
+  let inFlight = 0;
+  let max = 0;
+  const tasks = Array.from({ length: 6 }, () => async () => {
+    max = Math.max(max, ++inFlight);
+    await tick();
+    inFlight--;
+  });
+  await runPool(tasks, 1);
+  expect(max).toBe(1);
+});
+
+test("an Infinity limit starts every task at once", async () => {
+  const { state, pending, task } = gate();
+  const run = runPool([0, 1, 2].map(task), Infinity);
+  await tick();
+  expect(state.started).toEqual([0, 1, 2]);
+  for (const p of pending.values()) p.resolve(0);
+  await run;
+});
+
+test("results are in input order, not finishing order", async () => {
+  const delays = [30, 5, 15, 0];
+  const tasks = delays.map((ms, i) => () => new Promise<number>((r) => setTimeout(() => r(i), ms)));
+  const out = await runPool(tasks, 4);
+  expect(out.map((r) => (r.status === "fulfilled" ? r.value : null))).toEqual([0, 1, 2, 3]);
+});
+
+test("a sync throw is a rejection and a plain value is a fulfilment", async () => {
+  const boom = new Error("boom");
+  const out = await runPool<number>(
+    [
+      () => {
+        throw boom;
+      },
+      () => 7,
+    ],
+    1,
+  );
+  expect(out).toEqual([
+    { status: "rejected", reason: boom, attempts: 1 },
+    { status: "fulfilled", value: 7, attempts: 1 },
+  ]);
+});
+
+test("many sync tasks do not overflow the stack or break the limit", async () => {
+  const tasks = Array.from({ length: 20000 }, (_, i) => () => i);
+  const out = await runPool(tasks, 3);
+  expect(out.length).toBe(20000);
+  expect(out[19999]).toEqual({ status: "fulfilled", value: 19999, attempts: 1 });
+});
+
+test("a failing task is called retries + 1 times in all", async () => {
+  let calls = 0;
+  const out = await runPool(
+    [
+      () => {
+        calls++;
+        return Promise.reject(new Error("no"));
+      },
+    ],
+    1,
+    { retries: 2 },
+  );
+  expect(calls).toBe(3);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 3 });
+});
+
+test("retries default to 0, and attempts counts the call that worked", async () => {
+  let calls = 0;
+  const flaky = () => (++calls < 2 ? Promise.reject(new Error("once")) : Promise.resolve("ok"));
+  expect((await runPool([flaky], 1))[0]).toMatchObject({ status: "rejected", attempts: 1 });
+  calls = 0;
+  expect((await runPool([flaky], 1, { retries: 3 }))[0]).toEqual({ status: "fulfilled", value: "ok", attempts: 2 });
+  expect(calls).toBe(2);
+});
+
+test("a retry stays in its slot and does not let another task start", async () => {
+  const started: string[] = [];
+  let inFlight = 0;
+  let max = 0;
+  let failures = 0;
+  const track = (name: string, body: () => Promise<string>) => async () => {
+    started.push(name);
+    max = Math.max(max, ++inFlight);
+    try {
+      return await body();
+    } finally {
+      inFlight--;
+    }
+  };
+  const out = await runPool(
+    [
+      track("a", async () => {
+        await tick();
+        if (failures++ < 2) throw new Error("retry me");
+        return "a";
+      }),
+      track("b", async () => "b"),
+    ],
+    1,
+    { retries: 2 },
+  );
+  expect(started).toEqual(["a", "a", "a", "b"]);
+  expect(max).toBe(1);
+  expect(out[0]).toEqual({ status: "fulfilled", value: "a", attempts: 3 });
+});
+
+test("after abort no task starts; in-flight tasks keep their result; the rest reject with attempts 0", async () => {
+  const ac = new AbortController();
+  const reason = new Error("stop");
+  const { state, pending, task } = gate();
+  const run = runPool([0, 1, 2, 3].map(task), 2, { signal: ac.signal });
+  await tick();
+  ac.abort(reason);
+  pending.get(0)!.resolve(10);
+  pending.get(1)!.reject("own failure");
+  const out = await run;
+  expect(state.started).toEqual([0, 1]);
+  expect(out).toEqual([
+    { status: "fulfilled", value: 10, attempts: 1 },
+    { status: "rejected", reason: "own failure", attempts: 1 },
+    { status: "rejected", reason, attempts: 0 },
+    { status: "rejected", reason, attempts: 0 },
+  ]);
+});
+
+test("a task that aborts while starting stops the tasks after it", async () => {
+  const ac = new AbortController();
+  const called: number[] = [];
+  const out = await runPool(
+    [0, 1, 2].map((i) => () => {
+      called.push(i);
+      if (i === 0) ac.abort("halt");
+      return i;
+    }),
+    3,
+    { signal: ac.signal },
+  );
+  expect(called).toEqual([0]);
+  expect(out.map((r) => r.attempts)).toEqual([1, 0, 0]);
+  expect(out[1]).toEqual({ status: "rejected", reason: "halt", attempts: 0 });
+});
+
+test("abort cancels a pending retry, which rejects with signal.reason and the attempts it made", async () => {
+  const ac = new AbortController();
+  let calls = 0;
+  const out = await runPool(
+    [
+      async () => {
+        calls++;
+        await tick();
+        if (calls === 2) ac.abort("cancelled");
+        throw new Error("fail");
+      },
+    ],
+    1,
+    { retries: 5, signal: ac.signal },
+  );
+  expect(calls).toBe(2);
+  expect(out[0]).toEqual({ status: "rejected", reason: "cancelled", attempts: 2 });
+});
+
+test("an already aborted signal starts nothing and still resolves", async () => {
+  const ac = new AbortController();
+  ac.abort("early");
+  let calls = 0;
+  const out = await runPool([() => ++calls, () => ++calls], 2, { signal: ac.signal });
+  expect(calls).toBe(0);
+  expect(out).toEqual([
+    { status: "rejected", reason: "early", attempts: 0 },
+    { status: "rejected", reason: "early", attempts: 0 },
+  ]);
+});
+
+test("bad limit or retries reject with RangeError before any task starts", async () => {
+  let calls = 0;
+  const t = [() => ++calls];
+  for (const limit of [0, -1, 1.5, NaN, -Infinity, "2" as unknown as number]) {
+    await expect(runPool(t, limit)).rejects.toBeInstanceOf(RangeError);
+  }
+  for (const retries of [-1, 0.5, NaN, Infinity]) {
+    await expect(runPool(t, 1, { retries })).rejects.toBeInstanceOf(RangeError);
+  }
+  expect(calls).toBe(0);
+});
+
+test("never rejects when tasks fail", async () => {
+  const out = await runPool(
+    [() => Promise.reject(1), () => { throw 2; }, null as unknown as () => number],
+    2,
+    { retries: 1 },
+  );
+  expect(out.map((r) => r.status)).toEqual(["rejected", "rejected", "rejected"]);
+  expect(out.map((r) => r.attempts)).toEqual([2, 2, 2]);
+});
