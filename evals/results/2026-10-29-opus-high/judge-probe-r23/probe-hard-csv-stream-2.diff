--- a/csv.ts	2026-10-29 09:45:15.230506363 +0000
+++ b/csv.ts	2026-10-29 09:47:40.982576876 +0000
@@ -50,3 +50,99 @@
   rows.push(row);
   return rows;
 }
+
+type Mode = "fieldStart" | "unquoted" | "quoted" | "quoteInQuoted" | "afterQuote";
+
+/** `parseCsv` for input that comes in chunks: each row is returned once its row end has arrived. */
+export class CsvStream {
+  private started = false;
+  private mode: Mode = "fieldStart";
+  private row: string[] = [];
+  private field = "";
+  private rowOpen = false;
+  private pendingCR = false;
+  private failure: SyntaxError | null = null;
+
+  push(chunk: string): string[][] {
+    if (this.failure) throw this.failure;
+    let i = 0;
+    if (!this.started && chunk.length > 0) {
+      this.started = true;
+      if (chunk[0] === "\uFEFF") i = 1;
+    }
+    const rows: string[][] = [];
+    for (; i < chunk.length; i++) this.char(chunk[i]!, rows);
+    return rows;
+  }
+
+  end(): string[][] {
+    if (this.failure) throw this.failure;
+    if (this.mode === "quoted") throw this.fail("a quoted field is still open at the end of the input");
+    if (this.pendingCR) {
+      this.pendingCR = false;
+      if (this.mode === "afterQuote") throw this.fail('unexpected "\\r" after a closing quote');
+      this.field += "\r";
+    }
+    const rows: string[][] = [];
+    if (this.rowOpen) this.endRow(rows);
+    return rows;
+  }
+
+  private char(c: string, rows: string[][]): void {
+    if (this.pendingCR) {
+      this.pendingCR = false;
+      if (c === "\n") return this.endRow(rows);
+      if (this.mode === "afterQuote") throw this.fail('unexpected "\\r" after a closing quote');
+      this.field += "\r";
+      this.mode = "unquoted";
+    }
+    this.rowOpen = true;
+    if (this.mode === "quoted") {
+      if (c === '"') this.mode = "quoteInQuoted";
+      else this.field += c;
+      return;
+    }
+    if (this.mode === "quoteInQuoted") {
+      if (c === '"') {
+        this.field += '"';
+        this.mode = "quoted";
+        return;
+      }
+      this.mode = "afterQuote";
+    }
+    if (this.mode === "fieldStart") {
+      if (c === '"') {
+        this.mode = "quoted";
+        return;
+      }
+      this.mode = "unquoted";
+    }
+    if (c === ",") return this.endField();
+    if (c === "\n") return this.endRow(rows);
+    if (c === "\r") {
+      this.pendingCR = true;
+      return;
+    }
+    if (this.mode === "afterQuote") throw this.fail(`unexpected ${JSON.stringify(c)} after a closing quote`);
+    if (c === '"') throw this.fail("a quote in a field that is not quoted");
+    this.field += c;
+  }
+
+  private fail(message: string): SyntaxError {
+    this.failure = new SyntaxError(message);
+    return this.failure;
+  }
+
+  private endField(): void {
+    this.row.push(this.field);
+    this.field = "";
+    this.mode = "fieldStart";
+  }
+
+  private endRow(rows: string[][]): void {
+    this.endField();
+    rows.push(this.row);
+    this.row = [];
+    this.rowOpen = false;
+  }
+}
