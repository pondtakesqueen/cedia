--- a/csv.test.ts	2026-10-29 09:45:15.230436684 +0000
+++ b/csv.test.ts	2026-10-29 09:47:37.701091580 +0000
@@ -23,3 +23,98 @@
   expect(s.push("d")).toEqual([]);
   expect(s.end()).toEqual([["c", "d"]]);
 });
+
+function streamed(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows = chunks.flatMap((c) => s.push(c));
+  return rows.concat(s.end());
+}
+
+// Every chunking worth checking: whole, one character at a time, every two-way cut, and empty chunks around the text.
+function chunkings(text: string): string[][] {
+  const cases = [[text], text.split(""), ["", text, ""]];
+  for (let k = 0; k <= text.length; k++) cases.push([text.slice(0, k), text.slice(k)]);
+  return cases;
+}
+
+const inputs = [
+  "",
+  "\uFEFF",
+  "\uFEFFa",
+  "\uFEFF\uFEFFa",
+  "a\n",
+  "\n",
+  "\n\n",
+  "a,",
+  "a,\n",
+  "a\r\nb",
+  "a\rb",
+  "a\r",
+  "\r",
+  "\r\n",
+  '"x""y",z\r\n',
+  '"a\r\nb"',
+  '""',
+  '"",""\n',
+  '"a"\r\n',
+  '"a"\n\n',
+  "a\n\nb",
+  "a\n\uFEFFb",
+];
+
+test("a stream gives the rows parseCsv gives, for every chunking", () => {
+  for (const text of inputs) {
+    for (const chunks of chunkings(text)) {
+      expect(streamed(chunks)).toEqual(parseCsv(text));
+    }
+  }
+});
+
+test("rejected input throws a SyntaxError from push or end, for every chunking", () => {
+  const bad = ['"a"b', '"a"\rb', '"a"\r', '"a"\r"', 'a"b', '"abc', 'a,"b', '"a""', "\"a\"\r\rb", 'a,\r"x"'];
+  for (const text of bad) {
+    expect(() => parseCsv(text)).toThrow(SyntaxError);
+    for (const chunks of chunkings(text)) {
+      expect(() => streamed(chunks)).toThrow(SyntaxError);
+    }
+  }
+});
+
+test("the BOM is dropped only at the very start of the input", () => {
+  const s = new CsvStream();
+  expect(s.push("")).toEqual([]);
+  expect(s.push("\uFEFFa\n")).toEqual([["a"]]);
+  expect(s.end()).toEqual([]);
+  expect(streamed(["a\n", "\uFEFFb"])).toEqual([["a"], ["\uFEFFb"]]);
+});
+
+test("a row comes out as soon as its row end arrives, even when split", () => {
+  const s = new CsvStream();
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\nb")).toEqual([["a"]]);
+  expect(s.end()).toEqual([["b"]]);
+  const q = new CsvStream();
+  expect(q.push('"x"')).toEqual([]);
+  expect(q.push("\n")).toEqual([["x"]]);
+});
+
+test("a chunk ending in a comma keeps the empty field after it", () => {
+  const s = new CsvStream();
+  expect(s.push("a,")).toEqual([]);
+  expect(s.end()).toEqual([["a", ""]]);
+});
+
+test("many small chunks are handled in linear time", () => {
+  const s = new CsvStream();
+  let count = 0;
+  for (let i = 0; i < 200_000; i++) count += s.push("ab,c\n").length;
+  expect(count).toBe(200_000);
+  expect(s.end()).toEqual([]);
+});
+
+test("after a SyntaxError, later push and end calls throw it again", () => {
+  const s = new CsvStream();
+  expect(() => s.push('"a"b')).toThrow(SyntaxError);
+  expect(() => s.end()).toThrow(SyntaxError);
+  expect(() => s.push("\n")).toThrow(SyntaxError);
+});
