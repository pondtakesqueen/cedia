+  const norm = (s: string) => s.trim().replace(/\s+/g, ' ').replace(/ 2>&1$/, '').trim();
+  let cmd = norm(command);
+  const cd = /^cd\s+(\S+|"[^"]*"|'[^']*')\s*&&\s*(.*)$/.exec(cmd);
+  if (cd && cwd !== undefined && resolve(cwd, cd[1]!.replace(/^["']|["']$/g, '')) === resolve(cwd)) cmd = norm(cd[2]!);
+  return checks.find((c) => norm(c) === cmd);
