diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/rules.test.ts b/test/rules.test.ts
--- a/test/rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/rules.test.ts	2026-10-29 10:01:18.263697545 +0000
@@ -0,0 +1,36 @@
+import { expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+test('exactly 10 units of a SKU get the 5% bulk discount', () => {
+  // 10 x 120 = 1200; 5% off = 60; subtotal 1140 < 5000 so shipping 800; tax 7% of 1940 = 135.8 -> 136; total 2076
+  expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+});
+
+test('exactly 50 units of a SKU get the 10% bulk discount', () => {
+  // 50 x 120 = 6000; 10% off = 600; subtotal 5400 >= 5000 so free shipping; tax 7% of 5400 = 378; total 5778
+  expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+});
+
+test('lines of the same SKU are merged before the bulk discount', () => {
+  // 6 + 4 = 10 units of PEN, so the 5% tier applies once to the merged line
+  const t = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+  expect(t.lines.length).toBe(1);
+  expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+});
+
+test('shipping is judged on the amount after the coupon', () => {
+  // 12 x 450 = 5400; bulk 5% = 270 -> 5130; SAVE10 = 513 -> 4617 < 5000 so shipping 800; tax 7% of 5417 = 379.19 -> 379; total 5796
+  expect(totals(cart('US', [['MUG', 12]], 'SAVE10'))).toMatchObject({
+    subtotal: 5130,
+    coupon: 513,
+    shipping: 800,
+    tax: 379,
+    total: 5796,
+  });
+});
+
+test('UK ships free from 4000', () => {
+  // 2 x 2200 = 4400 >= 4000 so free shipping; tax 20% of 4400 = 880; total 5280
+  expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+});
