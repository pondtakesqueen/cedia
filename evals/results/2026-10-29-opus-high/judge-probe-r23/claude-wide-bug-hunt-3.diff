diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/rules.test.ts b/test/rules.test.ts
--- a/test/rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/rules.test.ts	2026-10-29 09:55:35.645119990 +0000
@@ -0,0 +1,60 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { bulkDiscount } from '../src/pricing/discounts/bulk.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('the region table matches the README', () => {
+    expect(REGIONS).toMatchObject({
+      US: { taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 },
+      EU: { taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 },
+      UK: { taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 },
+    });
+  });
+
+  test('UK ships free from 4000', () => {
+    // 2 tees + 1 cap = 4200 >= 4000; tax 20% of 4200 = 840
+    expect(totals(cart('UK', [['TEE', 2], ['CAP', 1]]))).toMatchObject({ subtotal: 4200, shipping: 0, tax: 840, total: 5040 });
+  });
+
+  test('bulk tiers start at exactly 10 and 50 units', () => {
+    expect(bulkDiscount(9, 1080)).toBe(0);
+    expect(bulkDiscount(10, 1200)).toBe(60);
+    expect(bulkDiscount(49, 5880)).toBe(294);
+    expect(bulkDiscount(50, 6000)).toBe(600);
+  });
+
+  test('10 units get 5% off in an order', () => {
+    // 10 pens = 1200, -60 = 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('50 units get 10% off in an order', () => {
+    // 50 pens = 6000, -600 = 5400 >= 5000 ships free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('free shipping is judged on the subtotal after the coupon', () => {
+    // 1 bag + 2 tees = 5200; FLAT5 -> 4700 < 5000 pays 800; tax 7% of 5500 = 385
+    expect(totals(cart('US', [['BAG', 1], ['TEE', 2]], 'FLAT5'))).toMatchObject({
+      subtotal: 5200,
+      coupon: 500,
+      shipping: 800,
+      tax: 385,
+      total: 5885,
+    });
+  });
+
+  test('lines of the same sku are merged before bulk pricing', () => {
+    // 6 + 4 pens = 10 units, same as one line of 10
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    const t = totals(c);
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ sku: 'PEN', quantity: 10, discount: 60, total: 1140 });
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+    // pricing does not change the cart it was given
+    expect(c.lines.map((l) => l.quantity)).toEqual([6, 4]);
+  });
+});
