diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.reader.test.ts b/sse.reader.test.ts
--- a/sse.reader.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.reader.test.ts	2026-10-29 09:59:46.273134888 +0000
@@ -0,0 +1,40 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString } from './sse.ts';
+
+test('breaking out early cancels the underlying body', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'x' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
+
+test('a long line split into many chunks is yielded whole', async () => {
+  const payload = 'y'.repeat(300_000);
+  const out: string[] = [];
+  for await (const m of readSse(streamFromString(`data: ${payload}\n\n`, 100))) out.push(m.data);
+  expect(out).toEqual([payload]);
+});
+
+test('a read error still reaches the caller', async () => {
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+      c.error(new Error('boom'));
+    },
+  });
+  const seen: string[] = [];
+  await expect((async () => {
+    for await (const m of readSse(body)) seen.push(m.data);
+  })()).rejects.toThrow('boom');
+  expect(seen).toEqual(['a']);
+});
