 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+const isShortGroup = (w: string) => w.startsWith('-') && !w.startsWith('--') && w.length > 1;
+const flagName = (w: string) => w.split('=')[0];
+// Contains $, or is ~user/..., so the shell would expand it to a path we cannot see here.
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+const badRmTarget = (p: string, cwd: string) => unresolvable(p) || !insideWorkspace(p, cwd) || sameDir(p, cwd);
+
+const GIT_VALUE_OPTS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+const FORCE_PUSH_FLAGS = new Set(['--force', '--force-with-lease', '--mirror', '--delete', '--prune']);
+
+function gitHit(argv: string[]): Hit | undefined {
+  let i = 1;
+  while (i < argv.length && argv[i].startsWith('-')) i += GIT_VALUE_OPTS.has(argv[i]) ? 2 : 1;
+  const sub = argv[i];
+  const rest = argv.slice(i + 1);
+  if (sub === 'push' && rest.some((w) => FORCE_PUSH_FLAGS.has(flagName(w)) || (isShortGroup(w) && /[fd]/.test(w)) || (!w.startsWith('-') && /^[+:]/.test(w))))
+    return { name: 'force-push', reason: 'git push --force rewrites remote history' };
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean') {
+    if (rest.some((w) => w === '-n' || w === '--dry-run')) return undefined;
+    if (rest.some((w) => flagName(w) === '--force' || (isShortGroup(w) && w.includes('f'))))
+      return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  }
+  return undefined;
+}
+
+function rmHit(argv: string[], cwd: string): Hit | undefined {
+  let recursive = false;
+  let afterDashDash = false;
+  const targets: string[] = [];
+  for (const w of argv.slice(1)) {
+    if (afterDashDash || !w.startsWith('-')) targets.push(w);
+    else if (w === '--') afterDashDash = true;
+    else if (w === '--recursive' || (isShortGroup(w) && /[rR]/.test(w))) recursive = true;
+  }
+  if (!recursive) return undefined;
+  if (targets.length === 0 || targets.some((t) => badRmTarget(t, cwd)))
+    return { name: 'rm-outside', reason: 'recursive rm outside the working directory' };
+  return undefined;
+}
+
+function findHit(argv: string[], cwd: string): Hit | undefined {
+  if (!argv.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const end = argv.findIndex((w, j) => j > 0 && w.startsWith('-'));
+  const starts = end < 0 ? argv.slice(1) : argv.slice(1, end);
+  if (starts.length === 0) starts.push('.');
+  if (starts.some((p) => unresolvable(p) || !insideWorkspace(p, cwd)))
+    return { name: 'rm-outside', reason: 'find deletes or execs outside the working directory' };
+  return undefined;
+}
