diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/rules.test.ts b/test/rules.test.ts
--- a/test/rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/rules.test.ts	2026-10-29 10:02:38.409145121 +0000
@@ -0,0 +1,63 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('UK free shipping starts at 4000', () => {
+    // 2 bags = 4400 >= 4000; tax 20% of 4400 = 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+
+  test('bulk discount applies at exactly 10 units', () => {
+    // 10 pens = 1200, 5% off = 60 -> 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('bulk discount is the 10% tier at exactly 50 units', () => {
+    // 50 pens = 6000, 10% off = 600 -> 5400; free shipping; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('shipping threshold is checked after the coupon', () => {
+    // 2 bags + 2 mugs = 5300; FLAT5 -> 4800 < 5000, so shipping 800; tax 7% of 5600 = 392
+    expect(totals(cart('US', [['BAG', 2], ['MUG', 2]], 'FLAT5'))).toMatchObject({ subtotal: 5300, coupon: 500, shipping: 800, tax: 392, total: 5992 });
+  });
+
+  test('lines of the same SKU count toward bulk tiers together', () => {
+    const t = totals(cart('US', [['PEN', 5], ['PEN', 5]]));
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ sku: 'PEN', quantity: 10 });
+  });
+
+  test('UK shipping is free at exactly 4000 and charged at 3910', () => {
+    // 1 bag + 4 mugs = 4000 >= 4000; tax 20% of 4000 = 800
+    expect(totals(cart('UK', [['BAG', 1], ['MUG', 4]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+    // 1 bag + 3 mugs + 3 pens = 3910 < 4000; shipping 700; tax 20% of (3910 + 700) = 922
+    expect(totals(cart('UK', [['BAG', 1], ['MUG', 3], ['PEN', 3]]))).toMatchObject({ subtotal: 3910, shipping: 700, tax: 922, total: 5532 });
+    // 1 bag + 3 mugs + 4 pens = 4030 >= 4000; tax 20% of 4030 = 806
+    expect(totals(cart('UK', [['BAG', 1], ['MUG', 3], ['PEN', 4]]))).toMatchObject({ subtotal: 4030, shipping: 0, tax: 806, total: 4836 });
+  });
+
+  test('US free shipping applies when the coupon lands exactly on 5000', () => {
+    // 2 mugs + 2 caps + 1 bag = 5500; FLAT5 -> 5000 >= 5000; tax 7% of 5000 = 350
+    expect(totals(cart('US', [['MUG', 2], ['CAP', 2], ['BAG', 1]], 'FLAT5'))).toMatchObject({ subtotal: 5500, coupon: 500, shipping: 0, tax: 350, total: 5350 });
+  });
+
+  test('no bulk discount at 9 units; 5% tier at 49 units', () => {
+    // 9 pens = 1080, no discount; shipping 800; tax 7% of 1880 = 131.6 -> 132
+    expect(totals(cart('US', [['PEN', 9]]))).toMatchObject({ subtotal: 1080, shipping: 800, tax: 132, total: 2012 });
+    // 49 pens = 5880, 5% off = 294 -> 5586; free shipping; tax 7% of 5586 = 391.02 -> 391
+    expect(totals(cart('US', [['PEN', 49]]))).toMatchObject({ subtotal: 5586, shipping: 0, tax: 391, total: 5977 });
+  });
+
+  test('non-adjacent same-SKU lines merge, and other SKUs are not discounted', () => {
+    // PEN 6 + PEN 4 = PEN 10 -> 1200 - 5% = 1140; MUG 1 = 450; subtotal 1590; shipping 800; tax 7% of 2390 = 167.3 -> 167
+    const t = totals(cart('US', [['PEN', 6], ['MUG', 1], ['PEN', 4]]));
+    expect(t).toMatchObject({ subtotal: 1590, shipping: 800, tax: 167, total: 2557 });
+    expect(t.lines).toHaveLength(2);
+    expect(t.lines[0]).toMatchObject({ sku: 'PEN', quantity: 10, discount: 60, total: 1140 });
+    expect(t.lines[1]).toMatchObject({ sku: 'MUG', quantity: 1, discount: 0, total: 450 });
+  });
+});
