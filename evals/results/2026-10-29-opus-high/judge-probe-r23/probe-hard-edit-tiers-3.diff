 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: nu, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (old === nu) return { error: 'old_text and new_text are the same' };
+
+  const strip = (s: string) => (s.endsWith('\n') ? s.slice(0, -1) : s);
+  const lineAt = (i: number) => content.slice(0, i).split('\n').length;
+  const hits: number[] = [];
+  for (let i = content.indexOf(old); i !== -1; i = content.indexOf(old, i + old.length)) hits.push(i);
+  if (hits.length > 1 && !replace_all) {
+    return { error: `old_text matches ${hits.length} places (first at line ${lineAt(hits[0])}); add context or use replace_all` };
+  }
+  if (hits.length > 0) {
+    const from = lineAt(hits[0]);
+    const to = from + strip(old).split('\n').length - 1;
+    const next = replace_all
+      ? content.split(old).join(nu)
+      : content.slice(0, hits[0]) + nu + content.slice(hits[0] + old.length);
+    return { content: next, applied: { from, to, tier: 'exact', count: hits.length } };
+  }
+
+  const oldLines = strip(old).split('\n');
+  const newBody = strip(nu);
+  const newLines = newBody === '' ? [] : newBody.split('\n');
+  const lines = content.split('\n');
+  // a trailing newline leaves an empty last element that is not a line of content
+  const lineCount = lines[lines.length - 1] === '' ? lines.length - 1 : lines.length;
+  const indentOf = (s: string) => s.match(/^\s*/)![0];
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', s => s.trimEnd()],
+    ['indentation', s => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const want = oldLines.map(norm);
+    const starts: number[] = [];
+    for (let i = 0; i + oldLines.length <= lineCount; i++) {
+      if (want.every((w, j) => norm(lines[i + j]) === w)) starts.push(i);
+    }
+    if (starts.length > 1) {
+      return { error: `old_text matches ${starts.length} places (at lines ${starts.map(i => i + 1).join(', ')}); add context` };
+    }
+    if (starts.length === 1) {
+      const i = starts[0];
+      let repl = newLines;
+      if (tier === 'indentation') {
+        const oldIndent = indentOf(oldLines.find(s => s.trim() !== '') ?? '');
+        const fileIndent = indentOf(lines.slice(i, i + oldLines.length).find(s => s.trim() !== '') ?? '');
+        repl = newLines.map(l => (l.trim() === '' ? l : fileIndent + (l.startsWith(oldIndent) ? l.slice(oldIndent.length) : l.trimStart())));
+      }
+      const next = [...lines.slice(0, i), ...repl, ...lines.slice(i + oldLines.length)].join('\n');
+      return { content: next, applied: { from: i + 1, to: i + oldLines.length, tier, count: 1 } };
+    }
+  }
+
+  const first = oldLines.find(s => s.trim() !== '')?.trim() ?? '';
+  const appears = first === '' ? [] : lines.flatMap((s, i) => (s.includes(first) ? [i + 1] : [])).slice(0, 5);
+  return { error: 'old_text not found' + (appears.length ? `; first line appears at line ${appears.join(', ')}` : '') };
 }
