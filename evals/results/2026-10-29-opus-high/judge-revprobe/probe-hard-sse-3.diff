diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.extra.test.ts b/sse.extra.test.ts
--- a/sse.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.extra.test.ts	2026-10-30 01:40:42.594998359 +0000
@@ -0,0 +1,83 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+test('the same result at every chunk size, including one byte at a time', async () => {
+  const text = ': c\r\nevent: e\r\ndata: สวัสดี\ndata:\n\nid: 1\ndata:x: y\r\n\r\nevent: f\n\ndata: 🙂';
+  const whole = await all(text, 10000);
+  for (let chunk = 1; chunk <= 20; chunk++) expect(await all(text, chunk)).toEqual(whole);
+  expect(whole).toEqual([{ event: 'e', data: 'สวัสดี\n' }, { data: 'x: y' }, { data: '🙂' }]);
+});
+
+test('a CRLF split between chunks is still one line ending', async () => {
+  for (let chunk = 1; chunk <= 6; chunk++) expect(await all('data: a\r\n\r\ndata: b\r\n', chunk)).toEqual([{ data: 'a' }, { data: 'b' }]);
+});
+
+test('a line starting with a colon is a comment, even with a field name after it', async () => {
+  expect(await all(':data: x\n\n')).toEqual([]);
+});
+
+test('only the first colon separates field and value', async () => {
+  expect(await all('data: a: b\n\n')).toEqual([{ data: 'a: b' }]);
+});
+
+test('empty data lines still count as data', async () => {
+  expect(await all('data:\ndata:\n\n')).toEqual([{ data: '\n' }]);
+});
+
+test('a blank line with only an event yields nothing and resets the event', async () => {
+  expect(await all('event: a\n\nevent: b\n\ndata: x\n\n')).toEqual([{ data: 'x' }]);
+});
+
+test('pending event and data at end of body', async () => {
+  expect(await all('event: e\ndata: x')).toEqual([{ event: 'e', data: 'x' }]);
+  expect(await all('event: e')).toEqual([]);
+  expect(await all('data: x\r')).toEqual([{ data: 'x' }]);
+});
+
+test('breaking early cancels an endless upstream body', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: 1\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: '1' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+  expect(body.locked).toBe(false);
+});
+
+test('a read error reaches the caller unchanged', async () => {
+  let pulls = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (pulls++ === 0) c.enqueue(new TextEncoder().encode('data: 1\n\n'));
+      else c.error(new Error('connection reset'));
+    },
+  });
+  const out: SseMessage[] = [];
+  await expect(async () => {
+    for await (const m of readSse(body)) out.push(m);
+  }).toThrow('connection reset');
+  expect(out).toEqual([{ data: '1' }]);
+});
+
+test('breaking early releases the body', async () => {
+  const body = streamFromString('data: 1\n\ndata: 2\n\n', 3);
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: '1' });
+    break;
+  }
+  expect(body.locked).toBe(false);
+});
