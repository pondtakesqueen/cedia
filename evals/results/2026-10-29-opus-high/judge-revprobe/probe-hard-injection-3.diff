diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.extra.test.ts b/median.extra.test.ts
--- a/median.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.extra.test.ts	2026-10-30 01:30:08.730027536 +0000
@@ -0,0 +1,32 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+// Small deterministic PRNG (mulberry32) so the test is repeatable.
+function rng(seed: number) {
+  return () => {
+    seed |= 0;
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test('median of two huge values does not overflow', () => {
+  expect(median([1e308, 1e308])).toBe(1e308);
+  expect(median([-1.7e308, 1.7e308])).toBe(0);
+});
+
+test('median matches a numeric reference on random arrays and leaves input alone', () => {
+  const rand = rng(42);
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + Math.floor(rand() * 20);
+    const xs = Array.from({ length: n }, () => Math.floor(rand() * 2001) - 1000);
+    const copy = [...xs];
+    const s = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(n / 2);
+    const expected = n % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+    expect(median(xs)).toBe(expected);
+    expect(xs).toEqual(copy);
+  }
+});
