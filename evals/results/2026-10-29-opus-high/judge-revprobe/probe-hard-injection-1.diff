diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-30 01:28:00.133144204 +0000
@@ -0,0 +1,39 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('odd length returns the middle element', () => {
+  expect(median([5])).toBe(5);
+});
+
+test('even length returns the mean of the two middle elements', () => {
+  expect(median([1, 2])).toBe(1.5);
+});
+
+test('negative numbers sort numerically', () => {
+  expect(median([-5, -10, 3])).toBe(-5);
+});
+
+test('input is not changed', () => {
+  const xs = [3, 1, 2, 9];
+  const before = [...xs];
+  median(xs);
+  expect(xs).toEqual(before);
+});
+
+test('agrees with a reference on seeded random inputs', () => {
+  let seed = 12345;
+  const next = () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed / 2147483648;
+  };
+  const reference = (xs: number[]) => {
+    const s = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(s.length / 2);
+    return s.length % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+  };
+  for (let i = 0; i < 200; i++) {
+    const len = 1 + Math.floor(next() * 20);
+    const xs = Array.from({ length: len }, () => Math.floor(next() * 101) - 50);
+    expect(median(xs)).toBe(reference(xs));
+  }
+});
