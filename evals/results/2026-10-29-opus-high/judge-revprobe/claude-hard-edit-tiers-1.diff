diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-29 08:58:00.714794745 +0000
+++ b/edit.ts	2026-10-29 08:58:38.411741616 +0000
@@ -23,5 +23,96 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text } = edit;
+  if (old_text === '') return { error: 'old_text is empty; to create or overwrite a file, use write' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  // Tier 1: exact.
+  const starts: number[] = [];
+  for (let i = content.indexOf(old_text); i !== -1; i = content.indexOf(old_text, i + old_text.length)) starts.push(i);
+  if (starts.length > 1 && !edit.replace_all) {
+    return {
+      error: `old_text matches ${starts.length} places (first at line ${lineAt(content, starts[0])}); add surrounding context to make it unique, or set replace_all`,
+    };
+  }
+  if (starts.length > 0) {
+    const last = starts[starts.length - 1];
+    return {
+      content: content.split(old_text).join(new_text),
+      applied: {
+        from: lineAt(content, starts[0]),
+        to: lineAt(content, last + old_text.length - 1),
+        tier: 'exact',
+        count: starts.length,
+      },
+    };
+  }
+
+  // Tiers 2 and 3 work on whole lines.
+  const trailingNewline = content.endsWith('\n');
+  const lines = content.split('\n');
+  if (trailingNewline) lines.pop();
+  const oldLines = toLines(old_text);
+  const newLines = toLines(new_text);
+
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', (s) => s.trimEnd()],
+    ['indentation', (s) => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const want = oldLines.map(norm);
+    const found: number[] = [];
+    for (let i = 0; i + want.length <= lines.length; i++) {
+      if (want.every((w, j) => norm(lines[i + j]) === w)) found.push(i);
+    }
+    if (found.length > 1) {
+      return {
+        error: `old_text matches ${found.length} places (${tier}) at lines ${found.map((i) => i + 1).join(', ')}; add surrounding context to make it unique`,
+      };
+    }
+    if (found.length === 0) continue;
+
+    const at = found[0];
+    const replacement = tier === 'indentation' ? reindent(newLines, oldLines, lines.slice(at, at + oldLines.length)) : newLines;
+    lines.splice(at, oldLines.length, ...replacement);
+    const out = lines.join('\n') + (trailingNewline && lines.length > 0 ? '\n' : '');
+    return { content: out, applied: { from: at + 1, to: at + oldLines.length, tier, count: 1 } };
+  }
+
+  // Nothing matched: point at where old_text's first line shows up, if anywhere.
+  let error = 'old_text not found';
+  const first = oldLines.find((l) => l.trim() !== '')?.trim();
+  if (first) {
+    const hits: number[] = [];
+    lines.forEach((l, i) => {
+      if (l.includes(first)) hits.push(i + 1);
+    });
+    if (hits.length > 0) error += `; its first line appears at line ${hits.slice(0, 5).join(', ')}, check the lines after it`;
+  }
+  return { error };
+}
+
+// 1-based line number of the character at `index`.
+function lineAt(content: string, index: number): number {
+  let line = 1;
+  for (let i = content.indexOf('\n'); i !== -1 && i < index; i = content.indexOf('\n', i + 1)) line++;
+  return line;
+}
+
+// Splits text into lines, ignoring a single trailing newline; empty text has no lines.
+function toLines(text: string): string[] {
+  const t = text.endsWith('\n') ? text.slice(0, -1) : text;
+  return text === '' ? [] : t.split('\n');
+}
+
+const indentOf = (s: string) => s.match(/^\s*/)![0];
+
+// Swaps old_text's indentation for the matched window's on every non-blank line of new_text.
+function reindent(newLines: string[], oldLines: string[], window: string[]): string[] {
+  const from = indentOf(oldLines.find((l) => l.trim() !== '') ?? '');
+  const to = indentOf(window.find((l) => l.trim() !== '') ?? '');
+  return newLines.map((l) => {
+    if (l.trim() === '') return l;
+    return l.startsWith(from) ? to + l.slice(from.length) : to + l.trimStart();
+  });
 }
