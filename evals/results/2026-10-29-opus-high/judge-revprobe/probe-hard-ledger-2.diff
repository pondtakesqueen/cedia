+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+let n = 0;
+const bash = (command: string, exitCode = 0, status: 'completed' | 'failed' | 'denied' | 'not_started' = exitCode ? 'failed' : 'completed'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool: 'bash', input: { command } },
+    { kind: 'tool_result', callId, status, output: { isError: exitCode !== 0, exitCode } },
+  ];
+};
+const edit = (path: string, status: 'completed' | 'failed' = 'completed'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool: 'edit', input: { path } },
+    { kind: 'tool_result', callId, status, output: { isError: status !== 'completed' } },
+  ];
+};
+const idOf = (events: SessionEvent[]) => (events[0]!.kind === 'tool_intent' ? events[0]!.callId : '');
+
+describe('matchCheck rules', () => {
+  test('whitespace is collapsed on both sides and the check is returned as written', () => {
+    expect(matchCheck('bun\ttest', [' bun  test '])).toBe(' bun  test ');
+  });
+
+  test('only one trailing 2>&1 is dropped', () => {
+    expect(matchCheck('bun test 2>&1 2>&1', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test', ['bun test 2>&1 2>&1'])).toBeUndefined();
+  });
+
+  test('one trailing 2>&1 is dropped even after a cd prefix', () => {
+    expect(matchCheck('cd /work/repo && bun test 2>&1 2>&1', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /work/repo && bun test 2>&1', ['bun test'], cwd)).toBe('bun test');
+  });
+
+  test('a pipe or a chain is not the check', () => {
+    expect(matchCheck('bun test; true', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test || x', ['bun test'])).toBeUndefined();
+  });
+
+  test('a cd to the working directory is removed, quotes stripped; a cd elsewhere is not', () => {
+    expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd .. && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd "/work/repo\' && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+
+  test('without a cwd, a leading cd is never removed', () => {
+    expect(matchCheck('cd . && bun test', ['bun test'])).toBeUndefined();
+  });
+});
+
+describe('ledgerEntries rules', () => {
+  test('only intents since the last request pair with a result', () => {
+    const [intent, result] = edit('a.ts');
+    expect(ledgerEntries([intent!, { kind: 'request' }, result!], [])).toEqual([]);
+    const again = { ...intent!, input: { path: 'b.ts' } } as SessionEvent;
+    expect(ledgerEntries([intent!, { kind: 'request' }, again, result!], [])).toEqual([
+      { kind: 'write', at: 3, tool: 'edit', path: 'b.ts' },
+    ]);
+  });
+
+  test('a denied bash with a snapshot is still not a write', () => {
+    const denied = bash('rm -rf build', 0, 'denied');
+    const events: SessionEvent[] = [...denied, { kind: 'snapshot', callId: idOf(denied), changed: ['build/x'] }];
+    expect(ledgerEntries(events, [])).toEqual([]);
+  });
+
+  test('a snapshot after the result still applies, even across a later request', () => {
+    const w = bash('sed -i s/a/b/ x.ts');
+    const events: SessionEvent[] = [...w, { kind: 'request' }, { kind: 'snapshot', callId: idOf(w), changed: ['x.ts'] }];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', path: 'x.ts' }]);
+  });
+
+  test('a snapshot overrides the edit path', () => {
+    const e = edit('a.ts');
+    expect(ledgerEntries([...e, { kind: 'snapshot', callId: idOf(e), changed: ['b.ts'] }], [])).toEqual([
+      { kind: 'write', at: 1, tool: 'edit', path: 'b.ts' },
+    ]);
+  });
+
+  test('a failed non-read-only bash is a write with a command', () => {
+    expect(ledgerEntries(bash('make', 2), [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'make' }]);
+  });
+
+  test('read-only commands are not writes; a redirect is', () => {
+    expect(ledgerEntries([...bash('git status'), ...bash('cat x')], [])).toEqual([]);
+    expect(ledgerEntries(bash('echo x > f'), [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'echo x > f' }]);
+  });
+
+  test('exitCode comes from the output when present', () => {
+    const [intent, result] = bash('bun test', 3);
+    expect(ledgerEntries([intent!, result!], ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 3 }]);
+  });
+});
+
+describe('evidence and verified rules', () => {
+  const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+  const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+  test('changed and unverified are deduped, first seen first', () => {
+    const e = evidence([w(1, 'a.ts'), w(2, 'a.ts'), w(3, 'b.ts'), w(4, 'a.ts')]);
+    expect(e.changed).toEqual(['a.ts', 'b.ts']);
+    expect(e.unverified).toEqual(['a.ts', 'b.ts']);
+  });
+
+  test('unverified covers every write when no check passed', () => {
+    expect(evidence([c(1, 1), w(2, 'a.ts'), c(3, 2)]).unverified).toEqual(['a.ts']);
+    expect(evidence([w(1, 'a.ts'), c(2, 1)]).unverified).toEqual(['a.ts']);
+  });
+
+  test('verified is true with no declared checks even if checks failed', () => {
+    expect(verified([w(1, 'a.ts'), c(2, 1)], [])).toBe(true);
+  });
+
+  test('a pass followed by a fail after the last write is verified, as evidence agrees', () => {
+    const entries = [w(1, 'a.ts'), c(2, 0), c(3, 1)];
+    expect(verified(entries, ['bun test'])).toBe(true);
+    expect(evidence(entries).unverified).toEqual([]);
+  });
+
+  test('evidence and verified agree on generated logs', () => {
+    let seed = 42;
+    const rand = (k: number) => {
+      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+      return seed % k;
+    };
+    for (let round = 0; round < 500; round++) {
+      const len = rand(9);
+      const entries: LedgerEntry[] = [];
+      for (let at = 0; at < len; at++) entries.push(rand(2) === 0 ? w(at, 'f.ts') : c(at, rand(2)));
+      if (!entries.some((e) => e.kind === 'write')) continue;
+      expect(evidence(entries).unverified.length === 0).toBe(verified(entries, ['x']));
+    }
+  });
+});
