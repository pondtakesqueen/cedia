diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.extra.test.ts b/deny.extra.test.ts
--- a/deny.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.extra.test.ts	2026-10-30 01:23:58.289113455 +0000
@@ -0,0 +1,71 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('git: path in argv[0], global options and their values', () => {
+  expect(hit('/usr/bin/git push -f')).toBe('force-push');
+  expect(hit('git -C push status')).toBeUndefined(); // `push` is the value of -C
+  expect(hit('git --namespace x push -f')).toBe('force-push');
+  expect(hit('git --git-dir=.git push -f')).toBe('force-push');
+});
+
+test('git push: long flags need the exact name', () => {
+  for (const f of ['--force', '--force-with-lease', '--mirror', '--delete', '--prune']) {
+    expect(hit(`git push ${f}`)).toBe('force-push');
+    expect(hit(`git push ${f}=x`)).toBe('force-push');
+  }
+  expect(hit('git push --forceful')).toBeUndefined();
+  expect(hit('git push -df')).toBe('force-push');
+});
+
+test('git: refspec rules only for push', () => {
+  expect(hit('git log +x')).toBeUndefined();
+  expect(hit('git push origin +main')).toBe('force-push');
+});
+
+test('git reset and clean details', () => {
+  expect(hit('git reset --mixed')).toBeUndefined();
+  expect(hit('git clean --force --dry-run')).toBeUndefined();
+  expect(hit('git clean -fn')).toBe('clean-force');
+});
+
+test('rm: only recursive removal is checked', () => {
+  expect(hit('rm /')).toBeUndefined();
+  expect(hit('rm -R /')).toBe('rm-outside');
+});
+
+test('rm: flags after -- are targets, and -- may be absent', () => {
+  expect(hit('rm -r -- ./x')).toBeUndefined();
+  expect(hit('rm -r')).toBe('rm-outside');
+  expect(hit('rm -r -')).toBe('rm-outside'); // lone - is a flag before any --, so no targets
+});
+
+test('rm: unresolvable and cwd-itself targets are denied', () => {
+  expect(hit('rm -r a$b')).toBe('rm-outside');
+  expect(hit('rm -r ~x')).toBe('rm-outside');
+  expect(hit('rm -r ./')).toBe('rm-outside');
+  expect(hit('rm -r /work/repo/')).toBe('rm-outside');
+  expect(hit('rm -r src/*')).toBeUndefined();
+});
+
+test('find: start paths and actions', () => {
+  expect(hit('find -exec x ;')).toBeUndefined(); // no start path means `.`
+  expect(hit('find /work/repo -delete')).toBeUndefined();
+  expect(hit('find ~u -delete')).toBe('rm-outside');
+  expect(hit('find / -print')).toBeUndefined();
+});
+
+test('find denies exactly the start paths outside the workspace; rm also denies cwd itself', () => {
+  for (const p of ['a', './a', '../a', '/work/repo/a', '/x', '.', '..', '/work/repo', '~', '~/a', '*']) {
+    expect([p, hit(`find ${p} -delete`)]).toEqual([p, insideWorkspace(p, cwd) ? undefined : 'rm-outside']);
+    expect([p, hit(`rm -r ${p}`)]).toEqual([p, insideWorkspace(p, cwd) && !sameDir(p, cwd) ? undefined : 'rm-outside']);
+  }
+});
+
+test('other commands pass', () => {
+  expect(denyListed(['ls'], cwd)).toBeUndefined();
+  expect(denyListed([], cwd)).toBeUndefined();
+  expect(hit('gitx push -f')).toBeUndefined();
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.ts b/deny.ts
--- a/deny.ts	2026-10-30 01:22:50.441226040 +0000
+++ b/deny.ts	2026-10-30 01:23:58.269679573 +0000
@@ -36,5 +36,56 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  const cmd = base(argv[0] ?? '');
+  if (cmd === 'git') return gitHit(argv.slice(1));
+  if (cmd === 'rm') return rmHit(argv.slice(1), cwd);
+  if (cmd === 'find') return findHit(argv.slice(1), cwd);
+  return undefined;
+}
+
+const base = (word: string) => word.slice(word.lastIndexOf('/') + 1);
+
+// A short flag group (-fu, -df) containing one of `chars`; long flags such as --force do not count.
+const shortHas = (word: string, chars: string) => /^-[^-]/.test(word) && [...chars].some((c) => word.includes(c));
+
+// A path that cannot be known before the command runs: a variable, or ~user.
+const unresolvable = (path: string) => path.includes('$') || (path.startsWith('~') && path !== '~' && !path.startsWith('~/'));
+
+const outside = (path: string, cwd: string) => unresolvable(path) || !insideWorkspace(path, cwd);
+
+const GIT_VALUE_OPTIONS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+
+function gitHit(words: string[]): Hit | undefined {
+  let i = 0;
+  while (i < words.length && words[i].startsWith('-')) i += GIT_VALUE_OPTIONS.has(words[i]) ? 2 : 1;
+  const sub = words[i];
+  const args = words.slice(i + 1);
+  if (sub === 'push') {
+    const word = args.find(
+      (w) => /^--(force|force-with-lease|mirror|delete|prune)(=|$)/.test(w) || shortHas(w, 'fd') || (!w.startsWith('-') && /^[+:]/.test(w)),
+    );
+    if (word !== undefined) return { name: 'force-push', reason: `git push ${word} rewrites or deletes remote refs` };
+  }
+  if (sub === 'reset' && args.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean' && (args.includes('--force') || args.some((w) => shortHas(w, 'f'))) && !args.some((w) => w === '-n' || w === '--dry-run'))
+    return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  return undefined;
+}
+
+function rmHit(words: string[], cwd: string): Hit | undefined {
+  const dd = words.indexOf('--');
+  const opts = dd < 0 ? words : words.slice(0, dd);
+  const targets = [...opts.filter((w) => !w.startsWith('-')), ...(dd < 0 ? [] : words.slice(dd + 1))];
+  if (!opts.some((w) => w === '--recursive' || shortHas(w, 'rR'))) return undefined;
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets (they may come from xargs)' };
+  const bad = targets.find((p) => outside(p, cwd) || sameDir(p, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `rm -r target outside workspace: ${bad}` };
+}
+
+function findHit(words: string[], cwd: string): Hit | undefined {
+  if (!words.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const end = words.findIndex((w) => w.startsWith('-'));
+  const starts = end < 0 ? words : words.slice(0, end);
+  const bad = (starts.length ? starts : ['.']).find((p) => outside(p, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `find deletes or runs commands under outside workspace: ${bad}` };
 }
