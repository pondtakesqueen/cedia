 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text, replace_all } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  // 1. exact
+  const offsets: number[] = [];
+  for (let at = content.indexOf(old_text); at !== -1; at = content.indexOf(old_text, at + old_text.length)) offsets.push(at);
+  const lineOf = (at: number) => 1 + countNewlines(content.slice(0, at));
+  if (offsets.length > 1 && !replace_all) return ambiguous(offsets.map(lineOf), 'exact');
+  if (offsets.length > 0) {
+    const at = offsets[0];
+    const from = lineOf(at);
+    const updated = replace_all
+      ? content.split(old_text).join(new_text)
+      : content.slice(0, at) + new_text + content.slice(at + old_text.length);
+    return { content: updated, applied: { from, to: from + countNewlines(strip1(old_text)), tier: 'exact', count: offsets.length } };
+  }
+
+  // 2-3. whole lines, ignoring trailing space, then indentation
+  const trailingNewline = content.endsWith('\n');
+  const lines = content === '' ? [] : (trailingNewline ? content.slice(0, -1) : content).split('\n');
+  const join = (ls: string[]) => ls.join('\n') + (trailingNewline && ls.length > 0 ? '\n' : '');
+  const oldLines = strip1(old_text).split('\n');
+  const newLines = strip1(new_text) === '' ? [] : strip1(new_text).split('\n');
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', (s) => s.trimEnd()],
+    ['indentation', (s) => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const want = oldLines.map(norm);
+    const starts: number[] = [];
+    for (let i = 0; i + want.length <= lines.length; i++) {
+      if (want.every((w, k) => norm(lines[i + k]) === w)) starts.push(i);
+    }
+    if (starts.length > 1) return ambiguous(starts.map((i) => i + 1), tier);
+    if (starts.length === 1) {
+      const i = starts[0];
+      const replacement = tier === 'trailing-space' ? newLines : reindent(newLines, oldLines, lines.slice(i, i + want.length));
+      lines.splice(i, want.length, ...replacement);
+      return { content: join(lines), applied: { from: i + 1, to: i + want.length, tier, count: 1 } };
+    }
+  }
+
+  const first = oldLines.find((l) => l.trim() !== '')?.trim();
+  const hits = first ? lines.flatMap((l, idx) => (l.includes(first) ? [idx + 1] : [])).slice(0, 5) : [];
+  return { error: `old_text not found${hits.length > 0 ? `; first line appears at line ${hits.join(', ')}` : ''}` };
 }
