--- a/edit.ts	2026-10-30 01:25:32.642768665 +0000
+++ b/edit.ts	2026-10-30 01:26:49.267017419 +0000
@@ -3,6 +3,26 @@
 // from/to are 1-based line numbers of the replaced text in the original content; count is how many places were replaced.
 export type Applied = { from: number; to: number; tier: Tier; count: number };
 
+const strip1 = (s: string) => (s.endsWith('\n') ? s.slice(0, -1) : s);
+const countNewlines = (s: string) => s.split('\n').length - 1;
+const indentOf = (s: string) => s.slice(0, s.length - s.trimStart().length);
+
+// Reports several matches, with their 1-based lines.
+function ambiguous(lines: number[], tier: Tier): { error: string } {
+  return { error: `old_text matches ${lines.length} places (at line ${lines.join(', ')}); add more context${tier === 'exact' ? ' or set replace_all' : ''}` };
+}
+
+// Re-indents new_text lines from old_text's indentation to the matched window's indentation.
+function reindent(newLines: string[], oldLines: string[], window: string[]): string[] {
+  const oldIndent = indentOf(oldLines.find((l) => l.trim() !== '') ?? '');
+  const fileIndent = indentOf(window.find((l) => l.trim() !== '') ?? '');
+  return newLines.map((l) => {
+    if (l.trim() === '') return '';
+    if (l.startsWith(oldIndent)) return fileIndent + l.slice(oldIndent.length);
+    return fileIndent + l.trimStart();
+  });
+}
+
 // Applies one edit to `content`.
 //
 // Tiers, tried in order; a tier applies only when it finds exactly one place (or replace_all is set, exact tier only):
