diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-30 01:27:03.171017101 +0000
@@ -0,0 +1,62 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+
+describe('rules not covered by edit.test.ts', () => {
+  test('replace_all falls through to a line tier when there is no exact match', () => {
+    const r = ok(applyEdit('a  \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }));
+    expect(r.applied).toEqual({ from: 1, to: 2, tier: 'trailing-space', count: 1 });
+    expect(r.content).toBe('c\n');
+  });
+  test('one trailing newline on old_text is not a line of its own', () => {
+    const r = ok(applyEdit('a\nb\nc\n', { old_text: 'b\n', new_text: 'B' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+    expect(r.content).toBe('a\nBc\n');
+  });
+  test('tier 2 deletion leaves no empty line', () => {
+    const r = ok(applyEdit('a  \nb\nc\n', { old_text: 'a\nb', new_text: '' }));
+    expect(r.content).toBe('c\n');
+  });
+  test('tier 3 ambiguity names the lines', () => {
+    const r = applyEdit('  x\ny\n\tx\ny\n', { old_text: 'x\ny', new_text: 'z' });
+    expect('error' in r && r.error).toContain('matches 2 places');
+    expect('error' in r && r.error).toContain('1, 3');
+  });
+  test('not found lists at most five lines', () => {
+    const r = applyEdit('q\nq\nq\nq\nq\nq\nq\n', { old_text: 'q\nzzz', new_text: 'x' });
+    expect('error' in r && r.error).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect('error' in r && r.error).not.toContain('6');
+  });
+  test('content without a trailing newline stays without one', () => {
+    const r = ok(applyEdit('a  \nb', { old_text: 'a\nb', new_text: 'c' }));
+    expect(r.content).toBe('c');
+  });
+});
+
+describe('agreement with splicing lines by hand', () => {
+  const base = ['l0', 'l1', 'l2', 'l3', 'l4', 'l5'];
+  const slices: [number, number][] = [];
+  for (let i = 0; i < base.length; i++) for (let j = i + 1; j <= base.length; j++) slices.push([i, j]);
+
+  test('exact tier', () => {
+    for (const [i, j] of slices) {
+      const r = ok(applyEdit(base.join('\n') + '\n', { old_text: base.slice(i, j).join('\n'), new_text: 'N' }));
+      expect(r.content).toBe([...base.slice(0, i), 'N', ...base.slice(j)].join('\n') + '\n');
+      expect(r.applied).toEqual({ from: i + 1, to: j, tier: 'exact', count: 1 });
+    }
+  });
+
+  test('trailing-space tier', () => {
+    // A one-line old_text is a verbatim substring of its padded line, so only multi-line slices reach this tier.
+    const pad = base.map((l) => l + '  ');
+    for (const [i, j] of slices.filter(([i, j]) => j - i > 1)) {
+      const r = ok(applyEdit(pad.join('\n') + '\n', { old_text: base.slice(i, j).join('\n'), new_text: 'N' }));
+      expect(r.content).toBe([...pad.slice(0, i), 'N', ...pad.slice(j)].join('\n') + '\n');
+      expect(r.applied).toEqual({ from: i + 1, to: j, tier: 'trailing-space', count: 1 });
+    }
+  });
+});
