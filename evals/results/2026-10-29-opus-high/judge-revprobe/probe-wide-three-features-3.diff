 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const PART = /(\d+(?:\.\d+)?)(ms|d|h|m|s) */y;
+const UNIT_MS = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1_000, ms: 1 } as const;
+const UNITS = ['d', 'h', 'm', 's', 'ms'] as const;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  const fail = () => new Error(`invalid duration "${text}"`);
+  if (s === '') throw fail();
+  let total = 0;
+  PART.lastIndex = 0;
+  while (PART.lastIndex < s.length) {
+    const m = PART.exec(s);
+    if (!m) throw fail();
+    total += Number(m[1]) * UNIT_MS[m[2] as keyof typeof UNIT_MS];
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!(ms >= 0) || !Number.isFinite(ms)) throw new Error(`invalid duration ${ms}`);
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const unit of UNITS) {
+    const n = Math.floor(rest / UNIT_MS[unit]);
+    if (n !== 0) out += `${n}${unit}`;
+    rest -= n * UNIT_MS[unit];
+  }
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
--- a/src/lru.ts	2026-10-30 01:45:23.780786578 +0000
+++ b/src/lru.ts	2026-10-30 01:47:05.794989594 +0000
@@ -14,30 +14,76 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
 
+  // entries in recency order, oldest first; an entry is removed before onEvict is called, so a throwing
+  // callback leaves the cache consistent.
+  private readonly entries = new Map<K, Entry<V>>();
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
+
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
+  }
+
+  private live(e: Entry<V>): boolean {
+    return this.now() < e.expires;
+  }
+
+  private remove(key: K, e: Entry<V>, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, e.value, reason);
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return undefined;
+    if (!this.live(e)) {
+      this.remove(key, e, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const old = this.entries.get(key);
+    if (old) {
+      if (this.live(old)) this.entries.delete(key);
+      else this.remove(key, old, 'expired');
+    }
+    this.entries.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.entries.size > this.capacity) {
+      for (const [k, e] of this.entries) if (!this.live(e)) this.remove(k, e, 'expired');
+      for (const [k, e] of this.entries) {
+        if (this.entries.size <= this.capacity) break;
+        this.remove(k, e, 'capacity');
+      }
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return false;
+    const live = this.live(e);
+    this.remove(key, e, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const e of this.entries.values()) if (this.live(e)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.entries].filter(([, e]) => this.live(e)).map(([k]) => k).reverse();
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-30 01:45:23.780887792 +0000
+++ b/src/slug.ts	2026-10-30 01:46:52.258989904 +0000
@@ -11,10 +11,24 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  const cut = s.lastIndexOf('-', max);
+  return cut > 0 ? s.slice(0, cut) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 01:47:46.553826951 +0000
@@ -0,0 +1,62 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('every unit parses', () => {
+  expect(parseDuration('2d')).toBe(172_800_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1m')).toBe(60_000);
+});
+
+test('fractions and rounding', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('1.4ms')).toBe(1);
+  expect(parseDuration('1.5ms')).toBe(2);
+});
+
+test('parts with spaces and surrounding spaces', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('  90s ')).toBe(90_000);
+});
+
+test('ms is not read as m then s', () => {
+  expect(parseDuration('1m1ms')).toBe(60_001);
+});
+
+test('invalid input throws with the input in the message', () => {
+  for (const input of ['', '   ', '10', '5x', 'h', '-1s', '1h30', 's1']) {
+    expect(() => parseDuration(input)).toThrow(`"${input}"`);
+  }
+});
+
+test('the message holds the raw input, even with special characters', () => {
+  for (const input of ['5"x', 'a\\b', '1h\t30m', '1h\n30m']) {
+    expect(() => parseDuration(input)).toThrow(input);
+  }
+});
+
+test('format examples', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(86_400_001)).toBe('1d1ms');
+});
+
+test('format rejects negative, NaN and infinite numbers', () => {
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(NaN)).toThrow();
+  expect(() => formatDuration(Infinity)).toThrow();
+});
+
+test('format and parse agree', () => {
+  const check = (n: number) => {
+    const text = formatDuration(n);
+    expect(text).toMatch(/^(\d+d)?(\d+h)?(\d+m)?(\d+s)?(\d+ms)?$/);
+    expect(parseDuration(text)).toBe(n);
+  };
+  for (let n = 0; n <= 5000; n++) check(n);
+  let seed = 12345;
+  for (let i = 0; i < 2000; i++) {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    check(seed % 864_000_000);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 01:47:05.805060283 +0000
@@ -0,0 +1,181 @@
+import { expect, test } from 'bun:test';
+import { EvictReason, LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl = 1000) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const log: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return { cache, log, setTime: (x: number) => (t = x) };
+}
+
+test('a get hit refreshes recency', () => {
+  const { cache, log } = setup(2);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('expiry boundary', () => {
+  const { cache, setTime } = setup(2);
+  cache.set('a', 1);
+  setTime(999);
+  expect(cache.get('a')).toBe(1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('an expired get logs once', () => {
+  const { cache, log, setTime } = setup(2);
+  cache.set('k', 7);
+  setTime(1000);
+  expect(cache.get('k')).toBeUndefined();
+  expect(log).toEqual([['k', 7, 'expired']]);
+  expect(cache.get('k')).toBeUndefined();
+  expect(log.length).toBe(1);
+});
+
+test('set gives a fresh ttl', () => {
+  const { cache, setTime } = setup(2);
+  cache.set('a', 1);
+  setTime(500);
+  cache.set('a', 2);
+  setTime(1400);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('capacity counts expired entries', () => {
+  const { cache, log, setTime } = setup(2);
+  cache.set('a', 1);
+  setTime(1500);
+  cache.set('b', 2);
+  expect(cache.size).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('expired entries are swept before a live one is evicted', () => {
+  const { cache, log, setTime } = setup(2);
+  cache.set('a', 1);
+  setTime(600);
+  cache.set('b', 2);
+  setTime(1200);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+});
+
+test('a live entry is evicted only while still over capacity', () => {
+  const { cache, log } = setup(1);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(log).toEqual([['a', 1, 'capacity']]);
+});
+
+test('delete', () => {
+  const { cache, log, setTime } = setup(3);
+  cache.set('a', 1);
+  expect(cache.delete('a')).toBe(true);
+  expect(log).toEqual([['a', 1, 'delete']]);
+
+  cache.set('b', 2);
+  setTime(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(log[1]).toEqual(['b', 2, 'expired']);
+
+  expect(cache.delete('zzz')).toBe(false);
+  expect(log.length).toBe(2);
+});
+
+test('size and keys leave out expired entries and log nothing', () => {
+  const { cache, log, setTime } = setup(3);
+  cache.set('a', 1);
+  setTime(600);
+  cache.set('b', 2);
+  setTime(1000);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+});
+
+test('overwriting a live key logs nothing and makes it most recent', () => {
+  const { cache, log } = setup(3);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('a', 3);
+  expect(log).toEqual([]);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  expect(cache.get('a')).toBe(3);
+});
+
+test('agrees with a naive reference model', () => {
+  const CAP = 3;
+  const TTL = 1000;
+  let t = 0;
+  const cache = new LRU<number, number>(CAP, TTL, () => t);
+  const logA: [number, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => logA.push([k, v, r]);
+
+  // reference: list of {k, v, exp} in recency order, oldest first
+  let model: { k: number; v: number; exp: number }[] = [];
+  const logB: [number, number, EvictReason][] = [];
+  const isLive = (e: { exp: number }) => t < e.exp;
+  const mRemove = (e: { k: number; v: number }, r: EvictReason) => {
+    model = model.filter((x) => x !== e);
+    logB.push([e.k, e.v, r]);
+  };
+  const mGet = (k: number) => {
+    const e = model.find((x) => x.k === k);
+    if (!e) return undefined;
+    if (!isLive(e)) {
+      mRemove(e, 'expired');
+      return undefined;
+    }
+    model = [...model.filter((x) => x !== e), e];
+    return e.v;
+  };
+  const mSet = (k: number, v: number) => {
+    const old = model.find((x) => x.k === k);
+    if (old) {
+      if (isLive(old)) model = model.filter((x) => x !== old);
+      else mRemove(old, 'expired');
+    }
+    model.push({ k, v, exp: t + TTL });
+    if (model.length > CAP) {
+      for (const e of [...model]) if (!isLive(e)) mRemove(e, 'expired');
+      while (model.length > CAP) mRemove(model[0], 'capacity');
+    }
+  };
+  const mDelete = (k: number) => {
+    const e = model.find((x) => x.k === k);
+    if (!e) return false;
+    const live = isLive(e);
+    mRemove(e, live ? 'delete' : 'expired');
+    return live;
+  };
+  const mSize = () => model.filter(isLive).length;
+  const mKeys = () => model.filter(isLive).map((x) => x.k).reverse();
+
+  let seed = 4242;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed % n;
+  };
+  for (let i = 0; i < 2000; i++) {
+    const op = rand(4);
+    const k = rand(6);
+    if (op === 0) expect(cache.get(k)).toBe(mGet(k));
+    else if (op === 1) {
+      const v = rand(100);
+      cache.set(k, v);
+      mSet(k, v);
+    } else if (op === 2) expect(cache.delete(k)).toBe(mDelete(k));
+    else t += rand(601);
+    expect(cache.size).toBe(mSize());
+    expect(cache.keys()).toEqual(mKeys());
+    expect(logA).toEqual(logB);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 01:46:52.273802973 +0000
@@ -0,0 +1,74 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('lower case', () => {
+  expect(slugify('ABC')).toBe('abc');
+});
+
+test('diacritics are dropped', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+});
+
+test('special letters', () => {
+  expect(slugify('ßæœøłđ')).toBe('ssaeoeold');
+  expect(slugify('ÆØŁĐ')).toBe('aeold');
+});
+
+test('runs of separators become one dash', () => {
+  expect(slugify('a -_/ b')).toBe('a-b');
+});
+
+test('no leading or trailing dash', () => {
+  expect(slugify('--a!!')).toBe('a');
+  expect(slugify('!!!')).toBe('');
+});
+
+test('non-Latin characters are separators', () => {
+  expect(slugify('a中b')).toBe('a-b');
+});
+
+test('max cuts at the last dash that fits', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab', 5)).toBe('ab');
+  expect(slugify('ab-cdef', 6)).toBe('ab');
+  expect(slugify('a-b', 0)).toBe('');
+});
+
+test('max agrees with a reference and never dangles', () => {
+  const reference = (s: string, max: number) => {
+    const words = s.split('-');
+    let best = '';
+    for (let i = 1; i <= words.length; i++) {
+      const cand = words.slice(0, i).join('-');
+      if (cand.length <= max) best = cand;
+    }
+    return best === '' ? s.slice(0, max) : best;
+  };
+  const alphabet = 'ab- é!ß';
+  let seed = 987654;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed % n;
+  };
+  for (let i = 0; i < 300; i++) {
+    let text = '';
+    const len = rand(14);
+    for (let j = 0; j < len; j++) text += alphabet[rand(alphabet.length)];
+    const full = slugify(text);
+    for (let max = 0; max <= 20; max++) {
+      const cut = slugify(text, max);
+      expect(cut).toBe(reference(full, max));
+      expect(cut.length).toBeLessThanOrEqual(max);
+      expect(cut.endsWith('-')).toBe(false);
+      expect(full.startsWith(cut)).toBe(true);
+    }
+  }
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set(['other']))).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+});
