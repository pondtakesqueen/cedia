+++ b/src/lru.ts	2026-10-30 01:45:55.136907656 +0000
@@ -14,30 +14,70 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Insertion order runs from least to most recently used.
+  private map = new Map<K, Entry<V>>();
+
+  constructor(
+    private capacity: number,
+    private ttlMs: number,
+    private now: () => number = Date.now,
+  ) {}
+
+  // Removes an entry from the map, then reports it to onEvict.
+  private remove(key: K, e: Entry<V>, reason: EvictReason): void {
+    this.map.delete(key);
+    this.onEvict?.(key, e.value, reason);
+  }
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+  private live(e: Entry<V>): boolean {
+    return this.now() < e.expires;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.map.get(key);
+    if (!e) return undefined;
+    if (!this.live(e)) {
+      this.remove(key, e, 'expired');
+      return undefined;
+    }
+    this.map.delete(key);
+    this.map.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.map.delete(key);
+    this.map.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    for (const [k, e] of [...this.map]) {
+      if (!this.live(e)) this.remove(k, e, 'expired');
+    }
+    while (this.map.size > this.capacity) {
+      const [k, e] = this.map.entries().next().value!;
+      this.remove(k, e, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.map.get(key);
+    if (!e) return false;
+    if (!this.live(e)) {
+      this.remove(key, e, 'expired');
+      return false;
+    }
+    this.remove(key, e, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    return [...this.map.values()].filter((e) => this.live(e)).length;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.map].reverse().filter(([, e]) => this.live(e)).map(([k]) => k);
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-30 01:44:14.777803240 +0000
+++ b/src/slug.ts	2026-10-30 01:45:55.134753547 +0000
@@ -11,10 +11,25 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (max <= 0) return '';
+  if (s[max] === '-') return s.slice(0, max);
+  const i = s.lastIndexOf('-', max - 1);
+  return i > 0 ? s.slice(0, i) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  let out = slug;
+  for (let n = 2; taken.has(out); n++) out = `${slug}-${n}`;
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 01:46:10.041850603 +0000
@@ -0,0 +1,61 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+// Seeded LCG, so the random cases are the same on every run.
+function lcg(seed: number) {
+  let x = seed;
+  return () => {
+    x = (Math.imul(x, 1664525) + 1013904223) >>> 0;
+    return x / 2 ** 32;
+  };
+}
+
+test('parses every unit', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1s500ms')).toBe(1500);
+});
+
+test('parses fractions and rounds the total', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('0.4ms')).toBe(0);
+  expect(parseDuration('1.5ms')).toBe(2);
+  expect(parseDuration('0.0015s')).toBe(2);
+});
+
+test('spaces between parts and around the text', () => {
+  expect(parseDuration('1h 30m')).toBe(5_400_000);
+  expect(parseDuration('1h   30m')).toBe(5_400_000);
+  expect(parseDuration('  90s ')).toBe(90_000);
+});
+
+test('rejects bad input, naming it in the message', () => {
+  for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '1.s', '.5s', '1..5h']) {
+    expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+  }
+});
+
+test('formats the shortest text', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(0.4)).toBe('0s');
+  expect(formatDuration(1.5)).toBe('2ms');
+});
+
+test('formatDuration rejects negative and non-finite numbers', () => {
+  expect(() => formatDuration(-1)).toThrow('-1');
+  expect(() => formatDuration(NaN)).toThrow();
+  expect(() => formatDuration(Infinity)).toThrow();
+});
+
+test('format and parse agree', () => {
+  for (let n = 0; n <= 5000; n++) expect(parseDuration(formatDuration(n))).toBe(n);
+  const rnd = lcg(1);
+  for (let i = 0; i < 2000; i++) {
+    const n = Math.floor(rnd() * 1e10);
+    expect(parseDuration(formatDuration(n))).toBe(n);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 01:46:10.045456807 +0000
@@ -0,0 +1,199 @@
+import { expect, test } from 'bun:test';
+import { EvictReason, LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const log: [string, number, EvictReason][] = [];
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return { cache, log, advance: (ms: number) => (t += ms), at: (x: number) => (t = x) };
+}
+
+// Seeded LCG, so the random cases are the same on every run.
+function lcg(seed: number) {
+  let x = seed;
+  return () => {
+    x = (Math.imul(x, 1664525) + 1013904223) >>> 0;
+    return x / 2 ** 32;
+  };
+}
+
+test('a get hit refreshes recency', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('an expired get returns undefined and logs once', () => {
+  const { cache, log, at } = setup(2, 1000);
+  cache.set('k', 7);
+  at(1000);
+  expect(cache.get('k')).toBeUndefined();
+  expect(cache.get('k')).toBeUndefined();
+  expect(log).toEqual([['k', 7, 'expired']]);
+});
+
+test('expiry boundary: live before ttl, gone at ttl', () => {
+  const { cache, at } = setup(2, 1000);
+  cache.set('k', 1);
+  at(999);
+  expect(cache.get('k')).toBe(1);
+  at(1000);
+  expect(cache.get('k')).toBeUndefined();
+});
+
+test('set gives a fresh ttl', () => {
+  const { cache, at } = setup(2, 1000);
+  cache.set('k', 1);
+  at(500);
+  cache.set('k', 2);
+  at(1200);
+  expect(cache.get('k')).toBe(2);
+});
+
+test('re-setting a key evicts nothing and makes it most recent', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('a', 3);
+  expect(log).toEqual([]);
+  expect(cache.keys()).toEqual(['a', 'b']);
+});
+
+test('expired entries count toward capacity and go first', () => {
+  const { cache, log, at } = setup(2, 1000);
+  cache.set('a', 1);
+  at(600);
+  cache.set('b', 2);
+  at(1000);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('all expired entries go, oldest first, before any live one', () => {
+  const { cache, log, at } = setup(3, 100);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  at(50);
+  cache.set('live', 9);
+  at(100);
+  cache.set('d', 4);
+  expect(log).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+  ]);
+  expect(cache.keys()).toEqual(['d', 'live']);
+});
+
+test('no sweep while not over capacity', () => {
+  const { cache, log, at } = setup(3, 100);
+  cache.set('a', 1);
+  at(100);
+  cache.set('b', 2);
+  expect(log).toEqual([]);
+  expect(cache.size).toBe(1);
+});
+
+test('delete: live, expired and missing', () => {
+  const { cache, log, at } = setup(3, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  at(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(cache.delete('zz')).toBe(false);
+  expect(log).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('size and keys skip expired entries and log nothing', () => {
+  const { cache, log, at } = setup(3, 1000);
+  cache.set('a', 1);
+  at(500);
+  cache.set('b', 2);
+  at(1000);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+});
+
+test('agrees with a reference model on random operations', () => {
+  const CAP = 3;
+  const TTL = 10;
+  const rnd = lcg(42);
+  const { cache, log, advance } = setup(CAP, TTL);
+
+  // Reference: entries oldest first, same rules written out directly.
+  let t = 0;
+  let entries: { key: string; value: number; expires: number }[] = [];
+  const refLog: [string, number, EvictReason][] = [];
+  const live = (e: { expires: number }) => t < e.expires;
+  const drop = (i: number, reason: EvictReason) => {
+    const [e] = entries.splice(i, 1);
+    refLog.push([e.key, e.value, reason]);
+  };
+  const ref = {
+    get(key: string) {
+      const i = entries.findIndex((e) => e.key === key);
+      if (i < 0) return undefined;
+      const e = entries[i];
+      if (!live(e)) {
+        drop(i, 'expired');
+        return undefined;
+      }
+      entries.splice(i, 1);
+      entries.push(e);
+      return e.value;
+    },
+    set(key: string, value: number) {
+      entries = entries.filter((e) => e.key !== key);
+      entries.push({ key, value, expires: t + TTL });
+      if (entries.length <= CAP) return;
+      for (let i = 0; i < entries.length; ) {
+        if (live(entries[i])) i++;
+        else drop(i, 'expired');
+      }
+      while (entries.length > CAP) drop(0, 'capacity');
+    },
+    delete(key: string) {
+      const i = entries.findIndex((e) => e.key === key);
+      if (i < 0) return false;
+      if (!live(entries[i])) {
+        drop(i, 'expired');
+        return false;
+      }
+      drop(i, 'delete');
+      return true;
+    },
+    size: () => entries.filter(live).length,
+    keys: () => entries.filter(live).map((e) => e.key).reverse(),
+  };
+
+  for (let op = 0; op < 2000; op++) {
+    const r = rnd();
+    const key = `k${Math.floor(rnd() * 5)}`;
+    if (r < 0.35) {
+      const value = op;
+      cache.set(key, value);
+      ref.set(key, value);
+    } else if (r < 0.7) {
+      expect(cache.get(key)).toBe(ref.get(key));
+    } else if (r < 0.85) {
+      expect(cache.delete(key)).toBe(ref.delete(key));
+    } else {
+      const d = Math.floor(rnd() * 8);
+      advance(d);
+      t += d;
+    }
+    expect(cache.size).toBe(ref.size());
+    expect(cache.keys()).toEqual(ref.keys());
+    expect(log).toEqual(refLog);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 01:46:10.043780950 +0000
@@ -0,0 +1,68 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+// Seeded LCG, so the random cases are the same on every run.
+function lcg(seed: number) {
+  let x = seed;
+  return () => {
+    x = (Math.imul(x, 1664525) + 1013904223) >>> 0;
+    return x / 2 ** 32;
+  };
+}
+
+// Straight from the rule: the longest prefix within max that ends before a "-".
+function bruteCut(full: string, max: number): string {
+  if (full.length <= max) return full;
+  let best = full.slice(0, max);
+  for (let p = 1; p <= max; p++) {
+    if (full[p] === '-' && !full.slice(0, p).endsWith('-')) best = full.slice(0, p);
+  }
+  return best;
+}
+
+test('lower case and diacritics', () => {
+  expect(slugify('ABC')).toBe('abc');
+  expect(slugify('à ç ñ ź')).toBe('a-c-n-z');
+});
+
+test('special letters, lower and upper case', () => {
+  expect(slugify('ß æ œ ø ł đ')).toBe('ss-ae-oe-o-l-d');
+  expect(slugify('Æ Ø Ł Đ')).toBe('ae-o-l-d');
+});
+
+test('separators collapse and are trimmed', () => {
+  expect(slugify('--a__b  c!!')).toBe('a-b-c');
+  expect(slugify('!!!')).toBe('');
+});
+
+test('max cuts at a dash or at max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab-cd', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd', 0)).toBe('');
+  expect(slugify('abc', -1)).toBe('');
+});
+
+test('max never leaves a trailing dash', () => {
+  for (let max = 1; max <= 8; max++) expect(slugify('ab-cd-ef', max).endsWith('-')).toBe(false);
+});
+
+test('uniqueSlug picks the first free suffix', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+});
+
+test('slugify with max agrees with the brute-force cut', () => {
+  const rnd = lcg(7);
+  const alphabet = 'ab -é';
+  for (let i = 0; i < 500; i++) {
+    let text = '';
+    const len = Math.floor(rnd() * 15);
+    for (let j = 0; j < len; j++) text += alphabet[Math.floor(rnd() * alphabet.length)];
+    const max = 1 + Math.floor(rnd() * 12);
+    const full = slugify(text);
+    expect(slugify(text, max)).toBe(bruteCut(full, max));
+  }
+});
