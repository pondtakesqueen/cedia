diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-30 01:30:01.429918771 +0000
@@ -0,0 +1,131 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const SRC = 'function f() {\n    if (a) {\n        return 1;  \n    }\n}\n';
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+const errOf = (r: ReturnType<typeof applyEdit>) => ('error' in r ? r.error : '');
+
+describe('input errors', () => {
+  test('empty old_text says use write, even when new_text is also empty', () => {
+    expect(errOf(applyEdit(SRC, { old_text: '', new_text: '' }))).toContain('use write');
+  });
+  test('old_text equal to new_text says same', () => {
+    expect(errOf(applyEdit(SRC, { old_text: 'x', new_text: 'x' }))).toContain('same');
+  });
+});
+
+describe('exact tier', () => {
+  test('exact wins over a fuzzy match on the same text', () => {
+    const r = ok(applyEdit('a\na \n', { old_text: 'a ', new_text: 'b' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+    expect(r.content).toBe('a\nb\n');
+  });
+  test('several matches name the count and the first line', () => {
+    const e = errOf(applyEdit('q\nx\nx\n', { old_text: 'x', new_text: 'z' }));
+    expect(e).toContain('matches 2 places');
+    expect(e).toContain('line 2');
+  });
+  test('overlapping occurrences count once each, left to right', () => {
+    const r = ok(applyEdit('aaa\n', { old_text: 'aa', new_text: 'X', replace_all: true }));
+    expect(r.content).toBe('Xa\n');
+    expect(r.applied.count).toBe(1);
+  });
+  test('replace_all replaces every exact match and counts them', () => {
+    const r = ok(applyEdit('x\nx\n', { old_text: 'x', new_text: 'y', replace_all: true }));
+    expect(r.content).toBe('y\ny\n');
+    expect(r.applied).toEqual({ from: 1, to: 1, tier: 'exact', count: 2 });
+  });
+  test('new_text is inserted literally', () => {
+    const r = ok(applyEdit('x\n', { old_text: 'x', new_text: '$&-$1' }));
+    expect(r.content).toBe('$&-$1\n');
+  });
+  test('a trailing newline in old_text ends the range on its own line', () => {
+    const r = ok(applyEdit('a\nb\nc\n', { old_text: 'b\n', new_text: 'B\n' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+    expect(r.content).toBe('a\nB\nc\n');
+  });
+});
+
+describe('trailing-space tier', () => {
+  test('several matches stop before the indentation tier', () => {
+    const e = errOf(applyEdit('a \nb\na\t\nb\n', { old_text: 'a\nb', new_text: 'c' }));
+    expect(e).toContain('matches 2 places');
+    expect(e).toContain('1, 3');
+  });
+  test('deleting with empty new_text removes the lines', () => {
+    const r = ok(applyEdit('a  \nb\nc\n', { old_text: 'a\nb', new_text: '' }));
+    expect(r.content).toBe('c\n');
+  });
+});
+
+describe('indentation tier', () => {
+  test('re-indents new_text to the file, keeping relative indent', () => {
+    const r = ok(applyEdit('f {\n\tif (a) {\n\t\tr;\n\t}\n}\n', { old_text: 'if (a) {\n    r;\n}', new_text: 'if (b) {\n    r;\n    s;\n}' }));
+    expect(r.applied).toEqual({ from: 2, to: 4, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('f {\n\tif (b) {\n\t    r;\n\t    s;\n\t}\n}\n');
+  });
+  test('empty new_text deletes the matched lines', () => {
+    const r = ok(applyEdit('f {\n\tif (a) {\n\t\tr;\n\t}\n}\n', { old_text: 'if (a) {\n    r;\n}', new_text: '' }));
+    expect(r.applied).toEqual({ from: 2, to: 4, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('f {\n}\n');
+  });
+  test('replace_all still needs one fuzzy match', () => {
+    const r = ok(applyEdit(SRC, { old_text: 'if (a) {\n    return 1;\n}', new_text: 'if (b) {\n    return 1;\n}', replace_all: true }));
+    expect(r.applied).toEqual({ from: 2, to: 4, tier: 'indentation', count: 1 });
+  });
+});
+
+describe('not found', () => {
+  test('lists at most five lines where the first line appears', () => {
+    const e = errOf(applyEdit('x\nx\nx\nx\nx\nx\nx\n', { old_text: 'x\nQ', new_text: 'y' }));
+    expect(e).toContain('line 1, 2, 3, 4, 5');
+    expect(e).not.toContain(', 6');
+  });
+});
+
+describe('agrees with a manual splice', () => {
+  let seed = 1;
+  const rnd = (n: number) => {
+    seed = (seed * 16807) % 2147483647;
+    return seed % n;
+  };
+  const cases = Array.from({ length: 200 }, () => {
+    const n = 3 + rnd(6);
+    const lines = Array.from({ length: n }, (_, k) => `<${k}:${rnd(100)}>`);
+    return { n, lines };
+  });
+
+  test('exact and indentation-free splices match applyEdit', () => {
+    for (const { n, lines } of cases) {
+      const i = rnd(n - 1);
+      const len = 1 + rnd(n - i);
+      const m = 1 + rnd(3);
+      const repl = Array.from({ length: m }, (_, k) => `new${k}:${rnd(100)}`);
+      const content = lines.join('\n') + '\n';
+      const old = lines.slice(i, i + len).join('\n');
+      const expected = [...lines.slice(0, i), ...repl, ...lines.slice(i + len)].join('\n') + '\n';
+      const r = ok(applyEdit(content, { old_text: old, new_text: repl.join('\n') }));
+      expect(r.content).toBe(expected);
+      expect(r.applied).toEqual({ from: i + 1, to: i + len, tier: 'exact', count: 1 });
+    }
+  });
+
+  test('trailing spaces on every line still splice the same lines', () => {
+    for (const { n, lines } of cases) {
+      const i = rnd(n - 1);
+      const len = 2 + rnd(n - i - 1);
+      const m = 1 + rnd(3);
+      const repl = Array.from({ length: m }, (_, k) => `new${k}:${rnd(100)}`);
+      const padded = lines.map(l => `${l}${' '.repeat(1 + rnd(3))}`);
+      const content = padded.join('\n') + '\n';
+      const old = lines.slice(i, i + len).join('\n');
+      const expected = [...padded.slice(0, i), ...repl, ...padded.slice(i + len)].join('\n') + '\n';
+      const r = ok(applyEdit(content, { old_text: old, new_text: repl.join('\n') }));
+      expect(r.content).toBe(expected);
+      expect(r.applied).toEqual({ from: i + 1, to: i + len, tier: 'trailing-space', count: 1 });
+    }
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-30 01:27:26.612664434 +0000
+++ b/edit.ts	2026-10-30 01:29:11.806970058 +0000
@@ -23,5 +23,84 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: next, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create or replace a whole file' };
+  if (old === next) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  const starts: number[] = [];
+  for (let i = content.indexOf(old); i !== -1; i = content.indexOf(old, i + old.length)) starts.push(i);
+  if (starts.length > 1 && !replace_all) {
+    return { error: `old_text matches ${starts.length} places (first at line ${lineAt(content, starts[0])}); add more context or set replace_all` };
+  }
+  if (starts.length > 0) {
+    const first = starts[0];
+    const out = replace_all
+      ? content.split(old).join(next)
+      : content.slice(0, first) + next + content.slice(first + old.length);
+    return {
+      content: out,
+      applied: { from: lineAt(content, first), to: lineAt(content, first + old.length - 1), tier: 'exact', count: starts.length },
+    };
+  }
+
+  const hasFinalNewline = content.endsWith('\n');
+  const fileLines = (hasFinalNewline ? content.slice(0, -1) : content).split('\n');
+  const oldLines = toLines(old);
+  const newLines = toLines(next);
+  const tiers = [
+    { tier: 'trailing-space', label: 'trailing whitespace', norm: (s: string) => s.trimEnd() },
+    { tier: 'indentation', label: 'indentation', norm: (s: string) => s.trim() },
+  ] as const;
+  for (const { tier, label, norm } of tiers) {
+    const windows = findWindows(fileLines, oldLines, norm);
+    if (windows.length > 1) {
+      return { error: `old_text matches ${windows.length} places (lines ${windows.map(i => i + 1).join(', ')}) ignoring ${label}` };
+    }
+    if (windows.length === 1) {
+      const i = windows[0];
+      let repl = newLines;
+      if (tier === 'indentation') {
+        const oldIndent = indentOf(oldLines);
+        const fileIndent = indentOf(fileLines.slice(i, i + oldLines.length));
+        repl = newLines.map(l => (l.trim() !== '' && l.startsWith(oldIndent) ? fileIndent + l.slice(oldIndent.length) : l));
+      }
+      fileLines.splice(i, oldLines.length, ...repl);
+      return {
+        content: fileLines.join('\n') + (hasFinalNewline ? '\n' : ''),
+        applied: { from: i + 1, to: i + oldLines.length, tier, count: 1 },
+      };
+    }
+  }
+
+  const first = oldLines.find(l => l.trim() !== '')?.trim();
+  const hits = first ? fileLines.flatMap((l, i) => (l.includes(first) ? [i + 1] : [])) : [];
+  const where = hits.length > 0 ? `; first line appears at line ${hits.slice(0, 5).join(', ')}` : '';
+  return { error: `old_text not found${where}` };
+}
+
+// 1-based line number of the character at `index`.
+function lineAt(content: string, index: number): number {
+  return content.slice(0, index).split('\n').length;
+}
+
+// Lines of a text, without one trailing newline.
+function toLines(text: string): string[] {
+  const body = text.endsWith('\n') ? text.slice(0, -1) : text;
+  return body === '' ? [] : body.split('\n');
+}
+
+// Start indexes where the file lines, normalised by `norm`, equal the old lines, normalised the same way.
+function findWindows(fileLines: string[], oldLines: string[], norm: (s: string) => string): number[] {
+  if (oldLines.length === 0) return [];
+  const hits: number[] = [];
+  for (let i = 0; i + oldLines.length <= fileLines.length; i++) {
+    if (oldLines.every((l, k) => norm(fileLines[i + k]) === norm(l))) hits.push(i);
+  }
+  return hits;
+}
+
+// Leading whitespace of the first non-blank line, or '' when every line is blank.
+function indentOf(lines: string[]): string {
+  const first = lines.find(l => l.trim() !== '');
+  return first === undefined ? '' : first.match(/^\s*/)![0];
 }
