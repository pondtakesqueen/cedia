diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-30 01:35:18.014528086 +0000
@@ -0,0 +1,191 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+// fn's calls, each settled by the test.
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("a rejection is shared by every waiter and the next call runs fn again", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  const err = new Error("boom");
+  calls[0]!.d.reject(err);
+  await expect(a).rejects.toBe(err);
+  await expect(b).rejects.toBe(err);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("size never exceeds max while calls are in flight", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  for (const k of ["a", "b", "c", "d"]) {
+    m(k);
+    expect(m.size).toBeLessThanOrEqual(2);
+  }
+  expect(m.size).toBe(2);
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  expect(m.size).toBe(2);
+});
+
+test("size never exceeds max when the key is new and the cache is full", () => {
+  const { fn } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  expect(m.size).toBe(1);
+});
+
+test("a hit refreshes the key's place in least-recently-used order", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("a"); // answered from the cache: a is now most recently used
+  m("c"); // evicts b, not a
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("a stale in-flight result does not overwrite a newer call after invalidate", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(m("k")).toBe(second);
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("an in-flight result for a key dropped to stay under max is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  const a = m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  expect(await a).toBe("a");
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a stale rejection does not delete the newer call's entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("stale"));
+  await expect(first).rejects.toThrow("stale");
+  await tick();
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("clear forgets in-flight calls, whose results are not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  expect(await a).toBe("old");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("expired results are not counted in size", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  calls[0]!.d.resolve("v");
+  await tick();
+  expect(m.size).toBe(1);
+  t = 100;
+  expect(m.size).toBe(0);
+});
+
+test("expired results do not take up room under max", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 1, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 100;
+  m("b");
+  expect(m.size).toBe(1);
+  expect(calls).toHaveLength(2);
+});
+
+test("bad options throw RangeError", () => {
+  const { fn } = lookups();
+  expect(() => memo(fn, { ttlMs: 0, max: 1 })).toThrow(RangeError);
+  expect(() => memo(fn, { ttlMs: 1, max: 0 })).toThrow(RangeError);
+  expect(() => memo(fn, { ttlMs: 1, max: 1.5 })).toThrow(RangeError);
+});
+
+const settled = new Set<unknown>();
+
+test("size stays within max through a seeded mix of calls, settles, invalidates and clock moves", async () => {
+  let seed = 7;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed % n;
+  };
+  let t = 0;
+  const { fn, calls } = lookups();
+  const max = 3;
+  const m = memo(fn, { ttlMs: 50, max, now: () => t });
+  const keys = ["a", "b", "c", "d"];
+  for (let i = 0; i < 300; i++) {
+    const op = rand(6);
+    const key = keys[rand(keys.length)]!;
+    if (op <= 2) m(key);
+    else if (op === 3) {
+      const pending = calls.filter((c) => !settled.has(c));
+      const c = pending[rand(Math.max(pending.length, 1))];
+      if (c) {
+        settled.add(c);
+        if (rand(2)) c.d.resolve(c.key);
+        else c.d.reject(new Error("x"));
+      }
+    } else if (op === 4) m.invalidate(key);
+    else t += rand(30);
+    expect(m.size).toBeLessThanOrEqual(max);
+    await tick();
+    expect(m.size).toBeLessThanOrEqual(max);
+  }
+});
