diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-30 01:35:41.707005241 +0000
@@ -0,0 +1,171 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("a rejection is shared by every waiting caller and the next call runs fn again", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(a).rejects.toThrow("boom");
+  await expect(b).rejects.toThrow("boom");
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection from an invalidated call does not delete the newer entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.reject(new Error("stale"));
+  await expect(first).rejects.toThrow("stale");
+  await tick();
+  expect(m("k")).toBe(second);
+  expect(calls).toHaveLength(2);
+});
+
+test("a hit refreshes recency, so the least recently used key is the one dropped", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("a");
+  m("c");
+  expect(m.size).toBe(2);
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("a shared in-flight hit refreshes recency too", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("a");
+  m("c");
+  calls.forEach((c) => c.d.resolve(c.key));
+  await tick();
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("a key in flight that is dropped for max is not brought back when it settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("c");
+  expect(m.size).toBe(2);
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  expect(m.size).toBe(2);
+  m("a");
+  expect(calls).toHaveLength(4);
+});
+
+test("the map never holds more than max keys, even with expired entries", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 10, max: 2, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 10;
+  m("b");
+  m("c");
+  expect(m.size).toBe(2);
+  expect(calls).toHaveLength(3);
+});
+
+test("a settled result past its ttl is not counted in size", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  calls[0]!.d.resolve("v");
+  await tick();
+  expect(m.size).toBe(1);
+  t = 100;
+  expect(m.size).toBe(0);
+});
+
+test("clear forgets in-flight calls, which do not come back when they settle", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a result that settles after invalidate does not replace the newer result", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("a synchronous throw from fn on a full cache drops no kept key", async () => {
+  const { fn, calls } = lookups();
+  const m = memo((key: string) => {
+    if (key === "bad") throw new Error("sync");
+    return fn(key);
+  }, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  await expect(m("bad")).rejects.toThrow("sync");
+  expect(m.size).toBe(2);
+  m("a");
+  expect(calls).toHaveLength(2);
+});
+
+test("a synchronous throw from fn rejects the call and keeps nothing", async () => {
+  const m = memo((): Promise<string> => {
+    throw new Error("sync");
+  }, { ttlMs: 1000, max: 10 });
+  await expect(m("k")).rejects.toThrow("sync");
+  expect(m.size).toBe(0);
+});
