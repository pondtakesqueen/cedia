diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse-stream.test.ts b/sse-stream.test.ts
--- a/sse-stream.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse-stream.test.ts	2026-10-29 09:13:08.828968600 +0000
@@ -0,0 +1,40 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString } from './sse.ts';
+
+test('stopping early cancels the body stream', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: x\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const _ of readSse(body)) break;
+  expect(cancelled).toBe(true);
+});
+
+test('a read error from the body reaches the consumer unchanged', async () => {
+  const boom = new Error('connection reset');
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.error(boom);
+    },
+  });
+  let caught: unknown;
+  try {
+    for await (const _ of readSse(body)) void _;
+  } catch (e) {
+    caught = e;
+  }
+  expect(caught).toBe(boom);
+});
+
+test('a long line split into many small chunks is parsed in full', async () => {
+  const big = 'y'.repeat(100_000);
+  const out = [];
+  for await (const m of readSse(streamFromString(`data: ${big}\n\n`, 1))) out.push(m);
+  expect(out).toEqual([{ data: big }]);
+});
