diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny-dotnames.test.ts b/deny-dotnames.test.ts
--- a/deny-dotnames.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny-dotnames.test.ts	2026-10-29 09:07:11.096947335 +0000
@@ -0,0 +1,16 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+
+test('names starting with two dots inside cwd are not outside', () => {
+  expect(denyListed(['rm', '-rf', '..cache'], cwd)).toBeUndefined();
+  expect(denyListed(['rm', '-r', './..build'], cwd)).toBeUndefined();
+  expect(denyListed(['find', '..cache', '-delete'], cwd)).toBeUndefined();
+});
+
+test('the parent directory and paths through it are still outside', () => {
+  expect(denyListed(['rm', '-rf', '..'], cwd)?.name).toBe('rm-outside');
+  expect(denyListed(['rm', '-rf', '../x'], cwd)?.name).toBe('rm-outside');
+  expect(denyListed(['find', '../x', '-delete'], cwd)?.name).toBe('rm-outside');
+});
