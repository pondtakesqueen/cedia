+  const cd = cwd === undefined ? null : /^cd\s+("[^"]*"|'[^']*'|\S+)\s*&&\s*(.*)$/.exec(cmd);
+  if (cwd !== undefined && cd && resolve(cwd, cd[1]!.replace(/^["']|["']$/g, '')) === resolve(cwd)) cmd = norm(cd[2]!);
+  return checks.find((c) => norm(c) === cmd);
 }
 
