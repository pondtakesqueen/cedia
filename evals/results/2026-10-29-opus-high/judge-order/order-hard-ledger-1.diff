--- a/ledger.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.rules.test.ts	2026-10-29 14:55:49.826825871 +0000
@@ -0,0 +1,160 @@
+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+let n = 0;
+type Status = 'completed' | 'failed' | 'denied' | 'not_started';
+type Output = { isError: boolean; exitCode?: number };
+
+// One intent and its result, as the log records them.
+function call(tool: string, input: Record<string, unknown>, opts: { status?: Status; output?: Output; callId?: string } = {}): SessionEvent[] {
+  const callId = opts.callId ?? `r${++n}`;
+  const status = opts.status ?? 'completed';
+  const output = opts.output ?? { isError: status !== 'completed' };
+  return [
+    { kind: 'tool_intent', callId, tool, input },
+    { kind: 'tool_result', callId, status, output },
+  ];
+}
+
+const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+const wb = (at: number, command: string): LedgerEntry => ({ kind: 'write', at, tool: 'bash', command });
+const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+// Same normalisation as ledger.ts, written again so the property test does not reuse the code under test.
+const norm = (s: string) => s.trim().replace(/\s+/g, ' ').replace(/ 2>&1$/, '').trim();
+
+// Seeded linear congruential generator: deterministic, returns values in [0, 1).
+function rng(seed: number) {
+  let s = seed >>> 0;
+  return () => {
+    s = (Math.imul(s, 1103515245) + 12345) >>> 0;
+    return s / 2 ** 32;
+  };
+}
+
+describe('matchCheck rules', () => {
+  test('whitespace and a trailing 2>&1 are normalised; anything else must match exactly', () => {
+    expect(matchCheck('bun  test\t2>&1', ['bun test'])).toBe('bun test');
+    expect(matchCheck('bun test 2>&1 2>&1', ['bun test'])).toBeUndefined();
+  });
+
+  test('pipes and chains never match', () => {
+    expect(matchCheck('bun test || true', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test; ls', ['bun test'])).toBeUndefined();
+  });
+
+  test('the cd must point at the working directory, and only one cd is stripped', () => {
+    expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd .. && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+
+  test('a cd target the shell would expand is not the working directory', () => {
+    expect(matchCheck('cd "$HOME/.." && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd ~/.. && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd "`pwd`/.." && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+
+  test('returns the first declared check that matches, as written', () => {
+    expect(matchCheck('bun test', ['bun  test 2>&1', 'bun test'])).toBe('bun  test 2>&1');
+    expect(matchCheck('bun test', ['bun test', 'bun  test 2>&1'])).toBe('bun test');
+  });
+
+  test('property: a command matches exactly when its normalised body equals the normalised check', () => {
+    const next = rng(7);
+    const tokens = ['bun', 'test', 'src', '|', '&&', '2>&1'];
+    const seps = [' ', '  ', '\t'];
+    for (let i = 0; i < 500; i++) {
+      const count = Math.floor(next() * 6);
+      let body = '';
+      for (let k = 0; k < count; k++) {
+        if (k > 0) body += seps[Math.floor(next() * seps.length)];
+        body += tokens[Math.floor(next() * tokens.length)];
+      }
+      const cmd = next() < 0.5 ? `cd /work/repo && ${body}` : body;
+      expect(matchCheck(cmd, ['bun test'], cwd) !== undefined).toBe(norm(body) === norm('bun test'));
+    }
+  });
+});
+
+describe('ledgerEntries rules', () => {
+  test('only intents since the last request pair with results', () => {
+    const first = call('edit', { path: 'a.ts' }, { callId: 'x' });
+    const second = call('edit', { path: 'b.ts' }, { callId: 'x' });
+    expect(ledgerEntries([first[0]!, { kind: 'request' }, second[0]!, second[1]!], [])).toEqual([{ kind: 'write', at: 3, tool: 'edit', path: 'b.ts' }]);
+  });
+
+  test('denied and not_started results never count, even with a snapshot or a check', () => {
+    const events: SessionEvent[] = [
+      ...call('edit', { path: 'a.ts' }, { status: 'denied', callId: 'd' }),
+      { kind: 'snapshot', callId: 'd', changed: ['z'] },
+      ...call('bash', { command: 'bun test' }, { status: 'not_started', output: { isError: false, exitCode: 0 } }),
+    ];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([]);
+  });
+
+  test('a check exit code comes from exitCode, then isError, then 0', () => {
+    const exit = (output: Output) => ledgerEntries(call('bash', { command: 'bun test' }, { output }), ['bun test'])[0];
+    expect(exit({ isError: false })).toEqual({ kind: 'check', at: 1, command: 'bun test', exitCode: 0 });
+    expect(exit({ isError: true, exitCode: 2 })).toEqual({ kind: 'check', at: 1, command: 'bun test', exitCode: 2 });
+    expect(exit({ isError: false, exitCode: 3 })).toEqual({ kind: 'check', at: 1, command: 'bun test', exitCode: 3 });
+  });
+
+  test('a snapshot wins over the edit and bash rules', () => {
+    const failedEdit = [...call('edit', { path: 'a.ts' }, { status: 'failed', callId: 'f' }), { kind: 'snapshot', callId: 'f', changed: ['z'] }] as SessionEvent[];
+    expect(ledgerEntries(failedEdit, [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'z' }]);
+
+    const emptySnap = [...call('edit', { path: 'a.ts' }, { callId: 'e' }), { kind: 'snapshot', callId: 'e', changed: [] }] as SessionEvent[];
+    expect(ledgerEntries(emptySnap, [])).toEqual([]);
+
+    const before = [{ kind: 'snapshot', callId: 'p', changed: ['q'] }, ...call('edit', { path: 'a.ts' }, { callId: 'p' })] as SessionEvent[];
+    expect(ledgerEntries(before, [])).toEqual([{ kind: 'write', at: 2, tool: 'edit', path: 'q' }]);
+
+    const readOnly = [...call('bash', { command: 'ls' }, { callId: 'l' }), { kind: 'snapshot', callId: 'l', changed: ['m'] }] as SessionEvent[];
+    expect(ledgerEntries(readOnly, [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', path: 'm' }]);
+  });
+
+  test('a completed edit or write without a snapshot is a write with its path; other tools are not', () => {
+    expect(ledgerEntries(call('edit', { path: 'a.ts' }), [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'a.ts' }]);
+    expect(ledgerEntries(call('read', { path: 'a.ts' }), [])).toEqual([]);
+  });
+
+  test('a failed non-read-only bash command is a write with its command; a pipe into rm is not read-only', () => {
+    expect(ledgerEntries(call('bash', { command: 'npm install' }, { status: 'failed', output: { isError: true, exitCode: 1 } }), [])).toEqual([
+      { kind: 'write', at: 1, tool: 'bash', command: 'npm install' },
+    ]);
+    expect(ledgerEntries(call('bash', { command: 'ls | rm x' }), [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'ls | rm x' }]);
+  });
+});
+
+describe('evidence and verified rules', () => {
+  test('duplicate labels are deduped; a failing check after a pass does not reset unverified', () => {
+    const e = evidence([w(0, 'a.ts'), c(1, 0), w(2, 'b.ts'), c(3, 1), w(4, 'b.ts')]);
+    expect(e.changed).toEqual(['a.ts', 'b.ts']);
+    expect(e.unverified).toEqual(['b.ts']);
+    expect(evidence([w(0, 'a.ts'), w(1, 'a.ts'), wb(2, 'npm i')]).unverified).toEqual(['a.ts', 'bash: npm i']);
+  });
+
+  test('with checks declared but no writes, verified is true even when every check failed', () => {
+    expect(verified([c(0, 1), c(1, 1)], ['bun test'])).toBe(true);
+    expect(verified([w(0, 'a.ts'), c(1, 1)], ['bun test'])).toBe(false);
+    expect(verified([c(0, 0), w(1, 'a.ts')], ['bun test'])).toBe(false);
+  });
+
+  test('property: verified agrees with "nothing unverified" when checks are declared', () => {
+    const next = rng(11);
+    for (let i = 0; i < 500; i++) {
+      const len = Math.floor(next() * 13);
+      const entries: LedgerEntry[] = [];
+      for (let k = 0; k < len; k++) {
+        const r = next();
+        if (r < 0.3) entries.push(c(k, next() < 0.5 ? 0 : 1));
+        else if (r < 0.6) entries.push(w(k, next() < 0.5 ? 'a.ts' : 'b.ts'));
+        else entries.push(wb(k, next() < 0.5 ? 'npm i' : 'make'));
+      }
+      expect(verified(entries, ['bun test'])).toBe(evidence(entries).unverified.length === 0);
+      expect(verified(entries, [])).toBe(true);
+    }
+  });
+});
