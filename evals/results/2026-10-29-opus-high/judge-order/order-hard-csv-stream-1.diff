diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.stream.test.ts b/csv.stream.test.ts
--- a/csv.stream.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/csv.stream.test.ts	2026-10-29 14:40:10.494770035 +0000
@@ -0,0 +1,124 @@
+import { expect, test } from "bun:test";
+import { CsvStream, parseCsv } from "./csv";
+
+function streamRows(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const chunk of chunks) rows.push(...s.push(chunk));
+  rows.push(...s.end());
+  return rows;
+}
+
+// The rows, or "Name: message" when the call throws, so both runs can be compared exactly.
+function outcome(f: () => string[][]): string[][] | string {
+  try {
+    return f();
+  } catch (e) {
+    return `${(e as Error).name}: ${(e as Error).message}`;
+  }
+}
+
+function rng(seed: number) {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test("a row comes back on the push that brings its row end, even when \\r and \\n are split", () => {
+  const s = new CsvStream();
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\n")).toEqual([["a"]]);
+  expect(s.push("b,c\r\n")).toEqual([["b", "c"]]);
+});
+
+test("a \\r that is not followed by \\n is part of its field", () => {
+  expect(streamRows(["a\r", "b\n"])).toEqual([["a\rb"]]);
+  expect(streamRows(["a\r"])).toEqual([["a\r"]]);
+  expect(streamRows(["a\r\r\n"])).toEqual([["a\r"]]);
+});
+
+test("doubled quotes are one quote, also when the pair is split", () => {
+  expect(streamRows(['"x"', '"y"'])).toEqual([['x"y']]);
+  expect(streamRows(['"x"', '"', 'y"'])).toEqual([['x"y']]);
+  expect(streamRows(['"a,\r', '\nb"\n'])).toEqual([["a,\r\nb"]]);
+});
+
+test("text after a closing quote is a SyntaxError, also when split", () => {
+  expect(() => streamRows(['"a"b'])).toThrow(SyntaxError);
+  expect(() => streamRows(['"a"', "b"])).toThrow(SyntaxError);
+  expect(() => streamRows(['"a"\r', "x"])).toThrow(SyntaxError);
+  expect(() => streamRows(['"a"\r'])).toThrow(SyntaxError);
+});
+
+test("a quote in a field that is not quoted is a SyntaxError, also when split", () => {
+  expect(() => streamRows(["a", '"'])).toThrow(SyntaxError);
+  expect(() => streamRows(["a\r", '"'])).toThrow(SyntaxError);
+});
+
+test("a quoted field still open at the end is a SyntaxError", () => {
+  const s = new CsvStream();
+  expect(s.push('"ab')).toEqual([]);
+  expect(() => s.end()).toThrow(SyntaxError);
+});
+
+test("a BOM is dropped only at the very start of the input", () => {
+  expect(streamRows(["", "\uFEFFa"])).toEqual([["a"]]);
+  expect(streamRows(["\uFEFF"])).toEqual([]);
+  expect(streamRows(["a\uFEFFb"])).toEqual([["a\uFEFFb"]]);
+});
+
+test("empty input has no rows, and a row end at the end adds no row", () => {
+  expect(streamRows([])).toEqual([]);
+  expect(streamRows(["", ""])).toEqual([]);
+  expect(streamRows(["a\n"])).toEqual([["a"]]);
+  expect(streamRows(["\n"])).toEqual([[""]]);
+  expect(streamRows(["a,"])).toEqual([["a", ""]]);
+});
+
+test("a stream agrees with parseCsv on random inputs and random splits, errors included", () => {
+  const random = rng(42);
+  const alphabet = ['a', ",", '"', "\r", "\n", "\uFEFF"];
+  for (let n = 0; n < 20000; n++) {
+    let text = "";
+    const len = Math.floor(random() * 13);
+    for (let k = 0; k < len; k++) text += alphabet[Math.floor(random() * alphabet.length)];
+    const splits: string[][] = [text.split("")];
+    for (let s = 0; s < 5; s++) {
+      const chunks: string[] = [];
+      let rest = text;
+      while (rest.length > 0 || random() < 0.2) {
+        const take = Math.floor(random() * 4);
+        chunks.push(rest.slice(0, take));
+        rest = rest.slice(take);
+        if (rest.length === 0 && random() < 0.5) break;
+      }
+      splits.push(chunks);
+    }
+    for (const chunks of splits) {
+      expect(outcome(() => streamRows(chunks))).toEqual(outcome(() => parseCsv(text)));
+    }
+  }
+});
+
+test("a stream over a 2 MB input in 3-character chunks gives parseCsv's rows", () => {
+  const text = `"${"x".repeat(1_000_000)}"\n` + "a,b,c\r\n".repeat(100_000);
+  const chunks: string[] = [];
+  for (let i = 0; i < text.length; i += 3) chunks.push(text.slice(i, i + 3));
+  expect(streamRows(chunks)).toEqual(parseCsv(text));
+});
+
+test("push and end after end() throw, and a failed stream keeps throwing", () => {
+  const done = new CsvStream();
+  done.push("a");
+  expect(done.end()).toEqual([["a"]]);
+  expect(() => done.push("b")).toThrow("CsvStream already ended");
+  expect(() => done.end()).toThrow("CsvStream already ended");
+
+  const failed = new CsvStream();
+  expect(() => failed.push('"a"b')).toThrow(SyntaxError);
+  expect(() => failed.push("c")).toThrow(SyntaxError);
+  expect(() => failed.end()).toThrow(SyntaxError);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.ts b/csv.ts
--- a/csv.ts	2026-10-29 14:38:33.903791048 +0000
+++ b/csv.ts	2026-10-29 14:40:02.634769567 +0000
@@ -50,3 +50,111 @@
   rows.push(row);
   return rows;
 }
+
+type State = "fieldStart" | "unquoted" | "unquotedCr" | "quoted" | "quotedQuote" | "afterClose" | "afterCloseCr";
+
+/**
+ * parseCsv for input that arrives in chunks of any size: the rows from all calls together are parseCsv of the whole
+ * input, and each call does work in proportion to its own chunk. Errors are the ones parseCsv throws.
+ */
+export class CsvStream {
+  private state: State = "fieldStart";
+  private field = "";
+  private row: string[] = [];
+  private offset = 0;
+  private crAt = 0;
+  private ended = false;
+  private failed = false;
+
+  push(chunk: string): string[][] {
+    this.check();
+    const rows: string[][] = [];
+    try {
+      for (let i = 0; i < chunk.length; i++) this.char(chunk[i]!, this.offset++, rows);
+    } catch (e) {
+      this.failed = true;
+      throw e;
+    }
+    return rows;
+  }
+
+  end(): string[][] {
+    this.check();
+    const rows: string[][] = [];
+    try {
+      if (this.state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+      if (this.state === "afterCloseCr") throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.crAt}`);
+      if (this.state === "unquotedCr") this.field += "\r";
+      if (this.state !== "fieldStart" || this.row.length > 0) this.endField(rows, true);
+    } catch (e) {
+      this.failed = true;
+      throw e;
+    }
+    this.ended = true;
+    return rows;
+  }
+
+  private check() {
+    if (this.ended) throw new Error("CsvStream already ended");
+    if (this.failed) throw new SyntaxError("stream failed earlier");
+  }
+
+  private char(c: string, at: number, rows: string[][]) {
+    if (at === 0 && c === "\uFEFF") return;
+    switch (this.state) {
+      case "fieldStart":
+        if (c === '"') this.state = "quoted";
+        else {
+          this.state = "unquoted";
+          this.char(c, at, rows);
+        }
+        return;
+      case "unquoted":
+        if (c === '"') throw new SyntaxError(`a quote in a field that is not quoted, at offset ${at}`);
+        if (c === "\r") this.state = "unquotedCr";
+        else if (c === "," || c === "\n") this.endField(rows, c === "\n");
+        else this.field += c;
+        return;
+      case "unquotedCr":
+        if (c === "\n") return this.endField(rows, true);
+        this.field += "\r";
+        this.state = "unquoted";
+        this.char(c, at, rows);
+        return;
+      case "quoted":
+        if (c === '"') this.state = "quotedQuote";
+        else this.field += c;
+        return;
+      case "quotedQuote":
+        if (c === '"') {
+          this.field += '"';
+          this.state = "quoted";
+          return;
+        }
+        this.state = "afterClose";
+        this.char(c, at, rows);
+        return;
+      case "afterClose":
+        if (c === "\r") {
+          this.state = "afterCloseCr";
+          this.crAt = at;
+        } else if (c === "," || c === "\n") this.endField(rows, c === "\n");
+        else throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${at}`);
+        return;
+      case "afterCloseCr":
+        if (c !== "\n") throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.crAt}`);
+        this.endField(rows, true);
+        return;
+    }
+  }
+
+  private endField(rows: string[][], rowEnd: boolean) {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "fieldStart";
+    if (rowEnd) {
+      rows.push(this.row);
+      this.row = [];
+    }
+  }
+}
