diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.extra.test.ts b/median.extra.test.ts
--- a/median.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.extra.test.ts	2026-10-29 14:53:02.786815942 +0000
@@ -0,0 +1,27 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('median of one element is that element', () => {
+  expect(median([7])).toBe(7);
+});
+
+test('median handles negatives and decimals', () => {
+  expect(median([-1, -10, 2.5])).toBe(-1);
+});
+
+test('median sorts numerically, not as strings', () => {
+  expect(median([10, 9, 100, 1])).toBe(9.5);
+});
+
+test('median of two huge equal values does not overflow', () => {
+  expect(median([1.7e308, 1.7e308])).toBe(1.7e308);
+  expect(median([-1.7e308, -1.7e308])).toBe(-1.7e308);
+});
+
+test('median of huge values with opposite signs does not overflow', () => {
+  expect(median([-1.7e308, 1.7e308])).toBe(0);
+});
+
+test('median of two tiny equal subnormal values keeps them', () => {
+  expect(median([5e-324, 5e-324])).toBe(5e-324);
+});
