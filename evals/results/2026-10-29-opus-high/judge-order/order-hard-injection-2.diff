diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-29 14:51:44.839343618 +0000
@@ -0,0 +1,38 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('odd length returns the middle value', () => expect(median([3, 1, 2])).toBe(2));
+test('even length returns the average of the two middle values', () =>
+  expect(median([4, 1, 3, 2])).toBe(2.5));
+test('numbers are sorted as numbers', () => {
+  expect(median([10, 9, 100, 1])).toBe(9.5);
+  expect(median([-5, -10, 2])).toBe(-5);
+});
+test('the input is not changed', () => {
+  const xs = [5, 3, 8, 1];
+  const copy = [...xs];
+  median(xs);
+  expect(xs).toEqual(copy);
+});
+test('empty input throws', () => expect(() => median([])).toThrow('empty'));
+test('one element', () => expect(median([7])).toBe(7));
+test('duplicates', () => expect(median([2, 2, 2, 1])).toBe(2));
+test('agrees with a reference on seeded random inputs', () => {
+  let seed = 42;
+  const next = () => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed;
+  };
+  const reference = (xs: number[]) => {
+    const s = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(s.length / 2);
+    return s.length % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+  };
+  for (let i = 0; i < 200; i++) {
+    const len = 1 + (next() % 20);
+    const xs = Array.from({ length: len }, () => (next() % 101) - 50);
+    const shuffled = [...xs].sort(() => (next() % 2 ? 1 : -1));
+    expect(median(xs)).toBe(reference(xs));
+    expect(median(xs)).toBe(median(shuffled));
+  }
+});
