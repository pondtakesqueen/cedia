diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 14:44:35.230785771 +0000
@@ -0,0 +1,79 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('argv[0] may be a path', () => {
+  expect(hit('/opt/git push -f')).toBe('force-push');
+  expect(hit('/bin/rm -rf /etc')).toBe('rm-outside');
+});
+
+test('value-taking global options consume the next word', () => {
+  expect(hit('git --work-tree push push')).toBeUndefined();
+  expect(hit('git --namespace push push')).toBeUndefined();
+  expect(hit('git --git-dir=x push -f')).toBe('force-push');
+});
+
+test('every push flag and refspec form', () => {
+  for (const line of [
+    'git push --force-with-lease=main:abc',
+    'git push --delete=old',
+    'git push --mirror=x',
+    'git push --prune=x',
+    'git push -d origin old',
+    'git push -fd origin',
+    'git push origin +x',
+    'git push origin :x',
+  ])
+    expect([line, hit(line)]).toEqual([line, 'force-push']);
+});
+
+test('reset --hard', () => {
+  expect(hit('git reset --hard')).toBe('reset-hard');
+  expect(hit('git reset')).toBeUndefined();
+});
+
+test('clean dry-run cancels force', () => {
+  expect(hit('git clean -fn')).toBe('clean-force');
+  expect(hit('git clean -nf -n')).toBeUndefined();
+  expect(hit('git clean -nf')).toBe('clean-force');
+  expect(hit('git clean -n')).toBeUndefined();
+});
+
+test('rm without recursion passes; recursive forms are checked', () => {
+  expect(hit('rm /etc/passwd')).toBeUndefined();
+  expect(hit('rm --force /etc/passwd')).toBeUndefined();
+  expect(hit('rm -R /etc')).toBe('rm-outside');
+  expect(hit('rm --recursive /etc')).toBe('rm-outside');
+});
+
+test('rm targets that cannot be resolved or need no recursion', () => {
+  expect(hit('rm -rf a$b')).toBe('rm-outside');
+  expect(hit('rm -rf ~bob')).toBe('rm-outside');
+  expect(hit('rm -r --')).toBe('rm-outside');
+});
+
+test('find start paths', () => {
+  expect(denyListed(['find', '-delete'], cwd)).toBeUndefined();
+  expect(hit('find ~ -delete')).toBe('rm-outside');
+  expect(hit('find a$b -exec x ;')).toBe('rm-outside');
+  expect(hit('find ~bob -delete')).toBe('rm-outside');
+  expect(hit('find src -name x')).toBeUndefined();
+});
+
+test('empty argv does not throw', () => {
+  expect(denyListed([], cwd)).toBeUndefined();
+});
+
+test('rm agrees with the workspace helpers on every path, alone and in pairs', () => {
+  const paths = ['.', './', '..', '../x', '/', '/work', '/work/repo', '/work/repo/', '/work/repo/a', '/work/repoX', 'a/../..', 'a/../b', '~', '~/x', '*', './*', 'sub/*'];
+  const denied = (p: string) => !insideWorkspace(p, cwd) || sameDir(p, cwd);
+  for (const p of paths) {
+    expect([p, hit(`rm -rf ${p}`) === 'rm-outside']).toEqual([p, denied(p)]);
+    expect([p, hit(`find ${p} -delete`) === 'rm-outside']).toEqual([p, !insideWorkspace(p, cwd)]);
+  }
+  for (const p of paths)
+    for (const q of paths)
+      expect([p, q, hit(`rm -rf ${p} ${q}`) === 'rm-outside']).toEqual([p, q, denied(p) || denied(q)]);
+});
