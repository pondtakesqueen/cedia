@@ -1,5 +1,5 @@
 import { homedir } from 'node:os';
-import { isAbsolute, relative, resolve } from 'node:path';
+import { basename, isAbsolute, relative, resolve } from 'node:path';
 
 export type Hit = { name: 'force-push' | 'reset-hard' | 'clean-force' | 'rm-outside'; reason: string };
 
@@ -36,5 +36,60 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  if (argv.length === 0) return undefined;
+  const cmd = basename(argv[0]);
+  if (cmd === 'git') return gitHit(argv.slice(1));
+  if (cmd === 'rm') return rmHit(argv.slice(1), cwd);
+  if (cmd === 'find') return findHit(argv.slice(1), cwd);
+  return undefined;
+}
+
+// A short flag group such as -fu or -df: starts with one dash, not --, and contains one of `letters`.
+const shortGroup = (w: string, letters: string) => /^-[^-]/.test(w) && [...letters].some((l) => w.includes(l));
+
+// A path that cannot be resolved before it runs: contains $, or is ~user.
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+
+const gitValueOptions = ['-C', '-c', '--git-dir', '--work-tree', '--namespace'];
+const forceFlags = ['--force', '--force-with-lease', '--mirror', '--delete', '--prune'];
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += gitValueOptions.includes(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const w = rest.find((x) => forceFlags.some((f) => x === f || x.startsWith(f + '=')) || shortGroup(x, 'fd') || x.startsWith('+') || x.startsWith(':'));
+    return w === undefined ? undefined : { name: 'force-push', reason: `git push ${w} rewrites or deletes remote refs` };
+  }
+  if (sub === 'reset') {
+    return rest.includes('--hard') ? { name: 'reset-hard', reason: 'git reset --hard discards local changes' } : undefined;
+  }
+  if (sub === 'clean') {
+    if (rest.some((x) => x === '-n' || x === '--dry-run')) return undefined;
+    const w = rest.find((x) => x === '--force' || shortGroup(x, 'f'));
+    return w === undefined ? undefined : { name: 'clean-force', reason: `git clean ${w} deletes untracked files` };
+  }
+  return undefined;
+}
+
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const before = dd === -1 ? args : args.slice(0, dd);
+  const after = dd === -1 ? [] : args.slice(dd + 1);
+  const flags = before.filter((w) => w.startsWith('-'));
+  if (!flags.some((w) => w === '--recursive' || shortGroup(w, 'rR'))) return undefined;
+  const targets = [...before.filter((w) => !w.startsWith('-')), ...after];
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets (from xargs?)' };
+  const bad = targets.find((t) => unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `rm -r target ${bad} is outside the workspace` };
+}
+
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const firstDash = args.findIndex((w) => w.startsWith('-'));
+  const starts = firstDash === -1 ? args : args.slice(0, firstDash);
+  const paths = starts.length > 0 ? starts : ['.'];
+  const bad = paths.find((p) => unresolvable(p) || !insideWorkspace(p, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `find start path ${bad} is outside the workspace` };
 }
