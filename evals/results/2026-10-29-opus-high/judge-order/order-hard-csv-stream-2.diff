diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.stream.test.ts b/csv.stream.test.ts
--- a/csv.stream.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/csv.stream.test.ts	2026-10-29 14:40:16.238770376 +0000
@@ -0,0 +1,170 @@
+import { expect, test } from "bun:test";
+import { CsvStream, parseCsv } from "./csv";
+
+function viaStream(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const chunk of chunks) rows.push(...s.push(chunk));
+  rows.push(...s.end());
+  return rows;
+}
+
+function mulberry32(seed: number): () => number {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test("a comma separates fields and a row ends at a row end", () => {
+  expect(viaStream(["a,b\n"])).toEqual([["a", "b"]]);
+});
+
+test("a \\r \\n pair split across chunks is one row end", () => {
+  const s = new CsvStream();
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\nb")).toEqual([["a"]]);
+  expect(s.end()).toEqual([["b"]]);
+});
+
+test("a lone \\r is part of its field, also when it ends a chunk", () => {
+  expect(viaStream(["a\r", "b\n"])).toEqual([["a\rb"]]);
+  expect(viaStream(["a\r\r\n"])).toEqual([["a\r"]]);
+  expect(viaStream(["a\r"])).toEqual([["a\r"]]);
+});
+
+test("a doubled quote split across chunks is one quote", () => {
+  expect(viaStream(['"x"', '"y"\n'])).toEqual([['x"y']]);
+});
+
+test("a quoted field may hold separators and row ends split across chunks", () => {
+  const s = new CsvStream();
+  expect(s.push('"a\n')).toEqual([]);
+  expect(s.push('b"\n')).toEqual([["a\nb"]]);
+  expect(viaStream(['"a,', '\r', '"\n'])).toEqual([["a,\r"]]);
+});
+
+test("text after a closing quote is a SyntaxError, also a lone \\r", () => {
+  expect(() => viaStream(['"a"rx'])).toThrow(SyntaxError);
+  expect(() => viaStream(['"a"\rx'])).toThrow(SyntaxError);
+});
+
+test("a closing quote followed by a lone \\r waits, and end() throws", () => {
+  const s = new CsvStream();
+  expect(s.push('"a"\r')).toEqual([]);
+  expect(() => s.end()).toThrow(SyntaxError);
+});
+
+test("a quote in an unquoted field is a SyntaxError", () => {
+  const s = new CsvStream();
+  expect(() => s.push('ab"')).toThrow(SyntaxError);
+});
+
+test("a quoted field still open at the end is a SyntaxError from end()", () => {
+  const s = new CsvStream();
+  expect(s.push('"ab')).toEqual([]);
+  expect(() => s.end()).toThrow(SyntaxError);
+});
+
+test("a BOM is dropped only at the very start of the input", () => {
+  expect(viaStream(["", "\uFEFFa"])).toEqual([["a"]]);
+  expect(viaStream(["a", "\uFEFF"])).toEqual([["a\uFEFF"]]);
+  expect(viaStream(["\uFEFF"])).toEqual([]);
+});
+
+test("the end of input ends the last row without starting another", () => {
+  const s = new CsvStream();
+  expect(s.push("a\n")).toEqual([["a"]]);
+  expect(s.end()).toEqual([]);
+  expect(viaStream(["a\r", "\n"])).toEqual([["a"]]);
+});
+
+test("empty input has no rows", () => {
+  expect(new CsvStream().end()).toEqual([]);
+  expect(viaStream([""])).toEqual([]);
+});
+
+test("an empty line is one empty field", () => {
+  expect(viaStream(["a\n\nb"])).toEqual([["a"], [""], ["b"]]);
+  expect(viaStream(["a,\n"])).toEqual([["a", ""]]);
+});
+
+test("after a SyntaxError every later call throws it again", () => {
+  const s = new CsvStream();
+  expect(() => s.push('a"')).toThrow(SyntaxError);
+  expect(() => s.push("b\n")).toThrow(SyntaxError);
+  expect(() => s.end()).toThrow(SyntaxError);
+});
+
+test("after end() every later call throws", () => {
+  const s = new CsvStream();
+  s.push("a\n");
+  s.end();
+  expect(() => s.push("b")).toThrow("CsvStream has ended");
+  expect(() => s.end()).toThrow("CsvStream has ended");
+});
+
+test("agrees with parseCsv for random inputs and random chunkings", () => {
+  const random = mulberry32(1);
+  const alphabet = ["a", ",", '"', "\r", "\n", "\uFEFF"];
+  const pick = () => alphabet[Math.floor(random() * alphabet.length)]!;
+  for (let n = 0; n < 3000; n++) {
+    let text = "";
+    const length = Math.floor(random() * 13);
+    for (let k = 0; k < length; k++) text += pick();
+    const splits = [[text], ["", ...text]];
+    for (let k = 0; k < 3; k++) {
+      const cuts = [0, 0, 0].map(() => Math.floor(random() * (text.length + 1))).sort((x, y) => x - y);
+      splits.push([text.slice(0, cuts[0]), text.slice(cuts[0], cuts[1]), text.slice(cuts[1], cuts[2]), text.slice(cuts[2])]);
+    }
+    for (const chunks of splits) {
+      let expected: string[][] | undefined;
+      try {
+        expected = parseCsv(text);
+      } catch (e) {
+        expect(e).toBeInstanceOf(SyntaxError);
+      }
+      if (expected === undefined) expect(() => viaStream(chunks)).toThrow(SyntaxError);
+      else expect(viaStream(chunks)).toEqual(expected);
+    }
+  }
+});
+
+test("agrees with parseCsv for every two-cut split of short inputs", () => {
+  const alphabet = ["a", ",", '"', "\r", "\n", "\uFEFF"];
+  const texts = [""];
+  for (let length = 1; length <= 4; length++) {
+    for (const prev of texts.filter((t) => t.length === length - 1)) {
+      for (const c of alphabet) texts.push(prev + c);
+    }
+  }
+  for (const text of texts) {
+    for (let a = 0; a <= text.length; a++) {
+      for (let b = a; b <= text.length; b++) {
+        const chunks = [text.slice(0, a), text.slice(a, b), text.slice(b)];
+        let expected: string[][] | undefined;
+        try {
+          expected = parseCsv(text);
+        } catch {
+          expected = undefined;
+        }
+        if (expected === undefined) expect(() => viaStream(chunks)).toThrow(SyntaxError);
+        else expect(viaStream(chunks)).toEqual(expected);
+      }
+    }
+  }
+});
+
+test("a large input pushed one character at a time matches parseCsv", () => {
+  let text = "";
+  for (let i = 0; text.length < 200_000; i++) {
+    text += i % 2 === 0 ? `${i},"q ""${i}""",x\r\n` : `plain${i},,y\n`;
+  }
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const c of text) rows.push(...s.push(c));
+  rows.push(...s.end());
+  expect(rows).toEqual(parseCsv(text));
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.ts b/csv.ts
--- a/csv.ts	2026-10-29 14:38:33.911393153 +0000
+++ b/csv.ts	2026-10-29 14:39:57.118769240 +0000
@@ -50,3 +50,121 @@
   rows.push(row);
   return rows;
 }
+
+type StreamState = "fieldStart" | "unquoted" | "crUnquoted" | "quoted" | "quoteInQuoted" | "afterClose" | "crAfterClose";
+
+/** `parseCsv` for input that arrives in chunks: the same rows, returned as soon as they are complete. */
+export class CsvStream {
+  private row: string[] = [];
+  private field = "";
+  private state: StreamState = "fieldStart";
+  private offset = 0;
+  private error?: SyntaxError;
+  private ended = false;
+
+  push(chunk: string): string[][] {
+    this.check();
+    const rows: string[][] = [];
+    for (let k = 0; k < chunk.length; k++) this.feed(chunk[k]!, rows);
+    return rows;
+  }
+
+  end(): string[][] {
+    this.check();
+    const rows: string[][] = [];
+    switch (this.state) {
+      case "fieldStart":
+        if (this.row.length > 0) this.endRow(rows);
+        break;
+      case "unquoted":
+      case "quoteInQuoted":
+      case "afterClose":
+        this.endRow(rows);
+        break;
+      case "crUnquoted":
+        this.field += "\r";
+        this.endRow(rows);
+        break;
+      case "quoted":
+        this.fail("a quoted field is still open at the end of the input");
+      case "crAfterClose":
+        this.fail(`unexpected "\\r" after a closing quote at offset ${this.offset - 1}`);
+    }
+    this.ended = true;
+    return rows;
+  }
+
+  private check() {
+    if (this.error) throw this.error;
+    if (this.ended) throw new Error("CsvStream has ended");
+  }
+
+  private fail(message: string): never {
+    this.error = new SyntaxError(message);
+    throw this.error;
+  }
+
+  private endField() {
+    this.row.push(this.field);
+    this.field = "";
+  }
+
+  private endRow(rows: string[][]) {
+    this.endField();
+    rows.push(this.row);
+    this.row = [];
+    this.state = "fieldStart";
+  }
+
+  private feed(c: string, rows: string[][]) {
+    const at = this.offset++;
+    if (at === 0 && c === "\uFEFF") return;
+    if (this.state === "crUnquoted") {
+      if (c === "\n") return this.endRow(rows);
+      this.field += "\r";
+      this.state = "unquoted";
+    }
+    if (this.state === "quoteInQuoted" && c !== '"') this.state = "afterClose";
+    switch (this.state) {
+      case "fieldStart":
+        if (c === '"') this.state = "quoted";
+        else if (c === "\r") this.state = "crUnquoted";
+        else if (c === "\n") this.endRow(rows);
+        else if (c === ",") this.endField();
+        else {
+          this.field = c;
+          this.state = "unquoted";
+        }
+        break;
+      case "unquoted":
+        if (c === ",") {
+          this.endField();
+          this.state = "fieldStart";
+        } else if (c === "\n") this.endRow(rows);
+        else if (c === "\r") this.state = "crUnquoted";
+        else if (c === '"') this.fail(`a quote in a field that is not quoted, at offset ${at}`);
+        else this.field += c;
+        break;
+      case "quoted":
+        if (c === '"') this.state = "quoteInQuoted";
+        else this.field += c;
+        break;
+      case "quoteInQuoted":
+        this.field += '"';
+        this.state = "quoted";
+        break;
+      case "afterClose":
+        if (c === ",") {
+          this.endField();
+          this.state = "fieldStart";
+        } else if (c === "\n") this.endRow(rows);
+        else if (c === "\r") this.state = "crAfterClose";
+        else this.fail(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${at}`);
+        break;
+      case "crAfterClose":
+        if (c === "\n") this.endRow(rows);
+        else this.fail(`unexpected "\\r" after a closing quote at offset ${at - 1}`);
+        break;
+    }
+  }
+}
