diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 15:08:37.930199191 +0000
@@ -0,0 +1,92 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { percentOf } from '../src/money/round.ts';
+import { totals } from '../src/order/total.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('rule 1: a line subtotal is unit price times quantity', () => {
+    expect(totals(cart('US', [['MUG', 2]])).lines[0]).toMatchObject({ subtotal: 900, discount: 0 });
+  });
+
+  test('rule 2: 10 units get 5% off the line', () => {
+    // 10 pens = 1200, 5% off = 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('rule 2: 9 units get no discount', () => {
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]).toMatchObject({ discount: 0 });
+  });
+
+  test('rule 2: 49 units get 5% only', () => {
+    // 49 pens = 5880, 5% off = 5586; free shipping; tax 7% of 5586 = 391.02 -> 391
+    expect(totals(cart('US', [['PEN', 49]]))).toMatchObject({ subtotal: 5586, shipping: 0, tax: 391, total: 5977 });
+  });
+
+  test('rule 2: 50 units get 10% only, tiers do not stack', () => {
+    // 50 pens = 6000, 10% off = 5400; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('rule 2: lines of the same sku are merged before pricing', () => {
+    const split = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+    expect(split).toMatchObject(totals(cart('US', [['PEN', 10]])));
+    expect(split.lines.length).toBe(1);
+  });
+
+  test('rule 2: merging does not change the caller cart', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    totals(c);
+    expect(c.lines.map((l) => l.quantity)).toEqual([6, 4]);
+  });
+
+  test('rule 3: the coupon applies after bulk discounts', () => {
+    // 1140 after bulk, SAVE10 takes 114, discounted 1026; tax 7% of 1826 = 127.82 -> 128
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10'))).toMatchObject({ coupon: 114, tax: 128, total: 1954 });
+  });
+
+  test('rule 3: FLAT5 never takes more than the amount', () => {
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('rule 4: shipping uses the discounted subtotal, so a coupon can bring it back under the threshold', () => {
+    // 5200 - FLAT5 = 4700 < 5000, so shipping is charged; tax 7% of 5500 = 385
+    expect(totals(cart('US', [['BAG', 1], ['TEE', 2]], 'FLAT5'))).toMatchObject({ subtotal: 5200, coupon: 500, shipping: 800, tax: 385, total: 5885 });
+  });
+
+  test('rule 4: a discounted subtotal exactly at the threshold ships free', () => {
+    // 4400 + 600 = 5000 exactly; tax 7% of 5000 = 350
+    expect(totals(cart('US', [['BAG', 2], ['PEN', 5]]))).toMatchObject({ subtotal: 5000, shipping: 0, tax: 350, total: 5350 });
+  });
+
+  test('region table: UK free shipping starts at 4000', () => {
+    // 4200 >= 4000; tax 20% of 4200 = 840
+    expect(totals(cart('UK', [['TEE', 2], ['CAP', 1]]))).toMatchObject({ subtotal: 4200, shipping: 0, tax: 840, total: 5040 });
+  });
+
+  test('region table: each region has the README rates and thresholds', () => {
+    expect(REGIONS.US).toMatchObject({ taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+    expect(REGIONS.EU).toMatchObject({ taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+    expect(REGIONS.UK).toMatchObject({ taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+
+  test('rule 5: percentOf rounds half up exactly, in integer maths', () => {
+    for (const rate of [0.05, 0.07, 0.1, 0.2]) {
+      const bp = Math.round(rate * 10000);
+      for (let a = 0; a <= 20000; a++) {
+        expect(percentOf(a, rate)).toBe(Math.floor((a * bp + 5000) / 10000));
+      }
+    }
+  });
+
+  test('rule 6: total is discounted subtotal + shipping + tax', () => {
+    for (const t of [
+      totals(cart('US', [['PEN', 10]], 'SAVE10')),
+      totals(cart('EU', [['MUG', 3], ['CAP', 2]], 'FLAT5')),
+      totals(cart('UK', [['BAG', 50]])),
+    ]) {
+      expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+    }
+  });
+});
