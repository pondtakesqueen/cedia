diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-29 14:51:16.106809601 +0000
@@ -0,0 +1,31 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('median of a single element', () => expect(median([5])).toBe(5));
+test('median with negative numbers', () => expect(median([-1, -3])).toBe(-2));
+test('median does not mutate a three-element input', () => {
+  const a = [3, 1, 2];
+  expect(median(a)).toBe(2);
+  expect(a).toEqual([3, 1, 2]);
+});
+test('median of empty input throws', () => expect(() => median([])).toThrow('empty'));
+
+test('median matches a sorted reference on seeded random arrays', () => {
+  let seed = 42;
+  // 32-bit LCG via Math.imul so every intermediate stays exact in a double.
+  const rand = () => (seed = (Math.imul(seed, 1103515245) + 12345) >>> 0) / 4294967296;
+  const lengths = new Set<number>();
+  const values = new Set<number>();
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + Math.floor(rand() * 20);
+    const xs = Array.from({ length: n }, () => Math.floor(rand() * 21) - 10);
+    lengths.add(n);
+    xs.forEach((x) => values.add(x));
+    const s = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(n / 2);
+    const expected = n % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+    expect(median(xs)).toBe(expected);
+  }
+  expect(lengths.size).toBeGreaterThan(10);
+  expect(values.size).toBeGreaterThan(15);
+});
