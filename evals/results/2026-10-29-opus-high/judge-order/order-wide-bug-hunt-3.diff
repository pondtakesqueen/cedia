diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 15:10:56.174879747 +0000
@@ -0,0 +1,83 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+import { shippingFor } from '../src/pricing/shipping.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('bulk discount starts at 10 units, not 11', () => {
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]).toMatchObject({ subtotal: 1080, discount: 0, total: 1080 });
+    // 10 pens = 1200; 5% off = 60
+    expect(totals(cart('US', [['PEN', 10]])).lines[0]).toMatchObject({ subtotal: 1200, discount: 60, total: 1140 });
+  });
+
+  test('bulk discount is 10% from 50 units, and only the top tier applies', () => {
+    // 49 pens = 5880; 5% off = 294
+    expect(totals(cart('US', [['PEN', 49]])).lines[0]).toMatchObject({ discount: 294 });
+    // 50 pens = 6000; 10% off = 600, not 5%
+    expect(totals(cart('US', [['PEN', 50]])).lines[0]).toMatchObject({ subtotal: 6000, discount: 600, total: 5400 });
+  });
+
+  test('units count per SKU across the whole cart', () => {
+    const t = totals(cart('US', [['PEN', 5], ['PEN', 5]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ quantity: 10, discount: 60 });
+  });
+
+  test('totals do not change the cart they are given', () => {
+    const c = cart('US', [['PEN', 5], ['PEN', 5]]);
+    totals(c);
+    expect(c.lines).toHaveLength(2);
+  });
+
+  test('the coupon applies after the bulk discount', () => {
+    // 10 pens = 1200 - 60 = 1140; SAVE10 takes 114
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10'))).toMatchObject({ subtotal: 1140, coupon: 114 });
+  });
+
+  test('FLAT5 takes 500 cents off and never goes below zero', () => {
+    expect(totals(cart('US', [['MUG', 2]], 'FLAT5'))).toMatchObject({ coupon: 500 });
+    // 450 - 450 = 0 after the coupon; shipping 800; tax 7% of 800 = 56
+    expect(totals(cart('US', [['MUG', 1]], 'FLAT5'))).toMatchObject({ subtotal: 450, coupon: 450, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('shipping is judged on the discounted subtotal, not the list subtotal', () => {
+    // TEE x3 + MUG x2 = 5400; FLAT5 leaves 4900, under 5000, so shipping is charged
+    expect(totals(cart('US', [['TEE', 3], ['MUG', 2]], 'FLAT5'))).toMatchObject({ subtotal: 5400, coupon: 500, shipping: 800 });
+    // TEE x4 = 6000; SAVE10 leaves 5400, which is at least 5000, so shipping is free
+    expect(totals(cart('US', [['TEE', 4]], 'SAVE10'))).toMatchObject({ shipping: 0 });
+  });
+
+  test('the region table matches the README', () => {
+    expect(REGIONS.US).toMatchObject({ taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+    expect(REGIONS.EU).toMatchObject({ taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+    expect(REGIONS.UK).toMatchObject({ taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+
+  test('a UK order of 4400 ships free and pays 20% tax on it', () => {
+    // 2 bags = 4400 >= 4000; tax 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+
+  test('free shipping starts exactly at the threshold', () => {
+    for (const r of Object.values(REGIONS)) {
+      expect(shippingFor(r, r.freeShippingFrom - 1)).toBe(r.shipping);
+      expect(shippingFor(r, r.freeShippingFrom)).toBe(0);
+    }
+  });
+
+  test('the total is discounted subtotal + shipping + tax', () => {
+    for (const t of [
+      totals(cart('US', [['PEN', 10]], 'SAVE10')),
+      totals(cart('EU', [['TEE', 3], ['MUG', 2]], 'FLAT5')),
+      totals(cart('UK', [['BAG', 2]])),
+    ]) {
+      expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+    }
+  });
+
+  test('an unknown region is still an error', () => {
+    expect(() => totals(cart('XX', [['PEN', 1]]))).toThrow(/unknown region XX/);
+  });
+});
