+type Outcome<T> = { ok: true; value: T } | { ok: false; reason: unknown };
+
+// Calls a task and always hands back a promise of its outcome, so sync throws and plain values follow the same
+// (asynchronous) path as promises. Only real promises are awaited; anything else is the fulfilment value itself.
+function call<T>(task: () => Promise<T> | T): Promise<Outcome<T>> {
+  let returned: Promise<T> | T;
+  try {
+    returned = task();
+  } catch (reason) {
+    return Promise.resolve({ ok: false, reason });
+  }
+  if (!(returned instanceof Promise)) return Promise.resolve({ ok: true, value: returned });
+  // Adopt through a fresh native promise so a misbehaving subclass `then` can settle us at most once.
+  return new Promise<T>((res) => res(returned)).then(
+    (value): Outcome<T> => ({ ok: true, value }),
+    (reason): Outcome<T> => ({ ok: false, reason }),
+  );
+}
