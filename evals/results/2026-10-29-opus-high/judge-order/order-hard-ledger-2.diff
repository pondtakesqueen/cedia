 }
 
 // changed: every write's label (path, or `bash: <command>`), first seen first, no duplicates.
 // checks: every check entry, in order, as { command, exitCode }.
 // unverified: labels of writes after the last passing check (all of them when no check passed), deduped.
 export function evidence(entries: LedgerEntry[]): Evidence {
-  throw new Error('not implemented');
+  const label = (w: LedgerEntry & { kind: 'write' }) => w.path ?? `bash: ${w.command}`;
+  const dedupe = (xs: string[]) => [...new Set(xs)];
+  const writes = entries.flatMap((e, i) => (e.kind === 'write' ? [{ i, label: label(e) }] : []));
+  const lastPass = entries.findLastIndex((e) => e.kind === 'check' && e.exitCode === 0);
+  return {
+    changed: dedupe(writes.map((w) => w.label)),
+    checks: entries.flatMap((e) => (e.kind === 'check' ? [{ command: e.command, exitCode: e.exitCode }] : [])),
+    unverified: dedupe(writes.filter((w) => w.i > lastPass).map((w) => w.label)),
+  };
 }
 
 // The done gate. With no declared checks, or no writes, it is satisfied. Otherwise a check with exit code 0
 // must come after the last write.
 export function verified(entries: LedgerEntry[], checks: string[]): boolean {
-  throw new Error('not implemented');
+  if (checks.length === 0) return true;
+  const lastWrite = entries.findLastIndex((e) => e.kind === 'write');
+  if (lastWrite === -1) return true;
+  return entries.findLastIndex((e) => e.kind === 'check' && e.exitCode === 0) > lastWrite;
 }
