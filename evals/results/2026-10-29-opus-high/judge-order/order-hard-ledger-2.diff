 // - Otherwise an edit or write call that completed is a write entry with path = input.path.
 // - Otherwise a bash call whose command is not read-only is a write entry with command set (no path).
 export function ledgerEntries(events: SessionEvent[], checks: string[], cwd?: string): LedgerEntry[] {
-  throw new Error('not implemented');
+  const snaps = new Map<string, string[]>();
+  for (const e of events) if (e.kind === 'snapshot' && e.callId !== undefined) snaps.set(e.callId, [...(snaps.get(e.callId) ?? []), ...e.changed]);
+  const entries: LedgerEntry[] = [];
+  let intents = new Map<string, { tool: string; input: Record<string, unknown> }>();
+  events.forEach((e, at) => {
+    if (e.kind === 'request') intents = new Map();
+    else if (e.kind === 'tool_intent') intents.set(e.callId, { tool: e.tool, input: e.input });
+    else if (e.kind === 'tool_result') {
+      const intent = intents.get(e.callId);
+      if (!intent || e.status === 'denied' || e.status === 'not_started') return;
+      const { tool, input } = intent;
+      const command = tool === 'bash' && typeof input.command === 'string' ? input.command : undefined;
+      const check = command === undefined ? undefined : matchCheck(command, checks, cwd);
+      if (check !== undefined) {
+        const exitCode = e.output.exitCode ?? (e.output.isError ? 1 : 0);
+        entries.push({ kind: 'check', at, command: check, exitCode });
+      } else if (snaps.has(e.callId)) {
+        for (const path of snaps.get(e.callId)!) entries.push({ kind: 'write', at, tool, path });
+      } else if ((tool === 'edit' || tool === 'write') && e.status === 'completed') {
+        entries.push({ kind: 'write', at, tool, path: input.path as string });
+      } else if (command !== undefined && !isReadOnly(command)) {
+        entries.push({ kind: 'write', at, tool, command });
+      }
+    }
+  });
