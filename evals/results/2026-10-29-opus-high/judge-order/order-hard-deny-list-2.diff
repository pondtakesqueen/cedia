@@ -36,5 +36,65 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  if (argv.length === 0) return undefined;
+  const cmd = basename(argv[0]);
+  if (cmd === 'git') return gitHit(argv.slice(1));
+  if (cmd === 'rm') return rmHit(argv.slice(1), cwd);
+  if (cmd === 'find') return findHit(argv.slice(1), cwd);
+  return undefined;
+}
+
+const GIT_VALUE_OPTS = ['-C', '-c', '--git-dir', '--work-tree', '--namespace'];
+const PUSH_FORCE_OPTS = ['--force', '--force-with-lease', '--mirror', '--delete', '--prune'];
+
+const isShortGroup = (w: string) => w.startsWith('-') && !w.startsWith('--') && w.length > 1;
+
+// A long option as written, or abbreviated to a prefix of its full name (--rec for --recursive); a value after = is ignored.
+const isOpt = (w: string, full: string) => {
+  const name = w.split('=')[0];
+  return name.length > 2 && name.startsWith('--') && full.startsWith(name);
+};
+
+// A path that cannot be resolved before it runs: contains $, or is ~user.
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+
+const isForcePush = (w: string) =>
+  PUSH_FORCE_OPTS.some(o => isOpt(w, o)) || (isShortGroup(w) && /[fd]/.test(w)) || (!w.startsWith('-') && /^[+:]/.test(w));
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += GIT_VALUE_OPTS.includes(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push' && rest.some(isForcePush))
+    return { name: 'force-push', reason: 'git push --force rewrites remote history' };
+  if (sub === 'reset' && rest.some(w => isOpt(w, '--hard')))
+    return { name: 'reset-hard', reason: 'git reset --hard discards uncommitted changes' };
+  if (sub === 'clean') {
+    const force = rest.some(w => isOpt(w, '--force') || (isShortGroup(w) && w.includes('f')));
+    const dry = rest.some(w => w === '-n' || isOpt(w, '--dry-run'));
+    if (force && !dry) return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  }
+  return undefined;
+}
+
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const sep = args.indexOf('--');
+  const before = sep < 0 ? args : args.slice(0, sep);
+  const after = sep < 0 ? [] : args.slice(sep + 1);
+  const flags = before.filter(w => w.startsWith('-'));
+  const targets = [...before.filter(w => !w.startsWith('-')), ...after];
+  const recursive = flags.some(w => isOpt(w, '--recursive') || (isShortGroup(w) && /[rR]/.test(w)));
+  if (!recursive) return undefined;
+  const bad = targets.length === 0 || targets.some(t => unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd));
+  return bad ? { name: 'rm-outside', reason: 'rm -r outside the working directory' } : undefined;
+}
+
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some(w => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const firstOpt = args.findIndex(w => w.startsWith('-'));
+  const starts = args.slice(0, firstOpt);
+  const roots = starts.length > 0 ? starts : ['.'];
+  const bad = roots.some(r => unresolvable(r) || !insideWorkspace(r, cwd));
+  return bad ? { name: 'rm-outside', reason: 'find -delete or -exec outside the working directory' } : undefined;
 }
