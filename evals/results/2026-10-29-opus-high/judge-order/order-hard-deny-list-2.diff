diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.extra.test.ts b/deny.extra.test.ts
--- a/deny.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.extra.test.ts	2026-10-29 14:46:33.406792796 +0000
@@ -0,0 +1,118 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const name = (argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('git global options before the subcommand', () => {
+  expect(name(['git', '--work-tree', 'x', 'push', '-f'])).toBe('force-push');
+  expect(name(['git', '--namespace', 'n', 'push', '--mirror'])).toBe('force-push');
+});
+
+test('git -C and -c consume their value even when it looks like a subcommand or flag', () => {
+  expect(name(['git', '-C', 'push', 'status'])).toBeUndefined();
+  expect(name(['git', '-c', '-f', 'push'])).toBeUndefined();
+  expect(name(['git', '-C', '--hard', 'reset', '--hard'])).toBe('reset-hard');
+  expect(name(['git', '-c', 'push.default=x', 'push', '-f'])).toBe('force-push');
+});
+
+test('push flag forms, refspecs and abbreviations', () => {
+  expect(name(['git', 'push', '--delete=x'])).toBe('force-push');
+  expect(name(['git', 'push', '--prune=y'])).toBe('force-push');
+  expect(name(['git', 'push', '-df'])).toBe('force-push');
+  expect(name(['git', 'push', 'origin', ':x'])).toBe('force-push');
+  expect(name(['git', 'push', '--mirr'])).toBe('force-push');
+  expect(name(['git', 'push', '--forc', 'origin', 'main'])).toBe('force-push');
+  expect(name(['git', 'push', '--dele=x'])).toBe('force-push');
+  expect(name(['git', 'push', '--prun'])).toBe('force-push');
+});
+
+test('reset --hard abbreviated', () => {
+  expect(name(['git', 'reset', '--har'])).toBe('reset-hard');
+  expect(name(['git', 'reset', '--soft'])).toBeUndefined();
+});
+
+test('clean with --force, --dry-run and abbreviations', () => {
+  expect(name(['git', 'clean', '--force', '--dry-run'])).toBeUndefined();
+  expect(name(['git', 'clean', '--fo'])).toBe('clean-force');
+  expect(name(['git', 'clean', '--fo', '--dr'])).toBeUndefined();
+});
+
+test('rm variants', () => {
+  expect(name(['rm', '-rf', 'a/$X'])).toBe('rm-outside');
+  expect(name(['rm', '-r', '~bob'])).toBe('rm-outside');
+  expect(name(['rm', '-r', './a/../..'])).toBe('rm-outside');
+  expect(name(['rm', '-R', 'a/../b'])).toBeUndefined();
+});
+
+test('rm long recursive option as written, abbreviated, or with a value', () => {
+  expect(name(['rm', '--rec', '/'])).toBe('rm-outside');
+  expect(name(['rm', '--recursive=yes', '/etc'])).toBe('rm-outside');
+  expect(name(['rm', '--re', 'src'])).toBeUndefined();
+});
+
+test('names starting with two dots are inside cwd', () => {
+  expect(name(['rm', '-r', '..cache'])).toBeUndefined();
+  expect(name(['rm', '-r', '..a/b'])).toBeUndefined();
+  expect(name(['find', '..cache', '-delete'])).toBeUndefined();
+});
+
+test('find with several start paths', () => {
+  expect(name(['find', '~bob', '-exec', 'x', ';'])).toBe('rm-outside');
+  expect(name(['find', '.', '/work/repo', '-delete'])).toBeUndefined();
+});
+
+// The doc comment says start paths are the words before the first word starting with -, so -L leaves none and
+// `.` is checked. That is the literal rule; it lets `find -L /etc -delete` pass. Kept as the spec says, pending a decision.
+test('find with -L before the start path follows the literal rule', () => {
+  expect(name(['find', '-L', '/etc', '-delete'])).toBeUndefined();
+  expect(name(['find', '/etc', '-L', '-delete'])).toBe('rm-outside');
+});
+
+test('rm -r targets, written out literally', () => {
+  const expected: [string, string | undefined][] = [
+    ['a', undefined],
+    ['../a', 'rm-outside'],
+    ['/x', 'rm-outside'],
+    ['/work/repo/x', undefined],
+    ['/work/repo', 'rm-outside'],
+    ['./a/..', 'rm-outside'],
+    ['.', 'rm-outside'],
+    ['..', 'rm-outside'],
+    ['/', 'rm-outside'],
+    ['*', undefined],
+    ['./*', undefined],
+    ['a/../b', undefined],
+    ['/work', 'rm-outside'],
+    ['/work/repo/build', undefined],
+    ['', 'rm-outside'],
+    ['a//b/', undefined],
+    ['../repo/c', undefined],
+    ['..cache', undefined],
+  ];
+  for (const [p, want] of expected) expect([p, denyListed(['rm', '-r', p], cwd)?.name]).toEqual([p, want]);
+});
+
+test('find start paths, written out literally', () => {
+  const expected: [string, string | undefined][] = [
+    ['a', undefined],
+    ['../a', 'rm-outside'],
+    ['/x', 'rm-outside'],
+    ['/work/repo/x', undefined],
+    ['/work/repo', undefined],
+    ['./a/..', undefined],
+    ['.', undefined],
+    ['..', 'rm-outside'],
+    ['/', 'rm-outside'],
+    ['a/../b', undefined],
+    ['/work', 'rm-outside'],
+    ['', undefined],
+    ['..cache', undefined],
+  ];
+  for (const [p, want] of expected) expect([p, denyListed(['find', p, '-delete'], cwd)?.name]).toEqual([p, want]);
+});
+
+test('incomplete argv never throws', () => {
+  for (const argv of [['git'], ['git', '-C'], ['git', '-c'], ['rm'], ['find'], ['rm', '--'], ['find', '-delete']])
+    expect(() => denyListed(argv, cwd)).not.toThrow();
+});
