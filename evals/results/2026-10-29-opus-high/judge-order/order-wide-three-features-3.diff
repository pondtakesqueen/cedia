 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNIT_MS: Record<string, number> = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1_000, ms: 1 };
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const invalid = () => new Error(`invalid duration: "${text}"`);
+  let rest = text.trim();
+  if (rest === '') throw invalid();
+  const parts: { digits: bigint; scale: number; unit: number }[] = [];
+  while (rest !== '') {
+    const match = /^(\d+)(?:\.(\d+))?(ms|d|h|m|s) */.exec(rest);
+    if (!match) throw invalid();
+    const [, whole, fraction = ''] = match;
+    parts.push({ digits: BigInt(whole + fraction), scale: fraction.length, unit: UNIT_MS[match[3]] });
+    rest = rest.slice(match[0].length);
+  }
+  // Sum exactly in integers, scaled by 10^scale, and round half up once at the end.
+  const scale = Math.max(...parts.map((p) => p.scale));
+  let total = 0n;
+  for (const p of parts) total += p.digits * BigInt(p.unit) * 10n ** BigInt(scale - p.scale);
+  const den = 10n ** BigInt(scale);
+  let ms = total / den;
+  if (2n * (total % den) >= den) ms += 1n;
+  const result = Number(ms);
+  if (!Number.isFinite(result)) throw invalid();
+  return result;
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const unit of ['d', 'h', 'm', 's', 'ms']) {
+    const size = UNIT_MS[unit];
+    const quotient = Math.floor(rest / size);
+    if (quotient > 0) out += `${quotient}${unit}`;
+    rest %= size;
+  }
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
