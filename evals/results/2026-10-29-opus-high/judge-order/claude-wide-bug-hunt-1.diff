diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/rules.test.ts b/test/rules.test.ts
--- a/test/rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/rules.test.ts	2026-10-29 09:01:33.878635109 +0000
@@ -0,0 +1,57 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { bulkDiscount } from '../src/pricing/discounts/bulk.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('regions match the README table', () => {
+    expect(REGIONS).toEqual({
+      US: { code: 'US', taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 },
+      EU: { code: 'EU', taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 },
+      UK: { code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 },
+    });
+  });
+
+  test('a UK order of exactly 4000 ships free', () => {
+    // 1 BAG + 1 CAP + 5 PEN = 2200 + 1200 + 600 = 4000 >= 4000
+    // tax 20% of 4000 = 800
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+
+  test('bulk tiers start at exactly 10 and 50 units', () => {
+    expect(bulkDiscount(9, 1000)).toBe(0);
+    expect(bulkDiscount(10, 1000)).toBe(50);
+    expect(bulkDiscount(49, 1000)).toBe(50);
+    expect(bulkDiscount(50, 1000)).toBe(100);
+  });
+
+  test('10 pens get 5% off the line', () => {
+    // 10 x 120 = 1200, bulk 60 -> 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('lines of the same sku are merged before the bulk discount', () => {
+    // 6 + 4 pens = 10 pens -> same as one line of 10
+    const t = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('merging does not change the cart passed in', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    totals(c);
+    expect(c.lines.map((l) => l.quantity)).toEqual([6, 4]);
+  });
+
+  test('free shipping is judged on the subtotal after the coupon', () => {
+    // EU: 3 BAG = 6600 >= 6000, but SAVE10 takes 660 -> 5940 < 6000, so shipping 900; tax 20% of 6840 = 1368
+    expect(totals(cart('EU', [['BAG', 3]], 'SAVE10'))).toMatchObject({ subtotal: 6600, coupon: 660, shipping: 900, tax: 1368, total: 8208 });
+  });
+
+  test('FLAT5 pushing an order under the threshold brings shipping back', () => {
+    // UK: 1 BAG + 1 CAP + 5 PEN = 4000; FLAT5 -> 3500 < 4000, shipping 700; tax 20% of 4200 = 840
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]], 'FLAT5'))).toMatchObject({ coupon: 500, shipping: 700, tax: 840, total: 5040 });
+  });
+});
