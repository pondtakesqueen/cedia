+++ b/src/slug.ts	2026-10-29 15:14:39.222768022 +0000
@@ -11,10 +11,24 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const LETTERS: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => LETTERS[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (s[max] === '-') return s.slice(0, max);
+  const i = s.lastIndexOf('-', max - 1);
+  return i > 0 ? s.slice(0, i) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  let out = slug;
+  for (let n = 2; taken.has(out); n++) out = `${slug}-${n}`;
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 15:13:21.506888386 +0000
@@ -0,0 +1,39 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parse units and combinations', () => {
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('1h30m')).toBe(5_400_000);
+  expect(parseDuration('  1h  ')).toBe(3_600_000);
+});
+
+test('parse rounds to whole milliseconds', () => {
+  expect(parseDuration('1.0004s')).toBe(1000);
+});
+
+test('parse rejects malformed input and names the input', () => {
+  for (const bad of ['', '10', '5x', 'h', '-1s', '1h x', '1 m']) {
+    expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+  }
+});
+
+test('format', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(0.4)).toBe('0s');
+  expect(() => formatDuration(-1)).toThrow('-1');
+  expect(() => formatDuration(NaN)).toThrow();
+  expect(() => formatDuration(Infinity)).toThrow();
+});
+
+test('format and parse round trip', () => {
+  for (let n = 0; n <= 1000; n++) expect(parseDuration(formatDuration(n))).toBe(n);
+  for (const n of [86_400_000, 90_061_001, 2 ** 40 + 7]) {
+    expect(parseDuration(formatDuration(n))).toBe(n);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 15:14:44.126893298 +0000
@@ -0,0 +1,183 @@
+import { expect, test } from 'bun:test';
+import { EvictReason, LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const events: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => events.push([k, v, r]);
+  return { cache, events, setTime: (v: number) => (t = v) };
+}
+
+test('get hit makes the key most recently used', () => {
+  const { cache } = setup(3, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  expect(cache.keys()).toEqual(['a', 'b']);
+});
+
+test('entry is live before ttl and expires at ttl, reported once', () => {
+  const { cache, events, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  setTime(999);
+  expect(cache.get('a')).toBe(1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.get('a')).toBeUndefined();
+  expect(events).toEqual([['a', 1, 'expired']]);
+});
+
+test('setting an existing key refreshes ttl and recency without an event', () => {
+  const { cache, events, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  setTime(900);
+  cache.set('a', 10);
+  setTime(1500);
+  expect(cache.get('a')).toBe(10);
+  expect(cache.keys()).toEqual(['a']);
+  expect(events).toEqual([]);
+});
+
+test('set over an expired key reports the old value as expired', () => {
+  const { cache, events, setTime } = setup(3, 10);
+  cache.set('a', 1);
+  setTime(20);
+  cache.set('a', 2);
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.get('a')).toBe(2);
+  expect(events).toHaveLength(1);
+});
+
+test('expired entries are removed before a live one is evicted', () => {
+  const { cache, events, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(500);
+  cache.set('b', 2);
+  setTime(1000);
+  cache.set('c', 3);
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('expired entries count toward capacity until swept', () => {
+  const { cache, events, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  setTime(1000);
+  cache.set('c', 3);
+  expect(events).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+  ]);
+  expect(cache.size).toBe(1);
+});
+
+test('overflow with all live entries evicts the least recently used', () => {
+  const { cache, events } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.get('a');
+  cache.set('c', 3);
+  expect(events).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('delete reasons and return values', () => {
+  const { cache, events, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  setTime(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(cache.delete('zzz')).toBe(false);
+  expect(events).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('size and keys ignore expired entries and fire no events', () => {
+  const { cache, events, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  setTime(600);
+  cache.set('b', 2);
+  setTime(1200);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(events).toEqual([]);
+});
+
+test('matches a reference model over a seeded random sequence', () => {
+  const capacity = 4;
+  const ttl = 50;
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const events: string[] = [];
+  cache.onEvict = (k, v, r) => events.push(`${k}=${v}:${r}`);
+
+  // Reference: ordered list, oldest first, of { key, value, expires }.
+  type E = { key: string; value: number; expires: number };
+  let model: E[] = [];
+  const modelEvents: string[] = [];
+  const isLive = (e: E) => t < e.expires;
+  const mGet = (key: string) => {
+    const i = model.findIndex((e) => e.key === key);
+    if (i < 0) return undefined;
+    const [e] = model.splice(i, 1);
+    if (!isLive(e)) {
+      modelEvents.push(`${e.key}=${e.value}:expired`);
+      return undefined;
+    }
+    model.push(e);
+    return e.value;
+  };
+  const mSet = (key: string, value: number) => {
+    const old = model.find((e) => e.key === key);
+    model = model.filter((e) => e.key !== key);
+    if (old && !isLive(old)) modelEvents.push(`${old.key}=${old.value}:expired`);
+    model.push({ key, value, expires: t + ttl });
+    if (model.length <= capacity) return;
+    for (const e of model.filter((x) => !isLive(x))) {
+      modelEvents.push(`${e.key}=${e.value}:expired`);
+    }
+    model = model.filter((x) => isLive(x));
+    while (model.length > capacity) {
+      const e = model.shift()!;
+      modelEvents.push(`${e.key}=${e.value}:capacity`);
+    }
+  };
+  const mDelete = (key: string) => {
+    const i = model.findIndex((e) => e.key === key);
+    if (i < 0) return false;
+    const [e] = model.splice(i, 1);
+    if (!isLive(e)) {
+      modelEvents.push(`${e.key}=${e.value}:expired`);
+      return false;
+    }
+    modelEvents.push(`${e.key}=${e.value}:delete`);
+    return true;
+  };
+
+  let seed = 42;
+  const rand = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
+  const keys = ['a', 'b', 'c', 'd', 'e', 'f'];
+  for (let i = 0; i < 500; i++) {
+    const op = rand();
+    const key = keys[Math.floor(rand() * keys.length)];
+    if (op < 0.4) {
+      expect(cache.get(key)).toBe(mGet(key));
+    } else if (op < 0.8) {
+      const v = Math.floor(rand() * 1000);
+      cache.set(key, v);
+      mSet(key, v);
+    } else {
+      expect(cache.delete(key)).toBe(mDelete(key));
+    }
+    if (rand() < 0.5) t += Math.floor(rand() * 30);
+    expect(cache.size).toBe(model.filter(isLive).length);
+    expect(cache.keys()).toEqual(model.filter(isLive).map((e) => e.key).reverse());
+    expect(events).toEqual(modelEvents);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 15:14:39.234893007 +0000
@@ -0,0 +1,55 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('lower case and diacritics', () => {
+  expect(slugify('HELLO')).toBe('hello');
+  expect(slugify('à ç ñ ź')).toBe('a-c-n-z');
+  expect(slugify('Straße Æon Œuvre Øre Łódź Đak')).toBe('strasse-aeon-oeuvre-ore-lodz-dak');
+});
+
+test('compatibility characters are separators, not letters', () => {
+  expect(slugify('x² ﬁsh')).toBe('x-sh');
+  expect(slugify('a™b')).toBe('a-b');
+  expect(slugify('ｆull')).toBe('ull');
+  expect(slugify('½ cup')).toBe('cup');
+});
+
+test('separators collapse and edges are trimmed', () => {
+  expect(slugify('--a!!b--')).toBe('a-b');
+  expect(slugify('!!!')).toBe('');
+  expect(slugify('')).toBe('');
+});
+
+test('max cuts at a dash or at max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab-cd', 10)).toBe('ab-cd');
+  expect(slugify('ab-cd', 0)).toBe('');
+});
+
+test('max keeps the invariants for many inputs', () => {
+  const alphabet = 'ab-- é!Z9';
+  let seed = 7;
+  const rand = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
+  for (let i = 0; i < 300; i++) {
+    let text = '';
+    const len = Math.floor(rand() * 20);
+    for (let j = 0; j < len; j++) text += alphabet[Math.floor(rand() * alphabet.length)];
+    const full = slugify(text);
+    for (let max = 0; max <= 12; max++) {
+      const cut = slugify(text, max);
+      expect(cut.length).toBeLessThanOrEqual(max);
+      expect(cut.startsWith('-') || cut.endsWith('-')).toBe(false);
+      expect(full.startsWith(cut)).toBe(true);
+      if (full.length <= max) expect(cut).toBe(full);
+    }
+  }
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set(['other']))).toBe('post');
+  const taken = new Set(['post', 'post-2']);
+  expect(uniqueSlug('post', taken)).toBe('post-3');
+  expect([...taken]).toEqual(['post', 'post-2']);
+});
