+    const entry = { promise: new Promise<V>((res) => res(fn(key))), expires: Infinity };
     cache.set(key, entry);
+    // Only the entry this call made may change the cache: an invalidated or dropped key stays forgotten.
     entry.promise.then(
-      (value) => cache.set(key, { promise: Promise.resolve(value), expires: now() + opts.ttlMs }),
