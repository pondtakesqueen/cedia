diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 15:09:18.338873932 +0000
@@ -0,0 +1,94 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { bulkDiscount } from '../src/pricing/discounts/bulk.ts';
+import { REGIONS, region } from '../src/pricing/regions.ts';
+import { shippingFor } from '../src/pricing/shipping.ts';
+
+// Rules from README.md, checked one at a time.
+describe('bulk discount tiers', () => {
+  test('9 units get no discount, 10 units get 5%', () => {
+    expect(bulkDiscount(9, 1080)).toBe(0);
+    expect(bulkDiscount(10, 1200)).toBe(60);
+  });
+
+  test('49 units get 5%, 50 units get 10% (only the highest tier applies)', () => {
+    expect(bulkDiscount(49, 5880)).toBe(294);
+    expect(bulkDiscount(50, 6000)).toBe(600);
+  });
+
+  test('10 PEN in the US: 5% off the line, shipping still charged', () => {
+    // subtotal 1200 - 60 = 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('50 PEN in the US: 10% off and free shipping', () => {
+    // subtotal 6000 - 600 = 5400; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+});
+
+describe('units count per SKU across the cart', () => {
+  test('lines of the same SKU are merged before the bulk tier is chosen', () => {
+    expect(totals(cart('US', [['PEN', 6], ['PEN', 4]]))).toMatchObject(totals(cart('US', [['PEN', 10]])));
+    expect(totals(cart('US', [['PEN', 6], ['PEN', 4]])).lines).toHaveLength(1);
+  });
+
+  test('pricing does not change the caller cart', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    totals(c);
+    expect(c.lines.map((l) => l.quantity)).toEqual([6, 4]);
+  });
+});
+
+describe('shipping uses the discounted subtotal', () => {
+  test('a coupon that drops the order under the threshold brings shipping back', () => {
+    // subtotal 2*2200 + 2*450 = 5300 >= 5000, but after FLAT5 it is 4800 < 5000
+    // tax 7% of (4800 + 800) = 392
+    expect(totals(cart('US', [['BAG', 2], ['MUG', 2]], 'FLAT5'))).toMatchObject({
+      subtotal: 5300,
+      coupon: 500,
+      shipping: 800,
+      tax: 392,
+      total: 5992,
+    });
+  });
+});
+
+describe('free shipping threshold', () => {
+  test('exactly at the threshold ships free, one cent below does not', () => {
+    expect(shippingFor(region('US'), 5000)).toBe(0);
+    expect(shippingFor(region('US'), 4999)).toBe(800);
+    expect(shippingFor(region('EU'), 6000)).toBe(0);
+    expect(shippingFor(region('EU'), 5999)).toBe(900);
+    expect(shippingFor(region('UK'), 4000)).toBe(0);
+    expect(shippingFor(region('UK'), 3999)).toBe(700);
+  });
+
+  test('a UK order of 2 bags (4400) ships free', () => {
+    // tax 20% of 4400 = 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+});
+
+describe('region table', () => {
+  test('matches the README table', () => {
+    expect(REGIONS).toEqual({
+      US: { code: 'US', taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 },
+      EU: { code: 'EU', taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 },
+      UK: { code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 },
+    });
+  });
+});
+
+describe('coupons', () => {
+  test('FLAT5 never takes more than the subtotal', () => {
+    // coupon capped at 120; shipping 800; tax 7% of 800 = 56
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ subtotal: 120, coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('SAVE10 takes 10% after the bulk discount', () => {
+    // 1140 after bulk; 10% of 1140 = 114
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10')).coupon).toBe(114);
+  });
+});
