diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-29 14:59:10.734837814 +0000
@@ -0,0 +1,273 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("the ttl runs from settle, not from the start of the call", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  t = 50;
+  calls[0]!.d.resolve("v");
+  await tick();
+  t = 149;
+  expect(await m("k")).toBe("v");
+  t = 150;
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection is not kept: every waiter gets it and the next call runs fn again", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  const err = new Error("boom");
+  calls[0]!.d.reject(err);
+  await expect(a).rejects.toBe(err);
+  await expect(b).rejects.toBe(err);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection from a call invalidated earlier does not delete the newer entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("old"));
+  await expect(first).rejects.toThrow("old");
+  await tick();
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("size stays at most max when an invalidated call in flight settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m.invalidate("a");
+  m("b");
+  m("c");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  calls[2]!.d.resolve("c");
+  await tick();
+  expect(m.size).toBeLessThanOrEqual(2);
+});
+
+test("a cache hit counts as a use for the max limit", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("a");
+  m("c");
+  calls[2]!.d.resolve("c");
+  await tick();
+  m("b");
+  expect(calls).toHaveLength(4);
+  m("c");
+  expect(calls).toHaveLength(4);
+});
+
+test("adding a key counts as a use: the least recently used key is dropped", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(4);
+});
+
+test("an evicted key whose call settles later is not stored", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("clear is invalidate for every key, including keys in flight", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("a");
+  const b = m("b");
+  m.clear();
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  expect(await a).toBe("a");
+  expect(await b).toBe("b");
+  await tick();
+  expect(m.size).toBe(0);
+  m("a");
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("expired keys do not count toward size or max", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 1, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 100;
+  expect(m.size).toBe(0);
+  m("b");
+  calls[1]!.d.resolve("b");
+  await tick();
+  expect(m.size).toBe(1);
+});
+
+test("a key that expired does not push out a live key", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 60;
+  m("b");
+  calls[1]!.d.resolve("b");
+  await tick();
+  t = 100;
+  m("c");
+  calls[2]!.d.resolve("c");
+  await tick();
+  expect(m.size).toBe(2);
+  m("b");
+  expect(calls).toHaveLength(3);
+});
+
+test("a synchronous throw from fn evicts nothing", async () => {
+  const calls: string[] = [];
+  const err = new Error("sync");
+  const fn = (key: string): Promise<string> => {
+    calls.push(key);
+    if (key === "b") throw err;
+    return Promise.resolve(key);
+  };
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  await m("a");
+  expect(() => m("b")).toThrow(err);
+  expect(m.size).toBe(1);
+  await m("a");
+  expect(calls).toEqual(["a", "b"]);
+});
+
+test("matches a reference model over seeded random operations", async () => {
+  let seed = 7;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  const flush = async () => {
+    for (let i = 0; i < 5; i++) await null;
+  };
+  for (const [max, ttlMs] of [
+    [1, 50],
+    [2, 30],
+    [3, 100],
+    [5, 10],
+  ] as const) {
+    let t = 0;
+    const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+    const m = memo(
+      (key: string) => {
+        const d = deferred<string>();
+        calls.push({ key, d });
+        return d.promise;
+      },
+      { ttlMs, max, now: () => t },
+    );
+    // Reference: entries are { id, expires } with expires Infinity while in flight, kept in use order.
+    const model = new Map<string, { id: number; expires: number }>();
+    let modelCalls = 0;
+    const prune = () => {
+      for (const [k, e] of model) if (e.expires <= t) model.delete(k);
+    };
+    const keys = ["a", "b", "c", "d"];
+    const results: { p: Promise<string>; key: string; id: number }[] = [];
+    for (let step = 0; step < 200; step++) {
+      const op = rand(6);
+      if (op === 0 || op === 1) {
+        const key = keys[rand(keys.length)]!;
+        const hit = model.get(key);
+        let id: number;
+        if (hit && hit.expires > t) {
+          model.delete(key);
+          model.set(key, hit);
+          id = hit.id;
+        } else {
+          model.delete(key);
+          prune();
+          while (model.size >= max) model.delete(model.keys().next().value as string);
+          id = modelCalls++;
+          model.set(key, { id, expires: Infinity });
+        }
+        results.push({ p: m(key), key, id });
+      } else if (op === 2 && calls.length) {
+        const i = rand(calls.length);
+        const c = calls[i]!;
+        const id = i;
+        const entry = model.get(c.key);
+        if (entry && entry.id === id && entry.expires === Infinity) entry.expires = t + ttlMs;
+        c.d.resolve(`${c.key}#${id}`);
+      } else if (op === 3 && calls.length) {
+        const i = rand(calls.length);
+        const c = calls[i]!;
+        const entry = model.get(c.key);
+        if (entry && entry.id === i && entry.expires === Infinity) model.delete(c.key);
+        c.d.reject(new Error(`${c.key}#${i}`));
+      } else if (op === 4) {
+        const key = keys[rand(keys.length)]!;
+        m.invalidate(key);
+        model.delete(key);
+      } else {
+        t += rand(40);
+      }
+      await flush();
+      prune();
+      expect(m.size).toBe(model.size);
+      expect(calls.length).toBe(modelCalls);
+    }
+    calls.forEach((c, i) => c.d.resolve(`${c.key}#${i}`));
+    for (const r of results) {
+      const outcome = await r.p.then(
+        (v) => v,
+        (e: Error) => e.message,
+      );
+      expect(outcome).toBe(`${r.key}#${r.id}`);
+    }
+  }
+});
