@@ -7,10 +7,35 @@
 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNITS: [string, number][] = [
+  ['d', 86_400_000],
+  ['h', 3_600_000],
+  ['m', 60_000],
+  ['s', 1000],
+  ['ms', 1],
+];
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  const fail = () => new Error(`invalid duration: ${JSON.stringify(text)}`);
+  if (!/^(?:\d+(?:\.\d+)?(?:ms|d|h|m|s)\s*)+$/.test(s)) throw fail();
+  let total = 0;
+  for (const [, n, unit] of s.matchAll(/(\d+(?:\.\d+)?)(ms|d|h|m|s)/g)) {
+    total += Number(n) * UNITS.find(([u]) => u === unit)![1];
+  }
+  if (!Number.isFinite(total)) throw fail();
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const [unit, size] of UNITS) {
+    const count = Math.floor(rest / size);
+    if (count > 0) out += `${count}${unit}`;
+    rest -= count * size;
+  }
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
--- a/src/lru.ts	2026-10-29 15:10:18.632680346 +0000
+++ b/src/lru.ts	2026-10-29 15:11:40.959449200 +0000
@@ -14,30 +14,73 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+interface Entry<V> {
+  value: V;
+  expires: number;
+}
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Map iteration order is recency order: the first entry is the least recently used.
+  private map = new Map<K, Entry<V>>();
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
-  }
+  constructor(
+    private capacity: number,
+    private ttlMs: number,
+    private now: () => number = Date.now,
+  ) {}
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.map.get(key);
+    if (!entry) return undefined;
+    this.map.delete(key);
+    if (this.now() >= entry.expires) {
+      this.onEvict?.(key, entry.value, 'expired');
+      return undefined;
+    }
+    this.map.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const t = this.now();
+    this.map.delete(key);
+    this.map.set(key, { value, expires: t + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    for (const [k, entry] of [...this.map]) {
+      if (t >= entry.expires) {
+        this.map.delete(k);
+        this.onEvict?.(k, entry.value, 'expired');
+      }
+    }
+    while (this.map.size > this.capacity) {
+      const [k, entry] = this.map.entries().next().value!;
+      this.map.delete(k);
+      this.onEvict?.(k, entry.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.map.get(key);
+    if (!entry) return false;
+    this.map.delete(key);
+    const live = this.now() < entry.expires;
+    this.onEvict?.(key, entry.value, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    const t = this.now();
+    let n = 0;
+    for (const entry of this.map.values()) if (t < entry.expires) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
+    return [...this.map]
+      .filter(([, entry]) => t < entry.expires)
+      .map(([k]) => k)
+      .reverse();
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 15:10:18.632739988 +0000
+++ b/src/slug.ts	2026-10-29 15:11:40.950882409 +0000
@@ -11,10 +11,25 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const LETTERS: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => LETTERS[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  if (slug[max] === '-') return slug.slice(0, max);
+  const cut = slug.lastIndexOf('-', max - 1);
+  return slug.slice(0, cut > 0 ? cut : max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 15:11:57.490883392 +0000
@@ -0,0 +1,55 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parse accepts each unit, fractions and spaces between parts', () => {
+  expect(parseDuration('90s')).toBe(90_000);
+  expect(parseDuration('1h30m')).toBe(5_400_000);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1m 30s')).toBe(90_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+});
+
+test('parse tells ms from m', () => {
+  expect(parseDuration('1ms')).toBe(1);
+  expect(parseDuration('1m')).toBe(60_000);
+});
+
+test('parse rounds the total to a whole number', () => {
+  expect(parseDuration('0.4ms')).toBe(0);
+  expect(parseDuration('1.0005s')).toBe(1001);
+});
+
+test('parse throws, naming the input, for anything else', () => {
+  for (const input of ['', '   ', '10', '5x', 'h', '-1s', '.5s', '1.s', 'ms']) {
+    expect(() => parseDuration(input)).toThrow(`invalid duration: ${JSON.stringify(input)}`);
+  }
+});
+
+test('parse throws when the total overflows', () => {
+  const input = '9'.repeat(400) + 'd';
+  expect(() => parseDuration(input)).toThrow('invalid duration');
+});
+
+test('format uses the largest units first, leaving out zero parts', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(86_400_000)).toBe('1d');
+});
+
+test('format rejects negative and non-finite numbers', () => {
+  for (const ms of [-1, NaN, Infinity]) {
+    expect(() => formatDuration(ms)).toThrow('invalid duration');
+  }
+});
+
+test('format then parse gives the same number back', () => {
+  const values = [0, 1, 999, 1000, 60_000, 86_400_000];
+  for (let i = 1; i <= 200; i++) values.push((i * 7919) % 1_000_000_000);
+  for (const x of values) {
+    expect(parseDuration(formatDuration(x))).toBe(x);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 15:12:05.414883863 +0000
@@ -0,0 +1,187 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+function recorded<K, V>(cache: LRU<K, V>) {
+  const log: [K, V, string][] = [];
+  cache.onEvict = (k, v, reason) => log.push([k, v, reason]);
+  return log;
+}
+
+test('an entry is live while now() < set time + ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(10, 1000, () => t);
+  const log = recorded(cache);
+  cache.set('k', 1);
+  t = 999;
+  expect(cache.get('k')).toBe(1);
+  t = 1000;
+  expect(cache.get('k')).toBeUndefined();
+  expect(log).toEqual([['k', 1, 'expired']]);
+});
+
+test('a hit makes the entry the most recently used', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recorded(cache);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('overwriting gives a fresh ttl, fires no eviction and makes the key newest', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recorded(cache);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  t = 500;
+  cache.set('a', 3);
+  expect(log).toEqual([]);
+  t = 1200;
+  expect(cache.get('a')).toBe(3);
+  expect(cache.keys()).toEqual(['a']);
+});
+
+test('expired entries are removed before a live one is evicted', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recorded(cache);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1000;
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('an expired entry that is not the least recently used is still removed first', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recorded(cache);
+  cache.set('x', 1);
+  cache.set('y', 2);
+  t = 999;
+  expect(cache.get('x')).toBe(1);
+  t = 1000;
+  cache.set('z', 3);
+  expect(log).toEqual([
+    ['y', 2, 'expired'],
+    ['x', 1, 'expired'],
+  ]);
+  expect(cache.keys()).toEqual(['z']);
+});
+
+test('expired entries count toward capacity until something cleans them up', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = recorded(cache);
+  cache.set('a', 1);
+  t = 900;
+  cache.set('b', 2);
+  t = 1000;
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+});
+
+test('delete reports live, expired and missing entries differently', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const log = recorded(cache);
+  cache.set('live', 1);
+  cache.set('old', 2);
+  t = 500;
+  cache.set('later', 3);
+  t = 1000;
+  expect(cache.delete('live')).toBe(false);
+  expect(log).toEqual([['live', 1, 'expired']]);
+  expect(cache.delete('later')).toBe(true);
+  expect(log[1]).toEqual(['later', 3, 'delete']);
+  log.length = 0;
+  expect(cache.delete('missing')).toBe(false);
+  expect(log).toEqual([]);
+  expect(cache.delete('old')).toBe(false);
+  expect(log).toEqual([['old', 2, 'expired']]);
+});
+
+test('keys lists live keys, newest first', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 600;
+  cache.set('b', 2);
+  cache.set('c', 3);
+  t = 1000;
+  expect(cache.keys()).toEqual(['c', 'b']);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('the model agrees with a naive reference over seeded random operations', () => {
+  type M = { k: number; v: number; exp: number };
+  let seed = 12345;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  for (let capacity = 1; capacity <= 4; capacity++) {
+    let t = 0;
+    const ttl = 10;
+    const cache = new LRU<number, number>(capacity, ttl, () => t);
+    const log = recorded(cache);
+    const model: M[] = [];
+    const live = (e: M) => t < e.exp;
+    const evicted: [number, number, string][] = [];
+    const modelDrop = (i: number, reason: string) => {
+      const [e] = model.splice(i, 1);
+      evicted.push([e.k, e.v, reason]);
+    };
+    for (let step = 0; step < 2000; step++) {
+      t += rand(5);
+      const op = rand(3);
+      const k = rand(6);
+      if (op === 0) {
+        const v = rand(1000);
+        const i = model.findIndex((e) => e.k === k);
+        if (i >= 0) model.splice(i, 1);
+        model.push({ k, v, exp: t + ttl });
+        if (model.length > capacity) {
+          for (let j = 0; j < model.length; ) {
+            if (live(model[j])) j++;
+            else modelDrop(j, 'expired');
+          }
+          while (model.length > capacity) modelDrop(0, 'capacity');
+        }
+        cache.set(k, v);
+      } else if (op === 1) {
+        const i = model.findIndex((e) => e.k === k);
+        let expected: number | undefined;
+        if (i >= 0) {
+          const [e] = model.splice(i, 1);
+          if (live(e)) {
+            model.push(e);
+            expected = e.v;
+          } else {
+            evicted.push([e.k, e.v, 'expired']);
+          }
+        }
+        expect(cache.get(k)).toBe(expected);
+      } else {
+        const i = model.findIndex((e) => e.k === k);
+        let expected = false;
+        if (i >= 0) {
+          const [e] = model.splice(i, 1);
+          expected = live(e);
+          evicted.push([e.k, e.v, expected ? 'delete' : 'expired']);
+        }
+        expect(cache.delete(k)).toBe(expected);
+      }
+      expect(cache.size).toBe(model.filter(live).length);
+      expect(cache.keys()).toEqual(model.filter(live).map((e) => e.k).reverse());
+      expect(log).toEqual(evicted);
+    }
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 15:13:13.544751699 +0000
@@ -0,0 +1,54 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify lower-cases', () => {
+  expect(slugify('ABC')).toBe('abc');
+});
+
+test('slugify drops diacritics and maps letters without a decomposition', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('Straße Æon Œuvre Øl Łódź Đak')).toBe('strasse-aeon-oeuvre-ol-lodz-dak');
+});
+
+test('slugify turns runs of other characters into one dash, never at the ends', () => {
+  expect(slugify('a__b  c!!')).toBe('a-b-c');
+  expect(slugify('--a--')).toBe('a');
+  expect(slugify('a1 b2')).toBe('a1-b2');
+  expect(slugify('!!!')).toBe('');
+});
+
+test('slugify with max cuts at a dash that keeps it within max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('ab-cd', 10)).toBe('ab-cd');
+});
+
+test('slugify with max cuts at max when there is no dash to cut at', () => {
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+});
+
+test('slugify with max 0 gives an empty slug, whether or not there is a dash', () => {
+  expect(slugify('ab-cd', 0)).toBe('');
+  expect(slugify('abcd', 0)).toBe('');
+});
+
+test('slugify with max always stays within max, with no dangling dash, as a prefix', () => {
+  const inputs = ['ab-cd-ef-gh', 'a-b-c-d-e-f', 'abcdefghijklmnop', 'x y z w v u', 'aa--bb cc'];
+  for (const input of inputs) {
+    const full = slugify(input);
+    for (let max = 0; max <= 12; max++) {
+      const cut = slugify(input, max);
+      expect(cut.length).toBeLessThanOrEqual(max);
+      expect(cut.endsWith('-')).toBe(false);
+      expect(full.startsWith(cut)).toBe(true);
+    }
+  }
+});
+
+test('uniqueSlug returns the slug when free, else the first free numbered one', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['post']))).toBe('post-2');
+  expect(uniqueSlug('post', new Set(['post', 'post-2', 'post-3']))).toBe('post-4');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+});
