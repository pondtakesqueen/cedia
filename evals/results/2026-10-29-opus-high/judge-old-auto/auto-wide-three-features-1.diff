 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Map order is recency order, least recently used first.
+  private entries = new Map<K, Entry<V>>();
+
+  constructor(
+    private capacity: number,
+    private ttlMs: number,
+    private now: () => number = Date.now,
+  ) {}
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+  private isLive(e: Entry<V>): boolean {
+    return this.now() < e.expires;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return undefined;
+    this.entries.delete(key);
+    if (!this.isLive(e)) {
+      this.onEvict?.(key, e.value, 'expired');
+      return undefined;
+    }
+    this.entries.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const old = this.entries.get(key);
+    if (old) {
+      this.entries.delete(key);
+      if (!this.isLive(old)) this.onEvict?.(key, old.value, 'expired');
+    }
+    this.entries.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.entries.size > this.capacity) {
+      for (const [k, e] of this.entries) {
+        if (!this.isLive(e)) {
+          this.entries.delete(k);
+          this.onEvict?.(k, e.value, 'expired');
+        }
+      }
+      while (this.entries.size > this.capacity) {
+        const [k, e] = this.entries.entries().next().value as [K, Entry<V>];
+        this.entries.delete(k);
+        this.onEvict?.(k, e.value, 'capacity');
+      }
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return false;
+    this.entries.delete(key);
+    const live = this.isLive(e);
+    this.onEvict?.(key, e.value, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const e of this.entries.values()) if (this.isLive(e)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const live: K[] = [];
+    for (const [k, e] of this.entries) if (this.isLive(e)) live.push(k);
+    return live.reverse();
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 08:11:17.154020167 +0000
+++ b/src/slug.ts	2026-10-29 08:12:28.489195546 +0000
@@ -11,10 +11,26 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const folds: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => folds[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  if (slug[max] === '-') return slug.slice(0, max);
+  const cut = slug.slice(0, max);
+  const i = cut.lastIndexOf('-');
+  return i > 0 ? cut.slice(0, i) : cut;
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.extra.test.ts b/test/duration.extra.test.ts
--- a/test/duration.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.extra.test.ts	2026-10-29 08:12:38.956790245 +0000
@@ -0,0 +1,25 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parseDuration reads fractions, several parts and spaces', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+  expect(parseDuration('1.0005s')).toBe(1001);
+});
+
+test('parseDuration rejects malformed input', () => {
+  for (const text of ['', '10', 'h', '-1s', '5 x']) {
+    expect(() => parseDuration(text)).toThrow(`invalid duration "${text}"`);
+  }
+});
+
+test('formatDuration', () => {
+  expect(formatDuration(1500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(0.4)).toBe('0s');
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(Number.NaN)).toThrow();
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.extra.test.ts b/test/lru.extra.test.ts
--- a/test/lru.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.extra.test.ts	2026-10-29 08:13:56.896794878 +0000
@@ -0,0 +1,94 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+function cacheWithLog(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const evicted: [string, number, string][] = [];
+  cache.onEvict = (k, v, reason) => evicted.push([k, v, reason]);
+  return { cache, evicted, setTime: (n: number) => (t = n) };
+}
+
+test('a get hit refreshes recency', () => {
+  const { cache, evicted } = cacheWithLog(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('get on an expired entry removes it with reason expired', () => {
+  const { cache, evicted, setTime } = cacheWithLog(2, 1000);
+  cache.set('a', 1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+});
+
+test('set over capacity removes expired entries before live ones', () => {
+  const { cache, evicted, setTime } = cacheWithLog(2, 1000);
+  cache.set('a', 1);
+  setTime(500);
+  cache.set('b', 2);
+  setTime(1000);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('delete reports live, expired and missing entries', () => {
+  const { cache, evicted, setTime } = cacheWithLog(4, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(cache.delete('missing')).toBe(false);
+  setTime(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(evicted).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('size and keys leave out expired entries without evicting them', () => {
+  const { cache, evicted, setTime } = cacheWithLog(4, 1000);
+  cache.set('a', 1);
+  setTime(600);
+  cache.set('b', 2);
+  setTime(1000);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(evicted).toEqual([]);
+});
+
+test('an entry is live before ttl and expired at ttl', () => {
+  const { cache, setTime } = cacheWithLog(2, 1000);
+  cache.set('a', 1);
+  setTime(999);
+  expect(cache.get('a')).toBe(1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('set on a live key replaces it silently and refreshes its ttl', () => {
+  const { cache, evicted, setTime } = cacheWithLog(2, 1000);
+  cache.set('a', 1);
+  setTime(900);
+  cache.set('a', 2);
+  expect(evicted).toEqual([]);
+  expect(cache.keys()).toEqual(['a']);
+  setTime(1500);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('set on an expired key reports it as expired', () => {
+  const { cache, evicted, setTime } = cacheWithLog(2, 1000);
+  cache.set('a', 1);
+  setTime(1000);
+  cache.set('a', 2);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.get('a')).toBe(2);
+});
+
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.extra.test.ts b/test/slug.extra.test.ts
--- a/test/slug.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.extra.test.ts	2026-10-29 08:12:38.964790245 +0000
@@ -0,0 +1,22 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify replaces letters that do not decompose', () => {
+  expect(slugify('Straße Æon œuvre Øre Łódź đak')).toBe('strasse-aeon-oeuvre-ore-lodz-dak');
+});
+
+test('slugify trims separators', () => {
+  expect(slugify('  --Hi!!  ')).toBe('hi');
+});
+
+test('slugify cuts at a dash within max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cdef', 5)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab', 5)).toBe('ab');
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('x', new Set())).toBe('x');
+});
