diff -ruN '--exclude=node_modules' '--exclude=.git' a/shell.rules.test.ts b/shell.rules.test.ts
--- a/shell.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/shell.rules.test.ts	2026-10-30 02:08:36.449344309 +0000
@@ -0,0 +1,118 @@
+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+test('separators split commands outside quotes', () => {
+  expect(simpleCommands('a;b&c|d&&e||f\ng')).toEqual([['a'], ['b'], ['c'], ['d'], ['e'], ['f'], ['g']]);
+  expect(simpleCommands('(a)')).toEqual([['a']]);
+  expect(simpleCommands('echo "a;b" \'c|d\'')).toEqual([['echo', 'a;b', 'c|d']]);
+});
+
+test('substitutions come after the command that holds them', () => {
+  expect(simpleCommands('echo $(rm x) `id`')).toEqual([['echo'], ['rm', 'x'], ['id']]);
+  expect(simpleCommands('a $(b $(c))')).toEqual([['a'], ['b'], ['c']]);
+  expect(simpleCommands('a $( (b) ; c)')).toEqual([['a'], ['b'], ['c']]);
+  expect(simpleCommands('echo "x $(rm y)"')).toEqual([['echo', 'x '], ['rm', 'y']]);
+});
+
+test('unclosed quotes and substitutions return null', () => {
+  expect(simpleCommands('a $(b')).toBeNull();
+  expect(simpleCommands('a `b')).toBeNull();
+  expect(simpleCommands('"x')).toBeNull();
+  expect(simpleCommands("'x\"")).toBeNull();
+});
+
+test('redirection operators are not background jobs', () => {
+  expect(simpleCommands('a 2>&1 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a >&2')).toEqual([['a']]);
+  expect(simpleCommands('a &>f b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a & b')).toEqual([['a'], ['b']]);
+  expect(simpleCommands('rm>f')).toEqual([['rm']]);
+  expect(simpleCommands('a \\>&b')).toEqual([['a', '>'], ['b']]);
+});
+
+test('single quotes are literal, backslashes escape', () => {
+  expect(simpleCommands("echo 'a\\b\"c'")).toEqual([['echo', 'a\\b"c']]);
+  expect(simpleCommands('a\\;b')).toEqual([['a;b']]);
+  expect(simpleCommands('"a\\"b"')).toEqual([['a"b']]);
+});
+
+test('empty quoted strings are words', () => {
+  expect(simpleCommands(`a '' ""`)).toEqual([['a', '', '']]);
+});
+
+test('redirection operators drop themselves and their target', () => {
+  for (const op of ['>', '>>', '<', '2>', '&>', '>&']) {
+    expect(simpleCommands(`a ${op} f b`)).toEqual([['a', 'b']]);
+  }
+  expect(simpleCommands('a >f 2>/dev/null 2>&1 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('echo ">" x')).toEqual([['echo', '>', 'x']]);
+});
+
+test('assignments and keywords are skipped only at the start', () => {
+  expect(simpleCommands('A=1 B=2 x')).toEqual([['x']]);
+  expect(simpleCommands('while a; do b; done')).toEqual([['a'], ['b']]);
+  expect(simpleCommands('! a')).toEqual([['a']]);
+  expect(simpleCommands('echo A=1 fi')).toEqual([['echo', 'A=1', 'fi']]);
+});
+
+test('wrappers are unwrapped with their value flags and positionals', () => {
+  expect(simpleCommands('nice -n 5 make')).toEqual([['make']]);
+  expect(simpleCommands('timeout 5 make')).toEqual([['make']]);
+  expect(simpleCommands('env -u X A=1 cmd')).toEqual([['cmd']]);
+  expect(simpleCommands('sudo -- -weird')).toEqual([['-weird']]);
+  expect(simpleCommands('sudo')).toEqual([]);
+  expect(simpleCommands('sudo -u')).toEqual([]);
+});
+
+test('shells with -c and eval are unpacked', () => {
+  expect(simpleCommands('zsh -c "a;b"')).toEqual([['a'], ['b']]);
+  expect(simpleCommands('bash -lc "a"')).toEqual([['a']]);
+  expect(simpleCommands('eval "a;b"')).toEqual([['a'], ['b']]);
+  expect(simpleCommands('bash -c "sh -c \'rm x\'"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash -o pipefail -c "rm x"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash script.sh')).toEqual([['bash', 'script.sh']]);
+  expect(simpleCommands('bash -c "\'"')).toBeNull();
+});
+
+test('wrappers and shells given as absolute paths are recognised', () => {
+  expect(simpleCommands('/bin/bash -c "rm x"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('/usr/bin/env A=1 rm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('/usr/bin/sudo -u root rm x')).toEqual([['rm', 'x']]);
+});
+
+test('empty commands are left out', () => {
+  expect(simpleCommands('')).toEqual([]);
+  expect(simpleCommands(';;')).toEqual([]);
+  expect(simpleCommands('{ a; }')).toEqual([['a']]);
+  expect(simpleCommands('a >f')).toEqual([['a']]);
+});
+
+// Seeded LCG so the generated cases are the same on every run.
+let seed = 42;
+const rand = (n: number) => {
+  seed = (Math.imul(seed, 1103515245) + 12345) >>> 0;
+  return (seed >>> 16) % n;
+};
+const WORDS = ['a', '-x', '"q r"', "'s;t'", 'A=1', '>f', '$(u v)'];
+const lines = Array.from({ length: 200 }, () =>
+  Array.from({ length: 1 + rand(6) }, () => WORDS[rand(WORDS.length)]).join(' '),
+);
+
+test('joining two lines with a separator joins their results', () => {
+  for (let k = 0; k < lines.length; k++) {
+    const x = lines[k];
+    const y = lines[(k * 7 + 3) % lines.length];
+    for (const sep of [';', '&&', '||', '|', '\n', '&']) {
+      // Spaces around the separator: `&>` written together is a redirection, not a separator.
+      expect(simpleCommands(`${x} ${sep} ${y}`)).toEqual([...simpleCommands(x)!, ...simpleCommands(y)!]);
+    }
+  }
+});
+
+test('sh -c and sudo prefixes keep the same commands', () => {
+  for (const x of lines) {
+    if (x.includes("'")) continue;
+    expect(simpleCommands(`sh -c '${x}'`)).toEqual(simpleCommands(x));
+    if (!/^[-<>$]/.test(x)) expect(simpleCommands('sudo ' + x)).toEqual(simpleCommands(x));
+  }
+});
