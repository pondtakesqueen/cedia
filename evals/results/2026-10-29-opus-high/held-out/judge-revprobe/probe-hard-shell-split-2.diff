+type Word = { text: string; raw: string };
+
+const SHELLS = new Set(['bash', 'sh', 'zsh', 'dash', 'ksh']);
+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const ASSIGNMENT = /^[A-Za-z_]\w*=/;
+// A redirection alone takes the next word as its target; one with the target attached is a single word.
+const REDIRECT = /^(\d*>>?|<|&>|\d*>&)$/;
+const REDIRECT_START = /^(\d*>>?|<|&>|\d*>&)./;
+const PLAIN_TEXT = /[^\s'"\\;&|()`$<>]+/y;
+
+// Scans s from start until stop: the end of the string for '', a closing ) for '$(', a closing backtick for '`'.
+// Returns the commands found and the index where the scan stopped, or null if the input is unbalanced.
+function parse(s: string, start: number, stop: '' | ')' | '`'): { commands: string[][]; end: number } | null {
+  const commands: string[][] = [];
+  let words: Word[] = [];
+  let nested: string[][] = [];
+  let word: string | null = null;
+  let wordStart = 0;
+  let depth = 0;
+  let i = start;
+
+  const append = (text: string) => {
+    if (word === null) wordStart = i;
+    word = (word ?? '') + text;
+  };
+  const rawWord = () => (word === null ? '' : s.slice(wordStart, i));
+  const finishWord = () => {
+    if (word !== null) words.push({ text: word, raw: s.slice(wordStart, i) });
+    word = null;
+  };
+  // Ends the current command and adds its commands, then the ones from its substitutions.
+  const finishCommand = (): boolean => {
+    finishWord();
+    const argvs = splitArgv(words);
+    if (argvs === null) return false;
+    commands.push(...argvs, ...nested);
+    words = [];
+    nested = [];
+    return true;
+  };
+
+  while (i < s.length) {
+    const c = s[i];
+    if (c === '\n') {
+      if (!finishCommand()) return null;
+      i++;
+    } else if (/\s/.test(c)) {
+      finishWord();
+      i++;
+    } else if (c === "'") {
+      const close = s.indexOf("'", i + 1);
+      if (close < 0) return null;
+      append(s.slice(i + 1, close));
+      i = close + 1;
+    } else if (c === '"') {
+      append('');
+      i++;
+      while (s[i] !== '"') {
+        if (i >= s.length) return null;
+        if (s[i] === '\\' && i + 1 < s.length) {
+          append(s[i + 1]);
+          i += 2;
+        } else if (s.startsWith('$(', i)) {
+          const r = parse(s, i + 2, ')');
+          if (r === null) return null;
+          nested.push(...r.commands);
+          i = r.end + 1;
+        } else if (s[i] === '`') {
+          const r = parse(s, i + 1, '`');
+          if (r === null) return null;
+          nested.push(...r.commands);
+          i = r.end + 1;
+        } else {
+          append(s[i]);
+          i++;
+        }
+      }
+      i++;
+    } else if (c === '\\') {
+      append(s[i + 1] ?? '\\');
+      i += 2;
+    } else if (s.startsWith('$(', i)) {
+      const r = parse(s, i + 2, ')');
+      if (r === null) return null;
+      nested.push(...r.commands);
+      i = r.end + 1;
+    } else if (c === '`') {
+      if (stop === '`') {
+        if (!finishCommand()) return null;
+        return { commands, end: i };
+      }
+      const r = parse(s, i + 1, '`');
+      if (r === null) return null;
+      nested.push(...r.commands);
+      i = r.end + 1;
+    } else if (c === '(') {
+      if (!finishCommand()) return null;
+      depth++;
+      i++;
+    } else if (c === ')') {
+      if (!finishCommand()) return null;
+      if (depth > 0) depth--;
+      else if (stop === ')') return { commands, end: i };
+      i++;
+    } else if (c === ';' || c === '|') {
+      if (!finishCommand()) return null;
+      i++;
+    } else if (c === '&') {
+      if (/^\d*>$/.test(rawWord())) {
+        append(c);
+      } else if (s[i + 1] === '>') {
+        finishWord();
+        append(c);
+      } else if (!finishCommand()) {
+        return null;
+      }
+      i++;
+    } else if (c === '<' || c === '>') {
+      if (!/^\d*[<>&]*$/.test(rawWord())) finishWord();
+      append(c);
+      i++;
+    } else {
+      PLAIN_TEXT.lastIndex = i;
+      const text = PLAIN_TEXT.exec(s)?.[0] ?? c;
+      append(text);
+      i += text.length;
+    }
+  }
+  if (stop !== '') return null;
+  return finishCommand() ? { commands, end: s.length } : null;
+}
+
+// Turns the words of one command into the argv of the simple commands it runs: drops redirections, assignments,
+// keywords and wrappers, and unpacks `bash -c` and `eval`. Returns null if the unpacked script is unbalanced.
+function splitArgv(words: Word[]): string[][] | null {
+  const argv: string[] = [];
+  for (let k = 0; k < words.length; k++) {
+    const { text, raw } = words[k];
+    if (REDIRECT.test(raw)) k++;
+    else if (!REDIRECT_START.test(raw)) argv.push(text);
+  }
+
+  // A command given as a path (/usr/bin/env) is looked up by its basename.
+  const base = (word: string) => word.slice(word.lastIndexOf('/') + 1);
+  let k = 0;
+  while (k < argv.length) {
+    const wrapper = WRAPPERS.get(base(argv[k]));
+    if (ASSIGNMENT.test(argv[k]) || KEYWORDS.has(argv[k])) {
+      k++;
+    } else if (wrapper) {
+      k++;
+      while (k < argv.length && argv[k].startsWith('-')) {
+        const flag = argv[k++];
+        if (flag === '--') break;
+        if (wrapper.value?.includes(flag)) k++;
+      }
+      k += wrapper.positional ?? 0;
+    } else {
+      break;
+    }
+  }
+
+  const rest = argv.slice(k);
+  if (rest.length === 0) return [];
+  const [name, ...args] = rest;
+  if (name === 'eval') return simpleCommands(args.join(' '));
+  if (SHELLS.has(base(name))) {
+    for (let j = 0; j < args.length && /^[-+]/.test(args[j]); j++) {
+      if (args[j] === '-o' || args[j] === '+o') j++;
+      else if (/^-[a-z]*c[a-z]*$/.test(args[j])) return j + 1 < args.length ? simpleCommands(args[j + 1]) : [rest];
+    }
+  }
+  return [rest];
+}
+
