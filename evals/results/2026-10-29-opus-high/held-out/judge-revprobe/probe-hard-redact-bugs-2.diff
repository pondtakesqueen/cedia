diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact-tokens.test.ts b/redact-tokens.test.ts
--- a/redact-tokens.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact-tokens.test.ts	2026-10-30 02:03:25.742967181 +0000
@@ -0,0 +1,14 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+test('plural secret names are still redacted', () => {
+  expect(redactSecrets('MY_TOKENS=abcd1234xyz')).toEqual({ text: `MY_TOKENS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('AUTH_TOKENS=abc')).toEqual({ text: `AUTH_TOKENS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('"tokens": "abcd1234efgh5678"')).toEqual({ text: `"tokens": "${REDACTED}"`, count: 1 });
+  expect(redactSecrets('api_tokens: abcd1234efgh')).toEqual({ text: `api_tokens: ${REDACTED}`, count: 1 });
+});
+
+test('limit-style token counts are not secrets', () => {
+  expect(redactSecrets('MAX_TOKENS=4096')).toEqual({ text: 'MAX_TOKENS=4096', count: 0 });
+  expect(redactSecrets('max_tokens: 1000')).toEqual({ text: 'max_tokens: 1000', count: 0 });
+});
