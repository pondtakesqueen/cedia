diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact.review.test.ts b/redact.review.test.ts
--- a/redact.review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact.review.test.ts	2026-10-30 02:01:42.062969552 +0000
@@ -0,0 +1,15 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+test('camelCase and plural secret names are redacted', () => {
+  expect(redactSecrets('secretKey=abc123def456')).toEqual({ text: `secretKey=${REDACTED}`, count: 1 });
+  expect(redactSecrets('passwords=hunter22abc')).toEqual({ text: `passwords=${REDACTED}`, count: 1 });
+  expect(redactSecrets('tokens: abc12345xyz')).toEqual({ text: `tokens: ${REDACTED}`, count: 1 });
+  expect(redactSecrets('apiKeyValue: "abcd1234efgh"')).toEqual({ text: `apiKeyValue: "${REDACTED}"`, count: 1 });
+  expect(redactSecrets('db_passwordHash=abc12345xyz')).toEqual({ text: `db_passwordHash=${REDACTED}`, count: 1 });
+});
+
+test('a dotenv number is not a secret, but a dotenv word is', () => {
+  expect(redactSecrets('MAX_TOKENS=4096')).toEqual({ text: 'MAX_TOKENS=4096', count: 0 });
+  expect(redactSecrets('DB_PASSWORD=changeme')).toEqual({ text: `DB_PASSWORD=${REDACTED}`, count: 1 });
+});
