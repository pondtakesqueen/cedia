+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { loadQuotaWait } from '../src/core/config.ts';
+import { runPrompt, type RunOptions } from '../src/core/loop/run.ts';
+import { FAUX_MODEL } from '../src/core/providers/catalog.ts';
+import { fauxProvider, text, toolUse, type FauxStep } from '../src/core/providers/faux.ts';
+import { lintSession } from '../src/core/session/lint.ts';
+import { SessionLog } from '../src/core/session/log.ts';
+import { bashTool } from '../src/core/tools/bash.ts';
+import { readTool } from '../src/core/tools/read.ts';
+import type { EventOf, SessionEvent } from '../src/core/types.ts';
+
+const cwd = mkdtempSync(join(tmpdir(), 'cedia-recovery-'));
+writeFileSync(join(cwd, 'a.txt'), 'alpha\n');
+const MIN = 60_000;
+
+function setup(steps: FauxStep[], extra: Partial<RunOptions> = {}) {
+  const log = SessionLog.create();
+  const opts: RunOptions = {
+    log,
+    provider: fauxProvider(steps),
+    model: FAUX_MODEL,
+    tools: [readTool, bashTool],
+    system: 'sys',
+    cwd,
+    retry: { sleep: async () => {} },
+    ...extra,
+  };
+  return { log, opts };
+}
+
+const of = <K extends SessionEvent['kind']>(events: SessionEvent[], k: K) => events.filter((e): e is EventOf<K> => e.kind === k);
+const spent = (retryAfterMs: number): FauxStep => ({ error: { code: 'quota', status: 429, retryAfterMs, message: 'usage limit reached' } });
+
+describe('recovery', () => {
+  test('abort during a quota wait ends at once with interrupted', async () => {
+    const ac = new AbortController();
+    const { opts } = setup([spent(10 * MIN), { blocks: [text('unreachable')] }], { signal: ac.signal, retry: {}, quotaWaitMs: 30 * MIN });
+    const p = runPrompt(opts, 'wait');
+    setTimeout(() => ac.abort(), 10);
+    const start = Date.now();
+    expect((await p).subtype).toBe('interrupted');
+    expect(Date.now() - start).toBeLessThan(1000);
+  });
+
+  test('quota waits do not count against retry.max', async () => {
+    const { opts } = setup([spent(MIN), spent(MIN), { blocks: [text('ok')] }], { quotaWaitMs: 30 * MIN, retry: { max: 2, sleep: async () => {} } });
+    expect(await runPrompt(opts, 'hi')).toMatchObject({ subtype: 'success', result: 'ok' });
+  });
+
+  test('two calls that share an id on the over-budget path give one not_started result', async () => {
+    const { log, opts } = setup([{ blocks: [toolUse('dup', 'read', { path: 'a.txt' }), toolUse('dup', 'read', { path: 'a.txt' })] }], { maxBudgetUsd: 0 });
+    expect((await runPrompt(opts, 'go')).subtype).toBe('error_max_budget_usd');
+    const results = of(log.events, 'tool_result');
+    expect(results.map((r) => [r.callId, r.status])).toEqual([['dup', 'not_started']]);
+    expect(lintSession(log.events)).toEqual([]);
