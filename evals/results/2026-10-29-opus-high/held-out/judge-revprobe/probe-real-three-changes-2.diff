+// On a spent quota that says when it returns: flag > user settings > fallback. Returns how many ms the run may wait
+// over all its sessions, or undefined to fall back at once.
+export function loadQuotaWait(flag?: string): number | undefined {
+  const raw = flag ?? readSettings(join(cediaHome(), 'settings.json')).onQuota ?? 'fallback';
+  if (raw === 'fallback') return undefined;
+  const m = /^wait:(\d+)$/.exec(raw);
+  if (!m || Number(m[1]) < 1) throw new Error(`on-quota must be fallback or wait:<minutes>: ${raw}`);
+  return Number(m[1]) * 60_000;
+}
