+  test('on-quota wait:<minutes> is 1 to 50 whole minutes, and anything else is refused', () => {
+    for (let n = 1; n <= 50; n++) expect(loadQuotaWait(`wait:${n}`)).toBe(n * MIN);
+    for (const bad of ['wait', 'wait:0', 'wait:-1', 'wait:1.5', 'later', 'Wait:5'])
+      expect(() => loadQuotaWait(bad)).toThrow('fallback or wait:<minutes>');
+  });
+
+  test('a quota error that says to retry now is not waited out, so the run cannot loop', async () => {
+    const { log, opts } = setup([spent(0), spent(0), spent(0), { blocks: [text('unreachable')] }], { quotaWaitMs: 30 * MIN });
+    expect((await runPrompt(opts, 'hi')).subtype).toBe('error_during_execution');
+    expect(of(log.events, 'attempt')).toHaveLength(1);
+  });
+
+  test('quota waits add up over the run, and the wait that would pass the ceiling ends it', async () => {
+    const waits: number[] = [];
+    const { log, opts } = setup([spent(10 * MIN), spent(10 * MIN), spent(10 * MIN), spent(10 * MIN), { blocks: [text('unreachable')] }], { quotaWaitMs: 30 * MIN, onQuotaWait: (ms) => void waits.push(ms) });
+    expect((await runPrompt(opts, 'hi')).subtype).toBe('error_during_execution');
