@@ -0,0 +1,90 @@
+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { buildMessages } from '../src/core/context/build.ts';
+import { runPrompt, type RunOptions } from '../src/core/loop/run.ts';
+import { FAUX_MODEL } from '../src/core/providers/catalog.ts';
+import { fauxProvider, text, toolUse, type FauxStep } from '../src/core/providers/faux.ts';
+import { lintSession } from '../src/core/session/lint.ts';
+import { SessionLog } from '../src/core/session/log.ts';
+import { readTool } from '../src/core/tools/read.ts';
+import type { EventOf, SessionEvent } from '../src/core/types.ts';
+
+const cwd = mkdtempSync(join(tmpdir(), 'cedia-malformed-'));
+writeFileSync(join(cwd, 'a.txt'), 'alpha\n');
+
+function setup(steps: FauxStep[], extra: Partial<RunOptions> = {}) {
+  const log = SessionLog.create();
+  const opts: RunOptions = {
+    log,
+    provider: fauxProvider(steps),
+    model: FAUX_MODEL,
+    tools: [readTool],
+    system: 'sys',
+    cwd,
+    retry: { sleep: async () => {} },
+    ...extra,
+  };
+  return { log, opts };
+}
+
+const of = <K extends SessionEvent['kind']>(events: SessionEvent[], k: K) => events.filter((e): e is EventOf<K> => e.kind === k);
+const thinking = (t: string) => ({ type: 'thinking' as const, text: t, opaque: 'sig' });
+
+describe('malformed turns', () => {
+  test('a call that repeats an id gets one result even when the budget stops the turn', async () => {
+    const { log, opts } = setup([{ blocks: [toolUse('dup', 'read', { path: 'a.txt' }), toolUse('dup', 'read', { path: 'a.txt' })] }], { maxBudgetUsd: 0 });
+    expect((await runPrompt(opts, 'go')).subtype).toBe('error_max_budget_usd');
+    const results = of(log.events, 'tool_result');
+    expect(results.map((r) => r.status)).toEqual(['not_started']);
+    expect(lintSession(log.events)).toEqual([]);
+  });
+
+  test('a refusal that also holds a tool call still answers the call', async () => {
+    const { log, opts } = setup([{ blocks: [toolUse('c1', 'read', { path: 'a.txt' }), text('no')], stop: 'refusal' }]);
+    expect(await runPrompt(opts, 'go')).toMatchObject({ subtype: 'error_during_execution', result: 'no' });
+    expect(of(log.events, 'tool_result').map((r) => r.callId)).toEqual(['c1']);
+    expect(lintSession(log.events)).toEqual([]);
+  });
+
+  test('a spent quota wait does not use up the retry budget', async () => {
+    const waits: number[] = [];
