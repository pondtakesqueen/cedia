+// On a spent quota: flag > user settings > fallback. The ms a run may wait in all; a repo cannot set it.
+export function loadQuotaWait(flag?: string): number | undefined {
+  const raw = flag ?? readSettings(join(cediaHome(), 'settings.json')).onQuota;
+  if (raw === undefined || raw === 'fallback') return undefined;
+  const m = /^wait:(\d+)$/.exec(raw);
+  if (!m || Number(m[1]) < 1) throw new Error(`--on-quota must be fallback or wait:<minutes>: ${raw}`);
+  return Number(m[1]) * 60_000;
