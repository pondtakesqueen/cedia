diff -ruN '--exclude=node_modules' '--exclude=.git' a/shell.rules.test.ts b/shell.rules.test.ts
--- a/shell.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/shell.rules.test.ts	2026-10-30 02:07:19.595233900 +0000
@@ -0,0 +1,97 @@
+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+test('separators split commands, including nested ones', () => {
+  expect(simpleCommands('a;b&c|d&&e||f\ng')).toEqual([['a'], ['b'], ['c'], ['d'], ['e'], ['f'], ['g']]);
+  expect(simpleCommands('a $(b $(c) d) e')).toEqual([['a', 'e'], ['b', 'd'], ['c']]);
+  expect(simpleCommands('a;')).toEqual([['a']]);
+});
+
+test('substitutions in double quotes run, single quotes do not', () => {
+  expect(simpleCommands('echo "x $(rm y)"')).toEqual([['echo', 'x '], ['rm', 'y']]);
+  expect(simpleCommands(`echo '$(rm y)'`)).toEqual([['echo', '$(rm y)']]);
+  expect(simpleCommands(`echo 'a;b' "c|d"`)).toEqual([['echo', 'a;b', 'c|d']]);
+});
+
+test('redirections: operator words, glued targets and quoted operators', () => {
+  expect(simpleCommands('a 2>&1 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a >&2')).toEqual([['a']]);
+  expect(simpleCommands('a > f b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a 2> f b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a >> f b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a < f b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a &> f b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a >f 2>/dev/null b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a >"f g" b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('echo ">" x')).toEqual([['echo', '>', 'x']]);
+});
+
+test('words: escapes, empty words and quotes', () => {
+  expect(simpleCommands(`a "" ''`)).toEqual([['a', '', '']]);
+  expect(simpleCommands('a\\ b c')).toEqual([['a b', 'c']]);
+  expect(simpleCommands('echo "a\\$b"')).toEqual([['echo', 'a$b']]);
+});
+
+test('assignments, keywords and wrappers are skipped only where they lead', () => {
+  expect(simpleCommands('A=1 B=2 x')).toEqual([['x']]);
+  expect(simpleCommands('while true; do x; done')).toEqual([['true'], ['x']]);
+  expect(simpleCommands('! x')).toEqual([['x']]);
+  expect(simpleCommands('echo A=1 if')).toEqual([['echo', 'A=1', 'if']]);
+  expect(simpleCommands('"A=1" x')).toEqual([['A=1', 'x']]);
+  expect(simpleCommands('env -u X A=1 x')).toEqual([['x']]);
+  expect(simpleCommands('nice -n5 x')).toEqual([['x']]);
+  expect(simpleCommands('sudo -- x')).toEqual([['x']]);
+  expect(simpleCommands('timeout 5 x')).toEqual([['x']]);
+  expect(simpleCommands('xargs -I{} x')).toEqual([['x']]);
+  expect(simpleCommands('stdbuf -o L x')).toEqual([['x']]);
+});
+
+test('shell -c and eval', () => {
+  expect(simpleCommands(`bash -e -c "rm -rf x"`)).toEqual([['rm', '-rf', 'x']]);
+  expect(simpleCommands(`sudo sh -c "eval rm x"`)).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash -c')).toEqual([['bash', '-c']]);
+  expect(simpleCommands('bash script.sh')).toEqual([['bash', 'script.sh']]);
+  expect(simpleCommands('eval')).toEqual([]);
+});
+
+test('empty commands and unbalanced input', () => {
+  expect(simpleCommands('A=1')).toEqual([]);
+  expect(simpleCommands('}')).toEqual([]);
+  expect(simpleCommands('( )')).toEqual([]);
+  expect(simpleCommands('$()')).toEqual([]);
+  expect(simpleCommands('sudo')).toEqual([['sudo']]);
+  expect(simpleCommands('env A=1')).toEqual([['env', 'A=1']]);
+  expect(simpleCommands('a )')).toBeNull();
+  expect(simpleCommands('$(x')).toBeNull();
+  expect(simpleCommands('`x')).toBeNull();
+  expect(simpleCommands('(x')).toBeNull();
+  expect(simpleCommands(`bash -c "'"`)).toBeNull();
+  expect(simpleCommands('a "$(x')).toBeNull();
+});
+
+test('a line equals its parts joined by a separator', () => {
+  const lines = ['ls -la', 'echo "hi there" $(date)', 'FOO=1 git push -f', '(cd y && make)', 'if true; then rm -r x; fi'];
+  for (const a of lines) {
+    for (const b of lines) {
+      for (const sep of [' ; ', ' && ', ' | ', '\n']) {
+        expect(simpleCommands(a + sep + b)).toEqual([...simpleCommands(a)!, ...simpleCommands(b)!]);
+      }
+    }
+  }
+});
+
+test('bash -c and eval give the same commands as the line itself', () => {
+  for (const a of ['ls -la', 'echo "hi there"', 'sudo git push -f', '(cd y && make)', 'FOO=1 rm x; ls']) {
+    expect(simpleCommands(`bash -c '${a}'`)).toEqual(simpleCommands(a));
+  }
+  for (const a of ['ls -la', 'sudo git push -f', '(cd y && make)', 'FOO=1 rm x; ls']) {
+    expect(simpleCommands(`eval ${a}`)).toEqual(simpleCommands(a));
+  }
+});
+
+test('a redirection after the command name changes nothing', () => {
+  for (const op of [' 2>/dev/null', ' >&2', ' &>log']) {
+    expect(simpleCommands(`ls${op} -la`)).toEqual([['ls', '-la']]);
+    expect(simpleCommands(`echo${op} "a b" c`)).toEqual([['echo', 'a b', 'c']]);
+  }
+});
