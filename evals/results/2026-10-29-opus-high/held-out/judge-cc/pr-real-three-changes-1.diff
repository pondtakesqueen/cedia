diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/malformed-extra.test.ts b/test/malformed-extra.test.ts
--- a/test/malformed-extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/malformed-extra.test.ts	2026-10-29 19:39:17.084843431 +0000
@@ -0,0 +1,77 @@
+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { runPrompt, type RunOptions } from '../src/core/loop/run.ts';
+import { FAUX_MODEL } from '../src/core/providers/catalog.ts';
+import { fauxProvider, text, type FauxStep } from '../src/core/providers/faux.ts';
+import { SessionLog } from '../src/core/session/log.ts';
+import { bashTool } from '../src/core/tools/bash.ts';
+import { readTool } from '../src/core/tools/read.ts';
+
+const cwd = mkdtempSync(join(tmpdir(), 'cedia-loop-extra-'));
+writeFileSync(join(cwd, 'a.txt'), 'alpha\n');
+
+function setup(steps: FauxStep[], extra: Partial<RunOptions> = {}) {
+  const sleeps: number[] = [];
+  const opts: RunOptions = {
+    log: SessionLog.create(),
+    provider: fauxProvider(steps),
+    model: FAUX_MODEL,
+    tools: [readTool, bashTool],
+    system: 'sys',
+    cwd,
+    retry: { sleep: async (ms) => void sleeps.push(ms) },
+    ...extra,
+  };
+  return { opts, sleeps };
+}
+
+const quota = (retryAfterMs: number): FauxStep => ({ error: { code: 'quota', status: 429, message: 'usage limit reached', retryAfterMs } });
+
+describe('quota wait', () => {
+  test('an abort during a quota wait ends the run as interrupted', async () => {
+    const ac = new AbortController();
+    const waits: number[] = [];
+    const { opts } = setup([quota(5), { blocks: [text('ok')] }], {
+      signal: ac.signal,
+      quotaWaitMs: 100,
+      onQuotaWait: (ms) => {
+        waits.push(ms);
+        ac.abort();
+      },
+      retry: { sleep: async () => {} },
+    });
+    const res = await runPrompt(opts, 'hi');
+    expect(res).toMatchObject({ subtype: 'interrupted' });
+    expect(waits).toEqual([5]);
+  });
+
+  test('quota waits do not use up the retry count', async () => {
+    const { opts, sleeps } = setup([quota(1), quota(1), quota(1), quota(1), quota(1), quota(1), { blocks: [text('ok')] }], { quotaWaitMs: 100 });
+    const res = await runPrompt(opts, 'hi');
+    expect(res).toMatchObject({ subtype: 'success' });
+    expect(sleeps).toEqual([1, 1, 1, 1, 1, 1]);
+    expect(opts.log.events.filter((e) => e.kind === 'attempt')).toHaveLength(7);
+  });
+
+  test('a retryable error after five quota waits still gets its retries', async () => {
+    const server: FauxStep = { error: { code: 'server', status: 500, message: 'boom' } };
+    const { opts, sleeps } = setup([quota(1), quota(1), quota(1), quota(1), quota(1), server, { blocks: [text('ok')] }], { quotaWaitMs: 100 });
+    expect(await runPrompt(opts, 'hi')).toMatchObject({ subtype: 'success' });
+    expect(sleeps.length).toBe(6);
+  });
+
+  test('retries and quota waits interleave: only the failed attempts count against the retry limit, not the waits', async () => {
+    const server: FauxStep = { error: { code: 'server', status: 500, message: 'boom' } };
+    const { opts } = setup([server, quota(1), server, quota(1), server, quota(1), server, { blocks: [text('ok')] }], { quotaWaitMs: 100 });
+    expect(await runPrompt(opts, 'hi')).toMatchObject({ subtype: 'success' });
+  });
+
+  test('the ceiling holds across the run: the wait that would pass it falls back', async () => {
+    const { opts, sleeps } = setup([quota(10), quota(10), quota(10), { blocks: [text('ok')] }], { quotaWaitMs: 25 });
+    const res = await runPrompt(opts, 'hi');
+    expect(res).toMatchObject({ subtype: 'error_during_execution' });
+    expect(sleeps).toEqual([10, 10]);
+  });
+});
