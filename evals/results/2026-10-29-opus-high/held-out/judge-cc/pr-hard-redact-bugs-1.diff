diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact-review.test.ts b/redact-review.test.ts
--- a/redact-review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact-review.test.ts	2026-10-29 19:20:27.999668092 +0000
@@ -0,0 +1,18 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+test('secret names that continue with a letter are still redacted', () => {
+  expect(redactSecrets('secretKey = "abcd1234efgh"')).toEqual({ text: `secretKey = "${REDACTED}"`, count: 1 });
+  expect(redactSecrets('SECRETS=abc123xyz')).toEqual({ text: `SECRETS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('DB_PASSWORDS=hunter22x')).toEqual({ text: `DB_PASSWORDS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('AUTH_TOKENS=abcd1234')).toEqual({ text: `AUTH_TOKENS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('tokens: "abcd1234efgh"')).toEqual({ text: `tokens: "${REDACTED}"`, count: 1 });
+  expect(redactSecrets('{"accessToken":"abcd1234efgh5678"}')).toEqual({ text: `{"accessToken":"${REDACTED}"}`, count: 1 });
+  expect(redactSecrets('{"clientSecretValue":"abcd1234efgh5678"}')).toEqual({ text: `{"clientSecretValue":"${REDACTED}"}`, count: 1 });
+});
+
+test('token counts such as MAX_TOKENS and max_tokens are not secrets', () => {
+  expect(redactSecrets('MAX_TOKENS=4096')).toEqual({ text: 'MAX_TOKENS=4096', count: 0 });
+  expect(redactSecrets('max_tokens: 1000')).toEqual({ text: 'max_tokens: 1000', count: 0 });
+  expect(redactSecrets('tokenizer = "bert-base-uncased"')).toEqual({ text: 'tokenizer = "bert-base-uncased"', count: 0 });
+});
