diff -ruN '--exclude=node_modules' '--exclude=.git' a/shell.rules.test.ts b/shell.rules.test.ts
--- a/shell.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/shell.rules.test.ts	2026-10-29 19:27:18.635692501 +0000
@@ -0,0 +1,122 @@
+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+test('separators split commands; a stray ) is a separator', () => {
+  expect(simpleCommands('a;b&c|d&&e||f\ng')).toEqual([['a'], ['b'], ['c'], ['d'], ['e'], ['f'], ['g']]);
+  expect(simpleCommands('(a)')).toEqual([['a']]);
+  expect(simpleCommands('a ) b')).toEqual([['a'], ['b']]);
+  expect(simpleCommands('a $(b) `c`')).toEqual([['a'], ['b'], ['c']]);
+  expect(simpleCommands('"x $(rm y)"')).toEqual([['x '], ['rm', 'y']]);
+});
+
+test('2>&1, >&2 and &>f are redirections, not separators', () => {
+  expect(simpleCommands('a 2>&1 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a >&2 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a &>f b')).toEqual([['a', 'b']]);
+});
+
+test('quoting and escaping inside words', () => {
+  expect(simpleCommands(`echo 'a\\"b'`)).toEqual([['echo', 'a\\"b']]);
+  expect(simpleCommands(`echo "a\\"b"`)).toEqual([['echo', 'a"b']]);
+  expect(simpleCommands('echo a\\ b')).toEqual([['echo', 'a b']]);
+  expect(simpleCommands(`echo "" ''`)).toEqual([['echo', '', '']]);
+  expect(simpleCommands('a \\')).toEqual([['a']]);
+});
+
+test('a escaped or quoted > before & is not a redirection', () => {
+  expect(simpleCommands('echo a\\>&rm -rf /')).toEqual([['echo', 'a>'], ['rm', '-rf', '/']]);
+  expect(simpleCommands("echo a'>'&rm -rf /")).toEqual([['echo', 'a>'], ['rm', '-rf', '/']]);
+  expect(simpleCommands('2>$(b)&rm x')).toEqual([['b'], ['rm', 'x']]);
+});
+
+test('backticks nest with escaped backticks', () => {
+  expect(simpleCommands('echo `echo \\`rm x\\``')).toEqual([['echo'], ['echo'], ['rm', 'x']]);
+  expect(simpleCommands('echo `a`')).toEqual([['echo'], ['a']]);
+});
+
+test('each redirection operator drops its target; quoted operators stay', () => {
+  for (const op of ['>', '>>', '<', '2>', '&>', '>&']) {
+    expect(simpleCommands(`a ${op} f b`)).toEqual([['a', 'b']]);
+  }
+  expect(simpleCommands('a >f b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a 2>/dev/null b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a ">" b')).toEqual([['a', '>', 'b']]);
+});
+
+test('assignments and keywords are skipped only at the start of a command', () => {
+  expect(simpleCommands('a B=1')).toEqual([['a', 'B=1']]);
+  expect(simpleCommands('A=1 b')).toEqual([['b']]);
+  expect(simpleCommands('while x; do y; done')).toEqual([['x'], ['y']]);
+});
+
+test('every wrapper skips its value flags', () => {
+  for (const line of ['sudo -u root', 'doas -u root', 'env -u A', 'time -o f', 'exec -a n', 'nice -n 5', 'ionice -c 3', 'stdbuf -o L', 'xargs -n 1']) {
+    expect(simpleCommands(`${line} cmd`)).toEqual([['cmd']]);
+  }
+  expect(simpleCommands('timeout -s KILL 5 cmd')).toEqual([['cmd']]);
+  expect(simpleCommands('timeout 5 cmd')).toEqual([['cmd']]);
+});
+
+test('-- ends wrapper flags', () => {
+  expect(simpleCommands('sudo -- rm -f')).toEqual([['rm', '-f']]);
+  expect(simpleCommands('sudo -- cmd -u x')).toEqual([['cmd', '-u', 'x']]);
+});
+
+test('bash -c finds its script after all options', () => {
+  expect(simpleCommands("bash -o pipefail -c 'rm x'")).toEqual([['rm', 'x']]);
+  expect(simpleCommands("bash -c -l 'rm x'")).toEqual([['rm', 'x']]);
+});
+
+test('bash -c, sh -c, zsh, dash, ksh and -ec unpack; eval unpacks', () => {
+  expect(simpleCommands(`sh -ec 'rm -rf /'`)).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands(`zsh -c 'a'`)).toEqual([['a']]);
+  expect(simpleCommands(`dash -c 'a'`)).toEqual([['a']]);
+  expect(simpleCommands(`ksh -c 'a'`)).toEqual([['a']]);
+  expect(simpleCommands('eval "a \'b c\'"')).toEqual([['a', 'b c']]);
+  expect(simpleCommands('bash script.sh')).toEqual([['bash', 'script.sh']]);
+  expect(simpleCommands('bash -c')).toEqual([['bash', '-c']]);
+});
+
+test('empty commands are left out', () => {
+  expect(simpleCommands('a;;b')).toEqual([['a'], ['b']]);
+  expect(simpleCommands('FOO=1')).toEqual([]);
+  expect(simpleCommands('sudo')).toEqual([]);
+  expect(simpleCommands('"" ""')).toEqual([['', '']]);
+});
+
+test('unbalanced input returns null', () => {
+  expect(simpleCommands('"a')).toBeNull();
+  expect(simpleCommands("'a")).toBeNull();
+  expect(simpleCommands('$(a')).toBeNull();
+  expect(simpleCommands('`a')).toBeNull();
+  expect(simpleCommands('(a')).toBeNull();
+  expect(simpleCommands('echo "$(a"')).toBeNull();
+  expect(simpleCommands(`bash -c "echo 'x"`)).toBeNull();
+  expect(simpleCommands(`eval "echo 'x"`)).toBeNull();
+});
+
+test('a line and its parts agree', () => {
+  const words = ['a', '"b c"', "'d'", 'x\\ y', '>o', '2>&1', 'A=1', 'a\\>', "'>'", '`b`', '2>$(b)'];
+  let seed = 1;
+  const pick = (n: number) => {
+    seed = (seed * 1103515245 + 12345) % 2 ** 31;
+    return seed % n;
+  };
+  const lines: string[] = [];
+  for (let n = 0; n < 200; n++) {
+    const count = 1 + pick(4);
+    const parts: string[] = [];
+    for (let k = 0; k < count; k++) parts.push(words[pick(words.length)]);
+    lines.push(parts.join(' '));
+  }
+  for (let n = 0; n + 1 < lines.length; n++) {
+    const x = lines[n];
+    const y = lines[n + 1];
+    for (const sep of ['; ', ' | ', ' && ', ' || ', ' & ', '\n']) {
+      expect(simpleCommands(x + sep + y)).toEqual([...simpleCommands(x)!, ...simpleCommands(y)!]);
+    }
+    if (!x.includes("'")) {
+      expect(simpleCommands(`bash -c '${x}'`)).toEqual(simpleCommands(x));
+    }
+  }
+});
