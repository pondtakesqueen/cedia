+type Word = { text: string; bare: boolean };
+type Parsed = { commands: string[][]; end: number };
+
+// Words that start a redirection; a word that is only one takes the next word as its target.
+const REDIRECT = /^(\d*>>?|<|&>>?|\d*>&)$/;
+const REDIRECT_START = /^(\d*>>?|<|&>>?|\d*>&)/;
+const PLAIN = /[^\s;&|()`'"\\$]+/y;
+const ASSIGNMENT = /^[A-Za-z_]\w*=/;
+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const SHELLS = new Set(['bash', 'sh', 'zsh', 'dash', 'ksh']);
+const SHELL_C = /^-[a-zA-Z]*c[a-zA-Z]*$/;
+
+// Runs the `...` substitution that starts at the backtick at i: the first unescaped backtick closes it, and \ \` \$ are unescaped first.
+function backquoted(s: string, i: number): Parsed | null {
+  let j = i + 1;
+  while (j < s.length && s[j] !== '`') j += s[j] === '\\' ? 2 : 1;
+  if (j >= s.length) return null;
+  const commands = simpleCommands(s.slice(i + 1, j).replace(/\\([\\`$])/g, '$1'));
+  return commands && { commands, end: j + 1 };
+}
+
+// Scans shell text from pos up to the closing character close ('' is the end of the line); returns its commands and the position after close.
+function parse(s: string, pos: number, close: string): Parsed | null {
+  const commands: string[][] = [];
+  let words: Word[] = [];
+  let inner: string[][] = []; // commands of $( ) and backticks in the current command, run after it
+  let cur = null as Word | null;
+  let bad = false;
+  let gtBefore = false; // the previous token was an unquoted >, so a following & is part of the redirection
+  let i = pos;
+
+  const add = (text: string, bare: boolean) => {
+    if (!cur) cur = { text: '', bare };
+    cur.text += text;
+  };
+  const flush = () => {
+    if (cur) words.push(cur);
+    cur = null;
+  };
+  const endCommand = () => {
+    flush();
+    const argv = finish(words);
+    words = [];
+    if (argv === null) bad = true;
+    else {
+      for (const a of argv) commands.push(a);
+      for (const a of inner) commands.push(a);
+    }
+    inner = [];
+  };
+
+  while (i < s.length && !bad) {
+    const c = s[i];
+    const gt = gtBefore;
+    gtBefore = false;
+    PLAIN.lastIndex = i;
+    const run = PLAIN.exec(s);
+    if (run) {
+      add(run[0], true);
+      gtBefore = run[0].endsWith('>');
+      i = PLAIN.lastIndex;
+    } else if (c === close) {
+      endCommand();
+      return bad ? null : { commands, end: i + 1 };
+    } else if (c === "'") {
+      const e = s.indexOf("'", i + 1);
+      if (e < 0) return null;
+      add(s.slice(i + 1, e), false);
+      i = e + 1;
+    } else if (c === '"') {
+      if (!cur) cur = { text: '', bare: false };
+      i++;
+      for (;;) {
+        let j = i;
+        while (j < s.length && !'"\\$`'.includes(s[j])) j++;
+        add(s.slice(i, j), false);
+        i = j;
+        if (i >= s.length) return null;
+        const d = s[i];
+        if (d === '"') {
+          i++;
+          break;
+        }
+        if (d === '\\') {
+          if (i + 1 >= s.length) return null;
+          add(s[i + 1], false);
+          i += 2;
+        } else if (d === '$' && s[i + 1] === '(') {
+          const sub = parse(s, i + 2, ')');
+          if (!sub) return null;
+          for (const a of sub.commands) inner.push(a);
+          i = sub.end;
+        } else if (d === '`') {
+          const sub = backquoted(s, i);
+          if (!sub) return null;
+          for (const a of sub.commands) inner.push(a);
+          i = sub.end;
+        } else {
+          add(d, false);
+          i++;
+        }
+      }
+    } else if (c === '\\') {
+      if (i + 1 < s.length) add(s[i + 1], false);
+      i += 2;
+    } else if (c === '$' && s[i + 1] === '(') {
+      const sub = parse(s, i + 2, ')');
+      if (!sub) return null;
+      for (const a of sub.commands) inner.push(a);
+      i = sub.end;
+    } else if (c === '$') {
+      add('$', true);
+      i++;
+    } else if (c === '`') {
+      const sub = backquoted(s, i);
+      if (!sub) return null;
+      for (const a of sub.commands) inner.push(a);
+      i = sub.end;
+    } else if (c === '(') {
+      endCommand();
+      const sub = parse(s, i + 1, ')');
+      if (!sub) return null;
+      for (const a of sub.commands) commands.push(a);
+      i = sub.end;
+    } else if (c === '&') {
+      if (s[i + 1] === '&') {
+        endCommand();
+        i += 2;
+      } else if (s[i + 1] === '>' || gt) {
+        add('&', true);
+        i++;
+      } else {
+        endCommand();
+        i++;
+      }
+    } else if (c === '|') {
+      endCommand();
+      i += s[i + 1] === '|' ? 2 : 1;
+    } else if (c === ';' || c === ')' || c === '\n') {
+      endCommand();
+      i++;
+    } else {
+      flush();
+      i++;
+    }
+  }
+  if (close !== '') return null;
+  endCommand();
+  return bad ? null : { commands, end: i };
+}
+
+// Turns the words of one command into its argv, or into the commands of a bash -c script or eval; null when that script is unbalanced.
+function finish(words: Word[]): string[][] | null {
+  const argv: Word[] = [];
+  for (let k = 0; k < words.length; k++) {
+    const { text, bare } = words[k];
+    if (bare && REDIRECT.test(text)) k++;
+    else if (!(bare && REDIRECT_START.test(text))) argv.push(words[k]);
+  }
+  while (argv.length) {
+    const { text, bare } = argv[0];
+    if (bare && (ASSIGNMENT.test(text) || KEYWORDS.has(text))) {
+      argv.shift();
+      continue;
+    }
+    const wrapper = WRAPPERS.get(text);
+    if (!wrapper) break;
+    argv.shift();
+    while (argv.length && argv[0].text.startsWith('-')) {
+      const flag = argv[0].text;
+      argv.shift();
+      if (flag === '--') break;
+      if (wrapper.value?.includes(flag)) argv.shift();
+    }
+    argv.splice(0, wrapper.positional ?? 0);
+  }
+  const args = argv.map((w) => w.text);
+  if (args.length === 0) return [];
+  if (SHELLS.has(args[0])) {
+    let k = 1;
+    let dashC = false;
+    while (k < args.length && /^[-+]/.test(args[k])) {
+      const opt = args[k++];
+      if (opt === '--') break;
+      if (SHELL_C.test(opt)) dashC = true;
+      if (/^[-+][a-zA-Z]*o$/.test(opt)) k++; // -o and +o take the next word as their value
+    }
+    if (dashC && k < args.length) return simpleCommands(args[k]);
+  }
+  if (args[0] === 'eval') return simpleCommands(args.slice(1).join(' '));
+  return [args];
+}
+
