--- a/cron.test.ts	2026-10-29 18:55:38.224055021 +0000
+++ b/cron.test.ts	2026-10-29 18:56:45.111583511 +0000
@@ -18,3 +18,77 @@
 test("a wrong number of fields", () => {
   expect(() => nextRun("* * *", at("2026-01-01T00:00:00Z"))).toThrow(RangeError);
 });
+
+const next = (expr: string, iso: string) => nextRun(expr, at(iso)).toISOString();
+
+test("month and day names, in any case", () => {
+  expect(next("0 12 * JAN-MAR mon", "2026-03-31T13:00:00Z")).toBe("2027-01-04T12:00:00.000Z");
+  expect(next("0 12 * feb Sun", "2026-01-01T00:00:00Z")).toBe("2026-02-01T12:00:00.000Z");
+  expect(next("0 0 * * MON-FRI", "2026-01-03T00:00:00Z")).toBe("2026-01-05T00:00:00.000Z");
+});
+
+test("steps", () => {
+  expect(next("*/15 * * * *", "2026-01-01T00:16:00Z")).toBe("2026-01-01T00:30:00.000Z");
+  expect(next("0-59/15 * * * *", "2026-01-01T00:46:00Z")).toBe("2026-01-01T01:00:00.000Z");
+  expect(next("10-30/10 * * * *", "2026-01-01T00:21:00Z")).toBe("2026-01-01T00:30:00.000Z");
+  expect(next("10-30/10 * * * *", "2026-01-01T00:31:00Z")).toBe("2026-01-01T01:10:00.000Z");
+  expect(next("5/20 * * * *", "2026-01-01T00:26:00Z")).toBe("2026-01-01T00:45:00.000Z");
+  expect(next("5/20 * * * *", "2026-01-01T00:46:00Z")).toBe("2026-01-01T01:05:00.000Z");
+  expect(next("0 0 * JAN/6 *", "2026-02-01T00:00:00Z")).toBe("2026-07-01T00:00:00.000Z");
+});
+
+test("Sunday written as 7", () => {
+  expect(next("0 0 * * 7", "2026-01-01T00:00:00Z")).toBe("2026-01-04T00:00:00.000Z");
+  expect(next("0 0 * * 5-7", "2026-01-04T01:00:00Z")).toBe("2026-01-09T00:00:00.000Z");
+  expect(next("0 0 * * 5-7", "2026-01-03T01:00:00Z")).toBe("2026-01-04T00:00:00.000Z");
+});
+
+test("both day of month and day of week", () => {
+  expect(next("0 0 1,15 * 1", "2026-01-01T00:00:00Z")).toBe("2026-01-05T00:00:00.000Z");
+  expect(next("0 0 1,15 * 1", "2026-01-12T00:00:00Z")).toBe("2026-01-15T00:00:00.000Z");
+  expect(next("0 0 31 4 5", "2026-01-01T00:00:00Z")).toBe("2026-04-03T00:00:00.000Z");
+});
+
+test("a day field that allows every value defers to the other", () => {
+  expect(next("0 0 1-31 * 1", "2026-01-01T00:00:00Z")).toBe("2026-01-05T00:00:00.000Z");
+  expect(next("0 0 13 * 0-6", "2026-01-01T00:00:00Z")).toBe("2026-01-13T00:00:00.000Z");
+  expect(next("0 0 13 * 1-7", "2026-01-01T00:00:00Z")).toBe("2026-01-13T00:00:00.000Z");
+});
+
+test("the 29th of February", () => {
+  expect(next("0 0 29 2 *", "2026-01-01T00:00:00Z")).toBe("2028-02-29T00:00:00.000Z");
+  expect(next("0 0 29 2 *", "2096-03-01T00:00:00Z")).toBe("2104-02-29T00:00:00.000Z");
+});
+
+test("invalid expressions", () => {
+  for (const expr of [
+    "60 * * * *",
+    "0 24 * * *",
+    "0 0 0 * *",
+    "0 0 32 * *",
+    "0 0 * 13 *",
+    "0 0 * * 8",
+    "-1 * * * *",
+    "*/0 * * * *",
+    "*/ * * * *",
+    "1/2/3 * * * *",
+    "5-1 * * * *",
+    "1-2-3 * * * *",
+    "1- * * * *",
+    "1,,2 * * * *",
+    "1.5 * * * *",
+    "0x1 * * * *",
+    "0 0 * FOO *",
+    "0 0 * * JAN",
+    "JAN * * * *",
+    "0 0 * * FRI-SUN",
+    "* * * * * *",
+  ]) {
+    expect(() => nextRun(expr, at("2026-01-01T00:00:00Z")), expr).toThrow(RangeError);
+  }
+});
+
+test("expressions that never fire", () => {
+  expect(() => nextRun("0 0 30 2 *", at("2026-01-01T00:00:00Z"))).toThrow(RangeError);
+  expect(() => nextRun("0 0 31 4,6,9,11 *", at("2026-01-01T00:00:00Z"))).toThrow(RangeError);
+});
