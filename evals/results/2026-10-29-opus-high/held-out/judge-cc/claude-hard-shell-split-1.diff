+// Turns the words of one simple command into the commands it runs.
+function finish(words: Word[]): string[][] | null {
+  const argv: Word[] = [];
+  for (let k = 0; k < words.length; k++) {
+    const w = words[k];
+    if (REDIRECT.test(w.lead)) {
+      if (w.plain && BARE_REDIRECT.test(w.text)) k++;
+    } else if (w.exists) {
+      argv.push(w);
+    }
+  }
+
+  let k = 0;
+  let wrapperStart = -1;
+  while (k < argv.length) {
+    const w = argv[k];
+    if (ASSIGNMENT.test(w.lead) || (w.plain && KEYWORDS.has(w.text))) {
+      k++;
+      continue;
+    }
+    const wrapper = WRAPPERS.get(w.text);
+    if (!wrapper) break;
+    wrapperStart = k++;
