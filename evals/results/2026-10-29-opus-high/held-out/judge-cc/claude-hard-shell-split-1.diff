+      const flag = argv[k++].text;
+      if (flag === '--') break;
+      if (wrapper.value?.includes(flag)) k++;
+    }
+    k += wrapper.positional ?? 0;
+  }
+  // A wrapper with nothing to run (`sudo -l`, `env`) is itself the command.
+  if (k >= argv.length && wrapperStart >= 0) k = wrapperStart;
+  const rest = argv.slice(k).map((w) => w.text);
+  if (rest.length === 0) return [];
+
+  if (rest[0] === 'eval') return simpleCommands(rest.slice(1).join(' '));
+  if (SHELLS.has(rest[0].slice(rest[0].lastIndexOf('/') + 1))) {
+    let script = false;
+    let j = 1;
+    for (; j < rest.length; j++) {
+      const a = rest[j];
+      if (a === '--' || a === '-') {
+        j++;
+        break;
+      }
+      if (!/^[-+]/.test(a)) break;
