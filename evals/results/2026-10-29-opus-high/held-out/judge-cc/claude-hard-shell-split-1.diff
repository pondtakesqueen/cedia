+
+// A word as written. `lead` is its leading text that was neither quoted, escaped nor substituted, so
+// `">"` or `\>` is not a redirection and `"A=1"` is not an assignment. `touched` words are kept even
+// when only a substitution made them, so a redirection never takes the word after its target.
+type Word = { text: string; lead: string; plain: boolean; exists: boolean; touched: boolean };
+const newWord = (): Word => ({ text: '', lead: '', plain: true, exists: false, touched: false });
+
+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const SHELLS = new Set(['bash', 'sh', 'zsh', 'dash', 'ksh']);
+const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*\+?=/;
+const REDIRECT = /^(?:\d*|&)(?:>>|>&|<&|>\||<<<|<<-|<<|<>|>|<)/;
+const BARE_REDIRECT = new RegExp(REDIRECT.source + '$');
+const REDIRECT_START = /^(?:\d*|&)[<>&]*$/;
+const ANSI_ESCAPES: Record<string, string> = { n: '\n', t: '\t', r: '\r', '\\': '\\', "'": "'", '"': '"' };
+
+// `$((expr))` is arithmetic when the inner paren is closed right before the outer one, as bash decides it.
+// Anything with quotes or substitutions inside is parsed as a command substitution instead, which may report
+// extra commands but never hides one. Returns the index after `))`, or -1.
+function arithmeticEnd(s: string, start: number): number {
+  let depth = 0;
+  for (let j = start; j < s.length; j++) {
+    const c = s[j];
+    if (c === "'" || c === '"' || c === '`' || c === '\\' || (c === '$' && s[j + 1] === '(')) return -1;
+    if (c === '(') depth++;
+    else if (c === ')' && depth > 0) depth--;
+    else if (c === ')') return s[j + 1] === ')' ? j + 2 : -1;
+  }
+  return -1;
+}
