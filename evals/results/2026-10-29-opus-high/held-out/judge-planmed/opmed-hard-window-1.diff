diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.contract.test.ts b/window.contract.test.ts
--- a/window.contract.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/window.contract.test.ts	2026-10-30 03:27:38.830159203 +0000
@@ -0,0 +1,107 @@
+import { expect, test } from "bun:test";
+import { distinctInWindow, type Event } from "./window";
+
+// The original implementation, kept as the reference the faster version must agree with.
+function reference(events: Event[], windowMs: number): number[] {
+  if (!(Number.isFinite(windowMs) && windowMs > 0)) throw new RangeError(`windowMs must be a finite number above 0, got ${windowMs}`);
+  events.forEach((e, i) => {
+    if (typeof e.t !== "number" || !Number.isFinite(e.t)) throw new TypeError(`event ${i} has no finite time: ${e.t}`);
+  });
+  return events.map((e) => {
+    const keys = new Set<string>();
+    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
+    return keys.size;
+  });
+}
+
+function mulberry32(seed: number): () => number {
+  let a = seed;
+  return () => {
+    a |= 0;
+    a = (a + 0x6d2b79f5) | 0;
+    let t = Math.imul(a ^ (a >>> 15), 1 | a);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test("the window excludes its earlier edge and includes t itself", () => {
+  expect(distinctInWindow([{ t: 0, key: "a" }, { t: 10, key: "b" }], 10)).toEqual([1, 1]);
+  expect(distinctInWindow([{ t: 10, key: "a" }, { t: 0.0001, key: "b" }], 10)).toEqual([2, 1]);
+});
+
+test("a later entry with the same or an earlier time is in the window", () => {
+  expect(distinctInWindow([{ t: 5, key: "a" }, { t: 5, key: "b" }, { t: 3, key: "c" }], 10)).toEqual([3, 3, 1]);
+});
+
+test("counts come back in input order and the input is not changed", () => {
+  const events = [
+    { t: 30, key: "x" },
+    { t: 5, key: "y" },
+    { t: 12, key: "x" },
+  ];
+  const before = JSON.stringify(events);
+  const same = [...events];
+  expect(distinctInWindow(events, 10)).toEqual([1, 1, 2]);
+  expect(reference(events, 10)).toEqual([1, 1, 2]);
+  expect(JSON.stringify(events)).toBe(before);
+  expect(events.every((e, i) => e === same[i])).toBe(true);
+});
+
+test("keys are compared exactly, as strings", () => {
+  const keys = ["a", "A", "a ", "__proto__", "constructor"];
+  const events = keys.map((key) => ({ t: 1, key }));
+  expect(distinctInWindow(events, 10)).toEqual([5, 5, 5, 5, 5]);
+});
+
+test("a time too large for the window to hold it gives 0", () => {
+  expect(distinctInWindow([{ t: 1e20, key: "a" }], 1)).toEqual([0]);
+  expect(reference([{ t: 1e20, key: "a" }], 1)).toEqual([0]);
+  const events = [{ t: 0.1, key: "a" }, { t: 0.3, key: "b" }, { t: 0.2, key: "c" }];
+  expect(distinctInWindow(events, 0.2)).toEqual(reference(events, 0.2));
+});
+
+test("windowMs must be a finite number above 0, even when the events are bad too", () => {
+  for (const w of [0, -1, NaN, Infinity, -Infinity]) {
+    expect(() => distinctInWindow([{ t: 1, key: "a" }], w)).toThrow(RangeError);
+    expect(() => distinctInWindow([{ t: "x" as unknown as number, key: "a" }], w)).toThrow(RangeError);
+  }
+});
+
+test("a bad time throws a TypeError naming the first bad event", () => {
+  const bad = [{ t: 1, key: "a" }, { t: "5" as unknown as number, key: "b" }, { t: NaN, key: "c" }];
+  expect(() => distinctInWindow(bad, 10)).toThrow(TypeError);
+  expect(() => distinctInWindow(bad, 10)).toThrow("event 1 ");
+  expect(() => distinctInWindow([{ t: 1, key: "a" }, { t: Infinity, key: "b" }], 10)).toThrow("event 1 ");
+  expect(() => distinctInWindow([{ key: "a" } as unknown as Event], 10)).toThrow("event 0 ");
+});
+
+test("agrees with the original implementation on random inputs", () => {
+  const rand = mulberry32(12345);
+  const ws = [0.5, 1, 3, 7.25, 1000];
+  for (let c = 0; c < 500; c++) {
+    const n = Math.floor(rand() * 61);
+    const fractional = rand() < 0.5;
+    const events: Event[] = [];
+    for (let i = 0; i < n; i++) {
+      const t = fractional ? rand() * 30 : Math.floor(rand() * 31);
+      let key = "";
+      for (let k = 1 + Math.floor(rand() * 5); k > 0; k--) key += "abcde"[Math.floor(rand() * 5)];
+      events.push({ t, key });
+    }
+    const w = ws[Math.floor(rand() * ws.length)];
+    expect(distinctInWindow(events, w)).toEqual(reference(events, w));
+  }
+});
+
+test("200,000 events: full length, and spot values match the original", () => {
+  const rand = mulberry32(777);
+  const events: Event[] = [];
+  for (let i = 0; i < 200000; i++) events.push({ t: Math.floor(rand() * 1e6), key: String(Math.floor(rand() * 500)) });
+  const result = distinctInWindow(events, 5000);
+  expect(result.length).toBe(200000);
+  for (const i of [0, 1, 4242, 99999, 199999]) {
+    const window = events.filter((other) => other.t > events[i].t - 5000 && other.t <= events[i].t);
+    expect(result[i]).toBe(new Set(window.map((e) => e.key)).size);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.ts b/window.ts
--- a/window.ts	2026-10-30 03:24:10.352212337 +0000
+++ b/window.ts	2026-10-30 03:27:29.022159427 +0000
@@ -16,9 +16,28 @@
   events.forEach((e, i) => {
     if (typeof e.t !== "number" || !Number.isFinite(e.t)) throw new TypeError(`event ${i} has no finite time: ${e.t}`);
   });
-  return events.map((e) => {
-    const keys = new Set<string>();
-    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
-    return keys.size;
-  });
+  const n = events.length;
+  const times = new Float64Array(n);
+  for (let i = 0; i < n; i++) times[i] = events[i].t;
+  const order = Array.from({ length: n }, (_, i) => i).sort((a, b) => times[a] - times[b]);
+  const counts = new Array<number>(n);
+  const inWindow = new Map<string, number>(); // key -> how many events with that key are in the window
+  let start = 0; // first position in `order` still in the window
+  for (let end = 0; end < n; ) {
+    const t = times[order[end]];
+    const groupStart = end;
+    for (; end < n && times[order[end]] === t; end++) {
+      const k = events[order[end]].key;
+      inWindow.set(k, (inWindow.get(k) ?? 0) + 1);
+    }
+    const after = t - windowMs;
+    for (; start < end && times[order[start]] <= after; start++) {
+      const k = events[order[start]].key;
+      const c = inWindow.get(k)! - 1;
+      if (c === 0) inWindow.delete(k);
+      else inWindow.set(k, c);
+    }
+    for (let j = groupStart; j < end; j++) counts[order[j]] = inWindow.size;
+  }
+  return counts;
 }
