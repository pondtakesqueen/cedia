+      onQuotaWait: (ms) => void waits.push(ms),
+    });
+    expect(await runPrompt(opts, 'go')).toMatchObject({ subtype: 'success', result: 'done' });
+    expect(sleeps).toEqual(Array(6).fill(60_000));
+    expect(waits).toHaveLength(6);
+  });
+
+  test('a quota wait that would pass the run ceiling falls back instead', async () => {
+    const { opts, sleeps } = setup([...Array.from({ length: 11 }, () => quota(60_000)), { blocks: [text('done')] }], { quotaWaitMs: 10 * 60_000 });
+    expect(await runPrompt(opts, 'go')).toMatchObject({ subtype: 'error_during_execution' });
+    expect(sleeps).toHaveLength(10);
+  });
+
+  test('an abort during a quota wait ends the run as interrupted, so nothing falls back', async () => {
+    const ac = new AbortController();
+    setTimeout(() => ac.abort(), 10);
+    const { opts } = setup([quota(600_000)], { retry: {}, quotaWaitMs: 30 * 60_000, signal: ac.signal });
+    const started = performance.now();
+    expect(await runPrompt(opts, 'go')).toMatchObject({ subtype: 'interrupted' });
+    expect(performance.now() - started).toBeLessThan(1000);
+  });
+
+  test('a refused history is recorded in the thread as rejected', () => {
+    const home = mkdtempSync(join(tmpdir(), 'cedia-turns-home-'));
+    const script = join(home, 'script.json');
+    const rejected = { error: { code: 'bad_request', status: 400, message: 'Invalid `signature` in `thinking` block' } };
+    writeFileSync(script, JSON.stringify([{ blocks: [{ type: 'tool_use', id: 'c1', name: 'bash', input: { command: 'ls' } }] }, rejected, { blocks: [{ type: 'text', text: 'done' }] }]));
+    const proc = Bun.spawnSync([BIN, '-m', 'faux', '--cwd', cwd, '-p', 'go', '--output-format', 'json'], {
+      env: { ...process.env, CEDIA_FAUX_SCRIPT: script, CEDIA_HOME: join(home, 'cedia') },
+    });
+    expect(proc.exitCode).toBe(0);
+    expect(Bun.spawnSync(['grep', '-r', '"why":"rejected"', join(home, 'cedia')]).exitCode).toBe(0);
+  });
+});
