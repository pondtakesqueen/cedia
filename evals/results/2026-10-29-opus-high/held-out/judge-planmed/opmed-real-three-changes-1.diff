+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { runPrompt, type RunOptions } from '../src/core/loop/run.ts';
+import { FAUX_MODEL } from '../src/core/providers/catalog.ts';
+import { fauxProvider, text, toolUse, type FauxStep } from '../src/core/providers/faux.ts';
+import { lintSession } from '../src/core/session/lint.ts';
+import { SessionLog } from '../src/core/session/log.ts';
+import { bashTool } from '../src/core/tools/bash.ts';
+import { readTool } from '../src/core/tools/read.ts';
+import type { EventOf, SessionEvent } from '../src/core/types.ts';
+
+const BIN = join(import.meta.dir, '..', 'bin', 'cedia');
+const cwd = mkdtempSync(join(tmpdir(), 'cedia-turns-'));
+writeFileSync(join(cwd, 'a.txt'), 'alpha\n');
+
+function setup(steps: FauxStep[], extra: Partial<RunOptions> = {}) {
+  const log = SessionLog.create();
+  const sleeps: number[] = [];
+  const opts: RunOptions = {
+    log,
+    provider: fauxProvider(steps),
+    model: FAUX_MODEL,
+    tools: [readTool, bashTool],
+    system: 'sys',
+    cwd,
+    retry: { sleep: async (ms) => void sleeps.push(ms) },
+    ...extra,
+  };
+  return { log, opts, sleeps };
+}
+
+const of = <K extends SessionEvent['kind']>(events: SessionEvent[], k: K) => events.filter((e): e is EventOf<K> => e.kind === k);
+const quota = (retryAfterMs: number) => ({ error: { code: 'quota', status: 429, retryAfterMs, message: 'quota is spent' } }) as unknown as FauxStep;
+
+describe('turns', () => {
+  test('a refusal that comes with tool calls fails the run and leaves each call not started', async () => {
+    const { log, opts } = setup([{ blocks: [text('no'), toolUse('c1', 'read', { path: 'a.txt' })], stop: 'refusal' }]);
+    expect(await runPrompt(opts, 'go')).toMatchObject({ subtype: 'error_during_execution', result: 'no' });
+    expect(of(log.events, 'tool_intent')).toHaveLength(0);
+    expect(of(log.events, 'tool_result')).toMatchObject([{ callId: 'c1', status: 'not_started' }]);
+    expect(lintSession(log.events)).toEqual([]);
+  });
+
+  test('calls that share an id stay paired when the budget stops the turn', async () => {
+    const { log, opts } = setup([{ blocks: [toolUse('dup', 'bash', { command: 'echo one' }), toolUse('dup', 'bash', { command: 'echo two' })] }], { maxBudgetUsd: 0 });
+    expect(await runPrompt(opts, 'go')).toMatchObject({ subtype: 'error_max_budget_usd' });
+    expect(of(log.events, 'tool_result')).toMatchObject([{ callId: 'dup', status: 'not_started' }]);
+    expect(lintSession(log.events)).toEqual([]);
+  });
+
+  test('random turns with repeated ids get one result and one intent per distinct id', async () => {
+    let seed = 7;
+    const pick = (n: number) => {
+      seed = (seed * 16807) % 2147483647;
+      return seed % n;
+    };
+    const pool = ['a', 'b', 'c'];
+    for (let i = 0; i < 40; i++) {
+      const picked = Array.from({ length: 1 + pick(6) }, () => pool[pick(3)]!);
+      const { log, opts } = setup([{ blocks: picked.map((id) => toolUse(id, 'read', { path: 'a.txt' })) }, { blocks: [text('ok')] }]);
+      await runPrompt(opts, 'go');
+      const distinct = [...new Set(picked)].sort();
+      expect(of(log.events, 'tool_result').map((r) => r.callId).sort()).toEqual(distinct);
+      expect(of(log.events, 'tool_intent')).toHaveLength(distinct.length);
+      expect(lintSession(log.events)).toEqual([]);
+    }
+  });
+
+  test('a tool name is cut to 64 characters in its not-run result', async () => {
+    const { log, opts } = setup([{ blocks: [toolUse('c1', 'x'.repeat(100), {})] }, { blocks: [text('ok')] }]);
+    await runPrompt(opts, 'go');
+    const out = of(log.events, 'tool_result')[0]!.output.text;
+    expect(out).toContain('x'.repeat(64));
+    expect(out).not.toContain('x'.repeat(65));
+  });
