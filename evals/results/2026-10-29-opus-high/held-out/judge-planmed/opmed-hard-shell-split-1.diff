+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+test('separators split commands but not quoted text', () => {
+  expect(simpleCommands('a;b&c|d&&e||f')).toEqual([['a'], ['b'], ['c'], ['d'], ['e'], ['f']]);
+  expect(simpleCommands('echo "a;b|c&d" \'x(y)\'')).toEqual([['echo', 'a;b|c&d', 'x(y)']]);
+  expect(simpleCommands('a $(b; c) d')).toEqual([['a', 'd'], ['b'], ['c']]);
+});
+
+test('substitutions are commands listed after their command', () => {
+  expect(simpleCommands('echo "`id`"')).toEqual([['echo', ''], ['id']]);
+  expect(simpleCommands('echo "$(rm x)"')).toEqual([['echo', ''], ['rm', 'x']]);
+  expect(simpleCommands('cat > $(rm x)')).toEqual([['cat'], ['rm', 'x']]);
+  expect(simpleCommands('A=$(rm x) ls')).toEqual([['ls'], ['rm', 'x']]);
+  expect(simpleCommands('echo $(true)')).toEqual([['echo'], ['true']]);
+});
+
+test('2>&1, >&2 and &>file are redirections, not background jobs', () => {
+  expect(simpleCommands('a 2>&1 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a >&2')).toEqual([['a']]);
+  expect(simpleCommands('a &>f b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a&>f')).toEqual([['a']]);
+  expect(simpleCommands('cat <&3 x')).toEqual([['cat', 'x']]);
+  expect(simpleCommands('a >| f x')).toEqual([['a', 'x']]);
+});
+
+test('word splitting and quote removal', () => {
+  expect(simpleCommands('a\tb')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a"b"\'c\'')).toEqual([['abc']]);
+  expect(simpleCommands("'a\\\"b'")).toEqual([['a\\"b']]);
+  expect(simpleCommands('"a\\b"')).toEqual([['ab']]);
+  expect(simpleCommands('a\\ b')).toEqual([['a b']]);
+  expect(simpleCommands('x \'\' ""')).toEqual([['x', '', '']]);
+});
+
+test('a redirection operator alone drops itself and its target', () => {
+  for (const op of ['>', '>>', '<', '2>', '&>', '>&']) {
+    expect(simpleCommands(`ls ${op} f x`)).toEqual([['ls', 'x']]);
+  }
+  expect(simpleCommands('ls > ; rm x')).toEqual([['ls'], ['rm', 'x']]);
+});
+
+test('attached redirections drop themselves', () => {
+  expect(simpleCommands('c >o')).toEqual([['c']]);
+  expect(simpleCommands('c 2>/dev/null')).toEqual([['c']]);
+  expect(simpleCommands('c >>o')).toEqual([['c']]);
+  expect(simpleCommands('c <i')).toEqual([['c']]);
+  expect(simpleCommands('echo a>b')).toEqual([['echo', 'a']]);
+  expect(simpleCommands('echo ">" x')).toEqual([['echo', '>', 'x']]);
+});
+
+test('leading assignments are skipped, quoted names are not assignments', () => {
+  expect(simpleCommands('A=1 B="x y" cmd')).toEqual([['cmd']]);
+  expect(simpleCommands('"A=1" cmd')).toEqual([['A=1', 'cmd']]);
+});
+
+test('keywords are skipped', () => {
+  for (const kw of ['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']) {
+    expect(simpleCommands(`${kw} a`)).toEqual([['a']]);
+  }
+  expect(simpleCommands('while ! a; do b; done')).toEqual([['a'], ['b']]);
+  expect(simpleCommands('{rm')).toEqual([['{rm']]);
+});
+
+test('every wrapper is unwrapped', () => {
+  expect(simpleCommands('sudo -u root ls')).toEqual([['ls']]);
+  expect(simpleCommands('doas -C conf ls')).toEqual([['ls']]);
+  expect(simpleCommands('env -u HOME ls')).toEqual([['ls']]);
+  expect(simpleCommands('command ls')).toEqual([['ls']]);
+  expect(simpleCommands('nohup ls')).toEqual([['ls']]);
+  expect(simpleCommands('time -f %e ls')).toEqual([['ls']]);
+  expect(simpleCommands('exec -a name ls')).toEqual([['ls']]);
+  expect(simpleCommands('nice -n 5 ls')).toEqual([['ls']]);
+  expect(simpleCommands('ionice -c 2 ls')).toEqual([['ls']]);
+  expect(simpleCommands('setsid ls')).toEqual([['ls']]);
+  expect(simpleCommands('stdbuf -o L ls')).toEqual([['ls']]);
+  expect(simpleCommands('timeout 5 ls')).toEqual([['ls']]);
+  expect(simpleCommands('timeout -s KILL 5 ls')).toEqual([['ls']]);
+  expect(simpleCommands('xargs -n 1 rm')).toEqual([['rm']]);
+});
+
+test('-- ends wrapper flags, a wrapper path is its basename, a bare wrapper is kept', () => {
+  expect(simpleCommands('sudo -- ls')).toEqual([['ls']]);
+  expect(simpleCommands('env -- ls -l')).toEqual([['ls', '-l']]);
+  expect(simpleCommands('/usr/bin/sudo rm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('sudo -v')).toEqual([['sudo', '-v']]);
+  expect(simpleCommands('timeout 5')).toEqual([['timeout', '5']]);
+});
+
+test('shell scripts and eval are unpacked', () => {
+  for (const shell of ['bash', 'sh', 'zsh', 'dash', 'ksh']) {
+    expect(simpleCommands(`${shell} -c 'a'`)).toEqual([['a']]);
+  }
+  expect(simpleCommands("bash -ec 'a;b'")).toEqual([['a'], ['b']]);
+  expect(simpleCommands("bash -o pipefail -c 'a'")).toEqual([['a']]);
+  expect(simpleCommands('bash x.sh')).toEqual([['bash', 'x.sh']]);
+  expect(simpleCommands(`eval "a 'b c'"`)).toEqual([['a', 'b c']]);
+});
+
+test('empty commands are left out', () => {
+  expect(simpleCommands('> out')).toEqual([]);
+  expect(simpleCommands('A=1')).toEqual([]);
+  expect(simpleCommands('fi')).toEqual([]);
+  expect(simpleCommands('eval')).toEqual([]);
+  expect(simpleCommands("bash -c ''")).toEqual([]);
+});
+
+test('unbalanced input returns null', () => {
+  expect(simpleCommands('"')).toBeNull();
+  expect(simpleCommands("'")).toBeNull();
+  expect(simpleCommands('echo "a\\')).toBeNull();
+  expect(simpleCommands('$(a')).toBeNull();
+  expect(simpleCommands('`a')).toBeNull();
+  expect(simpleCommands('(a')).toBeNull();
+  expect(simpleCommands('echo $(x "y)')).toBeNull();
+  expect(simpleCommands(`bash -c "echo 'x"`)).toBeNull();
+});
+
+// Deterministic generator (linear congruential), so the cases are the same on every run.
+let seed = 7;
+const rand = (n: number): number => {
+  seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+  return (seed >>> 8) % n;
+};
+const pick = <T>(xs: T[]): T => xs[rand(xs.length)];
+const gap = (): string => Array.from({ length: 1 + rand(3) }, () => pick([' ', '\t'])).join('');
+
+test('generated lines give the same commands in every form', () => {
+  const FIRST = ['ls', 'git', 'rm', 'x'];
+  const REST = ['push', '-f', 'a.txt', 'x', 'rm', '-rf'];
+  const SEPS = [';', '&&', '||', '|', '&', '\n'];
+  for (let n = 0; n < 200; n++) {
+    const texts = Array.from({ length: 1 + rand(4) }, () =>
+      [pick(FIRST), ...Array.from({ length: rand(4) }, () => pick(REST))].join(gap()),
+    );
+    const seps = texts.slice(1).map(() => pick(SEPS) + gap());
+    const join = (parts: string[]) => parts.reduce((acc, part, k) => (k === 0 ? part : acc + seps[k - 1] + part), '');
+    const cmds = texts.map((t) => t.split(/[ \t]+/));
+    const line = join(texts);
+    const redirected = join(texts.map((t) => `${t} 2>/dev/null`));
+    expect(simpleCommands(line)).toEqual(cmds);
+    expect(simpleCommands(redirected)).toEqual(cmds);
+    expect(simpleCommands(`(${line})`)).toEqual(cmds);
+    expect(simpleCommands(`\`${line}\``)).toEqual(cmds);
+    expect(simpleCommands(`bash -c '${line}'`)).toEqual(cmds);
+    expect(simpleCommands(`eval ${line}`)).toEqual(cmds);
+    expect(simpleCommands(`FOO=1 ${line}`)).toEqual(cmds);
+    expect(simpleCommands(`sudo ${line}`)).toEqual(cmds);
+    expect(simpleCommands(`echo $(${line})`)).toEqual([['echo'], ...cmds]);
+  }
+});
