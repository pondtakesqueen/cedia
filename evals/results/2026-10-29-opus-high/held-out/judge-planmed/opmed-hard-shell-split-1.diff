+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const SHELLS = new Set(['bash', 'sh', 'zsh', 'dash', 'ksh']);
+const SHELL_VALUE_FLAGS = new Set(['-o', '+o', '-O', '+O', '--rcfile', '--init-file']);
+const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;
+const REDIRECT = /(?:\d+|&)?(?:>>|>&|>\||<&|>|<)/y; // a redirection operator at the start of a word
+const PLAIN = /[^\s;&|()<>`$'"\\]+/y; // unquoted text with nothing special in it
+const DQ_PLAIN = /[^"\\$`]+/y; // text inside double quotes with nothing special in it
+const BLANKS = /[^\S\n]+/y; // whitespace other than a newline
+
+// One word: `text` with quotes and escapes removed, `raw` as written, `quoted` set when a quote was used,
+// so "" still counts as a word.
+type Word = { text: string; raw: string; quoted: boolean };
+
+// Turns the words of one command into argv: skips keywords and assignments, unwraps wrappers, and unpacks
+// `eval` and shell `-c` scripts. Null if such a script is unbalanced.
+function finish(words: Word[]): string[][] | null {
+  let i = 0;
+  for (;;) {
+    while (i < words.length && (KEYWORDS.has(words[i].raw) || ASSIGNMENT.test(words[i].raw))) i++;
+    if (i === words.length) return [];
+    const name = words[i].text.slice(words[i].text.lastIndexOf('/') + 1);
+    const wrapper = WRAPPERS.get(name);
+    if (wrapper === undefined) {
+      if (name === 'eval') return simpleCommands(words.slice(i + 1).map((w) => w.text).join(' '));
+      if (SHELLS.has(name)) {
+        const script = shellScript(words, i);
+        if (script !== undefined) return simpleCommands(script);
+      }
+      break;
+    }
+    const next = afterWrapper(words, i, wrapper);
+    if (next >= words.length) break; // nothing to run after the wrapper: keep it as it is
+    i = next;
+  }
+  return [words.slice(i).map((w) => w.text)];
+}
+
+// Index of the first word after a wrapper at words[i], its flags, the words of its value flags and its positionals.
+function afterWrapper(words: Word[], i: number, wrapper: Wrapper): number {
+  let j = i + 1;
+  while (j < words.length && words[j].text.startsWith('-')) {
+    const flag = words[j].text;
+    j++;
+    if (flag === '--') break;
+    if (wrapper.value?.includes(flag)) j++;
+  }
+  return j + (wrapper.positional ?? 0);
+}
+
+// The script of `bash -c <script>` (flags may come before -c), or undefined when there is none.
+function shellScript(words: Word[], i: number): string | undefined {
+  let runs = false;
+  let j = i + 1;
+  for (; j < words.length && /^[-+]/.test(words[j].text); j++) {
+    const flag = words[j].text;
+    if (flag === '--') {
+      j++;
+      break;
+    }
+    if (/^-[A-Za-z]*c/.test(flag)) runs = true;
+    else if (SHELL_VALUE_FLAGS.has(flag)) j++;
+  }
+  return runs ? words[j]?.text : undefined;
+}
 
