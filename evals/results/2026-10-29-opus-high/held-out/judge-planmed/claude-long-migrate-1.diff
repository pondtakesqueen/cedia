+export async function adjustStock(req: { sku: string; delta: number }): Promise<Row> {
+  if (!Number.isInteger(req.delta) || req.delta === 0) throw new HttpError(400, 'delta must be a non-zero integer');
+  const stock = await db.promises.get('stock', req.sku);
+  const units = ((stock?.units as number | undefined) ?? 0) + req.delta;
+  if (units < 0) throw new HttpError(409, `stock of ${req.sku} would be ${units}`);
+  return db.promises.put('stock', { id: req.sku, units });
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/handlers/stock/transferStock.ts b/src/handlers/stock/transferStock.ts
--- a/src/handlers/stock/transferStock.ts	2026-10-29 19:05:49.934625622 +0000
+++ b/src/handlers/stock/transferStock.ts	2026-10-29 19:06:13.960226473 +0000
@@ -2,21 +2,13 @@
 import { HttpError } from '../../errors.ts';
 
 // Moves units of one sku to another sku's count (a repack). Both rows are written, source first.
-export function transferStock(req: { from: string; to: string; units: number }, done: (err: Error | null, res?: { from: Row; to: Row }) => void): void {
-  if (req.from === req.to) return done(new HttpError(400, 'from and to are the same'));
-  db.get('stock', req.from, (err, a) => {
-    if (err) return done(err);
-    const have = (a?.units as number | undefined) ?? 0;
-    if (have < req.units) return done(new HttpError(409, `only ${have} ${req.from} left`));
-    db.get('stock', req.to, (err2, b) => {
-      if (err2) return done(err2);
-      db.put('stock', { id: req.from, units: have - req.units }, (err3, from) => {
-        if (err3) return done(err3);
-        db.put('stock', { id: req.to, units: ((b?.units as number | undefined) ?? 0) + req.units }, (err4, to) => {
-          if (err4) return done(err4);
-          done(null, { from: from!, to: to! });
-        });
-      });
-    });
-  });
+export async function transferStock(req: { from: string; to: string; units: number }): Promise<{ from: Row; to: Row }> {
+  if (req.from === req.to) throw new HttpError(400, 'from and to are the same');
+  const a = await db.promises.get('stock', req.from);
+  const have = (a?.units as number | undefined) ?? 0;
+  if (have < req.units) throw new HttpError(409, `only ${have} ${req.from} left`);
+  const b = await db.promises.get('stock', req.to);
+  const from = await db.promises.put('stock', { id: req.from, units: have - req.units });
+  const to = await db.promises.put('stock', { id: req.to, units: ((b?.units as number | undefined) ?? 0) + req.units });
+  return { from, to };
 }
