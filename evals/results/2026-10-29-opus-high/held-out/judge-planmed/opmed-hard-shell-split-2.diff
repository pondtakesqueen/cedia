diff -ruN '--exclude=node_modules' '--exclude=.git' a/shell.rules.test.ts b/shell.rules.test.ts
--- a/shell.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/shell.rules.test.ts	2026-10-30 03:24:06.482164059 +0000
@@ -0,0 +1,144 @@
+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+test('separators split, including parentheses', () => {
+  expect(simpleCommands('a;b&c|d&&e||f\ng')).toHaveLength(7);
+  expect(simpleCommands('(a)b')).toEqual([['a'], ['b']]);
+});
+
+test('substitutions are commands after their command, in source order', () => {
+  expect(simpleCommands('x $(a) `b` $(c $(d))')).toEqual([['x'], ['a'], ['b'], ['c'], ['d']]);
+  expect(simpleCommands('a$(b)c')).toEqual([['ac'], ['b']]);
+});
+
+test('separators inside quotes do not split', () => {
+  expect(simpleCommands(`echo "a;b|c" 'd&e' "(f)"`)).toEqual([['echo', 'a;b|c', 'd&e', '(f)']]);
+});
+
+test('fd redirections are not background jobs', () => {
+  expect(simpleCommands('a 2>&1 b >&2 c &>f d')).toEqual([['a', 'b', 'c', 'd']]);
+  expect(simpleCommands('a <&0 b')).toEqual([['a', 'b']]);
+});
+
+test('single quotes are literal', () => {
+  expect(simpleCommands(`echo 'a\\b "c" $(d)'`)).toEqual([['echo', 'a\\b "c" $(d)']]);
+});
+
+test('backslash escapes, and backslash-newline continues', () => {
+  expect(simpleCommands('a \\; b "x\\$y"')).toEqual([['a', ';', 'b', 'x$y']]);
+  expect(simpleCommands('a \\\nb')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a\\\nb')).toEqual([['ab']]);
+});
+
+test('empty quoted strings are words', () => {
+  expect(simpleCommands(`'' ; a ""`)).toEqual([[''], ['a', '']]);
+});
+
+test('operator-only words drop themselves and their target', () => {
+  for (const op of ['>', '>>', '<', '2>', '&>', '>&']) {
+    expect(simpleCommands(`c ${op} t arg`)).toEqual([['c', 'arg']]);
+  }
+});
+
+test('operator-prefixed words drop only themselves; quoted operators are arguments', () => {
+  expect(simpleCommands('c >o 2>>e <i 2>&1 arg')).toEqual([['c', 'arg']]);
+  expect(simpleCommands(`echo ">" '<'`)).toEqual([['echo', '>', '<']]);
+});
+
+test('an operator against a word still splits it', () => {
+  expect(simpleCommands('rm>x -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('a2>x')).toEqual([['a2']]);
+});
+
+test('leading assignments and keywords are skipped only at the start', () => {
+  expect(simpleCommands('! A=1 if B=2 x')).toEqual([['x']]);
+  expect(simpleCommands('while a; do b; done')).toEqual([['a'], ['b']]);
+  expect(simpleCommands('echo fi A=1')).toEqual([['echo', 'fi', 'A=1']]);
+});
+
+test('wrapper flags, value flags, -- and positionals', () => {
+  expect(simpleCommands('nice -n 5 make')).toEqual([['make']]);
+  expect(simpleCommands('sudo --user=root ls')).toEqual([['ls']]);
+  expect(simpleCommands('sudo -- -x')).toEqual([['-x']]);
+  expect(simpleCommands('timeout 5 make')).toEqual([['make']]);
+  expect(simpleCommands('env -u X A=1 nice ls')).toEqual([['ls']]);
+});
+
+test('wrapper and shell names match by basename', () => {
+  expect(simpleCommands('/usr/bin/sudo /bin/rm x')).toEqual([['/bin/rm', 'x']]);
+  expect(simpleCommands(`/bin/sh -c 'id'`)).toEqual([['id']]);
+});
+
+test('shell -c with clustered flags, other flags, and $0', () => {
+  expect(simpleCommands(`bash -e -c 'a; b' x y`)).toEqual([['a'], ['b']]);
+  expect(simpleCommands(`sh -lc 'a'`)).toEqual([['a']]);
+  expect(simpleCommands(`bash -o pipefail -c 'a'`)).toEqual([['a']]);
+  expect(simpleCommands('bash -O extglob -c "rm x"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash +O extglob -c "rm x"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash +e -c "rm x"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash --rcfile f -c "rm x"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash --init-file f -c "rm x"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash --norc -c "rm x"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash +o noclobber -c "rm x"')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash script.sh')).toEqual([['bash', 'script.sh']]);
+  expect(simpleCommands(`bash -c "echo 'x"`)).toBeNull();
+});
+
+test('eval joins its words and parses them', () => {
+  expect(simpleCommands('eval "a; b"')).toEqual([['a'], ['b']]);
+});
+
+test('empty commands are left out', () => {
+  expect(simpleCommands('> f; A=1; { ; }')).toEqual([]);
+  expect(simpleCommands('A=$(rm x)')).toEqual([['rm', 'x']]);
+});
+
+test('a wrapper, eval or bash -c with nothing left keeps its own argv', () => {
+  expect(simpleCommands('sudo -l')).toEqual([['sudo', '-l']]);
+  expect(simpleCommands('env')).toEqual([['env']]);
+  expect(simpleCommands('eval')).toEqual([['eval']]);
+  expect(simpleCommands(`sudo bash -c ''`)).toEqual([['sudo', 'bash', '-c', '']]);
+});
+
+test('unbalanced input returns null', () => {
+  for (const src of ['"a', "'a", '$(a', '(a', '`a', 'a)', 'echo "$(a']) {
+    expect(simpleCommands(src)).toBeNull();
+  }
+});
+
+test('substitutions inside double quotes are still commands', () => {
+  expect(simpleCommands('echo "$(rm x)" "`id`"')).toEqual([['echo', '', ''], ['rm', 'x'], ['id']]);
+});
+
+test('agreement with composed lines (seeded, deterministic)', () => {
+  const pool: [string, string[][]][] = [
+    ['ls -l', [['ls', '-l']]],
+    ['grep "a b" x', [['grep', 'a b', 'x']]],
+    ["echo 'c;d'", [['echo', 'c;d']]],
+    ['FOO=1 make', [['make']]],
+    ['sudo -u root git push', [['git', 'push']]],
+    ['cmd 2>/dev/null arg', [['cmd', 'arg']]],
+    ['a | b', [['a'], ['b']]],
+  ];
+  const seps = [';', ' && ', ' || ', ' | ', '\n', ' & '];
+  let seed = 12345;
+  const rnd = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  for (let iter = 0; iter < 300; iter++) {
+    const count = 1 + rnd(5);
+    let line = '';
+    let expected: string[][] = [];
+    for (let k = 0; k < count; k++) {
+      const [src, argv] = pool[rnd(pool.length)];
+      const sep = k === 0 ? '' : seps[rnd(seps.length)];
+      const space = ' \t'.repeat(1 + rnd(2));
+      line += (k === 0 ? '' : space) + sep + space + src;
+      expected = expected.concat(argv);
+    }
+    expect(simpleCommands(line)).toEqual(expected);
+    expect(simpleCommands(`(${line})`)).toEqual(expected);
+    expect(simpleCommands(`echo $(${line})`)).toEqual([['echo'], ...expected]);
+  }
+});
