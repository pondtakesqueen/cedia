diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.contract.test.ts b/window.contract.test.ts
--- a/window.contract.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/window.contract.test.ts	2026-10-30 03:27:00.378160082 +0000
@@ -0,0 +1,121 @@
+import { expect, test } from "bun:test";
+import { distinctInWindow, type Event } from "./window";
+
+// The original quadratic implementation, kept as the reference for the contract.
+function naive(events: Event[], windowMs: number): number[] {
+  return events.map((e) => {
+    const keys = new Set<string>();
+    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
+    return keys.size;
+  });
+}
+
+// Seeded PRNG (mulberry32), so every run sees the same cases.
+function rng(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test("the lower end of the window is excluded, the upper end included", () => {
+  expect(distinctInWindow([{ t: 0, key: "a" }, { t: 10, key: "b" }], 10)).toEqual([1, 1]);
+  expect(distinctInWindow([{ t: 0.5, key: "a" }, { t: 10, key: "b" }], 10)).toEqual([1, 2]);
+  expect(distinctInWindow([{ t: 5, key: "a" }, { t: 5, key: "b" }], 10)).toEqual([2, 2]);
+});
+
+test("later entries with the same or an earlier time count too", () => {
+  expect(distinctInWindow([{ t: 8, key: "a" }, { t: 0, key: "b" }, { t: 5, key: "c" }], 10)).toEqual([3, 1, 2]);
+});
+
+test("returns one count per event in input order and leaves the input unchanged", () => {
+  const events = [{ t: 3, key: "x" }, { t: 1, key: "y" }, { t: 2, key: "x" }];
+  const copy = structuredClone(events);
+  const counts = distinctInWindow(events, 5);
+  expect(counts).toEqual([2, 1, 2]);
+  expect(events).toEqual(copy);
+});
+
+test("keys are compared exactly, as strings", () => {
+  const events = [
+    { t: 1, key: "a" },
+    { t: 1, key: "A" },
+    { t: 1, key: "" },
+    { t: 1, key: "__proto__" },
+    { t: 1, key: "constructor" },
+    { t: 1, key: "toString" },
+    { t: 1, key: "a" },
+  ];
+  expect(distinctInWindow(events, 10)).toEqual([6, 6, 6, 6, 6, 6, 6]);
+});
+
+test("a window that is not finite or not above 0 is a RangeError", () => {
+  for (const w of [0, -1, NaN, Infinity, -Infinity]) {
+    expect(() => distinctInWindow([{ t: 1, key: "a" }], w)).toThrow(RangeError);
+  }
+  // the window check runs before the event check
+  expect(() => distinctInWindow([{ t: NaN, key: "a" }], 0)).toThrow(RangeError);
+});
+
+test("a time that is not finite is a TypeError naming the first bad index", () => {
+  const events: Event[] = [
+    { t: 1, key: "a" },
+    { t: NaN, key: "b" },
+    { t: 2, key: "c" },
+    // @ts-expect-error the type says t is a number; the runtime check still refuses a string
+    { t: "5", key: "d" },
+  ];
+  expect(() => distinctInWindow(events, 10)).toThrow(TypeError);
+  expect(() => distinctInWindow(events, 10)).toThrow("event 1 has no finite time");
+  const badTimes: unknown[] = [Infinity, -Infinity, undefined, "5"];
+  for (const t of badTimes) {
+    // @ts-expect-error the type says t is a number; the runtime check still refuses a non-finite time
+    const pair: Event[] = [{ t: 1, key: "a" }, { t, key: "b" }];
+    expect(() => distinctInWindow(pair, 10)).toThrow("event 1 has no finite time");
+  }
+});
+
+test("when t - windowMs rounds to t, the event's own window is empty", () => {
+  expect(distinctInWindow([{ t: 1e20, key: "a" }], 1)).toEqual([0]);
+  expect(distinctInWindow([{ t: 1e20, key: "a" }, { t: 1e20, key: "b" }], 1)).toEqual([0, 0]);
+});
+
+test("negative times and -0 behave like their values", () => {
+  expect(distinctInWindow([{ t: -5, key: "a" }, { t: -3, key: "b" }, { t: -20, key: "c" }], 10)).toEqual([1, 2, 1]);
+  expect(distinctInWindow([{ t: -0, key: "a" }, { t: 0, key: "b" }], 1)).toEqual([2, 2]);
+});
+
+test("agrees with the original implementation on random small inputs", () => {
+  const next = rng(12345);
+  const windows = [1, 0.5, 3, 7, 10, 1000];
+  for (let c = 0; c < 500; c++) {
+    const n = Math.floor(next() * 61);
+    const keyPool = 1 + Math.floor(next() * 8);
+    const fractional = next() < 0.3;
+    const events: Event[] = [];
+    for (let i = 0; i < n; i++) {
+      const t = fractional ? Math.round(next() * 30 * 10) / 10 : Math.floor(next() * 31);
+      events.push({ t, key: "k" + Math.floor(next() * keyPool) });
+    }
+    const windowMs = next() < 0.7 ? windows[Math.floor(next() * windows.length)] : 0.01 + next() * 20;
+    expect(distinctInWindow(events, windowMs)).toEqual(naive(events, windowMs));
+  }
+});
+
+test("200,000 events give the known answers", () => {
+  const next = rng(777);
+  const n = 200_000;
+  const perm = Array.from({ length: n }, (_, i) => i);
+  for (let i = n - 1; i > 0; i--) {
+    const j = Math.floor(next() * (i + 1));
+    [perm[i], perm[j]] = [perm[j], perm[i]];
+  }
+  const events = perm.map((i) => ({ t: i, key: "k" + (i % 1000) }));
+  // window (i - 500, i] holds 500 consecutive times, so 500 distinct keys once i >= 499
+  const expected = perm.map((i) => Math.min(i + 1, 500));
+  expect(distinctInWindow(events, 500)).toEqual(expected);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/window.ts b/window.ts
--- a/window.ts	2026-10-30 03:25:16.968191173 +0000
+++ b/window.ts	2026-10-30 03:26:36.466160629 +0000
@@ -16,9 +16,26 @@
   events.forEach((e, i) => {
     if (typeof e.t !== "number" || !Number.isFinite(e.t)) throw new TypeError(`event ${i} has no finite time: ${e.t}`);
   });
-  return events.map((e) => {
-    const keys = new Set<string>();
-    for (const other of events) if (other.t > e.t - windowMs && other.t <= e.t) keys.add(other.key);
-    return keys.size;
-  });
+  const order = events.map((_, i) => i).sort((a, b) => events[a].t - events[b].t);
+  const counts = new Array<number>(events.length);
+  // Sweep events in time order; `inWindow` counts keys of the events in `order[start, end)`.
+  const inWindow = new Map<string, number>();
+  let start = 0;
+  let end = 0;
+  for (const i of order) {
+    const t = events[i].t;
+    for (; end < order.length && events[order[end]].t <= t; end++) {
+      const key = events[order[end]].key;
+      inWindow.set(key, (inWindow.get(key) ?? 0) + 1);
+    }
+    const after = t - windowMs;
+    for (; start < end && events[order[start]].t <= after; start++) {
+      const key = events[order[start]].key;
+      const count = inWindow.get(key)! - 1;
+      if (count === 0) inWindow.delete(key);
+      else inWindow.set(key, count);
+    }
+    counts[i] = inWindow.size;
+  }
+  return counts;
 }
