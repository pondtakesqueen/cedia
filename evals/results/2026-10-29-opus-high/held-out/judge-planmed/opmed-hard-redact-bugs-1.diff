diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact.rules.test.ts b/redact.rules.test.ts
--- a/redact.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact.rules.test.ts	2026-10-30 03:17:41.028948781 +0000
@@ -0,0 +1,42 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+test('a generic sk- key needs a digit, and a key with one is still redacted', () => {
+  expect(redactSecrets('key sk-proj-abcdefghijklmnop1234 end')).toEqual({ text: `key ${REDACTED} end`, count: 1 });
+  expect(redactSecrets('sk-learn-and-more-words').count).toBe(0);
+});
+
+test('a URL password keeps the @ before the host', () => {
+  expect(redactSecrets('postgres://u:hunter2pw@host/db').text).toBe(`postgres://u:${REDACTED}@host/db`);
+});
+
+test('a plural token name that holds a secret is redacted', () => {
+  expect(redactSecrets('API_TOKENS=abc123def456ghi')).toEqual({ text: `API_TOKENS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('export AUTH_TOKENS=abcd1234efgh').count).toBe(1);
+  expect(redactSecrets('tokens: abc123def456gh').count).toBe(1);
+  expect(redactSecrets('"access_tokens": "abcd1234efgh"').count).toBe(1);
+  expect(redactSecrets('MAX_TOKENS=4096').count).toBe(0);
+});
+
+test('an sk-ant- key needs no digit, and a generic sk- key needs 20 characters and a digit', () => {
+  expect(redactSecrets('sk-ant-' + 'a'.repeat(20)).count).toBe(1);
+  expect(redactSecrets('sk-' + 'a'.repeat(20)).count).toBe(0);
+  expect(redactSecrets('sk-' + 'a'.repeat(19) + '1').count).toBe(1);
+  expect(redactSecrets('sk-' + 'a'.repeat(18) + '1').count).toBe(0);
+});
+
+test('a URL password of 3 characters is redacted and 2 is not', () => {
+  expect(redactSecrets('postgres://u:abc@host/db').text).toBe(`postgres://u:${REDACTED}@host/db`);
+  expect(redactSecrets('postgres://u:ab@host/db').count).toBe(0);
+});
+
+test('a key block cut before its end takes the rest of the text', () => {
+  expect(redactSecrets('x\n-----BEGIN PRIVATE KEY-----\nAAA\nkeep')).toEqual({ text: `x\n${REDACTED}`, count: 1 });
+});
+
+test('a redacted text redacts to itself', () => {
+  for (const s of ['x\n-----BEGIN PRIVATE KEY-----\nAAA\n-----END PRIVATE KEY-----\ny', 'secretKey=Sup3rSecret99', 'postgres://u:hunter2pw@host/db']) {
+    const once = redactSecrets(s).text;
+    expect(redactSecrets(once)).toEqual({ text: once, count: 0 });
+  }
+});
