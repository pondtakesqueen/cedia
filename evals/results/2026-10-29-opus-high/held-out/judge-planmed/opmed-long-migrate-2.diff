diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/handlers.rules.test.ts b/test/handlers.rules.test.ts
--- a/test/handlers.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/handlers.rules.test.ts	2026-10-30 03:30:07.258155808 +0000
@@ -0,0 +1,119 @@
+import { beforeEach, describe, expect, test } from 'bun:test';
+import { db, reset } from '../src/db.ts';
+import { HttpError } from '../src/errors.ts';
+import { createUser } from '../src/handlers/users/createUser.ts';
+import { getUser } from '../src/handlers/users/getUser.ts';
+import { renameUser } from '../src/handlers/users/renameUser.ts';
+import { deactivateUser } from '../src/handlers/users/deactivateUser.ts';
+import { createOrder } from '../src/handlers/orders/createOrder.ts';
+import { cancelOrder } from '../src/handlers/orders/cancelOrder.ts';
+import { adjustStock } from '../src/handlers/stock/adjustStock.ts';
+import { transferStock } from '../src/handlers/stock/transferStock.ts';
+
+beforeEach(() =>
+  reset({
+    users: [{ id: 'u1', name: 'Ann', active: true }, { id: 'u2', name: 'Bo', active: true }, { id: 'u3', name: 'Cy', active: false }],
+    stock: [{ id: 'MUG', units: 10 }, { id: 'TEE', units: 2 }],
+    orders: [
+      { id: 'o1', user: 'u1', sku: 'MUG', quantity: 1, status: 'open' },
+      { id: 'o2', user: 'u1', sku: 'TEE', quantity: 1, status: 'shipped' },
+      { id: 'o3', user: 'u1', sku: 'MUG', quantity: 2, status: 'open' },
+    ],
+  }),
+);
+
+const fails = async (p: Promise<unknown>, status: number, message: string) => {
+  const e = await p.then(() => undefined, (err) => err);
+  expect(e).toBeInstanceOf(HttpError);
+  expect(e).toMatchObject({ status, message });
+};
+
+describe('errors from the database', () => {
+  test('a non-HttpError from the database passes through unchanged', async () => {
+    const boom = new Error('disk gone');
+    const original = db.promises.get;
+    db.promises.get = async () => { throw boom; };
+    try {
+      const e = await getUser({ id: 'u1' }).then(() => undefined, (err) => err);
+      expect(e).toBe(boom);
+    } finally {
+      db.promises.get = original;
+    }
+  });
+});
+
+describe('validation runs before any database call', () => {
+  test('createUser, createOrder, adjustStock and transferStock', async () => {
+    const original = db.promises.get;
+    db.promises.get = async () => { throw new Error('db must not be read'); };
+    try {
+      await fails(createUser({ id: 'u9', name: '  ' }), 400, 'name is required');
+      await fails(createOrder({ id: 'o9', user: 'u1', sku: 'MUG', quantity: 0 }), 400, 'quantity must be a positive integer');
+      await fails(adjustStock({ sku: 'MUG', delta: 0 }), 400, 'delta must be a non-zero integer');
+      await fails(transferStock({ from: 'MUG', to: 'MUG', units: 1 }), 400, 'from and to are the same');
+    } finally {
+      db.promises.get = original;
+    }
+  });
+});
+
+describe('renameUser', () => {
+  test('a missing user is 404 even when the name is empty', async () => {
+    await fails(renameUser({ id: 'zz', name: '' }), 404, 'no user zz');
+  });
+  test('the same name after trimming writes nothing', async () => {
+    const puts: string[] = [];
+    const original = db.promises.put;
+    db.promises.put = async (t, row) => { puts.push(`${t}/${row.id}`); return original(t, row); };
+    try {
+      expect(await renameUser({ id: 'u2', name: ' Bo ' })).toMatchObject({ name: 'Bo' });
+    } finally {
+      db.promises.put = original;
+    }
+    expect(puts).toEqual([]);
+  });
+});
+
+describe('nothing is written when a request fails with 409', () => {
+  test('createOrder, adjustStock, transferStock, cancelOrder', async () => {
+    await fails(createOrder({ id: 'o10', user: 'u2', sku: 'TEE', quantity: 3 }), 409, 'only 2 TEE left');
+    expect(await db.promises.get('stock', 'TEE')).toMatchObject({ units: 2 });
+    expect(await db.promises.get('orders', 'o10')).toBeUndefined();
+
+    await fails(adjustStock({ sku: 'TEE', delta: -9 }), 409, 'stock of TEE would be -7');
+    expect(await db.promises.get('stock', 'TEE')).toMatchObject({ units: 2 });
+
+    await fails(transferStock({ from: 'TEE', to: 'MUG', units: 7 }), 409, 'only 2 TEE left');
+    expect(await db.promises.get('stock', 'TEE')).toMatchObject({ units: 2 });
+    expect(await db.promises.get('stock', 'MUG')).toMatchObject({ units: 10 });
+
+    await fails(cancelOrder({ id: 'o2' }), 409, 'order o2 is shipped');
+    expect(await db.promises.get('stock', 'TEE')).toMatchObject({ units: 2 });
+  });
+});
+
+describe('write order', () => {
+  test('deactivateUser cancels open orders in order and counts them', async () => {
+    const ids: string[] = [];
+    const original = db.promises.put;
+    db.promises.put = async (t, row) => { ids.push(`${t}/${row.id}`); return original(t, row); };
+    try {
+      expect(await deactivateUser({ id: 'u1' })).toEqual({ cancelled: 2 });
+      expect(await deactivateUser({ id: 'u2' })).toEqual({ cancelled: 0 });
+    } finally {
+      db.promises.put = original;
+    }
+    expect(ids).toEqual(['users/u1', 'orders/o1', 'orders/o3', 'users/u2']);
+  });
+  test('transferStock writes the source row first', async () => {
+    const ids: string[] = [];
+    const original = db.promises.put;
+    db.promises.put = async (t, row) => { ids.push(`${t}/${row.id}`); return original(t, row); };
+    try {
+      await transferStock({ from: 'MUG', to: 'TEE', units: 4 });
+    } finally {
+      db.promises.put = original;
+    }
+    expect(ids).toEqual(['stock/MUG', 'stock/TEE']);
+  });
+});
