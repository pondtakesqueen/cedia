diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/handlers.async.test.ts b/test/handlers.async.test.ts
--- a/test/handlers.async.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/handlers.async.test.ts	2026-10-30 03:29:59.898155976 +0000
@@ -0,0 +1,141 @@
+import { afterEach, beforeEach, describe, expect, test } from 'bun:test';
+import { db, reset } from '../src/db.ts';
+import { HttpError } from '../src/errors.ts';
+import { createUser } from '../src/handlers/users/createUser.ts';
+import { getUser } from '../src/handlers/users/getUser.ts';
+import { renameUser } from '../src/handlers/users/renameUser.ts';
+import { deactivateUser } from '../src/handlers/users/deactivateUser.ts';
+import { createOrder } from '../src/handlers/orders/createOrder.ts';
+import { listOrders } from '../src/handlers/orders/listOrders.ts';
+import { cancelOrder } from '../src/handlers/orders/cancelOrder.ts';
+import { adjustStock } from '../src/handlers/stock/adjustStock.ts';
+import { transferStock } from '../src/handlers/stock/transferStock.ts';
+import { summary } from '../src/handlers/reports/summary.ts';
+
+const fails = async (p: Promise<unknown>, status: number, message: string) => {
+  const e = await p.then(() => undefined, (err) => err);
+  expect(e).toBeInstanceOf(HttpError);
+  expect(e).toMatchObject({ status, message });
+};
+
+const seed = () =>
+  reset({
+    users: [{ id: 'u1', name: 'Ann', active: true }, { id: 'u2', name: 'Bo', active: true }, { id: 'u3', name: 'Cy', active: false }],
+    stock: [{ id: 'MUG', units: 10 }, { id: 'TEE', units: 2 }],
+    orders: [
+      { id: 'o1', user: 'u1', sku: 'MUG', quantity: 1, status: 'open' },
+      { id: 'o2', user: 'u1', sku: 'TEE', quantity: 1, status: 'shipped' },
+      { id: 'o3', user: 'u1', sku: 'MUG', quantity: 2, status: 'open' },
+      { id: 'o4', user: 'u3', sku: 'MUG', quantity: 5, status: 'open' },
+    ],
+  });
+
+beforeEach(seed);
+afterEach(seed);
+
+describe('validation rejects instead of throwing', () => {
+  test('errors come back as rejected promises', async () => {
+    const orders = [
+      createOrder({ id: 'x', user: 'u2', sku: 'MUG', quantity: 0 }),
+      adjustStock({ sku: 'TEE', delta: 0 }),
+      transferStock({ from: 'MUG', to: 'MUG', units: 1 }),
+    ];
+    for (const p of orders) expect(p).toBeInstanceOf(Promise);
+    await fails(orders[0], 400, 'quantity must be a positive integer');
+    await fails(orders[1], 400, 'delta must be a non-zero integer');
+    await fails(orders[2], 400, 'from and to are the same');
+  });
+  test('validation runs before any read', async () => {
+    await fails(createUser({ id: 'u1', name: ' ' }), 400, 'name is required');
+    await fails(createOrder({ id: 'x', user: 'u3', sku: 'MUG', quantity: 0 }), 400, 'quantity must be a positive integer');
+    await fails(adjustStock({ sku: 'TEE', delta: 1.5 }), 400, 'delta must be a non-zero integer');
+  });
+  test('renameUser checks 404 before 400', async () => {
+    await fails(renameUser({ id: 'zz', name: '' }), 404, 'no user zz');
+  });
+  test('renameUser to the same name returns the stored row', async () => {
+    expect(await renameUser({ id: 'u1', name: ' Ann ' })).toEqual({ id: 'u1', name: 'Ann', active: true });
+  });
+});
+
+describe('inactive users', () => {
+  test('getUser and createOrder treat them as missing', async () => {
+    await fails(getUser({ id: 'u3' }), 404, 'no user u3');
+    await fails(createOrder({ id: 'o9', user: 'u3', sku: 'MUG', quantity: 1 }), 404, 'no user u3');
+    expect(await db.promises.get('stock', 'MUG')).toMatchObject({ units: 10 });
+    expect(await db.promises.get('orders', 'o9')).toBeUndefined();
+  });
+});
+
+describe('failed writes', () => {
+  test('a failed createOrder writes nothing', async () => {
+    await fails(createOrder({ id: 'o10', user: 'u2', sku: 'TEE', quantity: 3 }), 409, 'only 2 TEE left');
+    expect(await db.promises.get('stock', 'TEE')).toMatchObject({ units: 2 });
+    expect(await db.promises.get('orders', 'o10')).toBeUndefined();
+  });
+  test('a failed transferStock writes nothing', async () => {
+    await fails(transferStock({ from: 'TEE', to: 'CAP', units: 3 }), 409, 'only 2 TEE left');
+    expect(await db.promises.get('stock', 'CAP')).toBeUndefined();
+    expect(await db.promises.get('stock', 'TEE')).toMatchObject({ units: 2 });
+  });
+});
+
+describe('orders', () => {
+  test('cancelOrder with no stock row creates it', async () => {
+    await db.promises.put('orders', { id: 'o7', user: 'u2', sku: 'CAP', quantity: 3, status: 'open' });
+    expect(await cancelOrder({ id: 'o7' })).toMatchObject({ status: 'cancelled' });
+    expect(await db.promises.get('stock', 'CAP')).toEqual({ id: 'CAP', units: 3 });
+  });
+  test('listOrders treats an empty status as no filter, newest id first', async () => {
+    expect((await listOrders({ user: 'u1', status: '' })).map((o) => o.id)).toEqual(['o3', 'o2', 'o1']);
+  });
+});
+
+describe('users', () => {
+  test('deactivateUser counts only open orders and leaves stock alone', async () => {
+    expect(await deactivateUser({ id: 'u1' })).toEqual({ cancelled: 2 });
+    expect(await db.promises.get('stock', 'MUG')).toMatchObject({ units: 10 });
+    expect(await deactivateUser({ id: 'u2' })).toEqual({ cancelled: 0 });
+    expect(await deactivateUser({ id: 'u3' })).toEqual({ cancelled: 1 });
+    expect(await db.promises.get('orders', 'o4')).toMatchObject({ status: 'cancelled' });
+  });
+});
+
+describe('stock', () => {
+  test('adjustStock can reach zero but not below', async () => {
+    expect(await adjustStock({ sku: 'TEE', delta: -2 })).toEqual({ id: 'TEE', units: 0 });
+    await fails(adjustStock({ sku: 'TEE', delta: -1 }), 409, 'stock of TEE would be -1');
+    expect(await db.promises.get('stock', 'TEE')).toMatchObject({ units: 0 });
+  });
+  test('transferStock to an unknown sku creates it', async () => {
+    expect(await transferStock({ from: 'MUG', to: 'CAP', units: 3 })).toEqual({
+      from: { id: 'MUG', units: 7 },
+      to: { id: 'CAP', units: 3 },
+    });
+  });
+});
+
+describe('reports', () => {
+  test('summary skips orders of unknown users and handles empty data', async () => {
+    await db.promises.put('orders', { id: 'o8', user: 'ghost', sku: 'MUG', quantity: 9, status: 'open' });
+    expect(await summary({})).toEqual({ byStatus: { open: 2, shipped: 1 }, units: 4 });
+    reset({});
+    expect(await summary({})).toEqual({ byStatus: {}, units: 0 });
+  });
