diff -ruN '--exclude=node_modules' '--exclude=.git' a/cron.test.ts b/cron.test.ts
--- a/cron.test.ts	2026-10-29 18:55:38.230352000 +0000
+++ b/cron.test.ts	2026-10-29 18:56:36.811583017 +0000
@@ -18,3 +18,80 @@
 test("a wrong number of fields", () => {
   expect(() => nextRun("* * *", at("2026-01-01T00:00:00Z"))).toThrow(RangeError);
 });
+
+test("month and day names, in any case", () => {
+  expect(nextRun("0 0 * jan-Mar MON", at("2026-04-01T00:00:00Z")).toISOString()).toBe("2027-01-04T00:00:00.000Z");
+  expect(nextRun("0 12 * * sat,SUN", at("2026-01-01T00:00:00Z")).toISOString()).toBe("2026-01-03T12:00:00.000Z");
+});
+
+test("a step over a star and over a range", () => {
+  expect(nextRun("*/15 * * * *", at("2026-01-01T00:16:00Z")).toISOString()).toBe("2026-01-01T00:30:00.000Z");
+  expect(nextRun("10-30/10 * * * *", at("2026-01-01T00:20:00Z")).toISOString()).toBe("2026-01-01T00:30:00.000Z");
+  expect(nextRun("10-30/10 * * * *", at("2026-01-01T00:30:00Z")).toISOString()).toBe("2026-01-01T01:10:00.000Z");
+});
+
+test("a step after a single value runs to the end of the field", () => {
+  expect(nextRun("5/20 * * * *", at("2026-01-01T00:05:00Z")).toISOString()).toBe("2026-01-01T00:25:00.000Z");
+  expect(nextRun("5/20 * * * *", at("2026-01-01T00:25:00Z")).toISOString()).toBe("2026-01-01T00:45:00.000Z");
+  expect(nextRun("5/20 * * * *", at("2026-01-01T00:45:00Z")).toISOString()).toBe("2026-01-01T01:05:00.000Z");
+});
+
+test("Sunday written as 7", () => {
+  // 2026-01-01 is a Thursday.
+  expect(nextRun("0 0 * * 7", at("2026-01-01T00:00:00Z")).toISOString()).toBe("2026-01-04T00:00:00.000Z");
+  expect(nextRun("0 0 * * 5-7", at("2026-01-03T01:00:00Z")).toISOString()).toBe("2026-01-04T00:00:00.000Z");
+});
+
+test("a day of week field covering every day leaves only the day of month", () => {
+  expect(nextRun("0 0 15 * 0-6", at("2026-01-01T00:00:00Z")).toISOString()).toBe("2026-01-15T00:00:00.000Z");
+  expect(nextRun("0 0 15 * 1-7", at("2026-01-01T00:00:00Z")).toISOString()).toBe("2026-01-15T00:00:00.000Z");
+  expect(nextRun("0 0 1-31 * 1", at("2026-01-01T00:00:00Z")).toISOString()).toBe("2026-01-05T00:00:00.000Z");
+});
+
+test("a day of month and a day of week both restricted match either", () => {
+  const runs: string[] = [];
+  let t = at("2026-01-01T00:00:00Z");
+  for (let i = 0; i < 5; i++) runs.push((t = nextRun("0 0 1,15 * 1", t)).toISOString().slice(0, 10));
+  expect(runs).toEqual(["2026-01-05", "2026-01-12", "2026-01-15", "2026-01-19", "2026-01-26"]);
+});
+
+test("the 29th of February", () => {
+  expect(nextRun("0 0 29 2 *", at("2026-01-01T00:00:00Z")).toISOString()).toBe("2028-02-29T00:00:00.000Z");
+  expect(nextRun("0 0 29 2 *", at("2096-02-29T00:00:00Z")).toISOString()).toBe("2104-02-29T00:00:00.000Z");
+});
+
+test("expressions that never fire", () => {
+  expect(() => nextRun("0 0 30 2 *", at("2026-01-01T00:00:00Z"))).toThrow(RangeError);
+  expect(() => nextRun("0 0 31 4,6,9,11 *", at("2026-01-01T00:00:00Z"))).toThrow(RangeError);
+});
+
+test("invalid expressions", () => {
+  for (const expr of [
+    "60 * * * *",
+    "* 24 * * *",
+    "* * 0 * *",
+    "* * * 13 *",
+    "* * * * 8",
+    "*/0 * * * *",
+    "1-/2 * * * *",
+    "*/ * * * *",
+    "*/x * * * *",
+    "1/2/3 * * * *",
+    "30-10 * * * *",
+    "* * * * FRI-MON",
+    "1- * * * *",
+    "-1 * * * *",
+    "1-2-3 * * * *",
+    ",5 * * * *",
+    "1.5 * * * *",
+    "0x1 * * * *",
+    "1e1 * * * *",
+    "* * * FOO *",
+    "* * * * MONDAY",
+    "* * * MON *",
+    "JAN * * * *",
+    "*-5 * * * *",
+  ]) {
+    expect(() => nextRun(expr, at("2026-01-01T00:00:00Z")), expr).toThrow(RangeError);
+  }
+});
