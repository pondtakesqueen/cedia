+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { threadsDir, ThreadStore } from '../src/core/project/threads.ts';
+import { projectSlug } from '../src/core/session/log.ts';
+
+const BIN = join(import.meta.dir, '..', 'bin', 'cedia');
+const call = (id: string, command: string) => ({ blocks: [{ type: 'tool_use', id, name: 'bash', input: { command } }] });
+const reply = (text: string) => ({ blocks: [{ type: 'text', text }] });
+const rejected = { error: { code: 'bad_request', status: 400, message: 'messages.3.content.0: Invalid `signature` in `thinking` block' } };
+const args = ['-p', 'make f.txt say good', '--output-format', 'json', '--permission', 'workspace', '--sandbox', 'off', '--check', 'grep -q good f.txt'];
+
+describe('a thread whose history the provider refused', () => {
+  test('a resumed thread whose last session was refused records its new session as rejected', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'cedia-rejected-'));
+    const home = join(dir, 'home');
+    const script = join(dir, 'script.json');
+    const run = (steps: unknown[], extra: string[] = []) => {
+      writeFileSync(script, JSON.stringify(steps));
+      return Bun.spawnSync([BIN, '-m', 'faux', '--cwd', dir, ...args, ...extra], { env: { ...process.env, CEDIA_FAUX_SCRIPT: script, CEDIA_HOME: home } });
+    };
+    const first = run([call('c1', 'echo good > f.txt'), rejected, call('c2', 'echo good >> f.txt'), rejected]);
+    const thread = JSON.parse(first.stdout.toString()).thread as string;
+    const resumed = run([call('c3', 'grep -q good f.txt'), reply('done')], ['--thread', thread]);
+    expect(JSON.parse(resumed.stdout.toString()).subtype).toBe('success');
+    const store = new ThreadStore(threadsDir(home, projectSlug(dir)));
+    expect(store.read(thread).sessions.map((s) => s.why)).toEqual(['start', 'rejected', 'rejected']);
+  });
+});
