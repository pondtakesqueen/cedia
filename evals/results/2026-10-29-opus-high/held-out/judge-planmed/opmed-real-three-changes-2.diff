diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/turns.test.ts b/test/turns.test.ts
--- a/test/turns.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/turns.test.ts	2026-10-30 03:40:06.690142097 +0000
@@ -0,0 +1,154 @@
+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { loadQuotaWait } from '../src/core/config.ts';
+import { CONTINUE_AFTER_LIMIT, EMPTY_REPLY, runPrompt, type RunOptions } from '../src/core/loop/run.ts';
+import { FAUX_MODEL } from '../src/core/providers/catalog.ts';
+import { fauxProvider, text, toolUse, type FauxStep } from '../src/core/providers/faux.ts';
+import { historyRefused } from '../src/clients/headless/main.ts';
+import { lintSession } from '../src/core/session/lint.ts';
+import { SessionLog } from '../src/core/session/log.ts';
+import { readTool } from '../src/core/tools/read.ts';
+import type { EventOf, SessionEvent } from '../src/core/types.ts';
+
+const cwd = mkdtempSync(join(tmpdir(), 'cedia-turns-'));
+writeFileSync(join(cwd, 'a.txt'), 'alpha\n');
+
+function setup(steps: FauxStep[], extra: Partial<RunOptions> = {}) {
+  const log = SessionLog.create();
+  const sleeps: number[] = [];
+  const opts: RunOptions = {
+    log,
+    provider: fauxProvider(steps),
+    model: FAUX_MODEL,
+    tools: [readTool],
+    system: 'sys',
+    cwd,
+    retry: { sleep: async (ms) => void sleeps.push(ms) },
+    ...extra,
+  };
+  return { log, opts, sleeps };
+}
+
+const of = <K extends SessionEvent['kind']>(events: SessionEvent[], k: K) => events.filter((e): e is EventOf<K> => e.kind === k);
+
+function expectPaired(events: SessionEvent[]) {
+  const uses = of(events, 'assistant').flatMap((a) => a.blocks.flatMap((b) => (b.type === 'tool_use' ? [b.callId ?? b.id] : [])));
+  expect(of(events, 'tool_result').map((r) => r.callId).sort()).toEqual(uses.sort());
+  expect(lintSession(events)).toEqual([]);
+}
+
+const thinking = (t: string) => ({ type: 'thinking' as const, text: t, opaque: 'sig' });
+const MIN = 60_000;
+const spent = (retryAfterMs?: number): FauxStep => ({ error: { code: 'quota', status: 429, message: 'usage limit reached', ...(retryAfterMs !== undefined ? { retryAfterMs } : {}) } });
+
+describe('malformed turns, more', () => {
+  test('a thinking-only reply cut off by max_tokens continues and is not treated as empty', async () => {
+    const { log, opts } = setup([{ blocks: [thinking('hmm')], stop: 'max_tokens' }, { blocks: [text('done')] }]);
+    expect(await runPrompt(opts, 'go')).toMatchObject({ subtype: 'success', result: 'done' });
+    expect(of(log.events, 'reminder').map((r) => r.text)).toEqual([CONTINUE_AFTER_LIMIT]);
+  });
+
+  test('empty replies get one reminder per run, not one per turn', async () => {
+    const { log, opts } = setup([
+      { blocks: [thinking('a')] },
+      { blocks: [text('working'), toolUse('c1', 'read', { path: 'a.txt' })] },
+      { blocks: [thinking('b')] },
+    ]);
+    const res = await runPrompt(opts, 'go');
+    expect(res).toMatchObject({ subtype: 'error_during_execution', result: expect.stringContaining('without a reply') });
+    expect(of(log.events, 'reminder').map((r) => r.text)).toEqual([EMPTY_REPLY]);
+    expectPaired(log.events);
+  });
+
+  test('a refusal that carries a tool call gets a not_started result, and the log stays paired', async () => {
+    const { log, opts } = setup([{ blocks: [text('no'), toolUse('c1', 'read', { path: 'a.txt' })], stop: 'refusal' }]);
+    expect(await runPrompt(opts, 'go')).toMatchObject({ subtype: 'error_during_execution', result: 'no' });
+    expect(of(log.events, 'tool_result').map((r) => r.status)).toEqual(['not_started']);
+    expect(of(log.events, 'tool_intent')).toEqual([]);
+    expectPaired(log.events);
+  });
+
+  test('a tool returning an object without isError still gets a completed string result', async () => {
+    const odd = { name: 'object', description: 'object', schema: { type: 'object' }, effect: 'read' as const, replay: 'safe' as const, run: (async () => ({ text: 'x' })) as never };
+    const { log, opts } = setup([{ blocks: [toolUse('c1', 'object', {})] }, { blocks: [text('ok')] }], { tools: [odd] });
+    await runPrompt(opts, 'go');
+    expect(of(log.events, 'tool_result')[0]).toMatchObject({ status: 'completed', output: { text: 'x', isError: false } });
+    expectPaired(log.events);
+  });
+
+  test('calls that share an id run once, for many seeded lists of calls', async () => {
+    let seed = 7;
+    const rand = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
+    for (let round = 0; round < 30; round++) {
+      const ids = Array.from({ length: 1 + Math.floor(rand() * 6) }, () => ['a', 'b', 'c'][Math.floor(rand() * 3)]!);
+      const { log, opts } = setup([{ blocks: ids.map((id) => toolUse(id, 'read', { path: 'a.txt' })) }, { blocks: [text('ok')] }]);
+      await runPrompt(opts, 'go');
+      const unique = new Set(ids).size;
+      expect(of(log.events, 'tool_result')).toHaveLength(unique);
+      expect(of(log.events, 'tool_intent')).toHaveLength(unique);
+      expect(lintSession(log.events)).toEqual([]);
+    }
+  });
+
+  test('an unknown tool name is cut to 64 characters', async () => {
+    const at64 = 'x'.repeat(64);
+    const at65 = 'y'.repeat(65);
+    const { log, opts } = setup([{ blocks: [toolUse('c1', at64, {}), toolUse('c2', at65, {})] }, { blocks: [text('ok')] }]);
+    await runPrompt(opts, 'go');
+    const [kept, cut] = of(log.events, 'tool_result');
+    expect(kept!.output.text).toBe(`not run: unknown tool "${at64}"`);
+    expect(cut!.output.text).toBe(`not run: unknown tool "${'y'.repeat(64)}..."`);
+    expectPaired(log.events);
+  });
+});
+
+describe('quota wait, more', () => {
+  test('a wait exactly at the ceiling is taken; no time named is not waited', async () => {
+    const at = setup([spent(30 * MIN), { blocks: [text('ok')] }], { quotaWaitMs: 30 * MIN });
+    expect((await runPrompt(at.opts, 'hi')).subtype).toBe('success');
+    expect(at.sleeps).toEqual([30 * MIN]);
+    const none = setup([spent(0), { blocks: [text('ok')] }], { quotaWaitMs: 30 * MIN });
+    expect((await runPrompt(none.opts, 'hi')).subtype).toBe('error_during_execution');
+    expect(none.sleeps).toEqual([]);
+  });
+
+  test('an abort during the quota wait ends the run as interrupted', async () => {
+    const ac = new AbortController();
+    const { log, opts } = setup([spent(20 * MIN), { blocks: [text('unreachable')] }], {
+      signal: ac.signal,
+      quotaWaitMs: 30 * MIN,
+      retry: { sleep: async () => ac.abort() },
+    });
+    expect((await runPrompt(opts, 'hi')).subtype).toBe('interrupted');
+    expect(of(log.events, 'turn_end')[0]).toMatchObject({ reason: 'aborted' });
+    expectPaired(log.events);
+  });
+});
+
+describe('loadQuotaWait and historyRefused', () => {
+  test('a malformed wait throws with the allowed forms', () => {
+    const prev = process.env.CEDIA_HOME;
+    process.env.CEDIA_HOME = mkdtempSync(join(tmpdir(), 'cedia-home-'));
+    try {
+      for (const bad of ['wait:abc', 'wait:-1', 'wait:1.5', 'wait:']) expect(() => loadQuotaWait(bad)).toThrow('fallback or wait:<minutes>');
+    } finally {
+      if (prev === undefined) delete process.env.CEDIA_HOME;
+      else process.env.CEDIA_HOME = prev;
+    }
+  });
+
+  test('only a refusal after an accepted request counts as a refused history', () => {
+    const attempt = (error?: { code: string; message: string }) => ({ kind: 'attempt', requestId: 'r', n: 1, ...(error ? { error } : {}) });
+    const ok = attempt();
+    const bad = { code: 'bad_request', message: 'bad' };
+    const long = { code: 'context_length', message: 'long' };
+    const events = (...e: unknown[]) => e as unknown as SessionEvent[];
+    expect(historyRefused(events(ok, attempt(bad)))).toBe(true);
+    expect(historyRefused(events(ok, attempt(long)))).toBe(true);
+    expect(historyRefused(events(attempt(bad)))).toBe(false);
+    expect(historyRefused(events(ok, attempt({ code: 'server', message: 'boom' })))).toBe(false);
+    expect(historyRefused(events(ok, attempt({ code: 'quota', message: 'spent' })))).toBe(false);
+  });
+});
