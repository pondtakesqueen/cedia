diff -ruN '--exclude=node_modules' '--exclude=.git' a/shell.rules.test.ts b/shell.rules.test.ts
--- a/shell.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/shell.rules.test.ts	2026-10-29 19:27:21.747692686 +0000
@@ -0,0 +1,151 @@
+import { expect, test } from 'bun:test';
+import { simpleCommands } from './shell.ts';
+
+const COMMANDS = [
+  'rm -rf /',
+  'git push -f',
+  'echo "a b"',
+  'ls 2>&1 | grep x',
+  'cd x && make',
+  'FOO=1 npm publish',
+  'sudo -u root rm x',
+  'echo $(id)',
+  'if true; then ls; fi',
+];
+
+test('every separator splits commands, quotes keep them', () => {
+  for (const sep of [';', '&', '|', '&&', '||', '\n', '(', ')']) {
+    expect(simpleCommands(`a x${sep}b`)).toEqual([['a', 'x'], ['b']]);
+  }
+  expect(simpleCommands(`echo 'a;b' "a|b" 'c&d'`)).toEqual([['echo', 'a;b', 'a|b', 'c&d']]);
+});
+
+test('substitutions and backticks are commands, single quotes are not', () => {
+  expect(simpleCommands('echo $(a $(b))')).toEqual([['echo'], ['a'], ['b']]);
+  expect(simpleCommands('echo "$(rm x)"')).toEqual([['echo', ''], ['rm', 'x']]);
+  expect(simpleCommands('echo "`rm x`"')).toEqual([['echo', ''], ['rm', 'x']]);
+  expect(simpleCommands("echo '$(rm)'")).toEqual([['echo', '$(rm)']]);
+});
+
+test('& inside redirections is not a separator', () => {
+  expect(simpleCommands('a 2>&1 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a >&2 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a &>f b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a & b')).toEqual([['a'], ['b']]);
+});
+
+test('words: literal single quotes, escapes, empty words', () => {
+  expect(simpleCommands(String.raw`echo 'a\b'`)).toEqual([['echo', 'a\\b']]);
+  expect(simpleCommands(String.raw`echo "a\"b"`)).toEqual([['echo', 'a"b']]);
+  expect(simpleCommands(String.raw`echo a\ b`)).toEqual([['echo', 'a b']]);
+  expect(simpleCommands('echo ""')).toEqual([['echo', '']]);
+  expect(simpleCommands('echo a""b')).toEqual([['echo', 'ab']]);
+  expect(simpleCommands("''")).toEqual([['']]);
+});
+
+test('redirection operators drop their target, quoted operators are words', () => {
+  for (const op of ['>', '>>', '<', '2>', '&>', '>&', '&>>']) {
+    expect(simpleCommands(`cmd ${op} f arg`)).toEqual([['cmd', 'arg']]);
+  }
+  expect(simpleCommands('cmd >f')).toEqual([['cmd']]);
+  expect(simpleCommands('cmd >')).toEqual([['cmd']]);
+  expect(simpleCommands('echo ">" x')).toEqual([['echo', '>', 'x']]);
+});
+
+test('assignments and keywords are skipped only before the command', () => {
+  expect(simpleCommands('echo A=1')).toEqual([['echo', 'A=1']]);
+  expect(simpleCommands('echo "if" then')).toEqual([['echo', 'if', 'then']]);
+  expect(simpleCommands('"if" x')).toEqual([['if', 'x']]);
+  expect(simpleCommands('! done')).toEqual([]);
+  expect(simpleCommands('while x; do y; done')).toEqual([['x'], ['y']]);
+});
+
+test('every wrapper unwraps and its value flags take their value', () => {
+  const wrappers: [string, string[]][] = [
+    ['sudo', ['-u', '--user']],
+    ['doas', ['-u']],
+    ['env', ['-u', '-S']],
+    ['command', []],
+    ['nohup', []],
+    ['time', ['-o']],
+    ['exec', ['-a']],
+    ['nice', ['-n']],
+    ['ionice', ['-c']],
+    ['setsid', []],
+    ['stdbuf', ['-o']],
+    ['timeout', ['-s']],
+    ['xargs', ['-I']],
+  ];
+  for (const [name, flags] of wrappers) {
+    const operand = name === 'timeout' ? '5 ' : ''; // timeout skips one operand before the command
+    expect(simpleCommands(`${name} ${operand}rm x`)).toEqual([['rm', 'x']]);
+    for (const flag of flags) {
+      expect(simpleCommands(`${name} ${flag} V ${operand}rm x`)).toEqual([['rm', 'x']]);
+    }
+  }
+  expect(simpleCommands('sudo -- rm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('timeout -s KILL 5 rm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('/usr/bin/sudo rm x')).toEqual([['rm', 'x']]);
+});
+
+test('shells with -c and eval unpack their script', () => {
+  expect(simpleCommands('bash -lc "rm x; ls"')).toEqual([['rm', 'x'], ['ls']]);
+  for (const sh of ['bash', 'sh', 'zsh', 'dash', 'ksh']) {
+    expect(simpleCommands(`${sh} -c 'rm x'`)).toEqual([['rm', 'x']]);
+  }
+  expect(simpleCommands("/bin/bash -c 'rm x'")).toEqual([['rm', 'x']]);
+  expect(simpleCommands('bash script.sh')).toEqual([['bash', 'script.sh']]);
+  expect(simpleCommands('eval "rm x" y')).toEqual([['rm', 'x', 'y']]);
+});
+
+test('empty commands are left out', () => {
+  expect(simpleCommands('( )')).toEqual([]);
+  expect(simpleCommands('$()')).toEqual([]);
+  expect(simpleCommands('sudo')).toEqual([]);
+});
+
+test('unbalanced input is null, nested ones too', () => {
+  for (const s of ['"', "'", '$(a', '`a', 'x "$(a', 'echo $(echo "x)', `bash -c "echo 'x"`]) {
+    expect(simpleCommands(s)).toBeNull();
+  }
+});
+
+test('joining commands with a separator joins their argvs', () => {
+  for (const a of COMMANDS) {
+    for (const b of COMMANDS) {
+      for (const sep of ['; ', ' & ', ' | ', ' && ', ' || ', '\n']) {
+        expect(simpleCommands(a + sep + b)).toEqual([...simpleCommands(a)!, ...simpleCommands(b)!]);
+      }
+    }
+  }
+});
+
+test('bash -c and sudo around a command leave its argvs unchanged', () => {
+  for (const a of COMMANDS) {
+    expect(simpleCommands(`bash -c '${a}'`)).toEqual(simpleCommands(a));
+    expect(simpleCommands(`sudo ${a}`)).toEqual(simpleCommands(a));
+  }
+});
+
+test('every prefix of a hard line gives null or non-empty argvs', () => {
+  const line = `bash -c "echo '$(rm x)' \`id\` 2>&1 && sudo -u root ls"`;
+  for (let k = 0; k <= line.length; k++) {
+    const r = simpleCommands(line.slice(0, k));
+    expect(r === null || r.every((argv) => argv.length > 0)).toBe(true);
+  }
+});
+
+test('escaped operators, backslash-newline, ANSI-C quotes and heredocs are read as the shell reads them', () => {
+  expect(simpleCommands('echo a\\>& rm x')).toEqual([['echo', 'a>'], ['rm', 'x']]);
+  expect(simpleCommands('a\\>>f arg')).toEqual([['a>', 'arg']]);
+  expect(simpleCommands('sudo \\\nrm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('r\\\nm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('"a\\\nb"')).toEqual([['ab']]);
+  expect(simpleCommands("$'rm' x")).toBeNull();
+  expect(simpleCommands('$"rm" x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('cat <<EOF x')).toEqual([['cat', 'x']]);
+  expect(simpleCommands('cat << EOF x')).toEqual([['cat', 'x']]);
+  expect(simpleCommands('cmd >| f arg')).toEqual([['cmd', 'arg']]);
+  expect(simpleCommands('cmd >|f arg')).toEqual([['cmd', 'arg']]);
+  expect(simpleCommands('rm>x -rf /')).toEqual([['rm', '-rf', '/']]);
+});
