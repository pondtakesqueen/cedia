+// A word of a simple command. `text` is its value with quotes and escapes removed; it goes into argv. `raw` is the
+// source it was read from, which decides whether it is a redirection, an assignment or a keyword.
+type Word = { text: string; raw: string };
+
+const REDIRECT_OP = /^(\d*>>?|\d*>\||\d*<+|&>>?|\d*>&)$/;
+const REDIRECT_PREFIX = /^(\d*>>?|\d*>\||\d*<+|&>>?|\d*>&)/;
+const ASSIGNMENT = /^[A-Za-z_]\w*=/;
+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const SHELLS = new Set(['bash', 'sh', 'zsh', 'dash', 'ksh']);
+
+function basename(path: string): string {
+  return path.slice(path.lastIndexOf('/') + 1);
+}
+
+// Scans src from index start and appends the argv of each simple command to out, substitutions' commands included.
+// It stops after the first unquoted `stop` character (')' closes $( ), '`' closes a backtick) or at the end of src
+// when stop is ''. It returns the index after the scan, or -1 when a quote or substitution is not closed.
+function scan(src: string, start: number, out: string[][], stop: string): number {
+  const words: Word[] = [];
+  const nested: string[][] = []; // commands of the substitutions in the current command
+  let word = undefined as Word | undefined;
+  let depth = 0;
+  let i = start;
+  const endWord = () => {
+    if (word) words.push(word);
+    word = undefined;
+  };
+  const endCommand = (): boolean => {
+    endWord();
+    const commands = finish(words.splice(0));
+    if (!commands) return false;
+    for (const argv of [...commands, ...nested.splice(0)]) if (argv.length > 0) out.push(argv);
+    return true;
+  };
+  const add = (text: string, raw: string) => {
+    word ??= { text: '', raw: '' };
+    word.text += text;
+    word.raw += raw;
+  };
+  const substitute = (at: number): number => {
+    const inner: string[][] = [];
+    const end = src.startsWith('$(', at) ? scan(src, at + 2, inner, ')') : scan(src, at + 1, inner, '`');
+    nested.push(...inner);
+    return end;
+  };
+  while (i < src.length) {
+    const c = src[i];
+    if (c === stop && depth === 0) return endCommand() ? i + 1 : -1;
+    if (c === "'") {
+      const end = src.indexOf("'", i + 1);
+      if (end < 0) return -1;
+      add(src.slice(i + 1, end), src.slice(i, end + 1));
+      i = end + 1;
+    } else if (c === '"') {
+      add('', '"');
+      let j = i + 1;
+      while (j < src.length && src[j] !== '"') {
+        if (src[j] === '\\' && j + 1 < src.length) {
+          if (src[j + 1] !== '\n') add(src[j + 1], src.slice(j, j + 2));
+          j += 2;
+        } else if (src[j] === '`' || src.startsWith('$(', j)) {
+          const end = substitute(j);
+          if (end < 0) return -1;
+          add('', src.slice(j, end));
+          j = end;
+        } else {
+          add(src[j], src[j]);
+          j++;
+        }
+      }
+      if (j >= src.length) return -1;
+      add('', '"');
+      i = j + 1;
+    } else if (c === '$' && src[i + 1] === '"') {
+      i++; // $"..." is a plain double-quoted string here: no translation
+    } else if (c === '$' && src[i + 1] === "'") {
+      return -1; // ANSI-C quoting ($'...') is not decoded, so the line is refused
+    } else if (c === '`' || src.startsWith('$(', i)) {
+      const end = substitute(i);
+      if (end < 0) return -1;
+      i = end;
+    } else if (c === '\\') {
+      if (i + 1 < src.length && src[i + 1] !== '\n') add(src[i + 1], src.slice(i, i + 2));
+      i += 2;
+    } else if (c === '<' || c === '>' || (c === '&' && (src[i + 1] === '>' || /^\d*[<>]$/.test(word?.raw ?? '')))) {
+      // an operator starts a word of its own, unless it continues an operator in progress (`2>&1`)
+      if (word && !/^\d*[<>&]*$/.test(word.raw)) endWord();
+      add(c, c);
+      i++;
+    } else if (c === '|' && word && /^\d*>$/.test(word.raw)) {
+      add(c, c); // `>|`
+      i++;
+    } else if ('\n;|&()'.includes(c)) {
+      if (c === '(') depth++;
+      else if (c === ')' && depth > 0) depth--;
+      if (!endCommand()) return -1;
+      i++;
+    } else if (/\s/.test(c)) {
+      endWord();
+      i++;
+    } else {
+      add(c, c);
+      i++;
+    }
+  }
+  if (stop) return -1;
+  return endCommand() ? src.length : -1;
+}
+
+// Turns the words of one simple command into the argv that runs: drops redirections, leading assignments and
+// keywords, and unwraps wrappers, `bash -c` and `eval`. It returns null when a nested script is unbalanced.
+function finish(words: Word[]): string[][] | null {
+  const args: Word[] = [];
+  for (let k = 0; k < words.length; k++) {
+    if (REDIRECT_OP.test(words[k].raw)) k++;
+    else if (!REDIRECT_PREFIX.test(words[k].raw)) args.push(words[k]);
+  }
+  let p = 0;
+  for (;;) {
+    while (p < args.length && (ASSIGNMENT.test(args[p].raw) || KEYWORDS.has(args[p].raw))) p++;
+    const wrapper = p < args.length ? WRAPPERS.get(basename(args[p].text)) : undefined;
+    if (!wrapper) break;
+    p++;
+    while (p < args.length && args[p].text.startsWith('-')) {
+      const flag = args[p++].text;
+      if (flag === '--') break;
+      if (wrapper.value?.includes(flag)) p++;
+    }
+    p += wrapper.positional ?? 0;
+  }
+  const argv = args.slice(p).map((w) => w.text);
+  if (argv.length === 0) return [];
+  if (SHELLS.has(basename(argv[0]))) {
+    const c = argv.findIndex((a, k) => k > 0 && /^-[A-Za-z]*c[A-Za-z]*$/.test(a));
+    if (c > 0 && c + 1 < argv.length) return simpleCommands(argv[c + 1]);
+  }
+  if (basename(argv[0]) === 'eval') return simpleCommands(argv.slice(1).join(' '));
+  return [argv];
+}
+
