+import { SessionLog } from '../src/core/session/log.ts';
+import { readTool } from '../src/core/tools/read.ts';
+import type { EventOf, SessionEvent } from '../src/core/types.ts';
+
+const cwd = mkdtempSync(join(tmpdir(), 'cedia-rules-'));
+
+function setup(steps: FauxStep[], extra: Partial<RunOptions> = {}) {
+  const log = SessionLog.create();
+  const sleeps: number[] = [];
+  const opts: RunOptions = {
+    log,
+    provider: fauxProvider(steps),
+    model: FAUX_MODEL,
+    tools: [readTool],
+    system: 'sys',
+    cwd,
+    retry: { sleep: async (ms) => void sleeps.push(ms) },
+    ...extra,
+  };
+  return { log, opts, sleeps };
+}
+
+const of = <K extends SessionEvent['kind']>(events: SessionEvent[], k: K) => events.filter((e): e is EventOf<K> => e.kind === k);
+const quota = (retryAfterMs: number): FauxStep => ({ error: { code: 'quota', status: 429, message: 'usage limit reached', retryAfterMs } });
+
+describe('run rules', () => {
+  test('a quota wait ceiling of zero waits for nothing and falls through to the error', async () => {
+    const { log, opts, sleeps } = setup([quota(60_000), { blocks: [text('ok')] }], { quotaWaitMs: 0 });
+    expect((await runPrompt(opts, 'hi')).subtype).toBe('error_during_execution');
+    expect(sleeps).toEqual([]);
+    expect(of(log.events, 'attempt')).toHaveLength(1);
+  });
+
+  test('abort during a quota wait ends the run as interrupted', async () => {
+    const ac = new AbortController();
+    const { opts } = setup([quota(60_000), { blocks: [text('unreachable')] }], {
+      quotaWaitMs: 600_000,
+      signal: ac.signal,
+      retry: { sleep: async () => ac.abort() },
+    });
+    expect((await runPrompt(opts, 'hi')).subtype).toBe('interrupted');
+  });
+
+  test('a refusal that came with a tool call runs none of it and fails the run', async () => {
+    const { log, opts } = setup([{ blocks: [text('no'), toolUse('c1', 'read', { path: 'missing.txt' })], stop: 'refusal' }, { blocks: [text('fine')] }]);
+    const r = await runPrompt(opts, 'go');
+    expect(r.subtype).toBe('error_during_execution');
+    expect(r.result).toBe('no');
+    expect(r.numTurns).toBe(1);
+    expect(of(log.events, 'tool_intent')).toHaveLength(0);
+    expect(of(log.events, 'tool_result').map((x) => x.status)).toEqual(['not_started']);
+    expect(lintSession(log.events)).toEqual([]);
+  });
+
+  test('a retry-after of zero still counts as a wait, so the ceiling bounds the retries', async () => {
+    const steps: FauxStep[] = Array.from({ length: 62 }, () => quota(0));
+    const { opts, sleeps } = setup([...steps, { blocks: [text('ok')] }], { quotaWaitMs: 60_000 });
+    expect((await runPrompt(opts, 'hi')).subtype).toBe('error_during_execution');
+    expect(sleeps).toHaveLength(60);
+    expect(sleeps.every((ms) => ms === 1000)).toBe(true);
+  });
+
+  test('an unknown tool name of exactly 64 characters is shown whole, and longer ones are cut', async () => {
+    const name64 = 'y'.repeat(64);
+    const { log, opts } = setup([{ blocks: [toolUse('c1', name64, {}), toolUse('c2', `${name64}z`, {})] }, { blocks: [text('ok')] }]);
+    await runPrompt(opts, 'go');
+    const [a, b] = of(log.events, 'tool_result');
+    expect(a!.output.text).toBe(`not run: unknown tool "${name64}"`);
+    expect(b!.output.text).toBe(`not run: unknown tool "${name64}"`);
+  });
+});
