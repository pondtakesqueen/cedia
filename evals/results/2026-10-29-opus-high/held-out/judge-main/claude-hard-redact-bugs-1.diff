diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact-review.test.ts b/redact-review.test.ts
--- a/redact-review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact-review.test.ts	2026-10-29 18:52:52.408691976 +0000
@@ -0,0 +1,22 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+const r = (s: string) => redactSecrets(s).text;
+
+test('names ending in tokens still redact a secret value', () => {
+  expect(r('AUTH_TOKENS=abc12345xyz')).toBe(`AUTH_TOKENS=${REDACTED}`);
+  expect(r('AUTH_TOKENS: abc12345xyz')).toBe(`AUTH_TOKENS: ${REDACTED}`);
+  expect(r('{"tokens": "abc12345xyz"}')).toBe(`{"tokens": "${REDACTED}"}`);
+});
+
+test('token counts and limits are left alone', () => {
+  expect(r('MAX_TOKENS=4096')).toBe('MAX_TOKENS=4096');
+  expect(r('max_tokens: 1000')).toBe('max_tokens: 1000');
+});
+
+test('generic sk- keys need a digit', () => {
+  const letters = 'sk-' + 'a'.repeat(24);
+  expect(redactSecrets(letters)).toEqual({ text: letters, count: 0 });
+  const withDigit = 'sk-' + 'a'.repeat(23) + '1';
+  expect(redactSecrets(withDigit)).toEqual({ text: REDACTED, count: 1 });
+});
