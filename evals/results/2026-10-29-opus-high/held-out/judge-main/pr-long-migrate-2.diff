diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/handlers-rules.test.ts b/test/handlers-rules.test.ts
--- a/test/handlers-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/handlers-rules.test.ts	2026-10-29 19:32:29.859711001 +0000
@@ -0,0 +1,162 @@
+import { afterEach, beforeEach, expect, test } from 'bun:test';
+import { db, reset } from '../src/db.ts';
+import { HttpError } from '../src/errors.ts';
+import { adjustStock } from '../src/handlers/stock/adjustStock.ts';
+import { transferStock } from '../src/handlers/stock/transferStock.ts';
+import { createOrder } from '../src/handlers/orders/createOrder.ts';
+import { cancelOrder } from '../src/handlers/orders/cancelOrder.ts';
+import { listOrders } from '../src/handlers/orders/listOrders.ts';
+import { createUser } from '../src/handlers/users/createUser.ts';
+import { renameUser } from '../src/handlers/users/renameUser.ts';
+import { deactivateUser } from '../src/handlers/users/deactivateUser.ts';
+
+type Method = 'get' | 'put' | 'query';
+const original = { ...db.promises };
+const calls: string[] = [];
+const restore = () => Object.assign(db.promises, original);
+
+beforeEach(() => {
+  reset({
+    users: [
+      { id: 'u1', name: 'Ann', active: true },
+      { id: 'u2', name: 'Bob', active: false },
+    ],
+    stock: [
+      { id: 'TEE', units: 2 },
+      { id: 'MUG', units: 10 },
+    ],
+    orders: [
+      { id: 'o1', user: 'u1', sku: 'TEE', quantity: 1, status: 'open' },
+      { id: 'o2', user: 'u1', sku: 'MUG', quantity: 2, status: 'open' },
+      { id: 'o3', user: 'u1', sku: 'MUG', quantity: 1, status: 'shipped' },
+    ],
+  });
+  calls.length = 0;
+  for (const m of ['get', 'put', 'query'] as Method[]) {
+    const orig = original[m] as (...a: unknown[]) => Promise<unknown>;
+    (db.promises as Record<string, unknown>)[m] = (...args: unknown[]) => {
+      calls.push(m);
+      return orig(...args);
+    };
+  }
+});
+
+afterEach(restore);
+
+test('invalid input is rejected with HttpError before any db access', async () => {
+  const cases = [
+    () => createUser({ id: 'u9', name: '   ' }),
+    () => createOrder({ id: 'o9', user: 'u1', sku: 'TEE', quantity: 0 }),
+    () => adjustStock({ sku: 'TEE', delta: 0 }),
+    () => transferStock({ from: 'TEE', to: 'TEE', units: 1 }),
+  ];
+  for (const run of cases) {
+    const err = await run().then(
+      () => null,
+      (e: unknown) => e,
+    );
+    expect(err).toBeInstanceOf(HttpError);
+  }
+  expect(calls).toEqual([]);
+});
+
+test('a db error propagates unchanged and is not an HttpError', async () => {
+  const boom = new Error('boom');
+  (db.promises as Record<string, unknown>).get = async () => {
+    throw boom;
+  };
+  const runs = [
+    () => createUser({ id: 'u9', name: 'Cy' }),
+    () => renameUser({ id: 'u1', name: 'Cy' }),
+    () => deactivateUser({ id: 'u1' }),
+    () => createOrder({ id: 'o9', user: 'u1', sku: 'TEE', quantity: 1 }),
+    () => cancelOrder({ id: 'o1' }),
+    () => adjustStock({ sku: 'TEE', delta: 1 }),
+    () => transferStock({ from: 'TEE', to: 'MUG', units: 1 }),
+  ];
+  for (const run of runs) {
+    const err = await run().then(
+      () => null,
+      (e: unknown) => e,
+    );
+    expect(err).toBe(boom);
+    expect(err).not.toBeInstanceOf(HttpError);
+  }
+});
+
+test('renameUser with the same name returns the user and writes nothing', async () => {
+  const user = await renameUser({ id: 'u1', name: ' Ann ' });
+  expect(user).toEqual({ id: 'u1', name: 'Ann', active: true });
+  expect(calls).toEqual(['get']);
+});
+
+test('a rejected createOrder writes nothing', async () => {
+  await expect(createOrder({ id: 'o9', user: 'u1', sku: 'TEE', quantity: 5 })).rejects.toThrow('only 2 TEE left');
+  expect(await db.promises.get('stock', 'TEE')).toEqual({ id: 'TEE', units: 2 });
+  expect(await db.promises.get('orders', 'o9')).toBeUndefined();
+});
+
+test('deactivateUser cancels open orders one at a time and stops at a failed write', async () => {
+  const put = original.put;
+  let puts = 0;
+  (db.promises as Record<string, unknown>).put = async (t: string, row: { id: string }) => {
+    puts++;
+    if (t === 'orders' && puts === 3) throw new Error('disk full');
+    return put(t, row as never);
+  };
+  await expect(deactivateUser({ id: 'u1' })).rejects.toThrow('disk full');
+  expect(puts).toBe(3);
+  expect((await db.promises.get('users', 'u1'))!.active).toBe(false);
+  expect((await db.promises.get('orders', 'o1'))!.status).toBe('cancelled');
+  expect((await db.promises.get('orders', 'o2'))!.status).toBe('open');
+});
+
+test('deactivateUser returns the count of cancelled orders', async () => {
+  expect(await deactivateUser({ id: 'u1' })).toEqual({ cancelled: 2 });
+  expect((await listOrders({ user: 'u1', status: 'open' })).length).toBe(0);
+});
+
+test('transferStock writes source then target, and creates a missing target', async () => {
+  const written: string[] = [];
+  const put = original.put;
+  (db.promises as Record<string, unknown>).put = async (t: string, row: { id: string; units: number }) => {
+    written.push(`${row.id}=${row.units}`);
+    return put(t, row as never);
+  };
+  const res = await transferStock({ from: 'MUG', to: 'NEW', units: 4 });
+  expect(written).toEqual(['MUG=6', 'NEW=4']);
+  expect(res.from.units).toBe(6);
+  expect(res.to).toEqual({ id: 'NEW', units: 4 });
+});
+
+test('listOrders agrees with a reference filter and sort for every user and status', async () => {
+  const all = await db.promises.query('orders', () => true);
+  for (const user of ['u1', 'u2', 'u3', 'nobody']) {
+    for (const status of [undefined, 'open', 'shipped', 'cancelled']) {
+      const expected = all
+        .filter((o) => o.user === user && (!status || o.status === status))
+        .sort((a, b) => (b.id as string).localeCompare(a.id as string));
+      expect(await listOrders({ user, status })).toEqual(expected);
+    }
+  }
+});
+
+test('adjustStock never goes below zero', async () => {
+  for (let delta = -5; delta <= 5; delta++) {
+    if (delta === 0) continue;
+    const want = 2 + delta;
+    if (want >= 0) {
+      expect(await adjustStock({ sku: 'TEE', delta })).toEqual({ id: 'TEE', units: want });
