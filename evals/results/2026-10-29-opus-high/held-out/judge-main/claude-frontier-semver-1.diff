+import { expect, test } from "bun:test";
+import { compare, maxSatisfying, parse, satisfies } from "./semver";
+
+test("version syntax", () => {
+  for (const bad of ["01.2.3", "1.2.3-01", "1.2.3-", "1.2.3-a..b", "1.2", "vv1.2.3", "1.2.3.4"]) {
+    expect(parse(bad)).toBeNull();
+  }
+  for (const good of ["v1.2.3", " 1.2.3 ", "1.2.3-0a", "1.2.3-x-y.1+build.5"]) {
+    expect(parse(good)).not.toBeNull();
+  }
+  expect(parse("1.2.3-beta.10")?.prerelease).toEqual(["beta", 10n]);
+});
+
+test("order of prereleases and build metadata", () => {
+  const sorted = [
+    "1.0.0-1", "1.0.0-2", "1.0.0-10", "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta",
+    "1.0.0-beta", "1.0.0-beta.2", "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0", "1.0.1", "1.1.0", "2.0.0",
+  ].map((s) => parse(s)!);
+  for (let i = 0; i < sorted.length; i++) {
+    for (let j = i + 1; j < sorted.length; j++) {
+      expect(compare(sorted[i]!, sorted[j]!)).toBe(-1);
+      expect(compare(sorted[j]!, sorted[i]!)).toBe(1);
+    }
+  }
+  expect(compare(parse("1.2.3+a")!, parse("1.2.3+b")!)).toBe(0);
+  expect(compare(parse("1.0.0-99999999999999999998")!, parse("1.0.0-99999999999999999999")!)).toBe(-1);
+});
+
+// Each pair is [sugar, its expansion as the doc comment states it].
+const pairs: [string, string][] = [
+  ["*", ""],
+  ["1.x", ">=1.0.0 <2.0.0-0"],
+  ["1", ">=1.0.0 <2.0.0-0"],
+  ["1.2.x", ">=1.2.0 <1.3.0-0"],
+  ["1.2", ">=1.2.0 <1.3.0-0"],
+  [">1", ">=2.0.0"],
+  [">1.2", ">=1.3.0"],
+  [">=1.2", ">=1.2.0"],
