+  expect(satisfies("3.4.5-beta", ">=1.2.3-alpha")).toBe(false);
+  expect(satisfies("1.0.0-beta", "*")).toBe(false);
+  expect(satisfies("1.0.0-beta", "")).toBe(false);
+  expect(satisfies("1.3.0-beta", "^1.2.3")).toBe(false);
+  expect(satisfies("1.2.4-beta", "~1.2.3")).toBe(false);
+  expect(satisfies("0.0.4-0", "^0.0.3")).toBe(false);
+});
+
+test("unreadable input matches nothing and never throws", () => {
+  expect(satisfies("nope", "*")).toBe(false);
+  expect(satisfies("1.2.3", ">=")).toBe(false);
+  expect(satisfies("1.2.3", "1.x.3")).toBe(false);
+  expect(satisfies("1.2.3", "01.2.3")).toBe(false);
+  expect(satisfies("1.2.3", "^1.2-beta")).toBe(false);
+  expect(satisfies("1.2.3", "1.2.3 - ")).toBe(false);
+  expect(satisfies("1.2.3", "junk || 1.2.3")).toBe(false);
+  expect(satisfies("1.5.0", "garbage || 1.x")).toBe(false);
+  expect(satisfies("1.2.3", "1.2.3 - 1.x.3")).toBe(false);
+  expect(satisfies("1.2.3", "x.2")).toBe(false);
+  expect(satisfies("1.2.3", "1.2-beta - 2")).toBe(false);
+});
+
+test("maxSatisfying with prereleases and as-given strings", () => {
+  expect(maxSatisfying(["1.0.0-beta.2", "1.0.0-beta.10", "x", "1.0.0-beta.1"], ">=1.0.0-beta")).toBe("1.0.0-beta.10");
+  expect(maxSatisfying([" v1.2.4", "1.2.3"], "1.2.x")).toBe(" v1.2.4");
+  expect(maxSatisfying(["1.0.0"], ">2.0.0")).toBeNull();
+});
