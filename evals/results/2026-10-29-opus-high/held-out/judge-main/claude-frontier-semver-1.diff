+  expect(satisfies("0.0.4", "^0.0.3")).toBe(false);
+  expect(satisfies("1.9.9", "1.x")).toBe(true);
+  expect(satisfies("2.0.0", "1.x")).toBe(false);
+  expect(satisfies("2.3.9", "1.2 - 2.3")).toBe(true);
+  expect(satisfies("2.4.0", "1.2 - 2.3")).toBe(false);
+  expect(satisfies("1.0.0", ">*")).toBe(false);
+  expect(satisfies("1.0.0", "<* 1.x")).toBe(false);
+  expect(satisfies("1.2.3", ">= 1.2.3")).toBe(true);
+  expect(satisfies("1.2.3", "< 2")).toBe(true);
+  expect(satisfies("1.2.3", "v1.2.3")).toBe(true);
+  expect(satisfies("1.2.3+b", "1.2.3")).toBe(true);
+});
+
+test("prerelease rule", () => {
