diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact-regressions.test.ts b/redact-regressions.test.ts
--- a/redact-regressions.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact-regressions.test.ts	2026-10-29 19:20:56.132551881 +0000
@@ -0,0 +1,32 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+const r = (s: string) => redactSecrets(s).text;
+
+test('plural secret names are still redacted', () => {
+  expect(redactSecrets('API_TOKENS=abc123def456')).toEqual({ text: `API_TOKENS=${REDACTED}`, count: 1 });
+  expect(redactSecrets('REFRESH_TOKENS=abc123def456')).toEqual({ text: `REFRESH_TOKENS=${REDACTED}`, count: 1 });
+  expect(r('auth_tokens: "a1b2c3d4e5f6"')).toBe(`auth_tokens: "${REDACTED}"`);
+  expect(r('{"tokens": "a1b2c3d4e5f6"}')).toBe(`{"tokens": "${REDACTED}"}`);
+});
+
+test('a count in a plural token name is left alone', () => {
+  expect(redactSecrets('MAX_TOKENS=4096')).toEqual({ text: 'MAX_TOKENS=4096', count: 0 });
+});
+
+test('a generic sk- key needs a digit', () => {
+  const word = 'sk-' + 'abcdefghijklmnopqrstuvwxyz';
+  expect(redactSecrets(word)).toEqual({ text: word, count: 0 });
+  const keyed = 'sk-' + 'abcdefghijklmnopqrstuvwxyz0';
+  expect(redactSecrets(keyed)).toEqual({ text: REDACTED, count: 1 });
+});
+
+test('a private key block stops at its first end marker', () => {
+  const text = '-----BEGIN PRIVATE KEY-----\nA1\n-----END PRIVATE KEY-----\nkeep\n-----BEGIN PRIVATE KEY-----\nB2\n-----END PRIVATE KEY-----';
+  expect(redactSecrets(text)).toEqual({ text: `${REDACTED}\nkeep\n${REDACTED}`, count: 2 });
+});
+
+test('a URL password is replaced and the @ host separator is kept', () => {
+  expect(redactSecrets('postgres://u:s3cr3tpw@h/x')).toEqual({ text: `postgres://u:${REDACTED}@h/x`, count: 1 });
+  expect(redactSecrets(`postgres://u:${REDACTED}@h/x`)).toEqual({ text: `postgres://u:${REDACTED}@h/x`, count: 0 });
+});
