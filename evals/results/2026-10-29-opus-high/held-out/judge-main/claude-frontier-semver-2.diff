+import { expect, test } from "bun:test";
+import { compare, maxSatisfying, parse, satisfies } from "./semver";
+
+test("versions: no leading zeros, no empty prerelease identifiers", () => {
+  expect(parse("01.2.3")).toBeNull();
+  expect(parse("1.2.3-01")).toBeNull();
+  expect(parse("1.2.3-a..b")).toBeNull();
+  expect(parse("vv1.2.3")).toBeNull();
+  expect(parse(" v1.2.3+b.1 ")).not.toBeNull();
+  expect(parse("1.2.3-0a")).not.toBeNull();
+});
+
+test("prerelease order", () => {
+  const sorted = [
+    "1.0.0-alpha",
+    "1.0.0-alpha.1",
+    "1.0.0-alpha.beta",
+    "1.0.0-beta",
+    "1.0.0-beta.2",
+    "1.0.0-beta.11",
+    "1.0.0-rc.1",
+    "1.0.0",
+  ].map((s) => parse(s)!);
+  for (let i = 0; i < sorted.length; i++) {
+    for (let j = i + 1; j < sorted.length; j++) {
+      expect(compare(sorted[i]!, sorted[j]!)).toBe(-1);
+      expect(compare(sorted[j]!, sorted[i]!)).toBe(1);
+    }
+  }
+  expect(compare(parse("1.2.3+a")!, parse("1.2.3+b")!)).toBe(0);
+});
+
+test("X-ranges", () => {
+  for (const r of ["1.x", "1", "1.X", "1.*"]) {
+    expect(satisfies("1.0.0", r)).toBe(true);
+    expect(satisfies("1.9.9", r)).toBe(true);
+    expect(satisfies("2.0.0", r)).toBe(false);
+    expect(satisfies("0.9.9", r)).toBe(false);
+  }
+  expect(satisfies("1.3.0", "1.2")).toBe(false);
+  expect(satisfies("1.2.9", "1.2.x")).toBe(true);
+  expect(satisfies("0.0.0", "*")).toBe(true);
+});
+
+test("operators with partial versions", () => {
+  expect(satisfies("2.0.0", ">1")).toBe(true);
+  expect(satisfies("1.9.9", ">1")).toBe(false);
+  expect(satisfies("1.3.0", "> 1.2")).toBe(true);
+  expect(satisfies("1.2.9", ">1.2")).toBe(false);
+  expect(satisfies("1.2.0", ">=1.2")).toBe(true);
+  expect(satisfies("1.1.9", ">=1.2")).toBe(false);
+  expect(satisfies("1.1.9", "<1.2")).toBe(true);
+  expect(satisfies("1.2.0", "<1.2")).toBe(false);
+  expect(satisfies("1.3.0", "<=1.2")).toBe(false);
+  expect(satisfies("1.2.9", "<=1.2")).toBe(true);
+  expect(satisfies("1.9.9", "<=1")).toBe(true);
+  expect(satisfies("2.0.0", "<=1")).toBe(false);
+  expect(satisfies("1.2.0", "=1.2")).toBe(true);
+  expect(satisfies("1.0.0", ">*")).toBe(false);
+  expect(satisfies("1.0.0", "<*")).toBe(false);
+});
+
+test("tilde with partial versions and prereleases", () => {
+  expect(satisfies("1.2.9", "~1.2")).toBe(true);
+  expect(satisfies("1.3.0", "~1.2")).toBe(false);
+  expect(satisfies("1.9.0", "~1")).toBe(true);
+  expect(satisfies("2.0.0", "~1")).toBe(false);
+  expect(satisfies("1.2.3-beta.3", "~1.2.3-beta.2")).toBe(true);
+  expect(satisfies("1.2.4-beta", "~1.2.3-beta.2")).toBe(false);
+});
+
+test("caret at its edges", () => {
+  expect(satisfies("0.2.9", "^0.2.3")).toBe(true);
+  expect(satisfies("0.3.0", "^0.2.3")).toBe(false);
+  expect(satisfies("0.0.3", "^0.0.3")).toBe(true);
+  expect(satisfies("0.0.4", "^0.0.3")).toBe(false);
+  expect(satisfies("0.0.9", "^0.0")).toBe(true);
+  expect(satisfies("0.1.0", "^0.0")).toBe(false);
