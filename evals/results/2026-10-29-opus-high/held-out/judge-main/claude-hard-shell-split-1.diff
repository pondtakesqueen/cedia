--- a/shell.test.ts	2026-10-29 18:53:00.918488438 +0000
+++ b/shell.test.ts	2026-10-29 18:58:08.131588446 +0000
@@ -48,3 +48,85 @@
   expect(simpleCommands(' ; ; ')).toEqual([]);
   expect(simpleCommands('a;;b')).toEqual([['a'], ['b']]);
 });
+
+test('substitutions inside quotes and nested substitutions', () => {
+  expect(simpleCommands('echo "$(rm x)"')).toEqual([['echo', ''], ['rm', 'x']]);
+  expect(simpleCommands('echo $(a $(b))')).toEqual([['echo'], ['a'], ['b']]);
+  expect(simpleCommands('echo $(rm')).toBeNull();
+  expect(simpleCommands('echo `id')).toBeNull();
+});
+
+test('redirections that contain & are not background jobs', () => {
+  expect(simpleCommands('a 2>&1 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a >&2')).toEqual([['a']]);
+  expect(simpleCommands('a >&2 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('a 2>')).toEqual([['a']]);
+});
+
+test('quoted operators and keywords are words', () => {
+  expect(simpleCommands("echo '>' x")).toEqual([['echo', '>', 'x']]);
+  expect(simpleCommands('echo "if"')).toEqual([['echo', 'if']]);
+  expect(simpleCommands('echo "a;b|c"')).toEqual([['echo', 'a;b|c']]);
+  expect(simpleCommands("echo '>'& rm -rf /")).toEqual([['echo', '>'], ['rm', '-rf', '/']]);
+  expect(simpleCommands('echo "" \'\'')).toEqual([['echo', '', '']]);
+});
+
+test('assignments only lead, and words can be escaped', () => {
+  expect(simpleCommands('ls A=1')).toEqual([['ls', 'A=1']]);
+  expect(simpleCommands('rm a\\ b')).toEqual([['rm', 'a b']]);
+});
+
+test('wrapper flags that take a value, and -- ', () => {
+  expect(simpleCommands('env -u X -- rm f')).toEqual([['rm', 'f']]);
+  expect(simpleCommands('stdbuf -o L grep x')).toEqual([['grep', 'x']]);
+  expect(simpleCommands('sudo')).toEqual([['sudo']]);
+  expect(simpleCommands('env -u')).toEqual([['env', '-u']]);
+});
+
+test('shell invocations with other flags', () => {
+  expect(simpleCommands("bash -x -c 'a;b'")).toEqual([['a'], ['b']]);
+  expect(simpleCommands("bash -o pipefail -c 'a;b'")).toEqual([['a'], ['b']]);
+  expect(simpleCommands('bash -c "echo \'open"')).toBeNull();
+  expect(simpleCommands('bash -c')).toEqual([['bash', '-c']]);
+  expect(simpleCommands('/bin/bash -c "rm -rf /"')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('/usr/bin/sudo rm x')).toEqual([['rm', 'x']]);
+});
+
+test('a quoted redirection target does not hide the command', () => {
+  expect(simpleCommands('>"x" rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('2>"/dev/null" rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('echo hi 2>"/dev/null"')).toEqual([['echo', 'hi']]);
+  expect(simpleCommands('a 2>"x" b')).toEqual([['a', 'b']]);
+});
+
+test('a substitution counts as a word for redirections and arguments', () => {
+  expect(simpleCommands('rm > "$(echo f)" -rf /')).toEqual([['rm', '-rf', '/'], ['echo', 'f']]);
+  expect(simpleCommands('rm > $(echo f) -rf /')).toEqual([['rm', '-rf', '/'], ['echo', 'f']]);
+  expect(simpleCommands('git push "$(echo --force)"')).toEqual([['git', 'push', ''], ['echo', '--force']]);
+});
+
+test('eval and backslashes at the end of input or before a newline', () => {
+  expect(simpleCommands('eval rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('eval')).toEqual([]);
+  expect(simpleCommands('echo a\\')).toEqual([['echo', 'a\\']]);
+  expect(simpleCommands('echo a\\\nb')).toEqual([['echo', 'ab']]);
+});
+
+test('a line in a subshell, or in bash -c, gives the same commands', () => {
+  const lines = ['echo hi', 'rm -rf /', 'sudo -u root git push -f', 'FOO=1 make', 'bash -c "ls $(id)"', 'cat a 2>&1'];
+  for (const line of lines) {
+    expect(simpleCommands(`(${line})`)).toEqual(simpleCommands(line));
+    expect(simpleCommands(`bash -c '${line}'`)).toEqual(simpleCommands(line));
+  }
+});
+
+test('joining two lines with a separator joins their commands', () => {
+  const lines = ['echo hi', 'rm -rf /', 'sudo -u root git push -f', 'FOO=1 make', 'bash -c "ls $(id)"', 'cat a 2>&1'];
+  for (const x of lines) {
+    for (const y of lines) {
+      for (const sep of [';', ' && ', ' || ', ' | ', ' & ', '\n']) {
+        expect(simpleCommands(x + sep + y)).toEqual([...simpleCommands(x)!, ...simpleCommands(y)!]);
+      }
+    }
+  }
+});
