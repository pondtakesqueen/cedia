diff -ruN '--exclude=node_modules' '--exclude=.git' a/redact.review.test.ts b/redact.review.test.ts
--- a/redact.review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/redact.review.test.ts	2026-10-29 18:53:23.744666649 +0000
@@ -0,0 +1,18 @@
+import { expect, test } from 'bun:test';
+import { REDACTED, redactSecrets } from './redact.ts';
+
+const r = (s: string) => redactSecrets(s).text;
+
+test('secret names followed by letters or digits still redact their values', () => {
+  expect(r('secretKey: "abcd1234efgh"')).toBe(`secretKey: "${REDACTED}"`);
+  expect(r('password1=abcd1234efgh')).toBe(`password1=${REDACTED}`);
+  expect(r('API_KEYS=abc12345678')).toBe(`API_KEYS=${REDACTED}`);
+  expect(r('tokens: "abcdefgh1234"')).toBe(`tokens: "${REDACTED}"`);
+  expect(r('passwords: "abcdef"')).toBe(`passwords: "${REDACTED}"`);
+  expect(r('clientSecretValue=abcd1234ef')).toBe(`clientSecretValue=${REDACTED}`);
+});
+
+test('generic sk- keys need a digit and 20+ characters', () => {
+  expect(r('sk-abcdefghijklmnopqrstuvwxyz')).toBe('sk-abcdefghijklmnopqrstuvwxyz');
+  expect(r('sk-abcdefghijklmnopqrst1234')).toBe(REDACTED);
+});
