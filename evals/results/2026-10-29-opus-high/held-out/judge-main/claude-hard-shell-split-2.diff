--- a/shell.test.ts	2026-10-29 18:53:30.650368565 +0000
+++ b/shell.test.ts	2026-10-29 18:58:42.581196909 +0000
@@ -48,3 +48,63 @@
   expect(simpleCommands(' ; ; ')).toEqual([]);
   expect(simpleCommands('a;;b')).toEqual([['a'], ['b']]);
 });
+
+test('separators inside quotes are literal', () => {
+  expect(simpleCommands('echo "a;b|c"')).toEqual([['echo', 'a;b|c']]);
+  expect(simpleCommands("echo 'a && b'")).toEqual([['echo', 'a && b']]);
+  expect(simpleCommands('a|&b')).toEqual([['a'], ['b']]);
+});
+
+test('substitutions nest and respect quotes', () => {
+  expect(simpleCommands('a $(b $(c))')).toEqual([['a'], ['b'], ['c']]);
+  expect(simpleCommands('echo "$(rm x)"')).toEqual([['echo', ''], ['rm', 'x']]);
+  expect(simpleCommands("echo '$(rm x)'")).toEqual([['echo', '$(rm x)']]);
+});
+
+test('redirection operators and quoted or empty words', () => {
+  expect(simpleCommands('a >&2 b')).toEqual([['a', 'b']]);
+  expect(simpleCommands('echo "" x')).toEqual([['echo', '', 'x']]);
+  expect(simpleCommands('echo ">" x')).toEqual([['echo', '>', 'x']]);
+  expect(simpleCommands('echo if A=1')).toEqual([['echo', 'if', 'A=1']]);
+});
+
+test('wrappers by path, env -S and shell options', () => {
+  expect(simpleCommands('env -u X FOO=1 rm a')).toEqual([['rm', 'a']]);
+  expect(simpleCommands('/usr/bin/sudo rm a')).toEqual([['rm', 'a']]);
+  expect(simpleCommands("env -S 'rm -rf /'")).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('bash -o pipefail -c "rm a"')).toEqual([['rm', 'a']]);
+  expect(simpleCommands(`bash -c "eval 'rm a'"`)).toEqual([['rm', 'a']]);
+  expect(simpleCommands('bash script.sh')).toEqual([['bash', 'script.sh']]);
+});
+
+test('quoted assignment values, glued redirections and nested backticks', () => {
+  expect(simpleCommands('FOO="a b" rm -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands("FOO='x' sudo rm a")).toEqual([['rm', 'a']]);
+  expect(simpleCommands('A=1 B="2" rm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('ENV=a\\ b rm x')).toEqual([['rm', 'x']]);
+  expect(simpleCommands('rm>/dev/null -rf /')).toEqual([['rm', '-rf', '/']]);
+  expect(simpleCommands('git>/dev/null push --force')).toEqual([['git', 'push', '--force']]);
+  expect(simpleCommands('echo `echo \\`rm x\\``')).toEqual([['echo'], ['echo'], ['rm', 'x']]);
+});
+
+test('unbalanced input is null', () => {
+  for (const line of ['echo $(x', 'echo `x', `bash -c "echo 'x"`, 'echo "$(x)']) {
+    expect(simpleCommands(line)).toBeNull();
+  }
+});
+
+test('odd input never throws', () => {
+  for (const line of ['&', '\\', '>', 'sudo', 'bash -c', 'eval', '((', ')', '$', '`', '$(', '"', '&>', '2>&', 'env -S', 'bash -c ""']) {
+    const result = simpleCommands(line);
+    expect(result === null || Array.isArray(result)).toBe(true);
+  }
+});
+
+test('shell -c and eval agree with the plain line', () => {
+  for (const line of ['git reset --hard && ls', 'cd x; make', 'sudo -u root rm a', 'a > out 2>&1 b', '(cd x && make)', 'a &> log b']) {
+    expect(simpleCommands(`bash -c '${line}'`)).toEqual(simpleCommands(line));
+  }
+  for (const line of ['rm -rf /tmp/x', 'sudo -u root rm a', 'FOO=1 nice -n 5 make', 'a > out 2>&1 b']) {
+    expect(simpleCommands(`eval ${line}`)).toEqual(simpleCommands(line));
+  }
+});
