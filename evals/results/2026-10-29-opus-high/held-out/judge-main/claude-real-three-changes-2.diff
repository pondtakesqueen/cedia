diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/loop-review.test.ts b/test/loop-review.test.ts
--- a/test/loop-review.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/loop-review.test.ts	2026-10-29 19:10:13.719631577 +0000
@@ -0,0 +1,58 @@
+import { describe, expect, test } from 'bun:test';
+import { mkdtempSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { runPrompt, type RunOptions } from '../src/core/loop/run.ts';
+import { HANDOFF_PROMPT } from '../src/core/project/handoff.ts';
+import { FAUX_MODEL } from '../src/core/providers/catalog.ts';
+import { fauxProvider, text, toolUse, type FauxStep } from '../src/core/providers/faux.ts';
+import { SessionLog } from '../src/core/session/log.ts';
+import { bashTool } from '../src/core/tools/bash.ts';
+import { CORE_TOOLS } from '../src/core/tools/index.ts';
+import { readTool } from '../src/core/tools/read.ts';
+
+const cwd = mkdtempSync(join(tmpdir(), 'cedia-loop-review-'));
+writeFileSync(join(cwd, 'a.txt'), 'alpha\n');
+
+function setup(steps: FauxStep[], extra: Partial<RunOptions> = {}) {
+  const sleeps: number[] = [];
+  const opts: RunOptions = {
+    log: SessionLog.create(),
+    provider: fauxProvider(steps),
+    model: FAUX_MODEL,
+    tools: [readTool, bashTool],
+    system: 'sys',
+    cwd,
+    retry: { sleep: async (ms) => void sleeps.push(ms) },
+    ...extra,
+  };
+  return { opts, sleeps };
+}
+
+describe('loop review fixes', () => {
+  test('a quota error that names a zero wait falls back at once, it never waits in a loop', async () => {
+    const quota: FauxStep = { error: { code: 'quota', status: 429, retryAfterMs: 0, message: 'usage limit reached' } };
+    const { opts, sleeps } = setup([quota, quota, quota], { quotaWaitMs: 60_000 });
+    const res = await runPrompt(opts, 'hi');
+    expect(res.subtype).toBe('error_during_execution');
+    expect(sleeps).toEqual([]);
+    expect(opts.log.events.filter((e) => e.kind === 'attempt')).toHaveLength(1);
+  });
+
+  test('a refusal while asked for the handoff note fails the run instead of becoming the note', async () => {
+    const big = 'x'.repeat(40_000);
+    const bigTool = { ...CORE_TOOLS[0]!, name: 'big', effect: 'read' as const, pathOf: undefined, run: async () => ({ text: big, isError: false }) };
+    const { opts } = setup(
+      [
+        { blocks: [toolUse('w1', 'write', { path: 'f.txt', content: 'x' })] },
+        { blocks: [toolUse('c1', 'big', {})] },
+        { blocks: [text('I cannot help with that.')], stop: 'refusal' },
+      ],
+      { handoffAt: 2000, tools: [...CORE_TOOLS, bigTool], permission: { mode: 'workspace', allow: [], deny: [] } },
+    );
+    const res = await runPrompt(opts, 'write f.txt');
+    expect(opts.log.events.some((e) => e.kind === 'reminder' && e.text === HANDOFF_PROMPT)).toBe(true);
+    expect(res.subtype).toBe('error_during_execution');
+    expect(res.subtype).not.toBe('handoff');
+  });
+});
