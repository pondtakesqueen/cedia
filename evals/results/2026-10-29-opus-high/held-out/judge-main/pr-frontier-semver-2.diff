+  expect(satisfies("1.2.3-a", " || 9.9.9")).toBe(false);
+});
+
+test("prerelease rule", () => {
+  expect(satisfies("1.2.3-beta.4", ">=1.2.3-alpha")).toBe(true);
+  expect(satisfies("3.4.5-beta", ">=1.2.3-alpha")).toBe(false);
+  expect(satisfies("1.9.0-beta", "^1.2.3")).toBe(false);
+  expect(satisfies("1.2.3-beta.3", "^1.2.3-beta.2")).toBe(true);
+  expect(satisfies("1.2.4-beta", "^1.2.3-beta.2")).toBe(false);
+  expect(satisfies("2.0.0-0", "^1.2.3-beta.2")).toBe(false);
+  expect(satisfies("2.0.0-0", "<2.0.0-0")).toBe(false);
+});
+
+test("unreadable ranges match nothing", () => {
+  for (const r of ["1.x.3", ">=", "1.2.3 -", "foo", "1.2-beta", "^1.2.3 || foo"]) expect(satisfies("1.2.3", r)).toBe(false);
+});
+
+test("numeric prerelease identifiers compare as numbers, however large", () => {
+  expect(compare(parse("1.0.0-99999999999999999999")!, parse("1.0.0-99999999999999999998")!)).toBe(1);
+  expect(compare(parse("1.0.0-9")!, parse("1.0.0-10")!)).toBe(-1);
+});
+
+test("hyphen ranges with wildcard or prerelease ends", () => {
+  expect(satisfies("0.0.0-alpha", "* - 2")).toBe(false);
+  expect(satisfies("1.2.3-beta", "1.2.3-alpha - 2")).toBe(true);
+  expect(satisfies("1.2.4", "1.2.3-alpha - 2")).toBe(true);
+  expect(satisfies("1.2.2-beta", "1.2.3-alpha - 2")).toBe(false);
+  expect(satisfies("2.0.0-0", "1.2.3-alpha - 2")).toBe(false);
+});
+
+test("maxSatisfying", () => {
+  expect(maxSatisfying(["1.0.0-beta.2", "1.0.0-beta.10", "x"], ">=1.0.0-beta")).toBe("1.0.0-beta.10");
+  expect(maxSatisfying(["1.2.3", "1.2.3+b"], "1.2.3")).toBe("1.2.3");
+  expect(maxSatisfying(["1.2.3"], ">2")).toBeNull();
+});
