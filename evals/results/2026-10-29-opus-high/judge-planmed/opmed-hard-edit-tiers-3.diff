 // from/to are 1-based line numbers of the replaced text in the original content; count is how many places were replaced.
 export type Applied = { from: number; to: number; tier: Tier; count: number };
 
+// Splits text into lines after dropping one trailing '\n'; '' gives no lines.
+function toLines(text: string): string[] {
+  if (text === '') return [];
+  return (text.endsWith('\n') ? text.slice(0, -1) : text).split('\n');
+}
+
+// 1-based line number of offset `at` in `text`.
+function lineOf(text: string, at: number): number {
+  let n = 1;
+  for (let i = text.indexOf('\n'); i !== -1 && i < at; i = text.indexOf('\n', i + 1)) n++;
+  return n;
+}
+
+// Start indices of every window of `body` whose lines equal `want` once `norm` is applied to both.
+function findWindows(body: string[], want: string[], norm: (s: string) => string): number[] {
+  const starts: number[] = [];
+  for (let s = 0; want.length > 0 && s + want.length <= body.length; s++) {
+    if (want.every((w, i) => norm(body[s + i]) === norm(w))) starts.push(s);
+  }
+  return starts;
+}
+
+const leading = (s: string) => /^\s*/.exec(s)![0];
+
 // Applies one edit to `content`.
 //
 // Tiers, tried in order; a tier applies only when it finds exactly one place (or replace_all is set, exact tier only):
@@ -23,5 +47,60 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text, replace_all } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create or replace a whole file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  const hits: number[] = [];
+  for (let i = content.indexOf(old_text); i !== -1; i = content.indexOf(old_text, i + old_text.length)) hits.push(i);
+  if (hits.length > 1 && !replace_all) {
+    return { error: `old_text matches ${hits.length} places (first at line ${lineOf(content, hits[0])}); add surrounding lines or set replace_all` };
+  }
+  if (hits.length > 0) {
+    return {
+      content: content.split(old_text).join(new_text),
+      applied: { from: lineOf(content, hits[0]), to: lineOf(content, hits[hits.length - 1] + old_text.length - 1), tier: 'exact', count: hits.length },
+    };
+  }
+
+  const trailingNl = content.endsWith('\n');
+  const body = toLines(content);
+  const oldLines = toLines(old_text);
+  const newLines = toLines(new_text);
+  const splice = (tier: Tier, start: number, lines: string[]) => {
+    // Replaced lines take the line ending of the last matched line, so CRLF files stay CRLF.
+    const eol = body[start + oldLines.length - 1].endsWith('\r') ? '\r' : '';
+    body.splice(start, oldLines.length, ...lines.map(l => l.replace(/\r$/, '') + eol));
+    return {
+      content: body.join('\n') + (trailingNl && body.length ? '\n' : ''),
+      applied: { from: start + 1, to: start + oldLines.length, tier, count: 1 },
+    };
+  };
+
+  // A whitespace-only old_text names no text, so it must not match blank lines in the line tiers.
+  const hasText = oldLines.some(l => l.trim() !== '');
+  const w2 = hasText ? findWindows(body, oldLines, s => s.trimEnd()) : [];
+  if (w2.length > 1) {
+    return { error: `old_text matches ${w2.length} places (ignoring trailing whitespace) at lines ${w2.map(s => s + 1).join(', ')}` };
+  }
+  if (w2.length === 1) return splice('trailing-space', w2[0], newLines);
+
+  const w3 = hasText ? findWindows(body, oldLines, s => s.trim()) : [];
+  if (w3.length > 1) {
+    return { error: `old_text matches ${w3.length} places (ignoring indentation) at lines ${w3.map(s => s + 1).join(', ')}` };
+  }
+  if (w3.length === 1) {
+    const k = oldLines.findIndex(l => l.trim() !== '');
+    const from = leading(oldLines[k]);
+    const to = leading(body[w3[0] + k]);
+    const mapped = newLines.map(l => (l.trim() === '' ? l : l.startsWith(from) ? to + l.slice(from.length) : l));
+    return splice('indentation', w3[0], mapped);
+  }
+
+  const first = oldLines.find(l => l.trim() !== '')?.trim();
+  const at: number[] = [];
+  if (first) {
+    for (let i = 0; i < body.length && at.length < 5; i++) if (body[i].includes(first)) at.push(i + 1);
+  }
+  return { error: `old_text not found${at.length ? ` (first line appears at line ${at.join(', ')})` : ''}` };
 }
