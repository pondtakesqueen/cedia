diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-30 03:22:28.412744765 +0000
@@ -0,0 +1,92 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+const errOf = (r: ReturnType<typeof applyEdit>) => ('error' in r ? r.error : '');
+
+// Small deterministic PRNG (LCG) so the random cases are repeatable.
+function rng(seed: number) {
+  let s = seed >>> 0;
+  return (n: number) => {
+    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
+    return s % n;
+  };
+}
+const pick = (rand: (n: number) => number, chars: string[], len: number) =>
+  Array.from({ length: len }, () => chars[rand(chars.length)]).join('');
+
+describe('rules', () => {
+  test('same text is reported before searching', () => {
+    expect(errOf(applyEdit('a\n', { old_text: 'zz', new_text: 'zz' }))).toContain('same');
+  });
+  test('exact ambiguity does not fall through to trailing-space', () => {
+    const r = applyEdit('x  \nx\n', { old_text: 'x', new_text: 'z' });
+    expect(errOf(r)).toContain('matches 2 places');
+  });
+  test('replace_all with no exact match falls through to line tiers', () => {
+    const r = ok(applyEdit('a\nb\n', { old_text: 'a ', new_text: 'c', replace_all: true }));
+    expect(r.content).toBe('c\nb\n');
+    expect(r.applied.tier).toBe('trailing-space');
+  });
+  test('replace_all with two line-tier matches is still an error', () => {
+    expect(errOf(applyEdit('a \nb\na  \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }))).toContain('matches 2 places');
+  });
+  test('empty new_text deletes lines in trailing-space tier', () => {
+    expect(ok(applyEdit('a\nb\n', { old_text: 'a ', new_text: '' })).content).toBe('b\n');
+  });
+  test('indentation tier with several matches is an error listing lines', () => {
+    const r = applyEdit('  a\n    a\n', { old_text: '\ta\n', new_text: 'b' });
+    expect(errOf(r)).toContain('matches 2 places (ignoring indentation)');
+    expect(errOf(r)).toContain('1, 2');
+  });
+  test('not found lists at most five pointer lines', () => {
+    const src = 'k\nk\nk\nk\nk\nk\nk\n';
+    const e = errOf(applyEdit(src, { old_text: 'k\nz', new_text: 'q' }));
+    expect(e).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect(e).not.toContain(' 6');
+  });
+  test('missing final newline stays missing', () => {
+    expect(ok(applyEdit('a\nb', { old_text: 'a ', new_text: 'c' })).content).toBe('c\nb');
+  });
+  test('whitespace-only old_text does not replace an unrelated blank line', () => {
+    expect(errOf(applyEdit('a\n\nb\n', { old_text: '  ', new_text: 'x' }))).toContain('not found');
+  });
+  test('indentation tier re-indents new_text to a deeper file', () => {
+    const r = ok(applyEdit('  if (a) {\n    return 1;\n  }\n', { old_text: '    if (a) {\n        return 1;\n    }', new_text: '    if (b) {\n        return 1;\n    }' }));
+    expect(r.content).toBe('  if (b) {\n      return 1;\n  }\n');
+  });
+  test('indentation tier leaves a new_text line without the old prefix as given', () => {
+    const r = ok(applyEdit('\ta\n\tb\n', { old_text: '  a\n  b', new_text: 'x\n  y' }));
+    expect(r.content).toBe('x\n\ty\n');
+  });
+  test('CRLF: replaced lines keep CRLF and untouched lines are unchanged', () => {
+    expect(ok(applyEdit('a\r\nb\r\n', { old_text: 'a\nb', new_text: 'c\nd' })).content).toBe('c\r\nd\r\n');
+    expect(ok(applyEdit('x\r\na\r\nb\r\ny\r\n', { old_text: 'a\nb', new_text: 'c' })).content).toBe('x\r\nc\r\ny\r\n');
+  });
+  test('random edits never throw', () => {
+    const rand = rng(7);
+    const chars = ['a', 'b', ' ', '\t', '\n'];
+    for (let i = 0; i < 300; i++) {
+      const content = pick(rand, chars, rand(12));
+      const edit = { old_text: pick(rand, chars, rand(4)), new_text: pick(rand, chars, rand(4)), replace_all: rand(2) === 0 };
+      expect(() => applyEdit(content, edit)).not.toThrow();
+    }
+  });
+  test('replace_all equals split/join on random content', () => {
+    const rand = rng(11);
+    const chars = ['a', 'b', '\n'];
+    for (let i = 0; i < 500; i++) {
+      const content = pick(rand, chars, 1 + rand(12));
+      const start = rand(content.length);
+      const old = content.slice(start, start + 1 + rand(3));
+      const neu = pick(rand, ['c', 'd'], 1 + rand(3));
+      if (old === neu) continue;
+      const r = ok(applyEdit(content, { old_text: old, new_text: neu, replace_all: true }));
+      expect(r.content).toBe(content.split(old).join(neu));
+      expect(r.applied.count).toBe(content.split(old).length - 1);
+    }
+  });
+});
