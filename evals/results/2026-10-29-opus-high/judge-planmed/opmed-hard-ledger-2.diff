+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+
+describe('rules the main tests skip', () => {
+  test('a cd to the working directory is removed only once, and only when it resolves to cwd', () => {
+    expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /elsewhere && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+
+  test('the first matching check in order is returned, and an empty check matches nothing', () => {
+    expect(matchCheck('bun test', ['bun  test 2>&1', 'bun test'])).toBe('bun  test 2>&1');
+    expect(matchCheck('', [''])).toBeUndefined();
+    expect(matchCheck('bun test; ls', ['bun test'])).toBeUndefined();
+  });
+
+  test('a bash check with cwd becomes a check entry, and a denied check is not one', () => {
+    const ok: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'a', tool: 'bash', input: { command: 'cd /work/repo && bun test' } },
+      { kind: 'tool_result', callId: 'a', status: 'completed', output: { isError: false, exitCode: 0 } },
+      { kind: 'tool_intent', callId: 'b', tool: 'bash', input: { command: 'bun test' } },
+      { kind: 'tool_result', callId: 'b', status: 'denied', output: { isError: true } },
+    ];
+    expect(ledgerEntries(ok, ['bun test'], cwd)).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+  });
+
+  test('a failed non-read-only bash command is a write, a failed edit is not, and a duplicate result counts once', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'a', tool: 'bash', input: { command: 'npm i' } },
+      { kind: 'tool_result', callId: 'a', status: 'failed', output: { isError: true, exitCode: 2 } },
+      { kind: 'tool_result', callId: 'a', status: 'completed', output: { isError: false } },
+      { kind: 'tool_intent', callId: 'b', tool: 'edit', input: { path: 'x.ts' } },
+      { kind: 'tool_result', callId: 'b', status: 'failed', output: { isError: true } },
+      { kind: 'tool_intent', callId: 'c', tool: 'bash', input: { command: 'git status' } },
+      { kind: 'tool_result', callId: 'c', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'npm i' }]);
+  });
+
+  test('a snapshot before the result applies at the result position, and a failed edit with a snapshot counts its paths', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'e', tool: 'edit', input: { path: 'ignored.ts' } },
+      { kind: 'snapshot', callId: 'e', changed: ['real.ts'] },
+      { kind: 'tool_result', callId: 'e', status: 'failed', output: { isError: true } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'edit', path: 'real.ts' }]);
+  });
+
+  test('evidence dedupes labels and a passing check covers earlier writes only', () => {
+    const w = (at: number, path: string) => ({ kind: 'write' as const, at, tool: 'edit', path });
+    const c = (at: number, exitCode: number) => ({ kind: 'check' as const, at, command: 'bun test', exitCode });
+    const e = evidence([w(0, 'a.ts'), c(1, 0), w(2, 'a.ts'), c(3, 1), w(4, 'a.ts')]);
+    expect(e.changed).toEqual(['a.ts']);
+    expect(e.unverified).toEqual(['a.ts']);
+    expect(verified([w(0, 'a.ts'), c(1, 0), c(2, 1)], ['bun test'])).toBe(true);
+  });
+
+  test('verified is false when writes are not followed by a passing check', () => {
+    expect(verified([{ kind: 'write', at: 0, tool: 'bash', command: 'npm i' }], ['bun test'])).toBe(false);
+  });
+});
+
+describe('ledgerEntries and verified edge rules', () => {
+  const edit = (callId: string, path: string, status: 'completed' | 'failed' | 'denied' | 'not_started' = 'completed'): SessionEvent[] => [
+    { kind: 'tool_intent', callId, tool: 'edit', input: { path } },
+    { kind: 'tool_result', callId, status, output: { isError: status !== 'completed' } },
+  ];
+
+  test('a request clears pending intents, so a result from before it is ignored', () => {
+    const [intent, result] = edit('r', 'a.ts');
+    expect(ledgerEntries([intent!, { kind: 'request' }, result!], [])).toEqual([]);
+  });
+
+  test('a result with no intent is ignored', () => {
+    expect(ledgerEntries([{ kind: 'tool_result', callId: 'ghost', status: 'completed', output: { isError: false } }], [])).toEqual([]);
+  });
+
+  test('a not_started result is ignored', () => {
+    expect(ledgerEntries(edit('n', 'a.ts', 'not_started'), [])).toEqual([]);
+  });
+
+  test('a snapshot with an empty list writes nothing and does not fall through to the bash branch', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'b', tool: 'bash', input: { command: 'npm i' } },
+      { kind: 'tool_result', callId: 'b', status: 'completed', output: { isError: false, exitCode: 0 } },
+      { kind: 'snapshot', callId: 'b', changed: [] },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([]);
+  });
+
+  test('a snapshot that arrives after its result still applies, at the result position', () => {
+    const events: SessionEvent[] = [...edit('s', 'ignored.ts'), { kind: 'snapshot', callId: 's', changed: ['real.ts'] }];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'real.ts' }]);
+  });
+
+  test('a check with no exit code and isError set gets exit code 1', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'k', tool: 'bash', input: { command: 'bun test' } },
+      { kind: 'tool_result', callId: 'k', status: 'failed', output: { isError: true } },
+    ];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 1 }]);
+  });
+
+  test('verified is true with no declared checks, and with no writes', () => {
+    const write = { kind: 'write' as const, at: 0, tool: 'edit', path: 'a.ts' };
+    expect(verified([write], [])).toBe(true);
+    expect(verified([], ['bun test'])).toBe(true);
+  });
+});
