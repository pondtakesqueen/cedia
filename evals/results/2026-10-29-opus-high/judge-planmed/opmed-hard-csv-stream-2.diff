--- a/csv.ts	2026-10-30 03:08:06.624828132 +0000
+++ b/csv.ts	2026-10-30 03:10:25.330068147 +0000
@@ -50,3 +50,126 @@
   rows.push(row);
   return rows;
 }
+
+/** Where a CsvStream stopped inside the row in progress. */
+type State = "start" | "plain" | "plainCr" | "quoted" | "quote" | "quoteCr";
+
+const special = /[,\r\n"]/g;
+
+function afterQuote(c: string, at: number): SyntaxError {
+  return new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${at}`);
+}
+
+/**
+ * Reads CSV from chunks with the rules of parseCsv, and returns each row once its row end has arrived. It keeps
+ * only the row in progress: its finished fields, the text of the field being read, and where reading stopped.
+ * After a SyntaxError every later call throws that same error. After end() every later call throws an Error.
+ */
+export class CsvStream {
+  #row: string[] = [];
+  #field = "";
+  #state: State = "start";
+  #offset = 0;
+  #closed: Error | undefined;
+
+  push(chunk: string): string[][] {
+    if (this.#closed) throw this.#closed;
+    const rows: string[][] = [];
+    try {
+      let i = this.#offset === 0 && chunk.startsWith("﻿") ? 1 : 0;
+      while (i < chunk.length) {
+        switch (this.#state) {
+          case "start":
+            if (chunk[i] === '"') {
+              this.#state = "quoted";
+              i++;
+            } else this.#state = "plain";
+            break;
+          case "plain": {
+            special.lastIndex = i;
+            const m = special.exec(chunk);
+            const j = m ? m.index : chunk.length;
+            this.#field += chunk.slice(i, j);
+            i = j;
+            if (j === chunk.length) break;
+            const c = chunk[i++];
+            if (c === '"') throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.#offset + j}`);
+            if (c === ",") this.#endField();
+            else if (c === "\n") this.#endRow(rows);
+            else this.#state = "plainCr";
+            break;
+          }
+          case "plainCr":
+            if (chunk[i] === "\n") {
+              i++;
+              this.#endRow(rows);
+            } else {
+              this.#field += "\r";
+              this.#state = "plain";
+            }
+            break;
+          case "quoted": {
+            const j = chunk.indexOf('"', i);
+            if (j === -1) {
+              this.#field += chunk.slice(i);
+              i = chunk.length;
+            } else {
+              this.#field += chunk.slice(i, j);
+              i = j + 1;
+              this.#state = "quote";
+            }
+            break;
+          }
+          case "quote": {
+            const c = chunk[i++]!;
+            if (c === '"') {
+              this.#field += '"';
+              this.#state = "quoted";
+            } else if (c === ",") this.#endField();
+            else if (c === "\n") this.#endRow(rows);
+            else if (c === "\r") this.#state = "quoteCr";
+            else throw afterQuote(c, this.#offset + i - 1);
+            break;
+          }
+          case "quoteCr":
+            if (chunk[i] !== "\n") throw afterQuote("\r", this.#offset + i - 1);
+            i++;
+            this.#endRow(rows);
+            break;
+        }
+      }
+    } catch (e) {
+      this.#closed = e as Error;
+      throw e;
+    }
+    this.#offset += chunk.length;
+    return rows;
+  }
+
+  end(): string[][] {
+    if (this.#closed) throw this.#closed;
+    try {
+      if (this.#state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+      if (this.#state === "quoteCr") throw afterQuote("\r", this.#offset - 1);
+      if (this.#state === "plainCr") this.#field += "\r";
+      const rows = this.#state === "start" && this.#row.length === 0 ? [] : [[...this.#row, this.#field]];
+      this.#closed = new Error("the stream has ended");
+      return rows;
+    } catch (e) {
+      this.#closed = e as Error;
+      throw e;
+    }
+  }
+
+  #endField() {
+    this.#row.push(this.#field);
+    this.#field = "";
+    this.#state = "start";
+  }
+
+  #endRow(rows: string[][]) {
+    this.#endField();
+    rows.push(this.#row);
+    this.#row = [];
+  }
+}
