diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-30 03:23:53.914164347 +0000
@@ -0,0 +1,61 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+function reference(xs: number[]): number {
+  const s = [...xs].sort((a, b) => a - b);
+  const mid = Math.floor(s.length / 2);
+  return s.length % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+}
+
+test('empty input throws', () => {
+  expect(() => median([])).toThrow(Error);
+  expect(() => median([])).toThrow('empty');
+});
+
+test('odd length returns the middle value', () => {
+  expect(median([5])).toBe(5);
+  expect(median([3, 1, 2])).toBe(2);
+});
+
+test('even length returns the mean of the two middle values', () => {
+  expect(median([1, 2])).toBe(1.5);
+  expect(median([4, 1, 3, 2])).toBe(2.5);
+});
+
+test('large magnitudes do not overflow the mean of the middle pair', () => {
+  expect(median([1e308, 1e308])).toBe(1e308);
+  expect(median([-1e308, 1e308])).toBe(0);
+  expect(median([1.5e308, 1.7e308])).toBe(1.6e308);
+  expect(median([5e-324, 5e-324])).toBe(5e-324);
+});
+
+test('numbers sort as numbers, not strings', () => {
+  expect(median([10, 9, 100, 1])).toBe(9.5);
+  expect(median([-5, -10, 2])).toBe(-5);
+});
+
+test('duplicates and floats', () => {
+  expect(median([7, 7, 7])).toBe(7);
+  expect(median([2, 2, 1, 3])).toBe(2);
+  expect(median([0.1, 0.2, 0.3])).toBe(0.2);
+});
+
+test('the input array is left unchanged', () => {
+  const xs = [9, 3, 7, 1];
+  const copy = [...xs];
+  median(xs);
+  expect(xs).toEqual(copy);
+});
+
+test('agrees with a reference implementation on seeded random inputs', () => {
+  let seed = 12345;
+  const next = () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed;
+  };
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + (next() % 20);
+    const xs = Array.from({ length: n }, () => (next() % 101) - 50);
+    expect(median(xs)).toBe(reference(xs));
+  }
+});
