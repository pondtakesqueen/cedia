@@ -0,0 +1,328 @@
+import { expect, test } from "bun:test";
+import { runPool, type Settled } from "./pool";
+
+type Deferred<T> = { promise: Promise<T>; resolve: (v: T) => void; reject: (e: unknown) => void };
+const deferred = <T>(): Deferred<T> => {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+};
+
+// Lets pending promise callbacks run without any timer.
+const flush = async () => {
+  for (let i = 0; i < 50; i++) await Promise.resolve();
+};
+
+test("invalid limit or retries reject with RangeError before any task runs", async () => {
+  let calls = 0;
+  const task = () => {
+    calls++;
+    return 1;
+  };
+  for (const limit of [1.5, NaN, -1, 0]) await expect(runPool([task], limit)).rejects.toBeInstanceOf(RangeError);
+  for (const retries of [-1, 1.5, NaN, Infinity]) await expect(runPool([task], 1, { retries })).rejects.toBeInstanceOf(RangeError);
+  expect(calls).toBe(0);
+});
+
+test("a limit of Infinity starts every task at once", async () => {
+  const ds = [0, 1, 2, 3, 4].map(() => deferred<number>());
+  let started = 0;
+  const run = runPool(
+    ds.map((d) => () => {
+      started++;
+      return d.promise;
+    }),
+    Infinity,
+  );
+  expect(started).toBe(5);
+  ds.forEach((d, i) => d.resolve(i));
+  expect((await run).map((r) => r.status)).toEqual(Array(5).fill("fulfilled"));
+});
+
+test("never runs more than limit at once, and refills a slot as soon as one settles", async () => {
+  const ds = [0, 1, 2, 3, 4].map(() => deferred<number>());
+  const order: number[] = [];
+  const run = runPool(
+    ds.map((d, i) => () => {
+      order.push(i);
+      return d.promise;
+    }),
+    2,
+  );
+  expect(order).toEqual([0, 1]);
+  ds[1].resolve(1);
+  await flush();
+  expect(order).toEqual([0, 1, 2]);
+  ds[0].resolve(0);
+  await flush();
+  expect(order).toEqual([0, 1, 2, 3]);
+  ds.forEach((d, i) => i !== 1 && d.resolve(i));
+  await run;
+});
+
+test("results are in input order, not finish order", async () => {
+  const ds = [0, 1, 2].map(() => deferred<number>());
+  const run = runPool(
+    ds.map((d) => () => d.promise),
+    3,
+  );
+  [2, 1, 0].forEach((i) => ds[i].resolve(i));
+  const out = await run;
+  expect(out.map((r) => (r.status === "fulfilled" ? r.value : -1))).toEqual([0, 1, 2]);
+});
+
+test("a synchronous throw is a rejection and a plain value is a fulfilment", async () => {
+  const boom = new Error("boom");
+  const out = await runPool(
+    [
+      () => {
+        throw boom;
+      },
+      () => 42,
+      () => Promise.resolve("ok"),
+    ],
+    1,
+  );
+  expect(out).toEqual([
+    { status: "rejected", reason: boom, attempts: 1 },
+    { status: "fulfilled", value: 42, attempts: 1 },
+    { status: "fulfilled", value: "ok", attempts: 1 },
+  ]);
+});
+
+test("retries use the same slot and attempts counts every call", async () => {
+  let always = 0;
+  let flaky = 0;
+  const out = await runPool(
+    [
+      () => {
+        always++;
+        return Promise.reject(new Error("no"));
+      },
+      () => {
+        flaky++;
+        return flaky === 1 ? Promise.reject(new Error("once")) : Promise.resolve("yes");
+      },
+    ],
+    1,
+    { retries: 2 },
+  );
+  expect(always).toBe(3);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 3 });
+  expect(out[1]).toEqual({ status: "fulfilled", value: "yes", attempts: 2 });
+});
+
+test("a retrying task holds its slot: the next task waits until it finishes", async () => {
+  const first = [deferred<number>(), deferred<number>()];
+  let calls0 = 0;
+  const started: number[] = [];
+  const run = runPool(
+    [
+      () => {
+        calls0++;
+        return first[calls0 - 1].promise;
+      },
+      () => {
+        started.push(1);
+        return 1;
+      },
+    ],
+    1,
+    { retries: 1 },
+  );
+  first[0].reject(new Error("try again"));
+  await flush();
+  expect(started).toEqual([]);
+  first[1].resolve(7);
+  expect(await run).toEqual([
+    { status: "fulfilled", value: 7, attempts: 2 },
+    { status: "fulfilled", value: 1, attempts: 1 },
+  ]);
+});
+
+test("an already aborted signal starts nothing and settles every task with attempts 0", async () => {
+  const ac = new AbortController();
+  ac.abort("stop");
+  let calls = 0;
+  const out = await runPool(
+    [1, 2, 3].map(() => () => {
+      calls++;
+      return 1;
+    }),
+    2,
+    { signal: ac.signal },
+  );
+  expect(calls).toBe(0);
+  expect(out).toEqual([0, 1, 2].map((): Settled<number> => ({ status: "rejected", reason: "stop", attempts: 0 })));
+});
+
+test("an abort keeps in-flight results and settles unstarted tasks, without starting more", async () => {
+  const ac = new AbortController();
+  const ds = [0, 1, 2, 3].map(() => deferred<string>());
+  let calls = 0;
+  const run = runPool(
+    ds.map((d) => () => {
+      calls++;
+      return d.promise;
+    }),
+    2,
+    { signal: ac.signal },
+  );
+  ac.abort("stop");
+  ds[0].resolve("a");
+  ds[1].resolve("b");
+  expect(await run).toEqual([
+    { status: "fulfilled", value: "a", attempts: 1 },
+    { status: "fulfilled", value: "b", attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+  expect(calls).toBe(2);
+});
+
+test("a retry cancelled by an abort settles with signal.reason and the attempts made", async () => {
+  const ac = new AbortController();
+  const d = deferred<number>();
+  let calls = 0;
+  const run = runPool(
+    [
+      () => {
+        calls++;
+        return d.promise;
+      },
+      () => {
+        calls++;
+        return 1;
+      },
+    ],
+    1,
+    { retries: 3, signal: ac.signal },
+  );
+  ac.abort("stop");
+  d.reject(new Error("fail"));
+  expect(await run).toEqual([
+    { status: "rejected", reason: "stop", attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+  expect(calls).toBe(1);
+});
+
+test("a task that aborts the signal in its own body stops the next start", async () => {
+  const ac = new AbortController();
+  let calls = 0;
+  const out = await runPool(
+    [
+      () => {
+        calls++;
+        ac.abort("stop");
+        return "first";
+      },
+      () => {
+        calls++;
+        return "second";
+      },
+    ],
+    1,
+    { signal: ac.signal },
+  );
+  expect(calls).toBe(1);
+  expect(out).toEqual([
+    { status: "fulfilled", value: "first", attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("the promise resolves, and does not reject, when tasks throw, reject or return plain values", async () => {
+  const out = await runPool(
+    [
+      () => {
+        throw 1;
+      },
+      () => Promise.reject(2),
+      () => 3,
+    ],
+    2,
+    { retries: 1 },
+  );
+  expect(out.map((r) => r.status)).toEqual(["rejected", "rejected", "fulfilled"]);
+});
+
+// Seeded PRNG so a failing case can be reproduced from its seed.
+const mulberry32 = (seed: number) => () => {
+  seed |= 0;
+  seed = (seed + 0x6d2b79f5) | 0;
+  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+};
+
+type Outcome = "ok" | "plain" | "fail" | "throw";
+
+test("randomised runs keep the limit, the order and the retry counts of a sequential reference", async () => {
+  const rnd = mulberry32(12345);
+  const pick = <T>(xs: readonly T[]): T => xs[Math.floor(rnd() * xs.length)];
+  const outcomes: Outcome[] = ["ok", "plain", "fail", "throw"];
+
+  for (let c = 0; c < 200; c++) {
+    const seed = c;
+    const n = Math.floor(rnd() * 13);
+    const limit = pick([1, 2, 3, 4, Infinity]);
+    const retries = Math.floor(rnd() * 3);
+    const script = Array.from({ length: n }, () => Array.from({ length: retries + 1 }, () => pick(outcomes)));
+
+    // What a sequential run with the same scripted outcomes must produce.
+    const expected: Settled<string>[] = script.map((steps, i) => {
+      for (let t = 1; t <= retries + 1; t++) {
+        const o = steps[t - 1];
+        if (o === "ok") return { status: "fulfilled", value: `ok ${i}/${t}`, attempts: t };
+        if (o === "plain") return { status: "fulfilled", value: `plain ${i}/${t}`, attempts: t };
+        if (t === retries + 1) return { status: "rejected", reason: `${o} ${i}/${t}`, attempts: t };
+      }
+      throw new Error("unreachable");
+    });
+
+    const counts = Array(n).fill(0);
+    let finished = 0;
+    const pending: { i: number; t: number; o: Outcome; d: Deferred<string> }[] = [];
+    const tasks = script.map((_, i) => () => {
+      const t = ++counts[i];
+      const o = script[i][t - 1];
+      const isFinal = o === "ok" || o === "plain" || t > retries;
+      if (o === "throw") {
+        if (isFinal) finished++;
+        throw `throw ${i}/${t}`;
+      }
+      if (o === "plain") {
+        if (isFinal) finished++;
+        return `plain ${i}/${t}`;
+      }
+      const d = deferred<string>();
+      pending.push({ i, t, o, d });
+      return d.promise;
+    });
+
+    const run = runPool(tasks, limit, { retries });
+    const check = async (step: string) => {
+      await flush();
+      const want = Math.min(limit, n - finished);
+      expect({ seed, step, inFlight: pending.length }).toEqual({ seed, step, inFlight: want });
+    };
+    await check("start");
+    while (pending.length > 0) {
+      const k = Math.floor(rnd() * pending.length);
+      const [p] = pending.splice(k, 1);
+      const isFinal = p.o === "ok" || p.t > retries;
+      if (isFinal) finished++;
+      if (p.o === "ok") p.d.resolve(`ok ${p.i}/${p.t}`);
+      else p.d.reject(`fail ${p.i}/${p.t}`);
+      await check(`settle ${p.i}/${p.t}`);
+    }
+
+    expect({ seed, out: await run }).toEqual({ seed, out: expected });
+    expect(counts).toEqual(expected.map((r) => r.attempts));
+  }
+});
