diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.check.test.ts b/median.check.test.ts
--- a/median.check.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.check.test.ts	2026-10-30 03:23:11.817014512 +0000
@@ -0,0 +1,24 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+// Seeded LCG so the run is repeatable.
+let seed = 12345;
+const rand = () => (seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648;
+
+test('median matches a reference on random integer arrays', () => {
+  for (let i = 0; i < 500; i++) {
+    const n = 1 + Math.floor(rand() * 20);
+    const xs = Array.from({ length: n }, () => Math.floor(rand() * 101) - 50);
+    const before = [...xs];
+    const s = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(n / 2);
+    const expected = n % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+    expect(median(xs)).toBe(expected);
+    expect(xs).toEqual(before);
+  }
+});
+
+test('single element returns that element', () => {
+  expect(median([7])).toBe(7);
+  expect(median([-3])).toBe(-3);
+});
