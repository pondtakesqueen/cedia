diff -ruN '--exclude=node_modules' '--exclude=.git' a/ledger.rules.test.ts b/ledger.rules.test.ts
--- a/ledger.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.rules.test.ts	2026-10-30 03:28:22.742158198 +0000
@@ -0,0 +1,96 @@
+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+
+const call = (callId: string, tool: string, input: Record<string, unknown>, status: 'completed' | 'failed' | 'denied' | 'not_started' = 'completed', output: { isError: boolean; exitCode?: number } = { isError: false, exitCode: 0 }): SessionEvent[] => [
+  { kind: 'tool_intent', callId, tool, input },
+  { kind: 'tool_result', callId, status, output },
+];
+
+describe('matchCheck edge cases', () => {
+  test('a longer command with the check as a prefix does not match', () => {
+    expect(matchCheck('bun test; rm -rf x', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test && echo ok', ['bun test'])).toBeUndefined();
+  });
+
+  test('the first declared check that matches wins', () => {
+    expect(matchCheck('a', ['a ', 'a'])).toBe('a ');
+  });
+
+  test('cd to the working directory in other spellings', () => {
+    expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd /work/repo/. && bun test', ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd .. && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd sub && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /work/repo && cd . && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+
+  test('an empty declared check never matches', () => {
+    expect(matchCheck('', [''], cwd)).toBeUndefined();
+  });
+});
+
+describe('ledgerEntries edge cases', () => {
+  test('a result is paired only with its intent in the same request window, once', () => {
+    const [intent, result] = call('a', 'edit', { path: 'a.ts' });
+    expect(ledgerEntries([intent!, result!, result!], [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'a.ts' }]);
+  });
+
+  test('denied and not_started calls never count, even with a snapshot or as a check', () => {
+    const events: SessionEvent[] = [
+      ...call('d', 'bash', { command: 'bun test' }, 'denied', { isError: true, exitCode: 1 }),
+      { kind: 'snapshot', callId: 'd', changed: ['x.ts'] },
+      ...call('n', 'edit', { path: 'y.ts' }, 'not_started', { isError: true }),
+    ];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([]);
+  });
+
+  test('a snapshot placed before the call still names its writes; an empty snapshot writes nothing', () => {
+    const events: SessionEvent[] = [
+      { kind: 'snapshot', callId: 's', changed: ['x.ts'] },
+      ...call('s', 'bash', { command: 'sed -i x x.ts' }),
+      ...call('e', 'edit', { path: 'z.ts' }),
+      { kind: 'snapshot', callId: 'e', changed: [] },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'bash', path: 'x.ts' }]);
+  });
+
+  test('failed edits are not writes but a failed write-like bash command is', () => {
+    expect(ledgerEntries(call('f', 'edit', { path: 'a.ts' }, 'failed', { isError: true }), [])).toEqual([]);
+    expect(ledgerEntries(call('g', 'bash', { command: 'npm install' }, 'failed', { isError: true, exitCode: 1 }), [])).toEqual([
+      { kind: 'write', at: 1, tool: 'bash', command: 'npm install' },
+    ]);
+  });
+
+  test('a missing exit code comes from isError, and an explicit one wins', () => {
+    const code = (output: { isError: boolean; exitCode?: number }) => ledgerEntries(call('k', 'bash', { command: 'bun test' }, 'completed', output), ['bun test']);
+    expect(code({ isError: true })).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 1 }]);
+    expect(code({ isError: false })).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+    expect(code({ isError: true, exitCode: 0 })).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+  });
+
+  test('an edit without a path is labelled by its tool', () => {
+    const entries = ledgerEntries(call('e', 'edit', {}), []);
+    expect(entries).toEqual([{ kind: 'write', at: 1, tool: 'edit' }]);
+    expect(evidence(entries).changed).toEqual(['edit']);
+  });
+});
+
+describe('evidence and verified', () => {
+  test('verified agrees with evidence over the unverified list', () => {
+    const cases: [boolean, boolean][] = [];
+    const writes = [{ kind: 'write' as const, at: 0, tool: 'edit', path: 'a.ts' }];
+    const check = (exitCode: number) => ({ kind: 'check' as const, at: 0, command: 'bun test', exitCode });
+    for (const entries of [[], writes, [...writes, check(0)], [check(0), ...writes], [...writes, check(1)], [check(1)]]) {
+      cases.push([verified(entries, ['bun test']), evidence(entries).unverified.length === 0]);
+    }
+    for (const [v, ok] of cases) expect(v).toBe(ok);
+  });
+
+  test('a passing check after the last write verifies even if a later check fails', () => {
+    const w = { kind: 'write' as const, at: 1, tool: 'edit', path: 'a.ts' };
+    const c = (exitCode: number) => ({ kind: 'check' as const, at: 2, command: 'bun test', exitCode });
+    expect(verified([w, c(0), c(1)], ['bun test'])).toBe(true);
+  });
+});
