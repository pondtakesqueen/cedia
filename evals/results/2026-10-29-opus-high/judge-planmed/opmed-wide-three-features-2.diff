@@ -14,30 +14,84 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+/** A stored value and the time it stops being live (live while now() < expires). */
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Map insertion order is recency order: the first entry is the least recently used.
+  private readonly entries = new Map<K, Entry<V>>();
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
-  }
+  constructor(
+    private readonly capacity: number,
+    private readonly ttlMs: number,
+    private readonly now: () => number = Date.now,
+  ) {}
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return undefined;
+    if (this.now() >= entry.expires) {
+      this.remove(key, entry, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const t = this.now();
+    this.entries.delete(key);
+    this.entries.set(key, { value, expires: t + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    // Remove everything first and report afterwards, so a throwing onEvict cannot leave the cache over capacity.
+    const evicted: [K, V, EvictReason][] = [];
+    for (const [k, e] of [...this.entries]) {
+      if (t < e.expires) continue;
+      this.entries.delete(k);
+      evicted.push([k, e.value, 'expired']);
+    }
+    for (const [k, e] of [...this.entries]) {
+      if (this.entries.size <= this.capacity) break;
+      this.entries.delete(k);
+      evicted.push([k, e.value, 'capacity']);
+    }
+    // Report every removal even if one callback throws; rethrow the first error at the end.
+    let failure: { error: unknown } | undefined;
+    for (const [k, v, reason] of evicted) {
+      try {
+        this.onEvict?.(k, v, reason);
+      } catch (error) {
+        failure ??= { error };
+      }
+    }
+    if (failure) throw failure.error;
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return false;
+    const live = this.now() < entry.expires;
+    this.remove(key, entry, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    const t = this.now();
+    let n = 0;
+    for (const e of this.entries.values()) if (t < e.expires) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
+    return [...this.entries].filter(([, e]) => t < e.expires).map(([k]) => k).reverse();
+  }
+
+  /** Removes the entry before reporting it, so a throwing onEvict leaves the cache consistent. */
+  private remove(key: K, entry: Entry<V>, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, entry.value, reason);
   }
 }
