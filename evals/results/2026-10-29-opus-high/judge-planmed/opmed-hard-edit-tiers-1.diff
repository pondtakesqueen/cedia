diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-30 03:18:48.502171332 +0000
@@ -0,0 +1,130 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const SRC = 'function f() {\n    if (a) {\n        return 1;  \n    }\n}\n';
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+const errorOf = (r: ReturnType<typeof applyEdit>) => ('error' in r ? r.error : '');
+
+describe('validation order', () => {
+  test('empty old_text is reported before same-text', () => {
+    expect(errorOf(applyEdit('a', { old_text: '', new_text: '' }))).toContain('use write');
+  });
+  test('identical old and new text is an error', () => {
+    expect(errorOf(applyEdit('a\n', { old_text: 'a', new_text: 'a' }))).toContain('same');
+  });
+});
+
+describe('exact tier', () => {
+  test('exact wins over the line tiers', () => {
+    const r = ok(applyEdit('b\na  \n', { old_text: 'b\n', new_text: 'c\n' }));
+    expect(r.applied.tier).toBe('exact');
+    expect(r.content).toBe('c\na  \n');
+  });
+  test('several matches report the count and first line', () => {
+    const e = errorOf(applyEdit('q\nx\nx\n', { old_text: 'x', new_text: 'z' }));
+    expect(e).toContain('matches 2 places');
+    expect(e).toContain('line 2');
+  });
+  test('replace_all reports count and spans first to last match', () => {
+    const r = ok(applyEdit('x\ny\nx\n', { old_text: 'x', new_text: 'z', replace_all: true }));
+    expect(r.applied).toEqual({ from: 1, to: 3, tier: 'exact', count: 2 });
+  });
+  test('overlapping occurrences are counted once each, non-overlapping', () => {
+    const r = ok(applyEdit('aaa', { old_text: 'aa', new_text: 'b', replace_all: true }));
+    expect(r.content).toBe('ba');
+    expect(r.applied.count).toBe(1);
+  });
+  test('$ patterns in new_text are inserted literally', () => {
+    const r = ok(applyEdit('x', { old_text: 'x', new_text: '$&$1' }));
+    expect(r.content).toBe('$&$1');
+  });
+  test("to does not count old_text's trailing newline", () => {
+    const r = ok(applyEdit('a\nb\n', { old_text: 'a\n', new_text: 'z\n' }));
+    expect(r.applied).toEqual({ from: 1, to: 1, tier: 'exact', count: 1 });
+  });
+  test('replace_all does not apply to the line tiers', () => {
+    const e = errorOf(applyEdit('a \nb\na \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }));
+    expect(e).toContain('matches 2 places');
+  });
+});
+
+describe('trailing-space tier', () => {
+  test('new_text lines are used as given', () => {
+    const r = ok(applyEdit('  a \n  b\n', { old_text: '  a\n  b', new_text: 'x\ny' }));
+    expect(r.content).toBe('x\ny\n');
+    expect(r.applied.tier).toBe('trailing-space');
+  });
+  test('empty new_text deletes, and deleting every line gives empty content', () => {
+    const r = ok(applyEdit('a \nb\n', { old_text: 'a\nb', new_text: '' }));
+    expect(r.content).toBe('');
+  });
+  test('no trailing newline in content stays that way', () => {
+    const r = ok(applyEdit('a \nb', { old_text: 'a\nb', new_text: 'c' }));
+    expect(r.content).toBe('c');
+  });
+});
+
+describe('indentation tier', () => {
+  test('several matches list their lines', () => {
+    const e = errorOf(applyEdit(' a\n b\n\ta\n\tb\n', { old_text: 'a\nb', new_text: 'c' }));
+    expect(e).toContain('matches 2 places');
+    expect(e).toContain('1, 3');
+  });
+  test('a new_text line less indented than old_text gets the file indent', () => {
+    const r = ok(applyEdit('    a\n    b\n', { old_text: '  a\n  b', new_text: '  a\nb' }));
+    expect(r.content).toBe('    a\n    b\n');
+  });
+  test('from and to cover the matched lines', () => {
+    const r = ok(applyEdit('x\n\ta\n\tb\n', { old_text: 'a\nb', new_text: 'c' }));
+    expect(r.applied).toEqual({ from: 2, to: 3, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('x\n\tc\n');
+  });
+});
+
+describe('not found', () => {
+  test('lists at most 5 lines where the first line appears', () => {
+    const e = errorOf(applyEdit('xx\n'.repeat(7), { old_text: 'xx\nnope', new_text: 'y' }));
+    expect(e).toContain('line 1, 2, 3, 4, 5');
+    expect(e).not.toContain(', 6');
+  });
+  test('pointer uses the first non-blank trimmed line of old_text', () => {
+    const e = errorOf(applyEdit(SRC, { old_text: '\n   if (a) {\nzzz', new_text: 'y' }));
+    expect(e).toContain('first line appears at line 2');
+  });
+  test('empty content does not throw', () => {
+    expect(errorOf(applyEdit('', { old_text: 'a', new_text: 'b' }))).toContain('not found');
+  });
+});
+
+describe('agrees with String.replace and split on exact matches', () => {
+  let seed = 1;
+  const rand = (n: number) => {
+    seed = (Math.imul(seed, 1103515245) + 12345) >>> 0;
+    return (seed >>> 16) % n;
+  };
+  const pick = (alphabet: string, min: number, max: number) => {
+    let s = '';
+    const len = min + rand(max - min + 1);
+    for (let k = 0; k < len; k++) s += alphabet[rand(alphabet.length)];
+    return s;
+  };
+  test('random exact edits match the reference', () => {
+    for (let iter = 0; iter < 500; iter++) {
+      const content = pick('ab\n ', 0, 30);
+      const old = pick('ab\n', 1, 3);
+      const neu = pick('abc\n', 0, 3);
+      if (old === neu || !content.includes(old)) continue;
+      const all = ok(applyEdit(content, { old_text: old, new_text: neu, replace_all: true }));
+      expect(all.content).toBe(content.split(old).join(neu));
+      expect(all.applied.count).toBe(content.split(old).length - 1);
+      expect(all.applied.tier).toBe('exact');
+      if (content.split(old).length === 2) {
+        const one = ok(applyEdit(content, { old_text: old, new_text: neu }));
+        expect(one.content).toBe(content.replace(old, () => neu));
+      }
+    }
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-30 03:16:32.360289962 +0000
+++ b/edit.ts	2026-10-30 03:18:39.554959120 +0000
@@ -23,5 +23,106 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text, new_text, replace_all } = edit;
+  if (old_text === '') return { error: 'old_text is empty; use write to create or replace a file' };
+  if (old_text === new_text) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  // exact: non-overlapping occurrences, as String.split finds them
+  const exactStarts: number[] = [];
+  for (let i = content.indexOf(old_text); i !== -1; i = content.indexOf(old_text, i + old_text.length)) exactStarts.push(i);
+  if (exactStarts.length > 1 && !replace_all) {
+    return { error: `old_text matches ${exactStarts.length} places (first at line ${lineOf(content, exactStarts[0])}); add context or set replace_all` };
+  }
+  if (exactStarts.length > 0) {
+    let out = '';
+    let pos = 0;
+    for (const i of exactStarts) {
+      out += content.slice(pos, i) + new_text;
+      pos = i + old_text.length;
+    }
+    out += content.slice(pos);
+    const last = exactStarts[exactStarts.length - 1];
+    return {
+      content: out,
+      applied: { from: lineOf(content, exactStarts[0]), to: lineOf(content, last + old_text.length - 1), tier: 'exact', count: exactStarts.length },
+    };
+  }
+
+  // line tiers: a single trailing newline on old_text and new_text is not a line
+  const trailing = content.endsWith('\n');
+  const lines = (trailing ? content.slice(0, -1) : content).split('\n');
+  const oldLines = stripNewline(old_text).split('\n');
+  const newText = stripNewline(new_text);
+  const newLines = newText === '' ? [] : newText.split('\n');
+
+  const trailingStarts = findWindows(lines, oldLines, s => s.trimEnd());
+  if (trailingStarts.length > 1) {
+    return { error: `old_text matches ${trailingStarts.length} places ignoring trailing whitespace (lines ${trailingStarts.map(i => i + 1).join(', ')}); add context` };
+  }
+  if (trailingStarts.length === 1) {
+    const i = trailingStarts[0];
+    return {
+      content: spliceLines(lines, i, oldLines.length, newLines, trailing),
+      applied: { from: i + 1, to: i + oldLines.length, tier: 'trailing-space', count: 1 },
+    };
+  }
+
+  const indentStarts = findWindows(lines, oldLines, s => s.trim());
+  if (indentStarts.length > 1) {
+    return { error: `old_text matches ${indentStarts.length} places ignoring indentation (lines ${indentStarts.map(i => i + 1).join(', ')}); add context` };
+  }
+  if (indentStarts.length === 1) {
+    const i = indentStarts[0];
+    const oldIndent = indentOf(oldLines);
+    const fileIndent = indentOf(lines.slice(i, i + oldLines.length));
+    const reindented = newLines.map(l => {
+      if (l.trim() === '') return l;
+      return l.startsWith(oldIndent) ? fileIndent + l.slice(oldIndent.length) : fileIndent + l.trimStart();
+    });
+    return {
+      content: spliceLines(lines, i, oldLines.length, reindented, trailing),
+      applied: { from: i + 1, to: i + oldLines.length, tier: 'indentation', count: 1 },
+    };
+  }
+
+  // nothing matched: point at the first non-blank line of old_text where it occurs
+  const first = oldLines.find(l => l.trim() !== '')?.trim();
+  const hits: number[] = [];
+  if (first) {
+    for (let i = 0; i < lines.length && hits.length < 5; i++) {
+      if (lines[i].includes(first)) hits.push(i + 1);
+    }
+  }
+  return { error: 'old_text not found' + (hits.length > 0 ? `; first line appears at line ${hits.join(', ')}` : '') };
+}
+
+// 1-based line number of the character at `index`.
+function lineOf(content: string, index: number): number {
+  return content.slice(0, index).split('\n').length;
+}
+
+// Removes one trailing newline.
+function stripNewline(s: string): string {
+  return s.endsWith('\n') ? s.slice(0, -1) : s;
+}
+
+// Leading whitespace of the first non-blank line, or '' when there is none.
+function indentOf(lines: string[]): string {
+  const first = lines.find(l => l.trim() !== '');
+  return first === undefined ? '' : first.slice(0, first.length - first.trimStart().length);
+}
+
+// Start indexes of every run of lines equal to oldLines under `norm`; overlapping runs each count.
+function findWindows(lines: string[], oldLines: string[], norm: (s: string) => string): number[] {
+  const starts: number[] = [];
+  for (let i = 0; i + oldLines.length <= lines.length; i++) {
+    if (oldLines.every((o, j) => norm(lines[i + j]) === norm(o))) starts.push(i);
+  }
+  return starts;
+}
+
+// Replaces lines[start, start + count) with newLines and joins the file back, keeping a trailing newline if there was one.
+function spliceLines(lines: string[], start: number, count: number, newLines: string[], trailing: boolean): string {
+  const out = [...lines.slice(0, start), ...newLines, ...lines.slice(start + count)];
+  return out.join('\n') + (trailing && out.length > 0 ? '\n' : '');
 }
