 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+
+/** Unit sizes in ms, largest first; formatDuration walks this order. */
+const UNITS: [string, number][] = [
+  ['d', 86_400_000],
+  ['h', 3_600_000],
+  ['m', 60_000],
+  ['s', 1000],
+  ['ms', 1],
+];
+const SIZE: Record<string, number> = Object.fromEntries(UNITS);
+
+/** One <number><unit> part, optionally preceded by spaces; sticky so the parts must be contiguous. */
+const PART = /\s*(\d+(?:\.\d+)?)(ms|d|h|m|s)/y;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  const bad = () => new Error(`invalid duration: "${text}"`);
+  if (s === '') throw bad();
+  let total = 0;
+  let pos = 0;
+  while (pos < s.length) {
+    PART.lastIndex = pos;
+    const m = PART.exec(s);
+    if (!m) throw bad();
+    total += Number(m[1]) * SIZE[m[2]];
+    pos = PART.lastIndex;
+  }
+  if (!Number.isFinite(total)) throw bad();
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration: ${ms}`);
+  let rem = Math.round(ms);
+  let out = '';
+  for (const [unit, size] of UNITS) {
+    const q = Math.floor(rem / size);
+    if (q > 0) {
+      out += `${q}${unit}`;
+      rem -= q * size;
+    }
+  }
+  return out || '0s';
 }
