 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+/** A stored value and the time from which it is expired. */
+interface Entry<V> {
+  value: V;
+  expiresAt: number;
+}
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Insertion order is recency order: the first key is the least recently used.
+  private entries = new Map<K, Entry<V>>();
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
 
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const t = this.now();
+    const entry = this.entries.get(key);
+    if (!entry) return undefined;
+    this.entries.delete(key);
+    if (t >= entry.expiresAt) {
+      this.onEvict?.(key, entry.value, 'expired');
+      return undefined;
+    }
+    this.entries.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const t = this.now();
+    this.entries.delete(key);
+    this.entries.set(key, { value, expiresAt: t + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, e] of this.entries) {
+      if (t >= e.expiresAt) {
+        this.entries.delete(k);
+        this.onEvict?.(k, e.value, 'expired');
+      }
+    }
+    while (this.entries.size > this.capacity) {
+      const [k, e] = this.entries.entries().next().value as [K, Entry<V>];
+      this.entries.delete(k);
+      this.onEvict?.(k, e.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return false;
+    const t = this.now();
+    this.entries.delete(key);
+    if (t >= entry.expiresAt) {
+      this.onEvict?.(key, entry.value, 'expired');
+      return false;
+    }
+    this.onEvict?.(key, entry.value, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    const t = this.now();
+    let n = 0;
+    for (const e of this.entries.values()) if (t < e.expiresAt) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
+    const live: K[] = [];
+    for (const [k, e] of this.entries) if (t < e.expiresAt) live.push(k);
+    return live.reverse();
   }
 }
