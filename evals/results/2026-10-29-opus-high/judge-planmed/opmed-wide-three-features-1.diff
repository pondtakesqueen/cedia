+++ b/src/slug.ts	2026-10-30 03:43:26.734137522 +0000
@@ -11,10 +11,24 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const slug = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || slug.length <= max) return slug;
+  const cut = slug.lastIndexOf('-', max);
+  return cut > 0 ? slug.slice(0, cut) : slug.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 03:43:22.990137607 +0000
@@ -0,0 +1,92 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+// Seeded xorshift32 so the random cases are the same on every run.
+function rng(seed: number): () => number {
+  let x = seed | 0;
+  return () => {
+    x ^= x << 13;
+    x ^= x >>> 17;
+    x ^= x << 5;
+    return (x >>> 0) / 4294967296;
+  };
+}
+
+test('parts may be separated by spaces', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('1h  30m')).toBe(5_400_000);
+});
+
+test('spaces around the whole text are ignored', () => {
+  expect(parseDuration('  90s ')).toBe(90_000);
+  expect(parseDuration('\t1m\n')).toBe(60_000);
+});
+
+test('units d, h, m, s, ms; ms is not m', () => {
+  expect(parseDuration('1d')).toBe(86_400_000);
+  expect(parseDuration('1h')).toBe(3_600_000);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('1s')).toBe(1_000);
+  expect(parseDuration('250ms')).toBe(250);
+});
+
+test('numbers may have a fraction', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+});
+
+test('the result is rounded to a whole number, once, on the total', () => {
+  expect(parseDuration('1.0004s')).toBe(1000);
+  expect(parseDuration('0.0006s')).toBe(1);
+  expect(parseDuration('0.4ms0.4ms')).toBe(1);
+});
+
+test('anything else throws with the input in the message', () => {
+  for (const input of ['', '   ', '10', '5x', 'h', '-1s', '5 s', '1H', '.5h', '1.h', '1e3s', '1s,']) {
+    expect(() => parseDuration(input)).toThrow(`"${input}"`);
+  }
+});
+
+test('format: largest unit first, zero parts left out, no spaces', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(86_400_001)).toBe('1d1ms');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(3_600_000)).toBe('1h');
+});
+
+test('format: 0 gives 0s, and -0 too', () => {
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(-0)).toBe('0s');
+});
+
+test('format throws on a negative or non-finite number', () => {
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(-0.5)).toThrow();
+  expect(() => formatDuration(Number.NaN)).toThrow();
+  expect(() => formatDuration(Number.POSITIVE_INFINITY)).toThrow();
+});
+
+test('parse and format agree', () => {
+  for (let n = 0; n <= 2000; n++) expect(parseDuration(formatDuration(n))).toBe(n);
+  const next = rng(42);
+  for (let i = 0; i < 500; i++) {
+    const n = Math.floor(next() * 1e10);
+    expect(parseDuration(formatDuration(n))).toBe(n);
+  }
+});
+
+test('joined random parts parse to their hand-computed sum', () => {
+  const units: [string, number][] = [['d', 86_400_000], ['h', 3_600_000], ['m', 60_000], ['s', 1_000], ['ms', 1]];
+  const next = rng(7);
+  for (let i = 0; i < 300; i++) {
+    let text = '';
+    let sum = 0;
+    const parts = 1 + Math.floor(next() * 5);
+    for (let p = 0; p < parts; p++) {
+      const [unit, ms] = units[Math.floor(next() * units.length)];
+      const n = Math.floor(next() * 500);
+      text += `${n}${unit}` + (next() < 0.5 ? '' : ' '.repeat(1 + Math.floor(next() * 2)));
+      sum += n * ms;
+    }
+    expect(parseDuration(text)).toBe(sum);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 03:44:03.458136682 +0000
@@ -0,0 +1,230 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+// Seeded xorshift32 so the random cases are the same on every run.
+function rng(seed: number): () => number {
+  let x = seed | 0;
+  return () => {
+    x ^= x << 13;
+    x ^= x >>> 17;
+    x ^= x << 5;
+    return (x >>> 0) / 4294967296;
+  };
+}
+
+function record<K, V>(cache: LRU<K, V>): string[] {
+  const log: string[] = [];
+  cache.onEvict = (key, value, reason) => log.push(`${key}:${String(value)}:${reason}`);
+  return log;
+}
+
+test('a hit makes the entry the most recently used', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = record(cache);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(cache.keys()).toEqual(['c', 'a']);
+  expect(log).toEqual(['b:2:capacity']);
+});
+
+test('a hit does not refresh the ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.set('a', 1);
+  t = 500;
+  expect(cache.get('a')).toBe(1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('an expired entry is removed when found, once', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = record(cache);
+  cache.set('a', 1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.get('a')).toBeUndefined();
+  expect(log).toEqual(['a:1:expired']);
+});
+
+test('set refreshes the ttl and the recency, with no eviction call', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = record(cache);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  t = 900;
+  cache.set('a', 3);
+  t = 1500;
+  expect(cache.get('a')).toBe(3);
+  expect(cache.keys()).toEqual(['a']);
+  expect(log).toEqual([]);
+});
+
+test('capacity counts expired entries, and expired go first', () => {
+  let t = 0;
+  const cache = new LRU<string, string>(2, 1000, () => t);
+  const log = record(cache);
+  cache.set('a', 'a');
+  t = 1000;
+  cache.set('b', 'b');
+  expect(log).toEqual([]);
+  expect(cache.size).toBe(1);
+  cache.set('c', 'c');
+  expect(log).toEqual(['a:a:expired']);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('a live entry is evicted only when still over capacity', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(1, 1000, () => t);
+  const log = record(cache);
+  cache.set('old', 1);
+  t = 10;
+  cache.set('new', 2);
+  expect(log).toEqual(['old:1:capacity']);
+  expect(cache.keys()).toEqual(['new']);
+});
+
+test('capacity 0 evicts the new entry at once', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(0, 1000, () => t);
+  const log = record(cache);
+  cache.set('a', 1);
+  expect(log).toEqual(['a:1:capacity']);
+  expect(cache.size).toBe(0);
+});
+
+test('ttl 0: the new entry is expired at once and swept when over capacity', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(1, 0, () => t);
+  const log = record(cache);
+  cache.set('a', 1);
+  expect(log).toEqual([]);
+  cache.set('b', 2);
+  expect(log).toEqual(['a:1:expired', 'b:2:expired']);
+  expect(cache.size).toBe(0);
+});
+
+test('delete on a live entry returns true with reason delete', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = record(cache);
+  cache.set('a', 1);
+  expect(cache.delete('a')).toBe(true);
+  expect(log).toEqual(['a:1:delete']);
+  expect(cache.size).toBe(0);
+});
+
+test('delete on an expired entry returns false with reason expired; missing gives false and no call', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const log = record(cache);
+  cache.set('a', 1);
+  t = 1000;
+  expect(cache.delete('a')).toBe(false);
+  expect(cache.delete('zz')).toBe(false);
+  expect(log).toEqual(['a:1:expired']);
+});
+
+test('size counts only live entries and drops at expiry without a get', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const log = record(cache);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  expect(cache.size).toBe(2);
+  t = 1000;
+  expect(cache.size).toBe(1);
+  expect(log).toEqual([]);
+});
+
+test('keys returns live keys, most recently used first', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 600;
+  cache.set('b', 2);
+  cache.set('c', 3);
+  t = 1200;
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('an entry set at t is live while now() < t + ttl', () => {
+  let t = 100;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  cache.set('a', 1);
+  t = 1099;
+  expect(cache.get('a')).toBe(1);
+  t = 1100;
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('agrees with a naive model over random operations', () => {
+  let t = 0;
+  const cap = 3;
+  const ttl = 1000;
+  const cache = new LRU<string, number>(cap, ttl, () => t);
+  const log = record(cache);
+  const expectedLog: string[] = [];
+  // Model: array ordered least to most recently used.
+  let model: { key: string; value: number; expiresAt: number }[] = [];
+  const live = (e: { expiresAt: number }) => t < e.expiresAt;
+  const remove = (key: string) => {
+    const i = model.findIndex((e) => e.key === key);
+    if (i < 0) return undefined;
+    return model.splice(i, 1)[0];
+  };
+  const next = rng(2026);
+  const keyNames = ['a', 'b', 'c', 'd', 'e'];
+  for (let i = 0; i < 2000; i++) {
+    const op = next();
+    const key = keyNames[Math.floor(next() * keyNames.length)];
+    if (op < 0.3) {
+      const value = Math.floor(next() * 100);
+      remove(key);
+      model.push({ key, value, expiresAt: t + ttl });
+      if (model.length > cap) {
+        for (const e of model.filter((x) => !live(x))) expectedLog.push(`${e.key}:${e.value}:expired`);
+        model = model.filter(live);
+        while (model.length > cap) {
+          const e = model.shift()!;
+          expectedLog.push(`${e.key}:${e.value}:capacity`);
+        }
+      }
+      cache.set(key, value);
+    } else if (op < 0.6) {
+      const e = remove(key);
+      let expected: number | undefined;
+      if (e) {
+        if (live(e)) {
+          model.push(e);
+          expected = e.value;
+        } else {
+          expectedLog.push(`${e.key}:${e.value}:expired`);
+        }
+      }
+      expect(cache.get(key)).toBe(expected);
+    } else if (op < 0.75) {
+      const e = remove(key);
+      let expected = false;
+      if (e) {
+        expected = live(e);
+        expectedLog.push(`${e.key}:${e.value}:${expected ? 'delete' : 'expired'}`);
+      }
+      expect(cache.delete(key)).toBe(expected);
+    } else if (op < 0.85) {
+      expect(cache.size).toBe(model.filter(live).length);
+    } else if (op < 0.9) {
+      expect(cache.keys()).toEqual(model.filter(live).map((e) => e.key).reverse());
+    } else {
+      t += Math.floor(next() * 401);
+    }
+  }
+  expect(log).toEqual(expectedLog);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 03:43:34.298137349 +0000
@@ -0,0 +1,105 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+// Seeded xorshift32 so the random cases are the same on every run.
+function rng(seed: number): () => number {
+  let x = seed | 0;
+  return () => {
+    x ^= x << 13;
+    x ^= x >>> 17;
+    x ^= x << 5;
+    return (x >>> 0) / 4294967296;
+  };
+}
+
+// Reference for max: keep whole '-' segments while they fit; if the first one does not fit, cut at max.
+function reference(full: string, max: number): string {
+  const segs = full.split('-');
+  if (segs[0].length > max) return full.slice(0, max);
+  let out = segs[0];
+  for (const seg of segs.slice(1)) {
+    if (out.length + 1 + seg.length > max) break;
+    out += '-' + seg;
+  }
+  return out;
+}
+
+test('lower case', () => {
+  expect(slugify('ABC')).toBe('abc');
+});
+
+test('diacritics are removed', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('Crème brûlée')).toBe('creme-brulee');
+});
+
+test('special letters', () => {
+  expect(slugify('ß æ œ ø ł đ')).toBe('ss-ae-oe-o-l-d');
+  expect(slugify('ÆØŁĐ')).toBe('aeold');
+  expect(slugify('ẞ')).toBe('ss');
+});
+
+test('dotted capital I loses its dot', () => {
+  expect(slugify('İ')).toBe('i');
+});
+
+test('other characters are separators; runs become one "-"; none at the ends', () => {
+  expect(slugify('  --a__b!!  ')).toBe('a-b');
+  expect(slugify('a_b')).toBe('a-b');
+  expect(slugify('a😀b')).toBe('a-b');
+  expect(slugify('---')).toBe('');
+  expect(slugify('')).toBe('');
+});
+
+test('characters with no ASCII form are dropped as separators', () => {
+  expect(slugify('ð')).toBe('');
+});
+
+test('max cuts at the last "-" within max', () => {
+  expect(slugify('hello-big-world', 10)).toBe('hello-big');
+});
+
+test('a "-" right after max counts', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+});
+
+test('with no "-" to cut at, cut at max', () => {
+  expect(slugify('abcdef', 3)).toBe('abc');
+});
+
+test('a "-" that would leave a longer first word cuts to max', () => {
+  expect(slugify('ab-cdefgh', 5)).toBe('ab');
+});
+
+test('max 0 gives an empty slug', () => {
+  expect(slugify('abc', 0)).toBe('');
+});
+
+test('a slug within max is unchanged', () => {
+  expect(slugify('ab', 5)).toBe('ab');
+  expect(slugify('ab', 2)).toBe('ab');
+});
+
+test('agrees with the reference on random strings', () => {
+  const alphabet = 'ab -_éß';
+  const next = rng(99);
+  for (let i = 0; i < 300; i++) {
+    let text = '';
+    const len = Math.floor(next() * 16);
+    for (let k = 0; k < len; k++) text += alphabet[Math.floor(next() * alphabet.length)];
+    const full = slugify(text);
+    for (let max = 0; max <= 12; max++) {
+      const got = slugify(text, max);
+      expect(got).toBe(reference(full, max));
+      expect(got.length).toBeLessThanOrEqual(max);
+      expect(got).toMatch(/^([a-z0-9]+(-[a-z0-9]+)*)?$/);
+    }
+  }
+});
+
+test('uniqueSlug returns the first free one and does not change taken', () => {
+  const taken = new Set(['post', 'post-2', 'post-4']);
+  expect(uniqueSlug('post', taken)).toBe('post-3');
+  expect(uniqueSlug('other', taken)).toBe('other');
+  expect([...taken]).toEqual(['post', 'post-2', 'post-4']);
+});
