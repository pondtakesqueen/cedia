 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+// Keeps one Map from key to { value, expiresAt }, ordered from least to most recently used: recency moves by
+// deleting and re-inserting the key.
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  private map = new Map<K, { value: V; expiresAt: number }>();
+  private capacity: number;
+  private ttlMs: number;
+  private now: () => number;
 
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const t = this.now();
+    const entry = this.map.get(key);
+    if (!entry) return undefined;
+    this.map.delete(key);
+    if (!(t < entry.expiresAt)) {
+      this.onEvict?.(key, entry.value, 'expired');
+      return undefined;
+    }
+    this.map.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const t = this.now();
+    this.map.delete(key);
+    this.map.set(key, { value, expiresAt: t + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    for (const [k, e] of this.map) {
+      if (!(t < e.expiresAt)) {
+        this.map.delete(k);
+        this.onEvict?.(k, e.value, 'expired');
+      }
+    }
+    while (this.map.size > this.capacity) {
+      const [k, e] = this.map.entries().next().value!;
+      this.map.delete(k);
+      this.onEvict?.(k, e.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const t = this.now();
+    const entry = this.map.get(key);
+    if (!entry) return false;
+    this.map.delete(key);
+    const live = t < entry.expiresAt;
+    this.onEvict?.(key, entry.value, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    const t = this.now();
+    let n = 0;
+    for (const e of this.map.values()) if (t < e.expiresAt) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
+    const live: K[] = [];
+    for (const [k, e] of this.map) if (t < e.expiresAt) live.push(k);
+    return live.reverse();
   }
 }
