diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-30 03:16:02.862175121 +0000
@@ -0,0 +1,69 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const name = (argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('git path and global options', () => {
+  expect(name(['/usr/bin/git', 'push', '-f'])).toBe('force-push');
+  for (const opt of ['-C x', '-c a=b', '--git-dir d', '--work-tree w', '--namespace n', '--git-dir=d']) {
+    expect([opt, name(['git', ...opt.split(' '), 'push', '-f'])]).toEqual([opt, 'force-push']);
+    expect([opt, name(['git', ...opt.split(' '), 'push', 'origin', 'feat'])]).toEqual([opt, undefined]);
+  }
+  expect(name(['git', '-C'])).toBeUndefined();
+});
+
+test('force-push flags and refspecs', () => {
+  for (const flag of ['--force', '--force=1', '--force-with-lease', '--mirror', '--delete', '--prune', '-d', '-f', '-uf', '-df', '+x', ':x'])
+    expect([flag, name(['git', 'push', flag])]).toEqual([flag, 'force-push']);
+  for (const flag of ['-u', '-v', '--forceful'])
+    expect([flag, name(['git', 'push', flag])]).toEqual([flag, undefined]);
+});
+
+test('reset and clean forms', () => {
+  expect(name(['git', 'reset', '--mixed'])).toBeUndefined();
+  for (const flags of [['-f'], ['-xf'], ['--force'], ['-fn']]) expect([flags, name(['git', 'clean', ...flags])]).toEqual([flags, 'clean-force']);
+  for (const flags of [['-f', '-n'], ['-f', '--dry-run'], ['-n', '-f']]) expect([flags, name(['git', 'clean', ...flags])]).toEqual([flags, undefined]);
+});
+
+test('rm recursive forms and -- split', () => {
+  for (const flags of [['-r'], ['-R'], ['-fR'], ['--recursive']]) expect([flags, name(['rm', ...flags, '/etc'])]).toEqual([flags, 'rm-outside']);
+  expect(name(['rm', '-f', '/etc'])).toBeUndefined();
+  expect(name(['rm', '-rf', '--', ''])).toBe('rm-outside');
+  expect(name(['rm', '-rf', '--'])).toBe('rm-outside');
+});
+
+test('unresolvable targets', () => {
+  for (const t of ['$X', 'a$b', '~bob', '~bob/x']) expect([t, name(['rm', '-rf', t])]).toEqual([t, 'rm-outside']);
+  expect(name(['rm', '-rf', '~/x'])).toBe('rm-outside'); // home is outside /work/repo
+});
+
+test('find start paths', () => {
+  for (const argv of [['find', '/', '-exec', 'rm', '{}', ';'], ['find', 'src', '..', '-execdir', 'rm', '{}', ';'], ['find', '$D', '-delete']])
+    expect([argv, name(argv)]).toEqual([argv, 'rm-outside']);
+  expect(name(['find', '/', '-print'])).toBeUndefined();
+});
+
+test('never throws on malformed argv', () => {
+  for (const argv of [[], [''], ['git'], ['git', '-C'], ['rm'], ['find']]) expect(name(argv)).toBeUndefined();
+  expect(name(['rm', '-r'])).toBe('rm-outside');
+});
+
+test('rm decision agrees with the path helpers', () => {
+  const targets = ['.', './', '..', '/', '~', '~/x', '/work/repo', '/work/repo/b', '/work/repo/../x', 'src', 'src/../..', '*', '../*', '$D', '~u'];
+  const flagSets = [['-rf'], ['-r', '-f'], ['-fr'], ['--recursive'], ['-rf', '--']];
+  for (const t of targets) {
+    const bad = t.includes('$') || /^~[^/]/.test(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd);
+    for (const flags of flagSets) {
+      const want = bad ? 'rm-outside' : undefined;
+      expect([flags, t, name(['rm', ...flags, t])]).toEqual([flags, t, want]);
+    }
+    const fbad = t.includes('$') || /^~[^/]/.test(t) || !insideWorkspace(t, cwd);
+    expect([t, name(['find', t, '-delete'])]).toEqual([t, fbad ? 'rm-outside' : undefined]);
+  }
+});
+
+test('hit reasons name the trigger', () => {
+  expect(denyListed(['git', 'push', '--mirror'], cwd)?.reason).toContain('--mirror');
+  expect(denyListed(['rm', '-rf', '/etc'], cwd)?.reason).toContain('/etc');
+});
