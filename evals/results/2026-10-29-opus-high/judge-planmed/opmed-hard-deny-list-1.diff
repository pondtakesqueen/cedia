 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+// A short flag group such as -f or -fu.
+const group = (w: string) => /^-[^-]/.test(w);
+// A path the guard cannot resolve before the command runs: $VAR, or ~user.
+const unresolvable = (p: string) => p.includes('$') || /^~[^/]/.test(p);
+// git global options that take the next word as their value.
+const GIT_VALUE_OPTS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+
+function git(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += GIT_VALUE_OPTS.has(args[i]) ? 2 : 1;
+  const [sub, ...rest] = args.slice(i);
+  if (sub === 'push') {
+    const w = rest.find((w) => /^--(force|force-with-lease|mirror|delete|prune)(=|$)/.test(w) || (group(w) && /[fd]/.test(w)) || /^[+:]/.test(w));
+    return w === undefined ? undefined : { name: 'force-push', reason: `git push ${w} rewrites or deletes remote history` };
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards uncommitted changes' };
+  if (sub === 'clean') {
+    const force = rest.some((w) => w === '--force' || (group(w) && w.includes('f')));
+    const dry = rest.some((w) => w === '-n' || w === '--dry-run');
+    if (force && !dry) return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  }
+  return undefined;
+}
+
+function rm(args: string[], cwd: string): Hit | undefined {
+  let recursive = false;
+  let afterDashDash = false;
+  const targets: string[] = [];
+  for (const w of args) {
+    if (afterDashDash) targets.push(w);
+    else if (w === '--') afterDashDash = true;
+    else if (w.startsWith('-')) recursive ||= w === '--recursive' || (group(w) && /[rR]/.test(w));
+    else targets.push(w);
+  }
+  if (!recursive) return undefined;
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets (they may come from xargs)' };
+  const bad = targets.find((t) => unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `rm -r ${bad} is outside the working directory, cwd itself, or unresolvable` };
+}
+
+function find(args: string[], cwd: string): Hit | undefined {
+  if (!args.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const starts = args.slice(0, args.findIndex((w) => w.startsWith('-')));
+  const bad = (starts.length ? starts : ['.']).find((p) => unresolvable(p) || !insideWorkspace(p, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `find ${bad} deletes or runs commands outside the working directory` };
+}
