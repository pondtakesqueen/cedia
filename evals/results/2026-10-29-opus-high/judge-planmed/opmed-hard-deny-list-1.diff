diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-30 03:15:27.234175936 +0000
@@ -0,0 +1,85 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('git path and global options', () => {
+  expect(hit('/usr/local/bin/git reset --hard')).toBe('reset-hard');
+  expect(hit('git -C push status')).toBeUndefined();
+  expect(hit('git -C')).toBeUndefined();
+  expect(hit('git --work-tree w --namespace n push -f')).toBe('force-push');
+  expect(hit('git --git-dir=.git push -f')).toBe('force-push');
+});
+
+test('push long flags, short groups, refspecs', () => {
+  for (const line of ['git push --mirror=x', 'git push --prune', 'git push -uf', 'git push -df', 'git push origin +HEAD:main'])
+    expect([line, hit(line)]).toEqual([line, 'force-push']);
+  for (const line of ['git push --forced', 'git push --force-if-includes', 'git push -u', 'git push -q'])
+    expect([line, hit(line)]).toEqual([line, undefined]);
+});
+
+test('reset and clean variants', () => {
+  for (const line of ['git reset --mixed', 'git reset']) expect([line, hit(line)]).toEqual([line, undefined]);
+  expect(hit('git clean -xf')).toBe('clean-force');
+  expect(hit('git clean -nf')).toBe('clean-force');
+  expect(hit('git clean --force --dry-run')).toBeUndefined();
+});
+
+test('rm recursive flags and targets', () => {
+  expect(hit('rm -f /')).toBeUndefined();
+  expect(hit('rm /etc/passwd')).toBeUndefined();
+  expect(hit('rm --recursive /')).toBe('rm-outside');
+  expect(hit('rm -r -- -- /etc')).toBe('rm-outside');
+  expect(hit('rm -r --')).toBe('rm-outside');
+  expect(hit('rm -r a$b')).toBe('rm-outside');
+  expect(hit('rm -r ~root')).toBe('rm-outside');
+  expect(hit('rm -r ./')).toBe('rm-outside');
+  expect(hit('rm -r src/..')).toBe('rm-outside');
+  expect(hit('rm -r src/../x')).toBeUndefined();
+});
+
+test('find without an action, start paths, basename', () => {
+  expect(hit('find / -print')).toBeUndefined();
+  expect(hit('find src -name /etc -delete')).toBeUndefined();
+  expect(hit('find . .. -delete')).toBe('rm-outside');
+  expect(hit('/usr/bin/find / -delete')).toBe('rm-outside');
+});
+
+test('empty argv and unknown command', () => {
+  expect(denyListed([], cwd)).toBeUndefined();
+  expect(hit('echo rm -rf /')).toBeUndefined();
+});
+
+test('every hit has a reason', () => {
+  for (const line of ['git push -f', 'git reset --hard', 'git clean -f', 'rm -r /', 'find / -delete'])
+    expect(denyListed(line.split(' '), cwd)?.reason.length).toBeGreaterThan(0);
+});
+
+test('rm agrees with the path helpers for each target', () => {
+  const paths = ['.', './', '..', '/', '/work', '/work/repo', '/work/repo/', '/work/repo/a', '/work/repoX', 'a', 'a/../..', '*', './*', '~', '~/a', '~bob', '$X', 'a$', '-x', '/etc'];
+  const bad = (p: string) => p.includes('$') || /^~[^/]/.test(p) || !insideWorkspace(p, cwd) || sameDir(p, cwd);
+  for (const p of paths) expect([p, hit(`rm -r -- ${p}`)]).toEqual([p, bad(p) ? 'rm-outside' : undefined]);
+  for (const a of paths)
+    for (const b of paths) {
+      const line = `rm -r -- ${a} ${b}`;
+      expect([line, hit(line)]).toEqual([line, bad(a) || bad(b) ? 'rm-outside' : undefined]);
+    }
+});
+
+test('find agrees with the path helpers for each start path', () => {
+  const paths = ['.', '..', '/', '/work/repo/a', 'a/../..', '~', '~bob', '$X'];
+  for (const p of paths) {
+    const bad = p.includes('$') || /^~[^/]/.test(p) || !insideWorkspace(p, cwd);
+    expect([p, hit(`find ${p} -delete`)]).toEqual([p, bad ? 'rm-outside' : undefined]);
+  }
+});
+
+test('git command forms agree', () => {
+  const lines = ['push -f', 'push origin +main', 'push origin feature', 'reset --hard', 'reset --soft', 'clean -fd', 'clean -n', 'status'];
+  const prefixes = ['git', '/usr/bin/git', 'git -C sub', 'git -c a=b', 'git --git-dir .git'];
+  for (const line of lines) {
+    const expected = hit(`git ${line}`);
+    for (const prefix of prefixes) expect([prefix, line, hit(`${prefix} ${line}`)]).toEqual([prefix, line, expected]);
+  }
+});
