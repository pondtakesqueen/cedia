diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-30 03:17:59.118172462 +0000
@@ -0,0 +1,98 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('argv[0] may be a path', () => {
+  expect(hit('/usr/local/bin/git push -f')).toBe('force-push');
+  expect(hit('/bin/rm -rf /')).toBe('rm-outside');
+});
+
+test('git global options that take a value are skipped', () => {
+  expect(hit('git -c x push -f')).toBe('force-push');
+  expect(hit('git --work-tree w push -f')).toBe('force-push');
+  expect(hit('git --namespace n push --mirror')).toBe('force-push');
+  expect(hit('git -C push status')).toBeUndefined();
+  expect(hit('git --git-dir=.git push -f')).toBe('force-push');
+});
+
+test('push long flags with =value, and look-alikes that pass', () => {
+  expect(hit('git push origin --force=x')).toBe('force-push');
+  expect(hit('git push origin --delete=x')).toBe('force-push');
+  expect(hit('git push origin --prune=x')).toBe('force-push');
+  expect(hit('git push --follow-tags')).toBeUndefined();
+  expect(hit('git push --force-if-includes')).toBeUndefined();
+});
+
+test('push short flag groups', () => {
+  expect(hit('git push -df origin')).toBe('force-push');
+  expect(hit('git push -uf origin x')).toBe('force-push');
+  expect(hit('git push -u origin')).toBeUndefined();
+  expect(hit('git push -v origin')).toBeUndefined();
+});
+
+test('push refspecs starting with + or :', () => {
+  expect(hit('git push origin +HEAD:main')).toBe('force-push');
+  expect(hit('git push origin :x')).toBe('force-push');
+  expect(hit('git push origin main:main')).toBeUndefined();
+});
+
+test('reset and clean forms', () => {
+  expect(hit('git reset HEAD')).toBeUndefined();
+  expect(hit('git clean -nf')).toBe('clean-force');
+  expect(hit('git clean --force -d')).toBe('clean-force');
+  expect(hit('git clean --force -n')).toBeUndefined();
+  expect(hit('git clean -f --dry-run')).toBeUndefined();
+  expect(hit('git clean --dry-run -fx')).toBeUndefined();
+});
+
+test('rm recursion flags', () => {
+  for (const line of ['rm -r /etc', 'rm -R /etc', 'rm --recursive /etc', 'rm -vR /etc']) expect([line, hit(line)]).toEqual([line, 'rm-outside']);
+  for (const line of ['rm -f /etc', 'rm -v /etc']) expect([line, hit(line)]).toEqual([line, undefined]);
+});
+
+test('rm target forms', () => {
+  expect(hit('rm -rf --')).toBe('rm-outside');
+  expect(hit('rm -rf src/..')).toBe('rm-outside');
+  expect(hit('rm -rf ../*')).toBe('rm-outside');
+  expect(hit('rm -rf a$b')).toBe('rm-outside');
+  expect(hit('rm -rf ~bob')).toBe('rm-outside');
+  expect(hit('rm -rf src -r')).toBeUndefined();
+  expect(denyListed(['rm', '--', '-r', '/etc'], cwd)).toBeUndefined();
+});
+
+test('find actions and start paths', () => {
+  expect(hit('find /work/repo -delete')).toBeUndefined();
+  expect(hit('find ~bob -exec x ;')).toBe('rm-outside');
+  expect(hit('find / -print')).toBeUndefined();
+});
+
+test('rm of each path agrees with the path helpers', () => {
+  const paths = ['.', '..', './', '/', '/work', '/work/repo', '/work/repo/build', 'src', 'src/..', 'src/../..', '*', './*', '../*', '~', '~/x', '~bob', 'a$b', '$X', '-weird', '/etc'];
+  const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+  for (const p of paths) {
+    const expected = unresolvable(p) || !insideWorkspace(p, cwd) || sameDir(p, cwd);
+    expect([p, denyListed(['rm', '-rf', '--', p], cwd)?.name === 'rm-outside']).toEqual([p, expected]);
+    expect([p, denyListed(['find', p, '-delete'], cwd)?.name === 'rm-outside']).toEqual([p, unresolvable(p) || !insideWorkspace(p, cwd)]);
+  }
+});
+
+test('rm result does not depend on target order', () => {
+  const paths = ['src', '..', '/etc', '*', '.'];
+  for (const p of paths)
+    for (const q of paths) expect([p, q, denyListed(['rm', '-rf', '--', p, q], cwd)?.name]).toEqual([p, q, denyListed(['rm', '-rf', '--', q, p], cwd)?.name]);
+});
+
+test('equivalent flag spellings agree', () => {
+  for (const flags of [['-rf'], ['-fr'], ['-r', '-f'], ['--recursive', '-f']])
+    expect(denyListed(['rm', ...flags, '/etc'], cwd)?.name).toBe('rm-outside');
+  expect(hit('git push -fu x')).toBe(hit('git push -f -u x'));
+  expect(hit('git clean -fd')).toBe(hit('git clean -f -d'));
+});
+
+test('empty argv and cmd with no rule', () => {
+  expect(denyListed([], cwd)).toBeUndefined();
+  expect(hit('git')).toBeUndefined();
+  expect(hit('rm')).toBeUndefined();
+});
