 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+const GIT_VALUE_OPTIONS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+const PUSH_FLAGS = ['--force', '--force-with-lease', '--mirror', '--delete', '--prune'];
+const FIND_ACTIONS = ['-delete', '-exec', '-execdir'];
+
+// A short flag group such as -f, -fu or -rR that contains one of `letters`. Long options never count.
+const shortGroupHas = (word: string, letters: string) => /^-[^-]/.test(word) && [...letters].some(c => word.includes(c));
+
+// $ or ~user: the shell decides what these name, so they cannot be checked before the command runs.
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+
+// git: skip global options to find the subcommand, then apply that subcommand's rule.
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += GIT_VALUE_OPTIONS.has(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const word = rest.find(w => PUSH_FLAGS.some(f => w === f || w.startsWith(f + '=')) || shortGroupHas(w, 'fd') || /^[+:]/.test(w));
+    return word === undefined ? undefined : { name: 'force-push', reason: `git push ${word} rewrites or deletes remote refs` };
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean' && !rest.includes('-n') && !rest.includes('--dry-run')) {
+    const word = rest.find(w => w === '--force' || shortGroupHas(w, 'f'));
+    if (word !== undefined) return { name: 'clean-force', reason: `git clean ${word} deletes untracked files` };
+  }
+  return undefined;
+}
+
+// rm: recursive removal of cwd itself, a target outside cwd, or a target that cannot be checked before it runs.
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const end = args.indexOf('--');
+  const before = end === -1 ? args : args.slice(0, end);
+  const after = end === -1 ? [] : args.slice(end + 1);
+  if (!before.some(w => w === '--recursive' || shortGroupHas(w, 'rR'))) return undefined;
+  const targets = [...before.filter(w => !w.startsWith('-')), ...after];
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets (they may come from xargs)' };
+  const bad = targets.find(t => unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `rm -r of ${bad}, which is outside the working directory, is cwd itself, or cannot be resolved` };
+}
+
+// find: -delete, -exec or -execdir on a start path outside cwd or one that cannot be checked. cwd itself is fine.
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some(w => FIND_ACTIONS.includes(w))) return undefined;
+  const first = args.findIndex(w => w.startsWith('-'));
+  const starts = first > 0 ? args.slice(0, first) : ['.'];
+  const bad = starts.find(p => unresolvable(p) || !insideWorkspace(p, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `find on ${bad}, which is outside the working directory or cannot be resolved` };
+}
+
 // Looks at one simple command's argv (already split, quotes removed) and returns a Hit when it must be denied.
 //
 // git (argv[0] may be a path such as /usr/bin/git). Global options before the subcommand are skipped; -C, -c,
@@ -36,5 +85,12 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  const [cmd, ...args] = argv;
+  if (cmd === undefined) return undefined;
+  switch (basename(cmd)) {
+    case 'git': return gitHit(args);
+    case 'rm': return rmHit(args, cwd);
+    case 'find': return findHit(args, cwd);
+    default: return undefined;
+  }
 }
