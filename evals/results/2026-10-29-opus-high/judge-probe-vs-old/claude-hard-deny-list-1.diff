+  const longOpt = (w: string, full: string) => w.length > 2 && w.startsWith('--') && full.startsWith(w.split('=')[0]);
+  const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
