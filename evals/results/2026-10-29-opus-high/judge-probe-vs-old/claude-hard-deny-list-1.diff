diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.abbrev.test.ts b/deny.abbrev.test.ts
--- a/deny.abbrev.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.abbrev.test.ts	2026-10-29 08:06:06.760766932 +0000
@@ -0,0 +1,19 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('unambiguous abbreviations of long options are checked', () => {
+  expect(hit(['rm', '--recurs', '/etc'])).toBe('rm-outside');
+  expect(hit(['git', 'push', '--dele', 'origin', 'x'])).toBe('force-push');
+  expect(hit(['git', 'push', '--mirr'])).toBe('force-push');
+  expect(hit(['git', 'push', '--prun', 'origin'])).toBe('force-push');
+});
+
+test('find keeps its leading options in front of the start paths', () => {
+  expect(hit(['find', '-L', '/etc', '-delete'])).toBe('rm-outside');
+  expect(hit(['find', '-H', '/etc', '-exec', 'rm', '{}', ';'])).toBe('rm-outside');
+  expect(hit(['find', '-O3', '-D', 'stat', '/etc', '-delete'])).toBe('rm-outside');
+  expect(hit(['find', '-L', 'src', '-delete'])).toBeUndefined();
+});
