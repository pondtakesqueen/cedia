--- a/csv.ts	2026-10-29 08:03:46.981042986 +0000
+++ b/csv.ts	2026-10-29 08:05:02.188763093 +0000
@@ -50,3 +50,99 @@
   rows.push(row);
   return rows;
 }
+
+type State = "fieldStart" | "unquoted" | "unquotedCR" | "quoted" | "quoteSeen" | "afterClose" | "afterCloseCR";
+
+/** Reads CSV in chunks, one character at a time, with the same rows as `parseCsv` of the whole input. */
+export class CsvStream {
+  #started = false;
+  #state: State = "fieldStart";
+  #row: string[] = [];
+  #field = "";
+
+  push(chunk: string): string[][] {
+    const rows: string[][] = [];
+    for (const c of chunk) {
+      if (!this.#started) {
+        this.#started = true;
+        if (c === "﻿") continue;
+      }
+      this.#feed(c, rows);
+    }
+    return rows;
+  }
+
+  end(): string[][] {
+    if (this.#state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+    if (this.#state === "afterCloseCR") throw new SyntaxError("a \\r after a closing quote is not followed by \\n");
+    if (this.#state === "unquotedCR") this.#field += "\r";
+    const rows: string[][] = [];
+    if (this.#state !== "fieldStart" || this.#row.length > 0) this.#endRow(rows);
+    return rows;
+  }
+
+  #endField() {
+    this.#row.push(this.#field);
+    this.#field = "";
+    this.#state = "fieldStart";
+  }
+
+  #endRow(rows: string[][]) {
+    this.#endField();
+    rows.push(this.#row);
+    this.#row = [];
+  }
+
+  #feed(c: string, rows: string[][]) {
+    switch (this.#state) {
+      case "fieldStart":
+        if (c === '"') this.#state = "quoted";
+        else if (c === ",") this.#endField();
+        else if (c === "\n") this.#endRow(rows);
+        else if (c === "\r") this.#state = "unquotedCR";
+        else {
+          this.#field = c;
+          this.#state = "unquoted";
+        }
+        return;
+      case "unquoted":
+        if (c === ",") this.#endField();
+        else if (c === "\n") this.#endRow(rows);
+        else if (c === "\r") this.#state = "unquotedCR";
+        else if (c === '"') throw new SyntaxError("a quote in a field that is not quoted");
+        else this.#field += c;
+        return;
+      case "unquotedCR":
+        if (c === "\n") this.#endRow(rows);
+        else {
+          this.#field += "\r";
+          this.#state = "unquoted";
+          this.#feed(c, rows);
+        }
+        return;
+      case "quoted":
+        if (c === '"') this.#state = "quoteSeen";
+        else this.#field += c;
+        return;
+      case "quoteSeen":
+        if (c === '"') {
+          this.#field += '"';
+          this.#state = "quoted";
+        } else {
+          this.#state = "afterClose";
+          this.#feed(c, rows);
+        }
+        return;
+      case "afterClose":
+        if (c === ",") this.#endField();
+        else if (c === "\n") this.#endRow(rows);
+        else if (c === "\r") this.#state = "afterCloseCR";
+        else throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote`);
+        return;
+      case "afterCloseCR":
+        if (c === "\n") this.#endRow(rows);
+        else throw new SyntaxError("a \\r after a closing quote is not followed by \\n");
+        return;
+    }
+  }
+}
