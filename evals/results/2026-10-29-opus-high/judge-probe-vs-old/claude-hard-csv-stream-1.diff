--- a/csv.test.ts	2026-10-29 08:03:46.980995357 +0000
+++ b/csv.test.ts	2026-10-29 08:06:33.560768525 +0000
@@ -23,3 +23,130 @@
   expect(s.push("d")).toEqual([]);
   expect(s.end()).toEqual([["c", "d"]]);
 });
+
+function streamAll(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const chunk of chunks) rows.push(...s.push(chunk));
+  rows.push(...s.end());
+  return rows;
+}
+
+// Every split of the input into 2 and 3 chunks, and into single characters.
+function splits(input: string): string[][] {
+  const out: string[][] = [[...input], [input]];
+  for (let a = 0; a <= input.length; a++) {
+    out.push([input.slice(0, a), input.slice(a)]);
+    for (let b = a; b <= input.length; b++) out.push([input.slice(0, a), input.slice(a, b), input.slice(b)]);
+  }
+  return out;
+}
+
+const tricky = [
+  "",
+  "\uFEFF",
+  "\uFEFFa,b",
+  "a\uFEFF",
+  "x\n\uFEFFy",
+  "a\n",
+  "a\n\n",
+  "\n",
+  "a,",
+  ",",
+  "a\r\nb\r\n",
+  "a\rb\n",
+  "a\r",
+  "\r\r\n",
+  '"x,""y""\r\n",z',
+  '""',
+  '""""',
+  '"a"\r\n"b"',
+  '"a",',
+];
+
+test("a stream gives the rows of parseCsv under every split", () => {
+  for (const input of tricky) {
+    for (const chunks of splits(input)) expect(streamAll(chunks)).toEqual(parseCsv(input));
+  }
+});
+
+test("a BOM is dropped at the start of the input even after empty chunks", () => {
+  const s = new CsvStream();
+  expect(s.push("")).toEqual([]);
+  expect(s.push("\uFEFFa")).toEqual([]);
+  expect(s.end()).toEqual([["a"]]);
+});
+
+test("a row comes out when its row end arrives, even when the end is split", () => {
+  const s = new CsvStream();
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\nb")).toEqual([["a"]]);
+  expect(s.end()).toEqual([["b"]]);
+});
+
+test("a quote at the end of a chunk waits for the next character", () => {
+  const s = new CsvStream();
+  expect(s.push('"a"')).toEqual([]);
+  expect(s.push('"b"\n')).toEqual([['a"b']]);
+  expect(s.end()).toEqual([]);
+});
+
+test("inputs parseCsv rejects throw a SyntaxError under every split", () => {
+  const bad = ['"a"b', 'a"b', '"abc', '"a"\rb', '"a"\r', '"', '"a""'];
+  for (const input of bad) {
+    expect(() => parseCsv(input)).toThrow(SyntaxError);
+    for (const chunks of splits(input)) expect(() => streamAll(chunks)).toThrow(SyntaxError);
+  }
+});
+
+test("random inputs and splits agree with parseCsv", () => {
+  let seed = 1;
+  const rand = () => {
+    seed = (Math.imul(seed, 1103515245) + 12345) >>> 0;
+    return seed / 2 ** 32;
+  };
+  const alphabet = ['a', ',', '"', '\r', '\n', '\uFEFF'];
+  const outcome = (run: () => string[][]) => {
+    try {
+      return run();
+    } catch (e) {
+      if (e instanceof SyntaxError) return "SyntaxError";
+      throw e;
+    }
+  };
+  for (let iter = 0; iter < 2000; iter++) {
+    const input = Array.from({ length: Math.floor(rand() * 13) }, () => alphabet[Math.floor(rand() * alphabet.length)]).join("");
+    const chunks: string[] = [];
+    for (let pos = 0; pos < input.length; ) {
+      const take = 1 + Math.floor(rand() * 4);
+      chunks.push(input.slice(pos, pos + take));
+      pos += take;
+      if (rand() < 0.1) chunks.push("");
+    }
+    let expected: string[][] | string;
+    try {
+      expected = parseCsv(input);
+    } catch {
+      expected = "SyntaxError";
+    }
+    expect({ input, chunks, rows: outcome(() => streamAll(chunks)) }).toEqual({ input, chunks, rows: expected });
+  }
+});
+
+test("a long quoted field across many chunks comes out whole, at its closing quote", () => {
+  const s = new CsvStream();
+  const chunk = "x".repeat(1000);
+  expect(s.push('"')).toEqual([]);
+  for (let i = 0; i < 1000; i++) expect(s.push(chunk)).toEqual([]);
+  expect(s.push('"\n')).toEqual([["x".repeat(1_000_000)]]);
+  expect(s.end()).toEqual([]);
+});
+
+test("work per chunk does not grow with the input before it", () => {
+  const s = new CsvStream();
+  let rows = 0;
+  const start = performance.now();
+  for (let i = 0; i < 200_000; i++) rows += s.push("abc,def\n").length;
+  expect(performance.now() - start).toBeLessThan(2000);
+  expect(rows).toBe(200_000);
+});
