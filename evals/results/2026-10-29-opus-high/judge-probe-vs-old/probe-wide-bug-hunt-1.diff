diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 09:14:07.120972065 +0000
@@ -0,0 +1,70 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+describe('pricing rules from README', () => {
+  test('UK free shipping starts at 4000, not 4500', () => {
+    const t = totals(cart('UK', [['TEE', 2], ['CAP', 1]]));
+    expect(t).toMatchObject({ subtotal: 4200, shipping: 0, tax: 840, total: 5040 });
+  });
+
+  test('exactly 10 units of one SKU get the 5% tier', () => {
+    const t = totals(cart('US', [['PEN', 10]]));
+    expect(t.lines[0]).toMatchObject({ subtotal: 1200, discount: 60, total: 1140 });
+    expect(t.subtotal).toBe(1140);
+  });
+
+  test('9 units of one SKU get no bulk discount', () => {
+    const t = totals(cart('US', [['PEN', 9]]));
+    expect(t.lines[0]).toMatchObject({ subtotal: 1080, discount: 0, total: 1080 });
+    expect(t.subtotal).toBe(1080);
+  });
+
+  test('49 units of one SKU get the 5% tier, not 10%', () => {
+    const t = totals(cart('US', [['PEN', 49]]));
+    expect(t.lines[0]).toMatchObject({ subtotal: 5880, discount: 294, total: 5586 });
+  });
+
+  test('exactly 50 units of one SKU get the 10% tier', () => {
+    const t = totals(cart('US', [['PEN', 50]]));
+    expect(t.lines[0]).toMatchObject({ subtotal: 6000, discount: 600, total: 5400 });
+    expect(t.subtotal).toBe(5400);
+  });
+
+  test('lines of the same SKU are merged before the bulk tier is chosen', () => {
+    const t = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ quantity: 10, discount: 60 });
+    expect(t.subtotal).toBe(1140);
+  });
+
+  test('UK order of exactly 4000 ships free', () => {
+    const t = totals(cart('UK', [['BAG', 1], ['MUG', 4]]));
+    expect(t).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+
+  test('UK order of 3700 pays shipping', () => {
+    const t = totals(cart('UK', [['TEE', 1], ['BAG', 1]]));
+    expect(t).toMatchObject({ subtotal: 3700, shipping: 700, tax: 880, total: 5280 });
+  });
+
+  test('UK discounted subtotal of exactly 4000 after FLAT5 ships free', () => {
+    const t = totals(cart('UK', [['TEE', 3]], 'FLAT5'));
+    expect(t).toMatchObject({ subtotal: 4500, coupon: 500, shipping: 0, total: 4800 });
+  });
+
+  test('FLAT5 takes 500 off a larger amount', () => {
+    const t = totals(cart('US', [['TEE', 1]], 'FLAT5'));
+    expect(t).toMatchObject({ coupon: 500, shipping: 800, tax: 126, total: 1926 });
+  });
+
+  test('FLAT5 never takes more than the amount', () => {
+    const t = totals(cart('US', [['PEN', 1]], 'FLAT5'));
+    expect(t).toMatchObject({ subtotal: 120, coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('shipping threshold is checked on the subtotal after the coupon', () => {
+    const t = totals(cart('US', [['BAG', 2], ['PEN', 5]], 'SAVE10'));
+    expect(t).toMatchObject({ subtotal: 5000, coupon: 500, shipping: 800, tax: 371, total: 5671 });
+  });
+});
