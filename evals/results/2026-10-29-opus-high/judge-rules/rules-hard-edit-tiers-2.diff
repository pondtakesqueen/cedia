+
+describe('review fixes', () => {
+  test('CRLF lines keep their line ending in trailing-space matches', () => {
+    const r = ok(applyEdit('a\r\nb\r\nc\r\n', { old_text: 'a\nb', new_text: 'A\nB' }));
+    expect(r.applied.tier).toBe('trailing-space');
+    expect(r.content).toBe('A\r\nB\r\nc\r\n');
+  });
+  test('indentation-only matches: ambiguity error', () => {
+    const r = applyEdit('x\n  a\n  b\nx\n    a\n    b\n', { old_text: 'a\nb', new_text: 'c' });
+    expect('error' in r && r.error).toContain('matches 2 places');
+    expect('error' in r && r.error).toContain('2, 5');
+  });
+  test('a line less indented than old_text keeps the window indentation', () => {
+    const r = ok(applyEdit('    a\n      b\n', { old_text: '  a\n    b', new_text: 'a\n z' }));
+    expect(r.content).toBe('    a\n    z\n');
+  });
+  test('not found lists at most five lines of the first line', () => {
+    const r = applyEdit('q\n'.repeat(8), { old_text: 'q\nz', new_text: 'r' });
+    expect('error' in r && r.error).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect('error' in r && r.error).not.toContain('6');
+  });
+});
