 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: next, replace_all } = edit;
+  const oldL = toLines(old);
+  if (oldL.length === 0) return { error: 'old_text is empty; use write to create content' };
+  if (old === next) return { error: 'old_text and new_text are the same' };
+
+  const hits: number[] = [];
+  for (let at = content.indexOf(old); at !== -1; at = content.indexOf(old, at + old.length)) hits.push(at);
+  if (hits.length > 1 && !replace_all) {
+    return { error: `old_text matches ${hits.length} places (first at line ${lineAt(content, hits[0])}); add context or set replace_all` };
+  }
+  if (hits.length > 0) {
+    const from = lineAt(content, hits[0]);
+    const out = replace_all
+      ? content.split(old).join(next)
+      : content.slice(0, hits[0]) + next + content.slice(hits[0] + old.length);
+    return { content: out, applied: { from, to: from + oldL.length - 1, tier: 'exact', count: replace_all ? hits.length : 1 } };
+  }
+
+  const lines = content.split('\n');
+  const newL = toLines(next);
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', (s) => s.trimEnd()],
+    ['indentation', (s) => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const starts: number[] = [];
