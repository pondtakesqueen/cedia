 // from/to are 1-based line numbers of the replaced text in the original content; count is how many places were replaced.
 export type Applied = { from: number; to: number; tier: Tier; count: number };
 
+// Splits text into lines, ignoring one trailing newline; empty text has no lines.
+const toLines = (s: string) => {
+  const t = s.endsWith('\n') ? s.slice(0, -1) : s;
+  return t === '' ? [] : t.split('\n');
+};
+const lineAt = (text: string, index: number) => text.slice(0, index).split('\n').length;
+const indentOf = (lines: string[]) => /^\s*/.exec(lines.find((l) => l.trim() !== '') ?? '')![0];
+
+// Re-indents new_text: old_text's indentation becomes the matched window's indentation.
+function reindent(oldL: string[], windowL: string[], newL: string[]): string[] {
+  const oldIndent = indentOf(oldL);
+  const fileIndent = indentOf(windowL);
+  return newL.map((l) => {
+    if (l.trim() === '') return '';
+    return fileIndent + (l.startsWith(oldIndent) ? l.slice(oldIndent.length) : l.trimStart());
+  });
+}
+
 // Applies one edit to `content`.
 //
 // Tiers, tried in order; a tier applies only when it finds exactly one place (or replace_all is set, exact tier only):
