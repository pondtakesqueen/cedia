+  const norm = (s: string) => s.trim().replace(/\s+/g, ' ');
+  const drop = (s: string) => norm(s).replace(/ 2>&1$/, '');
+  let c = drop(command);
+  const cd = /^cd\s+("[^"]*"|'[^']*'|\S+)\s*&&\s*([\s\S]*)$/.exec(command.trim());
+  if (cd && cwd !== undefined) {
+    if (resolve(cwd, cd[1]!.replace(/^(["'])(.*)\1$/, '$2')) !== resolve(cwd)) return undefined;
+    c = drop(cd[2]!);
+  }
