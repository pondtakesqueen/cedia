+test('abbreviated long options are the same flag', () => {
+  expect(hit('rm --recurs /etc')).toBe('rm-outside');
+  expect(hit('rm --rec /')).toBe('rm-outside');
+  expect(hit('git push --mirr')).toBe('force-push');
+  expect(hit('git push --dele origin old')).toBe('force-push');
+  expect(hit('git clean --fo')).toBe('clean-force');
+  expect(hit('git reset --ha')).toBe('reset-hard');
+  expect(hit('git push --progress origin x')).toBeUndefined();
+});
+
+test('a name starting with .. inside cwd is not outside', () => {
+  expect(hit('rm -rf ..cache')).toBeUndefined();
+  expect(hit('find ..cache -delete')).toBeUndefined();
+  expect(hit('rm -r ..')).toBe('rm-outside');
+  expect(hit('rm -r ../x')).toBe('rm-outside');
+});
