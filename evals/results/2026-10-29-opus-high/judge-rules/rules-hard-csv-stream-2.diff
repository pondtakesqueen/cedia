--- a/csv.ts	2026-10-29 11:00:33.306393684 +0000
+++ b/csv.ts	2026-10-29 11:02:04.649357108 +0000
@@ -50,3 +50,103 @@
   rows.push(row);
   return rows;
 }
+
+type State = "fieldStart" | "unquoted" | "unquotedCR" | "quoted" | "quoteInQuoted" | "afterClose" | "afterCloseCR";
+
+/** Reads the input of parseCsv a chunk at a time: push returns the rows that chunk finished, end returns the rest. */
+export class CsvStream {
+  private state: State = "fieldStart";
+  private field = "";
+  private row: string[] = [];
+  private offset = 0;
+  private crAt = 0;
+
+  push(chunk: string): string[][] {
+    const out: string[][] = [];
+    for (let k = 0; k < chunk.length; k++) this.feed(chunk[k]!, out);
+    return out;
+  }
+
+  end(): string[][] {
+    const out: string[][] = [];
+    if (this.state === "fieldStart" && this.row.length === 0) return out;
+    if (this.state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+    if (this.state === "afterCloseCR") throw this.unexpected("\r", this.crAt);
+    if (this.state === "unquotedCR") this.field += "\r";
+    this.endRow(out);
+    return out;
+  }
+
+  private feed(c: string, out: string[][]) {
+    const at = this.offset++;
+    if (at === 0 && c === "\uFEFF") return;
+    this.step(c, at, out);
+  }
+
+  private step(c: string, at: number, out: string[][]) {
+    switch (this.state) {
+      case "quoted":
+        if (c === '"') this.state = "quoteInQuoted";
+        else this.field += c;
+        return;
+      case "quoteInQuoted":
+        if (c === '"') {
+          this.field += c;
+          this.state = "quoted";
+          return;
+        }
+        this.state = "afterClose";
+        this.step(c, at, out);
+        return;
+      case "afterClose":
+        if (c === ",") this.endField();
+        else if (c === "\n") this.endRow(out);
+        else if (c === "\r") {
+          this.state = "afterCloseCR";
+          this.crAt = at;
+        } else throw this.unexpected(c, at);
+        return;
+      case "afterCloseCR":
+        if (c !== "\n") throw this.unexpected("\r", this.crAt);
+        this.endRow(out);
+        return;
+      case "unquotedCR":
+        if (c === "\n") {
+          this.endRow(out);
+          return;
+        }
+        this.field += "\r";
+        this.state = "unquoted";
+        this.step(c, at, out);
+        return;
+      default:
+        // fieldStart or unquoted
+        if (c === '"') {
+          if (this.state === "unquoted") throw new SyntaxError(`a quote in a field that is not quoted, at offset ${at}`);
+          this.state = "quoted";
+        } else if (c === ",") this.endField();
+        else if (c === "\n") this.endRow(out);
+        else if (c === "\r") this.state = "unquotedCR";
+        else {
+          this.field += c;
+          this.state = "unquoted";
+        }
+    }
+  }
+
+  private endField() {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "fieldStart";
+  }
+
+  private endRow(out: string[][]) {
+    this.endField();
+    out.push(this.row);
+    this.row = [];
+  }
+
+  private unexpected(c: string, at: number) {
+    return new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${at}`);
+  }
+}
