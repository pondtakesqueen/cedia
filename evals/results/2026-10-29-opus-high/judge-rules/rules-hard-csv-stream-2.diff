--- a/csv.test.ts	2026-10-29 11:00:33.306316666 +0000
+++ b/csv.test.ts	2026-10-29 11:02:23.981358258 +0000
@@ -23,3 +23,90 @@
   expect(s.push("d")).toEqual([]);
   expect(s.end()).toEqual([["c", "d"]]);
 });
+
+function run(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const c of chunks) rows.push(...s.push(c));
+  rows.push(...s.end());
+  return rows;
+}
+
+// The result of f: its rows, or its SyntaxError message.
+function outcome(f: () => string[][]): unknown {
+  try {
+    return f();
+  } catch (e) {
+    return e instanceof SyntaxError ? `SyntaxError: ${e.message}` : e;
+  }
+}
+
+test("a row end split across chunks, and a lone \r stays in its field", () => {
+  const s = new CsvStream();
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\nb")).toEqual([["a"]]);
+  expect(s.end()).toEqual([["b"]]);
+  expect(run(["a\r", "b"])).toEqual([["a\rb"]]);
+  expect(run(["a\r"])).toEqual([["a\r"]]);
+});
+
+test("a doubled quote or a closing quote split across chunks", () => {
+  expect(run(['"x"', '"y"', ""])).toEqual([['x"y']]);
+  expect(run(['"x"', ',y'])).toEqual([["x", "y"]]);
+});
+
+test("the BOM is dropped only at the very start of the input", () => {
+  expect(run(["", "\uFEFFa"])).toEqual([["a"]]);
+  expect(run(["a", "\uFEFFb"])).toEqual([["a\uFEFFb"]]);
+  expect(run(["\uFEFF"])).toEqual([]);
+  expect(run(["\uFEFF", "\n"])).toEqual([[""]]);
+});
+
+test("an empty input has no rows, a trailing row end adds none", () => {
+  expect(new CsvStream().end()).toEqual([]);
+  expect(run(["\n"])).toEqual([[""]]);
+  expect(run(["a\n", ""])).toEqual([["a"]]);
+});
+
+test("errors are SyntaxErrors with the parseCsv message, whatever the split", () => {
+  expect(outcome(() => run(["a\"", "b"]))).toBe(outcome(() => parseCsv('a"b')));
+  expect(outcome(() => run(['"a"', "b"]))).toBe(outcome(() => parseCsv('"a"b')));
+  expect(outcome(() => run(['"a"\r']))).toBe(outcome(() => parseCsv('"a"\r')));
+  expect(outcome(() => run(['"a"\r', "x"]))).toBe(outcome(() => parseCsv('"a"\rx')));
+  expect(outcome(() => run(['"a', "b"]))).toBe(outcome(() => parseCsv('"ab')));
+  expect(() => run(['"a'])).toThrow(SyntaxError);
+});
+
+test("matches parseCsv for random inputs and random splits", () => {
+  let seed = 1;
+  const rnd = () => {
+    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
+    return seed / 2 ** 32;
+  };
+  const alphabet = ['a', ',', '"', '\r', '\n', '\uFEFF'];
+  for (let t = 0; t < 3000; t++) {
+    let s = "";
+    const len = Math.floor(rnd() * 21);
+    for (let k = 0; k < len; k++) s += alphabet[Math.floor(rnd() * alphabet.length)];
+    const chunks: string[] = [];
+    for (let pos = 0; ; ) {
+      const n = Math.floor(rnd() * 5);
+      chunks.push(s.slice(pos, pos + n));
+      pos += n;
+      if (pos >= s.length) break;
+    }
+    const singles = s.split("");
+    expect(outcome(() => run(chunks))).toEqual(outcome(() => parseCsv(s)));
+    expect(outcome(() => run(singles))).toEqual(outcome(() => parseCsv(s)));
+  }
+});
+
+test("many small chunks give the same rows", () => {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (let i = 0; i < 200_000; i++) rows.push(...s.push(i % 2 ? "y\n" : "x,"));
+  rows.push(...s.end());
+  expect(rows.length).toBe(100_000);
+  expect(rows[0]).toEqual(["x", "y"]);
+  expect(rows.at(-1)).toEqual(["x", "y"]);
+});
