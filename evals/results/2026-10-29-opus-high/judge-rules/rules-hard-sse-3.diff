diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.extra.test.ts b/sse.extra.test.ts
--- a/sse.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.extra.test.ts	2026-10-29 11:30:31.881458591 +0000
@@ -0,0 +1,52 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+test('pending data with no final newline is yielded with its event', async () => {
+  expect(await all('event: e\ndata: x')).toEqual([{ event: 'e', data: 'x' }]);
+});
+
+test('a stream error surfaces after the messages before it', async () => {
+  let step = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (step++ === 0) c.enqueue(new TextEncoder().encode('data: a\n\n'));
+      else c.error(new Error('boom'));
+    },
+  });
+  const out: SseMessage[] = [];
+  await expect((async () => {
+    for await (const m of readSse(body)) out.push(m);
+  })()).rejects.toThrow('boom');
+  expect(out).toEqual([{ data: 'a' }]);
+});
+
+test('output does not depend on chunk size, with mixed line endings and multi-byte text', async () => {
+  const text = 'event: a\r\ndata: สวัสดี\n: c\r\ndata: 🙂 x\r\n\r\ndata:y\n\nid: 3\ndata\n\nevent: e\ndata: last';
+  const whole = await all(text, text.length + 1);
+  expect(whole).toEqual([{ event: 'a', data: 'สวัสดี\n🙂 x' }, { data: 'y' }, { data: '' }, { event: 'e', data: 'last' }]);
+  for (let chunk = 1; chunk <= text.length; chunk++) expect(await all(text, chunk)).toEqual(whole);
+});
+
+test('breaking out early cancels the source stream', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(enc.encode('data: a\n\ndata: b\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'a' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
