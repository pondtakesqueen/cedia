--- a/csv.ts	2026-10-29 11:00:33.293595731 +0000
+++ b/csv.ts	2026-10-29 11:01:49.397356202 +0000
@@ -50,3 +50,109 @@
   rows.push(row);
   return rows;
 }
+
+type State = "start" | "unquoted" | "unquotedCR" | "quoted" | "quotedQuote" | "afterCloseCR";
+
+/** Streams `parseCsv`: the rows from all calls together equal `parseCsv` of the whole input, for any split. */
+export class CsvStream {
+  private row: string[] = [];
+  private field = "";
+  private state: State = "start";
+  private offset = 0;
+
+  push(chunk: string): string[][] {
+    const rows: string[][] = [];
+    for (let k = 0; k < chunk.length; k++) {
+      const at = this.offset++;
+      if (at === 0 && chunk[k] === "﻿") continue;
+      this.step(chunk[k]!, at, rows);
+    }
+    return rows;
+  }
+
+  end(): string[][] {
+    const rows: string[][] = [];
+    switch (this.state) {
+      case "start":
+        if (this.row.length > 0) this.endRow(rows);
+        break;
+      case "unquoted":
+      case "quotedQuote":
+        this.endRow(rows);
+        break;
+      case "unquotedCR":
+        this.field += "\r";
+        this.endRow(rows);
+        break;
+      case "quoted":
+        throw new SyntaxError("a quoted field is still open at the end of the input");
+      case "afterCloseCR":
+        throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.offset - 1}`);
+    }
+    this.row = [];
+    this.field = "";
+    this.state = "start";
+    this.offset = 0;
+    return rows;
+  }
+
+  private step(c: string, at: number, rows: string[][]): void {
+    switch (this.state) {
+      case "start":
+        if (c === '"') this.state = "quoted";
+        else if (c === "\r") this.state = "unquotedCR";
+        else if (c === "\n") this.endRow(rows);
+        else if (c === ",") this.finishField();
+        else {
+          this.field += c;
+          this.state = "unquoted";
+        }
+        return;
+      case "unquoted":
+        if (c === "\r") this.state = "unquotedCR";
+        else if (c === "\n") this.endRow(rows);
+        else if (c === ",") this.finishField();
+        else if (c === '"') throw new SyntaxError(`a quote in a field that is not quoted, at offset ${at}`);
+        else this.field += c;
+        return;
+      case "unquotedCR":
+        if (c === "\n") {
+          this.endRow(rows);
+          return;
+        }
+        this.field += "\r";
+        this.state = "unquoted";
+        this.step(c, at, rows);
+        return;
+      case "quoted":
+        if (c === '"') this.state = "quotedQuote";
+        else this.field += c;
+        return;
+      case "quotedQuote":
+        if (c === '"') {
+          this.field += '"';
+          this.state = "quoted";
+        } else if (c === ",") this.finishField();
+        else if (c === "\n") this.endRow(rows);
+        else if (c === "\r") this.state = "afterCloseCR";
+        else throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${at}`);
+        return;
+      case "afterCloseCR":
+        if (c !== "\n") throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${at - 1}`);
+        this.endRow(rows);
+        return;
+    }
+  }
+
+  private finishField(): void {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "start";
+  }
+
+  private endRow(rows: string[][]): void {
+    this.finishField();
+    rows.push(this.row);
+    this.row = [];
+  }
+}
