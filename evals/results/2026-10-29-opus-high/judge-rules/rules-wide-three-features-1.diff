 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNIT_MS: Record<string, number> = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1000, ms: 1 };
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const trimmed = text.trim();
+  if (!/^(?:\d+(?:\.\d+)?(?:ms|d|h|m|s)\s*)+$/.test(trimmed)) {
+    throw new Error(`invalid duration: "${text}"`);
+  }
+  // Exact sum: each part is digits * unit / 10^fractionLength, so scale every part to the longest fraction.
+  const parts = [...trimmed.matchAll(/(\d+)(?:\.(\d+))?(ms|d|h|m|s)/g)].map(([, whole, frac = '', unit]) => ({
+    digits: BigInt(whole + frac),
+    scale: frac.length,
+    unit: BigInt(UNIT_MS[unit]),
+  }));
+  const scale = Math.max(0, ...parts.map((p) => p.scale));
+  const den = 10n ** BigInt(scale);
+  let total = 0n;
+  for (const p of parts) {
+    total += p.digits * p.unit * 10n ** BigInt(scale - p.scale);
+  }
+  return Number((total + den / 2n) / den);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) {
+    throw new Error(`invalid duration: ${ms}`);
+  }
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const unit of ['d', 'h', 'm', 's', 'ms']) {
+    const q = Math.floor(rest / UNIT_MS[unit]);
+    if (q > 0) {
+      out += `${q}${unit}`;
+      rest -= q * UNIT_MS[unit];
+    }
+  }
+  return out;
 }
