+++ b/src/lru.ts	2026-10-29 11:36:15.825479036 +0000
@@ -14,30 +14,74 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  private map = new Map<K, Entry<V>>();
+  private capacity: number;
+  private ttlMs: number;
+  private now: () => number;
 
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.map.get(key);
+    if (!e) return undefined;
+    this.map.delete(key);
+    if (this.now() >= e.expires) {
+      this.onEvict?.(key, e.value, 'expired');
+      return undefined;
+    }
+    this.map.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.map.delete(key);
+    this.map.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    const t = this.now();
+    for (const [k, e] of this.map) {
+      if (t >= e.expires) {
+        this.map.delete(k);
+        this.onEvict?.(k, e.value, 'expired');
+      }
+    }
+    while (this.map.size > this.capacity) {
+      const [k, e] = this.map.entries().next().value!;
+      this.map.delete(k);
+      this.onEvict?.(k, e.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.map.get(key);
+    if (!e) return false;
+    this.map.delete(key);
+    if (this.now() >= e.expires) {
+      this.onEvict?.(key, e.value, 'expired');
+      return false;
+    }
+    this.onEvict?.(key, e.value, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    const t = this.now();
+    let n = 0;
+    for (const e of this.map.values()) if (t < e.expires) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const t = this.now();
+    const live: K[] = [];
+    for (const [k, e] of this.map) if (t < e.expires) live.push(k);
+    return live.reverse();
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 11:35:04.302383143 +0000
+++ b/src/slug.ts	2026-10-29 11:36:15.818521413 +0000
@@ -11,10 +11,25 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const LETTERS: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => LETTERS[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (s[max] === '-') return s.slice(0, max);
+  const i = s.lastIndexOf('-', max - 1);
+  return i > 0 ? s.slice(0, i) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 11:37:47.289484473 +0000
@@ -0,0 +1,58 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parses compound, spaced, fractional and trimmed input', () => {
+  expect(parseDuration('2d 4h')).toBe(2 * 86_400_000 + 4 * 3_600_000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+});
+
+test('rounds the total to a whole number of milliseconds', () => {
+  expect(parseDuration('1.0005s')).toBe(1001);
+  expect(parseDuration('1.0015s')).toBe(1002);
+  expect(parseDuration('0.0015s')).toBe(2);
+  expect(parseDuration('4.35s')).toBe(4350);
+  expect(parseDuration('1.005s')).toBe(1005);
+});
+
+test('fractional parts sum exactly, matching decimal arithmetic on every input', () => {
+  // Expected value by integer arithmetic: whole seconds * 1000, plus the fraction digits * 1000 / 10^k rounded half up.
+  for (let k = 1; k <= 4; k++) {
+    const den = 10 ** k;
+    for (let frac = 0; frac < den; frac++) {
+      for (const whole of [0, 1, 7, 999]) {
+        const digits = String(frac).padStart(k, '0');
+        const num = frac * 1000;
+        const expected = whole * 1000 + Math.floor((2 * num + den) / (2 * den));
+        expect(parseDuration(`${whole}.${digits}s`)).toBe(expected);
+      }
+    }
+  }
+});
+
+test('tells ms apart from m', () => {
+  expect(parseDuration('1m1ms')).toBe(60_001);
+});
+
+test('rejects malformed input with the input quoted in the message', () => {
+  for (const bad of ['', '10', '5x', 'h', '-1s', '1 h', '1h30', '1..5s', '.5s', '1H', '5"x', 'a\nb', 'c\\d', '1h\t5']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+});
+
+test('formatDuration uses the largest units, leaves out zero parts and round trips', () => {
+  expect(formatDuration(1500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(3_600_000)).toBe('1h');
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(Number.NaN)).toThrow();
+  expect(() => formatDuration(Number.POSITIVE_INFINITY)).toThrow();
+  let seed = 12345;
+  for (let i = 0; i < 2000; i++) {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    const n = seed % 1_000_000_001;
+    expect(parseDuration(formatDuration(n))).toBe(n);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 11:36:31.689479979 +0000
@@ -0,0 +1,97 @@
+import { expect, test } from 'bun:test';
+import { LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const events: [string, number, string][] = [];
+  cache.onEvict = (k, v, reason) => events.push([k, v, reason]);
+  return { cache, events, setTime: (v: number) => (t = v) };
+}
+
+test('capacity eviction removes the least recently used entry', () => {
+  const { cache, events } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(events).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('get of an expired entry removes it with reason expired', () => {
+  const { cache, events, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(events).toEqual([['a', 1, 'expired']]);
+});
+
+test('an entry is live while now < set time + ttl', () => {
+  const { cache, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(999);
+  expect(cache.get('a')).toBe(1);
+  setTime(1000);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('expired entries are swept before a live one is evicted', () => {
+  const { cache, events, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(500);
+  cache.set('b', 2);
+  setTime(1000);
+  cache.set('c', 3);
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('expired entries count toward capacity until they are swept', () => {
+  const { cache, events, setTime } = setup(1, 1000);
+  cache.set('a', 1);
+  setTime(1000);
+  expect(events).toEqual([]);
+  cache.set('b', 2);
+  expect(events).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['b']);
+});
+
+test('delete reports live, expired and missing entries differently', () => {
+  const { cache, events, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(events).toEqual([['a', 1, 'delete']]);
+  setTime(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(events).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+  ]);
+  expect(cache.delete('zzz')).toBe(false);
+  expect(events.length).toBe(2);
+});
+
+test('size and keys leave out expired entries without removing them', () => {
+  const { cache, events, setTime } = setup(3, 1000);
+  cache.set('a', 1);
+  setTime(500);
+  cache.set('b', 2);
+  setTime(1200);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(events).toEqual([]);
+});
+
+test('setting an existing key refreshes its ttl and recency without an event', () => {
+  const { cache, events, setTime } = setup(2, 1000);
+  cache.set('a', 1);
+  setTime(900);
+  cache.set('b', 2);
+  cache.set('a', 10);
+  expect(events).toEqual([]);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  setTime(1500);
+  expect(cache.get('a')).toBe(10);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 11:36:26.985479700 +0000
@@ -0,0 +1,47 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('strips diacritics and maps special letters', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('ßæœøłđ')).toBe('ssaeoeold');
+});
+
+test('collapses separators and trims dashes', () => {
+  expect(slugify('--a  _ b--')).toBe('a-b');
+  expect(slugify('***')).toBe('');
+});
+
+test('cuts at a dash within max, or at max without one', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+  expect(slugify('abc', 3)).toBe('abc');
+  expect(slugify('abc', 10)).toBe('abc');
+});
+
+test('a cut slug is within max, has no edge dashes and is a prefix of the full slug', () => {
+  const chars = 'ab-c d_é!ß0';
+  let seed = 777;
+  for (let i = 0; i < 2000; i++) {
+    let text = '';
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    const len = seed % 30;
+    for (let j = 0; j < len; j++) {
+      seed = (seed * 1103515245 + 12345) % 2147483648;
+      text += chars[seed % chars.length];
+    }
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    const max = seed % 15;
+    const full = slugify(text);
+    const cut = slugify(text, max);
+    expect(cut.length).toBeLessThanOrEqual(max);
+    expect(cut.startsWith('-')).toBe(false);
+    expect(cut.endsWith('-')).toBe(false);
+    expect(full.startsWith(cut)).toBe(true);
+  }
+});
+
+test('uniqueSlug returns the first free numbered slug', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['other']))).toBe('post');
+});
