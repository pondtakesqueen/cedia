@@ -64,3 +64,53 @@
   expect((await it.next()).value).toEqual({ data: 'second' });
   expect((await it.next()).done).toBe(true);
 });
+
+test('stopping early cancels the body', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'a' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
+
+test('a long line arriving in small chunks is parsed in linear time', async () => {
+  const enc = new TextEncoder();
+  const parts = Array.from({ length: 20000 }, () => enc.encode('x'.repeat(50)));
+  parts.push(enc.encode('\n\n'));
+  let i = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (i < parts.length) c.enqueue(parts[i++]);
+      else c.close();
+    },
+  });
+  const t0 = performance.now();
+  const out: SseMessage[] = [];
+  for await (const m of readSse(body)) out.push(m);
+  expect(out).toEqual([]);
+  expect(performance.now() - t0).toBeLessThan(1000);
+});
+
+test('a stream error reaches the caller unchanged', async () => {
+  let n = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (n++ === 0) c.enqueue(new TextEncoder().encode('data: ok\n\n'));
+      else c.error(new Error('boom'));
+    },
+  });
+  const out: SseMessage[] = [];
+  await expect((async () => {
+    for await (const m of readSse(body)) out.push(m);
+  })()).rejects.toThrow('boom');
+  expect(out).toEqual([{ data: 'ok' }]);
+});
