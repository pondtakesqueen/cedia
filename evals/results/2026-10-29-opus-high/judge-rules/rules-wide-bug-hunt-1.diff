diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/rules.test.ts b/test/rules.test.ts
--- a/test/rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/rules.test.ts	2026-10-29 11:32:40.453466234 +0000
@@ -0,0 +1,132 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { percentOf } from '../src/money/round.ts';
+import { totals } from '../src/order/total.ts';
+import { priceLine } from '../src/pricing/lines.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Each test names the README rule it checks. Prices: MUG 450, TEE 1500, CAP 1200, PEN 120, BAG 2200.
+describe('README pricing rules', () => {
+  test('rule 1: a line subtotal is unit price times quantity', () => {
+    expect(totals(cart('US', [['TEE', 3]])).lines[0]).toMatchObject({ subtotal: 4500, discount: 0, total: 4500 });
+  });
+
+  test('rule 2: 9 units get no bulk discount, 10 units get 5%', () => {
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]).toMatchObject({ discount: 0 });
+    expect(totals(cart('US', [['PEN', 10]])).lines[0]).toMatchObject({ subtotal: 1200, discount: 60, total: 1140 });
+  });
+
+  test('rule 2: 49 units get 5%, 50 units get 10% and no more', () => {
+    expect(totals(cart('US', [['PEN', 49]])).lines[0]).toMatchObject({ subtotal: 5880, discount: 294 });
+    expect(totals(cart('US', [['PEN', 50]])).lines[0]).toMatchObject({ subtotal: 6000, discount: 600, total: 5400 });
+  });
+
+  test('rule 2: lines of the same SKU are merged before pricing', () => {
+    const merged = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+    expect(merged.lines).toHaveLength(1);
+    expect(merged.lines[0]).toMatchObject({ quantity: 10, subtotal: 1200, discount: 60 });
+    expect(merged).toEqual(totals(cart('US', [['PEN', 10]])));
+  });
+
+  test('rule 2: however a quantity is split across lines, the totals are the same', () => {
+    for (let q = 1; q <= 60; q++) {
+      const single = totals(cart('US', [['PEN', q]]));
+      for (let k = 1; k <= 4 && k <= q; k++) {
+        const parts: [string, number][] = [['PEN', q - (k - 1)]];
+        for (let i = 1; i < k; i++) parts.push(['PEN', 1]);
+        expect(totals(cart('US', parts))).toEqual(single);
+      }
+    }
+  });
+
+  test('rule 2: merging does not change the cart it was given', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    totals(c);
+    expect(c.lines).toEqual([
+      { sku: 'PEN', quantity: 6, unitPrice: 120 },
+      { sku: 'PEN', quantity: 4, unitPrice: 120 },
+    ]);
+  });
+
+  test('rule 2: priceLine alone gives the tier for the line it is given', () => {
+    expect(priceLine({ sku: 'PEN', quantity: 50, unitPrice: 120 })).toMatchObject({ discount: 600 });
+  });
+
+  test('rule 3: SAVE10 takes 10% after the bulk discount', () => {
+    // 10 pens: 1200 - 60 = 1140; 10% of 1140 = 114
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10'))).toMatchObject({ subtotal: 1140, coupon: 114 });
+  });
+
+  test('rule 3: FLAT5 takes 500 off, never below zero', () => {
+    expect(totals(cart('US', [['PEN', 10]], 'FLAT5'))).toMatchObject({ subtotal: 1140, coupon: 500 });
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ subtotal: 120, coupon: 120, shipping: 800 });
+  });
+
+  test('rule 3: coupon codes are not case sensitive; unknown codes give nothing', () => {
+    expect(totals(cart('US', [['MUG', 2]], 'save10'))).toMatchObject({ coupon: 90 });
+    expect(totals(cart('US', [['MUG', 2]], 'NOPE'))).toMatchObject({ coupon: 0 });
+  });
+
+  test('rule 4: free shipping is judged on the discounted subtotal', () => {
+    // 4 TEE = 6000, meets EU's 6000 threshold with no coupon
+    expect(totals(cart('EU', [['TEE', 4]]))).toMatchObject({ shipping: 0 });
+    // with SAVE10 the amount is 6000 - 600 = 5400, below the threshold
+    expect(totals(cart('EU', [['TEE', 4]], 'SAVE10'))).toMatchObject({ subtotal: 6000, coupon: 600, shipping: 900 });
+  });
+
+  test('rule 4: free shipping is judged on the discounted subtotal after bulk discounts', () => {
+    // 2 BAG = 4400 meets UK's 4000 threshold
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ shipping: 0 });
+    // 10 PEN is 1200 before bulk and 1140 after, which is below 4000
+    expect(totals(cart('UK', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 700 });
+  });
+
+  test('rule 4: the free-shipping threshold is inclusive', () => {
+    expect(totals(cart('US', [['BAG', 2], ['PEN', 5]]))).toMatchObject({ subtotal: 5000, shipping: 0 });
+    expect(totals(cart('US', [['BAG', 2], ['PEN', 4]]))).toMatchObject({ subtotal: 4880, shipping: 800 });
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0 });
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 4]]))).toMatchObject({ subtotal: 3880, shipping: 700 });
+  });
+
+  test('regions table matches the README', () => {
+    expect(REGIONS.US).toMatchObject({ taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+    expect(REGIONS.EU).toMatchObject({ taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+    expect(REGIONS.UK).toMatchObject({ taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+
+  test('rule 5: tax is charged on discounted subtotal plus shipping', () => {
+    // EU, 1 MUG: (450 + 900) * 20% = 270
+    expect(totals(cart('EU', [['MUG', 1]]))).toMatchObject({ tax: 270, total: 1620 });
+  });
+
+  test('rule 5: tax rounds half up to the cent', () => {
+    expect(percentOf(50, 0.07)).toBe(4); // 3.5
+    expect(percentOf(150, 0.07)).toBe(11); // 10.5
+    for (const r of Object.values(REGIONS)) {
+      const bp = Math.round(r.taxRate * 10000);
+      for (let a = 0; a <= 20000; a++) {
+        expect(percentOf(a, r.taxRate)).toBe(Math.floor((a * bp * 2 + 10000) / 20000));
+      }
+    }
+  });
+
+  test('rule 6: total is discounted subtotal + shipping + tax', () => {
+    let seed = 7;
+    const rnd = (n: number) => {
+      seed = (seed * 1103515245 + 12345) % 2147483648;
+      return seed % n;
+    };
+    const skus = ['MUG', 'TEE', 'CAP', 'PEN', 'BAG'];
+    const coupons = [undefined, 'SAVE10', 'FLAT5'];
+    for (let i = 0; i < 300; i++) {
+      const items: [string, number][] = Array.from({ length: 1 + rnd(4) }, () => [skus[rnd(5)]!, 1 + rnd(60)]);
+      const regionCode = ['US', 'EU', 'UK'][rnd(3)]!;
+      const t = totals(cart(regionCode, items, coupons[rnd(3)]));
+      expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+    }
+  });
+
+  test('unknown region still throws', () => {
+    expect(() => totals(cart('XX', [['MUG', 1]]))).toThrow(/unknown region XX/);
+  });
+});
