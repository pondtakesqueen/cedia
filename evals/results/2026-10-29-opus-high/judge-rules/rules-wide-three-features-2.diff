@@ -7,10 +7,37 @@
 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const units: [string, number][] = [
+  ['d', 86_400_000],
+  ['h', 3_600_000],
+  ['m', 60_000],
+  ['s', 1000],
+  ['ms', 1],
+];
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  if (s === '') throw new Error(`Invalid duration: ${JSON.stringify(text)}`);
+  const part = /(\d+(?:\.\d+)?|\.\d+)(ms|d|h|m|s)\s*/y;
+  let total = 0;
+  while (part.lastIndex < s.length) {
+    const match = part.exec(s);
+    if (!match) throw new Error(`Invalid duration: ${JSON.stringify(text)}`);
+    const unit = units.find(([name]) => name === match[2])![1];
+    total += parseFloat(match[1]) * unit;
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (ms < 0 || !Number.isFinite(ms)) throw new Error(`Invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const [name, size] of units) {
+    const q = Math.floor(rest / size);
+    if (q > 0) out += `${q}${name}`;
+    rest %= size;
+  }
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
