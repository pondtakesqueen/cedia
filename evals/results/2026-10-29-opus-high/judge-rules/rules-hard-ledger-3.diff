+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+const intent = (callId: string, tool: string, input: Record<string, unknown>): SessionEvent => ({ kind: 'tool_intent', callId, tool, input });
+const result = (callId: string, status: 'completed' | 'failed' | 'denied' | 'not_started' = 'completed', output: { isError: boolean; exitCode?: number } = { isError: false }): SessionEvent => ({
+  kind: 'tool_result',
+  callId,
+  status,
+  output,
+});
+
+describe('matchCheck rules', () => {
+  test('whitespace and a trailing 2>&1 are normalized on both sides, and the check comes back as written', () => {
+    expect(matchCheck('bun test', ['bun  test 2>&1'])).toBe('bun  test 2>&1');
+  });
+
+  test('a pipe or a chain never counts', () => {
+    expect(matchCheck('bun test | tail', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test; ls', ['bun test'])).toBeUndefined();
+  });
+
+  test('a cd prefix counts only when it resolves to cwd', () => {
+    expect(matchCheck("cd '/work/repo/' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd sub && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /work/repo && bun test', ['bun test'])).toBeUndefined();
+  });
+
+  test('a cd that does not resolve to cwd is kept, so a declared check with that prefix still matches', () => {
+    expect(matchCheck('cd sub && bun test', ['cd sub && bun test'], '/work/repo')).toBe('cd sub && bun test');
+    expect(matchCheck('cd sub && bun test', ['bun test'], '/work/repo')).toBeUndefined();
+  });
+});
+
+describe('ledgerEntries rules', () => {
+  test('an intent from before the last request does not pair with a later result', () => {
+    expect(ledgerEntries([intent('a', 'edit', { path: 'x.ts' }), { kind: 'request' }, result('a')], [])).toEqual([]);
+  });
+
+  test('denied and not_started results never count, even when a snapshot names the call', () => {
+    const events: SessionEvent[] = [
+      intent('a', 'bash', { command: 'sed -i s/a/b/ x.ts' }),
+      result('a', 'denied'),
+      intent('b', 'bash', { command: 'make' }),
+      result('b', 'not_started'),
+      { kind: 'snapshot', callId: 'a', changed: ['x.ts'] },
+      { kind: 'snapshot', callId: 'b', changed: ['y.ts'] },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([]);
+  });
+
+  test('a snapshot after the result still applies, including on a failed bash call', () => {
+    const events: SessionEvent[] = [
+      intent('a', 'bash', { command: 'codegen' }),
+      result('a', 'failed', { isError: true, exitCode: 2 }),
+      { kind: 'snapshot', callId: 'a', changed: ['gen.ts'] },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', path: 'gen.ts' }]);
+  });
+
+  test('an empty snapshot gives no write, even for a completed edit', () => {
+    const events: SessionEvent[] = [intent('a', 'edit', { path: 'x.ts' }), result('a'), { kind: 'snapshot', callId: 'a', changed: [] }];
+    expect(ledgerEntries(events, [])).toEqual([]);
+  });
+
+  test('a failed edit with no snapshot is not a write; a failed non-read-only bash call is', () => {
+    const events: SessionEvent[] = [
+      intent('a', 'edit', { path: 'x.ts' }),
+      result('a', 'failed', { isError: true }),
+      intent('b', 'bash', { command: 'npm install' }),
+      result('b', 'failed', { isError: true, exitCode: 1 }),
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 3, tool: 'bash', command: 'npm install' }]);
+  });
+
+  test('several snapshots for one callId are merged in order', () => {
+    const events: SessionEvent[] = [
+      intent('a', 'bash', { command: 'gen' }),
+      result('a'),
+      { kind: 'snapshot', callId: 'a', changed: ['x.ts'] },
+      { kind: 'snapshot', callId: 'a', changed: ['y.ts', 'x.ts'] },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([
+      { kind: 'write', at: 1, tool: 'bash', path: 'x.ts' },
+      { kind: 'write', at: 1, tool: 'bash', path: 'y.ts' },
+      { kind: 'write', at: 1, tool: 'bash', path: 'x.ts' },
+    ]);
+  });
+
+  test('a snapshot without a callId names no call, so a completed edit still gives its own path', () => {
+    const events: SessionEvent[] = [intent('a', 'edit', { path: 'x.ts' }), result('a'), { kind: 'snapshot', changed: ['z.ts'] }];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'x.ts' }]);
+  });
+
+  test('cwd is passed through, so a cd to cwd before a check is a check', () => {
+    const events: SessionEvent[] = [intent('a', 'bash', { command: 'cd /work/repo && bun test' }), result('a')];
+    expect(ledgerEntries(events, ['bun test'], '/work/repo')).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+    expect(ledgerEntries(events, ['bun test'])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'cd /work/repo && bun test' }]);
+  });
+
+  test('a read-only bash call is not a write', () => {
+    expect(ledgerEntries([intent('a', 'bash', { command: 'git status' }), result('a')], [])).toEqual([]);
+  });
+
+  test('a check with no exit code and no isError is 0', () => {
+    expect(ledgerEntries([intent('a', 'bash', { command: 'bun test' }), result('a')], ['bun test'])).toEqual([
+      { kind: 'check', at: 1, command: 'bun test', exitCode: 0 },
+    ]);
+  });
+});
+
+describe('evidence and verified rules', () => {
+  const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+  const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+  test('evidence dedupes labels, keeps first-seen order, and marks everything unverified when no check passed', () => {
+    const entries = [w(1, 'b.ts'), w(2, 'a.ts'), w(3, 'b.ts'), c(4, 1)];
+    expect(evidence(entries)).toEqual({
+      changed: ['b.ts', 'a.ts'],
+      checks: [{ command: 'bun test', exitCode: 1 }],
+      unverified: ['b.ts', 'a.ts'],
+    });
+  });
+
+  test('verified is true with no checks or no writes', () => {
+    expect(verified([w(1, 'a.ts')], [])).toBe(true);
+    expect(verified([c(1, 1)], ['bun test'])).toBe(true);
+  });
+
+  test('verified agrees with evidence().unverified being empty, over seeded random logs', () => {
+    let seed = 42;
+    const rnd = () => {
+      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+      return seed / 0x7fffffff;
+    };
+    for (let k = 0; k < 200; k++) {
+      const entries: LedgerEntry[] = [];
+      const len = 1 + Math.floor(rnd() * 8);
+      for (let i = 0; i < len; i++) entries.push(rnd() < 0.5 ? w(i, `f${Math.floor(rnd() * 3)}.ts`) : c(i, rnd() < 0.5 ? 0 : 1));
+      if (!entries.some((e) => e.kind === 'write')) continue;
+      expect(verified(entries, ['x'])).toBe(evidence(entries).unverified.length === 0);
+    }
+  });
+});
