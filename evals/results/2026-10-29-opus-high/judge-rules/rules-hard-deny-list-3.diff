@@ -36,5 +36,65 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  if (argv.length === 0) return undefined;
+  const cmd = argv[0].split('/').pop();
+  if (cmd === 'git') return gitHit(argv.slice(1));
+  if (cmd === 'rm') return rmHit(argv.slice(1), cwd);
+  if (cmd === 'find') return findHit(argv.slice(1), cwd);
+  return undefined;
+}
+
+const GIT_VALUE_OPTS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+const PUSH_FORCE_FLAGS = ['--force', '--force-with-lease', '--mirror', '--delete', '--prune'];
+const FIND_DELETE_ACTIONS = new Set(['-delete', '-exec', '-execdir']);
+const FIND_NOARG_OPTS = new Set(['-H', '-L', '-P']);
+
+const isShortGroup = (w: string) => /^-[^-]/.test(w);
+
+// A long option, or a prefix of one: git and GNU getopt both accept unambiguous abbreviations.
+const longOpt = (w: string, names: string[]) => w.startsWith('--') && w.length > 2 && names.some(n => n.startsWith(w.split('=')[0]));
+
+// A word that cannot be resolved before the command runs: a shell variable or ~user.
+const unresolvable = (w: string) => w.includes('$') || /^~[^/]/.test(w);
+
+const isForcePush = (w: string) =>
+  longOpt(w, PUSH_FORCE_FLAGS) || (isShortGroup(w) && /[fd]/.test(w)) || w.startsWith('+') || w.startsWith(':');
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += GIT_VALUE_OPTS.has(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push' && rest.some(isForcePush))
+    return { name: 'force-push', reason: 'git push --force rewrites remote history' };
+  if (sub === 'reset' && rest.some(w => longOpt(w, ['--hard'])))
+    return { name: 'reset-hard', reason: 'git reset --hard discards uncommitted changes' };
+  const forced = rest.some(w => longOpt(w, ['--force']) || (isShortGroup(w) && w.includes('f')));
+  const dryRun = rest.some(w => w === '-n' || longOpt(w, ['--dry-run']));
+  if (sub === 'clean' && forced && !dryRun) return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  return undefined;
+}
+
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const before = dd < 0 ? args : args.slice(0, dd);
+  const after = dd < 0 ? [] : args.slice(dd + 1);
+  const flags = before.filter(w => w.startsWith('-'));
+  const recursive = flags.some(w => longOpt(w, ['--recursive']) || (isShortGroup(w) && /[rR]/.test(w)));
+  if (!recursive) return undefined;
+  const targets = [...before.filter(w => !w.startsWith('-')), ...after];
+  const bad = targets.length === 0 || targets.some(t => unresolvable(t) || sameDir(t, cwd) || !insideWorkspace(t, cwd));
+  return bad ? { name: 'rm-outside', reason: 'recursive rm must stay inside the working directory' } : undefined;
+}
+
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some(w => FIND_DELETE_ACTIONS.has(w))) return undefined;
+  let i = 0;
+  while (i < args.length && (FIND_NOARG_OPTS.has(args[i]) || /^-O\d+$/.test(args[i]) || args[i] === '-D'))
+    i += args[i] === '-D' ? 2 : 1;
+  const words = args.slice(i);
+  const end = words.findIndex(w => w.startsWith('-'));
+  const starts = end > 0 ? words.slice(0, end) : ['.'];
+  const bad = starts.some(p => unresolvable(p) || !insideWorkspace(p, cwd));
+  return bad ? { name: 'rm-outside', reason: 'find -delete or -exec must start inside the working directory' } : undefined;
 }
