+
+test('review fixes: names inside cwd that start with .., find start options, long option prefixes', () => {
+  expect(hit('rm -rf ..cache')).toBeUndefined();
+  expect(hit('rm -rf ../x')).toBe('rm-outside');
+  expect(denyListed(['find', '-L', '/etc', '-delete'], cwd)?.name).toBe('rm-outside');
+  expect(denyListed(['find', '-H', '/', '-exec', 'rm', '{}', ';'], cwd)?.name).toBe('rm-outside');
+  expect(denyListed(['find', '-O3', '-D', 'exec', '-P', '..', '-delete'], cwd)?.name).toBe('rm-outside');
+  expect(denyListed(['find', '-L', 'src', '-delete'], cwd)).toBeUndefined();
+  expect(denyListed(['find', '-L', '-delete'], cwd)).toBeUndefined();
+  expect(hit('rm --recurs /etc')).toBe('rm-outside');
+  expect(hit('rm --recurs src')).toBeUndefined();
+  expect(hit('git push --force-w origin x')).toBe('force-push');
+  expect(hit('git push --mirr')).toBe('force-push');
+  expect(hit('git push --progress origin x')).toBeUndefined();
+  expect(hit('git reset --har HEAD~1')).toBe('reset-hard');
+  expect(hit('git reset --soft HEAD~1')).toBeUndefined();
+  expect(hit('git clean --forc')).toBe('clean-force');
+  expect(hit('git clean --force --dry')).toBeUndefined();
+});
