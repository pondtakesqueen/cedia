diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.extra.test.ts b/sse.extra.test.ts
--- a/sse.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.extra.test.ts	2026-10-29 11:32:35.281465927 +0000
@@ -0,0 +1,56 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+test('the same messages at every chunk size as with the whole body in one chunk', async () => {
+  const inputs = [
+    'event: x\r\ndata: 1\r\n\r\n: c\r\ndata:  ใช่ 🙂\r\n\r\ndata:a\n\n',
+    'data: one\n\ndata: [DONE]',
+    'data:   three\ndata\nid: 1\n\nevent: e\ndata: last',
+  ];
+  for (const text of inputs) {
+    const whole = await all(text, 1 << 20);
+    for (let n = 1; n <= 16; n++) expect(await all(text, n)).toEqual(whole);
+  }
+});
+
+test('an error from the body rejects with the original error, after earlier messages', async () => {
+  let step = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (step++ === 0) c.enqueue(new TextEncoder().encode('data: a\n\n'));
+      else c.error(new Error('boom'));
+    },
+  });
+  const it = readSse(body);
+  expect(await it.next()).toEqual({ value: { data: 'a' }, done: false });
+  await expect(it.next()).rejects.toThrow('boom');
+});
+
+test('a 2 MB line split into 1-byte chunks yields one message in linear time', async () => {
+  const messages = await all('data: ' + 'x'.repeat(2_000_000) + '\n\n', 1);
+  expect(messages.length).toBe(1);
+  expect(messages[0].data.length).toBe(2_000_000);
+});
+
+test('stopping early cancels the body', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'a' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+});
