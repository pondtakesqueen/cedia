diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 09:55:25.337119377 +0000
@@ -0,0 +1,37 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('bulk tiers start at exactly 10 and 50 units', () => {
+    // 10 pens = 1200, 5% off = 60 -> 1140; shipping 800; tax 7% of 1940 = 135.8 -> 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+    // 50 pens = 6000, 10% off = 600 -> 5400; ships free; tax 7% of 5400 = 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('lines of the same sku are merged before the bulk discount', () => {
+    // 6 + 4 pens = one line of 10 pens, priced as above
+    const t = totals(cart('US', [['PEN', 6], ['PEN', 4]]));
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ sku: 'PEN', quantity: 10, discount: 60, total: 1140 });
+    expect(t).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('free shipping is judged on the subtotal after the coupon', () => {
+    // UK: 1 cap + 2 tees = 4200; SAVE10 -420 -> 3780 < 4000, pays 700; tax 20% of 4480 = 896
+    expect(totals(cart('UK', [['CAP', 1], ['TEE', 2]], 'SAVE10'))).toMatchObject({
+      subtotal: 4200, coupon: 420, shipping: 700, tax: 896, total: 5376,
+    });
+    // US: 2 bags + 2 mugs = 5300; FLAT5 -500 -> 4800 < 5000, pays 800; tax 7% of 5600 = 392
+    expect(totals(cart('US', [['BAG', 2], ['MUG', 2]], 'FLAT5'))).toMatchObject({
+      subtotal: 5300, coupon: 500, shipping: 800, tax: 392, total: 5992,
+    });
+  });
+
+  test('UK ships free from exactly 4000', () => {
+    // 1 bag + 1 cap + 5 pens = 2200 + 1200 + 600 = 4000; ships free; tax 20% of 4000 = 800
+    expect(totals(cart('UK', [['BAG', 1], ['CAP', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+  });
+});
