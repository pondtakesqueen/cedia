     expect('error' in r && r.error).not.toContain('appears');
   });
 });
+
+describe('more coverage', () => {
+  test('indentation tier: several windows match: error with their lines', () => {
+    const r = applyEdit('  a\n  b\n    a\n    b\n', { old_text: 'a\nb', new_text: 'c' });
+    expect('error' in r && r.error).toContain('matches 2 places');
+    expect('error' in r && r.error).toContain('1, 3');
+  });
+  test('not found lists at most five lines where the first line appears', () => {
+    const r = applyEdit('x\nx\nx\nx\nx\nx\nx\n', { old_text: 'x\ny', new_text: 'z' });
+    expect('error' in r && r.error).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect('error' in r && r.error).not.toContain('6');
+  });
+  test('an exact match wins over a trailing-space window', () => {
+    const r = ok(applyEdit('a \nb\n', { old_text: 'a', new_text: 'z' }));
+    expect(r.applied.tier).toBe('exact');
+    expect(r.content).toBe('z \nb\n');
+  });
+  test('exact replacement agrees with String.replace on random content', () => {
+    let seed = 42;
+    const rnd = (n: number) => {
+      seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
+      return seed % n;
+    };
+    let asserted = 0;
+    const words = ['a', 'b', 'ab', 'c', 'ba'];
+    const line = () => Array.from({ length: 1 + rnd(3) }, () => words[rnd(words.length)]).join(' ');
+    for (let t = 0; t < 300; t++) {
+      const content = Array.from({ length: 1 + rnd(8) }, line).join('\n') + '\n';
+      const from = rnd(content.split('\n').length - 1);
+      const old = content.split('\n').slice(from, from + 1 + rnd(2)).join('\n');
+      if (content.split(old).length !== 2) continue;
+      const neu = Array.from({ length: 1 + rnd(3) }, line).join('\n');
+      if (neu === old) continue;
+      const r = ok(applyEdit(content, { old_text: old, new_text: neu }));
+      expect(r.content).toBe(content.replace(old, neu));
+      expect(r.applied.tier).toBe('exact');
+      asserted++;
+    }
+    expect(asserted).toBeGreaterThanOrEqual(50);
+  });
+});
