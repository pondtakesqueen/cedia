diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.test.ts b/memo.test.ts
--- a/memo.test.ts	2026-10-29 09:50:53.968914088 +0000
+++ b/memo.test.ts	2026-10-29 09:51:51.873106689 +0000
@@ -66,3 +66,127 @@
   m("k");
   expect(calls).toHaveLength(2);
 });
+
+test("adding a key at max drops exactly the least recently used one", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("c");
+  expect(m.size).toBe(2);
+  m("b");
+  m("c");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+});
+
+test("a result in flight during clear is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  expect(m.size).toBe(0);
+  const second = m("k");
+  expect(calls).toHaveLength(2);
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+});
+
+test("a result in flight when its key is dropped for max is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("an old call's result does not replace a newer call's after invalidate", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[1]!.d.resolve("new");
+  await tick();
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(await second).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("an old call's rejection does not forget a newer call after invalidate", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("old"));
+  await expect(first).rejects.toThrow("old");
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection reaches every waiting caller and is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(a).rejects.toThrow("boom");
+  await expect(b).rejects.toThrow("boom");
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a call answered from the cache makes its key most recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  expect(await m("a")).toBe("a");
+  m("c");
+  m("a");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("expired keys are not counted as kept and do not push out live ones", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 50;
+  m("b");
+  calls[1]!.d.resolve("b");
+  await tick();
+  t = 60;
+  expect(await m("a")).toBe("a"); // a is now the most recently used, but expires first
+  t = 120;
+  expect(m.size).toBe(1);
+  m("c");
+  expect(await m("b")).toBe("b");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+});
+
+test("fn throwing synchronously gives a rejected promise and keeps the cache as it was", async () => {
+  const fn = (key: string) => {
+    if (key === "bad") throw new Error("sync");
+    return Promise.resolve(key);
+  };
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  expect(await m("a")).toBe("a");
+  await expect(m("bad")).rejects.toThrow("sync");
+  expect(m.size).toBe(1);
+});
