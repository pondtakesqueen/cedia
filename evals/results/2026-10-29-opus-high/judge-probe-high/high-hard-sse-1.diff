   expect((await it.next()).done).toBe(true);
 });
+
+test('stopping early cancels the body and releases the lock', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'a' });
+    break;
+  }
+  expect(cancelled).toBe(true);
+  expect(body.locked).toBe(false);
+});
+
+test('a failing cancel is reported, and the lock is still released', async () => {
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+    },
+    cancel() {
+      throw new Error('cancel failed');
+    },
+  });
+  const it = readSse(body);
+  expect((await it.next()).value).toEqual({ data: 'a' });
+  await expect(it.return(undefined)).rejects.toThrow('cancel failed');
+  expect(body.locked).toBe(false);
+});
+
+test('a read error releases the lock', async () => {
+  const body = new ReadableStream<Uint8Array>({
+    pull() {
+      throw new Error('boom');
+    },
+  });
+  await expect(readSse(body).next()).rejects.toThrow('boom');
+  expect(body.locked).toBe(false);
+});
