+  const norm = (s: string) => s.trim().replace(/\s+/g, ' ').replace(/ 2>&1$/, '').trim();
+  let cmd = norm(command);
+  const cd = /^cd (\S+|"[^"]*"|'[^']*') && (.*)$/.exec(cmd);
+  if (cd) {
+    if (cwd === undefined || resolve(cwd, cd[1]!.replace(/["']/g, '')) !== resolve(cwd)) return undefined;
+    cmd = cd[2]!;
+  }
+  return checks.find((c) => norm(c) === cmd);
