+++ b/ledger.review.test.ts	2026-10-29 09:23:33.796590786 +0000
@@ -0,0 +1,19 @@
+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, type SessionEvent } from './ledger.ts';
+
+describe('review findings', () => {
+  test('a glued 2>&1 is not the check: test2 is a different word', () => {
+    expect(matchCheck('bun test2>&1', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test 2>&1', ['bun test'])).toBe('bun test');
+  });
+
+  test('an edit with no path is not labelled bash: undefined', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'e', tool: 'edit', input: {} },
+      { kind: 'tool_result', callId: 'e', status: 'completed', output: { isError: false } },
+    ];
+    const labels = evidence(ledgerEntries(events, [])).changed;
+    expect(labels).not.toContain('bash: undefined');
+    expect(labels).toEqual(['edit']);
+  });
+});
