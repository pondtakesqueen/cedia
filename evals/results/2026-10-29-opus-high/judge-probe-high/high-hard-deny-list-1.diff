diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.edge.test.ts b/deny.edge.test.ts
--- a/deny.edge.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.edge.test.ts	2026-10-29 09:18:44.848988574 +0000
@@ -0,0 +1,19 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('find options before the start path are skipped', () => {
+  expect(hit(['find', '-L', '/', '-delete'])).toBe('rm-outside');
+  expect(hit(['find', '-H', '/', '-exec', 'rm', '{}', ';'])).toBe('rm-outside');
+  expect(hit(['find', '-P', 'src', '-delete'])).toBeUndefined();
+  expect(hit(['find', '-O3', '/', '-delete'])).toBe('rm-outside');
+  expect(hit(['find', '-D', 'tree', '/', '-delete'])).toBe('rm-outside');
+  expect(hit(['find', '-O3', 'src', '-delete'])).toBeUndefined();
+  expect(hit(['find', '-O3', '-D', 'tree', '/', '-delete'])).toBe('rm-outside');
+});
+
+test('an empty word is a target that resolves to cwd', () => {
+  expect(hit(['rm', '-rf', ''])).toBe('rm-outside');
+});
