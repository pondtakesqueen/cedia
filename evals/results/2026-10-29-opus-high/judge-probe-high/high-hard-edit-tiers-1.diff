diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-29 09:18:52.017996833 +0000
+++ b/edit.ts	2026-10-29 09:22:01.225000247 +0000
@@ -23,5 +23,79 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: next, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create or replace a file' };
+  if (old === next) return { error: 'old_text and new_text are the same' };
+
+  const lineAt = (idx: number) => content.slice(0, idx).split('\n').length;
+
+  const hits: number[] = [];
+  for (let idx = content.indexOf(old); idx !== -1; idx = content.indexOf(old, idx + old.length)) hits.push(idx);
+  if (hits.length > 1 && !replace_all) {
+    return { error: `old_text matches ${hits.length} places (first at line ${lineAt(hits[0])}); add context or set replace_all` };
+  }
+  if (hits.length > 0) {
+    const first = hits[0];
+    const result = replace_all
+      ? content.split(old).join(next)
+      : content.slice(0, first) + next + content.slice(first + old.length);
+    const applied = { from: lineAt(first), to: lineAt(first + old.length - 1), tier: 'exact' as const, count: replace_all ? hits.length : 1 };
+    return { content: result, applied };
+  }
+
+  const stripNl = (s: string) => (s.endsWith('\n') ? s.slice(0, -1) : s);
+  const oldLines = stripNl(old).split('\n');
+  const newLines = stripNl(next) === '' ? [] : stripNl(next).split('\n');
+  const firstNonBlank = (ls: string[]) => ls.find((l) => l.trim() !== '') ?? '';
+  const indentOf = (s: string) => s.match(/^\s*/)![0];
+
+  // lines[realCount..] is not content: a trailing newline leaves an empty last element, kept as is on rejoin.
+  const lines = content.split('\n');
+  const realCount = content.endsWith('\n') ? lines.length - 1 : lines.length;
+
+  const tryTier = (
+    norm: (s: string) => string,
+    replacement: (i: number) => string[],
+    tier: Tier,
+  ): ReturnType<typeof applyEdit> | null => {
+    const starts: number[] = [];
+    for (let i = 0; i + oldLines.length <= realCount; i++) {
+      if (oldLines.every((o, k) => norm(lines[i + k]) === norm(o))) starts.push(i);
+    }
+    if (starts.length > 1) {
+      return { error: `old_text matches ${starts.length} places (${tier}) at lines ${starts.map((s) => s + 1).join(', ')}` };
+    }
+    if (starts.length === 0) return null;
+    const i = starts[0];
+    const eol = lines[i + oldLines.length - 1].endsWith('\r') ? '\r' : '';
+    lines.splice(i, oldLines.length, ...replacement(i).map((l) => l.replace(/\r$/, '') + eol));
+    return { content: lines.join('\n'), applied: { from: i + 1, to: i + oldLines.length, tier, count: 1 } };
+  };
+
+  const trailing = tryTier((s) => s.trimEnd(), () => newLines, 'trailing-space');
+  if (trailing) return trailing;
+
+  const oi = indentOf(firstNonBlank(oldLines));
+  const indented = tryTier(
+    (s) => s.trim(),
+    (i) => {
+      const wi = indentOf(firstNonBlank(lines.slice(i, i + oldLines.length)));
+      return newLines.map((l) => {
+        if (l.trim() === '') return '';
+        if (l.startsWith(oi)) return wi + l.slice(oi.length);
+        const li = indentOf(l);
+        // shallower than old_text's first line: keep the shift in columns
+        if (oi.startsWith(li)) return wi.slice(0, Math.max(0, wi.length - (oi.length - li.length))) + l.slice(li.length);
+        return wi + l.trimStart();
+      });
+    },
+    'indentation',
+  );
+  if (indented) return indented;
+
+  const first = firstNonBlank(oldLines).trim();
+  const appears = first
+    ? lines.slice(0, realCount).flatMap((l, i) => (l.includes(first) ? [i + 1] : [])).slice(0, 5)
+    : [];
+  return { error: 'old_text not found' + (appears.length ? `; first line appears at line ${appears.join(', ')}` : '') };
 }
