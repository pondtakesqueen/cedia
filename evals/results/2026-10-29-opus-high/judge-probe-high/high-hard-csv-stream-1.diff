+++ b/csv.ts	2026-10-29 09:17:47.972985193 +0000
@@ -50,3 +50,92 @@
   rows.push(row);
   return rows;
 }
+
+/**
+ * parseCsv for input that comes in chunks: the same rows, where `push` returns each row once its row end has arrived
+ * and `end` returns the last one. Every character is handled once, so a chunk costs what it holds.
+ */
+export class CsvStream {
+  private state: "start" | "plain" | "quoted" | "quote" | "closed" = "start";
+  private row: string[] = [];
+  private field = "";
+  // a `\r` was read outside quotes; whether it ends the row depends on the next character
+  private cr = false;
+  private begun = false;
+  // the current row has input in it
+  private rowOpen = false;
+
+  push(chunk: string): string[][] {
+    const rows: string[][] = [];
+    for (let i = 0; i < chunk.length; i++) {
+      const c = chunk[i]!;
+      if (!this.begun) {
+        this.begun = true;
+        if (c === "\uFEFF") continue;
+      }
+      this.rowOpen = true;
+      if (this.cr) {
+        this.cr = false;
+        if (c === "\n") {
+          this.endRow(rows);
+          continue;
+        }
+        if (this.state === "closed") throw new SyntaxError('unexpected "\\r" after a closing quote');
+        this.field += "\r";
+        this.state = "plain";
+      }
+      this.step(c, rows);
+    }
+    return rows;
+  }
+
+  end(): string[][] {
+    if (this.cr) {
+      if (this.state === "closed") throw new SyntaxError('unexpected "\\r" after a closing quote');
+      this.cr = false;
+      this.field += "\r";
+    }
+    if (this.state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+    if (!this.rowOpen) return [];
+    this.endField();
+    const row = this.row;
+    this.row = [];
+    this.rowOpen = false;
+    return [row];
+  }
+
+  private step(c: string, rows: string[][]): void {
+    if (this.state === "quoted") {
+      if (c === '"') this.state = "quote";
+      else this.field += c;
+    } else if (this.state === "quote" && c === '"') {
+      this.field += c;
+      this.state = "quoted";
+    } else {
+      if (this.state === "quote") this.state = "closed";
+      if (c === "\n") this.endRow(rows);
+      else if (c === "\r") this.cr = true;
+      else if (c === ",") this.endField();
+      else if (this.state === "start" && c === '"') this.state = "quoted";
+      else if (this.state === "closed") throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote`);
+      else if (c === '"') throw new SyntaxError("a quote in a field that is not quoted");
+      else {
+        this.field += c;
+        this.state = "plain";
+      }
+    }
+  }
+
+  private endField(): void {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "start";
+  }
+
+  private endRow(rows: string[][]): void {
+    this.endField();
+    rows.push(this.row);
+    this.row = [];
+    this.rowOpen = false;
+  }
+}
