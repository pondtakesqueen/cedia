--- a/csv.test.ts	2026-10-29 09:16:04.104369938 +0000
+++ b/csv.test.ts	2026-10-29 09:19:23.944898567 +0000
@@ -23,3 +23,112 @@
   expect(s.push("d")).toEqual([]);
   expect(s.end()).toEqual([["c", "d"]]);
 });
+
+// Every way to cut `text` into chunks: one character at a time with empty chunks between, and every cut into three.
+function chunkings(text: string): string[][] {
+  const all = [[text], text.split("").flatMap((c) => ["", c])];
+  for (let a = 0; a <= text.length; a++) {
+    for (let b = a; b <= text.length; b++) all.push([text.slice(0, a), text.slice(a, b), text.slice(b)]);
+  }
+  return all;
+}
+
+function streamed(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const chunk of chunks) for (const row of s.push(chunk)) rows.push(row);
+  for (const row of s.end()) rows.push(row);
+  return rows;
+}
+
+const corpus = [
+  "",
+  "\uFEFF",
+  "\uFEFFa",
+  "a\uFEFF",
+  "\uFEFF\n",
+  "\n",
+  "\r\n",
+  "\r",
+  "a\rb",
+  "a\r",
+  "\r,\r",
+  "a,",
+  ",\n,",
+  "a\n\nb",
+  "a,b\r\nc\n",
+  '"x,""y""",z\n',
+  '""',
+  '""""',
+  '"a""',
+  '"a"\r\n',
+  '"a"\rb',
+  '"a"\r',
+  '"a\r\nb"',
+  '"a\rb"',
+  '"a"b',
+  'a"b',
+  '"open',
+];
+
+for (const text of corpus) {
+  test(`streams ${JSON.stringify(text)} like parseCsv, whatever the chunks`, () => {
+    let expected: string[][] | undefined;
+    try {
+      expected = parseCsv(text);
+    } catch (e) {
+      expect(e).toBeInstanceOf(SyntaxError);
+    }
+    for (const chunks of chunkings(text)) {
+      if (expected) expect(streamed(chunks)).toEqual(expected);
+      else expect(() => streamed(chunks)).toThrow(SyntaxError);
+    }
+  });
+}
+
+test("a carriage return waits for the next character before it ends a row", () => {
+  const s = new CsvStream();
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\nb")).toEqual([["a"]]);
+  expect(s.end()).toEqual([["b"]]);
+});
+
+test("a byte order mark after an empty chunk is still dropped", () => {
+  const s = new CsvStream();
+  expect(s.push("")).toEqual([]);
+  expect(s.push("\uFEFFa")).toEqual([]);
+  expect(s.end()).toEqual([["a"]]);
+});
+
+test("the work for a chunk does not grow with the input before it", () => {
+  const s = new CsvStream();
+  let rows = 0;
+  for (let i = 0; i < 200_000; i++) rows += s.push("x,y\n").length;
+  rows += s.end().length;
+  expect(rows).toBe(200_000);
+});
+
+test("a quoted field left open across many chunks keeps all of its content", () => {
+  const s = new CsvStream();
+  let early = s.push('"').length;
+  for (let i = 0; i < 200_000; i++) early += s.push("ab,\n").length;
+  early += s.push('"').length;
+  expect(early).toBe(0);
+  expect(s.end()).toEqual([["ab,\n".repeat(200_000)]]);
+});
+
+test("a field left open across many chunks keeps all of its content", () => {
+  const s = new CsvStream();
+  let early = s.push("x").length;
+  for (let i = 0; i < 200_000; i++) early += s.push("ab").length;
+  expect(early).toBe(0);
+  expect(s.end()).toEqual([["x" + "ab".repeat(200_000)]]);
+});
+
+test("a carriage return left pending across many chunks keeps its place in the field", () => {
+  const s = new CsvStream();
+  let early = s.push("a").length;
+  for (let i = 0; i < 200_000; i++) early += s.push("\r").length;
+  expect(early).toBe(0);
+  expect(s.end()).toEqual([["a" + "\r".repeat(200_000)]]);
+});
