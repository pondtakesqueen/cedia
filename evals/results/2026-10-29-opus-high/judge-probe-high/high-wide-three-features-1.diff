@@ -14,30 +14,80 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+interface Entry<V> {
+  value: V;
+  expires: number;
+}
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Map iteration order is the recency order: the first key is the least recently used.
+  private entries = new Map<K, Entry<V>>();
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
-  }
+  constructor(
+    private capacity: number,
+    private ttlMs: number,
+    private now: () => number = Date.now,
+  ) {}
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (entry === undefined) return undefined;
+    this.entries.delete(key);
+    if (this.isExpired(entry)) {
+      this.onEvict?.(key, entry.value, 'expired');
+      return undefined;
+    }
+    this.entries.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.entries.delete(key);
+    this.entries.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, entry] of this.entries) {
+      if (this.isExpired(entry)) {
+        this.entries.delete(k);
+        this.onEvict?.(k, entry.value, 'expired');
+      }
+    }
+    while (this.entries.size > this.capacity) {
+      const [k, entry] = this.entries.entries().next().value!;
+      this.entries.delete(k);
+      this.onEvict?.(k, entry.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (entry === undefined) return false;
+    this.entries.delete(key);
+    if (this.isExpired(entry)) {
+      this.onEvict?.(key, entry.value, 'expired');
+      return false;
+    }
+    this.onEvict?.(key, entry.value, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let count = 0;
+    for (const entry of this.entries.values()) {
+      if (!this.isExpired(entry)) count++;
+    }
+    return count;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const live: K[] = [];
+    for (const [k, entry] of this.entries) {
+      if (!this.isExpired(entry)) live.push(k);
+    }
+    return live.reverse();
+  }
+
+  private isExpired(entry: Entry<V>): boolean {
+    return this.now() >= entry.expires;
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 09:26:48.465285885 +0000
+++ b/src/slug.ts	2026-10-29 09:29:36.629027318 +0000
@@ -11,10 +11,26 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (s[max] === '-') return s.slice(0, max);
+  const cut = s.slice(0, max);
+  const i = cut.lastIndexOf('-');
+  return i > 0 ? cut.slice(0, i) : cut;
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 09:28:16.781022571 +0000
@@ -0,0 +1,49 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parseDuration reads every unit and combinations', () => {
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('2d 4h')).toBe(2 * 86_400_000 + 4 * 3_600_000);
+  expect(parseDuration('1h 30m')).toBe(5_400_000);
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('1m30s')).toBe(90_000);
+});
+
+test('parseDuration ignores spaces around the whole text only', () => {
+  expect(parseDuration(' 90s ')).toBe(90_000);
+  expect(parseDuration('\t90s\n')).toBe(90_000);
+  expect(() => parseDuration('1 h')).toThrow('"1 h"');
+});
+
+test('parseDuration rounds to whole milliseconds', () => {
+  expect(parseDuration('1.5ms')).toBe(2);
+  expect(parseDuration('0.0004s')).toBe(0);
+});
+
+test('parseDuration rejects malformed text and names the input', () => {
+  for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '+1s', '1e3s', '1h,30m', '1.s', '1s-']) {
+    expect(() => parseDuration(bad)).toThrow(`${JSON.stringify(bad)}`);
+  }
+});
+
+test('formatDuration uses largest units first and leaves zero parts out', () => {
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(250)).toBe('250ms');
+  expect(formatDuration(86_400_000)).toBe('1d');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(3_600_000 * 25)).toBe('1d1h');
+});
+
+test('formatDuration throws on negative or non-finite input', () => {
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(NaN)).toThrow();
+  expect(() => formatDuration(Infinity)).toThrow();
+});
+
+test('formatDuration output parses back to the same value', () => {
+  for (const ms of [0, 1, 999, 1_000, 61_000, 5_400_000, 90_061_001, 7 * 86_400_000 + 5]) {
+    expect(parseDuration(formatDuration(ms))).toBe(ms);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 09:28:28.181023249 +0000
@@ -0,0 +1,150 @@
+import { expect, test } from 'bun:test';
+import { EvictReason, LRU } from '../src/lru.ts';
+
+function recorder<K, V>(cache: LRU<K, V>) {
+  const evicted: [K, V, EvictReason][] = [];
+  cache.onEvict = (key, value, reason) => evicted.push([key, value, reason]);
+  return evicted;
+}
+
+test('an entry set at t is live while now() < t + ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 999;
+  expect(cache.get('a')).toBe(1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('get refreshes recency, so the untouched entry is evicted', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(evicted).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('capacity eviction removes the least recently used entry first', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  cache.set('d', 4);
+  expect(evicted).toEqual([
+    ['a', 1, 'capacity'],
+    ['b', 2, 'capacity'],
+  ]);
+  expect(cache.keys()).toEqual(['d', 'c']);
+});
+
+test('an expired entry is evicted before a live one, and only once', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1000;
+  cache.set('c', 3);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('expired entries count toward capacity until they are removed', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(1, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  t = 1000;
+  cache.set('b', 2);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+  expect(cache.size).toBe(1);
+});
+
+test('an expired entry stays stored while the cache is within capacity', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(3, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  t = 1000;
+  cache.set('b', 2);
+  expect(evicted).toEqual([]);
+  expect(cache.size).toBe(1);
+});
+
+test('get on an expired entry evicts it with reason expired', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.get('a')).toBeUndefined();
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+});
+
+test('delete returns true and reports delete for a live entry', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  expect(cache.delete('a')).toBe(true);
+  expect(cache.delete('a')).toBe(false);
+  expect(evicted).toEqual([['a', 1, 'delete']]);
+});
+
+test('delete of an expired entry returns false and reports expired', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  t = 1000;
+  expect(cache.delete('a')).toBe(false);
+  expect(evicted).toEqual([['a', 1, 'expired']]);
+});
+
+test('size and keys leave out expired entries and do not evict them', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('b', 2);
+  t = 1000;
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(evicted).toEqual([]);
+});
+
+test('setting a key again refreshes its ttl and makes it most recent', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const evicted = recorder(cache);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  t = 500;
+  cache.set('a', 10);
+  expect(evicted).toEqual([]);
+  expect(cache.keys()).toEqual(['a', 'b']);
+  t = 1200;
+  expect(cache.get('a')).toBe(10);
+  expect(cache.get('b')).toBeUndefined();
+});
+
+test('keys lists live keys most recently used first', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  cache.get('a');
+  expect(cache.keys()).toEqual(['a', 'c', 'b']);
+  expect(cache.size).toBe(3);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 09:29:32.597027078 +0000
@@ -0,0 +1,54 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify lowers case and drops diacritics', () => {
+  expect(slugify('Łódź')).toBe('lodz');
+  expect(slugify('piñata ça')).toBe('pinata-ca');
+  expect(slugify('Đà Nẵng')).toBe('da-nang');
+});
+
+test('slugify expands letters without a plain ASCII form', () => {
+  expect(slugify('Straße')).toBe('strasse');
+  expect(slugify('ẞ')).toBe('ss');
+  expect(slugify('Ærø')).toBe('aero');
+  expect(slugify('Œuvre')).toBe('oeuvre');
+});
+
+test('slugify treats non-diacritic symbols and compatibility forms as separators', () => {
+  expect(slugify('m² area')).toBe('m-area');
+  expect(slugify('ﬁne')).toBe('ne');
+  expect(slugify('Ｈello')).toBe('ello');
+  expect(slugify('½ cup')).toBe('cup');
+  expect(slugify('a①b')).toBe('a-b');
+  expect(slugify('m² ﬁne Ｈ')).toBe('m-ne');
+});
+
+test('slugify makes runs of other characters one dash and trims the ends', () => {
+  expect(slugify('--Hi--')).toBe('hi');
+  expect(slugify('a & b  /  c')).toBe('a-b-c');
+  expect(slugify('x_y.z')).toBe('x-y-z');
+});
+
+test('slugify returns an empty slug when nothing is left', () => {
+  expect(slugify('')).toBe('');
+  expect(slugify('!!! ???')).toBe('');
+});
+
+test('slugify with max keeps the result within max and never ends with a dash', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+  expect(slugify('ab-cdefgh', 5)).toBe('ab');
+  expect(slugify('abcde-fgh', 5)).toBe('abcde');
+  expect(slugify('abcd-ef', 5)).toBe('abcd');
+  expect(slugify('ab-cd-ef', 8)).toBe('ab-cd-ef');
+  expect(slugify('abc', 3)).toBe('abc');
+  expect(slugify('a-b', 1)).toBe('a');
+  expect(slugify('ab-cd', 0)).toBe('');
+});
+
+test('uniqueSlug returns the slug when free, else the first free numbered one', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['post']))).toBe('post-2');
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+});
