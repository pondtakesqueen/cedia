@@ -7,10 +7,41 @@
 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNITS: [string, number][] = [
+  ['d', 86_400_000],
+  ['h', 3_600_000],
+  ['m', 60_000],
+  ['s', 1_000],
+  ['ms', 1],
+];
+const UNIT_MS = new Map(UNITS);
+
+// "ms" must come before "m" so the longer unit wins.
+const PART = /(\d+(?:\.\d+)?)(ms|d|h|m|s) */y;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const fail = () => new Error(`invalid duration: ${JSON.stringify(text)}`);
+  const s = text.trim();
+  if (s === '') throw fail();
+  let total = 0;
+  PART.lastIndex = 0;
+  while (PART.lastIndex < s.length) {
+    const match = PART.exec(s);
+    if (!match) throw fail();
+    total += Number(match[1]) * UNIT_MS.get(match[2])!;
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const [unit, size] of UNITS) {
+    const n = Math.floor(rest / size);
+    if (n > 0) out += `${n}${unit}`;
+    rest -= n * size;
+  }
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
--- a/src/lru.ts	2026-10-29 09:55:50.858972981 +0000
+++ b/src/lru.ts	2026-10-29 09:56:36.687342694 +0000
@@ -14,30 +14,78 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+interface Entry<V> {
+  value: V;
+  expiresAt: number;
+}
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
-  }
+  // Map iteration order is insertion order, so the first entry is the least recently used.
+  private entries = new Map<K, Entry<V>>();
+
+  constructor(
+    private capacity: number,
+    private ttlMs: number,
+    private now: () => number = Date.now,
+  ) {}
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return undefined;
+    if (!this.isLive(entry)) {
+      this.remove(key, entry, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, entry);
+    return entry.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const old = this.entries.get(key);
+    if (old) {
+      if (this.isLive(old)) this.entries.delete(key);
+      else this.remove(key, old, 'expired');
+    }
+    this.entries.set(key, { value, expiresAt: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, entry] of this.entries) {
+      if (!this.isLive(entry)) this.remove(k, entry, 'expired');
+    }
+    for (const [k, entry] of this.entries) {
+      if (this.entries.size <= this.capacity) break;
+      this.remove(k, entry, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const entry = this.entries.get(key);
+    if (!entry) return false;
+    const live = this.isLive(entry);
+    this.remove(key, entry, live ? 'delete' : 'expired');
+    return live;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const entry of this.entries.values()) if (this.isLive(entry)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const keys: K[] = [];
+    for (const [k, entry] of this.entries) if (this.isLive(entry)) keys.push(k);
+    return keys.reverse();
+  }
+
+  private isLive(entry: Entry<V>): boolean {
+    return this.now() < entry.expiresAt;
+  }
+
+  private remove(key: K, entry: Entry<V>, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, entry.value, reason);
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 09:55:50.859034788 +0000
+++ b/src/slug.ts	2026-10-29 09:56:36.685266494 +0000
@@ -11,10 +11,27 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  let slug = text
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max !== undefined && slug.length > max) {
+    if (slug[max] === '-') return slug.slice(0, max);
+    const cut = slug.lastIndexOf('-', max - 1);
+    slug = slug.slice(0, cut > 0 ? cut : max);
+  }
+  return slug;
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 09:57:09.649125578 +0000
@@ -0,0 +1,58 @@
+import { describe, expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+describe('parseDuration', () => {
+  test('each unit', () => {
+    expect(parseDuration('2d')).toBe(172_800_000);
+    expect(parseDuration('3h')).toBe(10_800_000);
+    expect(parseDuration('4m')).toBe(240_000);
+    expect(parseDuration('5s')).toBe(5_000);
+    expect(parseDuration('250ms')).toBe(250);
+  });
+
+  test('fractions, rounded to whole milliseconds', () => {
+    expect(parseDuration('1.5h')).toBe(5_400_000);
+    expect(parseDuration('0.1s')).toBe(100);
+    expect(parseDuration('1.5ms')).toBe(2);
+    expect(parseDuration('0.4ms')).toBe(0);
+  });
+
+  test('several parts, with or without spaces', () => {
+    expect(parseDuration('2d 4h')).toBe(187_200_000);
+    expect(parseDuration('1h30m')).toBe(5_400_000);
+    expect(parseDuration('1m 30s 250ms')).toBe(90_250);
+    expect(parseDuration('1m30s250ms')).toBe(90_250);
+  });
+
+  test('spaces around the whole text are ignored', () => {
+    expect(parseDuration('  90s  ')).toBe(90_000);
+  });
+
+  test('rejects anything else with the input in the message', () => {
+    for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '1.s', '5 s', '1h-30m', '1h,30m', 'ms']) {
+      expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+    }
+  });
+});
+
+describe('formatDuration', () => {
+  test('largest unit first, zero parts left out', () => {
+    expect(formatDuration(1_500)).toBe('1s500ms');
+    expect(formatDuration(0)).toBe('0s');
+    expect(formatDuration(250)).toBe('250ms');
+    expect(formatDuration(86_400_000)).toBe('1d');
+    expect(formatDuration(86_400_000 + 1)).toBe('1d1ms');
+    expect(formatDuration(187_200_000)).toBe('2d4h');
+    expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  });
+
+  test('round trips with parseDuration', () => {
+    for (const ms of [1, 999, 60_000, 5_400_000, 90_061_001]) {
+      expect(parseDuration(formatDuration(ms))).toBe(ms);
+    }
+  });
+
+  test('throws on a negative number', () => {
+    expect(() => formatDuration(-1)).toThrow();
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 09:57:09.653125578 +0000
@@ -0,0 +1,156 @@
+import { describe, expect, test } from 'bun:test';
+import { type EvictReason, LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  const clock = { t: 0 };
+  const cache = new LRU<string, number>(capacity, ttl, () => clock.t);
+  const evicted: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => evicted.push([k, v, r]);
+  return { clock, cache, evicted };
+}
+
+describe('LRU', () => {
+  test('get hit makes the entry most recently used', () => {
+    const { cache, evicted } = setup(2, 1000);
+    cache.set('a', 1);
+    cache.set('b', 2);
+    expect(cache.get('a')).toBe(1);
+    expect(cache.keys()).toEqual(['a', 'b']);
+    cache.set('c', 3);
+    expect(evicted).toEqual([['b', 2, 'capacity']]);
+    expect(cache.keys()).toEqual(['c', 'a']);
+  });
+
+  test('missing key', () => {
+    const { cache, evicted } = setup(2, 1000);
+    expect(cache.get('x')).toBeUndefined();
+    expect(cache.delete('x')).toBe(false);
+    expect(evicted).toEqual([]);
+  });
+
+  test('live while now < t + ttl; get removes expired with reason expired', () => {
+    const { clock, cache, evicted } = setup(2, 1000);
+    cache.set('a', 1);
+    clock.t = 999;
+    expect(cache.get('a')).toBe(1);
+    clock.t = 1000;
+    expect(cache.get('a')).toBeUndefined();
+    expect(evicted).toEqual([['a', 1, 'expired']]);
+    expect(cache.get('a')).toBeUndefined();
+    expect(evicted.length).toBe(1);
+  });
+
+  test('a get does not refresh the ttl, a set does', () => {
+    const { clock, cache } = setup(2, 1000);
+    cache.set('a', 1);
+    clock.t = 500;
+    cache.get('a');
+    clock.t = 1000;
+    expect(cache.get('a')).toBeUndefined();
+    cache.set('b', 2);
+    clock.t = 1500;
+    cache.set('b', 3);
+    clock.t = 2400;
+    expect(cache.get('b')).toBe(3);
+  });
+
+  test('set on an existing key replaces it as most recently used without eviction', () => {
+    const { cache, evicted } = setup(2, 1000);
+    cache.set('a', 1);
+    cache.set('b', 2);
+    cache.set('a', 10);
+    expect(cache.keys()).toEqual(['a', 'b']);
+    expect(evicted).toEqual([]);
+    cache.set('c', 3);
+    expect(evicted).toEqual([['b', 2, 'capacity']]);
+    expect(cache.get('a')).toBe(10);
+  });
+
+  test('capacity counts expired entries; expired ones are removed before live ones', () => {
+    const { clock, cache, evicted } = setup(3, 1000);
+    cache.set('a', 1);
+    clock.t = 500;
+    cache.set('b', 2);
+    cache.set('c', 3);
+    clock.t = 1000; // a has expired
+    cache.get('b'); // b is now most recent; c is the least recently used live entry
+    cache.set('d', 4);
+    expect(evicted).toEqual([['a', 1, 'expired']]);
+    expect(cache.keys()).toEqual(['d', 'b', 'c']);
+  });
+
+  test('all expired entries go before any live one is evicted', () => {
+    const { clock, cache, evicted } = setup(3, 1000);
+    cache.set('a', 1);
+    cache.set('b', 2);
+    clock.t = 600;
+    cache.set('c', 3);
+    clock.t = 1000; // a and b expired
+    cache.set('d', 4);
+    expect(evicted).toEqual([
+      ['a', 1, 'expired'],
+      ['b', 2, 'expired'],
+    ]);
+    expect(cache.keys()).toEqual(['d', 'c']);
+  });
+
+  test('expired entries are not removed while under capacity', () => {
+    const { clock, cache, evicted } = setup(3, 1000);
+    cache.set('a', 1);
+    clock.t = 1000;
+    cache.set('b', 2);
+    expect(evicted).toEqual([]);
+    expect(cache.size).toBe(1);
+  });
+
+  test('a live entry is evicted when nothing has expired', () => {
+    const { clock, cache, evicted } = setup(2, 1000);
+    cache.set('a', 1);
+    clock.t = 100;
+    cache.set('b', 2);
+    cache.set('c', 3);
+    expect(evicted).toEqual([['a', 1, 'capacity']]);
+  });
+
+  test('delete', () => {
+    const { clock, cache, evicted } = setup(3, 1000);
+    cache.set('a', 1);
+    clock.t = 500;
+    cache.set('b', 2);
+    expect(cache.delete('b')).toBe(true);
+    expect(evicted).toEqual([['b', 2, 'delete']]);
+    expect(cache.delete('b')).toBe(false);
+    clock.t = 1000;
+    expect(cache.delete('a')).toBe(false);
+    expect(evicted).toEqual([
+      ['b', 2, 'delete'],
+      ['a', 1, 'expired'],
+    ]);
+    expect(cache.delete('a')).toBe(false);
+    expect(evicted.length).toBe(2);
+  });
+
+  test('size and keys only count live entries', () => {
+    const { clock, cache } = setup(3, 1000);
+    cache.set('a', 1);
+    clock.t = 500;
+    cache.set('b', 2);
+    cache.set('c', 3);
+    expect(cache.size).toBe(3);
+    expect(cache.keys()).toEqual(['c', 'b', 'a']);
+    clock.t = 1000;
+    expect(cache.size).toBe(2);
+    expect(cache.keys()).toEqual(['c', 'b']);
+    clock.t = 1500;
+    expect(cache.size).toBe(0);
+    expect(cache.keys()).toEqual([]);
+  });
+
+  test('works without onEvict', () => {
+    const cache = new LRU<string, number>(1, 1000, () => 0);
+    cache.set('a', 1);
+    cache.set('b', 2);
+    expect(cache.delete('b')).toBe(true);
+    expect(cache.size).toBe(0);
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 09:57:09.652575675 +0000
@@ -0,0 +1,52 @@
+import { describe, expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+describe('slugify', () => {
+  test('lower case', () => {
+    expect(slugify('ABC Def')).toBe('abc-def');
+  });
+
+  test('diacritics are removed', () => {
+    expect(slugify('à ç ñ ź')).toBe('a-c-n-z');
+    expect(slugify('ÀÉÎÕÜ')).toBe('aeiou');
+    expect(slugify('Ångström')).toBe('angstrom');
+  });
+
+  test('special letters', () => {
+    expect(slugify('ß æ œ ø ł đ')).toBe('ss-ae-oe-o-l-d');
+    expect(slugify('Straße Æon Œuvre Øre Łódź Đorđe')).toBe('strasse-aeon-oeuvre-ore-lodz-dorde');
+  });
+
+  test('separators collapse and never lead or trail', () => {
+    expect(slugify('  --Hello___World!!  ')).toBe('hello-world');
+    expect(slugify('a/b.c:d')).toBe('a-b-c-d');
+    expect(slugify('日本 2024')).toBe('2024');
+    expect(slugify('!!!')).toBe('');
+    expect(slugify('')).toBe('');
+  });
+
+  test('max cuts at the last "-" within max', () => {
+    expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+    expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+    expect(slugify('ab-cd-ef', 4)).toBe('ab');
+    expect(slugify('ab-cd-ef', 8)).toBe('ab-cd-ef');
+    expect(slugify('ab-cd-ef', 100)).toBe('ab-cd-ef');
+  });
+
+  test('max cuts at max when there is no "-" to cut at', () => {
+    expect(slugify('abcdef', 3)).toBe('abc');
+    expect(slugify('abcdef-gh', 4)).toBe('abcd');
+  });
+});
+
+describe('uniqueSlug', () => {
+  test('slug itself when free', () => {
+    expect(uniqueSlug('post', new Set())).toBe('post');
+    expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+  });
+
+  test('first free numbered slug', () => {
+    expect(uniqueSlug('post', new Set(['post', 'post-2', 'post-3']))).toBe('post-4');
+    expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+  });
+});
