--- a/ledger.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.rules.test.ts	2026-10-29 14:10:40.138664799 +0000
@@ -0,0 +1,135 @@
+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+let n = 0;
+const bash = (command: string, exitCode = 0, status: 'completed' | 'failed' | 'denied' | 'not_started' = exitCode ? 'failed' : 'completed'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool: 'bash', input: { command } },
+    { kind: 'tool_result', callId, status, output: { isError: exitCode !== 0, exitCode } },
+  ];
+};
+const edit = (path: string, status: 'completed' | 'failed' = 'completed'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool: 'edit', input: { path } },
+    { kind: 'tool_result', callId, status, output: { isError: status !== 'completed' } },
+  ];
+};
+const callOf = (events: SessionEvent[]) => (events[0]!.kind === 'tool_intent' ? events[0]!.callId : '');
+const w = (at: number, path?: string, command?: string): LedgerEntry => (path ? { kind: 'write', at, tool: 'edit', path } : { kind: 'write', at, tool: 'bash', command: command! });
+const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+describe('matchCheck rules', () => {
+  test('whitespace and a trailing 2>&1 are dropped on both sides', () => {
+    expect(matchCheck(' bun\ttest 2>&1 ', ['bun test 2>&1'])).toBe('bun test 2>&1');
+  });
+
+  test('a pipe, a chain or a suffix does not match', () => {
+    expect(matchCheck('bun test | tail', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test; true', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test || x', ['bun test'])).toBeUndefined();
+  });
+
+  test('cd is stripped only when it resolves to cwd', () => {
+    expect(matchCheck("cd '/work/repo' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd .. && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /work/repo && cd x && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd "/work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+});
+
+describe('ledgerEntries rules', () => {
+  test('an intent after a request pairs with its result', () => {
+    expect(ledgerEntries([{ kind: 'request' }, ...edit('a.ts')], [])).toEqual([{ kind: 'write', at: 2, tool: 'edit', path: 'a.ts' }]);
+  });
+
+  test('denied and not_started results never count, even for a check or a snapshot', () => {
+    const denied = bash('bun test', 0, 'denied');
+    const skipped = bash('bun test', 0, 'not_started');
+    const snapped = [...edit('a.ts', 'failed')];
+    const events: SessionEvent[] = [
+      ...denied,
+      { kind: 'snapshot', callId: callOf(denied), changed: ['x.ts'] },
+      ...skipped,
+      { kind: 'snapshot', callId: callOf(skipped), changed: ['y.ts'] },
+      ...snapped,
+      { kind: 'snapshot', callId: callOf(snapped), changed: [] },
+    ];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([]);
+  });
+
+  test('a failed check keeps its exit code', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'f', tool: 'bash', input: { command: 'bun test' } },
+      { kind: 'tool_result', callId: 'f', status: 'failed', output: { isError: true, exitCode: 2 } },
+    ];
+    expect(ledgerEntries(events, ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 2 }]);
+  });
+
+  test('a snapshot before its result still applies, also on a failed edit', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 's', tool: 'bash', input: { command: 'gen' } },
+      { kind: 'snapshot', callId: 's', changed: ['x.ts'] },
+      { kind: 'tool_result', callId: 's', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 2, tool: 'bash', path: 'x.ts' }]);
+    const failed = edit('a.ts', 'failed');
+    expect(ledgerEntries([...failed, { kind: 'snapshot', callId: callOf(failed), changed: ['b.ts'] }], [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'b.ts' }]);
+  });
+
+  test('an edit that completed with an empty snapshot is not a write', () => {
+    const done = edit('a.ts');
+    expect(ledgerEntries([...done, { kind: 'snapshot', callId: callOf(done), changed: [] }], [])).toEqual([]);
+  });
+
+  test('failed edits without a snapshot, and read-only commands, are not writes', () => {
+    expect(ledgerEntries([...edit('a.ts', 'failed'), ...bash('git status')], [])).toEqual([]);
+  });
+
+  test('a failed non-read-only bash command is a write with its command', () => {
+    expect(ledgerEntries(bash('make', 1), [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', command: 'make' }]);
+  });
+});
+
+describe('evidence rules', () => {
+  test('repeated labels are listed once', () => {
+    const e = evidence([w(1, undefined, 'x'), w(2, undefined, 'x'), c(3, 0), w(4, undefined, 'x')]);
+    expect(e.changed).toEqual(['bash: x']);
+    expect(e.unverified).toEqual(['bash: x']);
+  });
+
+  test('nothing is unverified right after a passing check; every write is when only failures exist', () => {
+    expect(evidence([w(1, 'a.ts'), c(2, 0)]).unverified).toEqual([]);
+    expect(evidence([w(1, 'a.ts'), c(2, 1), w(3, 'b.ts'), c(4, 3)]).unverified).toEqual(['a.ts', 'b.ts']);
+  });
+});
+
+describe('verified rules', () => {
+  test('a later passing check counts after an earlier failure', () => {
+    expect(verified([w(1, 'a.ts'), c(2, 1), c(3, 0)], ['bun test'])).toBe(true);
+  });
+});
+
+describe('verified agrees with evidence on random logs', () => {
+  let seed = 42;
+  const rand = () => {
+    seed = (Math.imul(seed, 1103515245) + 12345) & 0x7fffffff;
+    return seed / 0x80000000;
+  };
+  test('500 seeded logs', () => {
+    for (let k = 0; k < 500; k++) {
+      const len = Math.floor(rand() * 9);
+      const e: LedgerEntry[] = [];
+      for (let i = 0; i < len; i++) {
+        if (rand() < 0.5) e.push(rand() < 0.5 ? w(i, ['a.ts', 'b.ts'][Math.floor(rand() * 2)]) : w(i, undefined, ['x', 'y'][Math.floor(rand() * 2)]));
+        else e.push(c(i, rand() < 0.5 ? 0 : 1));
+      }
+      const ev = evidence(e);
+      expect(verified(e, ['bun test'])).toBe(ev.unverified.length === 0);
+      const labels = e.flatMap((x) => (x.kind === 'write' ? [x.path ?? `bash: ${x.command}`] : []));
+      expect(ev.changed).toEqual([...new Set(labels)]);
+    }
+  });
+});
