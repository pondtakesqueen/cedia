-  throw new Error('not implemented');
+  if (checks.length === 0) return true;
+  const last = entries.findLastIndex((e) => e.kind === 'write');
+  if (last === -1) return true;
+  return entries.slice(last + 1).some((e) => e.kind === 'check' && e.exitCode === 0);
