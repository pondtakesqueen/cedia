 // changed: every write's label (path, or `bash: <command>`), first seen first, no duplicates.
 // checks: every check entry, in order, as { command, exitCode }.
 // unverified: labels of writes after the last passing check (all of them when no check passed), deduped.
 export function evidence(entries: LedgerEntry[]): Evidence {
-  throw new Error('not implemented');
+  const label = (e: Extract<LedgerEntry, { kind: 'write' }>) => e.path ?? `bash: ${e.command}`;
+  let lastPass = -1;
+  entries.forEach((e, i) => {
+    if (e.kind === 'check' && e.exitCode === 0) lastPass = i;
+  });
+  const changed = new Set<string>();
+  const unverified = new Set<string>();
+  entries.forEach((e, i) => {
+    if (e.kind !== 'write') return;
+    changed.add(label(e));
+    if (i > lastPass) unverified.add(label(e));
+  });
+  const checks = entries.flatMap((e) => (e.kind === 'check' ? [{ command: e.command, exitCode: e.exitCode }] : []));
+  return { changed: [...changed], checks, unverified: [...unverified] };
