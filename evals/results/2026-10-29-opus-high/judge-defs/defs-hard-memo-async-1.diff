diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-29 14:13:38.662675411 +0000
@@ -0,0 +1,260 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+// fn's calls, each settled by the test.
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("a result's ttl runs from when it settled, not when it was called", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  t = 50;
+  calls[0]!.d.resolve("v");
+  await tick();
+  t = 149;
+  expect(await m("k")).toBe("v");
+  expect(calls).toHaveLength(1);
+  t = 150;
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection reaches every waiter and is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const err = new Error("boom");
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(err);
+  await expect(a).rejects.toBe(err);
+  await expect(b).rejects.toBe(err);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("LRU order counts a call answered from the cache as a use", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("a");
+  expect(calls).toHaveLength(2);
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("sharing an in-flight call counts as a use for LRU order", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("a");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("an invalidated in-flight call that settles does not change the new entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const old = m("k");
+  m.invalidate("k");
+  const fresh = m("k");
+  calls[0]!.d.resolve("old");
+  calls[1]!.d.resolve("new");
+  expect(await old).toBe("old");
+  expect(await fresh).toBe("new");
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale rejection does not delete the newer entry for its key", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const old = m("k");
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("stale"));
+  await expect(old).rejects.toThrow("stale");
+  await tick();
+  m("k");
+  expect(calls).toHaveLength(2);
+  expect(m.size).toBe(1);
+});
+
+test("an in-flight call that was evicted is not kept when it settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+  expect(m.size).toBe(1);
+});
+
+test("a call in flight during clear is not kept when it settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.clear();
+  calls[0]!.d.resolve("v");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("size does not count expired results", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  calls[0]!.d.resolve("v");
+  await tick();
+  expect(m.size).toBe(1);
+  t = 100;
+  expect(m.size).toBe(0);
+});
+
+test("an expired result does not push out a live one", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("x");
+  m("e");
+  calls[1]!.d.resolve("e");
+  await tick();
+  t = 90;
+  calls[0]!.d.resolve("x");
+  await tick();
+  t = 150;
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("x");
+  expect(calls).toHaveLength(3);
+});
+
+test("a synchronous throw from fn rejects the call and is not kept", async () => {
+  let n = 0;
+  const err = new Error("boom");
+  const m = memo(
+    (_key: string): Promise<string> => {
+      n++;
+      throw err;
+    },
+    { ttlMs: 1000, max: 10 },
+  );
+  await expect(m("k")).rejects.toBe(err);
+  await tick();
+  await expect(m("k")).rejects.toBe(err);
+  expect(n).toBe(2);
+  expect(m.size).toBe(0);
+});
+
+// A small reference model of the documented rules, run against memo on seeded random sequences.
+function mulberry32(seed: number) {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let x = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    x = (x + Math.imul(x ^ (x >>> 7), 61 | x)) ^ x;
+    return ((x ^ (x >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test("matches a reference model on random sequences", async () => {
+  const ttlMs = 100;
+  const keys = ["a", "b", "c", "d"];
+  for (let seed = 1; seed <= 200; seed++) {
+    const rand = mulberry32(seed);
+    const pick = <T>(xs: T[]) => xs[Math.floor(rand() * xs.length)]!;
+    const max = 1 + Math.floor(rand() * 3);
+    let t = 0;
+    const { fn, calls } = lookups();
+    const m = memo(fn, { ttlMs, max, now: () => t });
+    // Model: items in LRU order, each with the call index it stands for and its expiry.
+    let items: { key: string; id: number; expires: number }[] = [];
+    const pending: number[] = [];
+    let modelCalls = 0;
+    const log: string[] = [];
+    for (let step = 0; step < 30; step++) {
+      const op = pick(["call", "call", "call", "invalidate", "clear", "advance", "settle", "settle"]);
+      log.push(op);
+      if (op === "call") {
+        const k = pick(keys);
+        const idx = items.findIndex((i) => i.key === k);
+        if (idx >= 0 && items[idx]!.expires > t) {
+          items.push(...items.splice(idx, 1));
+        } else {
+          if (idx >= 0) items.splice(idx, 1);
+          items = items.filter((i) => i.expires > t);
+          while (items.length >= max) items.shift();
+          items.push({ key: k, id: modelCalls, expires: Infinity });
+          pending.push(modelCalls);
+          modelCalls++;
+        }
+        m(k);
+      } else if (op === "invalidate") {
+        const k = pick(keys);
+        items = items.filter((i) => i.key !== k);
+        m.invalidate(k);
+      } else if (op === "clear") {
+        items = [];
+        m.clear();
+      } else if (op === "advance") {
+        t += Math.floor(rand() * 60);
+      } else if (pending.length > 0) {
+        const id = pending.shift()!;
+        const item = items.find((i) => i.id === id);
+        if (item) item.expires = t + ttlMs;
+        calls[id]!.d.resolve(calls[id]!.key);
+        await tick();
+      }
+      const live = items.filter((i) => i.expires > t).length;
+      expect({ seed, step, size: m.size, calls: calls.length }).toEqual({
+        seed,
+        step,
+        size: live,
+        calls: modelCalls,
+      });
+    }
+  }
+});
+
+test("misses do not scan the whole cache, so many distinct keys stay fast", () => {
+  const m = memo((_key: number) => new Promise<number>(() => {}), { ttlMs: 1000, max: 50000 });
+  const start = performance.now();
+  for (let k = 0; k < 50000; k++) m(k);
+  expect(performance.now() - start).toBeLessThan(1000);
+  expect(m.size).toBe(50000);
+});
