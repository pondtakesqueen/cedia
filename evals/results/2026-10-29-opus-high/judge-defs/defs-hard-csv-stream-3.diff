diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.stream.test.ts b/csv.stream.test.ts
--- a/csv.stream.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/csv.stream.test.ts	2026-10-29 14:00:47.118629549 +0000
@@ -0,0 +1,128 @@
+import { expect, test } from "bun:test";
+import { CsvStream, parseCsv } from "./csv";
+
+function run(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const c of chunks) rows.push(...s.push(c));
+  rows.push(...s.end());
+  return rows;
+}
+
+function outcome(f: () => string[][]): { rows: string[][] } | { error: string; name: string } {
+  try {
+    return { rows: f() };
+  } catch (e) {
+    const err = e as Error;
+    return { error: err.message, name: err.name };
+  }
+}
+
+function mulberry32(seed: number): () => number {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+function splitRandomly(text: string, rand: () => number): string[] {
+  const chunks: string[] = [];
+  let start = 0;
+  for (let i = 0; i <= text.length; i++) {
+    if (rand() < 0.3) {
+      chunks.push(text.slice(start, i));
+      start = i;
+    }
+  }
+  chunks.push(text.slice(start));
+  return chunks;
+}
+
+test("any split into chunks gives the rows or the error parseCsv gives", () => {
+  const rand = mulberry32(1);
+  const alphabet = ['a', ",", '"', "\r", "\n", "\uFEFF"];
+  for (let n = 0; n < 3000; n++) {
+    let text = "";
+    const len = Math.floor(rand() * 21);
+    for (let i = 0; i < len; i++) text += alphabet[Math.floor(rand() * alphabet.length)];
+    const expected = outcome(() => parseCsv(text));
+    for (let t = 0; t < 3; t++) {
+      expect(outcome(() => run(splitRandomly(text, rand)))).toEqual(expected);
+    }
+  }
+});
+
+test("every split point and every one-character chunk gives the rows of parseCsv", () => {
+  const inputs = [
+    'a,b\r\n"x,""y""",z\n',
+    "a\r\r\nb",
+    '"a""',
+    '"a"\r',
+    "\uFEFFa",
+    ",",
+    "\n",
+    "a\n",
+    "",
+  ];
+  for (const text of inputs) {
+    const expected = outcome(() => parseCsv(text));
+    for (let i = 0; i <= text.length; i++) {
+      expect(outcome(() => run([text.slice(0, i), text.slice(i)]))).toEqual(expected);
+    }
+    expect(outcome(() => run(text.split("")))).toEqual(expected);
+  }
+});
+
+test("rows come out as soon as their row end has arrived", () => {
+  const s = new CsvStream();
+  expect(s.push("a\n")).toEqual([["a"]]);
+  expect(s.push("a\r")).toEqual([]);
+  expect(s.push("\nb")).toEqual([["a"]]);
+  expect(s.end()).toEqual([["b"]]);
+
+  const q = new CsvStream();
+  expect(q.push('"x"')).toEqual([]);
+  expect(q.push(',y\n')).toEqual([["x", "y"]]);
+  expect(q.end()).toEqual([]);
+});
+
+test("a byte order mark is dropped only at the very start of the input", () => {
+  expect(run(["", "\uFEFFa"])).toEqual([["a"]]);
+  expect(run(["\uFEFF", "a"])).toEqual([["a"]]);
+  expect(run(["\uFEFF"])).toEqual([]);
+  expect(run(["a\uFEFFb"])).toEqual([["a\uFEFFb"]]);
+});
+
+test("inputs parseCsv rejects make push or end throw a SyntaxError", () => {
+  for (const text of ['"a"b', 'a"b', '"open', '"a"\rx', '"a"\r']) {
+    expect(() => run([text])).toThrow(SyntaxError);
+    expect(() => run(text.split(""))).toThrow(SyntaxError);
+  }
+});
+
+test("after an error every later call throws, and after end push throws", () => {
+  const s = new CsvStream();
+  expect(() => s.push('"a"b')).toThrow(SyntaxError);
+  expect(() => s.push("x")).toThrow(SyntaxError);
+  expect(() => s.end()).toThrow(SyntaxError);
+
+  const t = new CsvStream();
+  expect(t.push("a\n")).toEqual([["a"]]);
+  expect(t.end()).toEqual([]);
+  expect(() => t.push("b")).toThrow("the stream has ended");
+  expect(() => t.end()).toThrow("the stream has ended");
+});
+
+test("large inputs in small chunks stay fast", () => {
+  const s = new CsvStream();
+  let rows = 0;
+  for (let i = 0; i < 200_000; i++) rows += s.push('"ab""c",d\n').length;
+  expect(rows).toBe(200_000);
+
+  const q = new CsvStream();
+  const big = "x".repeat(1_000_000);
+  for (const c of '"' + big + '"') q.push(c);
+  expect(q.end()).toEqual([[big]]);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/csv.ts b/csv.ts
--- a/csv.ts	2026-10-29 13:57:11.726323336 +0000
+++ b/csv.ts	2026-10-29 14:00:34.150981634 +0000
@@ -50,3 +50,136 @@
   rows.push(row);
   return rows;
 }
+
+/**
+ * Reads the CSV that `parseCsv` reads, one chunk at a time. `push` returns the rows whose row end has arrived, and
+ * `end` returns the rest. Each character costs the same work however much came before it.
+ */
+export class CsvStream {
+  private pos = 0;
+  private started = false;
+  private state: "fieldStart" | "unquoted" | "quoted" | "quoteInQuoted" | "afterClose" | "cr" | "closeCr" = "fieldStart";
+  private row: string[] = [];
+  private field = "";
+  private rows: string[][] = [];
+  private failed = false;
+  private ended = false;
+
+  push(chunk: string): string[][] {
+    this.guard();
+    this.rows = [];
+    try {
+      for (let k = 0; k < chunk.length; k++, this.pos++) {
+        if (!this.started) {
+          this.started = true;
+          if (chunk[k] === "\uFEFF") continue;
+        }
+        this.char(chunk[k]!);
+      }
+    } catch (e) {
+      this.failed = true;
+      throw e;
+    }
+    return this.rows;
+  }
+
+  end(): string[][] {
+    this.guard();
+    this.rows = [];
+    try {
+      switch (this.state) {
+        case "quoted":
+          throw new SyntaxError("a quoted field is still open at the end of the input");
+        case "closeCr":
+          throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.pos - 1}`);
+        case "cr":
+          this.field += "\r";
+          this.endRow();
+          break;
+        case "unquoted":
+        case "quoteInQuoted":
+        case "afterClose":
+          this.endRow();
+          break;
+        case "fieldStart":
+          if (this.row.length > 0) this.endRow();
+          break;
+      }
+    } catch (e) {
+      this.failed = true;
+      throw e;
+    }
+    this.ended = true;
+    return this.rows;
+  }
+
+  private guard() {
+    if (this.failed) throw new SyntaxError("the stream already failed on an earlier chunk");
+    if (this.ended) throw new Error("the stream has ended");
+  }
+
+  private endField() {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "fieldStart";
+  }
+
+  private endRow() {
+    this.endField();
+    this.rows.push(this.row);
+    this.row = [];
+  }
+
+  private char(c: string) {
+    switch (this.state) {
+      case "fieldStart":
+        if (c === '"') this.state = "quoted";
+        else if (c === ",") this.endField();
+        else if (c === "\n") this.endRow();
+        else if (c === "\r") this.state = "cr";
+        else {
+          this.field = c;
+          this.state = "unquoted";
+        }
+        break;
+      case "unquoted":
+        if (c === ",") this.endField();
+        else if (c === "\n") this.endRow();
+        else if (c === "\r") this.state = "cr";
+        else if (c === '"') throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.pos}`);
+        else this.field += c;
+        break;
+      case "cr":
+        if (c === "\n") this.endRow();
+        else {
+          this.field += "\r";
+          this.state = "unquoted";
+          this.char(c);
+        }
+        break;
+      case "quoted":
+        if (c === '"') this.state = "quoteInQuoted";
+        else this.field += c;
+        break;
+      case "quoteInQuoted":
+        if (c === '"') {
+          this.field += '"';
+          this.state = "quoted";
+        } else {
+          this.state = "afterClose";
+          this.char(c);
+        }
+        break;
+      case "afterClose":
+        if (c === ",") this.endField();
+        else if (c === "\n") this.endRow();
+        else if (c === "\r") this.state = "closeCr";
+        else throw new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${this.pos}`);
+        break;
+      case "closeCr":
+        if (c === "\n") this.endRow();
+        else throw new SyntaxError(`unexpected "\\r" after a closing quote at offset ${this.pos - 1}`);
+        break;
+    }
+  }
+}
