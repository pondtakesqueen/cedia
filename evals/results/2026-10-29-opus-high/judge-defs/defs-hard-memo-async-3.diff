diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-29 14:14:59.174680197 +0000
@@ -0,0 +1,154 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("a stale resolve after invalidate does not overwrite a newer in-flight call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.resolve("old");
+  await tick();
+  calls[1]!.d.resolve("new");
+  expect(await first).toBe("old");
+  expect(await second).toBe("new");
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale rejection does not delete a newer entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(first).rejects.toThrow("boom");
+  expect(m.size).toBe(1);
+  calls[1]!.d.resolve("v");
+  expect(await second).toBe("v");
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale resolve after clear is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.clear();
+  calls[0]!.d.resolve("v");
+  await tick();
+  expect(m.size).toBe(0);
+});
+
+test("a stale resolve after eviction is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  await tick();
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("size never exceeds max as keys are added", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  for (const k of ["a", "b", "c"]) {
+    m(k);
+    expect(m.size).toBeLessThanOrEqual(2);
+  }
+  expect(m.size).toBe(2);
+  calls[2]!.d.resolve("c");
+  await tick();
+  expect(m.size).toBe(2);
+});
+
+test("a cache hit counts as a use for LRU eviction", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("a");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("ttl counts from when the result settled, not from the call", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  t = 50;
+  calls[0]!.d.resolve("v");
+  await tick();
+  t = 149;
+  expect(await m("k")).toBe("v");
+  t = 150;
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("expired entries do not count toward size", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  expect(m.size).toBe(2);
+  t = 100;
+  expect(m.size).toBe(0);
+  m("c");
+  m("d");
+  expect(m.size).toBe(2);
+});
+
+test("a rejection is shared by waiting callers and not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(a).rejects.toThrow("boom");
+  await expect(b).rejects.toThrow("boom");
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("constructor rejects bad options", () => {
+  const { fn } = lookups();
+  expect(() => memo(fn, { ttlMs: 0, max: 1 })).toThrow(RangeError);
+  expect(() => memo(fn, { ttlMs: 1, max: 0 })).toThrow(RangeError);
+  expect(() => memo(fn, { ttlMs: 1, max: 1.5 })).toThrow(RangeError);
+});
