diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.test.ts b/median.test.ts
--- a/median.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.test.ts	2026-10-29 14:08:38.038714654 +0000
@@ -0,0 +1,53 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('odd length returns the middle value', () => {
+  expect(median([5])).toBe(5);
+  expect(median([3, 1, 2])).toBe(2);
+});
+
+test('even length returns the average of the two middle values', () => {
+  expect(median([1, 2])).toBe(1.5);
+  expect(median([4, 1, 3, 2])).toBe(2.5);
+});
+
+test('numbers are sorted as numbers, not text', () => {
+  expect(median([10, 9, 100, 1])).toBe(9.5);
+  expect(median([-5, -10, 2])).toBe(-5);
+});
+
+test('the input is not modified', () => {
+  const xs = [3, 1, 2];
+  const copy = [...xs];
+  median(xs);
+  expect(xs).toEqual(copy);
+});
+
+test('empty input throws', () => expect(() => median([])).toThrow('empty'));
+
+test('duplicates and floats', () => {
+  expect(median([2, 2, 2, 2])).toBe(2);
+  expect(median([0.1, 0.3])).toBeCloseTo(0.2);
+});
+
+test('agrees with a reference on seeded random arrays', () => {
+  let seed = 42;
+  const next = () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed / 2147483648;
+  };
+  let odd = 0;
+  let even = 0;
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + Math.floor(next() * 20);
+    const xs = Array.from({ length: n }, () => Math.floor(next() * 2001) - 1000);
+    const s = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(n / 2);
+    const want = n % 2 ? s[mid]! : (s[mid - 1]! + s[mid]!) / 2;
+    if (n % 2) odd++;
+    else even++;
+    expect(median(xs)).toBe(want);
+  }
+  expect(odd).toBeGreaterThan(0);
+  expect(even).toBeGreaterThan(0);
+});
