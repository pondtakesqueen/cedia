diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 13:59:14.686624054 +0000
@@ -0,0 +1,71 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const name = (argv: string[]) => denyListed(argv, cwd)?.name;
+
+test('git path in argv[0] and global options with values', () => {
+  expect(name(['/opt/x/git', 'push', '-f'])).toBe('force-push');
+  expect(name(['git', '--namespace', 'push', 'push'])).toBeUndefined();
+  expect(name(['git', '--work-tree', 'w', 'push', '-f'])).toBe('force-push');
+});
+
+test('long push flags with =value', () => {
+  for (const f of ['--mirror=x', '--delete=x', '--prune=x']) expect(name(['git', 'push', f])).toBe('force-push');
+});
+
+test('short push groups with d or f', () => {
+  expect(name(['git', 'push', '-df'])).toBe('force-push');
+  expect(name(['git', 'push', '-ud'])).toBe('force-push');
+  expect(name(['git', 'push', '-u'])).toBeUndefined();
+});
+
+test('refspec + or : only counts for push', () => {
+  expect(name(['git', 'commit', '-m', '+x'])).toBeUndefined();
+  expect(name(['git', 'push', 'origin', '+main'])).toBe('force-push');
+});
+
+test('reset without --hard and clean variants', () => {
+  expect(name(['git', 'reset', 'HEAD'])).toBeUndefined();
+  expect(name(['git', 'clean', '-x', '-f'])).toBe('clean-force');
+  expect(name(['git', 'clean', '--force', '--dry-run'])).toBeUndefined();
+  expect(name(['git', 'clean', '-nf'])).toBe('clean-force');
+});
+
+test('rm without recursion, and recursive spellings', () => {
+  expect(name(['rm', '-f', '/etc'])).toBeUndefined();
+  expect(name(['rm', '-R', '/etc'])).toBe('rm-outside');
+  expect(name(['rm', '--recursive', '/etc'])).toBe('rm-outside');
+  expect(name(['rm', '--', '-r', '/etc'])).toBeUndefined();
+  expect(name(['rm', '-rf', '--'])).toBe('rm-outside');
+});
+
+test('rm targets outside or equal to cwd', () => {
+  expect(name(['rm', '-rf', '..'])).toBe('rm-outside');
+  expect(name(['rm', '-rf', '~'])).toBe('rm-outside');
+  expect(name(['rm', '-rf', '~/x'])).toBe('rm-outside');
+  expect(name(['rm', '-rf', '/work/repo/../repo2'])).toBe('rm-outside');
+  expect(name(['rm', '-rf', 'build$X'])).toBe('rm-outside');
+});
+
+test('find without an action, or with an in-workspace start', () => {
+  expect(name(['find', '/etc', '-name', 'x'])).toBeUndefined();
+  expect(name(['find', '.', '-execdir', 'x', '{}', ';'])).toBeUndefined();
+  expect(name(['find', '~bob', '-delete'])).toBe('rm-outside');
+  expect(name(['find', 'src', '-name', '/etc', '-delete'])).toBeUndefined();
+});
+
+test('other tools pass', () => {
+  expect(name(['echo', 'git', 'push', '-f'])).toBeUndefined();
+  expect(name([])).toBeUndefined();
+});
+
+test('rm -r target rule agrees with insideWorkspace and sameDir', () => {
+  const targets = ['.', '..', 'src', '/', '/etc', '/work/repo/b', '*', '~'];
+  for (const t of targets) {
+    for (const flags of [['-r'], ['-fR'], ['--recursive']]) {
+      const want = !insideWorkspace(t, cwd) || sameDir(t, cwd) ? 'rm-outside' : undefined;
+      expect([t, flags, name(['rm', ...flags, t])]).toEqual([t, flags, want]);
+    }
+  }
+});
