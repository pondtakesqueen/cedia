+import { basename, isAbsolute, relative, resolve } from 'node:path';
 
 export type Hit = { name: 'force-push' | 'reset-hard' | 'clean-force' | 'rm-outside'; reason: string };
 
@@ -14,6 +14,61 @@
 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+const short = (w: string) => /^-[^-]/.test(w);
+const shortHas = (w: string, letter: string) => short(w) && w.includes(letter);
+// A path the guard cannot resolve before the command runs: a variable, or ~user.
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+
+const gitValueOptions = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += gitValueOptions.has(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const force = rest.find(
+      (a) =>
+        /^--(force|force-with-lease|mirror|delete|prune)(=|$)/.test(a) ||
+        shortHas(a, 'f') ||
+        shortHas(a, 'd') ||
+        /^[+:]/.test(a),
+    );
+    return force === undefined ? undefined : { name: 'force-push', reason: `git push ${force}` };
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard' };
+  if (sub === 'clean' && !rest.some((a) => a === '-n' || a === '--dry-run')) {
+    if (rest.some((a) => a === '--force' || shortHas(a, 'f'))) return { name: 'clean-force', reason: 'git clean -f' };
+  }
+  return undefined;
+}
+
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  const dd = args.indexOf('--');
+  const before = dd < 0 ? args : args.slice(0, dd);
+  const flags = before.filter((a) => a.startsWith('-'));
+  const targets = [...before.filter((a) => !a.startsWith('-')), ...(dd < 0 ? [] : args.slice(dd + 1))];
+  const recursive = flags.some((a) => a === '--recursive' || shortHas(a, 'r') || shortHas(a, 'R'));
+  if (!recursive) return undefined;
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets' };
+  for (const t of targets) {
+    if (unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd)) {
+      return { name: 'rm-outside', reason: `rm -r target ${t} outside ${cwd}` };
+    }
+  }
+  return undefined;
+}
+
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some((a) => a === '-delete' || a === '-exec' || a === '-execdir')) return undefined;
+  const k = args.findIndex((a) => a.startsWith('-'));
+  const starts = k < 0 ? args : args.slice(0, k);
+  for (const p of starts.length > 0 ? starts : ['.']) {
+    if (unresolvable(p) || !insideWorkspace(p, cwd)) return { name: 'rm-outside', reason: `find start ${p} outside ${cwd}` };
+  }
+  return undefined;
+}
+
 // Looks at one simple command's argv (already split, quotes removed) and returns a Hit when it must be denied.
 //
 // git (argv[0] may be a path such as /usr/bin/git). Global options before the subcommand are skipped; -C, -c,
@@ -36,5 +91,16 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  if (argv.length === 0) return undefined;
+  const args = argv.slice(1);
+  switch (basename(argv[0])) {
+    case 'git':
+      return gitHit(args);
+    case 'rm':
+      return rmHit(args, cwd);
+    case 'find':
+      return findHit(args, cwd);
+    default:
+      return undefined;
+  }
 }
