 import { homedir } from 'node:os';
-import { isAbsolute, relative, resolve } from 'node:path';
+import { basename, isAbsolute, relative, resolve } from 'node:path';
 
 export type Hit = { name: 'force-push' | 'reset-hard' | 'clean-force' | 'rm-outside'; reason: string };
 
@@ -14,6 +14,53 @@
 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+// A short flag group (-fu, -R) containing one of `chars`; long flags like --force are not groups.
+const shortHas = (w: string, chars: string) => /^-[^-]/.test(w) && [...chars].some((c) => w.includes(c));
+
+const GIT_VALUE_OPTS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+const FORCE_PUSH = new Set(['--force', '--force-with-lease', '--mirror', '--delete', '--prune']);
+
+// A target that cannot be resolved before it runs: `$VAR`, or `~user`.
+const unresolvable = (t: string) => t.includes('$') || (t.startsWith('~') && t !== '~' && !t.startsWith('~/'));
+
+function gitDeny(argv: string[]): Hit | undefined {
+  let i = 1;
+  while (i < argv.length && argv[i].startsWith('-')) i += GIT_VALUE_OPTS.has(argv[i]) ? 2 : 1;
+  const sub = argv[i];
+  const rest = argv.slice(i + 1);
+  if (sub === 'push') {
+    const w = rest.find((w) => FORCE_PUSH.has(w.split('=')[0]) || shortHas(w, 'fd') || (!w.startsWith('-') && /^[+:]/.test(w)));
+    if (w !== undefined) return { name: 'force-push', reason: `git push ${w} rewrites or deletes remote refs` };
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean' && rest.some((w) => w === '--force' || shortHas(w, 'f')) && !rest.some((w) => w === '-n' || w === '--dry-run'))
+    return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  return undefined;
+}
+
+function rmDeny(argv: string[], cwd: string): Hit | undefined {
+  const dd = argv.indexOf('--');
+  const head = dd < 0 ? argv.slice(1) : argv.slice(1, dd);
+  const tail = dd < 0 ? [] : argv.slice(dd + 1);
+  const flags = head.filter((w) => w.startsWith('-'));
+  if (!flags.some((w) => w === '--recursive' || shortHas(w, 'rR'))) return undefined;
+  const targets = [...head.filter((w) => !w.startsWith('-')), ...tail];
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets' };
+  const bad = targets.find((t) => unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd));
+  if (bad !== undefined) return { name: 'rm-outside', reason: `rm -r ${bad} is outside ${cwd}` };
+  return undefined;
+}
+
+function findDeny(argv: string[], cwd: string): Hit | undefined {
+  if (!argv.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const end = argv.findIndex((w, i) => i > 0 && w.startsWith('-'));
+  const starts = argv.slice(1, end < 0 ? argv.length : end);
+  if (starts.length === 0) starts.push('.');
+  const bad = starts.find((p) => unresolvable(p) || !insideWorkspace(p, cwd));
+  if (bad !== undefined) return { name: 'rm-outside', reason: `find ${bad} deletes outside ${cwd}` };
+  return undefined;
+}
+
 // Looks at one simple command's argv (already split, quotes removed) and returns a Hit when it must be denied.
 //
 // git (argv[0] may be a path such as /usr/bin/git). Global options before the subcommand are skipped; -C, -c,
@@ -36,5 +83,14 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  switch (basename(argv[0] ?? '')) {
+    case 'git':
+      return gitDeny(argv);
+    case 'rm':
+      return rmDeny(argv, cwd);
+    case 'find':
+      return findDeny(argv, cwd);
+    default:
+      return undefined;
+  }
 }
