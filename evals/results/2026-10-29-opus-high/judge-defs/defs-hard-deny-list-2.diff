diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-29 14:01:30.506632128 +0000
@@ -0,0 +1,66 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('argv[0] may be a path for git, rm and find', () => {
+  expect(hit('/opt/x/git reset --hard')).toBe('reset-hard');
+  expect(hit('/bin/rm -r /etc')).toBe('rm-outside');
+  expect(hit('/usr/bin/find / -delete')).toBe('rm-outside');
+});
+
+test('git global options that take a value skip their value', () => {
+  expect(hit('git -c push.x=1 --work-tree w --namespace n push -d o x')).toBe('force-push');
+  expect(hit('git --namespace push status')).toBeUndefined();
+  expect(hit('git -C')).toBeUndefined();
+});
+
+test('force flags with =value and short groups containing d', () => {
+  for (const line of ['git push --mirror=x', 'git push --delete=x', 'git push --prune=x', 'git push --force=x', 'git push -df'])
+    expect([line, hit(line)]).toEqual([line, 'force-push']);
+  for (const line of ['git push -u', 'git push -v origin main'])
+    expect([line, hit(line)]).toEqual([line, undefined]);
+  expect(hit('git push origin main:main')).toBeUndefined();
+});
+
+test('reset --hard anywhere, and plain reset', () => {
+  expect(hit('git reset HEAD --hard')).toBe('reset-hard');
+  expect(hit('git reset')).toBeUndefined();
+});
+
+test('clean dry-run cancels force only as the exact word', () => {
+  expect(hit('git clean --dry-run -f')).toBeUndefined();
+  expect(hit('git clean --force -n')).toBeUndefined();
+  expect(hit('git clean -nf')).toBe('clean-force');
+});
+
+test('rm recursion is read from flags before --', () => {
+  expect(hit('rm --recursive -- x')).toBeUndefined();
+  expect(hit('rm -v -R /etc')).toBe('rm-outside');
+  expect(hit('rm -- --recursive /etc')).toBeUndefined();
+  expect(hit('rm -r --')).toBe('rm-outside');
+});
+
+test('rm targets that cannot be resolved or name the workspace itself', () => {
+  for (const line of ['rm -r a$b', 'rm -r ~x', 'rm -r ~/', 'rm -r ./', 'rm -r /work/repo/'])
+    expect([line, hit(line)]).toEqual([line, 'rm-outside']);
+});
+
+test('find start paths stop at the first word starting with -', () => {
+  expect(hit('find src -name /etc -delete')).toBeUndefined();
+  expect(hit('find ~ -exec x ;')).toBe('rm-outside');
+  expect(hit('find . -delete')).toBeUndefined();
+});
+
+test('commands that only look like git, rm or find pass', () => {
+  expect(hit('gitx push -f')).toBeUndefined();
+  expect(hit('rmdir -r /')).toBeUndefined();
+});
+
+test('a bad target anywhere in the list is denied, and a good one first does not hide it', () => {
+  for (const t of ['.', './', '..', '/', '~', 'a/../..', '/work/repox', '$X', '~u']) {
+    expect([t, hit(`rm -rf ${t}`)]).toEqual([t, 'rm-outside']);
+    expect([t, hit(`rm -rf a ${t}`)]).toEqual([t, 'rm-outside']);
+  }
+});
