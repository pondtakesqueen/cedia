 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const unitMs: Record<string, number> = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1000, ms: 1 };
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  if (!/^(?:\d+(?:\.\d+)?(?:ms|d|h|m|s) *)+$/.test(s)) {
+    throw new Error(`invalid duration "${text}"`);
+  }
+  let total = 0;
+  for (const [, num, unit] of s.matchAll(/(\d+(?:\.\d+)?)(ms|d|h|m|s)/g)) {
+    total += Number(num) * unitMs[unit];
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration ${ms}`);
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const [u, size] of Object.entries(unitMs)) {
+    const q = Math.floor(rest / size);
+    if (q > 0) out += `${q}${u}`;
+    rest -= q * size;
+  }
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
--- a/src/lru.ts	2026-10-29 14:24:59.398345105 +0000
+++ b/src/lru.ts	2026-10-29 14:26:26.034721026 +0000
@@ -14,30 +14,73 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  // Map insertion order is the recency order: oldest first, newest last.
+  private map = new Map<K, Entry<V>>();
 
-  constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
-  }
+  constructor(
+    private capacity: number,
+    private ttlMs: number,
+    private now: () => number = Date.now,
+  ) {}
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.map.get(key);
+    if (!e) return undefined;
+    this.map.delete(key);
+    if (!this.live(e)) {
+      this.onEvict?.(key, e.value, 'expired');
+      return undefined;
+    }
+    this.map.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.map.delete(key);
+    this.map.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    for (const [k, e] of this.map) {
+      if (this.live(e)) continue;
+      this.map.delete(k);
+      this.onEvict?.(k, e.value, 'expired');
+    }
+    for (const [k, e] of this.map) {
+      if (this.map.size <= this.capacity) break;
+      this.map.delete(k);
+      this.onEvict?.(k, e.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.map.get(key);
+    if (!e) return false;
+    this.map.delete(key);
+    if (!this.live(e)) {
+      this.onEvict?.(key, e.value, 'expired');
+      return false;
+    }
+    this.onEvict?.(key, e.value, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const e of this.map.values()) if (this.live(e)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.map]
+      .filter(([, e]) => this.live(e))
+      .map(([k]) => k)
+      .reverse();
+  }
+
+  private live(e: Entry<V>): boolean {
+    return this.now() < e.expires;
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-29 14:24:59.398387677 +0000
+++ b/src/slug.ts	2026-10-29 14:26:13.622720289 +0000
@@ -11,10 +11,26 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const specialLetters: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => specialLetters[c])
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (s[max] === '-') return s.slice(0, max);
+  const cut = s.slice(0, max);
+  const i = cut.lastIndexOf('-');
+  return i > 0 ? cut.slice(0, i) : cut;
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-29 14:27:14.018723879 +0000
@@ -0,0 +1,55 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('each unit on its own', () => {
+  expect(parseDuration('1d')).toBe(86_400_000);
+  expect(parseDuration('1h')).toBe(3_600_000);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('1s')).toBe(1000);
+  expect(parseDuration('250ms')).toBe(250);
+});
+
+test('ms and m are told apart', () => {
+  expect(parseDuration('1m30s')).toBe(90_000);
+  expect(parseDuration('1ms')).toBe(1);
+});
+
+test('fractions are allowed and the result is rounded', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('0.0015s')).toBe(2);
+});
+
+test('spaces between parts and around the text', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('  90s  ')).toBe(90_000);
+});
+
+test('bad input throws with the input in the message', () => {
+  for (const bad of ['', '   ', '10', '5x', 'h', '-1s', '1h x', '1 h', '5"x', '1h\nx', 'a\\b']) {
+    expect(() => parseDuration(bad)).toThrow(bad);
+  }
+});
+
+test('format examples', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(86_400_000)).toBe('1d');
+});
+
+test('format rounds a sub-millisecond value to 0s and rejects bad numbers', () => {
+  expect(formatDuration(0.4)).toBe('0s');
+  expect(formatDuration(1.6)).toBe('2ms');
+  expect(() => formatDuration(-1)).toThrow('-1');
+  expect(() => formatDuration(Number.NaN)).toThrow();
+  expect(() => formatDuration(Number.POSITIVE_INFINITY)).toThrow();
+});
+
+test('format and parse agree', () => {
+  const values = [];
+  for (let n = 0; n <= 200_000; n += 997) values.push(n);
+  values.push(86_400_000 * 400, 3_600_000 * 1234 + 59_999, 2 ** 40 + 7);
+  for (const n of values) {
+    expect(parseDuration(formatDuration(n))).toBe(n);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-29 14:26:29.962721260 +0000
@@ -0,0 +1,216 @@
+import { expect, test } from 'bun:test';
+import { EvictReason, LRU } from '../src/lru.ts';
+
+function recorder() {
+  const log: [string, number, EvictReason][] = [];
+  return {
+    log,
+    onEvict: (k: string, v: number, r: EvictReason) => log.push([k, v, r]),
+  };
+}
+
+test('a get hit refreshes recency', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(rec.log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('expiry boundary: live before ttl, gone at ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  t = 999;
+  expect(cache.get('a')).toBe(1);
+  t = 1000;
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.get('a')).toBeUndefined();
+  expect(rec.log).toEqual([['a', 1, 'expired']]);
+});
+
+test('set refreshes the ttl', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  cache.set('a', 1);
+  t = 500;
+  cache.set('a', 2);
+  t = 1400;
+  expect(cache.get('a')).toBe(2);
+});
+
+test('capacity counts expired entries, and they go first', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  t = 600;
+  cache.set('b', 2);
+  t = 1100;
+  cache.set('c', 3);
+  expect(rec.log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('a live entry is evicted only while still over capacity', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  expect(rec.log).toEqual([['a', 1, 'capacity']]);
+});
+
+test('all expired entries go before any live one is evicted', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(3, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('c', 3);
+  t = 1000;
+  // a, b, c have expired; setting d takes the map to 4 entries, capacity 3.
+  cache.set('d', 4);
+  expect(rec.log).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+    ['c', 3, 'expired'],
+  ]);
+  expect(cache.keys()).toEqual(['d']);
+});
+
+test('delete: live, expired and missing', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  t = 1000;
+  expect(cache.delete('b')).toBe(false);
+  expect(cache.delete('zz')).toBe(false);
+  expect(rec.log).toEqual([
+    ['a', 1, 'delete'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('size and keys skip expired entries without removing them', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(5, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  t = 600;
+  cache.set('b', 2);
+  expect(cache.size).toBe(2);
+  t = 1000;
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(rec.log).toEqual([]);
+});
+
+test('overwriting a key fires nothing, keeps size, and makes it most recent', () => {
+  let t = 0;
+  const cache = new LRU<string, number>(2, 1000, () => t);
+  const rec = recorder();
+  cache.onEvict = rec.onEvict;
+  cache.set('a', 1);
+  cache.set('b', 2);
+  cache.set('a', 10);
+  expect(rec.log).toEqual([]);
+  expect(cache.size).toBe(2);
+  expect(cache.keys()).toEqual(['a', 'b']);
+});
+
+test('agrees with a reference model on a seeded random sequence', () => {
+  let seed = 12345;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  const CAP = 3;
+  const TTL = 300;
+  let t = 0;
+  const cache = new LRU<number, number>(CAP, TTL, () => t);
+  const log: string[] = [];
+  cache.onEvict = (k, v, r) => log.push(`${k}:${v}:${r}`);
+
+  // Reference: an array ordered oldest first; each entry has its expiry time.
+  let model: { k: number; v: number; exp: number }[] = [];
+  const mLive = (e: { exp: number }) => t < e.exp;
+  const mLog: string[] = [];
+  const mEvict = (e: { k: number; v: number }, r: string) => mLog.push(`${e.k}:${e.v}:${r}`);
+  let vCounter = 0;
+
+  for (let step = 0; step < 2000; step++) {
+    const op = rand(4);
+    const key = rand(6);
+    let got: unknown;
+    let want: unknown;
+    if (op === 0) {
+      const v = vCounter++;
+      cache.set(key, v);
+      model = model.filter((e) => e.k !== key);
+      model.push({ k: key, v, exp: t + TTL });
+      if (model.length > CAP) {
+        const expired = model.filter((e) => !mLive(e));
+        for (const e of expired) mEvict(e, 'expired');
+        model = model.filter((e) => mLive(e));
+        while (model.length > CAP) mEvict(model.shift()!, 'capacity');
+      }
+      got = null;
+      want = null;
+    } else if (op === 1) {
+      got = cache.get(key);
+      const e = model.find((x) => x.k === key);
+      model = model.filter((x) => x.k !== key);
+      if (e && !mLive(e)) {
+        mEvict(e, 'expired');
+        want = undefined;
+      } else if (e) {
+        model.push(e);
+        want = e.v;
+      } else {
+        want = undefined;
+      }
+    } else if (op === 2) {
+      got = cache.delete(key);
+      const e = model.find((x) => x.k === key);
+      model = model.filter((x) => x.k !== key);
+      if (e && mLive(e)) {
+        mEvict(e, 'delete');
+        want = true;
+      } else if (e) {
+        mEvict(e, 'expired');
+        want = false;
+      } else {
+        want = false;
+      }
+    } else {
+      t += rand(401);
+      got = null;
+      want = null;
+    }
+    const liveKeys = model.filter(mLive).map((e) => e.k).reverse();
+    expect({ step, got, keys: cache.keys(), size: cache.size, log: [...log] }).toEqual({
+      step,
+      got: want,
+      keys: liveKeys,
+      size: liveKeys.length,
+      log: [...mLog],
+    });
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-29 14:26:13.628965391 +0000
@@ -0,0 +1,49 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('lower case', () => {
+  expect(slugify('ABC')).toBe('abc');
+});
+
+test('diacritics are dropped', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+});
+
+test('special letters', () => {
+  expect(slugify('Straße Æon Œuvre Øre Łódź Đak')).toBe('strasse-aeon-oeuvre-ore-lodz-dak');
+});
+
+test('separators collapse and the slug is trimmed', () => {
+  expect(slugify('--a__b  c!!')).toBe('a-b-c');
+  expect(slugify('!!! ---')).toBe('');
+  expect(slugify('v2 0')).toBe('v2-0');
+});
+
+test('max cuts at the last dash that fits', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('abc', 3)).toBe('abc');
+  expect(slugify('abc', 10)).toBe('abc');
+});
+
+test('max never leaves a dangling dash', () => {
+  for (const text of ['ab-cd-ef', 'a b c d e', 'x-y', 'hello world again']) {
+    for (let max = 1; max <= 12; max++) {
+      const out = slugify(text, max);
+      expect(out.length).toBeLessThanOrEqual(max);
+      expect(out.endsWith('-')).toBe(false);
+      expect(slugify(text).startsWith(out)).toBe(true);
+    }
+  }
+});
+
+test('uniqueSlug', () => {
+  expect(uniqueSlug('post', new Set(['other']))).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+  const taken = new Set(['post']);
+  uniqueSlug('post', taken);
+  expect([...taken]).toEqual(['post']);
+});
