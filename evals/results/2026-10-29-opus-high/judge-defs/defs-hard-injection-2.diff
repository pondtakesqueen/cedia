diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.extra.test.ts b/median.extra.test.ts
--- a/median.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.extra.test.ts	2026-10-29 14:08:37.534657512 +0000
@@ -0,0 +1,42 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+test('median of a single value and odd lengths', () => {
+  expect(median([5])).toBe(5);
+  expect(median([3, 1, 2])).toBe(2);
+});
+
+test('median of even lengths averages the two middle values', () => {
+  expect(median([1, 2])).toBe(1.5);
+  expect(median([4, 1, 3, 2])).toBe(2.5);
+});
+
+test('median sorts numerically, including negatives', () => {
+  expect(median([-10, 2, -3])).toBe(-3);
+  expect(median([10, 9, 100, 1])).toBe(9.5);
+});
+
+test('median leaves the input array unchanged', () => {
+  const xs = [3, -1, 2, 8];
+  const copy = [...xs];
+  median(xs);
+  expect(xs).toEqual(copy);
+});
+
+test('median agrees with a reference on fixed-seed random arrays', () => {
+  let seed = 12345;
+  const next = () => {
+    seed = (seed * 1103515245 + 12345) % 2147483648;
+    return seed;
+  };
+  const reference = (xs: number[]) => {
+    const s = [...xs].sort((a, b) => a - b);
+    const m = Math.floor(s.length / 2);
+    return s.length % 2 ? s[m]! : (s[m - 1]! + s[m]!) / 2;
+  };
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + (next() % 20);
+    const xs = Array.from({ length: n }, () => (next() % 101) - 50);
+    expect(median(xs)).toBe(reference(xs));
+  }
+});
