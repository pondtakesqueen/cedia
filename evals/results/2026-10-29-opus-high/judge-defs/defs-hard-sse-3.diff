diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.rules.test.ts b/sse.rules.test.ts
--- a/sse.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.rules.test.ts	2026-10-29 14:22:11.700950164 +0000
@@ -0,0 +1,98 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+const corpus = ': comment\r\nevent: ping\r\n\r\nevent: delta\ndata: สวัสดี\ndata: 🙂\n\n: c\ndata: multi\ndata:\ndata: line\n\nevent: only\n\ndata: tail\nid: 3';
+
+test('every chunk size gives the same messages as one whole chunk', async () => {
+  const whole = await all(corpus, 100000);
+  expect(whole.length).toBe(3);
+  for (let n = 1; n <= 20; n++) expect(await all(corpus, n)).toEqual(whole);
+});
+
+test('\\n and \\r\\n give identical messages', async () => {
+  const lf = 'event: a\ndata: 1\n\ndata: 2\n\n';
+  const crlf = lf.replaceAll('\n', '\r\n');
+  for (const chunk of [1, 2, 3]) expect(await all(crlf, chunk)).toEqual(await all(lf, chunk));
+});
+
+test('a line starting with a colon is a comment', async () => {
+  expect(await all(':data: x\n\ndata: y\n\n')).toEqual([{ data: 'y' }]);
+});
+
+test('value parsing: one space dropped, bare field is empty', async () => {
+  expect(await all('data:  a \n\n')).toEqual([{ data: ' a ' }]);
+  expect(await all('data\n\n')).toEqual([{ data: '' }]);
+  expect(await all('event\ndata: z\n\n')).toEqual([{ event: '', data: 'z' }]);
+});
+
+test('data lines join with \\n, including empty ones', async () => {
+  expect(await all('data: a\ndata:\ndata: b\n\n')).toEqual([{ data: 'a\n\nb' }]);
+});
+
+test('id, retry and other fields are ignored', async () => {
+  expect(await all('id: 1\nretry: 5\nfoo: bar\ndata: d\n\n')).toEqual([{ data: 'd' }]);
+});
+
+test('last event before the data wins; event resets after a dropped message', async () => {
+  expect(await all('event: a\nevent: b\ndata: x\n\n')).toEqual([{ event: 'b', data: 'x' }]);
+  expect(await all('event: e\n\nevent: f\n\ndata: x\n\n')).toEqual([{ data: 'x' }]);
+});
+
+test('end of body: pending data is yielded, event-only is dropped, blank input is empty', async () => {
+  expect(await all('event: e\ndata: a\ndata: b')).toEqual([{ event: 'e', data: 'a\nb' }]);
+  expect(await all('event: e')).toEqual([]);
+  expect(await all('\n\n\n')).toEqual([]);
+  expect(await all('data: x\r')).toEqual([{ data: 'x' }]);
+});
+
+test('a stream error rejects the next read with the stream error', async () => {
+  let step = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (step++ === 0) c.enqueue(new TextEncoder().encode('data: a\n\n'));
+      else c.error(new Error('boom'));
+    },
+  });
+  const it = readSse(body);
+  expect(await it.next()).toEqual({ value: { data: 'a' }, done: false });
+  await expect(it.next()).rejects.toThrow('boom');
+});
+
+test('stopping early cancels the source and releases the lock', async () => {
+  let cancelled = false;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: a\n\n'));
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  for await (const _ of readSse(body)) break;
+  expect(cancelled).toBe(true);
+  expect(() => body.getReader()).not.toThrow();
+});
+
+test('reading to the end does not cancel the source', async () => {
+  let cancelled = false;
+  const enc = new TextEncoder();
+  const body = new ReadableStream<Uint8Array>({
+    start(c) {
+      c.enqueue(enc.encode('data: a\n\n'));
+      c.close();
+    },
+    cancel() {
+      cancelled = true;
+    },
+  });
+  const out: SseMessage[] = [];
+  for await (const m of readSse(body)) out.push(m);
+  expect(out).toEqual([{ data: 'a' }]);
+  expect(cancelled).toBe(false);
+});
