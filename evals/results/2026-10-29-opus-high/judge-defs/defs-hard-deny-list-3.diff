 import { homedir } from 'node:os';
-import { isAbsolute, relative, resolve } from 'node:path';
+import { basename, isAbsolute, relative, resolve } from 'node:path';
 
 export type Hit = { name: 'force-push' | 'reset-hard' | 'clean-force' | 'rm-outside'; reason: string };
 
@@ -36,5 +36,62 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  if (argv.length === 0) return undefined;
+  const cmd = basename(argv[0]);
+  if (cmd === 'git') return gitHit(argv.slice(1));
+  if (cmd === 'rm') return rmHit(argv.slice(1), cwd);
+  if (cmd === 'find') return findHit(argv.slice(1), cwd);
+  return undefined;
+}
+
+const gitOptsWithValue = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+const pushForceFlags = new Set(['--force', '--force-with-lease', '--mirror', '--delete', '--prune']);
+
+// One short flag word such as -f, or a group such as -fu.
+const short = (w: string, ch: string) => /^-[^-]/.test(w) && w.slice(1).includes(ch);
+
+// A target that cannot be resolved before it runs: contains $, or is ~user.
+const unresolvable = (t: string) => t.includes('$') || (t.startsWith('~') && t !== '~' && !t.startsWith('~/'));
+
+function gitHit(args: string[]): Hit | undefined {
+  let i = 0;
+  while (i < args.length && args[i].startsWith('-')) i += gitOptsWithValue.has(args[i]) ? 2 : 1;
+  const sub = args[i];
+  const rest = args.slice(i + 1);
+  if (sub === 'push') {
+    const bad = rest.find(
+      (w) => pushForceFlags.has(w.replace(/=.*/, '')) || short(w, 'f') || short(w, 'd') || (!w.startsWith('-') && /^[+:]/.test(w)),
+    );
+    return bad === undefined ? undefined : { name: 'force-push', reason: `git push ${bad} rewrites or deletes remote refs` };
+  }
+  if (sub === 'reset' && rest.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean') {
+    const force = rest.some((w) => w === '--force' || short(w, 'f'));
+    const dry = rest.some((w) => w === '-n' || w === '--dry-run');
+    if (force && !dry) return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  }
+  return undefined;
+}
+
+function rmHit(args: string[], cwd: string): Hit | undefined {
+  let recursive = false;
+  let endOfFlags = false;
+  const targets: string[] = [];
+  for (const w of args) {
+    if (!endOfFlags && w === '--') endOfFlags = true;
+    else if (!endOfFlags && w.startsWith('-')) recursive ||= w === '--recursive' || short(w, 'r') || short(w, 'R');
+    else targets.push(w);
+  }
+  if (!recursive) return undefined;
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets (they may come from xargs)' };
+  const bad = targets.find((t) => unresolvable(t) || !insideWorkspace(t, cwd) || sameDir(t, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `rm -r target ${bad} is outside ${cwd}, is ${cwd} itself, or cannot be resolved` };
+}
+
+function findHit(args: string[], cwd: string): Hit | undefined {
+  if (!args.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const end = args.findIndex((w) => w.startsWith('-'));
+  const starts = end === -1 ? args : args.slice(0, end);
+  const bad = (starts.length ? starts : ['.']).find((p) => unresolvable(p) || !insideWorkspace(p, cwd));
+  return bad === undefined ? undefined : { name: 'rm-outside', reason: `find with -delete or -exec starts at ${bad}, outside ${cwd} or unresolvable` };
 }
