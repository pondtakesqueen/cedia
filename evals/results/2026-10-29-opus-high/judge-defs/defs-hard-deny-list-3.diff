diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.extra.test.ts b/deny.extra.test.ts
--- a/deny.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.extra.test.ts	2026-10-29 14:02:27.418635511 +0000
@@ -0,0 +1,38 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('long push flags with values, and git global options with --', () => {
+  expect(hit('git push --delete=x')).toBe('force-push');
+  expect(hit('git --namespace ns push -f')).toBe('force-push');
+});
+
+test('rm -r of home and of cwd-relative paths', () => {
+  expect(hit('rm -rf ~/x')).toBe('rm-outside');
+  expect(hit('rm -rf ~bob')).toBe('rm-outside');
+});
+
+test('find -exec starting at cwd is fine', () => {
+  expect(hit('find . -exec rm {} ;')).toBeUndefined();
+});
+
+test('every hit carries a non-empty reason', () => {
+  for (const line of ['git push -f', 'git reset --hard', 'git clean -fd', 'rm -rf /etc', 'find / -delete']) {
+    const r = denyListed(line.split(' '), cwd);
+    expect([line, typeof r?.reason, (r?.reason ?? '').length > 0]).toEqual([line, 'string', true]);
+  }
+});
+
+test('rm -r verdict agrees with insideWorkspace and sameDir for many paths', () => {
+  const parts = ['.', '..', 'a', '/', 'work', 'repo'];
+  const paths: string[] = [];
+  for (const a of parts)
+    for (const b of ['', ...parts]) for (const c of ['', ...parts]) paths.push([a, b, c].filter(Boolean).join('/'));
+  for (const p of paths) {
+    const expected = !insideWorkspace(p, cwd) || sameDir(p, cwd);
+    expect([p, denyListed(['rm', '-r', p], cwd) !== undefined]).toEqual([p, expected]);
+    expect([p, denyListed(['find', p, '-delete'], cwd) !== undefined]).toEqual([p, !insideWorkspace(p, cwd)]);
+  }
+});
