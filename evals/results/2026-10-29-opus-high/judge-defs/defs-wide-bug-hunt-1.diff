diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 14:23:01.738708882 +0000
@@ -0,0 +1,95 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { percentOf } from '../src/money/round.ts';
+import { region } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('R1: a line subtotal is unit price times quantity', () => {
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]).toMatchObject({ subtotal: 1080, discount: 0, total: 1080 });
+  });
+
+  test('R2: 10 units exactly get the 5% tier', () => {
+    // 10 pens = 1200; 5% off = 60 -> 1140; shipping 800; tax 7% of 1940 = 136
+    expect(totals(cart('US', [['PEN', 10]]))).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('R2: 50 units get the 10% tier only, not 5% too', () => {
+    // 50 pens = 6000; 10% off = 600 -> 5400; free shipping; tax 378
+    expect(totals(cart('US', [['PEN', 50]]))).toMatchObject({ subtotal: 5400, shipping: 0, tax: 378, total: 5778 });
+  });
+
+  test('R2: lines of the same SKU are merged before the tier is picked', () => {
+    const merged = totals(cart('US', [['PEN', 5], ['PEN', 5]]));
+    expect(merged.lines.length).toBe(1);
+    expect(merged).toMatchObject({ subtotal: 1140, shipping: 800, tax: 136, total: 2076 });
+  });
+
+  test('R2: merging does not change the caller cart', () => {
+    const c = cart('US', [['PEN', 5], ['PEN', 5]]);
+    totals(c);
+    expect(c.lines.map((l) => l.quantity)).toEqual([5, 5]);
+  });
+
+  test('R3: FLAT5 takes 500 off but never below zero', () => {
+    // 1 pen = 120; coupon 120; nothing left; shipping 800; tax 7% of 800 = 56
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('R3: SAVE10 is taken after the bulk discount', () => {
+    // 10 pens -> 1140 after bulk; SAVE10 takes 114 of that
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10')).coupon).toBe(114);
+  });
+
+  test('R4: free shipping uses the amount after the coupon', () => {
+    // 5400 before coupon, 4900 after FLAT5 (below 5000): shipping is charged; tax 7% of 5700 = 399
+    expect(totals(cart('US', [['TEE', 2], ['CAP', 2]], 'FLAT5'))).toMatchObject({
+      subtotal: 5400,
+      coupon: 500,
+      shipping: 800,
+      tax: 399,
+      total: 6099,
+    });
+  });
+
+  test('region table: UK free shipping starts at 4000', () => {
+    // 2 bags = 4400 >= 4000; tax 20% of 4400 = 880
+    expect(totals(cart('UK', [['BAG', 2]]))).toMatchObject({ subtotal: 4400, shipping: 0, tax: 880, total: 5280 });
+  });
+
+  test('region table: each region has the README rate, shipping and threshold', () => {
+    expect(region('US')).toMatchObject({ taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+    expect(region('EU')).toMatchObject({ taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+    expect(region('UK')).toMatchObject({ taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+
+  test('R5: tax rounds half up to the cent', () => {
+    expect(percentOf(150, 0.07)).toBe(11);
+  });
+
+  test('R5: percentOf agrees with exact integer rounding for the rates in use', () => {
+    for (const rate of [0.05, 0.07, 0.1, 0.2]) {
+      const p = Math.round(rate * 100);
+      for (let amount = 0; amount <= 20000; amount++) {
+        expect(percentOf(amount, rate)).toBe(Math.floor((amount * p * 2 + 100) / 200));
+      }
+    }
+  });
+
+  test('R6: total is discounted subtotal + shipping + tax', () => {
+    const cases = [
+      cart('US', [['PEN', 9]]),
+      cart('US', [['PEN', 10]], 'SAVE10'),
+      cart('US', [['PEN', 50]]),
+      cart('US', [['PEN', 1]], 'FLAT5'),
+      cart('US', [['TEE', 2], ['CAP', 2]], 'FLAT5'),
+      cart('EU', [['MUG', 3], ['TEE', 1]]),
+      cart('UK', [['BAG', 2]]),
+    ];
+    for (const c of cases) {
+      const t = totals(c);
+      expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+    }
+  });
+});
