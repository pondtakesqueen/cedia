diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 14:24:03.706712566 +0000
@@ -0,0 +1,137 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { percentOf } from '../src/money/round.ts';
+import { totals } from '../src/order/total.ts';
+import { REGIONS, region } from '../src/pricing/regions.ts';
+import { shippingFor } from '../src/pricing/shipping.ts';
+
+// Rules from README.md, checked against hand-worked numbers and integer arithmetic.
+describe('pricing rules', () => {
+  test('rule 1: a line subtotal is unit price times quantity', () => {
+    expect(totals(cart('US', [['TEE', 3]])).lines[0]).toMatchObject({ subtotal: 4500, discount: 0, total: 4500 });
+  });
+
+  test('rule 2: no bulk discount below 10 units', () => {
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]).toMatchObject({ subtotal: 1080, discount: 0 });
+  });
+
+  test('rule 2: 10 units get 5%', () => {
+    expect(totals(cart('US', [['PEN', 10]])).lines[0]).toMatchObject({ subtotal: 1200, discount: 60 });
+  });
+
+  test('rule 2: 49 units still get 5%', () => {
+    expect(totals(cart('US', [['PEN', 49]])).lines[0]).toMatchObject({ subtotal: 5880, discount: 294 });
+  });
+
+  test('rule 2: 50 units get 10% only, not 15%', () => {
+    expect(totals(cart('US', [['PEN', 50]])).lines[0]).toMatchObject({ subtotal: 6000, discount: 600 });
+  });
+
+  test('rule 2: lines of the same SKU are merged before bulk pricing, and the input cart is not changed', () => {
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    const merged = totals(c);
+    expect(merged.lines).toHaveLength(1);
+    expect(merged.lines[0]).toMatchObject({ quantity: 10, discount: 60 });
+    expect(merged).toEqual(totals(cart('US', [['PEN', 10]])));
+    expect(c.lines[0].quantity).toBe(6);
+  });
+
+  test('rule 3: SAVE10 applies after bulk discounts', () => {
+    // 1200 - 60 bulk = 1140; 10% of 1140 = 114
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10'))).toMatchObject({ subtotal: 1140, coupon: 114 });
+  });
+
+  test('rule 3: FLAT5 never takes the amount below zero', () => {
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ subtotal: 120, coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('rule 3: coupon codes are case-insensitive; unknown codes give nothing', () => {
+    expect(totals(cart('US', [['BAG', 1]], 'save10')).coupon).toBe(220);
+    expect(totals(cart('US', [['BAG', 1]], 'NOPE')).coupon).toBe(0);
+  });
+
+  test('rule 4: discounted amount exactly at the threshold ships free', () => {
+    // 6600 - 10% = 5940 >= 5000
+    expect(totals(cart('US', [['BAG', 3]], 'SAVE10'))).toMatchObject({ shipping: 0 });
+  });
+
+  test('rule 4: the threshold uses the discounted amount, not the subtotal', () => {
+    // 5100 subtotal >= 5000, but 5100 - 500 = 4600 < 5000
+    expect(totals(cart('US', [['TEE', 3], ['PEN', 5]], 'FLAT5'))).toMatchObject({ subtotal: 5100, shipping: 800 });
+  });
+
+  test('rule 4: exact UK threshold ships free through the cart', () => {
+    expect(totals(cart('UK', [['TEE', 2], ['CAP', 1]])).shipping).toBe(0); // 4200
+    expect(totals(cart('UK', [['BAG', 1], ['MUG', 4]])).shipping).toBe(0); // 4000
+  });
+
+  test('rule 4: shipping is free at the threshold and charged one cent below it', () => {
+    for (const code of Object.keys(REGIONS)) {
+      const r = region(code);
+      expect(shippingFor(r, r.freeShippingFrom)).toBe(0);
+      expect(shippingFor(r, r.freeShippingFrom - 1)).toBe(r.shipping);
+    }
+  });
+
+  test('region table matches README.md', () => {
+    expect(REGIONS).toEqual({
+      US: { code: 'US', taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 },
+      EU: { code: 'EU', taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 },
+      UK: { code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 },
+    });
+  });
+
+  test('rule 5: tax is on discounted subtotal plus shipping, rounded half up', () => {
+    // 450 + 800 = 1250; 7% = 87.5 -> 88
+    expect(totals(cart('US', [['MUG', 1]]))).toMatchObject({ tax: 88, total: 1338 });
+  });
+
+  test('rule 5: percentOf matches exact integer half-up rounding', () => {
+    for (let amount = 0; amount <= 20000; amount++) {
+      for (const bp of [700, 2000, 500, 1000]) {
+        expect(percentOf(amount, bp / 10000)).toBe(Math.floor((amount * bp + 5000) / 10000));
+      }
+    }
+  });
+
+  test('rule 6: total is discounted subtotal plus shipping plus tax, and matches a reference', () => {
+    const skus = ['MUG', 'TEE', 'CAP', 'PEN', 'BAG'];
+    const prices: Record<string, number> = { MUG: 450, TEE: 1500, CAP: 1200, PEN: 120, BAG: 2200 };
+    const coupons: (string | undefined)[] = [undefined, 'SAVE10', 'FLAT5'];
+    const regionCodes = Object.keys(REGIONS);
+    let seed = 7;
+    const next = (n: number) => {
+      seed = (seed * 1103515245 + 12345) % 2147483648;
+      return seed % n;
+    };
+    for (let i = 0; i < 60; i++) {
+      const items: [string, number][] = [];
+      const count = 1 + next(4);
+      for (let k = 0; k < count; k++) items.push([skus[next(skus.length)], 1 + next(60)]);
+      const c = cart(regionCodes[next(regionCodes.length)], items, coupons[next(coupons.length)]);
+      const t = totals(c);
+
+      const r = REGIONS[c.region];
+      const bySku = new Map<string, number>();
+      for (const [sku, q] of items) bySku.set(sku, (bySku.get(sku) ?? 0) + q);
+      let subtotal = 0;
+      for (const [sku, q] of bySku) {
+        const gross = prices[sku] * q;
+        const rate = q >= 50 ? 1000 : q >= 10 ? 500 : 0;
+        subtotal += gross - Math.floor((gross * rate + 5000) / 10000);
+      }
+      const coupon = c.coupon === 'SAVE10' ? Math.floor((subtotal * 1000 + 5000) / 10000) : c.coupon === 'FLAT5' ? Math.min(500, subtotal) : 0;
+      const discounted = subtotal - coupon;
+      const shipping = discounted >= r.freeShippingFrom ? 0 : r.shipping;
+      const tax = Math.floor(((discounted + shipping) * Math.round(r.taxRate * 10000) + 5000) / 10000);
+
+      expect(t.subtotal).toBe(t.lines.reduce((a, l) => a + l.total, 0));
+      expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+      expect(t).toMatchObject({ subtotal, coupon, shipping, tax, total: discounted + shipping + tax });
+    }
+  });
+
+  test('a bad region is an error, not a default', () => {
+    expect(() => totals(cart('FR', [['MUG', 1]]))).toThrow('unknown region FR');
+  });
+});
