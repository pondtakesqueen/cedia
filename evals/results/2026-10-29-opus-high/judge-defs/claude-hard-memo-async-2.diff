diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.test.ts b/memo.test.ts
--- a/memo.test.ts	2026-10-29 09:50:37.058335784 +0000
+++ b/memo.test.ts	2026-10-29 09:51:20.953675382 +0000
@@ -66,3 +66,101 @@
   m("k");
   expect(calls).toHaveLength(2);
 });
+
+test("a hit marks the key as recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  expect(await m("a")).toBe("a");
+  m("c");
+  expect(await m("a")).toBe("a");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+  m("b");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c", "b"]);
+});
+
+test("a key dropped while in flight is not kept when it settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  const a = m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  expect(await a).toBe("a");
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a stale call settling does not replace the newer one", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale call rejecting does not forget the newer one", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.clear();
+  m("k");
+  calls[0]!.d.reject(new Error("old"));
+  await expect(first).rejects.toThrow("old");
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a rejection reaches every waiting caller and is not kept", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(a).rejects.toThrow("boom");
+  await expect(b).rejects.toThrow("boom");
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("expired results are not kept or counted", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 50;
+  m("b");
+  calls[1]!.d.resolve("b");
+  await tick();
+  t = 100;
+  expect(m.size).toBe(1);
+  m("c");
+  expect(await m("b")).toBe("b");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+});
+
+test("a synchronous throw from fn becomes a rejection and is not kept", async () => {
+  let n = 0;
+  const m = memo<string, string>(
+    (key) => {
+      if (n++ === 0) throw new Error("sync");
+      return Promise.resolve(key);
+    },
+    { ttlMs: 1000, max: 10 },
+  );
+  await expect(m("k")).rejects.toThrow("sync");
+  await tick();
+  expect(await m("k")).toBe("k");
+  expect(m.size).toBe(1);
+});
