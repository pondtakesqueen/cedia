+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+
+// Seeded LCG so the random cases are the same on every run.
+function rng(seed: number) {
+  let s = seed >>> 0;
+  return (n: number) => {
+    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
+    return s % n;
+  };
+}
+
+describe('matchCheck rules', () => {
+  test('returns the check as written, not normalized', () => {
+    expect(matchCheck('bun test', ['x', '  bun  test '])).toBe('  bun  test ');
+  });
+
+  test('2>&1 is dropped from both sides', () => {
+    expect(matchCheck('bun test 2>&1', ['bun test 2>&1'])).toBe('bun test 2>&1');
+  });
+
+  test('pipes and separators do not match', () => {
+    expect(matchCheck('bun test; ls', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test || true', ['bun test'])).toBeUndefined();
+  });
+
+  test('cd handling: quoted dirs, dot-dot, and only one cd stripped', () => {
+    expect(matchCheck("cd '/work/repo' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd /work/repo/.. && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+});
+
+describe('ledgerEntries rules', () => {
+  test('the latest intent for a callId wins', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'k', tool: 'edit', input: { path: 'a.ts' } },
+      { kind: 'request' },
+      { kind: 'tool_intent', callId: 'k', tool: 'edit', input: { path: 'b.ts' } },
+      { kind: 'tool_result', callId: 'k', status: 'completed', output: { isError: false } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([{ kind: 'write', at: 3, tool: 'edit', path: 'b.ts' }]);
+  });
+
+  test('a snapshot gives writes even for a failed edit or a read-only ls', () => {
+    const failed: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'f', tool: 'edit', input: { path: 'a.ts' } },
+      { kind: 'tool_result', callId: 'f', status: 'failed', output: { isError: true } },
+      { kind: 'snapshot', callId: 'f', changed: ['a.ts'] },
+    ];
+    expect(ledgerEntries(failed, [])).toEqual([{ kind: 'write', at: 1, tool: 'edit', path: 'a.ts' }]);
+
+    const ls: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'l', tool: 'bash', input: { command: 'ls' } },
+      { kind: 'tool_result', callId: 'l', status: 'completed', output: { isError: false, exitCode: 0 } },
+      { kind: 'snapshot', callId: 'l', changed: ['z.ts'] },
+    ];
+    expect(ledgerEntries(ls, [])).toEqual([{ kind: 'write', at: 1, tool: 'bash', path: 'z.ts' }]);
+  });
+
+  test('an explicit exit code is used; without one, isError gives 0 or 1', () => {
+    const ev = (exitCode: number | undefined, isError: boolean): SessionEvent[] => [
+      { kind: 'tool_intent', callId: 'x', tool: 'bash', input: { command: 'bun test' } },
+      { kind: 'tool_result', callId: 'x', status: 'failed', output: { isError, ...(exitCode === undefined ? {} : { exitCode }) } },
+    ];
+    expect(ledgerEntries(ev(2, true), ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 2 }]);
+    expect(ledgerEntries(ev(undefined, false), ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+  });
+
+  test('a bash write keeps the command text and has no path key', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'w', tool: 'bash', input: { command: 'npm  i' } },
+      { kind: 'tool_result', callId: 'w', status: 'completed', output: { isError: false, exitCode: 0 } },
+    ];
+    const [e] = ledgerEntries(events, []);
+    expect(e).toEqual({ kind: 'write', at: 1, tool: 'bash', command: 'npm  i' });
+    expect('path' in e!).toBe(false);
+  });
+
+  test('a completed edit with no string path gives no write', () => {
+    const events: SessionEvent[] = [
+      { kind: 'tool_intent', callId: 'p', tool: 'edit', input: {} },
+      { kind: 'tool_result', callId: 'p', status: 'completed', output: { isError: false } },
+    ];
+    expect(ledgerEntries(events, [])).toEqual([]);
+  });
+});
+
+describe('evidence and verified rules', () => {
+  const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+  const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+  test('unverified counts from the last passing check', () => {
+    expect(evidence([w(1, 'a'), c(2, 0), w(3, 'b'), c(4, 1)]).unverified).toEqual(['b']);
+  });
+
+  test('changed and unverified dedupe in first-seen order', () => {
+    const e = evidence([w(1, 'b'), w(2, 'a'), w(3, 'b')]);
+    expect(e.changed).toEqual(['b', 'a']);
+    expect(e.unverified).toEqual(['b', 'a']);
+  });
+
+  test('verified is false when writes have no passing check after them, with two checks declared', () => {
+    expect(verified([w(1, 'a'), c(2, 1)], ['bun test', 'make lint'])).toBe(false);
+  });
+
+  test('random logs: verified agrees with unverified, and changed is first-seen order', () => {
+    const next = rng(42);
+    const labels = ['a.ts', 'b.ts', 'c.ts'];
+    for (let run = 0; run < 500; run++) {
+      const len = next(13);
+      const entries: LedgerEntry[] = [];
+      for (let at = 0; at < len; at++) {
+        entries.push(next(2) === 0 ? w(at, labels[next(3)]!) : c(at, next(2)));
+      }
+      expect(verified(entries, ['bun test'])).toBe(evidence(entries).unverified.length === 0);
+      const seen: string[] = [];
+      for (const e of entries) if (e.kind === 'write' && !seen.includes(e.path!)) seen.push(e.path!);
+      expect(evidence(entries).changed).toEqual(seen);
+    }
+  });
+
+  test('random event logs: at points at tool_result events and never decreases', () => {
+    const next = rng(7);
+    const cmds = ['bun test', 'npm i', 'ls'];
+    const statuses = ['completed', 'failed', 'denied', 'not_started'] as const;
+    for (let run = 0; run < 200; run++) {
+      const events: SessionEvent[] = [];
+      const calls = next(11);
+      for (let i = 0; i < calls; i++) {
+        if (next(3) === 0) events.push({ kind: 'request' });
+        const callId = `r${i}`;
+        const bash = next(2) === 0;
+        const input = bash ? { command: cmds[next(3)] } : { path: 'f.ts' };
+        events.push({ kind: 'tool_intent', callId, tool: bash ? 'bash' : 'edit', input });
+        events.push({ kind: 'tool_result', callId, status: statuses[next(4)]!, output: { isError: next(2) === 0, exitCode: next(2) } });
+      }
+      const entries = ledgerEntries(events, ['bun test']);
+      let prev = -1;
+      for (const e of entries) {
+        expect(e.at).toBeGreaterThanOrEqual(prev);
+        expect(events[e.at]?.kind).toBe('tool_result');
+        prev = e.at;
+      }
+    }
+  });
+});
