diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.contract.test.ts b/pool.contract.test.ts
--- a/pool.contract.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.contract.test.ts	2026-10-29 14:18:47.938693796 +0000
@@ -0,0 +1,271 @@
+import { expect, test } from "bun:test";
+import { runPool } from "./pool";
+
+const flush = async () => {
+  for (let i = 0; i < 10; i++) await Promise.resolve();
+};
+
+type Call = { resolve: (v: string) => void; reject: (e: unknown) => void; settled: boolean };
+
+// Tasks the test settles by hand. `calls[i]` holds one entry per call of task i; `order` lists task indexes in call order.
+function gated(count: number) {
+  const calls: Call[][] = Array.from({ length: count }, () => []);
+  const order: number[] = [];
+  const tasks = calls.map((log, i) => () => new Promise<string>((resolve, reject) => {
+    order.push(i);
+    log.push({ resolve, reject, settled: false });
+  }));
+  const last = (i: number) => calls[i][calls[i].length - 1];
+  return {
+    tasks,
+    calls,
+    order,
+    inFlight: () => calls.filter((log) => log.length > 0 && !log[log.length - 1].settled).length,
+    ok: (i: number, v: string) => {
+      const c = last(i);
+      c.settled = true;
+      c.resolve(v);
+    },
+    fail: (i: number, e: unknown) => {
+      const c = last(i);
+      c.settled = true;
+      c.reject(e);
+    },
+  };
+}
+
+test("refuses a bad limit or retries before any task starts", async () => {
+  let calls = 0;
+  const task = () => {
+    calls++;
+    return 1;
+  };
+  for (const limit of [0, -1, 1.5, NaN]) {
+    await expect(runPool([task], limit)).rejects.toBeInstanceOf(RangeError);
+  }
+  for (const retries of [-1, 1.5, NaN]) {
+    await expect(runPool([task], 1, { retries })).rejects.toBeInstanceOf(RangeError);
+  }
+  expect(calls).toBe(0);
+  expect(await runPool([task], Infinity)).toEqual([{ status: "fulfilled", value: 1, attempts: 1 }]);
+});
+
+test("keeps at most limit tasks in flight and starts them in input order", async () => {
+  const g = gated(5);
+  const done = runPool(g.tasks, 2);
+  await flush();
+  expect(g.order).toEqual([0, 1]);
+  g.ok(1, "b");
+  await flush();
+  expect(g.order).toEqual([0, 1, 2]);
+  expect(g.inFlight()).toBe(2);
+  g.ok(2, "c");
+  g.ok(0, "a");
+  await flush();
+  expect(g.order).toEqual([0, 1, 2, 3, 4]);
+  expect(g.inFlight()).toBe(2);
+  g.ok(3, "d");
+  g.ok(4, "e");
+  const out = await done;
+  expect(out.map((r) => r.status)).toEqual(["fulfilled", "fulfilled", "fulfilled", "fulfilled", "fulfilled"]);
+});
+
+test("results sit in the slot of their task, not in finishing order", async () => {
+  const g = gated(3);
+  const done = runPool(g.tasks, 3);
+  await flush();
+  g.ok(2, "c");
+  g.fail(0, "boom");
+  g.ok(1, "b");
+  const out = await done;
+  expect(out).toEqual([
+    { status: "rejected", reason: "boom", attempts: 1 },
+    { status: "fulfilled", value: "b", attempts: 1 },
+    { status: "fulfilled", value: "c", attempts: 1 },
+  ]);
+});
+
+test("a rejected task is retried in the same slot, up to retries more calls", async () => {
+  const g = gated(2);
+  const done = runPool(g.tasks, 1, { retries: 2 });
+  await flush();
+  g.fail(0, "x1");
+  await flush();
+  expect(g.calls[0].length).toBe(2);
+  expect(g.order).toEqual([0, 0]);
+  g.fail(0, "x2");
+  await flush();
+  expect(g.calls[0].length).toBe(3);
+  expect(g.order).toEqual([0, 0, 0]);
+  g.fail(0, "x3");
+  await flush();
+  expect(g.calls[0].length).toBe(3);
+  expect(g.order).toEqual([0, 0, 0, 1]);
+  g.ok(1, "b");
+  expect(await done).toEqual([
+    { status: "rejected", reason: "x3", attempts: 3 },
+    { status: "fulfilled", value: "b", attempts: 1 },
+  ]);
+});
+
+test("a sync throw is a rejection and a plain value is a fulfilment, and both are retried", async () => {
+  let calls = 0;
+  const tasks = [
+    () => {
+      calls++;
+      throw "boom";
+    },
+    () => {
+      calls++;
+      return "plain";
+    },
+  ];
+  const out = await runPool(tasks, 1, { retries: 1 });
+  expect(out).toEqual([
+    { status: "rejected", reason: "boom", attempts: 2 },
+    { status: "fulfilled", value: "plain", attempts: 1 },
+  ]);
+  expect(calls).toBe(3);
+});
+
+test("an aborted signal at the call starts nothing and rejects every slot with the reason", async () => {
+  const ac = new AbortController();
+  ac.abort("stop");
+  const g = gated(2);
+  const out = await runPool(g.tasks, 1, { signal: ac.signal });
+  expect(g.order).toEqual([]);
+  expect(out).toEqual([
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("an abort mid-run keeps in-flight results and rejects the tasks that never started", async () => {
+  const ac = new AbortController();
+  const g = gated(3);
+  const done = runPool(g.tasks, 1, { signal: ac.signal });
+  await flush();
+  ac.abort("stop");
+  g.ok(0, "a");
+  const out = await done;
+  expect(g.order).toEqual([0]);
+  expect(out).toEqual([
+    { status: "fulfilled", value: "a", attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("an abort cancels the retry of a task in flight, which settles with the reason", async () => {
+  const ac = new AbortController();
+  const g = gated(2);
+  const done = runPool(g.tasks, 1, { retries: 2, signal: ac.signal });
+  await flush();
+  ac.abort("stop");
+  g.fail(0, "boom");
+  const out = await done;
+  expect(g.calls[0].length).toBe(1);
+  expect(out).toEqual([
+    { status: "rejected", reason: "stop", attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("matches a sequential reference under random timing, outcomes and limits", async () => {
+  let seed = 1;
+  const rand = (n: number) => {
+    seed = (seed * 16807) % 2147483647;
+    return seed % n;
+  };
+  const kinds = ["ok", "fail", "throw", "plain"] as const;
+  for (let c = 0; c < 200; c++) {
+    const n = rand(13);
+    const limit = rand(5) === 4 ? Infinity : 1 + rand(4);
+    const retries = rand(3);
+    const scripts = Array.from({ length: n }, () => Array.from({ length: retries + 1 }, () => kinds[rand(4)]));
+    const delays = Array.from({ length: n }, () => rand(3));
+    const calls = Array<number>(n).fill(0);
+    let inFlight = 0;
+    let peak = 0;
+    const tasks = scripts.map((script, i) => () => {
+      const a = ++calls[i];
+      const kind = script[a - 1];
+      const value = `${i}:${a}`;
+      inFlight++;
+      peak = Math.max(peak, inFlight);
+      // A task counts as in flight until a microtask after it settles, so overlap is visible even for sync tasks.
+      if (kind === "throw") {
+        queueMicrotask(() => inFlight--);
+        throw value;
+      }
+      if (kind === "plain") {
+        queueMicrotask(() => inFlight--);
+        return value;
+      }
+      return (async () => {
+        for (let k = 0; k <= delays[i]; k++) await null;
+        inFlight--;
+        if (kind === "fail") throw value;
+        return value;
+      })();
+    });
+    const out = await runPool(tasks, limit, { retries });
+    const expected = scripts.map((script, i) => {
+      const tries = Math.min(retries + 1, script.findIndex((k) => k === "ok" || k === "plain") + 1 || retries + 1);
+      const kind = script[tries - 1];
+      const value = `${i}:${tries}`;
+      return kind === "ok" || kind === "plain"
+        ? { status: "fulfilled", value, attempts: tries }
+        : { status: "rejected", reason: value, attempts: tries };
+    });
+    expect(out).toEqual(expected);
+    expect(peak).toBe(Math.min(limit, n));
+  }
+});
+
+test("an abort from inside a task starts nothing after it", async () => {
+  const ac = new AbortController();
+  const started: number[] = [];
+  const tasks = [0, 1, 2].map((i) => () => {
+    started.push(i);
+    if (i === 0) ac.abort("stop");
+    return i;
+  });
+  const out = await runPool(tasks, 3, { signal: ac.signal });
+  expect(started).toEqual([0]);
+  expect(out).toEqual([
+    { status: "fulfilled", value: 0, attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("an abort with several tasks in flight rejects the unstarted slots only after the last one settles", async () => {
+  const ac = new AbortController();
+  const g = gated(4);
+  let finished = false;
+  const done = runPool(g.tasks, 2, { signal: ac.signal }).then((out) => {
+    finished = true;
+    return out;
+  });
+  await flush();
+  ac.abort("stop");
+  g.ok(1, "b");
+  await flush();
+  expect(finished).toBe(false);
+  g.ok(0, "a");
+  const out = await done;
+  expect(g.order).toEqual([0, 1]);
+  expect(out).toEqual([
+    { status: "fulfilled", value: "a", attempts: 1 },
+    { status: "fulfilled", value: "b", attempts: 1 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+    { status: "rejected", reason: "stop", attempts: 0 },
+  ]);
+});
+
+test("a thenable return value is adopted like a promise", async () => {
+  const thenable = { then: (res: (v: string) => void) => res("t") };
+  const out = await runPool([() => thenable as unknown as Promise<string>], 1);
+  expect(out).toEqual([{ status: "fulfilled", value: "t", attempts: 1 }]);
+});
