diff -ruN '--exclude=node_modules' '--exclude=.git' a/sse.rules.test.ts b/sse.rules.test.ts
--- a/sse.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/sse.rules.test.ts	2026-10-29 14:20:16.966699088 +0000
@@ -0,0 +1,134 @@
+import { expect, test } from 'bun:test';
+import { readSse, streamFromString, type SseMessage } from './sse.ts';
+
+async function all(text: string, chunk = 7): Promise<SseMessage[]> {
+  const out: SseMessage[] = [];
+  for await (const m of readSse(streamFromString(text, chunk))) out.push(m);
+  return out;
+}
+
+const corpus = ': c\r\nevent: e\r\ndata: สวัสดี 🙂\r\ndata:  b\r\nid: 3\r\n\r\ndata\n\nevent: \ndata: z\n\ndata: tail';
+
+test('every chunk size, including splits inside UTF-8 and CRLF, gives the same messages', async () => {
+  const want = await all(corpus, corpus.length);
+  expect(want).toEqual([
+    { event: 'e', data: 'สวัสดี 🙂\n b' },
+    { data: '' },
+    { event: '', data: 'z' },
+    { data: 'tail' },
+  ]);
+  for (let chunk = 1; chunk <= 20; chunk++) expect(await all(corpus, chunk)).toEqual(want);
+});
+
+test('LF and CRLF line endings give the same messages', async () => {
+  expect(await all('event: a\ndata: 1\ndata: 2\n\n')).toEqual(await all('event: a\r\ndata: 1\r\ndata: 2\r\n\r\n'));
+});
+
+test('a comment line is ignored, even when it looks like a field', async () => {
+  expect(await all(':data: x\n\n')).toEqual([]);
+});
+
+test('only one space after the colon is dropped', async () => {
+  expect(await all('data:  a \n\n')).toEqual([{ data: ' a ' }]);
+});
+
+test('a line with no colon is a field with an empty value', async () => {
+  expect(await all('data\ndata\n\n')).toEqual([{ data: '\n' }]);
+});
+
+test('data lines are joined with a newline', async () => {
+  expect(await all('data: a\ndata: b\ndata: c\n\n')).toEqual([{ data: 'a\nb\nc' }]);
+});
+
+test('other fields are ignored, and field names match exactly', async () => {
+  expect(await all('id: 1\nretry: 5\nfoo: x\ndata : y\n\n')).toEqual([]);
+});
+
+test('an event without data is dropped and the event is reset', async () => {
+  const [m] = await all('event: a\n\ndata: b\n\n');
+  expect(m).toEqual({ data: 'b' });
+  expect('event' in m).toBe(false);
+});
+
+test('the event belongs to one message only', async () => {
+  const [first, second] = await all('event: a\ndata: 1\n\ndata: 2\n\n');
+  expect(first).toEqual({ event: 'a', data: '1' });
+  expect('event' in second).toBe(false);
+});
+
+test('an empty event name is still a set event', async () => {
+  expect(await all('event:\ndata: 1\n\n')).toEqual([{ event: '', data: '1' }]);
+});
+
+test('a body that ends without a newline flushes its pending message', async () => {
+  expect(await all('event: e\ndata: x')).toEqual([{ event: 'e', data: 'x' }]);
+  expect(await all('event: e')).toEqual([]);
+});
+
+test('a lone CR is not a line ending', async () => {
+  expect(await all('data: a\rb\n\n')).toEqual([{ data: 'a\rb' }]);
+});
+
+test('a message is yielded before the body ends', async () => {
+  const enc = new TextEncoder();
+  let step = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (step++ === 0) c.enqueue(enc.encode('data: one\n\n'));
+      else return new Promise(() => {});
+    },
+  });
+  const it = readSse(body);
+  expect(await it.next()).toEqual({ value: { data: 'one' }, done: false });
+  await it.return(undefined);
+});
+
+test('a stream error reaches the consumer unchanged', async () => {
+  const boom = new Error('boom');
+  let step = 0;
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      if (step++ === 0) c.enqueue(new TextEncoder().encode('data: one\n\n'));
+      else c.error(boom);
+    },
+  });
+  const it = readSse(body);
+  expect(await it.next()).toEqual({ value: { data: 'one' }, done: false });
+  await expect(it.next()).rejects.toBe(boom);
+});
+
+function endlessBody() {
+  const state = { cancelled: false };
+  const body = new ReadableStream<Uint8Array>({
+    pull(c) {
+      c.enqueue(new TextEncoder().encode('data: x\n\n'));
+    },
+    cancel() {
+      state.cancelled = true;
+    },
+  });
+  return { body, state };
+}
+
+test('a consumer that breaks early cancels the source', async () => {
+  const { body, state } = endlessBody();
+  for await (const m of readSse(body)) {
+    expect(m).toEqual({ data: 'x' });
+    break;
+  }
+  expect(state.cancelled).toBe(true);
+});
+
+test('a consumer that throws cancels the source', async () => {
+  const { body, state } = endlessBody();
+  const fail = new Error('consumer failed');
+  await expect(
+    (async () => {
+      for await (const m of readSse(body)) {
+        expect(m).toEqual({ data: 'x' });
+        throw fail;
+      }
+    })(),
+  ).rejects.toBe(fail);
+  expect(state.cancelled).toBe(true);
+});
