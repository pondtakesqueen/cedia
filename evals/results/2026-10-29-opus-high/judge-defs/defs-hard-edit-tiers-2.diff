diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.tiers.test.ts b/edit.tiers.test.ts
--- a/edit.tiers.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.tiers.test.ts	2026-10-29 14:06:36.490650316 +0000
@@ -0,0 +1,98 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+const errOf = (r: ReturnType<typeof applyEdit>) => ('error' in r ? r.error : '');
+
+describe('replace_all matches split/join', () => {
+  const alphabet = ['a', 'b', '\n'];
+  const contents: string[] = [''];
+  for (let len = 1; len <= 4; len++) {
+    for (let n = 0; n < alphabet.length ** len; n++) {
+      let s = '';
+      let x = n;
+      for (let j = 0; j < len; j++) {
+        s += alphabet[x % alphabet.length];
+        x = Math.floor(x / alphabet.length);
+      }
+      contents.push(s);
+    }
+  }
+  const olds = ['a', 'b', 'ab', 'a\nb', '\n', 'ba\n'];
+  test('every generated content and old_text', () => {
+    let checked = 0;
+    for (const content of contents) {
+      for (const old of olds) {
+        if (!content.includes(old)) continue;
+        const r = ok(applyEdit(content, { old_text: old, new_text: 'X', replace_all: true }));
+        expect(r.content).toBe(content.split(old).join('X'));
+        expect(r.applied.count).toBe(content.split(old).length - 1);
+        expect(r.applied.tier).toBe('exact');
+        checked++;
+      }
+    }
+    expect(checked).toBeGreaterThan(100);
+  });
+});
+
+describe('tiers and reporting', () => {
+  test('exact wins over trailing-space when both match', () => {
+    const r = ok(applyEdit('a \na\n', { old_text: 'a\n', new_text: 'b\n' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+    expect(r.content).toBe('a \nb\n');
+  });
+  test('exact multi-match error names the first line', () => {
+    const e = errOf(applyEdit('q\nq\nz\nq\n', { old_text: 'q', new_text: 'r' }));
+    expect(e).toContain('matches 3 places');
+    expect(e).toContain('line 1');
+    const e2 = errOf(applyEdit('a\nb\nx\nx\n', { old_text: 'x', new_text: 'r' }));
+    expect(e2).toContain('line 3');
+  });
+  test('exact match on a trailing newline reports one line', () => {
+    const r = ok(applyEdit('a\nb\nc\n', { old_text: 'b\n', new_text: 'B\n' }));
+    expect(r.applied).toEqual({ from: 2, to: 2, tier: 'exact', count: 1 });
+    expect(r.content).toBe('a\nB\nc\n');
+  });
+  test('replace_all with two trailing-space matches is still an error', () => {
+    const e = errOf(applyEdit('a \nb\na  \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }));
+    expect(e).toContain('matches 2 places');
+  });
+  test('indentation multi-match error lists the lines', () => {
+    const e = errOf(applyEdit('  x\n  q\n    x\n  q\n', { old_text: 'x\nq', new_text: 'z' }));
+    expect(e).toContain('matches 2 places');
+    expect(e).toContain('1, 3');
+  });
+  test('no trailing newline is kept', () => {
+    const r = ok(applyEdit('a\n  b', { old_text: 'b', new_text: 'c' }));
+    expect(r.content).toBe('a\n  c');
+  });
+  test('new_text of a single newline leaves one blank line in the line tiers', () => {
+    const r = ok(applyEdit('a  \nb\n', { old_text: 'a\n', new_text: '\n' }));
+    expect(r.applied).toEqual({ from: 1, to: 1, tier: 'trailing-space', count: 1 });
+    expect(r.content).toBe('\nb\n');
+    const r2 = ok(applyEdit('  a\n  b\nc\n', { old_text: 'a\nb\n', new_text: '\n' }));
+    expect(r2.applied.tier).toBe('indentation');
+    expect(r2.content).toBe('\nc\n');
+  });
+  test('deleting every line leaves an empty file', () => {
+    const r = ok(applyEdit('a\n', { old_text: 'a\n', new_text: '' }));
+    expect(r.content).toBe('');
+  });
+  test('old_text longer than the content is not found, not a crash', () => {
+    expect(errOf(applyEdit('a\n', { old_text: 'a\nb\nc\nd', new_text: 'x' }))).toContain('not found');
+  });
+  test('not found lists at most five lines', () => {
+    const content = 'v\n'.repeat(7);
+    const e = errOf(applyEdit(content, { old_text: 'v\nw', new_text: 'x' }));
+    expect(e).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect(e).not.toContain('6');
+  });
+  test('whitespace-only old_text gives no pointer', () => {
+    const e = errOf(applyEdit('a\nb\n', { old_text: '   \n  ', new_text: 'x' }));
+    expect(e).toContain('not found');
+    expect(e).not.toContain('appears');
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-29 14:03:31.295183126 +0000
+++ b/edit.ts	2026-10-29 14:06:31.078649995 +0000
@@ -3,6 +3,9 @@
 // from/to are 1-based line numbers of the replaced text in the original content; count is how many places were replaced.
 export type Applied = { from: number; to: number; tier: Tier; count: number };
 
+const unNl = (s: string) => (s.endsWith('\n') ? s.slice(0, -1) : s);
+const indentOf = (lines: string[]) => /^\s*/.exec(lines.find((l) => l.trim() !== '') ?? '')![0];
+
 // Applies one edit to `content`.
 //
 // Tiers, tried in order; a tier applies only when it finds exactly one place (or replace_all is set, exact tier only):
@@ -23,5 +26,60 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: next, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create the file' };
+  if (old === next) return { error: 'old_text and new_text are the same' };
+
+  const lineAt = (idx: number) => content.slice(0, idx).split('\n').length;
+  const idxs: number[] = [];
+  for (let i = content.indexOf(old); i !== -1; i = content.indexOf(old, i + old.length)) idxs.push(i);
+  if (idxs.length > 1 && !replace_all) {
+    return { error: `old_text matches ${idxs.length} places (first at line ${lineAt(idxs[0])}); add more context or set replace_all` };
+  }
+  if (idxs.length > 0) {
+    const from = lineAt(idxs[0]);
+    const span = unNl(old).split('\n').length - 1;
+    const out = replace_all
+      ? content.split(old).join(next)
+      : content.slice(0, idxs[0]) + next + content.slice(idxs[0] + old.length);
+    return { content: out, applied: { from, to: from + span, tier: 'exact', count: idxs.length } };
+  }
+
+  const hasNl = content.endsWith('\n');
+  const body = (hasNl ? content.slice(0, -1) : content).split('\n');
+  const oldLines = unNl(old).split('\n');
+  const newLines = next === '' ? [] : unNl(next).split('\n');
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', (s) => s.trimEnd()],
+    ['indentation', (s) => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const want = oldLines.map(norm);
+    const starts: number[] = [];
+    for (let i = 0; i + want.length <= body.length; i++) {
+      if (want.every((w, j) => norm(body[i + j]) === w)) starts.push(i);
+    }
+    if (starts.length === 0) continue;
+    const what = tier === 'indentation' ? 'indentation' : 'trailing spaces';
+    if (starts.length > 1) {
+      return { error: `old_text matches ${starts.length} places (lines ${starts.map((i) => i + 1).join(', ')}) ignoring ${what}; add more context` };
+    }
+    const i = starts[0];
+    const k = want.length;
+    let repl = newLines;
+    if (tier === 'indentation') {
+      const oldIndent = indentOf(oldLines);
+      const fileIndent = indentOf(body.slice(i, i + k));
+      repl = newLines.map((l) =>
+        l.trim() === '' ? '' : fileIndent + (l.startsWith(oldIndent) ? l.slice(oldIndent.length) : l.trimStart()),
+      );
+    }
+    const lines = [...body.slice(0, i), ...repl, ...body.slice(i + k)];
+    const out = lines.length > 0 ? lines.join('\n') + (hasNl ? '\n' : '') : '';
+    return { content: out, applied: { from: i + 1, to: i + k, tier, count: 1 } };
+  }
+
+  const first = oldLines.find((l) => l.trim() !== '')?.trim();
+  const hits = first ? body.flatMap((l, i) => (l.includes(first) ? [i + 1] : [])).slice(0, 5) : [];
+  return { error: 'old_text not found' + (hits.length > 0 ? `; first line appears at line ${hits.join(', ')}` : '') };
 }
