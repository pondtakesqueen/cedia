diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-30 00:43:15.939497311 +0000
@@ -0,0 +1,111 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+
+// Small deterministic generator so the randomised check is repeatable.
+const rng = (seed: number) => () => {
+  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+  return seed / 0x7fffffff;
+};
+
+describe('replace_all agrees with split/join', () => {
+  test('about 200 generated inputs', () => {
+    const next = rng(42);
+    const alphabet = ['a', 'b', '\n', ' '];
+    const gen = (len: number) => Array.from({ length: len }, () => alphabet[Math.floor(next() * alphabet.length)]).join('');
+    let checked = 0;
+    for (let n = 0; n < 5000 && checked < 200; n++) {
+      const content = gen(1 + Math.floor(next() * 12));
+      const old = gen(1 + Math.floor(next() * 4));
+      const repl = gen(Math.floor(next() * 3)) + '$&';
+      if (old === repl || !content.includes(old)) continue;
+      checked++;
+      const r = ok(applyEdit(content, { old_text: old, new_text: repl, replace_all: true }));
+      expect(r.content).toBe(content.split(old).join(repl));
+      expect(r.applied.count).toBe(content.split(old).length - 1);
+    }
+    expect(checked).toBe(200);
+  });
+});
+
+describe('tier rules', () => {
+  test('replace_all does not widen to fuzzy tiers', () => {
+    const r = ok(applyEdit('a  \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }));
+    expect(r.applied).toEqual({ from: 1, to: 2, tier: 'trailing-space', count: 1 });
+    expect(r.content).toBe('c\n');
+  });
+  test('indentation: two windows differing only in indent is an error', () => {
+    const r = applyEdit('  x\n  y\n    x\n    y\n', { old_text: 'x\ny', new_text: 'z' });
+    expect('error' in r && r.error).toContain('matches 2 places (indentation)');
+    expect('error' in r && r.error).toContain('1, 3');
+  });
+  test('empty new_text deletes in trailing-space tier', () => {
+    const r = ok(applyEdit('a  \nb\nc\n', { old_text: 'a\nb', new_text: '' }));
+    expect(r.content).toBe('c\n');
+  });
+  test('a blank new_text line is kept, not a deletion', () => {
+    const r = ok(applyEdit('a  \nb\n', { old_text: 'a\nb', new_text: '\n' }));
+    expect(r.content).toBe('\n');
+  });
+  test('no trailing newline is added when the file has none', () => {
+    const r = ok(applyEdit('a\nb', { old_text: 'b ', new_text: 'c' }));
+    expect(r.content).toBe('a\nc');
+  });
+});
+
+describe('not-found pointer', () => {
+  test('lists at most five line numbers', () => {
+    const r = applyEdit('x\nx\nx\nx\nx\nx\nx\n', { old_text: 'x\ny', new_text: '' });
+    expect('error' in r && r.error).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect('error' in r && r.error).not.toContain('6');
+  });
+  test('whitespace-only old_text gives no pointer', () => {
+    const r = applyEdit('a\n  \nb\n', { old_text: '   \nzz', new_text: 'x' });
+    expect('error' in r && r.error).toContain('not found');
+    expect('error' in r && r.error).not.toContain('appears');
+  });
+});
+
+describe('indentation re-indent', () => {
+  test('re-indents new_text lines to the file', () => {
+    const r = ok(applyEdit('    a\n    b\n', { old_text: '  a\n  b', new_text: '  a2\n  b2' }));
+    expect(r.applied).toEqual({ from: 1, to: 2, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('    a2\n    b2\n');
+  });
+  test('new_text lines with different indents keep their relative indent', () => {
+    const r = ok(applyEdit('    a\n    b\n', { old_text: '  a\n  b', new_text: '  a\n    c\n  b' }));
+    expect(r.content).toBe('    a\n      c\n    b\n');
+  });
+  test('new_text line indented less than old_text first line is re-indented', () => {
+    const r = ok(applyEdit('    a\n    b\n', { old_text: '  a\n  b', new_text: 'x\n y' }));
+    expect(r.content).toBe('    x\n    y\n');
+  });
+  test('empty new_text deletes in indentation tier', () => {
+    const r = ok(applyEdit('    a\n    b\n    c\n', { old_text: '  a\n  b', new_text: '' }));
+    expect(r.content).toBe('    c\n');
+  });
+});
+
+describe('exact tier lines', () => {
+  test('multi-match error gives the first line of a multi-line old_text', () => {
+    const r = applyEdit('z\na\nb\nz\na\nb\n', { old_text: 'a\nb', new_text: 'Q' });
+    expect('error' in r && r.error).toContain('matches 2 places');
+    expect('error' in r && r.error).toContain('line 2');
+  });
+  test('trailing newline on old_text is not counted as a line', () => {
+    const r = ok(applyEdit('q\na\nb\nc\n', { old_text: 'a\nb\n', new_text: 'Y\n' }));
+    expect(r.applied).toEqual({ from: 2, to: 3, tier: 'exact', count: 1 });
+    expect(r.content).toBe('q\nY\nc\n');
+  });
+});
+
+describe('CRLF files', () => {
+  test('fuzzy tier keeps CRLF line endings', () => {
+    const r = ok(applyEdit('a\r\nb\r\n', { old_text: 'a\nb', new_text: 'x\ny' }));
+    expect(r.content).toBe('x\r\ny\r\n');
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-30 00:40:42.861655576 +0000
+++ b/edit.ts	2026-10-30 00:43:21.285342847 +0000
@@ -23,5 +23,71 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: next, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to replace the whole file' };
+  if (old === next) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  const strip1 = (s: string) => (s.endsWith('\n') ? s.slice(0, -1) : s);
+  const lead = (s: string) => s.match(/^\s*/)![0];
+  const firstNonBlank = (ls: string[]) => ls.find(l => l.trim() !== '') ?? '';
+
+  const eol = content.endsWith('\n');
+  const lines = (eol ? content.slice(0, -1) : content).split('\n');
+  const save = (ls: string[]) => ls.join('\n') + (eol ? '\n' : '');
+
+  const hits: number[] = [];
+  for (let i = content.indexOf(old); i !== -1; i = content.indexOf(old, i + old.length)) hits.push(i);
+  if (hits.length > 0) {
+    const lineOf = (i: number) => content.slice(0, i).split('\n').length;
+    const from = lineOf(hits[0]);
+    const to = lineOf(hits[hits.length - 1]) + strip1(old).split('\n').length - 1;
+    if (hits.length > 1 && !replace_all) {
+      return { error: `old_text matches ${hits.length} places; first at line ${from}. Add context or set replace_all.` };
+    }
+    const out = replace_all
+      ? content.split(old).join(next)
+      : content.slice(0, hits[0]) + next + content.slice(hits[0] + old.length);
+    return { content: out, applied: { from, to, tier: 'exact', count: hits.length } };
+  }
+
+  const oldLines = strip1(old).split('\n');
+  const newLines = next === '' ? [] : strip1(next).split('\n');
+  if (strip1(old) !== '') {
+    const fuzzy: [Tier, (s: string) => string][] = [
+      ['trailing-space', s => s.trimEnd()],
+      ['indentation', s => s.trim()],
+    ];
+    for (const [tier, norm] of fuzzy) {
+      const want = oldLines.map(norm);
+      const starts: number[] = [];
+      for (let i = 0; i + want.length <= lines.length; i++) {
+        if (want.every((w, k) => norm(lines[i + k]) === w)) starts.push(i);
+      }
+      if (starts.length === 0) continue;
+      if (starts.length > 1) {
+        return { error: `old_text matches ${starts.length} places (${tier}) at lines ${starts.map(i => i + 1).join(', ')}` };
+      }
+      const i = starts[0];
+      // A window line ending in \r (CRLF file) keeps that ending on the replacement lines.
+      const cr = lines[i + oldLines.length - 1].endsWith('\r') ? '\r' : '';
+      let repl = newLines;
+      if (tier === 'indentation') {
+        const oldIndent = lead(firstNonBlank(oldLines));
+        const fileIndent = lead(firstNonBlank(lines.slice(i, i + oldLines.length)));
+        repl = newLines.map(l =>
+          l.trim() === '' ? '' : l.startsWith(oldIndent) ? fileIndent + l.slice(oldIndent.length) : fileIndent + l.trimStart(),
+        );
+      }
+      return {
+        content: save([...lines.slice(0, i), ...repl.map(l => l + cr), ...lines.slice(i + oldLines.length)]),
+        applied: { from: i + 1, to: i + oldLines.length, tier, count: 1 },
+      };
+    }
+  }
+
+  const firstLine = firstNonBlank(oldLines).trim();
+  const appears = firstLine === '' ? [] : lines.flatMap((l, i) => (l.includes(firstLine) ? [i + 1] : []));
+  return {
+    error: `old_text not found` + (appears.length > 0 ? `; first line appears at line ${appears.slice(0, 5).join(', ')}` : ''),
+  };
 }
