diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.contract.test.ts b/pool.contract.test.ts
--- a/pool.contract.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.contract.test.ts	2026-10-30 00:52:07.997374156 +0000
@@ -0,0 +1,217 @@
+import { expect, test } from "bun:test";
+import { runPool, type Settled } from "./pool";
+
+const flush = () => new Promise<void>((r) => setImmediate(r));
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+}
+
+function prng(seed: number) {
+  return () => {
+    seed = (seed + 0x6d2b79f5) | 0;
+    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
+    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+test("rule 1: a limit that is not a whole number of 1 or more is refused before any task starts", async () => {
+  for (const limit of [0, -1, 1.5, NaN]) {
+    let calls = 0;
+    await expect(runPool([() => (calls++, 1)], limit)).rejects.toBeInstanceOf(RangeError);
+    expect(calls).toBe(0);
+  }
+}, { timeout: 1000 });
+
+test("rule 1: retries that are not a whole number of 0 or more are refused before any task starts", async () => {
+  for (const retries of [-1, 1.5, NaN]) {
+    let calls = 0;
+    await expect(runPool([() => (calls++, 1)], 1, { retries })).rejects.toBeInstanceOf(RangeError);
+    expect(calls).toBe(0);
+  }
+}, { timeout: 1000 });
+
+test("rule 1: a limit of Infinity is allowed and starts every task", async () => {
+  const out = await runPool([() => 1, () => 2, () => 3], Infinity);
+  expect(out.map((r) => r.status)).toEqual(["fulfilled", "fulfilled", "fulfilled"]);
+}, { timeout: 1000 });
+
+test("rule 2: never more than limit in flight, and one more starts each time one settles", async () => {
+  const defs = Array.from({ length: 10 }, () => deferred<number>());
+  const started: number[] = [];
+  let inFlight = 0;
+  let peak = 0;
+  const tasks = defs.map((d, i) => () => {
+    started.push(i);
+    inFlight++;
+    peak = Math.max(peak, inFlight);
+    const p = d.promise;
+    p.then(() => inFlight--, () => inFlight--);
+    return p;
+  });
+  const done = runPool(tasks, 3);
+  await flush();
+  expect(started).toEqual([0, 1, 2]);
+  for (let i = 0; i < 10; i++) {
+    defs[i].resolve(i);
+    await flush();
+    expect(started.length).toBe(Math.min(10, i + 4));
+  }
+  await done;
+  expect(peak).toBe(3);
+}, { timeout: 1000 });
+
+test("order: results follow input order even when tasks finish in reverse", async () => {
+  const defs = [0, 1, 2].map(() => deferred<number>());
+  const p = runPool(defs.map((d) => () => d.promise), 3);
+  defs[2].resolve(2);
+  defs[1].resolve(1);
+  defs[0].resolve(0);
+  const out = await p;
+  expect(out.map((r) => (r.status === "fulfilled" ? r.value : null))).toEqual([0, 1, 2]);
+}, { timeout: 1000 });
+
+test("rule 3: a sync throw is a rejection and a plain value is a fulfilment", async () => {
+  const boom = new Error("boom");
+  const out = await runPool([() => { throw boom; }, () => 7], 1);
+  expect(out[0]).toEqual({ status: "rejected", reason: boom, attempts: 1 });
+  expect(out[1]).toEqual({ status: "fulfilled", value: 7, attempts: 1 });
+}, { timeout: 1000 });
+
+test("rule 4: a failing task is retried in its slot up to retries more times, and attempts counts every call", async () => {
+  for (let k = 0; k <= 3; k++) {
+    for (let r = 0; r <= 3; r++) {
+      let calls = 0;
+      const task = () => (++calls <= k ? Promise.reject(new Error(`fail ${calls}`)) : Promise.resolve(calls));
+      const [res] = await runPool([task], 1, { retries: r });
+      if (k <= r) expect(res).toEqual({ status: "fulfilled", value: k + 1, attempts: k + 1 });
+      else expect(res).toMatchObject({ status: "rejected", attempts: r + 1 });
+      expect(calls).toBe(Math.min(k, r) + 1);
+    }
+  }
+}, { timeout: 1000 });
+
+test("rule 4: a retry runs before the next task starts, in the same slot", async () => {
+  const log: string[] = [];
+  let a = 0;
+  const tasks = [
+    () => {
+      log.push("a");
+      return ++a === 1 ? Promise.reject(new Error("x")) : Promise.resolve("a");
+    },
+    () => {
+      log.push("b");
+      return Promise.resolve("b");
+    },
+  ];
+  await runPool(tasks, 1, { retries: 1 });
+  expect(log).toEqual(["a", "a", "b"]);
+}, { timeout: 1000 });
+
+test("rule 5: an abort starts nothing new, keeps in-flight results, and cancels the tasks not started", async () => {
+  const ac = new AbortController();
+  const defs = Array.from({ length: 5 }, () => deferred<number>());
+  const called: number[] = [];
+  const tasks = defs.map((d, i) => () => {
+    called.push(i);
+    return d.promise;
+  });
+  const p = runPool(tasks, 2, { signal: ac.signal });
+  await flush();
+  expect(called).toEqual([0, 1]);
+  ac.abort("stop");
+  defs[0].resolve(10);
+  defs[1].resolve(11);
+  const out = await p;
+  expect(called).toEqual([0, 1]);
+  expect(out[0]).toEqual({ status: "fulfilled", value: 10, attempts: 1 });
+  expect(out[1]).toEqual({ status: "fulfilled", value: 11, attempts: 1 });
+  for (const i of [2, 3, 4]) expect(out[i]).toEqual({ status: "rejected", reason: "stop", attempts: 0 });
+}, { timeout: 1000 });
+
+test("rule 5: a retry cancelled by the abort settles with signal.reason and the attempts made", async () => {
+  const ac = new AbortController();
+  const d = deferred<number>();
+  let calls = 0;
+  const p = runPool([() => (calls++, d.promise)], 1, { retries: 2, signal: ac.signal });
+  await flush();
+  ac.abort("stop");
+  d.reject(new Error("fail"));
+  const [res] = await p;
+  expect(res).toEqual({ status: "rejected", reason: "stop", attempts: 1 });
+  expect(calls).toBe(1);
+}, { timeout: 1000 });
+
+test("rule 5: a signal already aborted at the call starts no task", async () => {
+  const ac = new AbortController();
+  ac.abort("early");
+  let calls = 0;
+  const out = await runPool([() => (calls++, 1), () => (calls++, 2)], 2, { signal: ac.signal });
+  expect(calls).toBe(0);
+  expect(out).toEqual([
+    { status: "rejected", reason: "early", attempts: 0 },
+    { status: "rejected", reason: "early", attempts: 0 },
+  ]);
+}, { timeout: 1000 });
+
+test("rule 6: over random sizes, limits, retries and settle orders, results match a sequential run", async () => {
+  const rand = prng(42);
+  const int = (lo: number, hi: number) => lo + Math.floor(rand() * (hi - lo + 1));
+  const summary = (r: Settled<string>) =>
+    r.status === "fulfilled" ? [r.status, r.value, r.attempts] : [r.status, (r.reason as Error).message, r.attempts];
+
+  for (let run = 0; run < 200; run++) {
+    const n = int(0, 12);
+    const limit = int(1, 4);
+    const retries = int(0, 2);
+    const fails = Array.from({ length: n }, () => int(0, 3));
+    const delays = Array.from({ length: n }, () => Array.from({ length: 5 }, () => int(0, 4)));
+
+    const make = () => {
+      const calls = new Array<number>(n).fill(0);
+      let inFlight = 0;
+      let peak = 0;
+      const tasks = Array.from({ length: n }, (_, i) => () => {
+        const k = ++calls[i];
+        inFlight++;
+        peak = Math.max(peak, inFlight);
+        const p = (async () => {
+          for (let j = 0; j < delays[i][k - 1]; j++) await null;
+          if (k <= fails[i]) throw new Error(`${i}:${k}`);
+          return `${i}:${k}`;
+        })();
+        p.then(() => inFlight--, () => inFlight--);
+        return p;
+      });
+      return { tasks, peak: () => peak };
+    };
+
+    const expected: Settled<string>[] = [];
+    const ref = make();
+    for (let i = 0; i < n; i++) {
+      for (let attempts = 1; ; attempts++) {
+        try {
+          expected.push({ status: "fulfilled", value: await ref.tasks[i](), attempts });
+          break;
+        } catch (reason) {
+          if (attempts > retries) {
+            expected.push({ status: "rejected", reason, attempts });
+            break;
+          }
+        }
+      }
+    }
+
+    const real = make();
+    const out = await runPool(real.tasks, limit, { retries });
+    expect(out.map(summary)).toEqual(expected.map(summary));
+    expect(real.peak()).toBeLessThanOrEqual(limit);
+  }
+}, { timeout: 5000 });
