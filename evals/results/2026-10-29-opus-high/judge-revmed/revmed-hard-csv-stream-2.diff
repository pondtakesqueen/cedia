+
+/**
+ * Reads CSV the way `parseCsv` does, from chunks that arrive over time. `push` returns the rows whose row end has
+ * arrived, and `end` returns the rest; together they equal `parseCsv` of the whole input. It keeps only the row and
+ * the field being read, plus a `\r` that waits for the next character. A SyntaxError is thrown at the offset
+ * `parseCsv` reports, and every later call throws it again.
+ */
+export class CsvStream {
+  private pos = 0; // offset in the whole input of the character being read
+  private state: "start" | "unquoted" | "quoted" | "quoteSeen" | "closed" = "start";
+  private field = "";
+  private row: string[] = [];
+  private pendingCR = false;
+  private rows: string[][] = [];
+  private failure?: SyntaxError;
+  private ended = false;
+
+  push(chunk: string): string[][] {
+    this.check();
+    this.rows = [];
+    try {
+      for (let k = 0; k < chunk.length; k++) {
+        this.feed(chunk[k]!);
+        this.pos++;
+      }
+    } catch (e) {
+      this.failure = e as SyntaxError;
+      throw e;
+    }
+    return this.rows;
+  }
+
+  end(): string[][] {
+    this.check();
+    this.ended = true;
+    this.rows = [];
+    try {
+      if (this.pendingCR) {
+        this.pendingCR = false;
+        this.literalCR();
+      }
+      if (this.state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+      if (this.state !== "start" || this.row.length > 0) this.endRow();
+    } catch (e) {
+      this.failure = e as SyntaxError;
+      throw e;
+    }
+    return this.rows;
+  }
+
+  private check(): void {
+    if (this.failure) throw this.failure;
+    if (this.ended) throw new Error("CsvStream has ended");
+  }
+
+  private feed(c: string): void {
+    if (this.pos === 0 && c === "\uFEFF") return;
+    if (this.pendingCR) {
+      this.pendingCR = false;
+      if (c === "\n") return this.endRow();
+      this.literalCR();
+    }
+    if (this.state === "quoted") {
+      if (c === '"') this.state = "quoteSeen";
+      else this.field += c;
+      return;
+    }
+    if (this.state === "quoteSeen") {
+      if (c === '"') {
+        this.field += c;
+        this.state = "quoted";
+        return;
+      }
+      this.state = "closed";
+    }
+    if (this.state === "start" && c === '"') {
+      this.state = "quoted";
+      return;
+    }
+    if (c === ",") return this.endField();
+    if (c === "\n") return this.endRow();
+    if (c === "\r") {
+      this.pendingCR = true;
+      return;
+    }
+    if (this.state === "closed") throw this.unexpected(c, this.pos);
+    if (c === '"') throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.pos}`);
+    this.field += c;
+    this.state = "unquoted";
+  }
+
+  // A `\r` that is not followed by `\n` is text, unless it closes a quoted field.
+  private literalCR(): void {
+    if (this.state === "closed") throw this.unexpected("\r", this.pos - 1);
+    this.field += "\r";
+    this.state = "unquoted";
+  }
+
+  private unexpected(c: string, at: number): SyntaxError {
+    return new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${at}`);
+  }
+
+  private endField(): void {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "start";
+  }
+
+  private endRow(): void {
+    this.endField();
+    this.rows.push(this.row);
+    this.row = [];
+  }
+}
