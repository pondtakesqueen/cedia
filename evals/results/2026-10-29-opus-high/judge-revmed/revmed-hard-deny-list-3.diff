diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.extra.test.ts b/deny.extra.test.ts
--- a/deny.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.extra.test.ts	2026-10-30 00:40:06.885331291 +0000
@@ -0,0 +1,50 @@
+import { expect, test } from 'bun:test';
+import { denyListed } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string, dir = cwd) => denyListed(line.split(' '), dir)?.name;
+
+test('git subcommand after a value-taking option is not push', () => {
+  expect(hit('git -C push status')).toBeUndefined();
+});
+
+test('combined short flags for push and rm', () => {
+  expect(hit('git push -df origin x')).toBe('force-push');
+  expect(hit('rm -rf ..x')).toBeUndefined();
+  expect(hit('rm -rf ../x')).toBe('rm-outside');
+});
+
+test('empty and bare commands', () => {
+  expect(hit('git')).toBeUndefined();
+  expect(hit('rm')).toBeUndefined();
+  expect(hit('find')).toBeUndefined();
+});
+
+// Independent restatement of the path rule: normalise the path against cwd and compare path segments.
+function segments(p: string, dir: string): string[] {
+  const home = process.env.HOME ?? '';
+  const abs = p === '~' || p.startsWith('~/') ? home + p.slice(1) : p;
+  const full = abs.startsWith('/') ? abs : dir + '/' + abs;
+  return full.split('/').reduce<string[]>((acc, s) => {
+    if (s === '..') acc.pop();
+    else if (s !== '' && s !== '.') acc.push(s);
+    return acc;
+  }, []);
+}
+
+test('rm and find decisions agree with the path rule for many paths and working directories', () => {
+  const paths = ['.', './', '..', '/', '/work/repo', '/work/repo/src', '/work/repo/../x', '/work/other', 'src', './*', '*', '../a', '~', '~/x', '~bob/x', '$DIR', 'a$b', '/work/repo2', '/work/repo/', 'build/out', '..x', './-x'];
+  for (const dir of ['/work/repo', '/', '/work/repo/src']) {
+    const root = segments(dir, '/');
+    for (const p of paths) {
+      const target = segments(p, dir);
+      const unresolvable = p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+      const inside = target.length >= root.length && root.every((s, i) => target[i] === s);
+      const same = target.length === root.length && inside;
+      const rmDenied = unresolvable || !inside || same;
+      const findDenied = unresolvable || !inside;
+      expect([dir, p, denyListed(['rm', '-r', p], dir)?.name === 'rm-outside']).toEqual([dir, p, rmDenied]);
+      expect([dir, p, denyListed(['find', p, '-delete'], dir)?.name === 'rm-outside']).toEqual([dir, p, findDenied]);
+    }
+  }
+});
