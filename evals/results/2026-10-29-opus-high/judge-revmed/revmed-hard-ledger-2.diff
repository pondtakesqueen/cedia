 export function verified(entries: LedgerEntry[], checks: string[]): boolean {
-  throw new Error('not implemented');
+  if (checks.length === 0) return true;
+  let lastWrite = -1;
+  let lastPass = -1;
+  entries.forEach((e, i) => {
+    if (e.kind === 'write') lastWrite = i;
+    else if (e.exitCode === 0) lastPass = i;
+  });
+  return lastWrite === -1 || lastPass > lastWrite;
