 // - Otherwise a bash call whose command is not read-only is a write entry with command set (no path).
 export function ledgerEntries(events: SessionEvent[], checks: string[], cwd?: string): LedgerEntry[] {
-  throw new Error('not implemented');
+  const snapshots = new Map<string, string[]>();
+  for (const e of events) {
+    if (e.kind === 'snapshot' && e.callId !== undefined) snapshots.set(e.callId, [...(snapshots.get(e.callId) ?? []), ...e.changed]);
+  }
+  const entries: LedgerEntry[] = [];
+  const open = new Map<string, Extract<SessionEvent, { kind: 'tool_intent' }>>();
+  events.forEach((e, at) => {
+    if (e.kind === 'request') return open.clear();
+    if (e.kind === 'tool_intent') return void open.set(e.callId, e);
+    if (e.kind !== 'tool_result') return;
+    const intent = open.get(e.callId);
+    open.delete(e.callId);
+    if (!intent || e.status === 'denied' || e.status === 'not_started') return;
+    const { tool, input } = intent;
+    const command = tool === 'bash' && typeof input.command === 'string' ? input.command : undefined;
+    const check = command === undefined ? undefined : matchCheck(command, checks, cwd);
+    if (check !== undefined) {
+      entries.push({ kind: 'check', at, command: check, exitCode: e.output.exitCode ?? (e.output.isError ? 1 : 0) });
+      return;
+    }
+    const changed = snapshots.get(e.callId);
+    if (changed !== undefined) {
+      for (const path of changed) entries.push({ kind: 'write', at, tool, path });
+      return;
+    }
+    if ((tool === 'edit' || tool === 'write') && e.status === 'completed' && typeof input.path === 'string') {
+      entries.push({ kind: 'write', at, tool, path: input.path });
