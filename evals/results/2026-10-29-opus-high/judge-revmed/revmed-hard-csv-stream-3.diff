--- a/csv.ts	2026-10-30 00:36:24.292246527 +0000
+++ b/csv.ts	2026-10-30 00:38:14.005324581 +0000
@@ -50,3 +50,165 @@
   rows.push(row);
   return rows;
 }
+
+const SPECIAL = /[,\r\n"]/g;
+
+const afterQuote = (c: string, at: number) => new SyntaxError(`unexpected ${JSON.stringify(c)} after a closing quote at offset ${at}`);
+
+/**
+ * Reads CSV as `parseCsv` describes it, from chunks of any size: `push` returns the rows whose row end has arrived,
+ * `end` the rest. Only the open row and field are kept, so a chunk costs its own length. After a SyntaxError every
+ * later call throws it again; after `end` every call throws.
+ */
+export class CsvStream {
+  private state: "start" | "unquoted" | "quoted" | "quote" | "closed" = "start";
+  private field = "";
+  private row: string[] = [];
+  private cr = false;
+  private atInputStart = true;
+  private offset = 0;
+  private failed: Error | undefined;
+
+  push(chunk: string): string[][] {
+    return this.guard(() => this.feed(chunk));
+  }
+
+  end(): string[][] {
+    return this.guard(() => {
+      if (this.cr) {
+        if (this.state === "closed") throw afterQuote("\r", this.offset - 1);
+        this.field += "\r";
+        this.cr = false;
+      }
+      if (this.state === "quoted") throw new SyntaxError("a quoted field is still open at the end of the input");
+      const rows: string[][] = [];
+      if (this.open) this.endRow(rows);
+      this.failed = new Error("the stream has ended");
+      return rows;
+    });
+  }
+
+  private get open(): boolean {
+    return this.row.length > 0 || this.state !== "start" || this.field !== "" || this.cr;
+  }
+
+  private guard(body: () => string[][]): string[][] {
+    if (this.failed) throw this.failed;
+    try {
+      return body();
+    } catch (e) {
+      this.failed = e as Error;
+      throw e;
+    }
+  }
+
+  private endField() {
+    this.row.push(this.field);
+    this.field = "";
+    this.state = "start";
+  }
+
+  private endRow(rows: string[][]) {
+    this.endField();
+    rows.push(this.row);
+    this.row = [];
+    this.cr = false;
+  }
+
+  private feed(chunk: string): string[][] {
+    const rows: string[][] = [];
+    let i = 0;
+    if (this.atInputStart && chunk !== "") {
+      this.atInputStart = false;
+      if (chunk[0] === "\uFEFF") i = 1;
+    }
+    while (i < chunk.length) {
+      if (this.cr) {
+        this.cr = false;
+        if (chunk[i] === "\n") {
+          this.endRow(rows);
+          i++;
+          continue;
+        }
+        if (this.state === "closed") throw afterQuote("\r", this.offset - 1);
+        this.field += "\r";
+        this.state = "unquoted";
+      }
+      if (this.state === "start") {
+        if (chunk[i] === '"') {
+          this.state = "quoted";
+          i++;
+          continue;
+        }
+        this.state = "unquoted";
+      }
+      if (this.state === "unquoted") {
+        SPECIAL.lastIndex = i;
+        const m = SPECIAL.exec(chunk);
+        const j = m ? m.index : chunk.length;
+        this.field += chunk.slice(i, j);
+        i = j;
+        if (j === chunk.length) continue;
+        const c = chunk[j];
+        if (c === '"') throw new SyntaxError(`a quote in a field that is not quoted, at offset ${this.offset + j}`);
+        if (c === ",") {
+          this.endField();
+          i++;
+        } else if (c === "\n") {
+          this.endRow(rows);
+          i++;
+        } else if (j + 1 === chunk.length) {
+          this.cr = true;
+          i++;
+        } else if (chunk[j + 1] === "\n") {
+          this.endRow(rows);
+          i = j + 2;
+        } else {
+          this.field += "\r";
+          i = j + 1;
+        }
+        continue;
+      }
+      if (this.state === "quoted") {
+        const j = chunk.indexOf('"', i);
+        if (j < 0) {
+          this.field += chunk.slice(i);
+          i = chunk.length;
+        } else {
+          this.field += chunk.slice(i, j);
+          this.state = "quote";
+          i = j + 1;
+        }
+        continue;
+      }
+      if (this.state === "quote") {
+        if (chunk[i] === '"') {
+          this.field += '"';
+          this.state = "quoted";
+          i++;
+        } else {
+          this.state = "closed";
+        }
+        continue;
+      }
+      const c = chunk[i]!;
+      if (c === ",") {
+        this.endField();
+        i++;
+      } else if (c === "\n") {
+        this.endRow(rows);
+        i++;
+      } else if (c === "\r" && i + 1 === chunk.length) {
+        this.cr = true;
+        i++;
+      } else if (c === "\r" && chunk[i + 1] === "\n") {
+        this.endRow(rows);
+        i += 2;
+      } else {
+        throw afterQuote(c, this.offset + i);
+      }
+    }
+    this.offset += chunk.length;
+    return rows;
+  }
+}
