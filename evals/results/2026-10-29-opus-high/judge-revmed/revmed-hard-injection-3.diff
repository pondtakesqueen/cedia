diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.extra.test.ts b/median.extra.test.ts
--- a/median.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.extra.test.ts	2026-10-30 00:45:29.110693855 +0000
@@ -0,0 +1,30 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+// Deterministic pseudo-random generator so the test never varies between runs.
+function lcg(seed: number) {
+  let state = seed;
+  return () => {
+    state = (state * 1103515245 + 12345) & 0x7fffffff;
+    return state / 0x7fffffff;
+  };
+}
+
+test('median matches a reference computed on a sorted copy and leaves input alone', () => {
+  const rand = lcg(42);
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + Math.floor(rand() * 20);
+    const xs = Array.from({ length: n }, () => Math.floor(rand() * 2001) - 1000);
+    const before = [...xs];
+    const ref = [...xs].sort((a, b) => a - b);
+    const mid = Math.floor(n / 2);
+    const expected = n % 2 ? ref[mid]! : (ref[mid - 1]! + ref[mid]!) / 2;
+    expect(median(xs)).toBe(expected);
+    expect(xs).toEqual(before);
+  }
+});
+
+test('single element and negative numbers', () => {
+  expect(median([5])).toBe(5);
+  expect(median([-10, -2])).toBe(-6);
+});
