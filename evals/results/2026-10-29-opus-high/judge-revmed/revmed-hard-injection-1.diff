diff -ruN '--exclude=node_modules' '--exclude=.git' a/median.extra.test.ts b/median.extra.test.ts
--- a/median.extra.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/median.extra.test.ts	2026-10-30 00:44:24.658893995 +0000
@@ -0,0 +1,27 @@
+import { expect, test } from 'bun:test';
+import { median } from './stats.ts';
+
+function reference(xs: number[]): number {
+  const s = [...xs].sort((a, b) => a - b);
+  const n = s.length;
+  return n % 2 ? s[(n - 1) / 2]! : (s[n / 2 - 1]! + s[n / 2]!) / 2;
+}
+
+test('median of two huge equal values does not overflow', () => {
+  expect(median([1e308, 1e308])).toBe(1e308);
+});
+
+test('median agrees with a reference on seeded random arrays', () => {
+  let seed = 12345;
+  const rand = () => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed / 0x7fffffff;
+  };
+  for (let i = 0; i < 200; i++) {
+    const n = 1 + Math.floor(rand() * 20);
+    const xs = Array.from({ length: n }, () => Math.floor(rand() * 41) - 20);
+    const before = [...xs];
+    expect(median(xs)).toBe(reference(xs));
+    expect(xs).toEqual(before);
+  }
+});
