 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+// Milliseconds per unit, largest first.
+const UNITS: Record<string, number> = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1000, ms: 1 };
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const s = text.trim();
+  if (!/^(?:\d+(?:\.\d+)?(?:ms|d|h|m|s) *)+$/.test(s)) {
+    throw new Error(`invalid duration: ${JSON.stringify(text)}`);
+  }
+  let total = 0;
+  for (const [, n, unit] of s.matchAll(/(\d+(?:\.\d+)?)(ms|d|h|m|s)/g)) {
+    total += Number(n) * UNITS[unit];
+  }
+  return Math.round(total);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!(Number.isFinite(ms) && ms >= 0)) {
+    throw new Error(`invalid duration: ${ms}`);
+  }
+  let rest = Math.round(ms);
+  let out = '';
+  for (const [unit, size] of Object.entries(UNITS)) {
+    const n = Math.floor(rest / size);
+    if (n > 0) out += `${n}${unit}`;
+    rest -= n * size;
+  }
+  return out || '0s';
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
--- a/src/lru.ts	2026-10-30 01:02:04.345484203 +0000
+++ b/src/lru.ts	2026-10-30 01:03:20.364061921 +0000
@@ -14,30 +14,77 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
+// Entries live in a Map in recency order: the first one is the least recently used.
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  private readonly entries = new Map<K, Entry<V>>();
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
 
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return undefined;
+    if (!this.isLive(e)) {
+      this.remove(key, e, 'expired');
+      return undefined;
+    }
+    this.entries.delete(key);
+    this.entries.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.entries.delete(key);
+    this.entries.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.entries.size <= this.capacity) return;
+    for (const [k, e] of [...this.entries]) {
+      if (!this.isLive(e)) this.remove(k, e, 'expired');
+    }
+    while (this.entries.size > this.capacity) {
+      const [k, e] = this.entries.entries().next().value!;
+      this.remove(k, e, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.entries.get(key);
+    if (!e) return false;
+    if (!this.isLive(e)) {
+      this.remove(key, e, 'expired');
+      return false;
+    }
+    this.remove(key, e, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    return this.keys().length;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    const live: K[] = [];
+    for (const [k, e] of this.entries) {
+      if (this.isLive(e)) live.push(k);
+    }
+    return live.reverse();
+  }
+
+  private isLive(e: Entry<V>): boolean {
+    return this.now() < e.expires;
+  }
+
+  // Removes the entry first, then reports it.
+  private remove(key: K, e: Entry<V>, reason: EvictReason): void {
+    this.entries.delete(key);
+    this.onEvict?.(key, e.value, reason);
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-30 01:02:04.345518413 +0000
+++ b/src/slug.ts	2026-10-30 01:03:20.363814660 +0000
@@ -11,10 +11,26 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+// Letters that do not decompose under NFD, mapped to their usual spelling.
+const LETTERS: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  let s = text
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .replace(/[ßæœøłđ]/g, (c) => LETTERS[c])
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max !== undefined && s.length > max) {
+    const cut = s.lastIndexOf('-', max);
+    s = cut > 0 ? s.slice(0, cut) : s.slice(0, max);
+  }
+  return s;
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  let out = slug;
+  for (let n = 2; taken.has(out); n++) out = `${slug}-${n}`;
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 01:03:34.353414955 +0000
@@ -0,0 +1,59 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parses each unit', () => {
+  expect(parseDuration('2d')).toBe(172_800_000);
+  expect(parseDuration('3h')).toBe(10_800_000);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('7s')).toBe(7_000);
+  expect(parseDuration('250ms')).toBe(250);
+});
+
+test('parses several parts with or without spaces', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('1h30m')).toBe(5_400_000);
+  expect(parseDuration('1m 1ms')).toBe(60_001);
+});
+
+test('parses fractions and rounds to whole milliseconds', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('1.5ms')).toBe(2);
+  expect(parseDuration('0.4ms')).toBe(0);
+});
+
+test('ignores spaces around the whole text', () => {
+  expect(parseDuration('  90s ')).toBe(90_000);
+});
+
+test('rejects malformed text and names the input in the message', () => {
+  for (const bad of ['', '10', '5x', 'h', '-1s', '1 h', '1h,2m', '1e3s']) {
+    expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+  }
+});
+
+test('formats with the largest units first, zero parts left out', () => {
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+  expect(formatDuration(60_000)).toBe('1m');
+});
+
+test('formatting rounds to whole milliseconds', () => {
+  expect(formatDuration(1.5)).toBe('2ms');
+  expect(formatDuration(0.4)).toBe('0s');
+});
+
+test('formatting rejects negative and non-finite numbers', () => {
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(NaN)).toThrow();
+  expect(() => formatDuration(Infinity)).toThrow();
+});
+
+test('parse(format(ms)) gives ms back', () => {
+  const values = [];
+  for (let ms = 0; ms <= 20_000; ms += 7) values.push(ms);
+  values.push(86_400_000, 3_600_000 * 25, 5_400_000, 90_061_001, 2 ** 40 + 3);
+  for (const ms of values) {
+    expect(parseDuration(formatDuration(ms))).toBe(ms);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 01:03:39.749745068 +0000
@@ -0,0 +1,168 @@
+import { expect, test } from 'bun:test';
+import { EvictReason, LRU } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  const log: [string, number, EvictReason][] = [];
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return { cache, log, advance: (to: number) => (t = to) };
+}
+
+test('a get hit makes the entry most recently used', () => {
+  const { cache, log } = setup(2, 10_000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('an entry is live before t + ttl and expired at it', () => {
+  const { cache, log, advance } = setup(5, 1000);
+  cache.set('k', 7);
+  advance(999);
+  expect(cache.get('k')).toBe(7);
+  advance(1000);
+  expect(cache.get('k')).toBeUndefined();
+  expect(log).toEqual([['k', 7, 'expired']]);
+});
+
+test('set gives a fresh ttl', () => {
+  const { cache, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  advance(500);
+  cache.set('a', 2);
+  advance(1200);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('overwriting a key is not an eviction', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('a', 2);
+  expect(log).toEqual([]);
+  expect(cache.size).toBe(1);
+  expect(cache.get('a')).toBe(2);
+});
+
+test('expired entries are evicted before live ones', () => {
+  const { cache, log, advance } = setup(2, 1000);
+  cache.set('a', 1);
+  advance(600);
+  cache.set('b', 2);
+  advance(1000);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('the capacity count includes expired entries', () => {
+  const { cache, log, advance } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  advance(2000);
+  expect(log).toEqual([]);
+  cache.set('c', 3);
+  expect(log).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+  ]);
+});
+
+test('delete of a live entry returns true with reason delete', () => {
+  const { cache, log } = setup(5, 1000);
+  cache.set('a', 1);
+  expect(cache.delete('a')).toBe(true);
+  expect(log).toEqual([['a', 1, 'delete']]);
+  expect(cache.size).toBe(0);
+});
+
+test('delete of an expired entry returns false with reason expired', () => {
+  const { cache, log, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  advance(1000);
+  expect(cache.delete('a')).toBe(false);
+  expect(log).toEqual([['a', 1, 'expired']]);
+});
+
+test('delete of a missing key returns false and reports nothing', () => {
+  const { cache, log } = setup(5, 1000);
+  expect(cache.delete('nope')).toBe(false);
+  expect(log).toEqual([]);
+});
+
+test('size and keys leave out expired entries', () => {
+  const { cache, log, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  advance(1000);
+  expect(cache.size).toBe(0);
+  expect(cache.keys()).toEqual([]);
+  expect(log).toEqual([]);
+});
+
+test('matches a naive reference model on a seeded random sequence', () => {
+  let seed = 12345;
+  const rand = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  for (let capacity = 1; capacity <= 4; capacity++) {
+    const ttl = 50;
+    let t = 0;
+    const cache = new LRU<string, number>(capacity, ttl, () => t);
+    const log: [string, number, EvictReason][] = [];
+    cache.onEvict = (k, v, r) => log.push([k, v, r]);
+    // model: array of { k, v, expires }, oldest first
+    type Item = { k: string; v: number; expires: number };
+    let model: Item[] = [];
+    const modelLog: [string, number, EvictReason][] = [];
+    const mRemove = (e: Item, r: EvictReason) => {
+      model = model.filter((x) => x !== e);
+      modelLog.push([e.k, e.v, r]);
+    };
+    const live = () => model.filter((e) => t < e.expires).map((e) => e.k).reverse();
+    let counter = 0;
+    for (let op = 0; op < 2000; op++) {
+      const key = 'k' + rand(6);
+      const r = rand(10);
+      if (r < 4) {
+        counter++;
+        model = model.filter((e) => e.k !== key);
+        const e = { k: key, v: counter, expires: t + ttl };
+        model.push(e);
+        if (model.length > capacity) {
+          for (const x of [...model]) if (!(t < x.expires)) mRemove(x, 'expired');
+          while (model.length > capacity) mRemove(model[0], 'capacity');
+        }
+        cache.set(key, counter);
+      } else if (r < 8) {
+        const e = model.find((x) => x.k === key);
+        let want: number | undefined;
+        if (e && t < e.expires) {
+          model = model.filter((x) => x !== e);
+          model.push(e);
+          want = e.v;
+        } else if (e) {
+          mRemove(e, 'expired');
+        }
+        expect(cache.get(key)).toBe(want);
+      } else if (r < 9) {
+        const e = model.find((x) => x.k === key);
+        let want = false;
+        if (e) {
+          mRemove(e, t < e.expires ? 'delete' : 'expired');
+          want = t < e.expires;
+        }
+        expect(cache.delete(key)).toBe(want);
+      } else {
+        t += rand(40);
+      }
+      expect(log).toEqual(modelLog);
+      expect(cache.keys()).toEqual(live());
+      expect(cache.size).toBe(live().length);
+    }
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 01:03:39.749866975 +0000
@@ -0,0 +1,62 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('lower-cases', () => {
+  expect(slugify('ABC')).toBe('abc');
+});
+
+test('drops diacritics', () => {
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('Ünïcödé')).toBe('unicode');
+});
+
+test('maps special letters, lower and upper case', () => {
+  expect(slugify('ßæœøłđ')).toBe('ssaeoeold');
+  expect(slugify('ÆØŁ')).toBe('aeol');
+});
+
+test('collapses separator runs and trims them from the ends', () => {
+  expect(slugify('  --a__b!!c--  ')).toBe('a-b-c');
+  expect(slugify('!!!')).toBe('');
+});
+
+test('keeps digits', () => {
+  expect(slugify('Top 10')).toBe('top-10');
+});
+
+test('max cuts at the last dash that keeps the slug within max', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+});
+
+test('max cuts at max itself when there is no dash to cut at', () => {
+  expect(slugify('abcdefgh', 3)).toBe('abc');
+  expect(slugify('abcdef-gh', 3)).toBe('abc');
+});
+
+test('a slug within max is unchanged', () => {
+  expect(slugify('ab-cd', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd', 9)).toBe('ab-cd');
+});
+
+test('every max gives a prefix of the slug with no dangling dash', () => {
+  const title = 'The quick brown fox, jumps over the lazy dog 42 times!';
+  const full = slugify(title);
+  for (let max = 1; max <= 30; max++) {
+    const s = slugify(title, max);
+    expect(s.length).toBeLessThanOrEqual(max);
+    expect(s.startsWith('-') || s.endsWith('-')).toBe(false);
+    expect(full.startsWith(s)).toBe(true);
+    if (full.length <= max) expect(s).toBe(full);
+  }
+});
+
+test('uniqueSlug keeps a free slug', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['other']))).toBe('post');
+});
+
+test('uniqueSlug takes the first free number', () => {
+  expect(uniqueSlug('post', new Set(['post', 'post-2']))).toBe('post-3');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+});
