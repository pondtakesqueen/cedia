diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.rules.test.ts b/edit.rules.test.ts
--- a/edit.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/edit.rules.test.ts	2026-10-30 00:43:00.914294627 +0000
@@ -0,0 +1,97 @@
+import { describe, expect, test } from 'bun:test';
+import { applyEdit } from './edit.ts';
+
+const SRC = 'function f() {\n    if (a) {\n        return 1;  \n    }\n}\n';
+const ok = (r: ReturnType<typeof applyEdit>) => {
+  if ('error' in r) throw new Error(r.error);
+  return r;
+};
+const err = (r: ReturnType<typeof applyEdit>) => ('error' in r ? r.error : '');
+
+describe('guards', () => {
+  test('empty old_text says use write, even with empty new_text', () => {
+    expect(err(applyEdit(SRC, { old_text: '', new_text: '' }))).toContain('use write');
+  });
+  test('same text is an error even when it is not in the file', () => {
+    expect(err(applyEdit(SRC, { old_text: 'zzz', new_text: 'zzz' }))).toContain('same');
+    expect(err(applyEdit(SRC, { old_text: 'zzz', new_text: 'zzz' }))).not.toContain('not found');
+  });
+});
+
+describe('exact rules', () => {
+  test('single match: from and to span the match', () => {
+    const r = ok(applyEdit('a\nb\n', { old_text: 'a\n', new_text: 'A\n' }));
+    expect(r.applied).toEqual({ from: 1, to: 1, tier: 'exact', count: 1 });
+    expect(r.content).toBe('A\nb\n');
+  });
+  test('several matches report count and first line', () => {
+    const r = err(applyEdit('x\nfoo\nbar\nfoo\nzz\nfoo\n', { old_text: 'foo', new_text: 'q' }));
+    expect(r).toContain('matches 3 places');
+    expect(r).toContain('line 2');
+  });
+  test('replace_all with random inputs matches split/join', () => {
+    let seed = 1;
+    const rnd = (n: number) => {
+      seed = (Math.imul(seed, 1103515245) + 12345) >>> 0;
+      return seed % n;
+    };
+    const alphabet = 'ab\n ';
+    const gen = (len: number) => Array.from({ length: len }, () => alphabet[rnd(alphabet.length)]).join('');
+    for (let k = 0; k < 200; k++) {
+      const content = gen(1 + rnd(30));
+      const s = rnd(content.length);
+      const old = content.slice(s, s + 1 + rnd(3));
+      const next = gen(rnd(4));
+      if (old === next) continue;
+      const r = ok(applyEdit(content, { old_text: old, new_text: next, replace_all: true }));
+      expect(r.content).toBe(content.split(old).join(next));
+      expect(r.applied.count).toBe(content.split(old).length - 1);
+      expect(r.applied.tier).toBe('exact');
+    }
+  });
+  test('replace_all does not widen the line tiers', () => {
+    expect(err(applyEdit('a \nb\na \nb\n', { old_text: 'a\nb', new_text: 'c', replace_all: true }))).toContain('matches 2 places');
+  });
+});
+
+describe('line tiers', () => {
+  test('one trailing newline is ignored and new_text lines go in as given', () => {
+    const r = ok(applyEdit('x\t\ny\n', { old_text: 'x\ny\n', new_text: 'Z\n' }));
+    expect(r.applied.tier).toBe('trailing-space');
+    expect(r.content).toBe('Z\n');
+  });
+  test('trailing-space is tried before indentation', () => {
+    const r = ok(applyEdit(' a \n', { old_text: ' a\n', new_text: ' b\n' }));
+    expect(r.applied.tier).toBe('trailing-space');
+  });
+  test('deleting in tier 2 leaves no empty line', () => {
+    expect(ok(applyEdit('a  \nb\n', { old_text: 'a\n', new_text: '' })).content).toBe('b\n');
+  });
+  test('deleting every line leaves empty content', () => {
+    expect(ok(applyEdit('a  \n', { old_text: 'a\n', new_text: '' })).content).toBe('');
+  });
+  test('content without a trailing newline stays without one', () => {
+    expect(ok(applyEdit('a \nb', { old_text: 'b\n', new_text: 'c' })).content).toBe('a \nc');
+  });
+  test('indentation window starting with a blank line takes indent from its second line', () => {
+    const r = ok(applyEdit('f\n\n    x\n    y\n', { old_text: '\nx\ny', new_text: '\nz\nw' }));
+    expect(r.applied).toEqual({ from: 2, to: 4, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('f\n\n    z\n    w\n');
+  });
+  test('new lines without old indent take the file indent; others keep their offset from it', () => {
+    const r = ok(applyEdit('    a\n    b\n', { old_text: '  a\n  b', new_text: 'a\n  c' }));
+    expect(r.applied).toEqual({ from: 1, to: 2, tier: 'indentation', count: 1 });
+    expect(r.content).toBe('    a\n    c\n');
+  });
+  test('several tier 3 matches list their start lines', () => {
+    expect(err(applyEdit('\tx\ny\n\tx\n', { old_text: ' x', new_text: ' z' }))).toContain('matches 2 places (lines 1, 3)');
+  });
+});
+
+describe('not found', () => {
+  test('lists at most five lines where the first line appears', () => {
+    const r = err(applyEdit('  q\n'.repeat(7), { old_text: 'q\nzzz', new_text: 'x' }));
+    expect(r).toContain('first line appears at line 1, 2, 3, 4, 5');
+    expect(r).not.toContain('6');
+  });
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/edit.ts b/edit.ts
--- a/edit.ts	2026-10-30 00:40:36.621142086 +0000
+++ b/edit.ts	2026-10-30 00:42:01.634629513 +0000
@@ -23,5 +23,102 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: next, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (old === next) return { error: 'old_text and new_text are the same; nothing to change' };
+
+  const starts = occurrences(content, old);
+  if (starts.length > 0) {
+    const first = starts[0];
+    const last = starts[starts.length - 1];
+    if (replace_all) {
+      return {
+        content: content.split(old).join(next),
+        applied: { from: lineOf(content, first), to: lineOf(content, last + old.length - 1), tier: 'exact', count: starts.length },
+      };
+    }
+    if (starts.length > 1) {
+      return { error: `old_text matches ${starts.length} places (first at line ${lineOf(content, first)}); add context or set replace_all` };
+    }
+    return {
+      content: content.slice(0, first) + next + content.slice(first + old.length),
+      applied: { from: lineOf(content, first), to: lineOf(content, first + old.length - 1), tier: 'exact', count: 1 },
+    };
+  }
+
+  const hasTrailing = content.endsWith('\n');
+  const lines = (hasTrailing ? content.slice(0, -1) : content).split('\n');
+  const oldLines = toLines(old);
+  const newLines = toLines(next);
+  const tiers: [Tier, (s: string) => string][] = [
+    ['trailing-space', s => s.trimEnd()],
+    ['indentation', s => s.trim()],
+  ];
+  for (const [tier, norm] of tiers) {
+    const windows = findWindows(lines, oldLines, norm);
+    if (windows.length === 0) continue;
+    if (windows.length > 1) {
+      return { error: `old_text matches ${windows.length} places (lines ${windows.map(w => w + 1).join(', ')})` };
+    }
+    const start = windows[0];
+    const replacement = tier === 'indentation' ? reindent(lines, start, oldLines, newLines) : newLines;
+    const out = [...lines.slice(0, start), ...replacement, ...lines.slice(start + oldLines.length)];
+    const body = out.join('\n');
+    return {
+      content: hasTrailing && out.length > 0 ? body + '\n' : body,
+      applied: { from: start + 1, to: start + oldLines.length, tier, count: 1 },
+    };
+  }
+
+  const first = oldLines.find(l => l.trim() !== '')?.trim();
+  if (first) {
+    const hits = lines.flatMap((l, i) => (l.includes(first) ? [i + 1] : []));
+    if (hits.length > 0) {
+      return { error: `old_text not found; first line appears at line ${hits.slice(0, 5).join(', ')}` };
+    }
+  }
+  return { error: 'old_text not found' };
+}
+
+// Start offsets of every non-overlapping occurrence of `old` in `content`.
+function occurrences(content: string, old: string): number[] {
+  const starts: number[] = [];
+  let i = content.indexOf(old);
+  while (i !== -1) {
+    starts.push(i);
+    i = content.indexOf(old, i + old.length);
+  }
+  return starts;
+}
+
+// 1-based line number of the character at offset `i`.
+function lineOf(content: string, i: number): number {
+  return content.slice(0, i).split('\n').length;
+}
+
+// Drops one trailing '\n', then splits into lines; '' gives [].
+function toLines(s: string): string[] {
+  return s === '' ? [] : s.replace(/\n$/, '').split('\n');
+}
+
+// Start indices of windows where every line of `lines` equals the matching line of `oldLines` under `norm`.
+function findWindows(lines: string[], oldLines: string[], norm: (s: string) => string): number[] {
+  const starts: number[] = [];
+  if (oldLines.length === 0) return starts;
+  for (let s = 0; s + oldLines.length <= lines.length; s++) {
+    if (oldLines.every((l, j) => norm(lines[s + j]) === norm(l))) starts.push(s);
+  }
+  return starts;
+}
+
+// Swaps the indentation of old's first non-blank line for the window's, on every non-blank new line.
+function reindent(lines: string[], start: number, oldLines: string[], newLines: string[]): string[] {
+  const j = oldLines.findIndex(l => l.trim() !== '');
+  if (j < 0) return newLines;
+  const oldIndent = /^\s*/.exec(oldLines[j])![0];
+  const fileIndent = /^\s*/.exec(lines[start + j])![0];
+  return newLines.map(l => {
+    if (l.trim() === '') return l;
+    return l.startsWith(oldIndent) ? fileIndent + l.slice(oldIndent.length) : fileIndent + l.trimStart();
+  });
 }
