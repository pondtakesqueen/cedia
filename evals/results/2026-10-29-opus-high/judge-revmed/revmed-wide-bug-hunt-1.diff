diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-30 00:59:42.973401201 +0000
@@ -0,0 +1,117 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { PRODUCTS } from '../src/catalog/products.ts';
+import { totals } from '../src/order/total.ts';
+import { percentOf } from '../src/money/round.ts';
+import { REGIONS } from '../src/pricing/regions.ts';
+
+// Expected values worked by hand from the rules and the region table in README.md.
+// Prices: MUG 450, TEE 1500, CAP 1200, PEN 120, BAG 2200.
+describe('pricing rules', () => {
+  test('rule 1: a line subtotal is unit price times quantity', () => {
+    // 3 pens = 3 * 120 = 360
+    expect(totals(cart('US', [['PEN', 3]])).lines[0]).toMatchObject({ subtotal: 360, discount: 0, total: 360 });
+  });
+
+  test('rule 2: bulk tiers start exactly at 10 and 50 units', () => {
+    // 9 pens = 1080, no tier
+    expect(totals(cart('US', [['PEN', 9]])).lines[0]).toMatchObject({ subtotal: 1080, discount: 0 });
+    // 10 pens = 1200, 5% = 60
+    expect(totals(cart('US', [['PEN', 10]])).lines[0]).toMatchObject({ subtotal: 1200, discount: 60, total: 1140 });
+    // 49 pens = 5880, 5% = 294
+    expect(totals(cart('US', [['PEN', 49]])).lines[0]).toMatchObject({ subtotal: 5880, discount: 294 });
+    // 50 pens = 6000, 10% only (not 15%) = 600
+    expect(totals(cart('US', [['PEN', 50]])).lines[0]).toMatchObject({ subtotal: 6000, discount: 600, total: 5400 });
+  });
+
+  test('rule 2: lines of the same sku are merged before pricing, the input cart is not changed', () => {
+    // 6 + 4 = 10 pens, one line, 5% = 60
+    const c = cart('US', [['PEN', 6], ['PEN', 4]]);
+    const t = totals(c);
+    expect(t.lines).toHaveLength(1);
+    expect(t.lines[0]).toMatchObject({ quantity: 10, subtotal: 1200, discount: 60 });
+    expect(c.lines).toHaveLength(2);
+    expect(c.lines.map((l) => l.quantity)).toEqual([6, 4]);
+  });
+
+  test('rule 3: the coupon applies after the bulk discount', () => {
+    // 10 pens = 1200, bulk 60, subtotal 1140, SAVE10 = 10% of 1140 = 114, discounted 1026
+    // shipping 800 (1026 < 5000); tax 7% of 1826 = 127.82 -> 128; total 1026 + 800 + 128 = 1954
+    expect(totals(cart('US', [['PEN', 10]], 'SAVE10'))).toMatchObject({ subtotal: 1140, coupon: 114, shipping: 800, tax: 128, total: 1954 });
+  });
+
+  test('rule 3: FLAT5 takes 500 cents off but never below zero', () => {
+    // 1 pen = 120; FLAT5 gives 120, discounted 0; shipping 800; tax 7% of 800 = 56; total 856
+    expect(totals(cart('US', [['PEN', 1]], 'FLAT5'))).toMatchObject({ coupon: 120, shipping: 800, tax: 56, total: 856 });
+  });
+
+  test('rule 3: coupon codes are case-insensitive', () => {
+    expect(totals(cart('US', [['PEN', 10]], 'save10')).coupon).toBe(114);
+  });
+
+  test('rule 4: shipping is free when the discounted subtotal reaches the threshold', () => {
+    // 4 caps = 4800 < 5000 pays 800
+    expect(totals(cart('US', [['CAP', 4]])).shipping).toBe(800);
+    // 5 caps = 6000, SAVE10 -> 5400 >= 5000, free; tax 7% of 5400 = 378; total 5778
+    expect(totals(cart('US', [['CAP', 5]], 'SAVE10'))).toMatchObject({ shipping: 0, tax: 378, total: 5778 });
+    // 4 caps + 2 pens = 5040 >= 5000 before the coupon, but SAVE10 leaves 4536 < 5000, so shipping 800
+    // tax 7% of 5336 = 373.52 -> 374; total 4536 + 800 + 374 = 5710
+    expect(totals(cart('US', [['CAP', 4], ['PEN', 2]], 'SAVE10'))).toMatchObject({ subtotal: 5040, coupon: 504, shipping: 800, tax: 374, total: 5710 });
+    // 1 bag + 2 caps = 4600, FLAT5 -> 4100 < 5000, shipping 800; tax 7% of 4900 = 343; total 5243
+    expect(totals(cart('US', [['BAG', 1], ['CAP', 2]], 'FLAT5'))).toMatchObject({ shipping: 800, tax: 343, total: 5243 });
+  });
+
+  test('rule 4: UK threshold is 4000 exactly', () => {
+    // 1 cap + 1 bag + 5 pens = 1200 + 2200 + 600 = 4000 -> free; tax 20% of 4000 = 800; total 4800
+    expect(totals(cart('UK', [['CAP', 1], ['BAG', 1], ['PEN', 5]]))).toMatchObject({ subtotal: 4000, shipping: 0, tax: 800, total: 4800 });
+    // 3 caps = 3600 < 4000 -> shipping 700; tax 20% of 4300 = 860; total 3600 + 700 + 860 = 5160
+    expect(totals(cart('UK', [['CAP', 3]]))).toMatchObject({ shipping: 700, tax: 860, total: 5160 });
+  });
+
+  test('rule 5: tax is rounded half up to the cent', () => {
+    // 1 mug = 450, shipping 800; taxable 1250; 7% = 87.5 -> 88; total 450 + 800 + 88 = 1338
+    expect(totals(cart('US', [['MUG', 1]]))).toMatchObject({ shipping: 800, tax: 88, total: 1338 });
+  });
+
+  test('rule 6: the total is discounted subtotal + shipping + tax', () => {
+    const carts = [
+      cart('US', [['PEN', 10]], 'SAVE10'),
+      cart('EU', [['BAG', 3], ['TEE', 2]], 'FLAT5'),
+      cart('UK', [['CAP', 1], ['BAG', 1], ['PEN', 5]]),
+      cart('US', [['CAP', 4], ['PEN', 2]], 'SAVE10'),
+    ];
+    for (const c of carts) {
+      const t = totals(c);
+      expect(t.total).toBe(t.subtotal - t.coupon + t.shipping + t.tax);
+    }
+  });
+
+  test('the region table matches README.md', () => {
+    expect(REGIONS.US).toEqual({ code: 'US', taxRate: 0.07, shipping: 800, freeShippingFrom: 5000 });
+    expect(REGIONS.EU).toEqual({ code: 'EU', taxRate: 0.2, shipping: 900, freeShippingFrom: 6000 });
+    expect(REGIONS.UK).toEqual({ code: 'UK', taxRate: 0.2, shipping: 700, freeShippingFrom: 4000 });
+  });
+
+  test('percentOf rounds half up exactly, for every amount and the rates in use', () => {
+    for (const rate of [0.05, 0.07, 0.1, 0.2]) {
+      const pct = Math.round(rate * 100);
+      for (let amount = 0; amount <= 20000; amount++) {
+        expect(percentOf(amount, rate)).toBe(Math.floor((amount * pct + 50) / 100));
+      }
+    }
+  });
+
+  test('a sku split across lines prices the same as one line with the total quantity', () => {
+    for (const region of Object.keys(REGIONS)) {
+      for (const sku of Object.keys(PRODUCTS)) {
+        for (let q = 2; q <= 60; q++) {
+          for (let a = 1; a < q; a++) {
+            const split = totals(cart(region, [[sku, a], [sku, q - a]], 'SAVE10'));
+            const whole = totals(cart(region, [[sku, q]], 'SAVE10'));
+            expect({ ...split, lines: undefined }).toEqual({ ...whole, lines: undefined });
+          }
+        }
+      }
+    }
+  });
+});
