 //
 // formatDuration: milliseconds to the shortest text using d, h, m, s and ms, largest unit first, zero parts
 // left out, no spaces: 5_400_000 -> "1h30m", 1_500 -> "1s500ms", 0 -> "0s". Throws on a negative number.
+const UNIT_MS = { d: 86_400_000, h: 3_600_000, m: 60_000, s: 1000, ms: 1 } as const;
+type Unit = keyof typeof UNIT_MS;
+const WHOLE = /^(?:\d+(?:\.\d+)?(?:ms|d|h|m|s) *)+$/;
+const PART = /(\d+(?:\.\d+)?)(ms|d|h|m|s)/g;
+
 export function parseDuration(text: string): number {
-  throw new Error('not implemented');
+  const t = text.trim();
+  if (!WHOLE.test(t)) throw new Error(`invalid duration: "${text}"`);
+  let sum = 0;
+  for (const [, n, u] of t.matchAll(PART)) sum += Number(n) * UNIT_MS[u as Unit];
+  return Math.round(sum);
 }
 
 export function formatDuration(ms: number): string {
-  throw new Error('not implemented');
+  if (!Number.isFinite(ms) || ms < 0) throw new Error(`invalid duration: ${ms}`);
+  let rest = Math.round(ms);
+  if (rest === 0) return '0s';
+  let out = '';
+  for (const unit of Object.keys(UNIT_MS) as Unit[]) {
+    const q = Math.floor(rest / UNIT_MS[unit]);
+    if (q > 0) out += `${q}${unit}`;
+    rest -= q * UNIT_MS[unit];
+  }
+  return out;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/lru.ts b/src/lru.ts
--- a/src/lru.ts	2026-10-30 01:03:13.718515974 +0000
+++ b/src/lru.ts	2026-10-30 01:04:46.801419262 +0000
@@ -14,30 +14,71 @@
 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+// An entry set at time t has expires = t + ttlMs and is live while now() < expires.
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
+  private readonly map = new Map<K, Entry<V>>(); // least recently used first
+  private readonly capacity: number;
+  private readonly ttlMs: number;
+  private readonly now: () => number;
 
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.capacity = capacity;
+    this.ttlMs = ttlMs;
+    this.now = now;
+  }
+
+  private isLive(e: Entry<V>): boolean {
+    return this.now() < e.expires;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.map.get(key);
+    if (e === undefined) return undefined;
+    this.map.delete(key);
+    if (!this.isLive(e)) {
+      this.onEvict?.(key, e.value, 'expired');
+      return undefined;
+    }
+    this.map.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    this.map.delete(key);
+    this.map.set(key, { value, expires: this.now() + this.ttlMs });
+    if (this.map.size <= this.capacity) return;
+    const expired = [...this.map].filter(([, e]) => !this.isLive(e));
+    for (const [k, e] of expired) {
+      this.map.delete(k);
+      this.onEvict?.(k, e.value, 'expired');
+    }
+    while (this.map.size > this.capacity) {
+      const [k, e] = this.map.entries().next().value as [K, Entry<V>];
+      this.map.delete(k);
+      this.onEvict?.(k, e.value, 'capacity');
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.map.get(key);
+    if (e === undefined) return false;
+    this.map.delete(key);
+    if (!this.isLive(e)) {
+      this.onEvict?.(key, e.value, 'expired');
+      return false;
+    }
+    this.onEvict?.(key, e.value, 'delete');
+    return true;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    return [...this.map.values()].filter((e) => this.isLive(e)).length;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.map].filter(([, e]) => this.isLive(e)).map(([k]) => k).reverse();
   }
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/src/slug.ts b/src/slug.ts
--- a/src/slug.ts	2026-10-30 01:03:13.718556676 +0000
+++ b/src/slug.ts	2026-10-30 01:04:46.794926291 +0000
@@ -11,10 +11,26 @@
 //   keeps exactly max ("ab-cd-ef" with max 5 is "ab-cd").
 //
 // uniqueSlug(slug, taken): slug itself if it is not in taken, else slug-2, slug-3, ... the first free one.
+const SPECIAL: Record<string, string> = { ß: 'ss', æ: 'ae', œ: 'oe', ø: 'o', ł: 'l', đ: 'd' };
+
 export function slugify(text: string, max?: number): string {
-  throw new Error('not implemented');
+  const s = text
+    .toLowerCase()
+    .replace(/[ßæœøłđ]/g, (c) => SPECIAL[c])
+    .normalize('NFD')
+    .replace(/\p{M}+/gu, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+  if (max === undefined || s.length <= max) return s;
+  if (max <= 0) return '';
+  if (s[max] === '-') return s.slice(0, max);
+  const cut = s.lastIndexOf('-', max - 1);
+  return cut > 0 ? s.slice(0, cut) : s.slice(0, max);
 }
 
 export function uniqueSlug(slug: string, taken: Set<string>): string {
-  throw new Error('not implemented');
+  if (!taken.has(slug)) return slug;
+  let n = 2;
+  while (taken.has(`${slug}-${n}`)) n++;
+  return `${slug}-${n}`;
 }
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/duration.rules.test.ts b/test/duration.rules.test.ts
--- a/test/duration.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/duration.rules.test.ts	2026-10-30 01:05:41.523999969 +0000
@@ -0,0 +1,56 @@
+import { expect, test } from 'bun:test';
+import { formatDuration, parseDuration } from '../src/duration.ts';
+
+test('parse: parts with or without spaces, outer spaces ignored', () => {
+  expect(parseDuration('2d 4h')).toBe(187_200_000);
+  expect(parseDuration('2d4h')).toBe(187_200_000);
+  expect(parseDuration('  90s ')).toBe(90_000);
+});
+
+test('parse: each unit, and m vs ms', () => {
+  expect(parseDuration('1d')).toBe(86_400_000);
+  expect(parseDuration('1h')).toBe(3_600_000);
+  expect(parseDuration('1m')).toBe(60_000);
+  expect(parseDuration('1s')).toBe(1000);
+  expect(parseDuration('250ms')).toBe(250);
+  expect(parseDuration('1ms')).toBe(1);
+  expect(parseDuration('10m5ms')).toBe(600_005);
+});
+
+test('parse: fractions, rounded to whole ms', () => {
+  expect(parseDuration('1.5h')).toBe(5_400_000);
+  expect(parseDuration('1.0005s')).toBe(1001);
+  expect(parseDuration('0.4ms')).toBe(0);
+});
+
+test('parse: invalid input throws with the input quoted', () => {
+  for (const bad of ['', '10', '5x', 'h', '-1s', '1h-30m', '1.s', '   ', '1 h', '5"x', '1\\s', '1\ns']) {
+    expect(() => parseDuration(bad)).toThrow(`"${bad}"`);
+  }
+  expect(() => parseDuration('5"x')).toThrow('5"x');
+  expect(() => parseDuration('1\\s')).toThrow('1\\s');
+});
+
+test('format: largest unit first, zero parts left out', () => {
+  expect(formatDuration(5_400_000)).toBe('1h30m');
+  expect(formatDuration(1_500)).toBe('1s500ms');
+  expect(formatDuration(0)).toBe('0s');
+  expect(formatDuration(86_400_001)).toBe('1d1ms');
+  expect(formatDuration(90_061_001)).toBe('1d1h1m1s1ms');
+});
+
+test('format: rejects negative and non-finite numbers', () => {
+  expect(() => formatDuration(-1)).toThrow();
+  expect(() => formatDuration(NaN)).toThrow();
+  expect(() => formatDuration(Infinity)).toThrow();
+});
+
+test('format and parse round-trip', () => {
+  for (let n = 0; n <= 200_000; n += 997) {
+    expect(parseDuration(formatDuration(n))).toBe(n);
+    expect(formatDuration(n)).toMatch(/^(\d+(d|h|m|s|ms))+$/);
+  }
+  for (const n of [86_400_000 * 400, 2 ** 40 + 7]) {
+    expect(parseDuration(formatDuration(n))).toBe(n);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/lru.rules.test.ts b/test/lru.rules.test.ts
--- a/test/lru.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/lru.rules.test.ts	2026-10-30 01:05:06.449420430 +0000
@@ -0,0 +1,174 @@
+import { expect, test } from 'bun:test';
+import { LRU, type EvictReason } from '../src/lru.ts';
+
+function setup(capacity: number, ttl: number) {
+  let t = 0;
+  const log: [string, number, EvictReason][] = [];
+  const cache = new LRU<string, number>(capacity, ttl, () => t);
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+  return { cache, log, advance: (ms: number) => (t += ms), at: (x: number) => (t = x) };
+}
+
+test('get hit makes the entry most recent', () => {
+  const { cache, log } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.get('a')).toBe(1);
+  cache.set('c', 3);
+  expect(log).toEqual([['b', 2, 'capacity']]);
+  expect(cache.keys()).toEqual(['c', 'a']);
+});
+
+test('expired get returns undefined once and reports expired', () => {
+  const { cache, log, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  advance(1000);
+  expect(cache.get('a')).toBeUndefined();
+  expect(cache.get('a')).toBeUndefined();
+  expect(log).toEqual([['a', 1, 'expired']]);
+});
+
+test('boundary: live at ttl-1, expired at ttl', () => {
+  const { cache, at } = setup(5, 1000);
+  cache.set('a', 1);
+  at(999);
+  expect(cache.get('a')).toBe(1);
+  at(1000);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('set gives a fresh ttl and does not evict', () => {
+  const { cache, log, at } = setup(2, 1000);
+  cache.set('a', 1);
+  at(500);
+  cache.set('a', 2);
+  expect(log).toEqual([]);
+  at(1400);
+  expect(cache.get('a')).toBe(2);
+  at(1500);
+  expect(cache.get('a')).toBeUndefined();
+});
+
+test('expired entries are swept before a live one is evicted', () => {
+  const { cache, log, advance } = setup(2, 1000);
+  cache.set('a', 1);
+  advance(600);
+  cache.set('b', 2);
+  advance(500);
+  cache.set('c', 3);
+  expect(log).toEqual([['a', 1, 'expired']]);
+  expect(cache.keys()).toEqual(['c', 'b']);
+});
+
+test('several expired entries are all swept, no live one evicted', () => {
+  const { cache, log, advance } = setup(2, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  advance(1000);
+  cache.set('c', 3);
+  cache.set('d', 4);
+  cache.set('e', 5);
+  expect(log).toEqual([
+    ['a', 1, 'expired'],
+    ['b', 2, 'expired'],
+    ['c', 3, 'capacity'],
+  ]);
+  expect(cache.keys()).toEqual(['e', 'd']);
+});
+
+test('delete reports live, expired and missing keys', () => {
+  const { cache, log, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  cache.set('b', 2);
+  expect(cache.delete('a')).toBe(true);
+  expect(log).toEqual([['a', 1, 'delete']]);
+  advance(1000);
+  expect(cache.delete('b')).toBe(false);
+  expect(log[1]).toEqual(['b', 2, 'expired']);
+  log.length = 0;
+  expect(cache.delete('zzz')).toBe(false);
+  expect(log).toEqual([]);
+});
+
+test('size and keys count only live entries, with no side effects', () => {
+  const { cache, log, advance } = setup(5, 1000);
+  cache.set('a', 1);
+  advance(500);
+  cache.set('b', 2);
+  advance(500);
+  expect(cache.size).toBe(1);
+  expect(cache.keys()).toEqual(['b']);
+  expect(log).toEqual([]);
+});
+
+test('seeded random operations match a reference model', () => {
+  let seed = 12345;
+  const rnd = (n: number) => {
+    seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+    return seed % n;
+  };
+  const CAP = 3;
+  const TTL = 1000;
+  let t = 0;
+  const log: [string, number, EvictReason][] = [];
+  const cache = new LRU<string, number>(CAP, TTL, () => t);
+  cache.onEvict = (k, v, r) => log.push([k, v, r]);
+
+  // Reference: MRU-first array of {k, v, exp}.
+  let model: { k: string; v: number; exp: number }[] = [];
+  const live = (e: { exp: number }) => t < e.exp;
+  const mEvict: [string, number, EvictReason][] = [];
+
+  const keysPool = ['a', 'b', 'c', 'd', 'e'];
+  for (let i = 0; i < 2000; i++) {
+    const op = rnd(4);
+    const key = keysPool[rnd(keysPool.length)];
+    if (op === 0) {
+      const v = rnd(100);
+      model = model.filter((x) => x.k !== key);
+      model.unshift({ k: key, v, exp: t + TTL });
+      cache.set(key, v);
+      // capacity-driven sweep uses the list in LRU-first order
+      if (model.length > CAP) {
+        const expired = model.filter((x) => !live(x));
+        model = model.filter((x) => live(x));
+        for (const e of expired.reverse()) mEvict.push([e.k, e.v, 'expired']);
+        while (model.length > CAP) {
+          const e = model.pop()!;
+          mEvict.push([e.k, e.v, 'capacity']);
+        }
+      }
+    } else if (op === 1) {
+      const idx = model.findIndex((x) => x.k === key);
+      let expected: number | undefined;
+      if (idx >= 0) {
+        const [e] = model.splice(idx, 1);
+        if (live(e)) {
+          model.unshift(e);
+          expected = e.v;
+        } else {
+          mEvict.push([e.k, e.v, 'expired']);
+        }
+      }
+      expect(cache.get(key)).toBe(expected);
+    } else if (op === 2) {
+      const idx = model.findIndex((x) => x.k === key);
+      let expected = false;
+      if (idx >= 0) {
+        const [e] = model.splice(idx, 1);
+        if (live(e)) {
+          expected = true;
+          mEvict.push([e.k, e.v, 'delete']);
+        } else {
+          mEvict.push([e.k, e.v, 'expired']);
+        }
+      }
+      expect(cache.delete(key)).toBe(expected);
+    } else {
+      t += rnd(401);
+    }
+    expect(cache.size).toBe(model.filter(live).length);
+    expect(cache.keys()).toEqual(model.filter(live).map((x) => x.k));
+    expect(log).toEqual(mEvict);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/slug.rules.test.ts b/test/slug.rules.test.ts
--- a/test/slug.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/slug.rules.test.ts	2026-10-30 01:05:01.489420135 +0000
@@ -0,0 +1,48 @@
+import { expect, test } from 'bun:test';
+import { slugify, uniqueSlug } from '../src/slug.ts';
+
+test('slugify: lower case and diacritics removed', () => {
+  expect(slugify('ABC')).toBe('abc');
+  expect(slugify('àçñź')).toBe('acnz');
+  expect(slugify('Crème')).toBe('creme');
+});
+
+test('slugify: special letters, both cases', () => {
+  expect(slugify('ß æ œ ø ł đ')).toBe('ss-ae-oe-o-l-d');
+  expect(slugify('ÆØŁĐ')).toBe('aeold');
+});
+
+test('slugify: separators collapse, no leading or trailing dash', () => {
+  expect(slugify('a_b  c!!d')).toBe('a-b-c-d');
+  expect(slugify('日本')).toBe('');
+  expect(slugify('--hi--')).toBe('hi');
+});
+
+test('slugify: max cuts at the last dash that fits', () => {
+  expect(slugify('ab-cd-ef', 5)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 6)).toBe('ab-cd');
+  expect(slugify('ab-cd-ef', 4)).toBe('ab');
+  expect(slugify('abcdef', 3)).toBe('abc');
+  expect(slugify('ab', 5)).toBe('ab');
+  expect(slugify('ab-cd', 0)).toBe('');
+});
+
+test('slugify: max never leaves a trailing dash or exceeds max', () => {
+  const full = slugify('ab-c-def-gh-ijklm');
+  for (let max = 1; max <= 12; max++) {
+    const s = slugify('ab-c-def-gh-ijklm', max);
+    expect(s.length).toBeLessThanOrEqual(max);
+    expect(s.endsWith('-')).toBe(false);
+    expect(full.startsWith(s)).toBe(true);
+  }
+});
+
+test('uniqueSlug: first free suffix, taken set not changed', () => {
+  expect(uniqueSlug('post', new Set())).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-2', 'post-3']))).toBe('post-4');
+  expect(uniqueSlug('post', new Set(['post-2']))).toBe('post');
+  expect(uniqueSlug('post', new Set(['post', 'post-3']))).toBe('post-2');
+  const taken = new Set(['post']);
+  uniqueSlug('post', taken);
+  expect([...taken]).toEqual(['post']);
+});
