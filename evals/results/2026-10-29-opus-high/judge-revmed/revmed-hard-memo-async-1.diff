diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.bugs.test.ts b/memo.bugs.test.ts
--- a/memo.bugs.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.bugs.test.ts	2026-10-30 00:49:16.913363987 +0000
@@ -0,0 +1,137 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+// fn's calls, each settled by the test.
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("never keeps more than max keys while they are in flight", () => {
+  const { fn } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  expect(m.size).toBe(2);
+  m("c");
+  expect(m.size).toBe(2);
+});
+
+test("a key dropped for max is looked up again", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  m("c");
+  m("a");
+  expect(calls).toHaveLength(4);
+});
+
+test("invalidate during a call does not bring its value back after it settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("clear during a call does not bring its value back after it settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.clear();
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a call dropped for max does not re-add its key when it settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  await tick();
+  expect(m.size).toBe(1);
+  m("b");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale rejection does not delete a newer call for the same key", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(first).rejects.toThrow("boom");
+  expect(m("k")).toBe(second);
+  expect(calls).toHaveLength(2);
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+});
+
+test("a cache hit counts as a use for max", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("a");
+  m("c");
+  expect(calls).toHaveLength(3);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("rejected callers all get the rejection and the next call runs fn again", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const a = m("k");
+  const b = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(a).rejects.toThrow("boom");
+  await expect(b).rejects.toThrow("boom");
+  expect(m.size).toBe(0);
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a settled value is kept for ttlMs, exclusive at the end", async () => {
+  let t = 50;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 10, now: () => t });
+  m("k");
+  calls[0]!.d.resolve("v");
+  await tick();
+  t = 149;
+  m("k");
+  expect(calls).toHaveLength(1);
+  t = 150;
+  m("k");
+  expect(calls).toHaveLength(2);
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.ts b/memo.ts
--- a/memo.ts	2026-10-30 00:48:05.649143085 +0000
+++ b/memo.ts	2026-10-30 00:49:16.906245628 +0000
@@ -31,14 +31,25 @@
   const cache = new Map<K, { promise: Promise<V>; expires: number }>();
   const call = ((key: K) => {
     const hit = cache.get(key);
-    if (hit && hit.expires > now()) return hit.promise;
+    if (hit && hit.expires > now()) {
+      // Answered from the cache: a use, so move the key to the most recent end.
+      cache.delete(key);
+      cache.set(key, hit);
+      return hit.promise;
+    }
     cache.delete(key);
-    if (cache.size > opts.max) cache.delete(cache.keys().next().value as K);
+    while (cache.size >= opts.max) cache.delete(cache.keys().next().value as K);
     const entry = { promise: fn(key), expires: Infinity };
     cache.set(key, entry);
+    // Only touch the cache if this call's entry is still the one kept for the key; otherwise it was
+    // invalidated, cleared or dropped for max, and its result is not kept.
     entry.promise.then(
-      (value) => cache.set(key, { promise: Promise.resolve(value), expires: now() + opts.ttlMs }),
-      () => cache.delete(key),
+      () => {
+        if (cache.get(key) === entry) entry.expires = now() + opts.ttlMs;
+      },
+      () => {
+        if (cache.get(key) === entry) cache.delete(key);
+      },
     );
     return entry.promise;
   }) as Memo<K, V>;
