+  const cd = cwd === undefined ? null : /^cd ("[^"]*"|'[^']*'|[^\s&]+) && /.exec(cmd);
+  if (cd && cwd !== undefined && resolve(cwd, cd[1]!.replace(/^["']|["']$/g, '')) === resolve(cwd)) cmd = cmd.slice(cd[0].length);
+  return checks.find((c) => normalize(c) === cmd);
 }
 
