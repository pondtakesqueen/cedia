+  let lastPass = -1;
+  entries.forEach((e, i) => {
+    if (e.kind === 'check' && e.exitCode === 0) lastPass = i;
+  });
+  const changed = new Set<string>();
+  const unverified = new Set<string>();
+  entries.forEach((e, i) => {
+    if (e.kind !== 'write') return;
