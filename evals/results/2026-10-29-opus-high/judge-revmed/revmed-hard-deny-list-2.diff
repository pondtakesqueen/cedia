diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.rules.test.ts b/deny.rules.test.ts
--- a/deny.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/deny.rules.test.ts	2026-10-30 00:40:30.213332678 +0000
@@ -0,0 +1,60 @@
+import { expect, test } from 'bun:test';
+import { denyListed, insideWorkspace, sameDir } from './deny.ts';
+
+const cwd = '/work/repo';
+const hit = (line: string) => denyListed(line.split(' '), cwd)?.name;
+
+test('git global options with values are skipped, --git-dir=x takes no extra word', () => {
+  expect(hit('git --work-tree w --namespace n push -f')).toBe('force-push');
+  expect(hit('git --git-dir=.git push -f')).toBe('force-push');
+  expect(hit('git -C')).toBeUndefined();
+  expect(hit('git')).toBeUndefined();
+});
+
+test('push long flags with =value, and near misses', () => {
+  expect(hit('git push --delete=x')).toBe('force-push');
+  expect(hit('git push --forced')).toBeUndefined();
+});
+
+test('push short flag groups containing f or d in any order', () => {
+  expect(hit('git push -df')).toBe('force-push');
+  expect(hit('git push -uf origin')).toBe('force-push');
+});
+
+test('clean with -n anywhere cancels force, and -df and -fn count', () => {
+  expect(hit('git clean -df')).toBe('clean-force');
+  expect(hit('git clean -fn')).toBe('clean-force');
+  expect(hit('git clean --force -n')).toBeUndefined();
+});
+
+test('rm -- makes later words targets, not flags', () => {
+  expect(hit('rm -- -r /etc')).toBeUndefined();
+  expect(hit('rm -rf -- /')).toBe('rm-outside');
+  expect(hit('rm -rf -- .')).toBe('rm-outside');
+  expect(hit('rm -r /')).toBe('rm-outside');
+  expect(hit('rm -r ./')).toBe('rm-outside');
+  expect(hit('rm -rf /work/repo/')).toBe('rm-outside');
+  expect(hit('rm -rf ~')).toBe('rm-outside');
+  expect(hit('rm -rf ..')).toBe('rm-outside');
+});
+
+test('find start paths: cwd is fine, ~user is outside, no paths or delete alone', () => {
+  expect(hit('find . /work/repo -delete')).toBeUndefined();
+  expect(hit('find ~bob -exec x ;')).toBe('rm-outside');
+  expect(hit('find -delete -exec')).toBeUndefined();
+  expect(hit('find')).toBeUndefined();
+});
+
+test('argv[0] path and empty argv', () => {
+  expect(hit('/usr/bin/rm -rf /')).toBe('rm-outside');
+  expect(denyListed([], cwd)).toBeUndefined();
+});
+
+test('rm -r verdict matches the workspace check for each target', () => {
+  const targets = ['/', '~', '.', '..', './', '/work/repo', '/work/repo/src', 'src', '../x', '/tmp', '/work/repository', 'a/../b'];
+  for (const p of targets) {
+    const outside = !insideWorkspace(p, cwd) || sameDir(p, cwd);
+    expect([p, hit('rm -rf ' + p) === 'rm-outside']).toEqual([p, outside]);
+    expect([p, hit('rm -R ' + p)]).toEqual([p, hit('rm -rf ' + p)]);
+  }
+});
diff -ruN '--exclude=node_modules' '--exclude=.git' a/deny.ts b/deny.ts
--- a/deny.ts	2026-10-30 00:38:50.802974980 +0000
+++ b/deny.ts	2026-10-30 00:39:52.089330412 +0000
@@ -1,5 +1,5 @@
 import { homedir } from 'node:os';
-import { isAbsolute, relative, resolve } from 'node:path';
+import { basename, isAbsolute, relative, resolve } from 'node:path';
 
 export type Hit = { name: 'force-push' | 'reset-hard' | 'clean-force' | 'rm-outside'; reason: string };
 
@@ -14,6 +14,13 @@
 // Same directory as cwd, e.g. `.`, `./`, or cwd's absolute path.
 export const sameDir = (path: string, cwd: string) => relative(resolve(cwd), resolve(cwd, expandHome(path))) === '';
 
+const GIT_VALUE_OPTS = new Set(['-C', '-c', '--git-dir', '--work-tree', '--namespace']);
+// A short flag group such as -fu or -df (not a long --option) containing one of `chars`.
+const shortHas = (w: string, chars: string) => /^-[^-]/.test(w) && [...w.slice(1)].some((c) => chars.includes(c));
+// Cannot be resolved before it runs: contains $, or ~user (~ and ~/... are fine).
+const unresolvable = (p: string) => p.includes('$') || (p.startsWith('~') && p !== '~' && !p.startsWith('~/'));
+const outside = (p: string, cwd: string) => unresolvable(p) || !insideWorkspace(p, cwd);
+
 // Looks at one simple command's argv (already split, quotes removed) and returns a Hit when it must be denied.
 //
 // git (argv[0] may be a path such as /usr/bin/git). Global options before the subcommand are skipped; -C, -c,
@@ -36,5 +43,47 @@
 //
 // Anything else: undefined.
 export function denyListed(argv: string[], cwd: string): Hit | undefined {
-  throw new Error('not implemented');
+  if (argv.length === 0) return undefined;
+  const cmd = basename(argv[0]);
+  if (cmd === 'git') return gitHit(argv.slice(1));
+  if (cmd === 'rm') return rmHit(argv.slice(1), cwd);
+  if (cmd === 'find') return findHit(argv.slice(1), cwd);
+  return undefined;
+}
+
+function gitHit(argv: string[]): Hit | undefined {
+  let i = 0;
+  while (i < argv.length && argv[i].startsWith('-')) i += GIT_VALUE_OPTS.has(argv[i]) ? 2 : 1;
+  const sub = argv[i];
+  const args = argv.slice(i + 1);
+  if (sub === 'push') {
+    const bad = args.find(
+      (w) => /^--(force|force-with-lease|mirror|delete|prune)(=|$)/.test(w) || shortHas(w, 'fd') || (!w.startsWith('-') && /^[+:]/.test(w)),
+    );
+    if (bad !== undefined) return { name: 'force-push', reason: `git push ${bad} rewrites or deletes remote refs` };
+  }
+  if (sub === 'reset' && args.includes('--hard')) return { name: 'reset-hard', reason: 'git reset --hard discards local changes' };
+  if (sub === 'clean' && !args.some((w) => w === '-n' || w === '--dry-run') && args.some((w) => w === '--force' || shortHas(w, 'f')))
+    return { name: 'clean-force', reason: 'git clean -f deletes untracked files' };
+  return undefined;
+}
+
+function rmHit(argv: string[], cwd: string): Hit | undefined {
+  const dd = argv.indexOf('--');
+  const before = dd < 0 ? argv : argv.slice(0, dd);
+  const targets = [...before.filter((w) => !w.startsWith('-')), ...(dd < 0 ? [] : argv.slice(dd + 1))];
+  if (!before.some((w) => w === '--recursive' || shortHas(w, 'rR'))) return undefined;
+  if (targets.length === 0) return { name: 'rm-outside', reason: 'rm -r with no targets (they may come from xargs)' };
+  const bad = targets.find((t) => outside(t, cwd) || sameDir(t, cwd));
+  if (bad !== undefined) return { name: 'rm-outside', reason: `rm -r ${bad} is outside ${cwd} or is cwd itself` };
+  return undefined;
+}
+
+function findHit(argv: string[], cwd: string): Hit | undefined {
+  if (!argv.some((w) => w === '-delete' || w === '-exec' || w === '-execdir')) return undefined;
+  const firstOpt = argv.findIndex((w) => w.startsWith('-'));
+  const starts = firstOpt < 0 ? argv : argv.slice(0, firstOpt);
+  const bad = (starts.length ? starts : ['.']).find((p) => outside(p, cwd));
+  if (bad !== undefined) return { name: 'rm-outside', reason: `find ${bad} with -delete or -exec is outside ${cwd}` };
+  return undefined;
 }
