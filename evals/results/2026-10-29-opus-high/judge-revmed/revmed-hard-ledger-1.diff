 // One exception: a leading `cd <dir> && ` is removed when <dir> (quotes stripped) resolves to `cwd`.
+const normalize = (s: string) => s.trim().replace(/\s+/g, ' ').replace(/ 2>&1$/, '').trim();
+
 export function matchCheck(command: string, checks: string[], cwd?: string): string | undefined {
-  throw new Error('not implemented');
+  let rest = normalize(command);
+  const cd = /^cd ("[^"]*"|'[^']*'|\S+) && /.exec(rest);
+  if (cd && cwd !== undefined && resolve(cwd, cd[1]!.replace(/^(["'])(.*)\1$/, '$2')) === resolve(cwd)) rest = rest.slice(cd[0].length);
+  return checks.find((check) => normalize(check) === rest);
 }
 
