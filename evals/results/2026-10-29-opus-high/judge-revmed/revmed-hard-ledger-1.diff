+  entries.forEach((e, i) => {
+    if (e.kind === 'check') {
+      checks.push({ command: e.command, exitCode: e.exitCode });
+      if (e.exitCode === 0) lastPass = i;
+    } else changed.add(label(e));
+  });
+  const unverified = new Set<string>();
+  entries.forEach((e, i) => {
