--- a/ledger.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/ledger.rules.test.ts	2026-10-30 00:47:20.093357042 +0000
@@ -0,0 +1,124 @@
+import { describe, expect, test } from 'bun:test';
+import { evidence, ledgerEntries, matchCheck, verified, type LedgerEntry, type SessionEvent } from './ledger.ts';
+
+const cwd = '/work/repo';
+let n = 0;
+const bash = (command: string, exitCode = 0, status: 'completed' | 'failed' | 'denied' | 'not_started' = exitCode ? 'failed' : 'completed'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool: 'bash', input: { command } },
+    { kind: 'tool_result', callId, status, output: { isError: exitCode !== 0, exitCode } },
+  ];
+};
+const edit = (path: string, status: 'completed' | 'failed' = 'completed', tool = 'edit'): SessionEvent[] => {
+  const callId = `r${++n}`;
+  return [
+    { kind: 'tool_intent', callId, tool, input: { path } },
+    { kind: 'tool_result', callId, status, output: { isError: status !== 'completed' } },
+  ];
+};
+
+describe('matchCheck rules', () => {
+  test('whitespace collapses and a trailing 2>&1 is dropped on both sides', () => {
+    expect(matchCheck('bun\t\ttest  2>&1 ', ['  bun   test '])).toBe('  bun   test ');
+    expect(matchCheck('bun test', ['bun test 2>&1'])).toBe('bun test 2>&1');
+  });
+
+  test('the first check in list order wins, returned as written', () => {
+    expect(matchCheck('bun test', ['bun  test', 'bun test 2>&1'])).toBe('bun  test');
+  });
+
+  test('cd exception: quoted single dirs, ./ and only one prefix', () => {
+    expect(matchCheck("cd '/work/repo' && bun test", ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd ./ && bun test', ['bun test'], cwd)).toBe('bun test');
+    expect(matchCheck('cd /elsewhere && bun test', ['bun test'], cwd)).toBeUndefined();
+    expect(matchCheck('cd /work/repo && cd /work/repo && bun test', ['bun test'], cwd)).toBeUndefined();
+  });
+
+  test('only one trailing 2>&1 is dropped, also after a cd prefix', () => {
+    expect(matchCheck('bun test 2>&1 2>&1', ['bun test'])).toBeUndefined();
+    expect(matchCheck('cd . && bun test 2>&1 2>&1', ['bun test'], '/w')).toBeUndefined();
+    expect(matchCheck('cd . && bun test 2>&1', ['bun test'], '/w')).toBe('bun test');
+  });
+
+  test('a quoted cd dir with spaces is stripped when it resolves to cwd', () => {
+    expect(matchCheck('cd "/work/my repo" && bun test', ['bun test'], '/work/my repo')).toBe('bun test');
+    expect(matchCheck('cd "/work/my repo" && bun test', ['bun test'])).toBeUndefined();
+  });
+
+  test('chains, redirects and extra arguments do not match', () => {
+    expect(matchCheck('bun test; echo', ['bun test'])).toBeUndefined();
+    expect(matchCheck('bun test > out', ['bun test'])).toBeUndefined();
+    expect(matchCheck('', ['bun test'])).toBeUndefined();
+  });
+});
+
+describe('ledgerEntries rules', () => {
+  test('a snapshot placed before its result still applies', () => {
+    const [intent, result] = bash('sed -i s/a/b/ x.ts');
+    expect(ledgerEntries([intent!, { kind: 'snapshot', callId: (intent as { callId: string }).callId, changed: ['x.ts'] }, result!], [])).toEqual([
+      { kind: 'write', at: 2, tool: 'bash', path: 'x.ts' },
+    ]);
+  });
+
+  test('a failed edit with a snapshot gives the snapshot paths; a failed npm install is still a write', () => {
+    const [ei, er] = edit('a.ts', 'failed');
+    const snap = { kind: 'snapshot' as const, callId: (ei as { callId: string }).callId, changed: ['a.ts', 'b.ts'] };
+    const install = bash('npm install', 1);
+    expect(ledgerEntries([ei!, er!, snap, ...install], [])).toEqual([
+      { kind: 'write', at: 1, tool: 'edit', path: 'a.ts' },
+      { kind: 'write', at: 1, tool: 'edit', path: 'b.ts' },
+      { kind: 'write', at: 4, tool: 'bash', command: 'npm install' },
+    ]);
+  });
+
+  test('an explicit exitCode 0 wins over isError', () => {
+    const [i] = bash('bun test');
+    const callId = i!.kind === 'tool_intent' ? i!.callId : '';
+    const result: SessionEvent = { kind: 'tool_result', callId, status: 'completed', output: { isError: true, exitCode: 0 } };
+    expect(ledgerEntries([i!, result], ['bun test'])).toEqual([{ kind: 'check', at: 1, command: 'bun test', exitCode: 0 }]);
+  });
+
+  test('read-only bash is not a write; a redirect is', () => {
+    expect(ledgerEntries([...bash('git status'), ...bash('echo x > f')], [])).toEqual([{ kind: 'write', at: 3, tool: 'bash', command: 'echo x > f' }]);
+  });
+
+  test('a snapshot without a callId is ignored', () => {
+    expect(ledgerEntries([{ kind: 'snapshot', changed: ['x.ts'] }], [])).toEqual([]);
+  });
+});
+
+describe('evidence and verified rules', () => {
+  const w = (at: number, path: string): LedgerEntry => ({ kind: 'write', at, tool: 'edit', path });
+  const c = (at: number, exitCode: number): LedgerEntry => ({ kind: 'check', at, command: 'bun test', exitCode });
+
+  test('unverified is deduped, first seen, and a later failing check does not clear it', () => {
+    const e = [w(1, 'a.ts'), c(2, 0), w(3, 'b.ts'), w(4, 'b.ts'), w(5, 'a.ts'), c(6, 1)];
+    expect(evidence(e).unverified).toEqual(['b.ts', 'a.ts']);
+  });
+
+  test('checks with no writes verify; a pass before a write does not', () => {
+    expect(verified([c(1, 0)], ['bun test'])).toBe(true);
+    expect(verified([c(1, 0), w(2, 'a.ts'), c(3, 1)], ['bun test'])).toBe(false);
+  });
+
+  test('agreement with evidence over seeded random logs', () => {
+    let seed = 42;
+    const rand = () => {
+      seed = (seed * 1103515245 + 12345) & 0x7fffffff;
+      return seed / 0x80000000;
+    };
+    for (let t = 0; t < 500; t++) {
+      const size = Math.floor(rand() * 9);
+      const e: LedgerEntry[] = [];
+      for (let i = 0; i < size; i++) {
+        const k = rand();
+        if (k < 0.4) e.push(w(i, `f${Math.floor(rand() * 3)}.ts`));
+        else if (k < 0.6) e.push({ kind: 'write', at: i, tool: 'bash', command: 'npm i' });
+        else e.push(c(i, rand() < 0.5 ? 0 : 1));
+      }
+      expect(verified(e, ['bun test'])).toBe(evidence(e).unverified.length === 0);
+      expect(verified(e, [])).toBe(true);
+    }
+  });
+});
