 // An entry set at time t expires at t + ttlMs: it is live while now() < t + ttlMs.
 export type EvictReason = 'capacity' | 'expired' | 'delete';
 
+type Entry<V> = { value: V; expires: number };
+
 export class LRU<K, V> {
   onEvict?: (key: K, value: V, reason: EvictReason) => void;
 
+  // Insertion order is recency order: the least recently used entry comes first.
+  #map = new Map<K, Entry<V>>();
+  #capacity: number;
+  #ttlMs: number;
+  #now: () => number;
+
   constructor(capacity: number, ttlMs: number, now: () => number = Date.now) {
-    throw new Error('not implemented');
+    this.#capacity = capacity;
+    this.#ttlMs = ttlMs;
+    this.#now = now;
+  }
+
+  #live(e: Entry<V>): boolean {
+    return this.#now() < e.expires;
   }
 
   get(key: K): V | undefined {
-    throw new Error('not implemented');
+    const e = this.#map.get(key);
+    if (e === undefined) return undefined;
+    this.#map.delete(key);
+    if (!this.#live(e)) {
+      this.onEvict?.(key, e.value, 'expired');
+      return undefined;
+    }
+    this.#map.set(key, e);
+    return e.value;
   }
 
   set(key: K, value: V): void {
-    throw new Error('not implemented');
+    const old = this.#map.get(key);
+    if (old !== undefined) {
+      this.#map.delete(key);
+      if (!this.#live(old)) this.onEvict?.(key, old.value, 'expired');
+    }
+    this.#map.set(key, { value, expires: this.#now() + this.#ttlMs });
+    if (this.#map.size > this.#capacity) {
+      for (const [k, e] of [...this.#map]) {
+        if (!this.#live(e)) {
+          this.#map.delete(k);
+          this.onEvict?.(k, e.value, 'expired');
+        }
+      }
+      while (this.#map.size > this.#capacity) {
+        const [k, e] = this.#map.entries().next().value as [K, Entry<V>];
+        this.#map.delete(k);
+        this.onEvict?.(k, e.value, 'capacity');
+      }
+    }
   }
 
   delete(key: K): boolean {
-    throw new Error('not implemented');
+    const e = this.#map.get(key);
+    if (e === undefined) return false;
+    this.#map.delete(key);
+    if (this.#live(e)) {
+      this.onEvict?.(key, e.value, 'delete');
+      return true;
+    }
+    this.onEvict?.(key, e.value, 'expired');
+    return false;
   }
 
   get size(): number {
-    throw new Error('not implemented');
+    let n = 0;
+    for (const e of this.#map.values()) if (this.#live(e)) n++;
+    return n;
   }
 
   keys(): K[] {
-    throw new Error('not implemented');
+    return [...this.#map]
+      .filter(([, e]) => this.#live(e))
+      .map(([k]) => k)
+      .reverse();
   }
 }
