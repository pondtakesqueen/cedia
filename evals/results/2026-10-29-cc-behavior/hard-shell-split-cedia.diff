diff --git a/shell.ts b/shell.ts
index 3093ac4..c2a301a 100644
--- a/shell.ts
+++ b/shell.ts
@@ -37,5 +37,134 @@ const WRAPPERS = new Map<string, Wrapper>([
 // - Empty commands are left out.
 // - Unbalanced quotes: return null.
 export function simpleCommands(command: string): string[][] | null {
-  throw new Error('not implemented');
+  const groups = splitWords(command);
+  if (!groups) return null;
+  const out: string[][] = [];
+  for (const group of groups) {
+    const argv = commandsOf(group);
+    if (!argv) return null;
+    out.push(...argv);
+  }
+  return out;
+}
+
+const ASSIGNMENT = /^[A-Za-z_][A-Za-z0-9_]*=/;
+const KEYWORDS = new Set(['{', '}', '!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until']);
+const SHELLS = new Set(['bash', 'sh', 'zsh', 'dash', 'ksh']);
+
+// Lexes the line into groups of words, one group per command. Separators and substitution delimiters all end
+// a group, so $( ) and backticks come out as commands of their own. Redirection targets are dropped.
+// Returns null on an unclosed quote.
+function splitWords(s: string): string[][] | null {
+  const groups: string[][] = [];
+  const stack: string[] = []; // open 'dq' (double quotes), 'sub' ($( )) and 'bt' (backticks)
+  let group: string[] = [];
+  let word = '';
+  let active = false; // a word has started; quotes make "" a word too
+  let quoted = false;
+  let target = false; // the next word is a redirection target
+  const endWord = () => {
+    if (!active) return;
+    if (target) target = false;
+    else group.push(word);
+    word = '';
+    active = quoted = false;
+  };
+  const separator = () => {
+    endWord();
+    groups.push(group);
+    group = [];
+    target = false;
+  };
+  let i = 0;
+  while (i < s.length) {
+    const c = s[i];
+    const top = stack.at(-1);
+    if (c === "'" && top !== 'dq') {
+      const end = s.indexOf("'", i + 1);
+      if (end < 0) return null;
+      word += s.slice(i + 1, end);
+      active = quoted = true;
+      i = end + 1;
+    } else if (c === '"') {
+      if (top === 'dq') stack.pop();
+      else stack.push('dq');
+      active = quoted = true;
+      i++;
+    } else if (c === '\\' && i + 1 < s.length) {
+      word += s[i + 1];
+      active = quoted = true;
+      i += 2;
+    } else if (c === '`') {
+      if (top === 'bt') stack.pop();
+      else stack.push('bt');
+      separator();
+      i++;
+    } else if (c === '$' && s[i + 1] === '(') {
+      stack.push('sub');
+      separator();
+      i += 2;
+    } else if (top === 'dq') {
+      word += c;
+      active = true;
+      i++;
+    } else if (c === ' ' || c === '\t') {
+      endWord();
+      i++;
+    } else if (c === '<' || c === '>' || (c === '&' && s[i + 1] === '>')) {
+      // A bare fd number before the operator (2>file) is part of the redirection.
+      if (active && !quoted && /^\d+$/.test(word)) {
+        word = '';
+        active = false;
+      } else {
+        endWord();
+      }
+      if (c === '&') i++;
+      while (s[i] === '<' || s[i] === '>') i++;
+      if (s[i] === '&' && /[<>]/.test(s[i - 1])) i++;
+      target = true;
+    } else if (c === '\n' || c === ';' || c === '&' || c === '|' || c === '(' || c === ')') {
+      separator();
+      if (c === ')' && top === 'sub') stack.pop();
+      i++;
+    } else {
+      word += c;
+      active = true;
+      i++;
+    }
+  }
+  if (stack.includes('dq')) return null;
+  endWord();
+  groups.push(group);
+  return groups;
+}
+
+// The argv of the simple commands in one group of words, after unwrapping what runs them.
+function commandsOf(words: string[]): string[][] | null {
+  let i = 0;
+  for (;;) {
+    while (i < words.length && (ASSIGNMENT.test(words[i]) || KEYWORDS.has(words[i]))) i++;
+    if (i >= words.length) return [];
+    const name = words[i];
+    const wrapper = WRAPPERS.get(name);
+    if (wrapper) {
+      i++;
+      while (i < words.length && words[i].startsWith('-')) {
+        const flag = words[i++];
+        if (flag === '--') break;
+        if (wrapper.value?.includes(flag)) i++;
+      }
+      i += wrapper.positional ?? 0;
+      continue;
+    }
+    const args = words.slice(i + 1);
+    if (SHELLS.has(name)) {
+      const isC = (arg: string) => /^-[a-zA-Z]*c/.test(arg);
+      let j = 0;
+      while (j < args.length && args[j].startsWith('-') && !isC(args[j])) j++;
+      if (j < args.length && isC(args[j])) return simpleCommands(args[j + 1] ?? '');
+    }
+    if (name === 'eval') return simpleCommands(args.join(' '));
+    return [words.slice(i)];
+  }
 }
