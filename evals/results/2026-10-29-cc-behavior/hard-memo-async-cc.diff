diff --git a/memo.test.ts b/memo.test.ts
index a4e14c1..5dc45ec 100644
--- a/memo.test.ts
+++ b/memo.test.ts
@@ -66,3 +66,75 @@ test("a result in flight during invalidate is not kept", async () => {
   m("k");
   expect(calls).toHaveLength(2);
 });
+
+test("a stale call settling does not overwrite a newer call's result", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[1]!.d.resolve("new");
+  await tick();
+  calls[0]!.d.resolve("old");
+  await tick();
+  expect(await second).toBe("new");
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("a stale call rejecting does not forget a newer call", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  m("k").catch(() => {});
+  m.invalidate("k");
+  m("k");
+  calls[0]!.d.reject(new Error("old"));
+  await tick();
+  m("k");
+  expect(calls).toHaveLength(2);
+});
+
+test("a key dropped for max while in flight is not re-added when it settles", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 1 });
+  const a = m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  expect(await a).toBe("a");
+  expect(m.size).toBe(1);
+  m("a");
+  expect(calls).toHaveLength(3);
+});
+
+test("a cache hit makes the key most recently used", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  for (const c of calls) c.d.resolve(c.key);
+  await tick();
+  expect(await m("a")).toBe("a");
+  m("c"); // drops b, not a
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("an expired key is dropped before a live one and not counted in size", async () => {
+  let t = 0;
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 100, max: 2, now: () => t });
+  m("a");
+  calls[0]!.d.resolve("a");
+  await tick();
+  t = 50;
+  m("b");
+  calls[1]!.d.resolve("b");
+  await tick();
+  t = 120; // a expired, b live
+  expect(m.size).toBe(1);
+  m("c"); // room without dropping b
+  expect(await m("b")).toBe("b");
+  expect(calls).toHaveLength(3);
+});
