+// Index of the backtick closing one whose contents start at `start`, or -1.
+function closingBacktick(s: string, start: number): number {
+  for (let i = start; i < s.length; i++) {
+    if (s[i] === '\\') i++;
+    else if (s[i] === '`') return i;
+  }
+  return -1;
