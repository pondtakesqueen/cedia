+// Turns the words of one simple command into the argv of the commands it runs.
+function expand(words: Word[]): string[][] | null {
+  const argv: string[] = [];
+  let lead = true;
+  for (let i = 0; i < words.length; i++) {
+    const { text, quoted } = words[i];
+    if (!quoted && REDIRECT_OP.test(text)) {
+      i++;
+      continue;
+    }
+    if (!quoted && REDIRECT_PREFIX.test(text)) continue;
+    if (lead && !quoted && (ASSIGNMENT.test(text) || KEYWORDS.has(text))) continue;
+    lead = false;
+    argv.push(text);
+  }
+  return unwrap(argv);
+}
+
+function unwrap(argv: string[]): string[][] | null {
+  for (;;) {
+    while (argv.length && (ASSIGNMENT.test(argv[0]) || KEYWORDS.has(argv[0]))) argv = argv.slice(1);
+    if (!argv.length) return [];
+    const name = basename(argv[0]);
+    const wrapper = WRAPPERS.get(name);
+    if (wrapper) {
+      let i = 1;
+      while (i < argv.length && argv[i].startsWith('-')) {
+        if (argv[i] === '--') {
+          i++;
+          break;
+        }
+        i += wrapper.value?.includes(argv[i]) ? 2 : 1;
+      }
+      argv = argv.slice(i + (wrapper.positional ?? 0));
+      continue;
+    }
+    if (name === 'eval') return simpleCommands(argv.slice(1).join(' '));
+    if (SHELLS.has(name)) {
+      let i = 1;
+      let script = false;
+      for (; i < argv.length && argv[i].startsWith('-'); i++) {
+        if (!argv[i].startsWith('--') && argv[i].slice(1).includes('c')) script = true;
+      }
+      if (script && i < argv.length) return simpleCommands(argv[i]);
+    }
+    return [argv];
+  }
