   expect(s.push("d")).toEqual([]);
   expect(s.end()).toEqual([["c", "d"]]);
 });
+
+function streamAll(chunks: string[]): string[][] {
+  const s = new CsvStream();
+  const rows: string[][] = [];
+  for (const c of chunks) rows.push(...s.push(c));
+  rows.push(...s.end());
+  return rows;
+}
+
+test("any split into chunks gives the rows of parseCsv", () => {
+  const inputs = [
+    'a,b\r\n"x,""y""",z\n',
+    "\uFEFFa,\"b\r\nc\"\r\n\r\n",
+    "a\r",
+    "a,\n\"\"\"\"\r\n",
+    "a\n\nb",
+    "",
+    "\uFEFF",
+    "a,",
+  ];
+  for (const text of inputs) {
+    for (let cut = 0; cut <= text.length; cut++) {
+      expect(streamAll([text.slice(0, cut), text.slice(cut)])).toEqual(parseCsv(text));
+    }
+    expect(streamAll(text.split(""))).toEqual(parseCsv(text));
+  }
+});
+
+test("a \r or a closing quote at the end of a chunk waits for the next character", () => {
+  const s = new CsvStream();
+  expect(s.push('"a"')).toEqual([]);
+  expect(s.push('\r')).toEqual([]);
+  expect(s.push("\n")).toEqual([["a"]]);
+  expect(s.push('"b""')).toEqual([]);
+  expect(s.push('"')).toEqual([]);
+  expect(s.end()).toEqual([['b"']]);
+});
+
+test("a stream rejects what parseCsv rejects", () => {
+  for (const text of ['"a"b', 'a"b', '"a', '"a"\rb\n', '"a"\r']) {
+    expect(() => parseCsv(text)).toThrow(SyntaxError);
+    expect(() => streamAll(text.split(""))).toThrow(SyntaxError);
+  }
+});
