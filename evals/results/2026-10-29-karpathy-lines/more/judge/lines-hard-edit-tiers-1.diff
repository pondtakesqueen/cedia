--- a/edit.ts	2026-10-29 05:30:47.796423500 +0000
+++ b/edit.ts	2026-10-29 05:31:23.477462385 +0000
@@ -23,5 +23,86 @@
 // - nothing matched: message contains "not found", and when the first non-blank line of old_text (trimmed) occurs
 //   in some lines of content, "first line appears at line L1, L2" (at most 5 lines).
 export function applyEdit(content: string, edit: TextEdit): { content: string; applied: Applied } | { error: string } {
-  throw new Error('not implemented');
+  const { old_text: old, new_text: news, replace_all } = edit;
+  if (old === '') return { error: 'old_text is empty; use write to create or overwrite a file' };
+  if (old === news) return { error: 'old_text and new_text are the same' };
+
+  const exactIdx = indexesOf(content, old);
+  if (exactIdx.length > 0) {
+    if (exactIdx.length > 1 && !replace_all) {
+      return { error: `old_text matches ${exactIdx.length} places at line ${exactIdx.map(lineOf(content)).join(', ')}; make it unique or set replace_all` };
+    }
+    const from = lineOf(content)(exactIdx[0]);
+    const to = lineOf(content)(exactIdx[exactIdx.length - 1] + old.length - 1);
+    const next = replace_all
+      ? content.split(old).join(news)
+      : content.slice(0, exactIdx[0]) + news + content.slice(exactIdx[0] + old.length);
+    return { content: next, applied: { from, to, tier: 'exact', count: exactIdx.length } };
+  }
+
+  const lines = content.split('\n');
+  const oldLines = stripNewline(old).split('\n');
+  const newText = stripNewline(news);
+
+  const trailing = windowsOf(lines, oldLines, (l) => l.trimEnd());
+  if (trailing.length > 1) return { error: ambiguous(trailing, 'trailing-space') };
+  if (trailing.length === 1) {
+    const start = trailing[0];
+    return apply(lines, start, oldLines.length, newText === '' ? [] : newText.split('\n'), 'trailing-space');
+  }
+
+  const indented = windowsOf(lines, oldLines, (l) => l.trim());
+  if (indented.length > 1) return { error: ambiguous(indented, 'indentation') };
+  if (indented.length === 1) {
+    const start = indented[0];
+    const k = oldLines.findIndex((l) => l.trim() !== '');
+    const oldIndent = k < 0 ? '' : leading(oldLines[k]);
+    const winIndent = k < 0 ? '' : leading(lines[start + k]);
+    const newLines = newText === ''
+      ? []
+      : newText.split('\n').map((l) => (l.trim() === '' ? '' : l.startsWith(oldIndent) ? winIndent + l.slice(oldIndent.length) : l));
+    return apply(lines, start, oldLines.length, newLines, 'indentation');
+  }
+
+  const firstLine = oldLines.find((l) => l.trim() !== '')?.trim() ?? '';
+  const hits = firstLine === '' ? [] : lines.flatMap((l, i) => (l.includes(firstLine) ? [i + 1] : []));
+  const pointer = hits.length > 0 ? `; first line appears at line ${hits.slice(0, 5).join(', ')}` : '';
+  return { error: `old_text not found${pointer}` };
+}
+
+function indexesOf(s: string, sub: string): number[] {
+  const out: number[] = [];
+  for (let i = s.indexOf(sub); i !== -1; i = s.indexOf(sub, i + sub.length)) out.push(i);
+  return out;
+}
+
+function lineOf(content: string) {
+  return (index: number) => content.slice(0, index).split('\n').length;
+}
+
+function stripNewline(s: string): string {
+  return s.endsWith('\n') ? s.slice(0, -1) : s;
+}
+
+function leading(line: string): string {
+  return line.match(/^\s*/)![0];
+}
+
+// Start indexes of windows of `lines` equal to `oldLines` after `norm`.
+function windowsOf(lines: string[], oldLines: string[], norm: (l: string) => string): number[] {
+  const want = oldLines.map(norm);
+  const out: number[] = [];
+  for (let i = 0; i + want.length <= lines.length; i++) {
+    if (want.every((w, j) => norm(lines[i + j]) === w)) out.push(i);
+  }
+  return out;
+}
+
+function ambiguous(starts: number[], tier: Tier): string {
+  return `old_text matches ${starts.length} places at line ${starts.map((s) => s + 1).join(', ')} (${tier}); make it unique`;
+}
+
+function apply(lines: string[], start: number, n: number, newLines: string[], tier: Tier) {
+  const next = [...lines.slice(0, start), ...newLines, ...lines.slice(start + n)].join('\n');
+  return { content: next, applied: { from: start + 1, to: start + n, tier, count: 1 } };
 }
