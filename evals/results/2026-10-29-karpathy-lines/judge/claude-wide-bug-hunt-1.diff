diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing-rules.test.ts b/test/pricing-rules.test.ts
--- a/test/pricing-rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing-rules.test.ts	2026-10-29 05:05:12.574260312 +0000
@@ -0,0 +1,26 @@
+import { describe, expect, test } from 'bun:test';
+import { cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+
+// Expected values worked by hand from the rules in README.md.
+describe('pricing rules', () => {
+  test('bulk discount starts at exactly 10 units', () => {
+    // 10 mugs = 4500; 5% off = 225; discounted 4275 < 5000 so shipping 800; tax 7% of 5075 = 355.25 -> 355
+    expect(totals(cart('US', [['MUG', 10]]))).toMatchObject({ subtotal: 4275, shipping: 800, tax: 355, total: 5430 });
+  });
+
+  test('UK free shipping starts at 4000', () => {
+    // 4 caps = 4800 >= 4000; tax 20% of 4800 = 960
+    expect(totals(cart('UK', [['CAP', 4]]))).toMatchObject({ shipping: 0, tax: 960, total: 5760 });
+  });
+
+  test('shipping is decided on the discounted subtotal', () => {
+    // 2 tees + 1 bag = 5200; SAVE10 -> 4680 < 5000 so shipping 800; tax 7% of 5480 = 383.6 -> 384
+    expect(totals(cart('US', [['TEE', 2], ['BAG', 1]], 'SAVE10'))).toMatchObject({ subtotal: 5200, coupon: 520, shipping: 800, tax: 384, total: 5864 });
+  });
+
+  test('lines of the same sku are merged before bulk pricing', () => {
+    // 5 + 5 mugs = 10 units -> 5% off 4500 = 225
+    expect(totals(cart('US', [['MUG', 5], ['MUG', 5]]))).toMatchObject({ subtotal: 4275, lines: [expect.objectContaining({ quantity: 10, discount: 225 })] });
+  });
+});
