diff -ruN '--exclude=node_modules' '--exclude=.git' a/memo.regression.test.ts b/memo.regression.test.ts
--- a/memo.regression.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/memo.regression.test.ts	2026-10-29 05:04:15.054256893 +0000
@@ -0,0 +1,79 @@
+import { expect, test } from "bun:test";
+import { memo } from "./memo";
+
+function deferred<T>() {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => ((resolve = res), (reject = rej)));
+  return { promise, resolve, reject };
+}
+
+function lookups() {
+  const calls: { key: string; d: ReturnType<typeof deferred<string>> }[] = [];
+  const fn = (key: string) => {
+    const d = deferred<string>();
+    calls.push({ key, d });
+    return d.promise;
+  };
+  return { fn, calls };
+}
+
+const tick = () => new Promise((r) => setTimeout(r, 0));
+
+test("an invalidated call settling does not overwrite a newer call's entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.resolve("old");
+  expect(await first).toBe("old");
+  calls[1]!.d.resolve("new");
+  expect(await second).toBe("new");
+  expect(await m("k")).toBe("new");
+  expect(calls).toHaveLength(2);
+});
+
+test("size stays at max once settled results arrive", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("c");
+  expect(m.size).toBe(2);
+  calls[2]!.d.resolve("c");
+  await tick();
+  expect(m.size).toBe(2);
+});
+
+test("a cache hit makes its key the last to be dropped", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 2 });
+  m("a");
+  m("b");
+  calls[0]!.d.resolve("a");
+  calls[1]!.d.resolve("b");
+  await tick();
+  m("a");
+  m("c");
+  expect(calls.map((c) => c.key)).toEqual(["a", "b", "c"]);
+  m("a");
+  expect(calls).toHaveLength(3);
+  m("b");
+  expect(calls).toHaveLength(4);
+});
+
+test("a rejected call does not drop a newer call's entry", async () => {
+  const { fn, calls } = lookups();
+  const m = memo(fn, { ttlMs: 1000, max: 10 });
+  const first = m("k");
+  m.invalidate("k");
+  const second = m("k");
+  calls[0]!.d.reject(new Error("boom"));
+  await expect(first).rejects.toThrow("boom");
+  expect(m("k")).toBe(second);
+  expect(calls).toHaveLength(2);
+});
