diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.rules.test.ts b/pool.rules.test.ts
--- a/pool.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.rules.test.ts	2026-10-29 05:04:21.178257257 +0000
@@ -0,0 +1,73 @@
+import { expect, test } from "bun:test";
+import { runPool } from "./pool";
+
+const later = <T>(ms: number, v: T) => () => new Promise<T>((r) => setTimeout(() => r(v), ms));
+
+test("results stay in input order when tasks finish out of order", async () => {
+  const out = await runPool([later(20, "slow"), later(1, "fast")], 2);
+  expect(out.map((r) => (r.status === "fulfilled" ? r.value : null))).toEqual(["slow", "fast"]);
+});
+
+test("never runs more than limit tasks at once", async () => {
+  let inFlight = 0;
+  let peak = 0;
+  const task = () => {
+    inFlight++;
+    peak = Math.max(peak, inFlight);
+    return new Promise<void>((r) => setTimeout(() => { inFlight--; r(); }, 2));
+  };
+  await runPool(Array.from({ length: 10 }, () => task), 3);
+  expect(peak).toBe(3);
+});
+
+test("a synchronous throw is a rejection and a plain value is a fulfilment", async () => {
+  const out = await runPool([() => { throw new Error("boom"); }, () => 7 as unknown as Promise<number>], 1);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 1 });
+  expect(out[1]).toMatchObject({ status: "fulfilled", value: 7 });
+});
+
+test("retries exactly `retries` times in the same slot", async () => {
+  let calls = 0;
+  const flaky = () => { calls++; return Promise.reject(new Error("no")); };
+  const out = await runPool([flaky], 1, { retries: 2 });
+  expect(calls).toBe(3);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 3 });
+});
+
+test("a non-integer limit is refused", async () => {
+  await expect(runPool([later(1, 1)], 1.5)).rejects.toBeInstanceOf(RangeError);
+});
+
+test("a non-integer retries is refused", async () => {
+  await expect(runPool([later(1, 1)], 1, { retries: 0.5 })).rejects.toBeInstanceOf(RangeError);
+});
+
+test("an abort stops new starts and settles unstarted tasks with the reason", async () => {
+  const ac = new AbortController();
+  let started = 0;
+  const task = () => { started++; return new Promise<number>((r) => setTimeout(() => r(started), 5)); };
+  const p = runPool([task, task, task, task], 1, { signal: ac.signal });
+  ac.abort("stop");
+  const out = await p;
+  expect(started).toBe(1);
+  expect(out[0]).toMatchObject({ status: "fulfilled", attempts: 1 });
+  expect(out.slice(1)).toEqual([1, 2, 3].map(() => ({ status: "rejected", reason: "stop", attempts: 0 })));
+});
+
+test("an already aborted signal starts nothing", async () => {
+  const ac = new AbortController();
+  ac.abort("early");
+  let started = 0;
+  const out = await runPool([() => { started++; return 1; }], 1, { signal: ac.signal });
+  expect(started).toBe(0);
+  expect(out).toEqual([{ status: "rejected", reason: "early", attempts: 0 }]);
+});
+
+test("an abort cancels a pending retry", async () => {
+  const ac = new AbortController();
+  let calls = 0;
+  const task = () => { calls++; ac.abort("cut"); return Promise.reject(new Error("no")); };
+  const out = await runPool([task], 1, { retries: 3, signal: ac.signal });
+  expect(calls).toBe(1);
+  expect(out[0]).toMatchObject({ status: "rejected", reason: "cut", attempts: 1 });
+});
