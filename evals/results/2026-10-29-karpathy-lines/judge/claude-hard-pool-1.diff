diff -ruN '--exclude=node_modules' '--exclude=.git' a/pool.rules.test.ts b/pool.rules.test.ts
--- a/pool.rules.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/pool.rules.test.ts	2026-10-29 05:04:47.958258849 +0000
@@ -0,0 +1,91 @@
+import { expect, test } from "bun:test";
+import { runPool } from "./pool";
+
+const later = <T>(ms: number, v: T) => () => new Promise<T>((r) => setTimeout(() => r(v), ms));
+
+test("never runs more than limit tasks at once", async () => {
+  let inFlight = 0;
+  let peak = 0;
+  const tracked = (ms: number) => async () => {
+    inFlight++;
+    peak = Math.max(peak, inFlight);
+    await new Promise((r) => setTimeout(r, ms));
+    inFlight--;
+    return ms;
+  };
+  await runPool([tracked(5), tracked(1), tracked(3), tracked(1), tracked(4), tracked(2)], 2);
+  expect(peak).toBe(2);
+});
+
+test("results stay in the slot of their task, not finish order", async () => {
+  const out = await runPool([later(20, "slow"), later(1, "fast")], 2);
+  expect(out.map((r) => (r.status === "fulfilled" ? r.value : null))).toEqual(["slow", "fast"]);
+});
+
+test("a synchronous throw is a rejection, and a plain value is a fulfilment", async () => {
+  const out = await runPool<number>([() => { throw new Error("boom"); }, () => 7], 1);
+  expect(out[0]).toMatchObject({ status: "rejected", attempts: 1 });
+  expect(out[1]).toEqual({ status: "fulfilled", value: 7, attempts: 1 });
+});
+
+test("a failing task is retried in its slot up to retries times", async () => {
+  let calls = 0;
+  const flaky = async () => {
+    calls++;
+    if (calls < 3) throw new Error("again");
+    return "ok";
+  };
+  const out = await runPool([flaky, later(1, "x")], 2, { retries: 2 });
+  expect(out[0]).toEqual({ status: "fulfilled", value: "ok", attempts: 3 });
+  const always = await runPool([async () => { throw 1; }], 1, { retries: 1 });
+  expect(always[0]).toEqual({ status: "rejected", reason: 1, attempts: 2 });
+});
+
+test("a fractional or negative retries count is refused", async () => {
+  await expect(runPool([later(1, 1)], 1, { retries: 1.5 })).rejects.toBeInstanceOf(RangeError);
+  await expect(runPool([later(1, 1)], 1, { retries: -1 })).rejects.toBeInstanceOf(RangeError);
+});
+
+test("a fractional limit is refused", async () => {
+  await expect(runPool([later(1, 1)], 1.5)).rejects.toBeInstanceOf(RangeError);
+});
+
+test("an abort stops new starts and retries; unstarted tasks reject with the reason", async () => {
+  const ac = new AbortController();
+  let started = 0;
+  const tasks = [0, 1, 2, 3].map((i) => async () => {
+    started++;
+    if (i === 0) {
+      ac.abort("stop");
+      throw new Error("fail");
+    }
+    return i;
+  });
+  const out = await runPool(tasks, 1, { retries: 3, signal: ac.signal });
+  expect(started).toBe(1);
+  expect(out[0]).toEqual({ status: "rejected", reason: "stop", attempts: 1 });
+  expect(out.slice(1)).toEqual([1, 2, 3].map(() => ({ status: "rejected", reason: "stop", attempts: 0 })));
+});
+
+test("an abort cancels a pending retry with the attempts made so far", async () => {
+  const ac = new AbortController();
+  let calls = 0;
+  const task = async () => {
+    calls++;
+    await new Promise((r) => setTimeout(r, 5));
+    if (calls === 1) ac.abort("late");
+    throw new Error("fail");
+  };
+  const out = await runPool([task], 1, { retries: 5, signal: ac.signal });
+  expect(calls).toBe(1);
+  expect(out[0]).toEqual({ status: "rejected", reason: "late", attempts: 1 });
+});
+
+test("an already aborted signal starts nothing", async () => {
+  const ac = new AbortController();
+  ac.abort("early");
+  let calls = 0;
+  const out = await runPool([() => { calls++; return 1; }, () => { calls++; return 2; }], 2, { signal: ac.signal });
+  expect(calls).toBe(0);
+  expect(out).toEqual([0, 1].map(() => ({ status: "rejected", reason: "early", attempts: 0 })));
+});
