diff -ruN '--exclude=node_modules' '--exclude=.git' a/test/pricing.test.ts b/test/pricing.test.ts
--- a/test/pricing.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/pricing.test.ts	2026-10-29 05:04:39.597468034 +0000
@@ -0,0 +1,41 @@
+import { describe, expect, test } from 'bun:test';
+import type { Cart } from '../src/cart/cart.ts';
+import { totals } from '../src/order/total.ts';
+import { bulkDiscount } from '../src/pricing/discounts/bulk.ts';
+
+const c = (region: string, lines: Cart['lines'], coupon?: string): Cart => ({ region, lines, coupon });
+
+describe('pricing rules', () => {
+  test('bulk discount starts at exactly 10 units and 50 units', () => {
+    expect(bulkDiscount(9, 10000)).toBe(0);
+    expect(bulkDiscount(10, 10000)).toBe(500);
+    expect(bulkDiscount(49, 10000)).toBe(500);
+    expect(bulkDiscount(50, 10000)).toBe(1000);
+  });
+
+  test('UK free shipping starts at 4000', () => {
+    // 2 items at 2000 = 4000 >= 4000: free; tax 20% of 4000 = 800
+    expect(totals(c('UK', [{ sku: 'X', quantity: 2, unitPrice: 2000 }]))).toMatchObject({ shipping: 0, tax: 800, total: 4800 });
+  });
+
+  test('shipping is judged on the discounted subtotal', () => {
+    // 1 line of 5000 with a FLAT5 coupon -> 4500 < 5000 in US, so shipping is charged
+    // subtotal 5000 (free by the old rule); tax 7% of 4500+800 = 371
+    expect(totals(c('US', [{ sku: 'X', quantity: 1, unitPrice: 5000 }], 'FLAT5'))).toMatchObject({
+      coupon: 500,
+      shipping: 800,
+      tax: 371,
+      total: 5671,
+    });
+  });
+
+  test('bulk tiers count units per SKU across the whole cart', () => {
+    // 6 + 5 units of SKU X = 11 units -> 5% off 11000 = 550
+    const t = totals(c('US', [
+      { sku: 'X', quantity: 6, unitPrice: 1000 },
+      { sku: 'X', quantity: 5, unitPrice: 1000 },
+    ]));
+    expect(t.subtotal).toBe(10450);
+    expect(t.lines).toHaveLength(1);
+  });
+});
